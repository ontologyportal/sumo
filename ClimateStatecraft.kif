;; ----------------------------------------------------------------------------------
;; Concepts Related to Climate Statecraft
;; ----------------------------------------------------------------------------------


;; ----------------------------------------------------------------------------------
;; Transpiration
;; ----------------------------------------------------------------------------------

(documentation Transpiration EnglishWrittenLanguage "Transpiration is the evaporation of
water into the atmosphere from the leaves and stems of plants.")
(termFormat EnglishWrittenLanguage Transpiration "transpiration")
(subclass Transpiration OrganOrTissueProcess)
(subclass Transpiration Transfer)

(=>
   (instance ?T Transpiration)
   (exists (?SC ?PLANT ?WATER)
     (and
       (instance ?SC StateChange)
       (instance ?PLANT Plant)
       (attribute ?WATER Liquid)
       (subProcess ?SC ?T)
       (patient ?SC ?WATER)
       (objectTransferred ?T ?WATER)
       (holdsDuring
         (BeginFn
           (WhenFn ?SC))
             (attribute ?WATER Liquid))
       (holdsDuring
         (EndFn
           (WhenFn ?SC))
             (attribute ?WATER Gas))
       (holdsDuring
         (BeginFn
           (WhenFn ?T))
             (part ?WATER ?PLANT))
       (holdsDuring
         (EndFn
           (WhenFn ?T))
             (not (part ?WATER ?PLANT))))))



;; ----------------------------------------------------------------------------------
;; Tilling
;; ----------------------------------------------------------------------------------
(documentation Tilling EnglishWrittenLanguage "The cultivation of soil for raising crops.")
(termFormat EnglishWrittenLanguage Tilling "tilling")

(subclass Tilling Agriculture)

(=>
 (instance ?T Tilling)
 (exists (?L ?COMBINE ?AIR ?SOIL)
   (and
     (instance ?L LandArea)
     (instance ?SOIL Soil)
     (instance ?COMBINE Combining)
     (subProcess ?COMBINE ?T)
     (instance ?AIR Air)
     (resource ?COMBINE ?AIR)
     (component ?SOIL ?L)
     (attribute ?L FertileTerrain)
     (patient ?COMBINE ?SOIL))))



;; ----------------------------------------------------------------------------------
;; Trace Gases in Earths Atmosphere
;; ----------------------------------------------------------------------------------
(documentation TraceGasEarthAtmosphere EnglishWrittenLanguage "Trace gases are gases that
are present in small amounts within an the earths atmosphere. Trace gases in Earth's
atmosphere are gases other than nitrogen (78.1%), oxygen (20.9%), and argon (0.934%)
which, in combination, make up 99.934% of its atmosphere")
(termFormat EnglishWrittenLanguage TraceGasEarthAtmosphere "trace gas in earth's atmosphere")

(subAttribute TraceGasEarthAtmosphere Gas)

(=>
   (attribute ?TG TraceGasEarthAtmosphere)
   (exists (?G)
     (and
       (attribute ?G Gas)
       (part ?G EarthsAtmosphere)
       (not (instance ?G Oxygen))
       (not (instance ?G Nitrogen))
       (not (instance ?G Argon)))))


;; ----------------------------------------------------------------------------------
;; Photosynthesis
;; ----------------------------------------------------------------------------------
(documentation Photosynthesis EnglishWrittenLanguage "Synthesis of compounds with the aid
of radiant energy. Only possible in plants, algae, and a group of bacteria called
cyanobacteria.")
(termFormat EnglishWrittenLanguage Photosynthesis "photosynthesis")

(subclass Photosynthesis OrganOrTissueProcess)
(subclass Photosynthesis ChemicalSynthesis)

(=>
   (instance ?PS Photosynthesis)
   (exists (?RL ?N)
     (and
       (instance ?RL RadiatingLight)
       (instance ?N  Nutrient)
       (resource ?PS ?RL)
       (result ?PS ?N))))



;; ----------------------------------------------------------------------------------
;; Cyanobacteria
;; ----------------------------------------------------------------------------------
(documentation Cyanobacteria  EnglishWrittenLanguage "Predominantly photosynthetic
prokaryotic organisms containing a blue pigment in addition to chlorophyll; occur
singly or in colonies in diverse habitats; important as phytoplankton.")
(termFormat EnglishWrittenLanguage Cyanobacteria "cyanobacteria")

(subclass Cyanobacteria Bacterium)
(subclass Cyanobacteria Photoautotroph)


;; ----------------------------------------------------------------------------------
;; Photoautotroph
;; ----------------------------------------------------------------------------------
(documentation Photoautotroph EnglishWrittenLanguage "An organism that can photosynthesize")
(termFormat EnglishWrittenLanguage Photoautotroph "photoautotroph")

(subclass Photoautotroph Organism)
(subclass Alga Photoautotroph)
(subclass Plant Photoautotroph)
(subclass Cyanobacteria Photoautotroph)

(=>
   (instance ?PS Photosynthesis)
   (exists (?PA)
     (and
       (instance ?PA Photoautotroph)
       (experiencer ?PS ?PA))))



;; ----------------------------------------------------------------------------------
;; OceanRegion
;; ----------------------------------------------------------------------------------
(documentation OceanRegion EnglishWrittenLanguage"OceanRegion is the class of all subregions
 of the &%WorldOcean. Analagous to &%AtmosphericRegion")
(termFormat EnglishWrittenLanguage OceanRegion "ocean region")

(subclass OceanRegion Ocean)

(=>
   (instance ?OR OceanRegion)
   (exists (?OCEAN)
     (and
       (instance ?OCEAN Ocean)
       (part ?OR ?OCEAN))))

(=>
   (instance ?OR OceanRegion)
   (part ?OR WorldOcean))


;; ----------------------------------------------------------------------------------
;; OceanRegion
;; ----------------------------------------------------------------------------------
(documentation PelagicZone EnglishWrittenLanguage "The pelagic zone consists of the water
column of the open ocean and can be further divided into regions by depth.")
(termFormat EnglishWrittenLanguage PelagicZone "pelagic zone")

(subclass PelagicZone OceanRegion)
(partition PelagicZone EpipelagicZone MesopelagicZone BathypelagicZone AbyssopelagicZone HadopelagicZone)

;; ----------------------------------------------------------------------------------
;; EpipelagicZone
;; ----------------------------------------------------------------------------------
(documentation EpipelagicZone EnglishWrittenLanguage "Ocean region that is the uppermost
layer of a body of water that receives sunlight, allowing phytoplankton to perform
photosynthesis.")
(termFormat EnglishWrittenLanguage EpipelagicZone "epipelagic zone")
(termFormat EnglishWrittenLanguage EpipelagicZone "photic zone")
(termFormat EnglishWrittenLanguage EpipelagicZone "sunlight zone")
(termFormat EnglishWrittenLanguage EpipelagicZone "euphotic zone")


(subclass EpipelagicZone PelagicZone)

(=>
   (and
     (instance ?PS Photosynthesis)
     (instance ?OR PelagicZone)
     (eventLocated ?PS ?OR))
   (exists (?EZ)
     (and
       (instance ?EZ EpipelagicZone)
       (equal ?EZ ?OR))))


(=>
   (instance ?EZ EpipelagicZone)
   (exists (?AIR)
     (and
       (instance ?AIR AtmosphericRegion)
       (orientation ?AIR ?EZ Above))))

(=>
   (and
     (instance ?EZ EpipelagicZone)
     (instance ?MZ MesopelagicZone))
   (orientation ?EZ ?MZ Above))


;; ----------------------------------------------------------------------------------
;; MesopelagicZone
;; ----------------------------------------------------------------------------------
(documentation MesopelagicZone EnglishWrittenLanguage "Ocean Region  begins at the depth
where only 1% of incident light reaches and ends where there is no light; the depths
of this zone are between approximately 200 to
1,000 meters (~656 to 3,280 feet) below the ocean surface.")
(termFormat EnglishWrittenLanguage MesopelagicZone "mesopelagic zone")
(termFormat EnglishWrittenLanguage MesopelagicZone "middle pelagic")
(termFormat EnglishWrittenLanguage MesopelagicZone "twilight zone")

(subclass MesopelagicZone PelagicZone)

(=>
   (and
     (instance ?MZ MesopelagicZone)
     (instance ?BZ BathypelagicZone))
   (orientation ?MZ ?BZ Above))


;; ----------------------------------------------------------------------------------
;; BathypelagicZone
;; ----------------------------------------------------------------------------------
(documentation BathypelagicZone EnglishWrittenLanguage "The bathypelagic zone, also known as
 the midnight zone, is the ocean layer that extends from about 1,000 meters
 (3,280 feet) to 4,000 meters (13,123 feet) below the surface.")
(termFormat EnglishWrittenLanguage BathypelagicZone "bathypelagic zone")
(termFormat EnglishWrittenLanguage BathypelagicZone "bathyal zone")
(termFormat EnglishWrittenLanguage BathypelagicZone "midnight zone")

(subclass BathypelagicZone PelagicZone)

(=>
   (and
     (instance ?MZ BathypelagicZone)
     (instance ?BZ AbyssopelagicZone))
   (orientation ?MZ ?BZ Above))



;; ----------------------------------------------------------------------------------
;; AbyssopelagicZone
;; ----------------------------------------------------------------------------------
(documentation AbyssopelagicZone EnglishWrittenLanguage "The abyssopelagic zone, also known
as the abyssal zone, is the layer of the ocean that extends from about 4,000 meters
(13,123 feet) to 6,000 meters (19,685 feet) below the surface.")
(termFormat EnglishWrittenLanguage AbyssopelagicZone "abyssopelagic zone")

(subclass AbyssopelagicZone PelagicZone)

(=>
   (and
     (instance ?MZ AbyssopelagicZone)
     (instance ?BZ HadopelagicZone))
   (orientation ?MZ ?BZ Above))



;; ----------------------------------------------------------------------------------
;; HadopelagicZone
;; ----------------------------------------------------------------------------------
(documentation HadopelagicZone EnglishWrittenLanguage "The hadopelagic zone, also known as
the hadal zone, is the deepest part of the ocean. It begins at around 6,000 meters
(19,685 feet) and extends to the ocean floor, which can be as deep as 11,000 meters
(36,089 feet).")
(termFormat EnglishWrittenLanguage HadopelagicZone "hadopelagic zone")

(subclass HadopelagicZone PelagicZone)

(=>
   (and
     (instance ?HZ HadopelagicZone)
     (instance ?SA SeabedArea))
   (orientation ?HZ ?SA Above))
