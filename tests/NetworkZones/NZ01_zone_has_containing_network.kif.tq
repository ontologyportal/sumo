;; A network zone has a containing network.
(note NZ01_zone_has_containing_network)
(category general)
(time 30)
(file NetworkZones.kif)

(instance Zone1 NetworkZone)

(query
  (exists (?NETWORK)
    (and
      (instance ?NETWORK ComputerNetwork)
      (immediateSubNetwork Zone1 ?NETWORK)
      (subNetwork Zone1 ?NETWORK)
      (properPart Zone1 ?NETWORK))))
(answer yes)
