;; A part of a contained zone is a part of its containing zone.
(note NZ02_member_of_inner_is_member_of_outer)
(category general)
(time 30)
(file NetworkZones.kif)

(instance Host1 Computer)
(instance ZoneInner NetworkZone)
(instance ZoneOuter NetworkZone)
(not
  (equal ZoneInner ZoneOuter))
(immediateSubNetwork ZoneInner ZoneOuter)
(part Host1 ZoneInner)

(query
  (part Host1 ZoneOuter))
(answer yes)
