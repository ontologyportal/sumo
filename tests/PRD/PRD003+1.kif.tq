; Written by Jackson Lawrence
;; PRD003+1 -- scenario reasoning test

(note PRD003+1)
(category PRD)

;; Scenario
(instance PRD003Bench WeightTrainingBench)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Seat -> Furniture (Mid-
;; level-ontology.kif:5559).
(query
  (and
    (instance PRD003Bench Furniture)
    (instance PRD003Bench AnaerobicExerciseDevice)
    (instance PRD003Bench Artifact)
    (attribute PRD003Bench InclineAdjustable)
    (capability Rotating patient PRD003Bench)))

(answer yes)
