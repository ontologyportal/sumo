; Written by Jackson Lawrence
; Meant to test GymEquipment.kif
(note PRD002+1)
(category PRD)

; Conjecture
(query
(forall (?EZ)
    (=>
        (instance ?EZ EZBarbell)
        (and
            (instance ?EZ Barbell)
            (instance ?EZ FreeWeight)
            (instance ?EZ AnaerobicExerciseDevice)
            (shape ?EZ Wavy)
            (attribute ?EZ TexturedGrip)
            (attribute ?EZ Rough)
            (attribute ?EZ Portable)
            (attribute ?EZ LoadBearing)
            (exists (?N)
                (and
                    (instance ?N NonnegativeInteger)
                    (curveReversalCount ?EZ ?N)
                    (greaterThan ?N 1)))))))

(answer yes)