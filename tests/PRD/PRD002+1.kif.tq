; Written by Jackson Lawrence
;; PRD002+1 -- scenario reasoning test

(note PRD002+1)
(category PRD)

;; Scenario
(instance PRD002Ez EZBarbell)

;; Reasoning: Classify the EZBarbell through Barbell, FreeWeight and
;; AnaerobicExerciseDevice to RecreationOrExerciseDevice; infer its grip and shape
;; properties.
(query
  (and
    (and
      (instance PRD002Ez FreeWeight)
      (instance PRD002Ez AnaerobicExerciseDevice)
      (shape PRD002Ez Wavy)
      (attribute PRD002Ez TexturedGrip)
      (attribute PRD002Ez Rough)
      (attribute PRD002Ez Portable)
      (attribute PRD002Ez LoadBearing)
      (exists (?N)
        (and
          (instance ?N NonnegativeInteger)
          (curveReversalCount PRD002Ez ?N)
          (greaterThan ?N 1))))
    (instance PRD002Ez RecreationOrExerciseDevice)))

(answer yes)
