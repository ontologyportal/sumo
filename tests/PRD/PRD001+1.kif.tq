; Written by Jackson Lawrence
;; PRD001+1 -- scenario reasoning test

(note PRD001+1)
(category PRD)

;; Scenario
(instance PRD001Rb ResistanceBand)

(instance PRD001S Stretching)

(patient PRD001S PRD001Rb)

;; Reasoning: Instantiate the scenario; apply the domain rule, then AnaerobicExerciseDevice
;; -> RecreationOrExerciseDevice (Mid-level-ontology.kif:12086).
(query
  (and
    (instance PRD001Rb Artifact)
    (instance PRD001Rb RecreationOrExerciseDevice)
    (attribute PRD001Rb LongAndThin)
    (attribute PRD001Rb Elastic)
    (attribute PRD001Rb Pliable)
    (capability Stretching patient PRD001Rb)
    (exists (?SHAPE)
      (and
        (holdsDuring (BeginFn (WhenFn PRD001S)) (shape PRD001Rb ?SHAPE))
        (holdsDuring (EndFn (WhenFn PRD001S)) (shape PRD001Rb ?SHAPE))))))

(answer yes)
