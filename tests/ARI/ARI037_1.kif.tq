;;------------------------------------------------------------------------------
;; File     : ARI037_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Rational representation of a terminating decimal
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Evaluate the original arithmetic expression, add the tare mass, then substitute the result into the shipment measurement.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0035
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note ARI037_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI037Shipment Artifact)

(measure
  ARI037Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (RationalNumberFn 0.75)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure
    ARI037Shipment
    (MeasureFn (AdditionFn (AbsoluteValueFn (DivisionFn 3.0 4.0)) 10) Kilogram)))

(answer yes)
