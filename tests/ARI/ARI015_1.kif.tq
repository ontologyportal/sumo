;;------------------------------------------------------------------------------
;; File     : ARI015_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : A nonzero integer times its inverse power equals one
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Evaluate nested integer/real operations in a concrete shipment, then propagate equality to its recorded mass.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0013
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note ARI015_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI015Shipment Artifact)

(measure
  ARI015Shipment
  (MeasureFn (AdditionFn (MultiplicationFn 4 (ExponentiationFn 4 -1)) 10) Kilogram))

;; Reasoning: Evaluate nested integer/real operations in a concrete shipment, then
;; propagate equality to its recorded mass.
(query
  (measure ARI015Shipment (MeasureFn (AdditionFn 1 10) Kilogram)))

(answer yes)
