;;------------------------------------------------------------------------------
;; File     : ARI031_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Least common multiple of two positive integers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The least common multiple of 4 and 6 is 12.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0029
;;
;; Status   : Theorem
;; Comments : Exercises the corrected positive result and minimality
;;          : axioms for LeastCommonMultipleFn in Merge.kif.
;;          : Variable-arity translation and the prover result have not
;;          : yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note ARI031_1)
(category ARI)
(minLang tff)
(include Merge.kif)

(query
  (equal (LeastCommonMultipleFn 4 6) 12))

(answer yes)
