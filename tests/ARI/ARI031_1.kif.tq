(note ARI031_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI031Shipment Artifact)

(measure
  ARI031Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (LeastCommonMultipleFn 4 6)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure ARI031Shipment (MeasureFn 22 Kilogram)))

(answer yes)
