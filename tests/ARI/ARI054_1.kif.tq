;; ARI054_1 -- scenario reasoning test

(note ARI054_1)
(category ARI)
(minLang tff)
(time 300)

;; Scenario
(instance MyCar Automobile)

(instance MyTransmission AutomobileTransmission)

(instance MySuspension AutoSuspensionSystem)

(part MyTransmission MyCar)

(part MySuspension MyCar)

(measure MyTransmission (MeasureFn 100 PoundMass))

(measure MySuspension (MeasureFn 200 Kilogram))

;; Reasoning: The component masses do not determine the complete car mass; no unsupported
;; additive rule is supplied. This remains a non-entailment test.
(query
  (measure MyCar (MeasureFn 500 PoundMass)))

(answer no)
