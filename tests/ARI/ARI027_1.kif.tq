(note ARI027_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI027Shipment Artifact)

(measure
  ARI027Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (IntegerSquareRootFn 81)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure ARI027Shipment (MeasureFn 19 Kilogram)))

(answer yes)
