;;------------------------------------------------------------------------------
;; File     : ARI014_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Remainder of positive integers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Seventeen divided by five has remainder two.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0012
;;
;; Status   : Theorem
;; Comments : Tests RemainderFn with a nonzero positive divisor.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note ARI014_1)
(category ARI)
(minLang tff)
(include Merge.kif)

(query
  (equal (RemainderFn 17 5) 2))

(answer yes)
