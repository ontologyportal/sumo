(note ARI014_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI014Shipment Artifact)

(measure
  ARI014Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (RemainderFn 17 5)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure ARI014Shipment (MeasureFn 12 Kilogram)))

(answer yes)
