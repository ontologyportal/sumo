(note ARI055_1)
(category ARI)
(minLang tff)
(time 300)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include MilitaryDevices.kif)

;; Scenario
(instance SurveyRobot Vehicle)

(instance SurveyCar Automobile)

(instance (MeasureFn 100.0 PoundMass) MassMeasure)

(instance (MeasureFn 1.5 TonMass) MassMeasure)

(weight SurveyCar (MeasureFn 1.5 TonMass))

(maximumPayloadCapacity SurveyRobot (MeasureFn 100.0 PoundMass))

;; Reasoning: Convert the car weight into the capacity unit, compare the magnitudes, then
;; use the MilitaryDevices payload exclusion rule. This asks for an explicit negative
;; conclusion rather than merely failing to prove a trip.
(query
  (not
    (exists (?TRANSPORT)
      (and
        (instance ?TRANSPORT Transportation)
        (instrument ?TRANSPORT SurveyRobot)
        (patient ?TRANSPORT SurveyCar)))))

(answer yes)
