;; ARI045_1 -- scenario reasoning test

(note ARI045_1)
(category ARI)
(minLang tff)

;; Scenario
(instance SurveyFreight Artifact)

(measure
  SurveyFreight
  (MeasureFn (SubtractionFn (DivisionFn 100.0 2.0) 10.0) Kilogram))

;; Reasoning: Evaluate division and subtraction for the freight reading; independently
;; evaluate addition, division and multiplication, then substitute the equal mass.
(query
  (measure
    SurveyFreight
    (MeasureFn (MultiplicationFn (AdditionFn 4.0 4.0) (DivisionFn 10.0 2.0)) Kilogram)))

(answer yes)
