;; ARI002_1 -- scenario reasoning test

(note ARI002_1)
(category ARI)
(minLang tff)

;; Scenario
(instance ARI002Shipment Artifact)

(measure ARI002Shipment (MeasureFn (AdditionFn 2 -1) Kilogram))

(instance ARI002ShipmentReference Artifact)

(measure ARI002ShipmentReference (MeasureFn (AdditionFn 2 1) Kilogram))

;; Reasoning: Evaluate two shipment measurements, bind their magnitudes, then compare the
;; resulting weights.
(query
  (exists (?A ?B)
    (and
      (measure ARI002Shipment (MeasureFn ?A Kilogram))
      (measure ARI002ShipmentReference (MeasureFn ?B Kilogram))
      (lessThan ?A ?B))))

(answer yes)
