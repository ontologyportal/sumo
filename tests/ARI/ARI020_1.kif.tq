(note ARI020_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI020Shipment Artifact)

(measure
  ARI020Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (MaxFn 3 7)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure ARI020Shipment (MeasureFn 17 Kilogram)))

(answer yes)
