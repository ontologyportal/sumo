;;------------------------------------------------------------------------------
;; File     : ARI034_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Arc sine reverses sine within its principal range
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Evaluate the original arithmetic expression, add the tare mass, then substitute the result into the shipment measurement.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0032
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note ARI034_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI034Shipment Artifact)

(measure
  ARI034Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (ArcSineFn (SineFn 0.5))) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure ARI034Shipment (MeasureFn 10.5 Kilogram)))

(answer yes)
