;; ARI044_1 -- scenario reasoning test

(note ARI044_1)
(category ARI)
(minLang tff)

;; Scenario
(instance EastShipment Artifact)

(instance WestShipment Artifact)

(measure EastShipment (MeasureFn (AdditionFn 3.0 5.0) Kilogram))

(measure WestShipment (MeasureFn (AdditionFn 4.0 4.0) Kilogram))

;; Reasoning: Evaluate the two independent shipment-mass calculations, then use equality to
;; show they have a shared measurement.
(query
  (exists (?MASS) (and (measure EastShipment ?MASS) (measure WestShipment ?MASS))))

(answer yes)
