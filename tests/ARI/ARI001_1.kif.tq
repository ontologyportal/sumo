;; ARI001_1 -- scenario reasoning test

(note ARI001_1)
(category ARI)
(minLang tff)

;; Scenario
(instance ARI001Shipment Artifact)

(measure ARI001Shipment (MeasureFn (AdditionFn 2 -1) Kilogram))

(instance ARI001ShipmentReference Artifact)

(measure ARI001ShipmentReference (MeasureFn (AdditionFn 2 0) Kilogram))

;; Reasoning: Evaluate two shipment measurements, bind their magnitudes, then compare the
;; resulting weights.
(query
  (exists (?A ?B)
    (and
      (measure ARI001Shipment (MeasureFn ?A Kilogram))
      (measure ARI001ShipmentReference (MeasureFn ?B Kilogram))
      (lessThan ?A ?B))))

(answer yes)
