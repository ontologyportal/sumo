;; ARI042_1 -- scenario reasoning test

(note ARI042_1)
(category ARI)
(minLang tff)

;; Scenario
(instance ARI042Shipment Artifact)

(measure ARI042Shipment (MeasureFn (AdditionFn (AbsoluteValueFn 12) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure
    ARI042Shipment
    (MeasureFn (AdditionFn (AbsoluteValueFn (MultiplicationFn 3 4)) 10) Kilogram)))

(answer yes)
