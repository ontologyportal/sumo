(note ARI033_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI033Shipment Artifact)

(measure
  ARI033Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (TangentFn 0.0)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure ARI033Shipment (MeasureFn 10 Kilogram)))

(answer yes)
