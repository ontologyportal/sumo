;; ARI043_1 -- scenario reasoning test

(note ARI043_1)
(category ARI)
(minLang tff)

;; Scenario
(instance ARI043Shipment Artifact)

(measure
  ARI043Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (AdditionFn 3.0 5.0)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure
    ARI043Shipment
    (MeasureFn (AdditionFn (AbsoluteValueFn (AdditionFn 4.0 4.0)) 10) Kilogram)))

(answer yes)
