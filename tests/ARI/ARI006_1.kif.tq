;;------------------------------------------------------------------------------
;; File     : ARI006_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : The successor function is injective on integers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Apply successor injectivity to identify two counts, then transport that equality into the concrete cargo member-count observation.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note ARI006_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance CargoCountA Integer)

(instance CargoCountB Integer)

(equal (SuccessorFn CargoCountA) (SuccessorFn CargoCountB))

(instance CountedCargo Artifact)

(measure CountedCargo (MeasureFn CargoCountA Kilogram))

;; Reasoning: Apply successor injectivity to identify two numeric readings, then transport
;; their equality into the concrete cargo measurement.
(query
  (measure CountedCargo (MeasureFn CargoCountB Kilogram)))

(answer yes)
