(note ARI053_1)
(category ARI)
(minLang tff)
(time 300)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include MilitaryDevices.kif)

;; Scenario
(instance SurveyRobot Vehicle)

(maximumPayloadCapacity SurveyRobot (MeasureFn 100.0 PoundMass))

;; Reasoning: Use the Mid-level-ontology TonMass/PoundMass conversion as encoded, invert
;; its numeric magnitude and substitute the equal capacity measure. No approximate answer
;; is asserted.
(query
  (maximumPayloadCapacity SurveyRobot (MeasureFn (DivisionFn 100.0 2205.0) TonMass)))

(answer yes)
