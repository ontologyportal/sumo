(note ARI019_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI019Shipment Artifact)

(measure
  ARI019Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (MinFn 3 7)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure ARI019Shipment (MeasureFn 13 Kilogram)))

(answer yes)
