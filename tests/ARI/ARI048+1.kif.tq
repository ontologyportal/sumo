;; ARI048+1 -- scenario reasoning test

(note ARI048+1)
(category ARI)

;; Scenario
(instance Number3-1 NonnegativeRealNumber)

(disjoint NonnegativeRealNumber NegativeRealNumber)

(instance AvailableStock Artifact)

(measure AvailableStock (MeasureFn Number3-1 Kilogram))

(instance DeficitReading NegativeRealNumber)

;; Reasoning: Derive the stock reading is not negative via the numeric-class/signum rules,
;; then use a negative reference reading to establish distinctness.
(query
  (not (equal Number3-1 DeficitReading)))

(answer yes)
