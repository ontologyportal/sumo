;;------------------------------------------------------------------------------
;; File     : ARI010_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Reversing a four-term sum with an absolute value
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Evaluate nested integer/real operations in a concrete shipment, then propagate equality to its recorded mass.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note ARI010_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI010Shipment Artifact)

(measure
  ARI010Shipment
  (MeasureFn
    (AdditionFn
      (AdditionFn (AbsoluteValueFn -5.0) (AdditionFn 2.0 (AdditionFn 3.0 4.0)))
      10)
    Kilogram))

;; Reasoning: Evaluate nested integer/real operations in a concrete shipment, then
;; propagate equality to its recorded mass.
(query
  (measure ARI010Shipment (MeasureFn (AdditionFn 14 10) Kilogram)))

(answer yes)
