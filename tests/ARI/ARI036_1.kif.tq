(note ARI036_1)
(category ARI)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance ARI036Shipment Artifact)

(measure
  ARI036Shipment
  (MeasureFn (AdditionFn (AbsoluteValueFn (ArcCosineFn 1.0)) 10) Kilogram))

;; Reasoning: Evaluate the original arithmetic expression, add the tare mass, then
;; substitute the result into the shipment measurement.
(query
  (measure ARI036Shipment (MeasureFn 10 Kilogram)))

(answer yes)
