; Written by Jackson Lawrence
; Meant to test GymEquipment.kif
(note GymEquipment_3)
(category GymEquipment)

; Conjecture
(query
(forall (?BENCH)
    (=>
        (instance ?BENCH WeightTrainingBench)
        (and
            (instance ?BENCH Seat)
            (instance ?BENCH AnaerobicExerciseDevice)
            (instance ?BENCH Artifact)
            (attribute ?BENCH InclineAdjustable)
            (capability Rotating patient ?BENCH)))))

(answer yes)