; Written by Bradford Sweeter
; Meant to test Astronomy.kif
(note Astronomy_1)
(category Astronomy)

; Assertions
(instance OBJ1 Object) 
(instance F1 PointInSpace) 
(instance F2 PointInSpace) 
(foci OBJ1 F1 F2)

; Conjecture
(query
  (and 
    (attribute OBJ1 Ellipse) 
    (located F1 OBJ1) 
    (not 
      (exists (?SURF) 
        (and 
          (superficialPart ?SURF OBJ1) 
          (or 
            (overlapsSpatially F1 ?SURF) 
            (meetsSpatially F1 ?SURF)))))))

(answer yes)