;;------------------------------------------------------------------------------
;; File     : GEG004+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Desert dryness
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Identify the camp area and use the desert classification and desert dryness rule for that area.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG004+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance DesertSurveyCamp Object)

(located DesertSurveyCamp MojaveDesert)

;; Reasoning: Identify the camp area and use the desert classification and desert dryness
;; rule for that area.
(query
  (exists (?AREA)
    (and
      (located DesertSurveyCamp ?AREA)
      (instance ?AREA GeographicArea)
      (attribute ?AREA Dry))))

(answer yes)
