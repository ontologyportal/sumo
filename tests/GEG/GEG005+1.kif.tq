;;------------------------------------------------------------------------------
;; File     : GEG005+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Sea classification
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Follow the destination Sea/BodyOfWater hierarchy to its geographic-area classification.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0005
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG005+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance MarineSurvey Translocation)

(destination MarineSurvey MediterraneanSea)

;; Reasoning: Follow the destination Sea/BodyOfWater hierarchy to its geographic-area
;; classification.
(query
  (exists (?AREA)
    (and
      (destination MarineSurvey ?AREA)
      (instance ?AREA BodyOfWater)
      (instance ?AREA GeographicArea))))

(answer yes)
