;;------------------------------------------------------------------------------
;; File     : GEG003+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Mountain landform classification
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Bind the survey destination, then follow MountWhitney mountain/landform classification.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0003
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG003+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance SummitSurvey Translocation)

(destination SummitSurvey MountWhitney)

;; Reasoning: Bind the survey destination, then follow MountWhitney mountain/landform
;; classification.
(query
  (exists (?PEAK) (and (destination SummitSurvey ?PEAK) (instance ?PEAK LandForm))))

(answer yes)
