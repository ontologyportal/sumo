;;------------------------------------------------------------------------------
;; File     : GEG010^1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Climate zone witness
;; Version  : Full SUMO axioms; ^1 denotes THF formulation 1.
;; English  : Use the climate-area witness rule for the survey district, then MediterraneanClimateZone -> ClimateZone.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0010
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG010^1)
(category GEG)
(minLang thf)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance CoastalSurveyDistrict GeographicArea)

(climateTypeInArea CoastalSurveyDistrict MediterraneanClimateZone)

;; Reasoning: Use the climate-area witness rule for the survey district, then
;; MediterraneanClimateZone -> ClimateZone.
(query
  (exists (?REGION ?CLIMATE)
    (and
      (part ?REGION CoastalSurveyDistrict)
      (attribute ?REGION ?CLIMATE)
      (instance ?CLIMATE ClimateZone))))

(answer yes)
