;;------------------------------------------------------------------------------
;; File     : GEG010^1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Climate zone witness
;; Version  : Full SUMO axioms; ^1 denotes THF formulation 1.
;; English  : Part of Southern France has a Mediterranean climate attribute.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0010
;;
;; Status   : Theorem
;; Comments : Specializes the climateTypeInArea rule with a class-valued argument.
;;          : Uses the 51-file full SUMO source manifest.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note GEG010^1)
(category GEG)
(minLang thf)
(include tests/axiom-sets/full.sources)

(query
  (exists (?REGION ?TYPE)
    (and
      (instance ?REGION GeographicArea)
      (instance ?TYPE MediterraneanClimateZone)
      (attribute ?REGION ?TYPE)
      (part ?REGION SouthernFrance))))

(answer yes)
