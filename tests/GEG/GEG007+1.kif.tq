;;------------------------------------------------------------------------------
;; File     : GEG007+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Symmetry of external connection
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Combine the known regional boundary with the RCC8 external-connection/equal-region composition rule.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0007
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG007+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance NorthernSurveyZone Region)

(equalRegions NorthernCalifornia NorthernSurveyZone)

;; Reasoning: Combine the known regional boundary with the RCC8 external-connection/equal-
;; region composition rule.
(query
  (externallyConnected SouthernCalifornia NorthernSurveyZone))

(answer yes)
