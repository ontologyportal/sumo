;;------------------------------------------------------------------------------
;; File     : GEG016+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Endorheic basin drainage
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Apply the GreatBasin river exclusion and classify PacificOcean as Ocean to rule out this particular outlet.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0016
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG016+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance BasinSurveyRiver River)

(located BasinSurveyRiver GreatBasin)

;; Reasoning: Apply the GreatBasin river exclusion and classify PacificOcean as Ocean to
;; rule out this particular outlet.
(query
  (not (flows BasinSurveyRiver PacificOcean)))

(answer yes)
