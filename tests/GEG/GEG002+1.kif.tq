(note GEG002+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance BasinSurveyCamp Object)

(located BasinSurveyCamp BadwaterBasin)

;; Reasoning: Compose BadwaterBasin -> DeathValley -> MojaveDesert and propagate the survey
;; camp location.
(query
  (located BasinSurveyCamp MojaveDesert))

(answer yes)
