;;------------------------------------------------------------------------------
;; File     : GEG017+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Compass direction decomposition
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Reduce the known Northwest bearing to North, then reverse the surveyed endpoints to infer South.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0017
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG017+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance SummitToBasinSurvey Translocation)

(origin SummitToBasinSurvey MountWhitney)

(destination SummitToBasinSurvey BadwaterBasin)

;; Reasoning: Reduce the known Northwest bearing to North, then reverse the surveyed
;; endpoints to infer South.
(query
  (exists (?FROM ?TO)
    (and
      (origin SummitToBasinSurvey ?FROM)
      (destination SummitToBasinSurvey ?TO)
      (orientation ?TO ?FROM South))))

(answer yes)
