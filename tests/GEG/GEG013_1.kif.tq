;;------------------------------------------------------------------------------
;; File     : GEG013_1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Elevation below sea level
;; Version  : Full SUMO axioms; _1 denotes TFF formulation 1.
;; English  : Substitute the measured elevation, then evaluate subtraction to relate the survey record to its negative altitude.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0013
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG013_1)
(category GEG)
(minLang tff)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance BasinSurveySite GeographicArea)

(instance BasinSurveyElevation LengthMeasure)

(equal BasinSurveyElevation (MeasureFn -86 Meter))

(elevation BasinSurveySite BasinSurveyElevation)

;; Reasoning: Substitute the measured elevation, then evaluate subtraction to relate the
;; survey record to its negative altitude.
(query
  (elevation BasinSurveySite (MeasureFn (SubtractionFn 0 86) Meter)))

(answer yes)
