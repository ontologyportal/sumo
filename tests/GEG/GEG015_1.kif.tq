;;------------------------------------------------------------------------------
;; File     : GEG015_1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Area of an inland sea
;; Version  : Full SUMO axioms; _1 denotes TFF formulation 1.
;; English  : Identify the surveyed sea, classify it as a body of water, and convert its area from square kilometers to square meters.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0015
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG015_1)
(category GEG)
(minLang tff)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance MediterraneanSurvey Translocation)

(destination MediterraneanSurvey MediterraneanSea)

;; Reasoning: Identify the surveyed sea, classify it as a body of water, and convert its
;; area from square kilometers to square meters.
(query
  (exists (?SEA)
    (and
      (destination MediterraneanSurvey ?SEA)
      (instance ?SEA BodyOfWater)
      (totalArea ?SEA (MeasureFn 2500000000000 SquareMeter)))))

(answer yes)
