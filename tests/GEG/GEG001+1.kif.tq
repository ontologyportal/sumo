;;------------------------------------------------------------------------------
;; File     : GEG001+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Country within a continent
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Infer Egypt located in Africa from geographicSubregion, then use located transitivity for the survey camp.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0001
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG001+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance DeltaSurveyCamp Object)

(located DeltaSurveyCamp Egypt)

;; Reasoning: Infer Egypt located in Africa from geographicSubregion, then use located
;; transitivity for the survey camp.
(query
  (located DeltaSurveyCamp Africa))

(answer yes)
