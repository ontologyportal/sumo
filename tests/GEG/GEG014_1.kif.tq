;;------------------------------------------------------------------------------
;; File     : GEG014_1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Distance between landforms
;; Version  : Full SUMO axioms; _1 denotes TFF formulation 1.
;; English  : Bind the surveyed endpoints, use distance symmetry, and convert the known 136-kilometer distance to meters.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0014
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG014_1)
(category GEG)
(minLang tff)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance BasinToSummitSurvey Translocation)

(origin BasinToSummitSurvey BadwaterBasin)

(destination BasinToSummitSurvey MountWhitney)

;; Reasoning: Bind the surveyed endpoints, use distance symmetry, and convert the known
;; 136-kilometer distance to meters.
(query
  (exists (?FROM ?TO)
    (and
      (origin BasinToSummitSurvey ?FROM)
      (destination BasinToSummitSurvey ?TO)
      (distance ?TO ?FROM (MeasureFn 136000 Meter)))))

(answer yes)
