;;------------------------------------------------------------------------------
;; File     : GEG006+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Ocean mereology
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Use the PacificOcean part/location relation with WorldOcean, then propagate the buoy location.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0006
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG006+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance PacificSurveyBuoy Object)

(located PacificSurveyBuoy PacificOcean)

;; Reasoning: Use the PacificOcean part/location relation with WorldOcean, then propagate
;; the buoy location.
(query
  (located PacificSurveyBuoy WorldOcean))

(answer yes)
