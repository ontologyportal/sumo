;;------------------------------------------------------------------------------
;; File     : GEG011+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Latitude circle classification
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Bind the survey path and infer its Region type through the Equator/latitude hierarchy.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0011
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG011+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance EquatorialSurvey Translocation)

(path EquatorialSurvey Equator)

;; Reasoning: Bind the survey path and infer its Region type through the Equator/latitude
;; hierarchy.
(query
  (exists (?PATH) (and (path EquatorialSurvey ?PATH) (instance ?PATH Region))))

(answer yes)
