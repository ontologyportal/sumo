;;------------------------------------------------------------------------------
;; File     : GEG008+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : RCC8 overlap classification
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Derive partial overlap from geographic overlapsSpatially, then compose it with equalRegions for the survey zone.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG008+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance AsianSurveyZone Region)

(equalRegions Asia AsianSurveyZone)

;; Reasoning: Derive partial overlap from geographic overlapsSpatially, then compose it
;; with equalRegions for the survey zone.
(query
  (partiallyOverlapping MiddleEastRegion AsianSurveyZone))

(answer yes)
