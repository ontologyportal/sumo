;;------------------------------------------------------------------------------
;; File     : GEG012^1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Natural hazard occurrence
;; Version  : Full SUMO axioms; ^1 denotes THF formulation 1.
;; English  : Use the process-hazard witness rule and then the CyclonicStorm weather-system hierarchy.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0012
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG012^1)
(category GEG)
(minLang thf)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance SurveyOcean GeographicArea)

(naturalHazardTypeInArea SurveyOcean CyclonicStorm)

;; Reasoning: Use the process-hazard witness rule and then the CyclonicStorm weather-system
;; hierarchy.
(query
  (exists (?STORM) (and (instance ?STORM WeatherSystem) (located ?STORM SurveyOcean))))

(answer yes)
