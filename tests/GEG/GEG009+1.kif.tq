;;------------------------------------------------------------------------------
;; File     : GEG009+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Coastal external connection
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Translate Egypt/RedSea boundary contact into externallyConnected, use symmetry and then equal-region composition.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0009
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note GEG009+1)
(category GEG)
(minLang fof)
(include tests/axiom-sets/full.sources)

;; Scenario
(instance EgyptianSurveyZone Region)

(equalRegions Egypt EgyptianSurveyZone)

;; Reasoning: Translate Egypt/RedSea boundary contact into externallyConnected, use
;; symmetry and then equal-region composition.
(query
  (externallyConnected RedSea EgyptianSurveyZone))

(answer yes)
