;;------------------------------------------------------------------------------
;; File     : CSR022_1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Broad-gauge railway width
;; Version  : Merge.kif + Transportation.kif axioms; _1 denotes TFF formulation 1.
;; English  : A broad-gauge railway measured in meters has a track width greater than 1.44 meters.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0009
;;
;; Status   : Theorem
;; Comments : Combines broad-gauge classification, MeasureFn length typing, and the track-width bound.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR022_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Transportation.kif)

(query
  (=>
    (and
      (instance ?RAILWAY BroadGaugeRailway)
      (trackWidth ?RAILWAY (MeasureFn ?WIDTH Meter)))
    (greaterThan ?WIDTH 1.44)))

(answer yes)
