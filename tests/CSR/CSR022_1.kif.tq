;;------------------------------------------------------------------------------
;; File     : CSR022_1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Broad-gauge railway width
;; Version  : Merge.kif + Transportation.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then (greaterThan CSR022Width 1.44) -> a weaker numeric bound by comparison transitivity.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0009
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR022_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Transportation.kif)

;; Scenario
(instance CSR022Railway BroadGaugeRailway)

(trackWidth CSR022Railway (MeasureFn CSR022Width Meter))

;; Reasoning: Instantiate the scenario; apply the domain rule, then (greaterThan
;; CSR022Width 1.44) -> a weaker numeric bound by comparison transitivity.
(query
  (greaterThan CSR022Width 0.43999999999999995))

(answer yes)
