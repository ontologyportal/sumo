;;------------------------------------------------------------------------------
;; File     : CSR009+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Space transportation uses a vehicle in a space region
;; Version  : Merge.kif + Mid-level-ontology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Translocation -> Motion (Merge.kif:14838).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif
;; Names    : SMO_AST_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR009+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)

;; Scenario
(instance CSR009Trip SpaceTransportation)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Translocation -> Motion
;; (Merge.kif:14838).
(query
  (exists (?CRAFT ?REGION)
    (and
      (instance CSR009Trip Motion)
      (instance ?CRAFT TransportationDevice)
      (instance ?REGION SpaceRegion)
      (instrument CSR009Trip ?CRAFT)
      (eventLocated CSR009Trip ?REGION))))

(answer yes)
