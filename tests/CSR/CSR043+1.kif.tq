;;------------------------------------------------------------------------------
;; File     : CSR043+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Rain is liquid precipitation
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Precipitation -> WeatherProcess (Merge.kif:14332).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0003
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR043+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR043Raining Raining)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Precipitation ->
;; WeatherProcess (Merge.kif:14332).
(query
  (and
    (instance CSR043Raining WeatherProcess)
    (precipitationState CSR043Raining Liquid)
    (exists (?WATER)
      (and (instance ?WATER WaterSolution) (objectTransferred CSR043Raining ?WATER)))))

(answer yes)
