;;------------------------------------------------------------------------------
;; File     : CSR017+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Vehicle in a water transportation service
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : A water transportation service includes a water trip using a vehicle.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0004
;;
;; Status   : Theorem
;; Comments : Combines the water-service witness rule with WaterVehicle subclass Vehicle.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR017+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?SERVICE WaterTransportationService)
    (exists (?TRIP ?VEHICLE)
      (and
        (instance ?TRIP WaterTransportation)
        (instance ?VEHICLE Vehicle)
        (instrument ?TRIP ?VEHICLE)
        (subProcess ?TRIP ?SERVICE)))))

(answer yes)
