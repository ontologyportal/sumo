;;------------------------------------------------------------------------------
;; File     : CSR017+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Vehicle in a water transportation service
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then WaterTransportation -> Transportation (Mid-level-ontology.kif:25059).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR017+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

;; Scenario
(instance CSR017Service WaterTransportationService)

;; Reasoning: Instantiate the scenario; apply the domain rule, then WaterTransportation ->
;; Transportation (Mid-level-ontology.kif:25059).
(query
  (exists (?TRIP ?VEHICLE)
    (and
      (instance ?TRIP Transportation)
      (instance ?VEHICLE Vehicle)
      (instrument ?TRIP ?VEHICLE)
      (subProcess ?TRIP CSR017Service))))

(answer yes)
