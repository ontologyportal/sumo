;;------------------------------------------------------------------------------
;; File     : CSR057_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Blizzard snowfall and visibility
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : SierraBlizzard is an observed blizzard. Infer a solid-precipitation subprocess and sub-400-meter visibility in an area affected by that storm.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0017
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR057_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance SierraBlizzard Blizzard)

;; Reasoning: Weather.kif Blizzard witness rule produces Snowing; Snowing is Precipitation
;; and its state is Solid. The visibility witness is for that same SierraBlizzard.
(query
  (and
    (exists (?SNOW)
      (and
        (instance ?SNOW Precipitation)
        (subProcess ?SNOW SierraBlizzard)
        (precipitationState ?SNOW Solid)))
    (exists (?AREA ?DISTANCE)
      (and
        (instance ?AREA GeographicArea)
        (eventLocated SierraBlizzard ?AREA)
        (visibilityInMeteorology
          ?AREA
          (WhenFn SierraBlizzard)
          (MeasureFn ?DISTANCE Meter))
        (lessThan ?DISTANCE 400.0)))))

(answer yes)
