;;------------------------------------------------------------------------------
;; File     : CSR028+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Air trip path classification
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then AirTransitway -> Transitway (Transportation.kif:1330).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0015
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR028+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

;; Scenario
(instance CSR028Trip AirTransportation)

(path CSR028Trip CSR028Route)

;; Reasoning: Instantiate the scenario; apply the domain rule, then AirTransitway ->
;; Transitway (Transportation.kif:1330).
(query
  (and (instance CSR028Route Transitway) (instance CSR028Route GeographicArea)))

(answer yes)
