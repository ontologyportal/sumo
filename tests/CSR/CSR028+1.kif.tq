;;------------------------------------------------------------------------------
;; File     : CSR028+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Air trip path classification
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : The path of an air transportation event is an air transitway and a geographic area.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0015
;;
;; Status   : Theorem
;; Comments : Combines the air-path rule with AirTransitway subclass Transitway subclass GeographicArea.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR028+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

(query
  (=>
    (and
      (instance ?TRIP AirTransportation)
      (path ?TRIP ?ROUTE))
    (and
      (instance ?ROUTE AirTransitway)
      (instance ?ROUTE GeographicArea))))

(answer yes)
