;;------------------------------------------------------------------------------
;; File     : CSR019+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Airport apron location
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Airport -> TransitTerminal (Transportation.kif:1347).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0006
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR019+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

;; Scenario
(instance CSR019Apron AirportApron)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Airport ->
;; TransitTerminal (Transportation.kif:1347).
(query
  (exists (?AIRPORT)
    (and
      (instance ?AIRPORT TransitTerminal)
      (instance ?AIRPORT GeographicArea)
      (located CSR019Apron ?AIRPORT))))

(answer yes)
