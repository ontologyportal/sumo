;;------------------------------------------------------------------------------
;; File     : CSR021+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Distinct tracks in a multiple-track railway
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then StationaryArtifact -> Artifact (Merge.kif:20280).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR021+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

;; Scenario
(instance CSR021Railway MultipleTrackRailway)

;; Reasoning: Instantiate the scenario; apply the domain rule, then StationaryArtifact ->
;; Artifact (Merge.kif:20280).
(query
  (exists (?TRACK1 ?TRACK2)
    (and
      (instance ?TRACK1 Artifact)
      (instance ?TRACK2 StationaryArtifact)
      (not (equal ?TRACK1 ?TRACK2))
      (part ?TRACK1 CSR021Railway)
      (part ?TRACK2 CSR021Railway))))

(answer yes)
