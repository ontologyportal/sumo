;;------------------------------------------------------------------------------
;; File     : CSR013+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Supernova causes a light-radiation event
;; Version  : Merge.kif + Mid-level-ontology.kif + Astronomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then NaturalProcess -> Process (Merge.kif:13406).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Astronomy.kif
;; Names    : SMO_AST_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR013+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Astronomy.kif)

;; Scenario
(instance CSR013Supernova Supernova)

;; Reasoning: Instantiate the scenario; apply the domain rule, then NaturalProcess ->
;; Process (Merge.kif:13406).
(query
  (exists (?LIGHT ?REGION)
    (and
      (instance CSR013Supernova Process)
      (instance ?LIGHT RadiatingElectromagnetic)
      (instance ?REGION Region)
      (patient ?LIGHT ?REGION)
      (causes CSR013Supernova ?LIGHT))))

(answer yes)
