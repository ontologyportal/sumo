;;------------------------------------------------------------------------------
;; File     : CSR015+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Aircraft in an air transportation service
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Transportation -> Translocation (Merge.kif:14889).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0002
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR015+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

;; Scenario
(instance CSR015Service AirTransportationService)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Transportation ->
;; Translocation (Merge.kif:14889).
(query
  (exists (?AIR ?CRAFT)
    (and
      (instance ?AIR Translocation)
      (instance ?CRAFT Aircraft)
      (instrument ?AIR ?CRAFT)
      (subProcess ?AIR CSR015Service))))

(answer yes)
