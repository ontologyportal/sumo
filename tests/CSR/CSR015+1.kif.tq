;;------------------------------------------------------------------------------
;; File     : CSR015+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Aircraft in an air transportation service
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : An air transportation service has an aircraft-instrumented transportation subprocess.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0002
;;
;; Status   : Theorem
;; Comments : Combines the air-service witness rule with AirTransportation subclass Transportation.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR015+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?SERVICE AirTransportationService)
    (exists (?AIR ?CRAFT)
      (and
        (instance ?AIR Transportation)
        (instance ?CRAFT Aircraft)
        (instrument ?AIR ?CRAFT)
        (subProcess ?AIR ?SERVICE)))))

(answer yes)
