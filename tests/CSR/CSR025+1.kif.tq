;;------------------------------------------------------------------------------
;; File     : CSR025+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Street parking lies on a transitway
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif + TransportDetail.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every street-parking region lies on a street that is a transitway.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif, TransportDetail.kif
;; Names    : SMO_TRN_0012
;;
;; Status   : Theorem
;; Comments : Combines street-parking placement with Street, Roadway, and LandTransitway classification.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR025+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)
(include TransportDetail.kif)

(query
  (=>
    (instance ?PARK StreetParking)
    (exists (?STREET)
      (and
        (instance ?STREET Street)
        (instance ?STREET Transitway)
        (orientation ?PARK ?STREET On)))))

(answer yes)
