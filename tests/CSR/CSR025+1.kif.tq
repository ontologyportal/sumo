;;------------------------------------------------------------------------------
;; File     : CSR025+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Street parking lies on a transitway
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif + TransportDetail.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Street -> Roadway (Transportation.kif:1853).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif, TransportDetail.kif
;; Names    : SMO_TRN_0012
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR025+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)
(include TransportDetail.kif)

;; Scenario
(instance CSR025Park StreetParking)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Street -> Roadway
;; (Transportation.kif:1853).
(query
  (exists (?STREET)
    (and
      (instance ?STREET Roadway)
      (instance ?STREET Transitway)
      (orientation CSR025Park ?STREET On))))

(answer yes)
