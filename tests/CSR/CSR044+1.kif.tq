;;------------------------------------------------------------------------------
;; File     : CSR044+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Snow carries crystalline ice
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : A snowing event is solid precipitation that transfers a collection containing monocrystalline ice.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0004
;;
;; Status   : Theorem
;; Comments : Combines the Snowing state and transferred-ice rules.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR044+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (instance ?SNOWING Snowing)
    (and
      (instance ?SNOWING Precipitation)
      (precipitationState ?SNOWING Solid)
      (exists (?COLLECTION ?ICE)
        (and
          (instance ?COLLECTION CollectionOfObjects)
          (instance ?ICE Ice)
          (attribute ?ICE MonoCrystalline)
          (member ?ICE ?COLLECTION)
          (objectTransferred ?SNOWING ?COLLECTION))))))

(answer yes)
