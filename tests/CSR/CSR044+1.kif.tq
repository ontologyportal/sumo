;;------------------------------------------------------------------------------
;; File     : CSR044+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Snow carries crystalline ice
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Precipitation -> WeatherProcess (Merge.kif:14332).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR044+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR044Snowing Snowing)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Precipitation ->
;; WeatherProcess (Merge.kif:14332).
(query
  (and
    (instance CSR044Snowing WeatherProcess)
    (precipitationState CSR044Snowing Solid)
    (exists (?COLLECTION ?ICE)
      (and
        (instance ?COLLECTION CollectionOfObjects)
        (instance ?ICE Ice)
        (attribute ?ICE MonoCrystalline)
        (member ?ICE ?COLLECTION)
        (objectTransferred CSR044Snowing ?COLLECTION)))))

(answer yes)
