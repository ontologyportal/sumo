;;------------------------------------------------------------------------------
;; File     : CSR012+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Sol emits electromagnetic radiation
;; Version  : Merge.kif + Mid-level-ontology.kif + Astronomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : Classify the observed solar radiation through the radiation/motion hierarchy to Process.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Astronomy.kif
;; Names    : SMO_AST_0007
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR012+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Astronomy.kif)

;; Scenario
(instance SolarSurveyEmission RadiatingElectromagnetic)

(origin SolarSurveyEmission Sol)

;; Reasoning: Classify the observed solar radiation through the radiation/motion hierarchy
;; to Process.
(query
  (and (instance SolarSurveyEmission Process) (origin SolarSurveyEmission Sol)))

(answer yes)
