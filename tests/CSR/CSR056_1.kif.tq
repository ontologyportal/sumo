;;------------------------------------------------------------------------------
;; File     : CSR056_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Tropical storm sustained wind range
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then GeographicArea -> Region (Merge.kif:18162).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0016
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR056_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR056Storm TropicalStorm)

;; Reasoning: Instantiate the scenario; apply the domain rule, then GeographicArea ->
;; Region (Merge.kif:18162).
(query
  (exists (?AREA ?SPEED)
    (and
      (instance ?AREA Region)
      (eventLocated CSR056Storm ?AREA)
      (equal
        (MeasureFn ?SPEED MilesPerHour)
        (Mean1MinuteWindSpeedFn ?AREA (WhenFn CSR056Storm)))
      (greaterThanOrEqualTo ?SPEED 39.0)
      (lessThanOrEqualTo ?SPEED 74.0))))

(answer yes)
