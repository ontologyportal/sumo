;;------------------------------------------------------------------------------
;; File     : CSR052_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Clear sky cloud-cover bound
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then (lessThan CSR052Fraction 0.3) -> a weaker numeric bound by comparison transitivity.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0012
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR052_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR052Area GeographicArea)

(instance CSR052Weather ClearWeather)

(eventLocated CSR052Weather CSR052Area)

(cloudCoverFraction CSR052Area CSR052Fraction)

;; Reasoning: Instantiate the scenario; apply the domain rule, then (lessThan
;; CSR052Fraction 0.3) -> a weaker numeric bound by comparison transitivity.
(query
  (lessThan CSR052Fraction 0.5))

(answer yes)
