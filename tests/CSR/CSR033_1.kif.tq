;; ======================================================
;; Fuel sufficiency using miles per US gallon
;; Verify 700 gallons covers a 500-gallon trip plus a 100-gallon reserve.
;; ======================================================
(note CSR033_1)
(category CSR)
(minLang tff)
(time 60)

;; Vehicle and flight: identify the powered vehicle for this synthetic scenario.
(instance TestAircraft PoweredVehicle)
(instance TestFlight Flying)
(patient TestFlight TestAircraft)

;; Route and distance: travel 1000 miles along the specified route.
(instance TestRoute Transitway)
(path TestFlight TestRoute)
(instance TestDistance LengthMeasure)
(equal TestDistance (MeasureFn 1000 Mile))
(distanceOnPath TestDistance TestRoute)

;; Assumed efficiency: 2 miles per US gallon implies 500 gallons of trip fuel.
(instance TestEfficiency FunctionQuantity)
(equal TestEfficiency (PerFn (MeasureFn 2 Mile) (MeasureFn 1 UnitedStatesGallon)))
(fuelEfficiency TestAircraft TestEfficiency)

;; Reserve: require an additional 100 US gallons.
(instance TestReserve PhysicalQuantity)
(equal TestReserve (MeasureFn 100 UnitedStatesGallon))
(requiredFlightFuelReserve TestFlight TestReserve)

;; Available fuel: 700 US gallons exceeds the 600-gallon total requirement.
(instance TestAvailable PhysicalQuantity)
(equal TestAvailable (MeasureFn 700 UnitedStatesGallon))
(availableFlightFuel TestFlight TestAvailable)

;; Question: Is the available fuel sufficient for the calculated trip and reserve?
(query (instance TestFlight FuelSufficientFlight))
(answer yes)
