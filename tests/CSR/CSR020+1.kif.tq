;;------------------------------------------------------------------------------
;; File     : CSR020+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Subway route is a tunnel
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Tunnel -> LandTransitway (Transportation.kif:1840).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0007
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR020+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

;; Scenario
(instance CSR020System SubwaySystem)

(routeInSystem CSR020Route CSR020System)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Tunnel ->
;; LandTransitway (Transportation.kif:1840).
(query
  (and (instance CSR020Route LandTransitway) (instance CSR020Route Transitway)))

(answer yes)
