;;------------------------------------------------------------------------------
;; File     : CSR020+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Subway route is a tunnel
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : A route in a subway system is a tunnel and a transitway.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0007
;;
;; Status   : Theorem
;; Comments : Combines the subway route rule with Tunnel subclass LandTransitway subclass Transitway.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR020+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

(query
  (=>
    (and
      (instance ?SYSTEM SubwaySystem)
      (routeInSystem ?ROUTE ?SYSTEM))
    (and
      (instance ?ROUTE Tunnel)
      (instance ?ROUTE Transitway))))

(answer yes)
