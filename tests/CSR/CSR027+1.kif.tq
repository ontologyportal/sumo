;;------------------------------------------------------------------------------
;; File     : CSR027+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Transitway junction connects two routes
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then GeographicArea -> Region (Merge.kif:18162).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0014
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR027+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

;; Scenario
(instance CSR027Junction TransitwayJunction)

;; Reasoning: Instantiate the scenario; apply the domain rule, then GeographicArea ->
;; Region (Merge.kif:18162).
(query
  (exists (?ROUTE1 ?ROUTE2)
    (and
      (instance ?ROUTE1 Region)
      (instance ?ROUTE2 GeographicArea)
      (not (equal ?ROUTE1 ?ROUTE2))
      (connects CSR027Junction ?ROUTE1 ?ROUTE2))))

(answer yes)
