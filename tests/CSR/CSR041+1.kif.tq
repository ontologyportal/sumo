;;------------------------------------------------------------------------------
;; File     : CSR041+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Surface wind speed and source direction
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Use the known opposite cardinal directions and the surface-wind bridge rules to infer the harbor observation speed and source direction.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0001
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR041+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance HarborWeatherStation GeographicArea)

(instance HarborWindSpeed PhysicalQuantity)

(surfaceWindVelocity HarborWeatherStation HarborWindSpeed South)

;; Reasoning: Use the known opposite cardinal directions and the surface-wind bridge rules
;; to infer the harbor observation speed and source direction.
(query
  (and
    (surfaceWindSpeed HarborWeatherStation HarborWindSpeed)
    (surfaceWindDirection HarborWeatherStation North)))

(answer yes)
