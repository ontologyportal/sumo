;;------------------------------------------------------------------------------
;; File     : CSR041+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Surface wind speed and source direction
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : A surface wind velocity gives its speed and the direction from which the wind comes.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0001
;;
;; Status   : Theorem
;; Comments : Combines surfaceWindVelocity with oppositeDirection.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR041+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (surfaceWindVelocity ?PLACE ?SPEED ?TOWARD)
      (oppositeDirection ?TOWARD ?FROM))
    (and
      (surfaceWindSpeed ?PLACE ?SPEED)
      (surfaceWindDirection ?PLACE ?FROM))))

(answer yes)
