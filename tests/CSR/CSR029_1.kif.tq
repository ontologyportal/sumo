;; ======================================================
;; Runway too short for the assessed landing
;; Verify a runway-length violation: 1500 meters required, 1200 available.
;; ======================================================
(note CSR029_1)
(category CSR)
(minLang tff)
(time 60)

;; Aircraft and airfield: identify the aircraft and its destination runway.
(instance RunwayTestAircraft Aircraft)
(instance RunwayTestAirfield Airport)
(instance RunwayTestRunway Runway)
(part RunwayTestRunway RunwayTestAirfield)

;; Proposed landing: connect the aircraft to the destination runway.
(instance RunwayTestLanding Landing)
(patient RunwayTestLanding RunwayTestAircraft)
(destination RunwayTestLanding RunwayTestRunway)

;; Assessed requirement: this landing needs at least 1500 meters.
(instance RunwayTestRequiredLength LengthMeasure)
(equal RunwayTestRequiredLength (MeasureFn 1500 Meter))
(minimumLandingRunwayLength RunwayTestLanding RunwayTestRequiredLength)

;; Available distance: the runway provides only 1200 meters.
(instance RunwayTestAvailableLength LengthMeasure)
(equal RunwayTestAvailableLength (MeasureFn 1200 Meter))
(availableLandingRunwayLength RunwayTestRunway RunwayTestAvailableLength)

;; Question: Does the proposed landing violate the runway-length requirement?
(query (violatesLandingRunwayRequirement RunwayTestLanding RunwayTestRunway))
(answer yes)
