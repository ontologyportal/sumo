;;------------------------------------------------------------------------------
;; File     : CSR047+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Icing deposits solid ice
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : An icing event is a freezing process that deposits polycrystalline ice on a solid object.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0007
;;
;; Status   : Theorem
;; Comments : Combines the Icing subclass and deposition witness axioms.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR047+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (instance ?ICING Icing)
    (and
      (instance ?ICING Freezing)
      (exists (?ICE ?OBJECT)
        (and
          (instance ?ICE Ice)
          (attribute ?ICE PolyCrystalline)
          (patient ?ICING ?ICE)
          (instance ?OBJECT Object)
          (attribute ?OBJECT Solid)
          (destination ?ICING ?OBJECT)
          (meetsSpatially ?ICE ?OBJECT))))))

(answer yes)
