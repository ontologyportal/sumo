;;------------------------------------------------------------------------------
;; File     : CSR047+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Icing deposits solid ice
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Freezing -> StateChange (Merge.kif:18107).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0007
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR047+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR047Icing Icing)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Freezing -> StateChange
;; (Merge.kif:18107).
(query
  (and
    (instance CSR047Icing StateChange)
    (exists (?ICE ?OBJECT)
      (and
        (instance ?ICE Ice)
        (attribute ?ICE PolyCrystalline)
        (patient CSR047Icing ?ICE)
        (instance ?OBJECT Object)
        (attribute ?OBJECT Solid)
        (destination CSR047Icing ?OBJECT)
        (meetsSpatially ?ICE ?OBJECT)))))

(answer yes)
