;;------------------------------------------------------------------------------
;; File     : CSR014+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Vehicle and rider in a transportation service
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then TransportationDevice -> Device (Merge.kif:20672).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0001
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR014+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

;; Scenario
(instance CSR014Service TransportationService)

;; Reasoning: Instantiate the scenario; apply the domain rule, then TransportationDevice ->
;; Device (Merge.kif:20672).
(query
  (exists (?VEHICLE ?TRIP ?RIDER)
    (and
      (instance ?VEHICLE Device)
      (instance ?TRIP Translocation)
      (patient ?TRIP ?RIDER)
      (instrument ?TRIP ?VEHICLE)
      (subProcess ?TRIP CSR014Service))))

(answer yes)
