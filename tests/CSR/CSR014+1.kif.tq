;;------------------------------------------------------------------------------
;; File     : CSR014+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Vehicle and rider in a transportation service
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : A transportation service has a vehicle-instrumented transport subprocess carrying a rider.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0001
;;
;; Status   : Theorem
;; Comments : Combines the service witness rule with Vehicle and Transportation subclass hierarchies.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR014+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?SERVICE TransportationService)
    (exists (?VEHICLE ?TRIP ?RIDER)
      (and
        (instance ?VEHICLE TransportationDevice)
        (instance ?TRIP Translocation)
        (patient ?TRIP ?RIDER)
        (instrument ?TRIP ?VEHICLE)
        (subProcess ?TRIP ?SERVICE)))))

(answer yes)
