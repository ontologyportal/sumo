;;------------------------------------------------------------------------------
;; File     : CSR006+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : A newly surveyed moon belongs to its star's planetary system
;; Version  : Merge.kif + Mid-level-ontology.kif + Astronomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : A survey identifies a star in a planetary system, a planet
;;          : orbiting that star, and a moon orbiting the planet. Does the moon
;;          : belong to the same planetary system as the star?
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Astronomy.kif
;; Names    : SMO_AST_0001
;;
;; Status   : Theorem
;; Comments : Requires two applications of planetary-system membership:
;;          : first infer the planet's membership, then the moon's membership.
;;          : Only the star's membership is asserted; all survey objects are
;;          : local to this scenario rather than named Solar System objects.
;;          : Source verified with the native prover using the declared KIF files.
;;          : Packaged TPTP translation has not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR006+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Astronomy.kif)

; Assertions: observations from a fictional astronomical survey.
(instance SurveySystem PlanetarySystem)
(instance SurveyStar Star)
(member SurveyStar SurveySystem)
(instance SurveyPlanet Planet)
(orbits SurveyPlanet SurveyStar)
(instance SurveyMoon Moon)
(orbits SurveyMoon SurveyPlanet)

; Conjecture: the moon belongs to the star's planetary system, even though
; the observed orbit links it to the planet rather than directly to the star.
(query
  (member SurveyMoon SurveySystem))

(answer yes)
