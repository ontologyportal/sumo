;;------------------------------------------------------------------------------
;; File     : CSR046+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Freezing rain becomes solid
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Liquid freezing rain makes its water-solution patient solid immediately after the event.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0006
;;
;; Status   : Theorem
;; Comments : Combines the FreezingRain state with its immediate-future patient rule.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR046+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?PROCESS FreezingRain)
      (patient ?PROCESS ?WATER)
      (instance ?WATER WaterSolution))
    (and
      (precipitationState ?PROCESS Liquid)
      (holdsDuring
        (ImmediateFutureFn (WhenFn ?PROCESS))
        (attribute ?WATER Solid)))))

(answer yes)
