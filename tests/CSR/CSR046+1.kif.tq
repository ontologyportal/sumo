;;------------------------------------------------------------------------------
;; File     : CSR046+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Freezing rain becomes solid
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then attribute -> property (Merge.kif:2278).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0006
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR046+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR046Process FreezingRain)

(patient CSR046Process CSR046Water)

(instance CSR046Water WaterSolution)

;; Reasoning: Instantiate the scenario; apply the domain rule, then attribute -> property
;; (Merge.kif:2278).
(query
  (and
    (precipitationState CSR046Process Liquid)
    (holdsDuring
      (ImmediateFutureFn (WhenFn CSR046Process))
      (property CSR046Water Solid))))

(answer yes)
