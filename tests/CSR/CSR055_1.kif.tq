;;------------------------------------------------------------------------------
;; File     : CSR055_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Strong wind speed threshold
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then (greaterThan CSR055Speed 58) -> a weaker numeric bound by comparison transitivity.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0015
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR055_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR055Wind StrongWind)

(eventLocated CSR055Wind CSR055Area)

(instance CSR055Area GeographicArea)

(surfaceWindSpeed CSR055Area (MeasureFn CSR055Speed MilesPerHour))

;; Reasoning: Instantiate the scenario; apply the domain rule, then (greaterThan
;; CSR055Speed 58) -> a weaker numeric bound by comparison transitivity.
(query
  (greaterThan CSR055Speed 55.0))

(answer yes)
