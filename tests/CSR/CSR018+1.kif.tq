;;------------------------------------------------------------------------------
;; File     : CSR018+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Airline fleet contains an aircraft
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Fleet -> CollectionOfObjects (Mid-level-ontology.kif:5280).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0005
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR018+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

;; Scenario
(instance CSR018Airline Airline)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Fleet ->
;; CollectionOfObjects (Mid-level-ontology.kif:5280).
(query
  (exists (?FLEET ?CRAFT)
    (and
      (instance ?FLEET CollectionOfObjects)
      (possesses CSR018Airline ?FLEET)
      (member ?CRAFT ?FLEET)
      (instance ?CRAFT Aircraft)
      (instance ?CRAFT Vehicle))))

(answer yes)
