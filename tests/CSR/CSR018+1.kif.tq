;;------------------------------------------------------------------------------
;; File     : CSR018+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Airline fleet contains an aircraft
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every airline possesses a fleet containing an aircraft, which is a vehicle.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0005
;;
;; Status   : Theorem
;; Comments : Combines the airline fleet witness rule with Aircraft subclass Vehicle.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR018+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?AIRLINE Airline)
    (exists (?FLEET ?CRAFT)
      (and
        (instance ?FLEET Fleet)
        (possesses ?AIRLINE ?FLEET)
        (member ?CRAFT ?FLEET)
        (instance ?CRAFT Aircraft)
        (instance ?CRAFT Vehicle)))))

(answer yes)
