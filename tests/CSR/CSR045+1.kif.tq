;;------------------------------------------------------------------------------
;; File     : CSR045+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Sleet contains rain and melting snow
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Precipitation -> WeatherProcess (Merge.kif:14332).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0005
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR045+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR045Sleet Sleeting)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Precipitation ->
;; WeatherProcess (Merge.kif:14332).
(query
  (exists (?COLLECTION ?DROP ?FLAKE ?MELT)
    (and
      (instance CSR045Sleet WeatherProcess)
      (instance ?COLLECTION CollectionOfObjects)
      (objectTransferred CSR045Sleet ?COLLECTION)
      (instance ?DROP Raindrop)
      (instance ?FLAKE Snowflake)
      (member ?DROP ?COLLECTION)
      (member ?FLAKE ?COLLECTION)
      (instance ?MELT Melting)
      (subProcess ?MELT CSR045Sleet)
      (patient ?MELT ?FLAKE))))

(answer yes)
