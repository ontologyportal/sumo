;;------------------------------------------------------------------------------
;; File     : CSR045+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Sleet contains rain and melting snow
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : A sleeting event transfers both a raindrop and a snowflake, with the snowflake undergoing melting.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0005
;;
;; Status   : Theorem
;; Comments : Uses the Sleeting collection and Melting subprocess witness.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR045+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (instance ?SLEET Sleeting)
    (exists (?COLLECTION ?DROP ?FLAKE ?MELT)
      (and
        (instance ?SLEET Precipitation)
        (instance ?COLLECTION CollectionOfObjects)
        (objectTransferred ?SLEET ?COLLECTION)
        (instance ?DROP Raindrop)
        (instance ?FLAKE Snowflake)
        (member ?DROP ?COLLECTION)
        (member ?FLAKE ?COLLECTION)
        (instance ?MELT Melting)
        (subProcess ?MELT ?SLEET)
        (patient ?MELT ?FLAKE)))))

(answer yes)
