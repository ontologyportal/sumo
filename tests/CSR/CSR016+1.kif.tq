;;------------------------------------------------------------------------------
;; File     : CSR016+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Vehicle in a land transportation service
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then LandTransportation -> Transportation (Mid-level-ontology.kif:25091).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0003
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR016+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

;; Scenario
(instance CSR016Service LandTransportationService)

;; Reasoning: Instantiate the scenario; apply the domain rule, then LandTransportation ->
;; Transportation (Mid-level-ontology.kif:25091).
(query
  (exists (?TRIP ?VEHICLE)
    (and
      (instance ?TRIP Transportation)
      (instance ?VEHICLE Vehicle)
      (instrument ?TRIP ?VEHICLE)
      (subProcess ?TRIP CSR016Service))))

(answer yes)
