;;------------------------------------------------------------------------------
;; File     : CSR042+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Moving air in a weather system
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Translocation -> Motion (Merge.kif:14838).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0002
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR042+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR042System WeatherSystem)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Translocation -> Motion
;; (Merge.kif:14838).
(query
  (exists (?MOVE ?FLOW)
    (and
      (instance ?MOVE Motion)
      (instance ?FLOW AirStream)
      (located ?FLOW EarthsAtmosphere)
      (patient ?MOVE ?FLOW)
      (subProcess ?MOVE CSR042System))))

(answer yes)
