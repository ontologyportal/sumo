;;------------------------------------------------------------------------------
;; File     : CSR058_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Fog visibility threshold
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then (lessThan CSR058Distance 1000.0) -> a weaker numeric bound by comparison transitivity.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0018
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR058_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR058Fog Fogging)

(eventLocated CSR058Fog CSR058Area)

(instance CSR058Area GeographicArea)

(instance CSR058Air AtmosphericRegion)

(orientation CSR058Air CSR058Area Above)

(instance CSR058Aerosol Aerosal)

(locatedAtTime CSR058Aerosol (WhenFn CSR058Fog) CSR058Air)

(instance (MeasureFn CSR058Distance Meter) LengthMeasure)

(visibilityInMeteorology
  CSR058Area
  (WhenFn CSR058Fog)
  (MeasureFn CSR058Distance Meter))

;; Reasoning: Instantiate the scenario; apply the domain rule, then (lessThan
;; CSR058Distance 1000.0) -> a weaker numeric bound by comparison transitivity.
(query
  (lessThan CSR058Distance 1200.0))

(answer yes)
