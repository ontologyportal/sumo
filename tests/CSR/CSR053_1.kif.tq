;;------------------------------------------------------------------------------
;; File     : CSR053_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Partly cloudy sky fraction
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then (greaterThanOrEqualTo CSR053Fraction 0.3) -> a weaker numeric bound by comparison transitivity.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0013
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR053_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR053Area GeographicArea)

(instance CSR053Weather PartlyCloudyWeather)

(eventLocated CSR053Weather CSR053Area)

(cloudCoverFraction CSR053Area CSR053Fraction)

;; Reasoning: Instantiate the scenario; apply the domain rule, then (greaterThanOrEqualTo
;; CSR053Fraction 0.3) -> a weaker numeric bound by comparison transitivity.
(query
  (and
    (greaterThanOrEqualTo CSR053Fraction 0.2)
    (lessThanOrEqualTo CSR053Fraction 0.7)))

(answer yes)
