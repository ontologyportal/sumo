;; ======================================================
;; F-22 carrier incompatibility despite arresting equipment
;; Verify tailhook and arresting gear presence alongside explicit carrier incompatibility.
;; ======================================================
(minLang tff)
(note CSR031_1)
(category CSR)
(time 60)

;; Aircraft and landing: propose a carrier landing by a standard F-22.
(instance RaptorTest001 F22Raptor)
(instance TestLanding Landing)
(patient TestLanding RaptorTest001)

;; Destination: identify the aircraft carrier for the proposed landing.
(instance TestCarrier AircraftCarrier)
(destination TestLanding TestCarrier)

;; Equipment: assert installed arresting gear; its presence does not establish compatibility.
(instance TestCarrierArrestingGear ArrestingGear)
(part TestCarrierArrestingGear TestCarrier)

;; Question: Does the F-22 have a tailhook and the carrier have arresting gear, while remaining incompatible?
(query
  (and
    (exists (?HOOK)
      (and
        (instance ?HOOK Tailhook)
        (part ?HOOK RaptorTest001)))
    (exists (?GEAR)
      (and
        (instance ?GEAR ArrestingGear)
        (part ?GEAR TestCarrier)))
    (not
      (carrierLandingCompatible RaptorTest001 TestCarrier))))
(answer yes)
