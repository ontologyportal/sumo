;;------------------------------------------------------------------------------
;; File     : CSR024+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Merchant marine ship registration
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then ShipRegistration -> ContentBearingObject (Transportation.kif:1193).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0011
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR024+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

;; Scenario
(instance CSR024Ship Ship)

(instance CSR024Area GeopoliticalArea)

(member CSR024Ship (MerchantMarineFn CSR024Area))

;; Reasoning: Instantiate the scenario; apply the domain rule, then ShipRegistration ->
;; ContentBearingObject (Transportation.kif:1193).
(query
  (exists (?REGISTRATION)
    (and
      (instance ?REGISTRATION ContentBearingObject)
      (possesses CSR024Ship ?REGISTRATION)
      (subsumesContentInstance (ShipRegisterFn CSR024Area) ?REGISTRATION))))

(answer yes)
