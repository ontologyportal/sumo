;;------------------------------------------------------------------------------
;; File     : CSR051_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : High-pressure system reading
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then barometricPressure -> measure (Merge.kif:9890).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0011
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR051_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR051System HighPressureWeatherSystem)

(eventLocated CSR051System CSR051Area)

;; Reasoning: Instantiate the scenario; apply the domain rule, then barometricPressure ->
;; measure (Merge.kif:9890).
(query
  (exists (?PRESSURE)
    (and
      (measure CSR051Area (MeasureFn ?PRESSURE InchMercury))
      (greaterThan ?PRESSURE 30.2))))

(answer yes)
