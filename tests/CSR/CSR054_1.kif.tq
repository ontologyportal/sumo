;;------------------------------------------------------------------------------
;; File     : CSR054_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Overcast sky cloud-cover bound
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then (greaterThan CSR054Fraction 0.7) -> a weaker numeric bound by comparison transitivity.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0014
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR054_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR054Area GeographicArea)

(instance CSR054Weather OvercastWeather)

(eventLocated CSR054Weather CSR054Area)

(cloudCoverFraction CSR054Area CSR054Fraction)

;; Reasoning: Instantiate the scenario; apply the domain rule, then (greaterThan
;; CSR054Fraction 0.7) -> a weaker numeric bound by comparison transitivity.
(query
  (greaterThan CSR054Fraction 0.6))

(answer yes)
