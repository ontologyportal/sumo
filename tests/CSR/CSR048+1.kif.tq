;;------------------------------------------------------------------------------
;; File     : CSR048+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Drought excludes overlapping rain
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Drought excludes overlapping Raining; HeavyRaining is a subclass of Raining, so an overlapping downpour is also excluded.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR048+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance ValleyDrought Drought)

(instance ValleySurveyArea GeographicArea)

(eventLocated ValleyDrought ValleySurveyArea)

;; Reasoning: Drought excludes overlapping Raining; HeavyRaining is a subclass of Raining,
;; so an overlapping downpour is also excluded.
(query
  (not
    (exists (?RAIN ?REGION)
      (and
        (instance ?RAIN HeavyRaining)
        (instance ?REGION Region)
        (eventLocated ?RAIN ?REGION)
        (overlapsSpatially ?REGION ValleySurveyArea)
        (overlapsTemporally ?RAIN ValleyDrought)))))

(answer yes)
