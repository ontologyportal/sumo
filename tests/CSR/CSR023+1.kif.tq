;;------------------------------------------------------------------------------
;; File     : CSR023+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Container ship type and cargo
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then WaterVehicle -> Vehicle (Mid-level-ontology.kif:5244).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0010
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR023+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

;; Scenario
(instance CSR023Ship ContainerShip)

;; Reasoning: Instantiate the scenario; apply the domain rule, then WaterVehicle -> Vehicle
;; (Mid-level-ontology.kif:5244).
(query
  (and (instance CSR023Ship Vehicle) (cargoType CSR023Ship ShipContainer)))

(answer yes)
