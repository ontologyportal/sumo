;; ======================================================
;; Explicit fuel insufficiency from assessed quantities
;; Verify 1000 pounds cannot cover 900 pounds of trip fuel plus 200 pounds of reserve.
;; ======================================================

(note CSR037_1)
(category CSR)
(minLang tff)
(time 60)

;; Flight: identify the proposed flight being assessed.
(instance ResourceSufficiencyTestFlight Flying)

;; Trip requirement: supply an assessed consumption of 900 lb.
(instance TestTripFuel MassMeasure)
(equal TestTripFuel (MeasureFn 900 PoundMass))
(requiredFlightFuel ResourceSufficiencyTestFlight TestTripFuel)

;; Reserve requirement: add 200 lb beyond the trip fuel.
(instance TestReserveFuel MassMeasure)
(equal TestReserveFuel (MeasureFn 200 PoundMass))
(requiredFlightFuelReserve ResourceSufficiencyTestFlight TestReserveFuel)

;; Available fuel: only 1000 lb is usable for the 1100 lb total requirement.
(instance TestAvailableFuel MassMeasure)
(equal TestAvailableFuel (MeasureFn 1000 PoundMass))
(availableFlightFuel ResourceSufficiencyTestFlight TestAvailableFuel)

;; Question: Is the flight explicitly not fuel sufficient because 1000 lb is less than 1100 lb?
(query (not (instance ResourceSufficiencyTestFlight FuelSufficientFlight)))
(answer yes)
