;;------------------------------------------------------------------------------
;; File     : CSR010+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Rocket as spacecraft and aircraft
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Spacecraft -> Vehicle (Mid-level-ontology.kif:25021).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_AST_0005
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR010+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

;; Scenario
(instance CSR010Rocket Rocket)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Spacecraft -> Vehicle
;; (Mid-level-ontology.kif:25021).
(query
  (and
    (instance CSR010Rocket Vehicle)
    (instance CSR010Rocket Aircraft)
    (instance CSR010Rocket TransportationDevice)))

(answer yes)
