;;------------------------------------------------------------------------------
;; File     : CSR011+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Stellar remnant has a star and formation process
;; Version  : Merge.kif + Mid-level-ontology.kif + Astronomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Star -> AstronomicalBody (Mid-level-ontology.kif:15789).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Astronomy.kif
;; Names    : SMO_AST_0006
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR011+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Astronomy.kif)

;; Scenario
(instance CSR011Remnant StellarRemnant)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Star ->
;; AstronomicalBody (Mid-level-ontology.kif:15789).
(query
  (exists (?STAR ?PROCESS)
    (and
      (instance CSR011Remnant SelfConnectedObject)
      (instance ?STAR AstronomicalBody)
      (instance ?PROCESS NaturalProcess)
      (result ?PROCESS CSR011Remnant)
      (resource ?PROCESS ?STAR))))

(answer yes)
