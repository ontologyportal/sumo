;;------------------------------------------------------------------------------
;; File     : CSR026+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Parking garage contains a geographic area
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif + TransportDetail.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every parking garage is a building containing a parking lot that is a geographic area.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif, TransportDetail.kif
;; Names    : SMO_TRN_0013
;;
;; Status   : Theorem
;; Comments : Combines ParkingGarage classification with the parking-lot witness and its geographic type.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR026+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)
(include TransportDetail.kif)

(query
  (=>
    (instance ?GARAGE ParkingGarage)
    (and
      (instance ?GARAGE Building)
      (exists (?LOT)
        (and
          (instance ?LOT ParkingLot)
          (instance ?LOT GeographicArea)
          (located ?LOT ?GARAGE))))))

(answer yes)
