;;------------------------------------------------------------------------------
;; File     : CSR026+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Parking garage contains a geographic area
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif + TransportDetail.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Building -> StationaryArtifact (Merge.kif:20303).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif, TransportDetail.kif
;; Names    : SMO_TRN_0013
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR026+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)
(include TransportDetail.kif)

;; Scenario
(instance CSR026Garage ParkingGarage)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Building ->
;; StationaryArtifact (Merge.kif:20303).
(query
  (and
    (instance CSR026Garage StationaryArtifact)
    (exists (?LOT)
      (and
        (instance ?LOT ParkingLot)
        (instance ?LOT GeographicArea)
        (located ?LOT CSR026Garage)))))

(answer yes)
