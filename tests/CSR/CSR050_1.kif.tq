;;------------------------------------------------------------------------------
;; File     : CSR050_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Cyclonic storm rotation and pressure
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A cyclonic storm in a region has a rotating subprocess and a low barometric-pressure reading.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0010
;;
;; Status   : Theorem
;; Comments : Combines CyclonicStorm subclass, rotation, and LowPressureWeatherSystem pressure rules.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR050_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?STORM CyclonicStorm)
      (instance ?AREA Region)
      (eventLocated ?STORM ?AREA))
    (and
      (instance ?STORM LowPressureWeatherSystem)
      (exists (?ROTATION)
        (and
          (instance ?ROTATION Rotating)
          (subProcess ?ROTATION ?STORM)))
      (exists (?PRESSURE)
        (and
          (barometricPressure ?AREA (MeasureFn ?PRESSURE InchMercury))
          (lessThan ?PRESSURE 29.5))))))

(answer yes)
