;;------------------------------------------------------------------------------
;; File     : CSR050_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Cyclonic storm rotation and pressure
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then LowPressureWeatherSystem -> WeatherSystem (Weather.kif:890).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0010
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR050_1)
(category CSR)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR050Storm CyclonicStorm)

(instance CSR050Area Region)

(eventLocated CSR050Storm CSR050Area)

;; Reasoning: Instantiate the scenario; apply the domain rule, then
;; LowPressureWeatherSystem -> WeatherSystem (Weather.kif:890).
(query
  (and
    (instance CSR050Storm WeatherSystem)
    (exists (?ROTATION)
      (and (instance ?ROTATION Rotating) (subProcess ?ROTATION CSR050Storm)))
    (exists (?PRESSURE)
      (and
        (barometricPressure CSR050Area (MeasureFn ?PRESSURE InchMercury))
        (lessThan ?PRESSURE 29.5)))))

(answer yes)
