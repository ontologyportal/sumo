;;------------------------------------------------------------------------------
;; File     : CSR049+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Wind measuring device elevation
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : A surface wind speed measurement uses a device at an elevation of ten meters during the measurement.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0009
;;
;; Status   : Theorem
;; Comments : Uses the SurfaceWindSpeedMeasuring device and elevation witness.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note CSR049+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (instance ?MEASUREMENT SurfaceWindSpeedMeasuring)
    (exists (?AREA ?DEVICE ?HEIGHT)
      (and
        (instance ?AREA GeographicArea)
        (instance ?DEVICE Device)
        (eventLocated ?MEASUREMENT ?AREA)
        (instrument ?MEASUREMENT ?DEVICE)
        (instance ?HEIGHT LengthMeasure)
        (equal ?HEIGHT (MeasureFn 10.0 Meter))
        (holdsDuring
          (WhenFn ?MEASUREMENT)
          (elevation ?DEVICE ?HEIGHT))))))

(answer yes)
