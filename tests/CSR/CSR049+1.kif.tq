;;------------------------------------------------------------------------------
;; File     : CSR049+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Wind measuring device elevation
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then GeographicArea -> Region (Merge.kif:18162).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0009
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note CSR049+1)
(category CSR)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance CSR049Measurement SurfaceWindSpeedMeasuring)

;; Reasoning: Instantiate the scenario; apply the domain rule, then GeographicArea ->
;; Region (Merge.kif:18162).
(query
  (exists (?AREA ?DEVICE ?HEIGHT)
    (and
      (instance ?AREA Region)
      (instance ?DEVICE Device)
      (eventLocated CSR049Measurement ?AREA)
      (instrument CSR049Measurement ?DEVICE)
      (instance ?HEIGHT LengthMeasure)
      (equal ?HEIGHT (MeasureFn 10.0 Meter))
      (holdsDuring (WhenFn CSR049Measurement) (elevation ?DEVICE ?HEIGHT)))))

(answer yes)
