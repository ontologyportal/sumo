;; Written by Colin Seymour
;; Tests for Cellular&TelephoneArchitecture.kif
;Meta predicates
(note Communications_3)
(time 30)
(category Communications)

;Conjecture
(query
  (=>
    (and
      (instance ?PHONE MobileCellPhone)
      (instance ?N GPRSNetwork)
      (instance ?BTS BaseTransceiverStation)
      (component ?BTS ?N)
      (instance ?UP Uplink)
      (instance ?DOWN Downlink)
      (origin ?UP ?PHONE)
      (destination ?UP ?BTS)
      (origin ?DOWN ?BTS)
      (destination ?DOWN ?PHONE))
    (connected ?PHONE Internet)))

(answer yes)
