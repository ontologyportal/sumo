; Written by Bradford Sweeter
; Meant to test Astronomy.kif
(note Astronomy_4)
(category Astronomy)

; Assertions
(instance EX1 Exoplanet) 

; Conjecture
(query
  (exists 
    (?STAR) 
    (and 
      (instance ?STAR Star) 
      (orbits EX1 ?STAR) 
      (not 
        (orbits ?STAR EX1)))) )

(answer yes)