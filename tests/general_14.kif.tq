(note TQG14)  ;; boolean version
(category general)

(instance Atom14-1 Atom)

(instance Nucleus14-1 AtomicNucleus)

(part Nucleus14-1 Atom14-1)

(query
  (not
    (exists (?NUCLEUS)
      (and
        (instance ?NUCLEUS AtomicNucleus)
        (part ?NUCLEUS Atom14-1)
        (not
          (equal ?NUCLEUS Nucleus14-1))))))

(answer yes)

