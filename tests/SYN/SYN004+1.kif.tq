;; SYN004+1 -- scenario reasoning test

(note SYN004+1)
(category SYN)

;; Scenario
(instance ScenarioRelation4 QuaternaryPredicate)

(domain ScenarioRelation4 1 Human)

(domain ScenarioRelation4 2 Artifact)

(domain ScenarioRelation4 3 GeographicArea)

(domain ScenarioRelation4 4 TimePosition)

(ScenarioRelation4 ScenarioDeckhand ScenarioCargo ScenarioPort ScenarioTime)

;; Reasoning: Apply the declared predicate argument domains to concrete scenario
;; participants, then Human -> Animal and Artifact -> Object. Avoid the former wrong-arity
;; logical atom.
(query
  (and (instance ScenarioDeckhand Animal) (instance ScenarioCargo Object)))

(answer yes)
