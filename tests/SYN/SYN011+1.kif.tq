;; SYN011+1 -- scenario reasoning test

(note SYN011+1)
(category SYN)

;; Scenario
(instance testRowPred Predicate)

(instance testRowPred VariableArityRelation)

(domain testRowPred 1 Entity)

(domain testRowPred 2 Entity)

(domain testRowPred 3 Entity)

(instance A Entity)

(instance B Entity)

(instance C Entity)

(testRowPred A B C)

(=> (testRowPred @ROW) (equal (ListFn @ROW) TestList))

;; Reasoning: Expand the scenario row/tuple into a named list, substitute list equality,
;; then infer membership of its second item.
(query
  (inList B TestList))

(answer yes)
