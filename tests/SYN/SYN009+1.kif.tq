;; SYN009+1 -- scenario reasoning test

(note SYN009+1)
(category SYN)

;; Scenario
(instance testRowPred Predicate)

(instance testRowPred VariableArityRelation)

(domain testRowPred 1 Entity)

(domain testRowPred 2 Entity)

(domain testRowPred 3 Entity)

(instance A Entity)

(instance B Entity)

(instance C Entity)

(testRowPred A B C)

(=> (testRowPred @ROW) (equal TestList (ListFn @ROW)))

;; Reasoning: Expand the scenario predicate row into TestList, then evaluate its second
;; element. The query is no longer a list tautology independent of the scenario.
(query
  (equal (ListOrderFn TestList 2) B))

(answer yes)
