;; SYN016+1 -- scenario reasoning test

(note SYN016+1)
(category SYN)

;; Scenario
(instance ChildrenOfFn UnaryFunction)

(domain ChildrenOfFn 1 Class)

(range ChildrenOfFn List)

(partition ParentClass ChildA ChildB ChildC)

(=> (partition ?C @ROW) (equal (ChildrenOfFn ?C) (ListFn @ROW)))

;; Reasoning: Expand the partition row into ChildrenOfFn, then infer membership of a
;; particular child class.
(query
  (inList ChildB (ChildrenOfFn ParentClass)))

(answer yes)
