;; SYN005+1 -- scenario reasoning test

(note SYN005+1)
(category SYN)

;; Scenario
(instance ScenarioRelation5 QuintaryPredicate)

(domain ScenarioRelation5 1 Human)

(domain ScenarioRelation5 2 Artifact)

(domain ScenarioRelation5 3 GeographicArea)

(domain ScenarioRelation5 4 TimePosition)

(domain ScenarioRelation5 5 Artifact)

(ScenarioRelation5
  ScenarioDeckhand
  ScenarioCargo
  ScenarioPort
  ScenarioTime
  ScenarioContainer)

;; Reasoning: Apply the declared predicate argument domains to concrete scenario
;; participants, then Human -> Animal and Artifact -> Object. Avoid the former wrong-arity
;; logical atom.
(query
  (and (instance ScenarioDeckhand Animal) (instance ScenarioCargo Object)))

(answer yes)
