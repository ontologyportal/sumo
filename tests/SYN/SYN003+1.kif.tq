;; SYN003+1 -- scenario reasoning test

(note SYN003+1)
(category SYN)

;; Scenario
(instance ScenarioRelation3 TernaryPredicate)

(domain ScenarioRelation3 1 Human)

(domain ScenarioRelation3 2 Artifact)

(domain ScenarioRelation3 3 GeographicArea)

(ScenarioRelation3 ScenarioDeckhand ScenarioCargo ScenarioPort)

;; Reasoning: Apply the declared predicate argument domains to concrete scenario
;; participants, then Human -> Animal and Artifact -> Object. Avoid the former wrong-arity
;; logical atom.
(query
  (and (instance ScenarioDeckhand Animal) (instance ScenarioCargo Object)))

(answer yes)
