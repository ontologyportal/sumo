;; SYN002+1 -- scenario reasoning test

(note SYN002+1)
(category SYN)

;; Scenario
(instance ScenarioRelation2 BinaryPredicate)

(domain ScenarioRelation2 1 Human)

(domain ScenarioRelation2 2 Artifact)

(ScenarioRelation2 ScenarioDeckhand ScenarioCargo)

;; Reasoning: Apply the declared predicate argument domains to concrete scenario
;; participants, then Human -> Animal and Artifact -> Object. Avoid the former wrong-arity
;; logical atom.
(query
  (and (instance ScenarioDeckhand Animal) (instance ScenarioCargo Object)))

(answer yes)
