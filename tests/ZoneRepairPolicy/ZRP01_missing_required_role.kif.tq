;; An agent holding one required role but lacking another required role violates the policy.
(note ZRP01_missing_required_role)
(category general)
(time 30)
(file ZoneRepairPolicy.kif)

(instance Repair1 Repairing)
(instance Org1 Organization)
(instance Obj1 Object)
(instance Zone1 NetworkZone)
(patient Repair1 Obj1)
(possesses Org1 Obj1)
(part Obj1 Zone1)
(instance Worker1 AutonomousAgent)
(instance RoleMaintainer OccupationalRole)
(instance RoleElectrician OccupationalRole)
(not
  (equal RoleMaintainer RoleElectrician))
(requiresRoleForRepair Org1 RoleMaintainer Repair1)
(requiresRoleForRepair Org1 RoleElectrician Repair1)
(agent Repair1 Worker1)
(attribute Worker1 RoleMaintainer)
(not
  (attribute Worker1 RoleElectrician))

(query
  (violatesZoneRepairPolicy Repair1 Org1))
(answer yes)
