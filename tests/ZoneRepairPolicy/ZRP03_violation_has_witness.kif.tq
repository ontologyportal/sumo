;; An asserted violation yields the shared zone, agent and missing-role witness.
(note ZRP03_violation_has_witness)
(category general)
(time 30)
(file ZoneRepairPolicy.kif)

(instance Repair1 Repairing)
(instance Org1 Organization)
(violatesZoneRepairPolicy Repair1 Org1)

(query
  (exists (?ZONE ?AGENT ?OCCUPATION)
    (and
      (repairInZone Repair1 Org1 ?ZONE)
      (agent Repair1 ?AGENT)
      (requiresRoleForRepair Org1 ?OCCUPATION Repair1)
      (not
        (attribute ?AGENT ?OCCUPATION)))))
(answer yes)
