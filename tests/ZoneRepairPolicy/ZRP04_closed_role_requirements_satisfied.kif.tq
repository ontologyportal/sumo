;; Under explicit closure of the agent and required-role lists, with every
;; required role held by every agent, this particular violation is absent.
;; This shows absence of the defined violation, not overall compliance.
(note ZRP04_closed_role_requirements_satisfied)
(category general)
(time 30)
(file ZoneRepairPolicy.kif)

(instance Repair1 Repairing)
(instance Org1 Organization)
(instance Obj1 Object)
(instance Zone1 NetworkZone)
(patient Repair1 Obj1)
(possesses Org1 Obj1)
(part Obj1 Zone1)
(instance Worker1 AutonomousAgent)
(instance RoleMaintainer OccupationalRole)
(requiresRoleForRepair Org1 RoleMaintainer Repair1)
(agent Repair1 Worker1)
(attribute Worker1 RoleMaintainer)
(forall (?A)
  (<=>
    (agent Repair1 ?A)
    (equal ?A Worker1)))
(forall (?R)
  (<=>
    (requiresRoleForRepair Org1 ?R Repair1)
    (equal ?R RoleMaintainer)))

(query
  (not
    (violatesZoneRepairPolicy Repair1 Org1)))
(answer yes)
