;; One unqualified co-agent suffices even when another agent holds the required role.
(note ZRP02_unqualified_coagent)
(category general)
(time 30)
(file ZoneRepairPolicy.kif)

(instance Repair1 Repairing)
(instance Org1 Organization)
(instance Obj1 Object)
(instance Zone1 NetworkZone)
(patient Repair1 Obj1)
(possesses Org1 Obj1)
(part Obj1 Zone1)
(instance WorkerQualified AutonomousAgent)
(instance WorkerUnqualified AutonomousAgent)
(not
  (equal WorkerQualified WorkerUnqualified))
(instance RoleMaintainer OccupationalRole)
(requiresRoleForRepair Org1 RoleMaintainer Repair1)
(agent Repair1 WorkerQualified)
(agent Repair1 WorkerUnqualified)
(attribute WorkerQualified RoleMaintainer)
(not
  (attribute WorkerUnqualified RoleMaintainer))

(query
  (violatesZoneRepairPolicy Repair1 Org1))
(answer yes)
