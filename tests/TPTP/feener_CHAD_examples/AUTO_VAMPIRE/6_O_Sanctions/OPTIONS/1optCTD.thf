% option CTD

% NOTE: Unlike elsewhere, we want option CTD to refute here 

% Option B: "Bill does not pay his taxes"
% (not (exists (?TAX) 
%   (and 
%     (instance ?TAX Tax)
%     (origin ?TAX Bill))))
thf(optB_bill_does_not_pay, axiom, (
  ~?[TAX:$i] : (
    ((s__instance @ TAX @ s__Tax) & 
    (s__origin @ TAX @ s__Bill @ cw))))).