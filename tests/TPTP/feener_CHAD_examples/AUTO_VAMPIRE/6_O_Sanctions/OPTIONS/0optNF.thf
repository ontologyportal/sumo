% option NF 

% NOTE: Unlike other examples, we want this option NF to time out 

% Option A: "Bill pays his taxes"
% (exists (?TAX) 
%   (and 
%     (instance ?TAX Tax)
%     (origin ?TAX Bill)))
thf(optA_bill_pays, axiom, (
  ?[TAX:$i] : (
    ((s__instance @ TAX @ s__Tax) & 
    (s__origin @ TAX @ s__Bill @ cw))))).
