
% (NOTE: Unlike other examples, want this to time out 
% under option NF)
% Option Norms-followed: "Smith goes"
% (exists (?G)
%   (and
%     (instance ?G Translocation)
%     (agent ?G Smith)))
thf(opt_norms_followed, axiom,
  (? [G: $i]:
    ((s__instance @ G @ s__Translocation)
    & (s__agent @ G @ s__Smith @ cw)))).
