; CF 
; 1_obligation.kif

; To test:
;   Go to https://ontologyportal.github.io/sigma-rs/browse/ 
;     (might only work on Chrome-based browser)
;   May toggle "Options"
;     (if you toggle to CTD, this should timeout)
;   Copy "Assertions" and "Query"
;   Verify results:
;     If NF, verify this shows "Proved"
;     If not, verify it is NOT "Proved" 

; Results under Options:
;   NF:
;     Proved
;   CTD: 
;     Proved (should be timeout!)
;   None: 
;     Proved (should be timeout!)

;;;;;;;;;;;;;;;;;;;;;;;; Enter this into "Assertions" ;;;;;;;;;;;;;;;;;;;;;

; Obligation 1: "If Bill gets a paycheck, he must pay taxes"
(=> 
  (and 
    (instance ?GIV Giving) 
    (instance ?PCH PayCheck)
    (patient ?GIV ?PCH) 
    (destination ?GIV Bill))
  (modalAttribute 
    (exists (?TAX) 
      (and 
        (instance ?TAX Tax)
        (origin ?TAX Bill))) Obligation))
        
; Obligation 2: "If Bill flies to moon, it is obligatory he gets paycheck"
(=>
  (and 
    (instance ?FLY Flying) 
    (instance ?BILL Human) 
    (instance ?MOON Moon)
    (agent ?FLY ?BILL)
    (destination ?FLY ?MOON))
  (modalAttribute 
    (exists (?G ?P)
      (and 
        (instance ?G Giving)
        (instance ?P PayCheck)
        (patient ?G ?P)
        (destination ?G ?BILL)))))

;;;;;;;;;;;;;;;;;;;;;;;;; OPTIONS (toggle these) ;;;;;;;;;;;;;;;;;;;;;;;;;;

; Option Norms-Followed: "Bill flies to the moon"
 (exists (?FLY ?MOON) 
   (and 
     (instance ?FLY Flying)
     (instance ?MOON Moon)
     (agent ?FLY Bill)
     (destination ?FLY ?MOON)))
     
; Option CTD: "Bill does not fly to the moon"
; (not (exists (?FLY ?MOON) 
;   (and 
;     (instance ?FLY Flying)
;     (instance ?MOON Moon)
;     (agent ?FLY Bill)
;     (destination ?FLY ?MOON))))

;;;;;;;;;;;;;;;;;;;;;; Enter this into "Query";;;;;;;;;;;;;;;;;;;;;;;;;;;;
     
; Conjecture: "Therefore, obligatory that Bill must get taxed" 
 (modalAttribute 
   (exists (?TAX)
     (and 
       (instance ?TAX Tax)
       (origin ?TAX Bill))) Obligation)