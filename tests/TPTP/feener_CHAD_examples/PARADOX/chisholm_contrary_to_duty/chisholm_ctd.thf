% CF: THF-version of Chisholm: "If Smith goes, he ought to tell; if he does not go, he ought not tell"

% Norms-followed
% (Want these to time out, not refute!)
% K (0, distribution)   : timeout
% D (1, serial)         : timeout
% D4                    : timeout
% D45                   : timeout
% T (2, reflexive)      : timeout
% B (3, r and symmetric): timeout
% S4 (r and trans)      : timeout
% S5 (r and Euclid)     : timeout
% Summary: Everything times out as expected! 

% Contrary-to-duty
% (want these to refute!)
% K (0, distribution)   : ref (o2 and optCTD)
% D (1, serial)         : ref
% D4                    : ref
% D45                   : ref
% T (2, reflexive)      : ref
% B (3, r and symmetric): ref
% S4 (r and trans)      : ref
% S5 (r and Euclid)     : ref
% Summary: This is as expected! Success! 

% Summary of findings: DDL protects against a paradox! 

%%%%%%%%%%%%%%%%%%%%%%%%%% Pre-System Setup %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
thf(worlds_tp,type, w: $tType).
thf(cw_tp,type, cw: w).
thf(modals_tp,type, m: $tType).
thf(obligation_tp,type, s__Obligation: m).          % obligation modality
thf(permission_tp, type, s__Permission: m).
thf(prohibition_tp, type, s__Prohibition: m).
thf(accreln1_tp,type, accreln1: m > w > w > $o ).
thf(accreln2_tp,type, accreln2: m > $i > w > w > $o ).
thf(accreln3_tp,type, accreln3: m > $i > $i > w > w > $o ).

%%%%%%%%%%%%%%%%%%%%%% Systems: Under Obligation %%%%%%%%%%%%%%%%%%%%%%%%%%%
% 0. K: distribution
% [Nothing to implement] 

% 1. D: serial 
%thf(serial_obligation, axiom,
%  ![W1:w]: ?[W2:w]:
%    (accreln1 @ s__Obligation @ W1 @ W2)).

% 3. T: reflexive
thf(reflexive_obligation, axiom,
  ![W:w]:(
    (accreln1 @ s__Obligation @ W @ W))).

% 4. B: symmetric (if W1 accesses W2 then W2 accesses W1)
% NOTE: B is done with T 
%thf(symmetric_obligation, axiom,
%  ![W1: w, W2: w] :
%    ((accreln1 @ s__Obligation @ W1 @ W2) 
%      => (accreln1 @ s__Obligation @ W2 @ W1))).

% 5. S4: transitive with reflexive (if W1->W2 and W2->W3 then W1->W3)
% 2. D4: t but with serial (this is more exact for Obligation)
thf(transitive_obligation, axiom,
  ![W1: w, W2: w, W3: w] :
    (((accreln1 @ s__Obligation @ W1 @ W2) &
      (accreln1 @ s__Obligation @ W2 @ W3))
     => (accreln1 @ s__Obligation @ W1 @ W3))).

% 6. S5: Euclidean (if W1->W2 and W1->W3 then W2->W3)
% NOTE: S5 is commonly given as T + Euclidean; enable reflexive_obligation and this euclid axiom
thf(euclid_obligation, axiom,
  ![W1: w, W2: w, W3: w] :
    (((accreln1 @ s__Obligation @ W1 @ W2) &
      (accreln1 @ s__Obligation @ W1 @ W3))
     => (accreln1 @ s__Obligation @ W2 @ W3))).
      
%%%%%%%%%%%%%%%%%%%%%%%%%%% End: Systems under O %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% SUMO Terms: 

thf(t1,type,s__agent:($i > $i > w > $o)).
thf(t2,type,s__victim:($i > $i > w > $o)).
thf(t3,type,s__manner:($i > $i > w > $o)).
thf(t4,type,s__instance:($i > $i > $o)).

thf(t5, type, s__Translocation: $i).
thf(t6, type, s__LinguisticCommunication: $i).
thf(t7, type, s__Smith: $i).

thf(smith_always_human, axiom, (
  s__instance @ s__Smith @ s__Human)).
  
% Distinctness block:
thf(dist_translocation_linguisticcommunication, axiom,
  ~(s__Translocation = s__LinguisticCommunication)).
thf(dist_translocation_smith, axiom,
  ~(s__Translocation = s__Smith)).
thf(dist_linguisticcommunication_smith, axiom,
  ~(s__LinguisticCommunication = s__Smith)).

% Obligation A: If Smith goes, then it is obligatory that Smith tell.
% (modalAttribute
%   (=> 
%     (and
%       (instance ?GO Translocation)
%       (agent ?GO Smith))
%     (exists (?TELL)
%       (and
%         (instance ?TELL LinguisticCommunication)
%         (agent ?TELL Smith))))
%   Obligation)
thf(obligation1_smith_goes, axiom,
  ![W1:w, W2: w] : 
  ( ![GO: $i] : (( 
      (s__instance @ GO @ s__Translocation) & 
      (s__agent @ GO @ s__Bill @ W1)) => (
          (accreln1 @ s__Obligation @ W1 @ W2) => 
            ( ?[TELL: $i] : (
              (s__instance @ TELL @ s__LinguisticCommunication) & 
              (s__agent @ TELL @ s__Smith @ W2))))))).

% Obligation 2: If Smith does NOT go, then it is obligatory that Smith NOT tell.
% (modalAttribute
%   (=> 
%     (not (exists (?GO)
%       (and
%         (instance ?GO Translocation)
%         (agent ?GO Smith))))
%     (not
%       (exists (?T)
%         (and
%           (instance ?T LinguisticCommunication)
%           (agent ?T Smith)))))
%   Obligation)
thf(obligation2_smith_does_not_go, axiom,
  ![W1:w, W2: w] : 
  ( ~?[GO: $i] : (( 
      (s__instance @ GO @ s__Translocation) & 
      (s__agent @ GO @ s__Bill @ W1)) => (
          (accreln1 @ s__Obligation @ W1 @ W2) => 
            ( ~?[TELL: $i] : (
              (s__instance @ TELL @ s__LinguisticCommunication) & 
              (s__agent @ TELL @ s__Smith @ W2))))))).

%%% Options: Toggle these! %%%

% Option Norms-followed: "Smith goes"
% (exists (?G)
%   (and
%     (instance ?G Translocation)
%     (agent ?G Smith)))
thf(opt_norms_followed, axiom,
  (? [G: $i]:
    ((s__instance @ G @ s__Translocation)
    & (s__agent @ G @ s__Smith @ cw)))).

% Option Contrary-to-duty: "Smith does not go"
% (not (exists (?G)
%   (and
%     (instance ?G Translocation)
%     (agent ?G Smith))))
%thf(opt_contrary_to_duty, axiom,
%  ~(? [G: $i]:
%    ((s__instance @ G @ s__Translocation)
%    & (s__agent @ G @ s__Smith @ cw)))).

% Conjecture: "Therefore, Smith should NOT tell in the actual world"
% NOTE: We want this to work under CTD option rather than NF! This is 
% the reverse of what we normally do! 
% (modalAttribute
%   (not (exists (?T)
%     (and
%       (instance ?T LinguisticCommunication)
%       (agent ?T Smith)))) Obligation)
thf(conj, conjecture, (
  ?[Wx: w] : (
    (accreln1 @ s__Obligation @ cw @ Wx) &
    (~? [T: $i] : (
        (s__instance @ T @ s__LinguisticCommunication) &
        (s__agent @ T @ s__Smith @ cw)))))).
