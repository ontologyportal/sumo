; Written by Jackson Lawrence
; Meant to test GymEquipment.kif
(note GymEquipment_1)
(category GymEquipment)

; Conjecture
(query
(forall (?RB ?S)
    (=>
        (and
            (instance ?RB ResistanceBand)
            (instance ?S Stretching)
            (patient ?S ?RB))
        (and
            (instance ?RB Artifact)
            (instance ?RB AnaerobicExerciseDevice)
            (attribute ?RB LongAndThin)
            (attribute ?RB Elastic)
            (attribute ?RB Pliable)
            (capability Stretching patient ?RB)
            (exists (?SHAPE)
                (and
                    (holdsDuring
                        (BeginFn (WhenFn ?S))
                        (shape ?RB ?SHAPE))
                    (holdsDuring
                        (EndFn (WhenFn ?S))
                        (shape ?RB ?SHAPE))))))))

(answer yes)