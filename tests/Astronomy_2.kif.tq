; Written by Bradford Sweeter
; Meant to test Astronomy.kif
(note Astronomy_2)
(category Astronomy)

; Assertions
(instance E1 StellarEnvelopeShedding) 

; Conjecture
(query
  (exists (?WD ?N) 
    (and 
      (instance ?WD WhiteDwarf) 
      (result E1 ?WD) 
      (measure ?WD
        (MeasureFn ?N SolarMass)) 
      (lessThanOrEqualTo ?N 1.44))))

(answer yes)