;; AGT001+1 -- scenario reasoning test

(note AGT001+1)
(time 30)
(category AGT)

;; Scenario
(instance AGT001X MobileCellPhone)

(instance AGT001Y Downlink)

(destination AGT001Y AGT001X)

;; Reasoning: Instantiate the scenario; apply the domain rule, then component -> part
;; (Merge.kif:1106).
(query
  (exists (?Z) (and (instance ?Z CellNetwork) (part AGT001X ?Z))))

(answer yes)
