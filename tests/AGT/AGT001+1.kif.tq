;; Written by Colin Seymour
;; Tests for Cellular&TelephoneArchitecture.kif

;Meta predicates
(note AGT001+1)
(time 30)
(category AGT)

;Assertions

;Conjecture
(query
  (=>
    (and
      (instance ?X MobileCellPhone)
      (instance ?Y Downlink)
      (destination ?Y ?X))
    (exists (?Z)
      (and
        (instance ?Z CellNetwork)
        (component ?X ?Z)))))
        
(answer yes)
