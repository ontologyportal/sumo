;; Written by Colin Seymour
;; AGT002+1 -- scenario reasoning test

(note AGT002+1)
(time 30)
(category AGT)

;; Scenario
(instance AGT002S SARSatellite)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Radar -> ElectricDevice
;; (Mid-level-ontology.kif:4064).
(query
  (exists (?P ?R)
    (and
      (instance ?P SatellitePayload)
      (instance ?R ElectricDevice)
      (component ?P AGT002S)
      (component ?R ?P))))

(answer yes)
