;; Written by Colin Seymour
;; Tests for Cellular&TelephoneArchitecture.kif

;Meta predicates
(note AGT002+1)
(time 30)
(category AGT)

;Conjecture
(query
  (=>
    (instance ?S SARSatellite)
    (exists (?P ?R)
      (and
        (instance ?P SatellitePayload)
        (instance ?R Radar)
        (component ?P ?S)
        (component ?R ?P)))))

(answer yes)
