;; Written by Colin Seymour
;; AGT003+1 -- scenario reasoning test

(note AGT003+1)
(time 30)
(category AGT)

;; Scenario
(instance AGT003Phone MobileCellPhone)

(instance AGT003N GPRSNetwork)

(instance AGT003Bts BaseTransceiverStation)

(component AGT003Bts AGT003N)

(instance AGT003Up Uplink)

(instance AGT003Down Downlink)

(origin AGT003Up AGT003Phone)

(destination AGT003Up AGT003Bts)

(origin AGT003Down AGT003Bts)

(destination AGT003Down AGT003Phone)

;; Reasoning: Use GPRS uplink/downlink connectivity to reach Internet, then connected
;; symmetry to reverse that derived relation.
(query
  (connected Internet AGT003Phone))

(answer yes)
