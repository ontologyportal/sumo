;; GRA001+1 -- scenario reasoning test

(note GRA001+1)
(category GRA)
(time 240)

;; Scenario
(instance Arc13-1 GraphLoop)

;; Reasoning: Create the node witness for the scenario graph loop, then infer its GraphNode
;; type from the links relation domain.
(query
  (exists (?NODE) (and (links ?NODE ?NODE Arc13-1) (instance ?NODE GraphNode))))

(answer yes)
