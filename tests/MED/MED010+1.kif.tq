;;------------------------------------------------------------------------------
;; File     : MED010+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Reflux transfers material toward the esophagus
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Transfer -> Translocation (Merge.kif:14495).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0010
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED010+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

;; Scenario
(instance MED010Reflux GERefluxDisease)

(experiencer MED010Reflux MED010Patient)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Transfer ->
;; Translocation (Merge.kif:14495).
(query
  (exists (?TRANSFER ?STOMACH ?ESOPHAGUS)
    (and
      (instance ?TRANSFER Translocation)
      (instance ?STOMACH Organ)
      (instance ?ESOPHAGUS BodyVessel)
      (origin ?TRANSFER ?STOMACH)
      (destination ?TRANSFER ?ESOPHAGUS)
      (part ?STOMACH MED010Patient)
      (part ?ESOPHAGUS MED010Patient)
      (subProcess ?TRANSFER MED010Reflux))))

(answer yes)
