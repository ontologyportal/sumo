;;------------------------------------------------------------------------------
;; File     : MED011+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Crohn's disease impairs the gastrointestinal tract
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then AutoImmuneDisorder -> PathologicProcess (Medicine.kif:2555).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0011
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED011+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED011Disease CrohnsDisease)

(experiencer MED011Disease MED011Patient)

;; Reasoning: Instantiate the scenario; apply the domain rule, then AutoImmuneDisorder ->
;; PathologicProcess (Medicine.kif:2555).
(query
  (and
    (instance MED011Disease PathologicProcess)
    (attribute MED011Patient (ImpairedBodyPartFn GastroIntestinalTract))))

(answer yes)
