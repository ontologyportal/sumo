;;------------------------------------------------------------------------------
;; File     : MED001+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Injuring produces an injury
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then DiseaseOrSyndrome -> BiologicalAttribute (Merge.kif:23637).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0001
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED001+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED001Event Injuring)

(experiencer MED001Event MED001Person)

;; Reasoning: Instantiate the scenario; apply the domain rule, then DiseaseOrSyndrome ->
;; BiologicalAttribute (Merge.kif:23637).
(query
  (exists (?INJURY)
    (and
      (instance ?INJURY BiologicalAttribute)
      (holdsDuring
        (ImmediateFutureFn (WhenFn MED001Event))
        (attribute MED001Person ?INJURY)))))

(answer yes)
