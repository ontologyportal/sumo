;;------------------------------------------------------------------------------
;; File     : MED002+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Roles in applying a tourniquet
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then TherapeuticProcess -> Repairing (Merge.kif:15680).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0002
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED002+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED002Application ApplyingTourniquet)

;; Reasoning: Instantiate the scenario; apply the domain rule, then TherapeuticProcess ->
;; Repairing (Merge.kif:15680).
(query
  (and
    (instance MED002Application Repairing)
    (exists (?AGENT ?PATIENT ?OBJECT)
      (and
        (instance ?AGENT AutonomousAgent)
        (instance ?PATIENT Mammal)
        (agent MED002Application ?AGENT)
        (destination MED002Application ?PATIENT)
        (objectTransferred MED002Application ?OBJECT)))))

(answer yes)
