;;------------------------------------------------------------------------------
;; File     : MED003+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Catheterization inserts a medical device
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then MedicalDevice -> Device (Medicine.kif:738).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0003
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED003+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED003Procedure Catheterization)

;; Reasoning: Instantiate the scenario; apply the domain rule, then MedicalDevice -> Device
;; (Medicine.kif:738).
(query
  (exists (?CATHETER ?PATIENT)
    (and
      (instance ?CATHETER Device)
      (instance ?PATIENT Organism)
      (objectTransferred MED003Procedure ?CATHETER)
      (destination MED003Procedure ?PATIENT))))

(answer yes)
