;;------------------------------------------------------------------------------
;; File     : MED012+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Organ transplant includes organ placement
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then TherapeuticProcess -> Repairing (Merge.kif:15680).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0012
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED012+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED012Transplant OrganTransplant)

;; Reasoning: Instantiate the scenario; apply the domain rule, then TherapeuticProcess ->
;; Repairing (Merge.kif:15680).
(query
  (and
    (instance MED012Transplant Repairing)
    (exists (?RECIPIENT ?ORGAN ?PLACEMENT)
      (and
        (instance ?RECIPIENT Animal)
        (instance ?ORGAN Organ)
        (instance ?PLACEMENT Putting)
        (subProcess ?PLACEMENT MED012Transplant)
        (objectTransferred ?PLACEMENT ?ORGAN)
        (destination ?PLACEMENT ?RECIPIENT)))))

(answer yes)
