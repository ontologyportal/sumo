;;------------------------------------------------------------------------------
;; File     : MED004+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : CPR includes chest compression
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Compressing -> Motion (Mid-level-ontology.kif:5326).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED004+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

;; Scenario
(instance MED004Resuscitation CPR)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Compressing -> Motion
;; (Mid-level-ontology.kif:5326).
(query
  (exists (?COMPRESSION ?CHEST ?PATIENT)
    (and
      (instance ?COMPRESSION Motion)
      (instance ?CHEST AnimalAnatomicalStructure)
      (patient MED004Resuscitation ?PATIENT)
      (part ?CHEST ?PATIENT)
      (patient ?COMPRESSION ?CHEST)
      (subProcess ?COMPRESSION MED004Resuscitation))))

(answer yes)
