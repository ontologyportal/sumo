;;------------------------------------------------------------------------------
;; File     : MED005+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Blood circulation follows blood vessels
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Animal -> Organism (Merge.kif:18700).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0005
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED005+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

;; Scenario
(instance MED005Circulation BloodCirculation)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Animal -> Organism
;; (Merge.kif:18700).
(query
  (exists (?ANIMAL ?BLOOD ?ARTERY ?VEIN)
    (and
      (instance ?ANIMAL Organism)
      (instance ?BLOOD Blood)
      (instance ?ARTERY BloodVessel)
      (instance ?VEIN BloodVessel)
      (moves MED005Circulation ?BLOOD)
      (part ?ARTERY ?ANIMAL)
      (part ?VEIN ?ANIMAL)
      (path MED005Circulation ?ARTERY)
      (path MED005Circulation ?VEIN))))

(answer yes)
