;;------------------------------------------------------------------------------
;; File     : MED013+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : EpiPen contains a needle and adrenaline
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Device -> Artifact (Merge.kif:20622).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0013
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED013+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

;; Scenario
(instance MED013Pen EpiPen)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Device -> Artifact
;; (Merge.kif:20622).
(query
  (and
    (instance MED013Pen Artifact)
    (exists (?NEEDLE ?ADRENALINE)
      (and
        (instance ?NEEDLE Needle)
        (instance ?ADRENALINE Hormone)
        (part ?NEEDLE MED013Pen)
        (part ?ADRENALINE MED013Pen)))))

(answer yes)
