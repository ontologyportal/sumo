;;------------------------------------------------------------------------------
;; File     : MED006+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : IV therapy uses a medical-device line
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then MedicalDevice -> Device (Medicine.kif:738).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0006
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED006+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED006Therapy IVTherapy)

;; Reasoning: Instantiate the scenario; apply the domain rule, then MedicalDevice -> Device
;; (Medicine.kif:738).
(query
  (exists (?LINE ?VEIN)
    (and
      (instance ?LINE Device)
      (instance ?VEIN Vein)
      (path MED006Therapy ?LINE)
      (destination MED006Therapy ?VEIN))))

(answer yes)
