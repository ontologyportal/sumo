;;------------------------------------------------------------------------------
;; File     : MED008+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Thoracentesis uses a medical needle
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then TherapeuticProcess -> Repairing (Merge.kif:15680).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED008+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED008Procedure Thoracentesis)

(patient MED008Procedure MED008Patient)

;; Reasoning: Instantiate the scenario; apply the domain rule, then TherapeuticProcess ->
;; Repairing (Merge.kif:15680).
(query
  (and
    (instance MED008Procedure Repairing)
    (exists (?INSERTION ?NEEDLE ?CHEST)
      (and
        (instance ?INSERTION Inserting)
        (instance ?NEEDLE MedicalDevice)
        (instance ?CHEST Chest)
        (subProcess ?INSERTION MED008Procedure)
        (objectTransferred ?INSERTION ?NEEDLE)
        (part ?CHEST MED008Patient)))))

(answer yes)
