;;------------------------------------------------------------------------------
;; File     : MED015_1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Oxygen saturation percentage bounds
;; Version  : Merge.kif + Medicine.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Human -> Hominid (Merge.kif:18981).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0015
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED015_1)
(category MED)
(minLang tff)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(oxygenSaturation MED015Patient MED015Percent)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Human -> Hominid
;; (Merge.kif:18981).
(query
  (and
    (instance MED015Patient Hominid)
    (greaterThan MED015Percent 0.0)
    (lessThan MED015Percent 100.0)))

(answer yes)
