;;------------------------------------------------------------------------------
;; File     : MED014+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : RT-PCR measurement emits light
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Device -> Artifact (Merge.kif:20622).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0014
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED014+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED014Measurement Measuring)

(instrument MED014Measurement MED014Test)

(instance MED014Test RTPCRTest)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Device -> Artifact
;; (Merge.kif:20622).
(query
  (and
    (instance MED014Test Artifact)
    (exists (?LIGHT)
      (and (instance ?LIGHT RadiatingLight) (origin ?LIGHT MED014Test)))))

(answer yes)
