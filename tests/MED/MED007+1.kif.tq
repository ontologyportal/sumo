;;------------------------------------------------------------------------------
;; File     : MED007+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Saline lock contains saline solution
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Device -> Artifact (Merge.kif:20622).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0007
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED007+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance MED007Lock SalineLock)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Device -> Artifact
;; (Merge.kif:20622).
(query
  (and
    (instance MED007Lock Artifact)
    (exists (?SOLUTION)
      (and (instance ?SOLUTION SalineSolution) (contains MED007Lock ?SOLUTION)))))

(answer yes)
