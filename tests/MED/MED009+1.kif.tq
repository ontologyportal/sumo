;;------------------------------------------------------------------------------
;; File     : MED009+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Seizure is located in the brain
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then PathologicProcess -> BiologicalProcess (Merge.kif:13296).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0009
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MED009+1)
(category MED)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

;; Scenario
(instance MED009Seizure Seizure)

(experiencer MED009Seizure MED009Patient)

;; Reasoning: Instantiate the scenario; apply the domain rule, then PathologicProcess ->
;; BiologicalProcess (Merge.kif:13296).
(query
  (and
    (instance MED009Seizure BiologicalProcess)
    (exists (?BRAIN)
      (and
        (instance ?BRAIN VitalOrgan)
        (part ?BRAIN MED009Patient)
        (located MED009Seizure ?BRAIN)))))

(answer yes)
