(note TQROW_NO_DOMAIN)
(category general)

(instance testRowPred Predicate)
(instance testRowPred VariableArityRelation)

(instance A Entity)
(instance B Entity)
(instance C Entity)

(testRowPred A B C)

(=>
  (testRowPred @ROW)
  (equal (ListFn @ROW) TestList))

