;; Connect numeric month lengths to SUMO duration measurements.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_month_duration)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(instance CalendarTestMonth Integer)
(greaterThan CalendarTestMonth 0)
(lessThanOrEqualTo CalendarTestMonth 12)
(instance CalendarTestLength Integer)
(daysInMonth CalendarTestMonth CalendarTestYear CalendarTestLength)

(query
  (exists (?Duration)
    (and
      (instance ?Duration TimeDuration)
      (equal ?Duration (MeasureFn CalendarTestLength DayDuration))
      (duration (MonthIntervalFn CalendarTestYear CalendarTestMonth) ?Duration))))
(answer yes)
