;; Propagate an already-normalized remainder through an overflowing month.
;; The recursive result is a premise, as divisibility facts are in leap tests.
;; This tests the recurrence step, not evaluation of FloorFn arithmetic.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_day_overflow)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(instance CalendarOverflowDay Integer)
(instance CalendarSourceMonth Integer)
(greaterThan CalendarSourceMonth 0)
(lessThanOrEqualTo CalendarSourceMonth 12)
(not (equal CalendarSourceMonth 12))
(instance CalendarMonthLength Integer)
(daysInMonth CalendarSourceMonth CalendarTestYear CalendarMonthLength)
(greaterThan CalendarOverflowDay CalendarMonthLength)
(subclass CalendarNormalizedDate Day)
(dateCalculation
  (FloorFn (SubtractionFn CalendarOverflowDay CalendarMonthLength))
  (FloorFn (AdditionFn CalendarSourceMonth 1))
  CalendarTestYear
  CalendarNormalizedDate)

(query
  (dateCalculation CalendarOverflowDay CalendarSourceMonth CalendarTestYear CalendarNormalizedDate))
(answer yes)
