;; The minute-class adapter works for an arbitrary SUMO Day subclass.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_generic_date_time)
(category general)
(time 10)

(subclass CalendarTestDate Day)
(instance CalendarTestHour NonnegativeInteger)
(instance CalendarTestMinute NonnegativeInteger)
(lessThan CalendarTestHour 24)
(lessThan CalendarTestMinute 60)

(query (equal (DateTimeOnDateFn CalendarTestDate CalendarTestHour CalendarTestMinute) (MinuteFn CalendarTestMinute (HourFn CalendarTestHour CalendarTestDate))))
(answer yes)
