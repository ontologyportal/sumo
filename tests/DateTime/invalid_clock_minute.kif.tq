;; A minute at or above 60 is not a valid clock time.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_invalid_clock_minute)
(category general)
(time 10)

(not (lessThan CalendarInvalidMinute 60))

(query (not (validClockTime CalendarTestHour CalendarInvalidMinute)))
(answer yes)
