;; Valid concrete coordinates realize a minute interval.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_valid_minute_instance)
(category general)
(time 10)

(validCalendarDate CalendarTestYear CalendarTestMonth CalendarTestDay)
(instance CalendarTestHour NonnegativeInteger)
(instance CalendarTestMinute NonnegativeInteger)
(lessThan CalendarTestHour 24)
(lessThan CalendarTestMinute 60)

(query (instance (MinuteIntervalFn (DateTimeOnDateFn (DateFromYMDFn CalendarTestYear CalendarTestMonth CalendarTestDay) CalendarTestHour CalendarTestMinute)) (DateTimeOnDateFn (DateFromYMDFn CalendarTestYear CalendarTestMonth CalendarTestDay) CalendarTestHour CalendarTestMinute)))
(answer yes)
