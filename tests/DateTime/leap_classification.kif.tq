;; Classify the year interval using the existing SUMO LeapYear class.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_leap_classification)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(daysInYear CalendarTestYear 366)

(query (instance (YearIntervalFn CalendarTestYear) LeapYear))
(answer yes)
