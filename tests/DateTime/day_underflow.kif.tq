;; A nonpositive day coordinate reuses the normalized result from the preceding month.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_day_underflow)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(instance CalendarInputDay Integer)
(instance CalendarSourceMonth Integer)
(greaterThan CalendarSourceMonth 0)
(lessThanOrEqualTo CalendarSourceMonth 12)
(instance CalendarMonthLength Integer)
(subclass CalendarNormalizedDate Day)
(not (equal CalendarSourceMonth 1))
(lessThanOrEqualTo CalendarInputDay 0)
(daysInMonth (FloorFn (SubtractionFn CalendarSourceMonth 1)) CalendarTestYear CalendarMonthLength)
(dateCalculation
  (FloorFn (AdditionFn CalendarInputDay CalendarMonthLength))
  (FloorFn (SubtractionFn CalendarSourceMonth 1))
  CalendarTestYear
  CalendarNormalizedDate)

(query (dateCalculation CalendarInputDay CalendarSourceMonth CalendarTestYear CalendarNormalizedDate))
(answer yes)
