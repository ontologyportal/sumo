;; A month above the calendar range cannot be a valid date.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_invalid_month)
(category general)
(time 10)

(not (lessThanOrEqualTo CalendarInvalidMonth 12))

(query (not (validCalendarDate CalendarTestYear CalendarInvalidMonth CalendarTestDay)))
(answer yes)
