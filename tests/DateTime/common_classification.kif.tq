;; Establish an explicit non-leap classification.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_common_classification)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(daysInYear CalendarTestYear 365)

(query (not (instance (YearIntervalFn CalendarTestYear) LeapYear)))
(answer yes)
