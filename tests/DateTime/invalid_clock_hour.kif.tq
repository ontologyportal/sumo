;; An hour at or above 24 is not a valid clock time.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_invalid_clock_hour)
(category general)
(time 10)

(not (lessThan CalendarInvalidHour 24))

(query (not (validClockTime CalendarInvalidHour CalendarTestMinute)))
(answer yes)
