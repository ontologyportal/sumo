;; A valid coordinate is the base case of date normalization.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_normalization_base)
(category general)
(time 10)

(validCalendarDate CalendarTestYear CalendarTestMonth CalendarTestDay)

(query
  (dateCalculation CalendarTestDay CalendarTestMonth CalendarTestYear
    (DateFromYMDFn CalendarTestYear CalendarTestMonth CalendarTestDay)))
(answer yes)
