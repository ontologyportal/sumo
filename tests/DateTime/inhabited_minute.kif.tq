;; Generic minute realization requires a witness to class nonemptiness.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_inhabited_minute)
(category general)
(time 10)

(subclass CalendarTestMinuteClass Minute)
(instance CalendarExistingMinute CalendarTestMinuteClass)

(query (instance (MinuteIntervalFn CalendarTestMinuteClass) CalendarTestMinuteClass))
(answer yes)
