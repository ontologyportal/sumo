;; February uses the shared Gregorian year-day count.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_century_common)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(equal (RemainderFn CalendarTestYear 4) 0)
(equal (RemainderFn CalendarTestYear 100) 0)
(not (equal (RemainderFn CalendarTestYear 400) 0))

(query (daysInMonth 2 CalendarTestYear 28))
(answer yes)
