;; SUMO's native DayFn cannot have instances for a day above 31.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_day_32_not_instantiated)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(instance CalendarTestMonth Integer)
(instance CalendarInvalidDay Integer)
(not (lessThanOrEqualTo CalendarInvalidDay 31))

(query
  (not
    (instance
      (DayIntervalFn CalendarTestYear CalendarTestMonth CalendarInvalidDay)
      (DayFn CalendarInvalidDay
        (MonthFn (MonthNumberFn CalendarTestMonth) (YearFn CalendarTestYear))))))
(answer yes)
