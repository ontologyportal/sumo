;; Only valid calendar coordinates are equated with the SUMO date constructor.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_valid_date_alias)
(category general)
(time 10)

(validCalendarDate CalendarTestYear CalendarTestMonth CalendarTestDay)

(query (equal (DateFromYMDFn CalendarTestYear CalendarTestMonth CalendarTestDay) (DayFn CalendarTestDay (MonthFn (MonthNumberFn CalendarTestMonth) (YearFn CalendarTestYear)))))
(answer yes)
