;; A dated month specializes its existing named SUMO month class.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_named_month_class)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(instance CalendarTestMonth Integer)
(greaterThan CalendarTestMonth 0)
(lessThanOrEqualTo CalendarTestMonth 12)

(query (subclass (MonthFn (MonthNumberFn CalendarTestMonth) (YearFn CalendarTestYear)) (MonthNumberFn CalendarTestMonth)))
(answer yes)
