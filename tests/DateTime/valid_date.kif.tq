;; A valid day bounded by its actual month length establishes calendar validity.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_valid_date)
(category general)
(time 10)

(instance CalendarTestYear Integer)
(instance CalendarTestMonth Integer)
(greaterThan CalendarTestMonth 0)
(lessThanOrEqualTo CalendarTestMonth 12)
(instance CalendarTestDay Integer)
(instance CalendarTestLength Integer)
(daysInMonth CalendarTestMonth CalendarTestYear CalendarTestLength)
(greaterThan CalendarTestDay 0)
(lessThanOrEqualTo CalendarTestDay CalendarTestLength)

(query (validCalendarDate CalendarTestYear CalendarTestMonth CalendarTestDay))
(answer yes)
