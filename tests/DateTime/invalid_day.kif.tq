;; A nonpositive day cannot be a valid date; do not confuse absence with negation.
;; Background: Merge.kif and root DateTime.kif.
(note DateTime_invalid_day)
(category general)
(time 10)

(not (greaterThan CalendarInvalidDay 0))

(query (not (validCalendarDate CalendarTestYear CalendarTestMonth CalendarInvalidDay)))
(answer yes)
