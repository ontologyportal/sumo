;;------------------------------------------------------------------------------
;; File     : MGT004+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Issued bank card is linked to its issuer
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then FinancialAccount -> Agreement (FinancialOntology.kif:47).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT004+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT004Card BankCard)

(instance MGT004Issuer FinancialOrganization)

(issuedBy MGT004Card MGT004Issuer)

;; Reasoning: Instantiate the scenario; apply the domain rule, then FinancialAccount ->
;; Agreement (FinancialOntology.kif:47).
(query
  (exists (?ACCOUNT)
    (and
      (instance ?ACCOUNT Agreement)
      (cardAccount MGT004Card ?ACCOUNT)
      (accountAt ?ACCOUNT MGT004Issuer))))

(answer yes)
