;;------------------------------------------------------------------------------
;; File     : MGT002+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Debit card links its holder to a deposit account
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then DepositAccount -> FinancialAccount (FinancialOntology.kif:1106).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0002
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT002+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT002Card DebitCard)

(possesses MGT002Customer MGT002Card)

;; Reasoning: Instantiate the scenario; apply the domain rule, then DepositAccount ->
;; FinancialAccount (FinancialOntology.kif:1106).
(query
  (exists (?ACCOUNT ?PROVIDER)
    (and
      (instance ?ACCOUNT FinancialAccount)
      (instance ?ACCOUNT FinancialContract)
      (instance ?PROVIDER FinancialOrganization)
      (cardAccount MGT002Card ?ACCOUNT)
      (accountHolder ?ACCOUNT MGT002Customer)
      (accountAt ?ACCOUNT ?PROVIDER))))

(answer yes)
