;;------------------------------------------------------------------------------
;; File     : MGT011+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Opening an account establishes its holder and provider
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then FinancialContract -> Contract (FinancialOntology.kif:41).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0011
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT011+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT011Opening OpeningAnAccount)

(eventLocated MGT011Opening MGT011Provider)

(instance MGT011Provider FinancialOrganization)

(agent MGT011Opening MGT011Customer)

(equal (WhenFn MGT011Opening) MGT011Openingtime)

;; Reasoning: Instantiate the scenario; apply the domain rule, then FinancialContract ->
;; Contract (FinancialOntology.kif:41).
(query
  (exists (?ACCOUNT ?PERIOD)
    (and
      (instance ?ACCOUNT Contract)
      (accountAt ?ACCOUNT MGT011Provider)
      (accountHolder ?ACCOUNT MGT011Customer)
      (agreementPeriod ?ACCOUNT ?PERIOD)
      (meetsTemporally MGT011Openingtime ?PERIOD))))

(answer yes)
