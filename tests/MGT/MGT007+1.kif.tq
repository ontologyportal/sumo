;;------------------------------------------------------------------------------
;; File     : MGT007+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Depositing a check creates a matching deposit
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then FinancialTransaction -> Transaction (Merge.kif:15181).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0007
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT007+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT007Action DepositingACheck)

(patient MGT007Action MGT007Check)

(instance MGT007Check Check)

(checkAccount MGT007Check MGT007Account)

(monetaryValue MGT007Check MGT007Amount)

;; Reasoning: Instantiate the scenario; apply the domain rule, then FinancialTransaction ->
;; Transaction (Merge.kif:15181).
(query
  (exists (?DEPOSIT)
    (and
      (instance ?DEPOSIT Transaction)
      (destination ?DEPOSIT (CurrencyFn MGT007Account))
      (transactionAmount ?DEPOSIT MGT007Amount))))

(answer yes)
