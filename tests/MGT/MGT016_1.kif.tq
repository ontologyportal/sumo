;;------------------------------------------------------------------------------
;; File     : MGT016_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Five percent simple interest on one hundred dollars
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then domain rule plus participant classification: FinancialAccount -> Agreement (FinancialOntology.kif:47).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0016
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT016_1)
(category MGT)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT016Account FinancialAccount)

(instance (MeasureFn 100 UnitedStatesDollar) CurrencyMeasure)

(principalAmount MGT016Account (MeasureFn 100 UnitedStatesDollar))

(fixedInterestRate MGT016Account 5)

(instance (MeasureFn MGT016Amount UnitedStatesDollar) CurrencyMeasure)

(simpleInterest
  MGT016Account
  (MeasureFn MGT016Amount UnitedStatesDollar)
  MGT016Period)

(instance MGT016Amount RealNumber)

(instance MGT016Period TimeInterval)

;; Reasoning: Read the principal, fixed rate and recorded simple interest; divide the rate
;; by 100, multiply by principal, then infer the unknown interest amount.
(query
  (equal MGT016Amount 5))

(answer yes)
