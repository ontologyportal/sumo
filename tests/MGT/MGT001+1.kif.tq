;;------------------------------------------------------------------------------
;; File     : MGT001+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Financial account has a provider
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then FinancialContract -> Contract (FinancialOntology.kif:41).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0001
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT001+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT001Account FinancialAccount)

;; Reasoning: Instantiate the scenario; apply the domain rule, then FinancialContract ->
;; Contract (FinancialOntology.kif:41).
(query
  (and
    (instance MGT001Account Contract)
    (instance MGT001Account ServiceContract)
    (exists (?PROVIDER)
      (and
        (instance ?PROVIDER FinancialOrganization)
        (accountAt MGT001Account ?PROVIDER)))))

(answer yes)
