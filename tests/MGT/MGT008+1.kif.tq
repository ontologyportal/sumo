;;------------------------------------------------------------------------------
;; File     : MGT008+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Processing a check withdraws its value
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Withdrawal -> FinancialTransaction (FinancialOntology.kif:488).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT008+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(monetaryValue MGT008Check MGT008Amount)

(checkAccount MGT008Check MGT008Account)

(instance MGT008Processing ProcessingACheck)

(patient MGT008Processing MGT008Check)

(equal (WhenFn MGT008Processing) MGT008Processingtime)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Withdrawal ->
;; FinancialTransaction (FinancialOntology.kif:488).
(query
  (exists (?WITHDRAWAL ?WITHDRAWALTIME)
    (and
      (instance ?WITHDRAWAL FinancialTransaction)
      (instrument ?WITHDRAWAL MGT008Check)
      (transactionAmount ?WITHDRAWAL MGT008Amount)
      (origin ?WITHDRAWAL MGT008Account)
      (equal (WhenFn ?WITHDRAWAL) ?WITHDRAWALTIME)
      (meetsTemporally MGT008Processingtime ?WITHDRAWALTIME))))

(answer yes)
