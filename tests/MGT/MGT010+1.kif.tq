;;------------------------------------------------------------------------------
;; File     : MGT010+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Payment before its due date is a prepayment
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : A payment matching an amount due and occurring before its due date is a prepayment.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0010
;;
;; Status   : Theorem
;; Comments : Uses the amount-due and temporal condition for Prepayment.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note MGT010+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?PAYMENT Payment)
      (transactionAmount ?PAYMENT ?AMOUNT)
      (date ?PAYMENT ?PAYMENTDATE)
      (instance ?ACCOUNT FinancialAccount)
      (destination ?PAYMENT (CurrencyFn ?ACCOUNT))
      (amountDue ?ACCOUNT ?AMOUNT ?DUEDATE)
      (before (EndFn ?PAYMENTDATE) (BeginFn ?DUEDATE)))
    (instance ?PAYMENT Prepayment)))

(answer yes)
