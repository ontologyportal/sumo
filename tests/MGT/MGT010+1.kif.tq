;;------------------------------------------------------------------------------
;; File     : MGT010+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Payment before its due date is a prepayment
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Use before transitivity across the clearing point to show the payment precedes its due date, then apply the Prepayment rule.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0010
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT010+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT010Payment Payment)

(transactionAmount MGT010Payment MGT010Amount)

(date MGT010Payment MGT010Paymentdate)

(instance MGT010Account FinancialAccount)

(destination MGT010Payment (CurrencyFn MGT010Account))

(amountDue MGT010Account MGT010Amount MGT010Duedate)

(instance PaymentClearingPoint TimePoint)

(before (EndFn MGT010Paymentdate) PaymentClearingPoint)

(before PaymentClearingPoint (BeginFn MGT010Duedate))

;; Reasoning: Use before transitivity across the clearing point to show the payment
;; precedes its due date, then apply the Prepayment rule.
(query
  (instance MGT010Payment Prepayment))

(answer yes)
