;;------------------------------------------------------------------------------
;; File     : MGT014_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Negative balance gives an overdraft amount
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then domain rule plus participant classification: CurrencyMeasure -> ConstantQuantity (Merge.kif:7813).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0014
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT014_1)
(category MGT)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance (MeasureFn -25 UnitedStatesDollar) CurrencyMeasure)

(currentAccountBalance MGT014Account MGT014Date (MeasureFn -25 UnitedStatesDollar))

;; Reasoning: Instantiate the scenario; apply the domain rule, then domain rule plus
;; participant classification: CurrencyMeasure -> ConstantQuantity (Merge.kif:7813).
(query
  (and
    (overdraft MGT014Account (MeasureFn 25 UnitedStatesDollar) MGT014Date)
    (instance (MeasureFn -25 UnitedStatesDollar) ConstantQuantity)))

(answer yes)
