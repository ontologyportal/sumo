;;------------------------------------------------------------------------------
;; File     : MGT012_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Deposit raises account balance
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then domain rule plus participant classification: FinancialAccount -> Agreement (FinancialOntology.kif:47).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0012
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT012_1)
(category MGT)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT012Account FinancialAccount)

(instance MGT012Deposit Deposit)

(destination MGT012Deposit (CurrencyFn MGT012Account))

(instance (MeasureFn 50 UnitedStatesDollar) CurrencyMeasure)

(transactionAmount MGT012Deposit (MeasureFn 50 UnitedStatesDollar))

(instance (BeginFn (WhenFn MGT012Deposit)) TimePoint)

(instance (MeasureFn 100 UnitedStatesDollar) CurrencyMeasure)

(currentAccountBalance
  MGT012Account
  (BeginFn (WhenFn MGT012Deposit))
  (MeasureFn 100 UnitedStatesDollar))

;; Reasoning: Instantiate the scenario; apply the domain rule, then domain rule plus
;; participant classification: FinancialAccount -> Agreement (FinancialOntology.kif:47).
(query
  (and
    (currentAccountBalance
      MGT012Account
      (EndFn (WhenFn MGT012Deposit))
      (MeasureFn 150 UnitedStatesDollar))
    (instance MGT012Account Agreement)))

(answer yes)
