;;------------------------------------------------------------------------------
;; File     : MGT009+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Service fee produces a fee transaction
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then FinancialTransaction -> Transaction (Merge.kif:15181).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0009
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT009+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(serviceFee MGT009Provider MGT009Action MGT009Amount)

;; Reasoning: Instantiate the scenario; apply the domain rule, then FinancialTransaction ->
;; Transaction (Merge.kif:15181).
(query
  (exists (?FEE)
    (and
      (instance ?FEE Transaction)
      (agent ?FEE MGT009Provider)
      (causes MGT009Action ?FEE)
      (amountCharged ?FEE MGT009Amount))))

(answer yes)
