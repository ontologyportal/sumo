;;------------------------------------------------------------------------------
;; File     : MGT009+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Service fee produces a fee transaction
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : A service fee charged by a financial organization creates a fee transaction for the specified amount.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0009
;;
;; Status   : Theorem
;; Comments : Combines the service-fee witness with ChargingAFee subclass FinancialTransaction.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note MGT009+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (serviceFee ?PROVIDER ?ACTION ?AMOUNT)
    (exists (?FEE)
      (and
        (instance ?FEE FinancialTransaction)
        (agent ?FEE ?PROVIDER)
        (causes ?ACTION ?FEE)
        (amountCharged ?FEE ?AMOUNT)))))

(answer yes)
