;;------------------------------------------------------------------------------
;; File     : MGT015_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Payment below monthly minimum incurs a penalty
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Penalty -> ChargingAFee (FinancialOntology.kif:1002).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0015
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT015_1)
(category MGT)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT015Account LiabilityAccount)

(instance (MeasureFn 50 UnitedStatesDollar) CurrencyMeasure)

(minimumPayment MGT015Account (MeasureFn 50 UnitedStatesDollar) MonthDuration)

(instance MGT015Month Month)

(instance MGT015Payment Payment)

(destination MGT015Payment (CurrencyFn MGT015Account))

(instance (MeasureFn 20 UnitedStatesDollar) CurrencyMeasure)

(paymentsPerPeriod MGT015Account (MeasureFn 20 UnitedStatesDollar) MGT015Month)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Penalty -> ChargingAFee
;; (FinancialOntology.kif:1002).
(query
  (exists (?PENALTY)
    (and
      (instance ?PENALTY ChargingAFee)
      (destination ?PENALTY (CurrencyFn MGT015Account)))))

(answer yes)
