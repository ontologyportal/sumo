;;------------------------------------------------------------------------------
;; File     : MGT003+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Credit card links its holder to a liability account
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : A person possessing a credit card holds a linked credit-card account, which is a liability account.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0003
;;
;; Status   : Theorem
;; Comments : Combines the credit-card account witness with the account subclass chain.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note MGT003+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?CARD CreditCard)
      (possesses ?CUSTOMER ?CARD))
    (exists (?ACCOUNT)
      (and
        (instance ?ACCOUNT LiabilityAccount)
        (cardAccount ?CARD ?ACCOUNT)
        (accountHolder ?ACCOUNT ?CUSTOMER)))))

(answer yes)
