;;------------------------------------------------------------------------------
;; File     : MGT003+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Credit card links its holder to a liability account
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then LiabilityAccount -> FinancialAccount (FinancialOntology.kif:1248).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0003
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT003+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT003Card CreditCard)

(possesses MGT003Customer MGT003Card)

;; Reasoning: Instantiate the scenario; apply the domain rule, then LiabilityAccount ->
;; FinancialAccount (FinancialOntology.kif:1248).
(query
  (exists (?ACCOUNT)
    (and
      (instance ?ACCOUNT FinancialAccount)
      (cardAccount MGT003Card ?ACCOUNT)
      (accountHolder ?ACCOUNT MGT003Customer))))

(answer yes)
