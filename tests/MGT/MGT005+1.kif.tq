;;------------------------------------------------------------------------------
;; File     : MGT005+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Account holder acts in account use
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : An event using an account has the account holder as its agent.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0005
;;
;; Status   : Theorem
;; Comments : Combines UsingAnAccount subclass FinancialTransaction with the account-use rule.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note MGT005+1)
(category MGT)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?USE UsingAnAccount)
      (patient ?USE ?ACCOUNT)
      (accountHolder ?ACCOUNT ?CUSTOMER))
    (and
      (instance ?USE FinancialTransaction)
      (agent ?USE ?CUSTOMER))))

(answer yes)
