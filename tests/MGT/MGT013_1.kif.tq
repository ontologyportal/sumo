;;------------------------------------------------------------------------------
;; File     : MGT013_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Payment lowers account balance
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then domain rule plus participant classification: FinancialAccount -> Agreement (FinancialOntology.kif:47).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0013
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note MGT013_1)
(category MGT)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

;; Scenario
(instance MGT013Account FinancialAccount)

(instance MGT013Payment Payment)

(origin MGT013Payment (CurrencyFn MGT013Account))

(instance (MeasureFn 40 UnitedStatesDollar) CurrencyMeasure)

(transactionAmount MGT013Payment (MeasureFn 40 UnitedStatesDollar))

(instance (EndFn (ImmediatePastFn (WhenFn MGT013Payment))) TimePoint)

(instance (MeasureFn 100 UnitedStatesDollar) CurrencyMeasure)

(currentAccountBalance
  MGT013Account
  (EndFn (ImmediatePastFn (WhenFn MGT013Payment)))
  (MeasureFn 100 UnitedStatesDollar))

;; Reasoning: Instantiate the scenario; apply the domain rule, then domain rule plus
;; participant classification: FinancialAccount -> Agreement (FinancialOntology.kif:47).
(query
  (and
    (currentAccountBalance
      MGT013Account
      (BeginFn (ImmediateFutureFn (WhenFn MGT013Payment)))
      (MeasureFn 60 UnitedStatesDollar))
    (instance MGT013Account Agreement)))

(answer yes)
