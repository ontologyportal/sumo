;; DAT001+1 -- scenario reasoning test

(note DAT001+1)
(category DAT)

;; Scenario
(instance ManifestFirst Artifact)

(instance ManifestSecond Artifact)

(equal ShippingManifest (ListFn ManifestFirst ManifestSecond))

;; Reasoning: ListFn has range List; List is a subclass of Abstract; substitute the named
;; manifest.
(query
  (instance ShippingManifest Abstract))

(answer yes)
