;; DAT003+1 -- scenario reasoning test

(note DAT003+1)
(category DAT)

;; Scenario
(instance ManifestFirst Artifact)

(instance ManifestSecond Artifact)

(equal ShippingManifest (ListFn ManifestFirst ManifestSecond))

(equal InspectedItem (ListOrderFn ShippingManifest 2))

;; Reasoning: Substitute the named manifest, then evaluate ListOrderFn to identify the
;; inspected cargo item.
(query
  (equal InspectedItem ManifestSecond))

(answer yes)
