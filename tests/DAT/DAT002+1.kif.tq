;; DAT002+1 -- scenario reasoning test

(note DAT002+1)
(category DAT)

;; Scenario
(instance ManifestFirst Artifact)

(instance ManifestSecond Artifact)

(equal ShippingManifest (ListFn ManifestFirst ManifestSecond))

(equal InspectedItem (ListOrderFn ShippingManifest 2))

;; Reasoning: Resolve the second list element through the manifest binding, then infer its
;; membership.
(query
  (inList InspectedItem ShippingManifest))

(answer yes)
