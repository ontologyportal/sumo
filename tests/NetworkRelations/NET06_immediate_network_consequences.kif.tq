;; Immediate containment has no intermediary and does not reverse or skip a level.
(note NET06_immediate_network_consequences)
(category general)
(time 30)
(file NetworkRelations.kif)

(immediateSubNetwork Net1 Net2)
(immediateSubNetwork Net2 Net3)

(query
  (and
    (subNetwork Net1 Net2)
    (subNetwork Net1 Net3)
    (not
      (exists (?MID)
        (and
          (subNetwork Net1 ?MID)
          (subNetwork ?MID Net2))))
    (not
      (immediateSubNetwork Net2 Net1))
    (not
      (immediateSubNetwork Net1 Net3))))
(answer yes)
