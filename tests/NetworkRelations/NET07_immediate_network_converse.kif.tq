;; Established containment with no intermediary is immediate containment.
(note NET07_immediate_network_converse)
(category general)
(time 30)
(file NetworkRelations.kif)

(subNetwork Net1 Net2)
(not
  (exists (?MID)
    (and
      (subNetwork Net1 ?MID)
      (subNetwork ?MID Net2))))

(query
  (immediateSubNetwork Net1 Net2))
(answer yes)
