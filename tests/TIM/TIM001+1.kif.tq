;;------------------------------------------------------------------------------
;; File     : TIM001+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Ordering nonadjacent Jurassic ages
;; Version  : Merge.kif + GeochronologicTimes.kif axioms; +1 denotes FOF formulation 1.
;; English  : Chain the survey time through the geochronologic earlier relations using transitivity.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and GeochronologicTimes.kif
;; Names    : SMO_TIM_0001
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note TIM001+1)
(category TIM)
(minLang fof)
(include Merge.kif)
(include GeochronologicTimes.kif)

;; Scenario
(instance CoreSurveyTime TimePosition)

(earlier CoreSurveyTime Hettangian)

;; Reasoning: Chain the survey time through the geochronologic earlier relations using
;; transitivity.
(query
  (earlier CoreSurveyTime Pliensbachian))

(answer yes)
