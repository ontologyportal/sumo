;;------------------------------------------------------------------------------
;; File     : TIM005+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Damage precedes bleeding
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Damaging -> InternalChange (Merge.kif:15717).
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Medicine.kif
;; Names    : SMO_TIM_0005
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note TIM005+1)
(category TIM)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

;; Scenario
(instance TIM005Bleed Bleeding)

(experiencer TIM005Bleed TIM005Person)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Damaging ->
;; InternalChange (Merge.kif:15717).
(query
  (exists (?VESSEL ?DAMAGE)
    (and
      (or (instance ?VESSEL Vein) (instance ?VESSEL Artery))
      (part ?VESSEL TIM005Person)
      (instance ?DAMAGE InternalChange)
      (patient ?DAMAGE ?VESSEL)
      (before (EndFn (WhenFn ?DAMAGE)) (BeginFn (WhenFn TIM005Bleed))))))

(answer yes)
