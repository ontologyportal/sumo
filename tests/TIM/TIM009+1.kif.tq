;;------------------------------------------------------------------------------
;; File     : TIM009+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : First and last walking steps
;; Version  : Merge.kif + Mid-level-ontology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Stepping -> BodyMotion (Mid-level-ontology.kif:692).
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Mid-level-ontology.kif
;; Names    : SMO_TIM_0009
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note TIM009+1)
(category TIM)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)

;; Scenario
(instance TIM009Walk Ambulating)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Stepping -> BodyMotion
;; (Mid-level-ontology.kif:692).
(query
  (exists (?FIRST ?LAST)
    (and
      (instance ?FIRST BodyMotion)
      (instance ?LAST Stepping)
      (not (equal ?FIRST ?LAST))
      (temporalPart (WhenFn ?FIRST) (WhenFn TIM009Walk))
      (temporalPart (WhenFn ?LAST) (WhenFn TIM009Walk)))))

(answer yes)
