;;------------------------------------------------------------------------------
;; File     : TIM006^1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Stellar phase succession
;; Version  : Merge.kif + Astronomy.kif axioms; ^1 denotes THF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then TimePosition -> TimeMeasure (Merge.kif:2749).
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Astronomy.kif
;; Names    : SMO_TIM_0006
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note TIM006^1)
(category TIM)
(minLang thf)
(include Merge.kif)
(include Astronomy.kif)

;; Scenario
(holdsDuring TIM006Later (attribute TIM006Star SubgiantStarPhase))

;; Reasoning: Instantiate the scenario; apply the domain rule, then TimePosition ->
;; TimeMeasure (Merge.kif:2749).
(query
  (exists (?EARLIER)
    (and
      (instance ?EARLIER TimeMeasure)
      (before ?EARLIER TIM006Later)
      (holdsDuring ?EARLIER (attribute TIM006Star MainSequenceStarPhase)))))

(answer yes)
