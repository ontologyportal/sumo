;;------------------------------------------------------------------------------
;; File     : TIM004+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : A question precedes its answer
;; Version  : Merge.kif + Mid-level-ontology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Questioning -> Directing (Merge.kif:17003).
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Mid-level-ontology.kif
;; Names    : SMO_TIM_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note TIM004+1)
(category TIM)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)

;; Scenario
(instance TIM004Answer Answering)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Questioning ->
;; Directing (Merge.kif:17003).
(query
  (exists (?QUESTION)
    (and
      (instance ?QUESTION Directing)
      (refers TIM004Answer ?QUESTION)
      (before (EndFn (WhenFn ?QUESTION)) (BeginFn (WhenFn TIM004Answer))))))

(answer yes)
