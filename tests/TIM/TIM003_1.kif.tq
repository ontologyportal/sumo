;;------------------------------------------------------------------------------
;; File     : TIM003_1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Conversion of day duration
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Apply the day/hour conversion and equality substitution to the duration of a concrete survey trip.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_TIM_0003
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note TIM003_1)
(category TIM)
(minLang tff)
(include Merge.kif)

;; Scenario
(instance SurveyTrip Translocation)

(duration (WhenFn SurveyTrip) (MeasureFn 2 DayDuration))

;; Reasoning: Apply the day/hour conversion and equality substitution to the duration of a
;; concrete survey trip.
(query
  (duration (WhenFn SurveyTrip) (MeasureFn 48 HourDuration)))

(answer yes)
