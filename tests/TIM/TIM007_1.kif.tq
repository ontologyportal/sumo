;;------------------------------------------------------------------------------
;; File     : TIM007_1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Wind gust duration bound
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then (lessThan TIM007Seconds 20) -> a weaker numeric bound by comparison transitivity.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Weather.kif
;; Names    : SMO_TIM_0007
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note TIM007_1)
(category TIM)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

;; Scenario
(instance TIM007Gust WindGust)

(eventLocated TIM007Gust TIM007Area)

(instance TIM007Area GeographicArea)

(duration (WhenFn TIM007Gust) (MeasureFn TIM007Seconds SecondDuration))

;; Reasoning: Instantiate the scenario; apply the domain rule, then (lessThan TIM007Seconds
;; 20) -> a weaker numeric bound by comparison transitivity.
(query
  (lessThan TIM007Seconds 21.0))

(answer yes)
