;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0005+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Capybara habitat
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every capybara inhabits both a water area and a land area.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0005
;;
;; Status   : Theorem
;; Comments : Uses the capybara habitat rule; the conjecture concerns habitat, not a process category.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0005)
(category biology)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

(query
  (forall (?C)
    (=>
      (instance ?C Capybara)
      (exists (?W ?L)
        (and
          (instance ?W WaterArea)
          (instance ?L LandArea)
          (inhabits ?C ?W)
          (inhabits ?C ?L))))))

(answer yes)
