;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0004+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Dolphin respiration
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every dolphin participates as agent in a biological process of breathing.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0004
;;
;; Status   : Theorem
;; Comments : Combines the dolphin breathing rule with the Breathing process hierarchy.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0004)
(category biology)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

(query
  (forall (?D)
    (=>
      (instance ?D Dolphin)
      (exists (?B)
        (and
          (instance ?B BiologicalProcess)
          (agent ?B ?D))))))

(answer yes)
