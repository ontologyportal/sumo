;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0003+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Dolphins are animals
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Dolphins are animals through the aquatic mammal and vertebrate hierarchy.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0003
;;
;; Status   : Theorem
;; Comments : Combines the Dolphin declaration in Animals.kif with Merge.kif taxonomy.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0003)
(category biology)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

(query
  (subclass Dolphin Animal))

(answer yes)
