;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0009+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Dolphin reproduction
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : A dolphin reproduction event entails a birth process involving that dolphin.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0009
;;
;; Status   : Theorem
;; Comments : Combines the dolphin viviparous attribute with the viviparous reproduction rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0009)
(category biology)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

(query
  (=>
    (and
      (instance ?D Dolphin)
      (instance ?R Reproduction)
      (agent ?R ?D))
    (exists (?B)
      (and
        (instance ?B Birth)
        (agent ?B ?D)))))

(answer yes)
