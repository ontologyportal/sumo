;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0007+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Capybara herbivory
;; Version  : Merge.kif + Mid-level-ontology.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Anything eaten by a capybara in an eating event is a plant.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Animals.kif
;; Names    : SMO_BIO_0007
;;
;; Status   : Theorem
;; Comments : Combines the capybara herbivore attribute with the dietary rule in Mid-level-ontology.kif.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0007)
(category biology)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Animals.kif)

(query
  (forall (?C ?E ?F)
    (=>
      (and
        (instance ?C Capybara)
        (instance ?E Eating)
        (agent ?E ?C)
        (patient ?E ?F))
      (instance ?F Plant))))

(answer yes)
