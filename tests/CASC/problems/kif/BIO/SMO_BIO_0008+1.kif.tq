;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0008+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Eagle reproduction
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : An eagle reproduction event has an egg as a result.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0008
;;
;; Status   : Theorem
;; Comments : Combines the eagle oviparous attribute with the oviparous reproduction rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0008)
(category biology)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

(query
  (forall (?E ?R)
    (=>
      (and
        (instance ?E Eagle)
        (instance ?R Reproduction)
        (agent ?R ?E))
      (exists (?EGG)
        (and
          (instance ?EGG Egg)
          (result ?R ?EGG))))))

(answer yes)
