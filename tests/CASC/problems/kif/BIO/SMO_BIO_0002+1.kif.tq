;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0002+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Bacterial cellular structure
;; Version  : Merge.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every bacterium has a cell component that is a body part.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_BIO_0002
;;
;; Status   : Theorem
;; Comments : Combines the bacterial cell-component rule with Cell subclass BodyPart.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0002)
(category biology)
(minLang fof)
(include Merge.kif)

(query
  (=>
    (instance ?B Bacterium)
    (exists (?C)
      (and
        (component ?C ?B)
        (instance ?C BodyPart)))))

(answer yes)
