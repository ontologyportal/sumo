;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0014+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Shoulder joint connectivity
;; Version  : Merge.kif + Anatomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : The left humerus and left scapula are connected body-part types in humans.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Anatomy.kif
;; Names    : SMO_BIO_0014
;;
;; Status   : Theorem
;; Comments : Uses the left scapula to humerus fact and symmetry of connectedBodyPartTypes.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0014)
(category biology)
(minLang fof)
(include Merge.kif)
(include Anatomy.kif)

(query
  (connectedBodyPartTypes LeftHumerus LeftScapulaBone Human))

(answer yes)
