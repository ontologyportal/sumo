;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0012+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Pecan tree material
;; Version  : Merge.kif + Mid-level-ontology.kif + Trees.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every pecan tree has wood as its material.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Trees.kif
;; Names    : SMO_BIO_0012
;;
;; Status   : Theorem
;; Comments : Combines the PecanTree to BotanicalTree hierarchy with the botanical-tree wood rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0012)
(category biology)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Trees.kif)

(query
  (=>
    (instance ?T PecanTree)
    (material Wood ?T)))

(answer yes)
