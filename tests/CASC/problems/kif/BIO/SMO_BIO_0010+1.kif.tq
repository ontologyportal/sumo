;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0010+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Cobra venom
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every cobra has a toxin as one of its parts.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0010
;;
;; Status   : Theorem
;; Comments : Combines the cobra venomous rule with the generic venomous-organism toxin rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0010)
(category biology)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

(query
  (forall (?C)
    (=>
      (instance ?C Cobra)
      (exists (?T)
        (and
          (instance ?T Toxin)
          (part ?T ?C))))))

(answer yes)
