;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0006+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Raptor diet
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every eagle has the carnivore dietary attribute inherited from raptors.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0006
;;
;; Status   : Theorem
;; Comments : Combines Eagle subclass Raptor with the Raptor carnivore rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0006)
(category biology)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

(query
  (=>
    (instance ?E Eagle)
    (attribute ?E Carnivore)))

(answer yes)
