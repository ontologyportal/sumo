;;------------------------------------------------------------------------------
;; File     : SMO_BIO_0011+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Pecan tree taxonomy
;; Version  : Merge.kif + Mid-level-ontology.kif + Trees.kif axioms; +1 denotes FOF formulation 1.
;; English  : Pecan trees are organisms through hickory, botanical tree, woody plant, flowering plant, and plant.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Trees.kif
;; Names    : SMO_BIO_0011
;;
;; Status   : Theorem
;; Comments : Crosses the Trees.kif, Mid-level-ontology.kif, and Merge.kif taxonomy.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_BIO_0011)
(category biology)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Trees.kif)

(query
  (subclass PecanTree Organism))

(answer yes)
