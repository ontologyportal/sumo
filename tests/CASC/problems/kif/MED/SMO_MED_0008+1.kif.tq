;;------------------------------------------------------------------------------
;; File     : SMO_MED_0008+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Thoracentesis uses a medical needle
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Thoracentesis on a patient includes an insertion subprocess transferring a medical needle.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0008
;;
;; Status   : Theorem
;; Comments : Combines the thoracentesis witness rule with Needle subclass MedicalDevice.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0008)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (and
      (instance ?PROCEDURE Thoracentesis)
      (patient ?PROCEDURE ?PATIENT))
    (and
      (instance ?PROCEDURE TherapeuticProcess)
      (exists (?INSERTION ?NEEDLE ?CHEST)
        (and
          (instance ?INSERTION Inserting)
          (instance ?NEEDLE MedicalDevice)
          (instance ?CHEST Chest)
          (subProcess ?INSERTION ?PROCEDURE)
          (objectTransferred ?INSERTION ?NEEDLE)
          (part ?CHEST ?PATIENT))))))

(answer yes)
