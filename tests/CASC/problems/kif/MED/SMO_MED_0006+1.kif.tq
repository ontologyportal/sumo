;;------------------------------------------------------------------------------
;; File     : SMO_MED_0006+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : IV therapy uses a medical-device line
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : An IV therapy process follows an IV line that is a medical device and reaches a vein.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0006
;;
;; Status   : Theorem
;; Comments : Combines the IV therapy witness rule with IVLine, Catheter, and MedicalDevice.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0006)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (instance ?THERAPY IVTherapy)
    (exists (?LINE ?VEIN)
      (and
        (instance ?LINE MedicalDevice)
        (instance ?VEIN Vein)
        (path ?THERAPY ?LINE)
        (destination ?THERAPY ?VEIN)))))

(answer yes)
