;;------------------------------------------------------------------------------
;; File     : SMO_MED_0010+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Reflux transfers material toward the esophagus
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : A reflux episode includes a transfer from the patient's stomach toward the esophagus.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0010
;;
;; Status   : Theorem
;; Comments : Combines the reflux transfer rule with Stomach subclass Organ and Esophagus subclass BodyVessel.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0010)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

(query
  (=>
    (and
      (instance ?REFLUX GERefluxDisease)
      (experiencer ?REFLUX ?PATIENT))
    (exists (?TRANSFER ?STOMACH ?ESOPHAGUS)
      (and
        (instance ?TRANSFER Transfer)
        (instance ?STOMACH Organ)
        (instance ?ESOPHAGUS BodyVessel)
        (origin ?TRANSFER ?STOMACH)
        (destination ?TRANSFER ?ESOPHAGUS)
        (part ?STOMACH ?PATIENT)
        (part ?ESOPHAGUS ?PATIENT)
        (subProcess ?TRANSFER ?REFLUX)))))

(answer yes)
