;;------------------------------------------------------------------------------
;; File     : SMO_MED_0015_1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Oxygen saturation percentage bounds
;; Version  : Merge.kif + Medicine.kif axioms; _1 denotes TFF formulation 1.
;; English  : A recorded oxygen-saturation percentage for a human is strictly between zero and one hundred.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0015
;;
;; Status   : Theorem
;; Comments : Uses the oxygenSaturation domain and numeric bounds axioms.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0015)
(category medicine)
(minLang tff)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (oxygenSaturation ?PATIENT ?PERCENT)
    (and
      (instance ?PATIENT Human)
      (greaterThan ?PERCENT 0.0)
      (lessThan ?PERCENT 100.0))))

(answer yes)
