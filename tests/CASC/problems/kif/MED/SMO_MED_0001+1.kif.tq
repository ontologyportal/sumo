;;------------------------------------------------------------------------------
;; File     : SMO_MED_0001+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Injuring produces an injury
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : An injuring event experienced by an agent is followed by an injury that is a disease or syndrome.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0001
;;
;; Status   : Theorem
;; Comments : Combines the injury witness rule with Injury subclass DiseaseOrSyndrome.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0001)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (and
      (instance ?EVENT Injuring)
      (experiencer ?EVENT ?PERSON))
    (exists (?INJURY)
      (and
        (instance ?INJURY DiseaseOrSyndrome)
        (holdsDuring
          (ImmediateFutureFn (WhenFn ?EVENT))
          (attribute ?PERSON ?INJURY))))))

(answer yes)
