;;------------------------------------------------------------------------------
;; File     : SMO_MED_0011+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Crohn's disease impairs the gastrointestinal tract
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : A Crohn's disease event is an autoimmune disorder associated with impairment of the experiencer's gastrointestinal tract.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0011
;;
;; Status   : Theorem
;; Comments : Combines CrohnsDisease and InflammatoryBowelDisease subclass links with the impairment rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0011)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (and
      (instance ?DISEASE CrohnsDisease)
      (experiencer ?DISEASE ?PATIENT))
    (and
      (instance ?DISEASE AutoImmuneDisorder)
      (attribute
        ?PATIENT
        (ImpairedBodyPartFn GastroIntestinalTract)))))

(answer yes)
