;;------------------------------------------------------------------------------
;; File     : SMO_MED_0005+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Blood circulation follows blood vessels
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : A blood-circulation process moves blood through an animal's artery and vein.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0005
;;
;; Status   : Theorem
;; Comments : Combines the circulation witness rule with the artery and vein blood-vessel classes.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0005)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

(query
  (=>
    (instance ?CIRCULATION BloodCirculation)
    (exists (?ANIMAL ?BLOOD ?ARTERY ?VEIN)
      (and
        (instance ?ANIMAL Animal)
        (instance ?BLOOD Blood)
        (instance ?ARTERY BloodVessel)
        (instance ?VEIN BloodVessel)
        (moves ?CIRCULATION ?BLOOD)
        (part ?ARTERY ?ANIMAL)
        (part ?VEIN ?ANIMAL)
        (path ?CIRCULATION ?ARTERY)
        (path ?CIRCULATION ?VEIN)))))

(answer yes)
