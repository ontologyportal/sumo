;;------------------------------------------------------------------------------
;; File     : SMO_MED_0002+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Roles in applying a tourniquet
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Applying a tourniquet is a therapeutic process with an agent, a mammal recipient, and a transferred object.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0002
;;
;; Status   : Theorem
;; Comments : Combines the tourniquet application witness rule with its TherapeuticProcess class.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0002)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (instance ?APPLICATION ApplyingTourniquet)
    (and
      (instance ?APPLICATION TherapeuticProcess)
      (exists (?AGENT ?PATIENT ?OBJECT)
        (and
          (instance ?AGENT AutonomousAgent)
          (instance ?PATIENT Mammal)
          (agent ?APPLICATION ?AGENT)
          (destination ?APPLICATION ?PATIENT)
          (objectTransferred ?APPLICATION ?OBJECT))))))

(answer yes)
