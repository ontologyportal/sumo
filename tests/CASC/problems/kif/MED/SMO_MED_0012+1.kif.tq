;;------------------------------------------------------------------------------
;; File     : SMO_MED_0012+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Organ transplant includes organ placement
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : An organ transplant is a therapeutic surgery with a subprocess putting an organ into an animal.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0012
;;
;; Status   : Theorem
;; Comments : Combines the transplant placement rule with OrganTransplant, Surgery, and TherapeuticProcess.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0012)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (instance ?TRANSPLANT OrganTransplant)
    (and
      (instance ?TRANSPLANT TherapeuticProcess)
      (exists (?RECIPIENT ?ORGAN ?PLACEMENT)
        (and
          (instance ?RECIPIENT Animal)
          (instance ?ORGAN Organ)
          (instance ?PLACEMENT Putting)
          (subProcess ?PLACEMENT ?TRANSPLANT)
          (objectTransferred ?PLACEMENT ?ORGAN)
          (destination ?PLACEMENT ?RECIPIENT))))))

(answer yes)
