;;------------------------------------------------------------------------------
;; File     : SMO_MED_0013+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : EpiPen contains a needle and adrenaline
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : An EpiPen is a device containing a needle and adrenaline, which is a hormone.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0013
;;
;; Status   : Theorem
;; Comments : Combines the EpiPen parts rule with MedicalDevice and Adrenaline classifications.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0013)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

(query
  (=>
    (instance ?PEN EpiPen)
    (and
      (instance ?PEN Device)
      (exists (?NEEDLE ?ADRENALINE)
        (and
          (instance ?NEEDLE Needle)
          (instance ?ADRENALINE Hormone)
          (part ?NEEDLE ?PEN)
          (part ?ADRENALINE ?PEN))))))

(answer yes)
