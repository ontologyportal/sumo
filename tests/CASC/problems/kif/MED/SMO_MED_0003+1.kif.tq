;;------------------------------------------------------------------------------
;; File     : SMO_MED_0003+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Catheterization inserts a medical device
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Catheterization inserts a catheter, which is a medical device, into an organism.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0003
;;
;; Status   : Theorem
;; Comments : Combines the catheterization witness rule with Catheter subclass MedicalDevice.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0003)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (instance ?PROCEDURE Catheterization)
    (exists (?CATHETER ?PATIENT)
      (and
        (instance ?CATHETER MedicalDevice)
        (instance ?PATIENT Organism)
        (objectTransferred ?PROCEDURE ?CATHETER)
        (destination ?PROCEDURE ?PATIENT)))))

(answer yes)
