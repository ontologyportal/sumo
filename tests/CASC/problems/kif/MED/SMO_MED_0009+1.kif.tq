;;------------------------------------------------------------------------------
;; File     : SMO_MED_0009+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Seizure is located in the brain
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : A seizure experienced by an agent is a pathologic process located in that agent's vital organ.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0009
;;
;; Status   : Theorem
;; Comments : Combines the seizure location rule with Brain subclass VitalOrgan.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0009)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

(query
  (=>
    (and
      (instance ?SEIZURE Seizure)
      (experiencer ?SEIZURE ?PATIENT))
    (and
      (instance ?SEIZURE PathologicProcess)
      (exists (?BRAIN)
        (and
          (instance ?BRAIN VitalOrgan)
          (part ?BRAIN ?PATIENT)
          (located ?SEIZURE ?BRAIN))))))

(answer yes)
