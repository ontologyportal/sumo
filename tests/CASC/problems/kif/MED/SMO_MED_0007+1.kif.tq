;;------------------------------------------------------------------------------
;; File     : SMO_MED_0007+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : Saline lock contains saline solution
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : A saline lock is a device containing a saline solution.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0007
;;
;; Status   : Theorem
;; Comments : Combines the saline-lock contents rule with MedicalDevice subclass Device.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0007)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (instance ?LOCK SalineLock)
    (and
      (instance ?LOCK Device)
      (exists (?SOLUTION)
        (and
          (instance ?SOLUTION SalineSolution)
          (contains ?LOCK ?SOLUTION))))))

(answer yes)
