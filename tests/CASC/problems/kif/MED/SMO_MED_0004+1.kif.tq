;;------------------------------------------------------------------------------
;; File     : SMO_MED_0004+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : CPR includes chest compression
;; Version  : Merge.kif + Mid-level-ontology.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : CPR has a chest-compression subprocess acting on a patient's anatomical structure.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Medicine.kif
;; Names    : SMO_MED_0004
;;
;; Status   : Theorem
;; Comments : Combines the CPR witness rule with Chest subclass AnimalAnatomicalStructure.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0004)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Medicine.kif)

(query
  (=>
    (instance ?RESUSCITATION CPR)
    (exists (?COMPRESSION ?CHEST ?PATIENT)
      (and
        (instance ?COMPRESSION Compressing)
        (instance ?CHEST AnimalAnatomicalStructure)
        (patient ?RESUSCITATION ?PATIENT)
        (part ?CHEST ?PATIENT)
        (patient ?COMPRESSION ?CHEST)
        (subProcess ?COMPRESSION ?RESUSCITATION)))))

(answer yes)
