;;------------------------------------------------------------------------------
;; File     : SMO_MED_0014+1 : SUMO/CASC source.
;; Domain   : Medicine
;; Problem  : RT-PCR measurement emits light
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : Measuring with an RT-PCR test entails a light-radiating event originating at the measuring device.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Medicine.kif
;; Names    : SMO_MED_0014
;;
;; Status   : Theorem
;; Comments : Combines the RT-PCR measurement rule with MeasuringDevice subclass Device.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_MED_0014)
(category medicine)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (and
      (instance ?MEASUREMENT Measuring)
      (instrument ?MEASUREMENT ?TEST)
      (instance ?TEST RTPCRTest))
    (and
      (instance ?TEST Device)
      (exists (?LIGHT)
        (and
          (instance ?LIGHT RadiatingLight)
          (origin ?LIGHT ?TEST))))))

(answer yes)
