;;------------------------------------------------------------------------------
;; File     : SMO_GEG_0016+1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Endorheic basin drainage
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : A river in the Great Basin has no outflow to an ocean.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0016
;;
;; Status   : Theorem
;; Comments : Specializes the EndorheicBasin rule to the GreatBasin instance.
;;          : The current rule excludes all BodyOfWater outflow.
;;          : Uses the 51-file full SUMO source manifest.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_GEG_0016)
(category geography)
(minLang fof)
(include tests/CASC/axiom-sets/full.sources)

(query
  (forall (?RIVER)
    (=>
      (and
        (instance ?RIVER River)
        (located ?RIVER GreatBasin))
      (not
        (exists (?OUT)
          (and
            (instance ?OUT Ocean)
            (flows ?RIVER ?OUT)))))))

(answer yes)
