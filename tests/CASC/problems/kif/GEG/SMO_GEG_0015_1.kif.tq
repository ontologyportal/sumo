;;------------------------------------------------------------------------------
;; File     : SMO_GEG_0015_1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Area of an inland sea
;; Version  : Full SUMO axioms; _1 denotes TFF formulation 1.
;; English  : The Mediterranean Sea has an area of 2500000 square kilometers.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0015
;;
;; Status   : Theorem
;; Comments : Extracts a concrete area from Geography.kif's measurement statement.
;;          : Uses the 51-file full SUMO source manifest.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_GEG_0015)
(category geography)
(minLang tff)
(include tests/CASC/axiom-sets/full.sources)

(query
  (totalArea MediterraneanSea
    (MeasureFn 2500000 SquareKilometer)))

(answer yes)
