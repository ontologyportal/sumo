;;------------------------------------------------------------------------------
;; File     : SMO_GEG_0013_1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Elevation below sea level
;; Version  : Full SUMO axioms; _1 denotes TFF formulation 1.
;; English  : Badwater Basin has an elevation of negative 86 meters.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0013
;;
;; Status   : Theorem
;; Comments : Extracts a concrete measure from Geography.kif's elevation statement.
;;          : Uses the 51-file full SUMO source manifest.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_GEG_0013)
(category geography)
(minLang tff)
(include tests/CASC/axiom-sets/full.sources)

(query
  (elevation BadwaterBasin
    (MeasureFn -86 Meter)))

(answer yes)
