;;------------------------------------------------------------------------------
;; File     : SMO_GEG_0012^1 : SUMO/CASC source.
;; Domain   : Geography
;; Problem  : Natural hazard occurrence
;; Version  : Full SUMO axioms; ^1 denotes THF formulation 1.
;; English  : Some cyclonic storm is located in the Southern Ocean.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEG_0012
;;
;; Status   : Theorem
;; Comments : Specializes a hazard rule with a process class and an area fact.
;;          : Uses the 51-file full SUMO source manifest.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_GEG_0012)
(category geography)
(minLang thf)
(include tests/CASC/axiom-sets/full.sources)

(query
  (exists (?STORM)
    (and
      (instance ?STORM CyclonicStorm)
      (located ?STORM SouthernOcean))))

(answer yes)
