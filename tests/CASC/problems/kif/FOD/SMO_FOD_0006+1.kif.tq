;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0006+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Fermented food has a fermentation history
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Food marked fermented has a fermentation process that produced it.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0006
;;
;; Status   : Theorem
;; Comments : Combines PreparedFoodAttribute classification and the FermentedAttribute witness.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0006)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (attribute ?FOOD FermentedAttribute)
    (and
      (instance ?FOOD Food)
      (exists (?FERMENT)
        (and
          (instance ?FERMENT Fermentation)
          (instance ?FERMENT PreservingFood)
          (instance ?FERMENT BiologicalProcess)
          (result ?FERMENT ?FOOD))))))

(answer yes)
