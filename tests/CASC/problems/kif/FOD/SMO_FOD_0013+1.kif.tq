;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0013+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Dry roasting is cooking and heating
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Food marked dry-roasted results from a process that is both cooking and heating.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0013
;;
;; Status   : Theorem
;; Comments : Combines DryRoastAttribute production with DryRoasting's two subclasses.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0013)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (attribute ?FOOD DryRoastAttribute)
    (and
      (instance ?FOOD Food)
      (exists (?ROAST)
        (and
          (instance ?ROAST DryRoasting)
          (instance ?ROAST Cooking)
          (instance ?ROAST Heating)
          (result ?ROAST ?FOOD))))))

(answer yes)
