;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0010+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Vegan attribute excludes meat and dairy parts
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Within the current ontology, a vegan item is vegetarian and has neither meat nor dairy parts.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0010
;;
;; Status   : Theorem
;; Comments : Combines the Vegan implication with the Vegetarian no-meat rule; it does not infer the absence of every animal-derived substance.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0010)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (attribute ?ITEM Vegan)
    (and
      (attribute ?ITEM Vegetarian)
      (not
        (exists (?MEAT)
          (and
            (instance ?MEAT Meat)
            (part ?MEAT ?ITEM))))
      (not
        (exists (?DAIRY)
          (and
            (instance ?DAIRY DairyArtifact)
            (part ?DAIRY ?ITEM)))))))

(answer yes)
