;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0014_1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Whole-milk butterfat proportion
;; Version  : Merge.kif + Food.kif axioms; _1 denotes TFF formulation 1.
;; English  : Measured whole milk has a butterfat part between 3.25 and 5 percent of its measured volume.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0014
;;
;; Status   : Theorem
;; Comments : Uses the WholeMilk witness and its numeric butterfat bounds.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0014)
(category food)
(minLang tff)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (and
      (instance ?MILK WholeMilk)
      (measure ?MILK (MeasureFn ?VOLUME ?UNIT))
      (instance ?UNIT UnitOfVolume))
    (exists (?FAT ?FATVOLUME)
      (and
        (instance ?FAT ButterFat)
        (part ?FAT ?MILK)
        (measure ?FAT (MeasureFn ?FATVOLUME ?UNIT))
        (greaterThanOrEqualTo
          ?FATVOLUME
          (MultiplicationFn 0.0325 ?VOLUME))
        (lessThanOrEqualTo
          ?FATVOLUME
          (MultiplicationFn 0.05 ?VOLUME))))))

(answer yes)
