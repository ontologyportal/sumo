;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0015_1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Skimmed-milk butterfat proportion
;; Version  : Merge.kif + Food.kif axioms; _1 denotes TFF formulation 1.
;; English  : Measured skimmed milk has a butterfat part no greater than 0.5 percent of its measured volume.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0015
;;
;; Status   : Theorem
;; Comments : Uses the SkimmedMilk witness and its numeric upper and lower bounds.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0015)
(category food)
(minLang tff)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (and
      (instance ?MILK SkimmedMilk)
      (measure ?MILK (MeasureFn ?VOLUME ?UNIT))
      (instance ?UNIT UnitOfVolume))
    (exists (?FAT ?FATVOLUME)
      (and
        (instance ?FAT ButterFat)
        (part ?FAT ?MILK)
        (measure ?FAT (MeasureFn ?FATVOLUME ?UNIT))
        (greaterThanOrEqualTo
          ?FATVOLUME
          (MultiplicationFn 0.0 ?VOLUME))
        (lessThanOrEqualTo
          ?FATVOLUME
          (MultiplicationFn 0.005 ?VOLUME))))))

(answer yes)
