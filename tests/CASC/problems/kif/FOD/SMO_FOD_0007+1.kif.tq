;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0007+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Flour is ground cereal food
;; Version  : Merge.kif + Mid-level-ontology.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Flour is a prepared food and mixture produced by grinding cereal grain.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Food.kif
;; Names    : SMO_FOD_0007
;;
;; Status   : Theorem
;; Comments : Combines Flour production and classification with PreparedFood in Mid-level-ontology.kif.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0007)
(category food)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Food.kif)

(query
  (=>
    (instance ?FLOUR Flour)
    (and
      (instance ?FLOUR Food)
      (instance ?FLOUR PreparedFood)
      (instance ?FLOUR Mixture)
      (attribute ?FLOUR RawAttribute)
      (exists (?GRIND ?GRAIN)
        (and
          (instance ?GRIND Grinding)
          (instance ?GRAIN CerealGrain)
          (patient ?GRIND ?GRAIN)
          (result ?GRIND ?FLOUR))))))

(answer yes)
