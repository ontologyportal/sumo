;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0012+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Hulled food has a peeling process
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Food marked hulled results from a hulling process classified as both cooking and peeling.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0012
;;
;; Status   : Theorem
;; Comments : Combines HulledAttribute production and Hulling classifications.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0012)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (attribute ?FOOD HulledAttribute)
    (and
      (instance ?FOOD Food)
      (exists (?HULLING)
        (and
          (instance ?HULLING Hulling)
          (instance ?HULLING Cooking)
          (instance ?HULLING Peeling)
          (result ?HULLING ?FOOD))))))

(answer yes)
