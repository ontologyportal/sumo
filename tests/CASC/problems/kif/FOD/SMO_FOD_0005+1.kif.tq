;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0005+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Curing combines salt and drying
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : A curing process preserves food through salt application and a drying subprocess.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0005
;;
;; Status   : Theorem
;; Comments : Joins the CuringFood food-and-salt witness to its Drying subprocess rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0005)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (instance ?CURING CuringFood)
    (and
      (instance ?CURING PreservingFood)
      (exists (?FOOD ?PUTTING ?SALT ?DRYING)
        (and
          (instance ?FOOD Food)
          (patient ?CURING ?FOOD)
          (instance ?PUTTING Putting)
          (subProcess ?PUTTING ?CURING)
          (instance ?SALT SodiumChloride)
          (patient ?PUTTING ?SALT)
          (destination ?PUTTING ?FOOD)
          (instance ?DRYING Drying)
          (subProcess ?DRYING ?CURING)
          (patient ?DRYING ?FOOD))))))

(answer yes)
