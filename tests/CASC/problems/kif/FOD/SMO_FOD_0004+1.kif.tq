;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0004+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Baking uses an oven
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : A baking process is both cooking and heating and uses an oven.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0004
;;
;; Status   : Theorem
;; Comments : Combines Baking classification with its oven-instrument witness.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0004)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (instance ?BAKE Baking)
    (and
      (instance ?BAKE Cooking)
      (instance ?BAKE Heating)
      (exists (?OVEN)
        (and
          (instance ?OVEN Oven)
          (instrument ?BAKE ?OVEN))))))

(answer yes)
