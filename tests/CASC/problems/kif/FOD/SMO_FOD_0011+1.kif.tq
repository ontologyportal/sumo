;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0011+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Fermentation uses microorganisms and carbohydrates
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : A fermentation process uses a microorganism as an instrument and a carbohydrate as a resource.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0011
;;
;; Status   : Theorem
;; Comments : Combines Fermentation's process classifications with its resource-and-instrument witness.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0011)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (instance ?FERMENT Fermentation)
    (and
      (instance ?FERMENT BiologicalProcess)
      (instance ?FERMENT PreservingFood)
      (exists (?CARBOHYDRATE ?MICROBE)
        (and
          (instance ?CARBOHYDRATE Carbohydrate)
          (instance ?MICROBE Microorganism)
          (instrument ?FERMENT ?MICROBE)
          (resource ?FERMENT ?CARBOHYDRATE))))))

(answer yes)
