;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0016^1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Ingredient quantities imply a preparation
;; Version  : Merge.kif + Food.kif axioms; ^1 denotes THF formulation 1.
;; English  : A stated amount of an ingredient class used for a food class entails a preparation process using a measured ingredient instance.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0016
;;
;; Status   : Theorem
;; Comments : Quantifies over ingredient and product classes in the ingredientAmount rule, requiring a higher-order formulation.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0016)
(category food)
(minLang thf)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (ingredientAmount ?INGREDIENT_CLASS ?PRODUCT_CLASS ?AMOUNT)
    (exists (?PREPARATION ?INGREDIENT ?PRODUCT)
      (and
        (instance ?INGREDIENT ?INGREDIENT_CLASS)
        (measure ?INGREDIENT ?AMOUNT)
        (instance ?PRODUCT ?PRODUCT_CLASS)
        (instance ?PREPARATION Process)
        (patient ?PREPARATION ?INGREDIENT)
        (result ?PREPARATION ?PRODUCT)))))

(answer yes)
