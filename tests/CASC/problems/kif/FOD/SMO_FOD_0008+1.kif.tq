;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0008+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Fruit puree results from pureeing fruit
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : A fruit puree is a mixture made by grinding fruit.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0008
;;
;; Status   : Theorem
;; Comments : Combines the FruitPuree witness with Pureeing subclass Grinding.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0008)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (instance ?PUREE FruitPuree)
    (and
      (instance ?PUREE Mixture)
      (exists (?FRUIT ?PROCESS)
        (and
          (instance ?FRUIT Fruit)
          (instance ?PROCESS Grinding)
          (patient ?PROCESS ?FRUIT)
          (result ?PROCESS ?PUREE))))))

(answer yes)
