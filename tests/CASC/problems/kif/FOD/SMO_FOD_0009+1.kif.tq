;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0009+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Meal members are human food
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : An item in a meal is food for humans, and the meal is a collection.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0009
;;
;; Status   : Theorem
;; Comments : Combines Meal collection classification and its member constraint.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0009)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (and
      (instance ?MEAL Meal)
      (member ?ITEM ?MEAL))
    (and
      (instance ?MEAL CollectionOfObjects)
      (instance ?ITEM (FoodForFn Human)))))

(answer yes)
