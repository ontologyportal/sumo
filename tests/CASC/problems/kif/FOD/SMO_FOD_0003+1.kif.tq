;;------------------------------------------------------------------------------
;; File     : SMO_FOD_0003+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Plant-derived food excludes meat
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Plant-derived food is food and is not meat.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0003
;;
;; Status   : Theorem
;; Comments : Combines the FoodFromPlant subclass and disjointness axioms.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FOD_0003)
(category food)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (instance ?ITEM FoodFromPlant)
    (and
      (instance ?ITEM Food)
      (not (instance ?ITEM Meat)))))

(answer yes)
