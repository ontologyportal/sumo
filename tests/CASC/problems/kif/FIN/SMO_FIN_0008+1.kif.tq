;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0008+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Processing a check withdraws its value
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Processing a check yields a matching withdrawal from its backing account.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0008
;;
;; Status   : Theorem
;; Comments : Projects the check-clearing withdrawal and its amount, source account, and timing.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0008)
(category finance)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (monetaryValue ?CHECK ?AMOUNT)
      (checkAccount ?CHECK ?ACCOUNT)
      (instance ?PROCESSING ProcessingACheck)
      (patient ?PROCESSING ?CHECK)
      (equal (WhenFn ?PROCESSING) ?PROCESSINGTIME))
    (exists (?WITHDRAWAL ?WITHDRAWALTIME)
      (and
        (instance ?WITHDRAWAL Withdrawal)
        (instrument ?WITHDRAWAL ?CHECK)
        (transactionAmount ?WITHDRAWAL ?AMOUNT)
        (origin ?WITHDRAWAL ?ACCOUNT)
        (equal (WhenFn ?WITHDRAWAL) ?WITHDRAWALTIME)
        (meetsTemporally ?PROCESSINGTIME ?WITHDRAWALTIME)))))

(answer yes)
