;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0013_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Payment lowers account balance
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : A 40-dollar payment from an account with a 100-dollar prior balance leaves 60 dollars afterward.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0013
;;
;; Status   : Theorem
;; Comments : Instantiates the payment-balance rule with subtraction of 40 from 100.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0013)
(category finance)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?ACCOUNT FinancialAccount)
      (instance ?PAYMENT Payment)
      (origin ?PAYMENT (CurrencyFn ?ACCOUNT))
      (instance ?PAYMENTAMOUNT CurrencyMeasure)
      (equal ?PAYMENTAMOUNT (MeasureFn 40 UnitedStatesDollar))
      (transactionAmount ?PAYMENT ?PAYMENTAMOUNT)
      (instance ?BEFORE TimePoint)
      (equal ?BEFORE (EndFn (ImmediatePastFn (WhenFn ?PAYMENT))))
      (instance ?PREVIOUSBALANCE CurrencyMeasure)
      (equal ?PREVIOUSBALANCE (MeasureFn 100 UnitedStatesDollar))
      (currentAccountBalance ?ACCOUNT ?BEFORE ?PREVIOUSBALANCE))
    (currentAccountBalance
      ?ACCOUNT
      (BeginFn (ImmediateFutureFn (WhenFn ?PAYMENT)))
      (MeasureFn 60 UnitedStatesDollar))))

(answer yes)
