;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0001+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Financial account has a provider
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every financial account is a financial and service contract held at a financial organization.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0001
;;
;; Status   : Theorem
;; Comments : Combines the financial-account contract and provider rules.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0001)
(category finance)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (instance ?ACCOUNT FinancialAccount)
    (and
      (instance ?ACCOUNT FinancialContract)
      (instance ?ACCOUNT ServiceContract)
      (exists (?PROVIDER)
        (and
          (instance ?PROVIDER FinancialOrganization)
          (accountAt ?ACCOUNT ?PROVIDER))))))

(answer yes)
