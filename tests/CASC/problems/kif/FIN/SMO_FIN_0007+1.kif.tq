;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0007+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Depositing a check creates a matching deposit
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Depositing a check yields a deposit of its monetary value into the check's account.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0007
;;
;; Status   : Theorem
;; Comments : Projects the check-deposit witness and classifies the resulting deposit as a transaction.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0007)
(category finance)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?ACTION DepositingACheck)
      (patient ?ACTION ?CHECK)
      (instance ?CHECK Check)
      (checkAccount ?CHECK ?ACCOUNT)
      (monetaryValue ?CHECK ?AMOUNT))
    (exists (?DEPOSIT)
      (and
        (instance ?DEPOSIT FinancialTransaction)
        (destination ?DEPOSIT (CurrencyFn ?ACCOUNT))
        (transactionAmount ?DEPOSIT ?AMOUNT)))))

(answer yes)
