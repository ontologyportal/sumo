;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0006+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Drawing a check identifies the account holder
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : The agent who draws a check is the holder of the account against which it is drawn.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0006
;;
;; Status   : Theorem
;; Comments : Combines the drawing-check rule with DrawingACheck subclass FinancialTransaction.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0006)
(category finance)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?DRAWING DrawingACheck)
      (patient ?DRAWING ?CHECK)
      (agent ?DRAWING ?CUSTOMER)
      (checkAccount ?CHECK ?ACCOUNT))
    (and
      (instance ?DRAWING FinancialTransaction)
      (accountHolder ?ACCOUNT ?CUSTOMER))))

(answer yes)
