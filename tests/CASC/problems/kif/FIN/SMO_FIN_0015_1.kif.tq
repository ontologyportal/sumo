;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0015_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Payment below monthly minimum incurs a penalty
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : Paying 20 dollars toward a 50-dollar monthly minimum on a liability account entails a penalty.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0015
;;
;; Status   : Theorem
;; Comments : Instantiates the minimum-payment penalty rule with an underpayment.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0015)
(category finance)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?ACCOUNT LiabilityAccount)
      (instance ?MINIMUM CurrencyMeasure)
      (equal ?MINIMUM (MeasureFn 50 UnitedStatesDollar))
      (minimumPayment ?ACCOUNT ?MINIMUM MonthDuration)
      (instance ?MONTH Month)
      (instance ?PAYMENT Payment)
      (destination ?PAYMENT (CurrencyFn ?ACCOUNT))
      (instance ?PAID CurrencyMeasure)
      (equal ?PAID (MeasureFn 20 UnitedStatesDollar))
      (paymentsPerPeriod ?ACCOUNT ?PAID ?MONTH))
    (exists (?PENALTY)
      (and
        (instance ?PENALTY Penalty)
        (destination ?PENALTY (CurrencyFn ?ACCOUNT))))))

(answer yes)
