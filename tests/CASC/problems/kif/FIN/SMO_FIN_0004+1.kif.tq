;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0004+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Issued bank card is linked to its issuer
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : A bank card issued by a financial organization links to an account at that organization.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0004
;;
;; Status   : Theorem
;; Comments : Uses the bank-card issuer rule to identify the account provider.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0004)
(category finance)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?CARD BankCard)
      (instance ?ISSUER FinancialOrganization)
      (issuedBy ?CARD ?ISSUER))
    (exists (?ACCOUNT)
      (and
        (instance ?ACCOUNT FinancialAccount)
        (cardAccount ?CARD ?ACCOUNT)
        (accountAt ?ACCOUNT ?ISSUER)))))

(answer yes)
