;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0016_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Five percent simple interest on one hundred dollars
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : At a five-percent fixed rate, simple interest on a 100-dollar principal is five dollars under SUMO's interest rule.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0016
;;
;; Status   : Theorem
;; Comments : Tests the financial interest formula and TFF arithmetic over 100, 5, and 5.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0016)
(category finance)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?ACCOUNT FinancialAccount)
      (instance ?PRINCIPAL CurrencyMeasure)
      (equal ?PRINCIPAL (MeasureFn 100 UnitedStatesDollar))
      (principalAmount ?ACCOUNT ?PRINCIPAL)
      (fixedInterestRate ?ACCOUNT 5)
      (instance ?INTEREST CurrencyMeasure)
      (equal ?INTEREST (MeasureFn ?AMOUNT UnitedStatesDollar))
      (simpleInterest ?ACCOUNT ?INTEREST ?PERIOD))
    (equal ?AMOUNT 5)))

(answer yes)
