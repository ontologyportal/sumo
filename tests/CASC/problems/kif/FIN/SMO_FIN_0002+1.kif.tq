;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0002+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Debit card links its holder to a deposit account
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : A person possessing a debit card holds a linked deposit account at a financial organization.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0002
;;
;; Status   : Theorem
;; Comments : Combines the debit-card account witness with the financial-account provider rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0002)
(category finance)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?CARD DebitCard)
      (possesses ?CUSTOMER ?CARD))
    (exists (?ACCOUNT ?PROVIDER)
      (and
        (instance ?ACCOUNT DepositAccount)
        (instance ?ACCOUNT FinancialContract)
        (instance ?PROVIDER FinancialOrganization)
        (cardAccount ?CARD ?ACCOUNT)
        (accountHolder ?ACCOUNT ?CUSTOMER)
        (accountAt ?ACCOUNT ?PROVIDER)))))

(answer yes)
