;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0012_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Deposit raises account balance
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : A 50-dollar deposit into an account with a 100-dollar starting balance leaves 150 dollars at the end of the deposit.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0012
;;
;; Status   : Theorem
;; Comments : Instantiates the deposit-balance rule with addition of 100 and 50.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0012)
(category finance)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?ACCOUNT FinancialAccount)
      (instance ?DEPOSIT Deposit)
      (destination ?DEPOSIT (CurrencyFn ?ACCOUNT))
      (instance ?DEPOSITAMOUNT CurrencyMeasure)
      (equal ?DEPOSITAMOUNT (MeasureFn 50 UnitedStatesDollar))
      (transactionAmount ?DEPOSIT ?DEPOSITAMOUNT)
      (instance ?START TimePoint)
      (equal ?START (BeginFn (WhenFn ?DEPOSIT)))
      (instance ?PREVIOUSBALANCE CurrencyMeasure)
      (equal ?PREVIOUSBALANCE (MeasureFn 100 UnitedStatesDollar))
      (currentAccountBalance ?ACCOUNT ?START ?PREVIOUSBALANCE))
    (currentAccountBalance
      ?ACCOUNT
      (EndFn (WhenFn ?DEPOSIT))
      (MeasureFn 150 UnitedStatesDollar))))

(answer yes)
