;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0011+1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Opening an account establishes its holder and provider
;; Version  : Merge.kif + FinancialOntology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Opening an account at a financial organization establishes a financial contract held there by the opening agent.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0011
;;
;; Status   : Theorem
;; Comments : Combines the account-opening witness with FinancialAccount subclass FinancialContract.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0011)
(category finance)
(minLang fof)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?OPENING OpeningAnAccount)
      (eventLocated ?OPENING ?PROVIDER)
      (instance ?PROVIDER FinancialOrganization)
      (agent ?OPENING ?CUSTOMER)
      (equal (WhenFn ?OPENING) ?OPENINGTIME))
    (exists (?ACCOUNT ?PERIOD)
      (and
        (instance ?ACCOUNT FinancialContract)
        (accountAt ?ACCOUNT ?PROVIDER)
        (accountHolder ?ACCOUNT ?CUSTOMER)
        (agreementPeriod ?ACCOUNT ?PERIOD)
        (meetsTemporally ?OPENINGTIME ?PERIOD)))))

(answer yes)
