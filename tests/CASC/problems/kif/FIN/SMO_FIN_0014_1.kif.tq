;;------------------------------------------------------------------------------
;; File     : SMO_FIN_0014_1 : SUMO/CASC source.
;; Domain   : Finance
;; Problem  : Negative balance gives an overdraft amount
;; Version  : Merge.kif + FinancialOntology.kif axioms; _1 denotes TFF formulation 1.
;; English  : An account balance of minus 25 dollars entails an overdraft of 25 dollars on that date.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, FinancialOntology.kif
;; Names    : SMO_FIN_0014
;;
;; Status   : Theorem
;; Comments : Instantiates the overdraft rule with a negative dollar balance.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_FIN_0014)
(category finance)
(minLang tff)
(include Merge.kif)
(include FinancialOntology.kif)

(query
  (=>
    (and
      (instance ?BALANCE CurrencyMeasure)
      (equal ?BALANCE (MeasureFn -25 UnitedStatesDollar))
      (currentAccountBalance ?ACCOUNT ?DATE ?BALANCE))
    (overdraft
      ?ACCOUNT
      (MeasureFn 25 UnitedStatesDollar)
      ?DATE)))

(answer yes)
