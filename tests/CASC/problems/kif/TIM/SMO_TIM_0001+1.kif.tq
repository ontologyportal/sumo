;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0001+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Ordering nonadjacent Jurassic ages
;; Version  : Merge.kif + GeochronologicTimes.kif axioms; +1 denotes FOF formulation 1.
;; English  : The Hettangian age ended before the Pliensbachian age began.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and GeochronologicTimes.kif
;; Names    : SMO_TIM_0001
;;
;; Status   : Theorem
;; Comments : GeochronologicTimes.kif says Hettangian meets Sinemurian
;;          : and Sinemurian meets Pliensbachian. Merge.kif orders the
;;          : endpoints of a time interval and defines earlier.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0001)
(category temporalReasoning)
(minLang fof)
(include Merge.kif)
(include GeochronologicTimes.kif)

(query
  (earlier Hettangian Pliensbachian))

(answer yes)
