;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0004+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : A question precedes its answer
;; Version  : Merge.kif + Mid-level-ontology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every answering event refers to a questioning event that ended before the answer began.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Mid-level-ontology.kif
;; Names    : SMO_TIM_0004
;;
;; Status   : Theorem
;; Comments : Combines the Answering rule with the endpoint definition of earlier.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0004)
(category temporalReasoning)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)

(query
  (=>
    (instance ?ANSWER Answering)
    (exists (?QUESTION)
      (and
        (instance ?QUESTION Questioning)
        (refers ?ANSWER ?QUESTION)
        (before
          (EndFn (WhenFn ?QUESTION))
          (BeginFn (WhenFn ?ANSWER)))))))

(answer yes)
