;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0006^1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Stellar phase succession
;; Version  : Merge.kif + Astronomy.kif axioms; ^1 denotes THF formulation 1.
;; English  : A star in its subgiant phase had an earlier main-sequence phase.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Astronomy.kif
;; Names    : SMO_TIM_0006
;;
;; Status   : Theorem
;; Comments : Uses the stellar-evolution rule; holdsDuring takes a formula as an argument.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0006)
(category temporalReasoning)
(minLang thf)
(include Merge.kif)
(include Astronomy.kif)

(query
  (=>
    (holdsDuring ?LATER
      (attribute ?STAR SubgiantStarPhase))
    (exists (?EARLIER)
      (and
        (instance ?EARLIER TimePosition)
        (before ?EARLIER ?LATER)
        (holdsDuring ?EARLIER
          (attribute ?STAR MainSequenceStarPhase))))))

(answer yes)
