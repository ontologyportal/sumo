;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0009+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : First and last walking steps
;; Version  : Merge.kif + Mid-level-ontology.kif axioms; +1 denotes FOF formulation 1.
;; English  : An ambulation has distinct first and last steps whose times are parts of the ambulation interval.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Mid-level-ontology.kif
;; Names    : SMO_TIM_0009
;;
;; Status   : Theorem
;; Comments : Combines the Ambulating step rule with starts and finishes as subrelations of temporalPart.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0009)
(category temporalReasoning)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)

(query
  (=>
    (instance ?WALK Ambulating)
    (exists (?FIRST ?LAST)
      (and
        (instance ?FIRST Stepping)
        (instance ?LAST Stepping)
        (not (equal ?FIRST ?LAST))
        (temporalPart
          (WhenFn ?FIRST)
          (WhenFn ?WALK))
        (temporalPart
          (WhenFn ?LAST)
          (WhenFn ?WALK))))))

(answer yes)
