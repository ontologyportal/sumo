;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0008+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Organizational succession
;; Version  : Merge.kif + Government.kif axioms; +1 denotes FOF formulation 1.
;; English  : The predecessor organization's existence ends before its successor's existence begins.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Government.kif
;; Names    : SMO_TIM_0008
;;
;; Status   : Theorem
;; Comments : Combines successorOrganization with Government.kif's earlier rule and Merge.kif's endpoint definition.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0008)
(category temporalReasoning)
(minLang fof)
(include Merge.kif)
(include Government.kif)

(query
  (=>
    (successorOrganization ?OLD ?NEW)
    (before
      (EndFn (WhenFn ?OLD))
      (BeginFn (WhenFn ?NEW)))))

(answer yes)
