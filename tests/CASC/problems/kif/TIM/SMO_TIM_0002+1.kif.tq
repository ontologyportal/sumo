;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0002+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Causal precedence
;; Version  : Merge.kif axioms; +1 denotes FOF formulation 1.
;; English  : A cause ends before the event it causes begins.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_TIM_0002
;;
;; Status   : Theorem
;; Comments : Combines the causes-to-earlier axiom with the definition of earlier.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0002)
(category temporalReasoning)
(minLang fof)
(include Merge.kif)

(query
  (=>
    (causes ?CAUSE ?EFFECT)
    (before
      (EndFn (WhenFn ?CAUSE))
      (BeginFn (WhenFn ?EFFECT)))))

(answer yes)
