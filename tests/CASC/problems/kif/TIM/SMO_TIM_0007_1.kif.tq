;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0007_1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Wind gust duration bound
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A measured wind gust in a geographic area lasts less than twenty seconds.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Weather.kif
;; Names    : SMO_TIM_0007
;;
;; Status   : Theorem
;; Comments : Combines Merge.kif duration-measure typing with Weather.kif's wind-gust bound.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0007)
(category temporalReasoning)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?GUST WindGust)
      (eventLocated ?GUST ?AREA)
      (instance ?AREA GeographicArea)
      (duration
        (WhenFn ?GUST)
        (MeasureFn ?SECONDS SecondDuration)))
    (lessThan ?SECONDS 20)))

(answer yes)
