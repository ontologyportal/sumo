;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0003_1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Conversion of day duration
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Two days have the same duration as forty-eight hours.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_TIM_0003
;;
;; Status   : Theorem
;; Comments : Instantiates the day-to-hour conversion and evaluates 2 times 24.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0003)
(category temporalReasoning)
(minLang tff)
(include Merge.kif)

(query
  (equal
    (MeasureFn 2 DayDuration)
    (MeasureFn 48 HourDuration)))

(answer yes)
