;;------------------------------------------------------------------------------
;; File     : SMO_TIM_0005+1 : SUMO/CASC source.
;; Domain   : Time
;; Problem  : Damage precedes bleeding
;; Version  : Merge.kif + Medicine.kif axioms; +1 denotes FOF formulation 1.
;; English  : If someone experiences bleeding, a damaging event affecting a vein or artery ended before the bleeding began.
;;
;; Refs     :
;; Source   : SUMO Merge.kif and Medicine.kif
;; Names    : SMO_TIM_0005
;;
;; Status   : Theorem
;; Comments : Combines the Bleeding injury rule with the endpoint definition of earlier.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TIM_0005)
(category temporalReasoning)
(minLang fof)
(include Merge.kif)
(include Medicine.kif)

(query
  (=>
    (and
      (instance ?BLEED Bleeding)
      (experiencer ?BLEED ?PERSON))
    (exists (?VESSEL ?DAMAGE)
      (and
        (or
          (instance ?VESSEL Vein)
          (instance ?VESSEL Artery))
        (part ?VESSEL ?PERSON)
        (instance ?DAMAGE Damaging)
        (patient ?DAMAGE ?VESSEL)
        (before
          (EndFn (WhenFn ?DAMAGE))
          (BeginFn (WhenFn ?BLEED)))))))

(answer yes)
