;;------------------------------------------------------------------------------
;; File     : SMO_GEO_0014_1 : SUMO/CASC source.
;; Domain   : Geometry
;; Problem  : Distance between landforms
;; Version  : Full SUMO axioms; _1 denotes TFF formulation 1.
;; English  : Badwater Basin is 136 kilometers from Mount Whitney.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEO_0014
;;
;; Status   : Theorem
;; Comments : Extracts a concrete distance from Geography.kif's measurement statement.
;;          : Uses the 51-file full SUMO source manifest.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_GEO_0014)
(category geometry)
(minLang tff)
(include tests/CASC/axiom-sets/full.sources)

(query
  (distance BadwaterBasin MountWhitney
    (MeasureFn 136 Kilometer)))

(answer yes)
