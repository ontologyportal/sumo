;;------------------------------------------------------------------------------
;; File     : SMO_GEO_0001+1 : SUMO/CASC source.
;; Domain   : Geometry
;; Problem  : Country within a continent
;; Version  : Full SUMO axioms; +1 denotes FOF formulation 1.
;; English  : Egypt is a geographic subregion of Africa.
;;
;; Refs     :
;; Source   : SUMO Geography.kif and full SUMO
;; Names    : SMO_GEO_0001
;;
;; Status   : Theorem
;; Comments : Combines the Egypt fact in CountriesAndRegions.kif with NorthernAfrica in Geography.kif.
;;          : Uses the 51-file full SUMO source manifest.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_GEO_0001)
(category geometry)
(minLang fof)
(include tests/CASC/axiom-sets/full.sources)

(query
  (geographicSubregion Egypt Africa))

(answer yes)
