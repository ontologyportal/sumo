;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0018_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Fog visibility threshold
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A fog observation with suspended aerosol has visibility below one thousand meters.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0018
;;
;; Status   : Theorem
;; Comments : Uses the Fogging visibility rule with all of its stated conditions.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0018)
(category weather)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?FOG Fogging)
      (eventLocated ?FOG ?AREA)
      (instance ?AREA GeographicArea)
      (instance ?AIR AtmosphericRegion)
      (orientation ?AIR ?AREA Above)
      (instance ?AEROSOL Aerosal)
      (locatedAtTime ?AEROSOL (WhenFn ?FOG) ?AIR)
      (instance ?LENGTH LengthMeasure)
      (equal ?LENGTH (MeasureFn ?DISTANCE Meter))
      (visibilityInMeteorology ?AREA (WhenFn ?FOG) ?LENGTH))
    (lessThan ?DISTANCE 1000.0)))

(answer yes)
