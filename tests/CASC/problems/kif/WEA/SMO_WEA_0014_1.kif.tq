;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0014_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Overcast sky cloud-cover bound
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A reported cloud-cover fraction during overcast weather exceeds 0.7.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0014
;;
;; Status   : Theorem
;; Comments : Uses the observed-fraction OvercastWeather rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0014)
(category weather)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?AREA GeographicArea)
      (instance ?WEATHER OvercastWeather)
      (eventLocated ?WEATHER ?AREA)
      (cloudCoverFraction ?AREA ?FRACTION))
    (greaterThan ?FRACTION 0.7)))

(answer yes)
