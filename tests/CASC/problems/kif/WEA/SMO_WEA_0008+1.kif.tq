;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0008+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Drought excludes overlapping rain
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : A drought in an area rules out a temporally overlapping rain event in an overlapping region.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0008
;;
;; Status   : Theorem
;; Comments : Uses the Drought exclusion rule without turning lack of rain into a merely likely statement.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0008)
(category weather)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?DROUGHT Drought)
      (eventLocated ?DROUGHT ?AREA))
    (not
      (exists (?RAIN ?REGION)
        (and
          (instance ?RAIN Raining)
          (instance ?REGION Region)
          (eventLocated ?RAIN ?REGION)
          (overlapsSpatially ?REGION ?AREA)
          (overlapsTemporally ?RAIN ?DROUGHT))))))

(answer yes)
