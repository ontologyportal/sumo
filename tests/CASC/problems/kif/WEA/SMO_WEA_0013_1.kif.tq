;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0013_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Partly cloudy sky fraction
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A reported cloud-cover fraction during partly cloudy weather is between 0.3 and 0.7 inclusive.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0013
;;
;; Status   : Theorem
;; Comments : Uses both bounds in the PartlyCloudyWeather observed-fraction rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0013)
(category weather)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?AREA GeographicArea)
      (instance ?WEATHER PartlyCloudyWeather)
      (eventLocated ?WEATHER ?AREA)
      (cloudCoverFraction ?AREA ?FRACTION))
    (and
      (greaterThanOrEqualTo ?FRACTION 0.3)
      (lessThanOrEqualTo ?FRACTION 0.7))))

(answer yes)
