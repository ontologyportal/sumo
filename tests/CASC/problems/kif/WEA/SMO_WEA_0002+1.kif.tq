;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0002+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Moving air in a weather system
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every weather system has a translocation subprocess whose patient is an atmospheric wind flow.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0002
;;
;; Status   : Theorem
;; Comments : Combines the WeatherSystem witness with WindFlow classification and location.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0002)
(category weather)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (instance ?SYSTEM WeatherSystem)
    (exists (?MOVE ?FLOW)
      (and
        (instance ?MOVE Translocation)
        (instance ?FLOW AirStream)
        (located ?FLOW EarthsAtmosphere)
        (patient ?MOVE ?FLOW)
        (subProcess ?MOVE ?SYSTEM)))))

(answer yes)
