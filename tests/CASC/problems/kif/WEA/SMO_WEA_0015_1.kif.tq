;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0015_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Strong wind speed threshold
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A measured surface wind classified as strong exceeds 58 miles per hour.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0015
;;
;; Status   : Theorem
;; Comments : Uses the StrongWind threshold for an observed surfaceWindSpeed.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0015)
(category weather)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?WIND StrongWind)
      (eventLocated ?WIND ?AREA)
      (instance ?AREA GeographicArea)
      (surfaceWindSpeed ?AREA (MeasureFn ?SPEED MilesPerHour)))
    (greaterThan ?SPEED 58)))

(answer yes)
