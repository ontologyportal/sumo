;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0017_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Blizzard snowfall and visibility
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A blizzard has a snowing subprocess and an affected area with visibility below 400 meters.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0017
;;
;; Status   : Theorem
;; Comments : Combines the two Blizzard witness rules.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0017)
(category weather)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (instance ?BLIZZARD Blizzard)
    (and
      (exists (?SNOW)
        (and
          (instance ?SNOW Snowing)
          (subProcess ?SNOW ?BLIZZARD)))
      (exists (?AREA ?DISTANCE ?LENGTH)
        (and
          (instance ?AREA GeographicArea)
          (eventLocated ?BLIZZARD ?AREA)
          (instance ?LENGTH LengthMeasure)
          (equal ?LENGTH (MeasureFn ?DISTANCE Meter))
          (visibilityInMeteorology ?AREA (WhenFn ?BLIZZARD) ?LENGTH)
          (lessThan ?DISTANCE 400.0))))))

(answer yes)
