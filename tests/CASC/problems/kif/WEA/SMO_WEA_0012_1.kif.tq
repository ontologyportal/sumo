;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0012_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Clear sky cloud-cover bound
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A reported cloud-cover fraction during clear weather is below 0.3.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0012
;;
;; Status   : Theorem
;; Comments : Uses the observed-fraction ClearWeather rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0012)
(category weather)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?AREA GeographicArea)
      (instance ?WEATHER ClearWeather)
      (eventLocated ?WEATHER ?AREA)
      (cloudCoverFraction ?AREA ?FRACTION))
    (lessThan ?FRACTION 0.3)))

(answer yes)
