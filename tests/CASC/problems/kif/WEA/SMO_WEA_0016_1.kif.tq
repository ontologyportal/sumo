;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0016_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Tropical storm sustained wind range
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A tropical storm has a location with a one-minute mean wind speed between 39 and 74 miles per hour.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0016
;;
;; Status   : Theorem
;; Comments : Uses the TropicalStorm wind-speed witness.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0016)
(category weather)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (instance ?STORM TropicalStorm)
    (exists (?AREA ?SPEED)
      (and
        (instance ?AREA GeographicArea)
        (eventLocated ?STORM ?AREA)
        (equal
          (MeasureFn ?SPEED MilesPerHour)
          (Mean1MinuteWindSpeedFn ?AREA (WhenFn ?STORM)))
        (greaterThanOrEqualTo ?SPEED 39.0)
        (lessThanOrEqualTo ?SPEED 74.0)))))

(answer yes)
