;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0003+1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : Rain is liquid precipitation
;; Version  : Merge.kif + Weather.kif axioms; +1 denotes FOF formulation 1.
;; English  : A raining event is liquid precipitation and transfers rainwater.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0003
;;
;; Status   : Theorem
;; Comments : Combines Raining and Rain classifications with the transferred-object rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0003)
(category weather)
(minLang fof)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (instance ?RAINING Raining)
    (and
      (instance ?RAINING Precipitation)
      (precipitationState ?RAINING Liquid)
      (exists (?WATER)
        (and
          (instance ?WATER WaterSolution)
          (objectTransferred ?RAINING ?WATER))))))

(answer yes)
