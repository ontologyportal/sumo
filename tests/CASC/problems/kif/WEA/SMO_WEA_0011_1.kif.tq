;;------------------------------------------------------------------------------
;; File     : SMO_WEA_0011_1 : SUMO/CASC source.
;; Domain   : Weather
;; Problem  : High-pressure system reading
;; Version  : Merge.kif + Weather.kif axioms; _1 denotes TFF formulation 1.
;; English  : A high-pressure weather system has a barometric-pressure reading above 30.2 inches of mercury.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Weather.kif
;; Names    : SMO_WEA_0011
;;
;; Status   : Theorem
;; Comments : Uses the HighPressureWeatherSystem pressure witness.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_WEA_0011)
(category weather)
(minLang tff)
(include Merge.kif)
(include Weather.kif)

(query
  (=>
    (and
      (instance ?SYSTEM HighPressureWeatherSystem)
      (eventLocated ?SYSTEM ?AREA))
    (exists (?PRESSURE)
      (and
        (barometricPressure ?AREA (MeasureFn ?PRESSURE InchMercury))
        (greaterThan ?PRESSURE 30.2)))))

(answer yes)
