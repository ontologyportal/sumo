;;------------------------------------------------------------------------------
;; File     : SMO_AST_0002+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : A probe orbiting an exoplanet shares its extrasolar system
;; Version  : Merge.kif + Mid-level-ontology.kif + Astronomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : A fictional mission places a probe in orbit around a newly
;;          : identified exoplanet. Must the probe and planet belong to a
;;          : common planetary system other than the Solar System, even
;;          : without naming the planet's host star or system?
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Astronomy.kif
;; Names    : SMO_AST_0002
;;
;; Status   : Theorem
;; Comments : The exoplanet rule supplies a host star and extrasolar system.
;;          : Planetary-system membership then propagates from the star to
;;          : the planet and from the planet to the orbiting probe.
;;          : Neither the host star nor any system membership is asserted.
;;          : Source verified with Vampire in FOF mode (SInE scope 1).
;;          : Packaged TPTP translation has not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_AST_0002)
(category astronomy)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Astronomy.kif)

; Assertions: a fictional probe has reached orbit around an exoplanet.
(instance MissionPlanet Exoplanet)
(instance MissionProbe ArtificialSatellite)
(orbits MissionProbe MissionPlanet)

; Conjecture: both mission objects belong to the same extrasolar system.
(query
  (exists (?SYSTEM)
    (and
      (instance ?SYSTEM PlanetarySystem)
      (not (equal ?SYSTEM TheSolarSystem))
      (member MissionPlanet ?SYSTEM)
      (member MissionProbe ?SYSTEM))))

(answer yes)
