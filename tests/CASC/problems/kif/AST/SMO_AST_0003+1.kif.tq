;;------------------------------------------------------------------------------
;; File     : SMO_AST_0003+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Identifying a working satellite relay from redundant telemetry
;; Version  : Merge.kif + Mid-level-ontology.kif axioms; +1 denotes FOF formulation 1.
;; English  : Mission control needs a working communication relay. A reliable
;;          : redundancy monitor reports that at least one of two satellite
;;          : relays is functioning. Fault telemetry reports Relay A as
;;          : not functioning. Must Relay B be functioning?
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif
;; Names    : SMO_AST_0003
;;
;; Status   : Theorem
;; Comments : All telemetry describes the same operational snapshot.
;;          : The negative fault report rules out Relay A; combine it with
;;          : the monitor's alternatives to establish Relay B's condition.
;;          : The at-least-one-working report is an explicit observation;
;;          : a fault in Relay A alone would not establish Relay B's condition.
;;          : Source verified with the native prover in FOF mode (SInE scope 1).
;;          : The proof uses both telemetry observations.
;;          : Packaged TPTP translation has not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_AST_0003)
(category astronomy)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)

; Assertions: two distinct relays and reliable telemetry for one snapshot.
(instance RelayA CommunicationSatellite)
(instance RelayB CommunicationSatellite)
(not (equal RelayA RelayB))

; The redundancy monitor guarantees at least one functioning relay.
(or
  (attribute RelayA Functioning)
  (attribute RelayB Functioning))

; Fault telemetry rules out Relay A as a functioning relay.
(not (attribute RelayA Functioning))

; Conjecture: mission control can identify Relay B as the working relay.
(query
  (attribute RelayB Functioning))

(answer yes)
