;;------------------------------------------------------------------------------
;; File     : SMO_AST_0004+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Space transportation uses a vehicle in a space region
;; Version  : Merge.kif + Mid-level-ontology.kif axioms; +1 denotes FOF formulation 1.
;; English  : A space-transportation event is a translocation involving a spacecraft vehicle in a space region.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif
;; Names    : SMO_AST_0004
;;
;; Status   : Theorem
;; Comments : Combines the space-transportation witness rule with transportation and vehicle hierarchies.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_AST_0004)
(category astronomy)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)

(query
  (=>
    (instance ?TRIP SpaceTransportation)
    (exists (?CRAFT ?REGION)
      (and
        (instance ?TRIP Translocation)
        (instance ?CRAFT TransportationDevice)
        (instance ?REGION SpaceRegion)
        (instrument ?TRIP ?CRAFT)
        (eventLocated ?TRIP ?REGION)))))

(answer yes)
