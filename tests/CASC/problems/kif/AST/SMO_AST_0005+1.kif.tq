;;------------------------------------------------------------------------------
;; File     : SMO_AST_0005+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Rocket as spacecraft and aircraft
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Under SUMO's classifications, a rocket is both a spacecraft and an aircraft, hence a transportation device.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_AST_0005
;;
;; Status   : Theorem
;; Comments : Joins the Rocket subclass axioms across Mid-level-ontology.kif and Transportation.kif.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_AST_0005)
(category astronomy)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?ROCKET Rocket)
    (and
      (instance ?ROCKET Spacecraft)
      (instance ?ROCKET Aircraft)
      (instance ?ROCKET TransportationDevice))))

(answer yes)
