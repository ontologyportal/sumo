;;------------------------------------------------------------------------------
;; File     : SMO_AST_0006+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Stellar remnant has a star and formation process
;; Version  : Merge.kif + Mid-level-ontology.kif + Astronomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : A stellar remnant is a connected astronomical object formed by a natural process using a star.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Astronomy.kif
;; Names    : SMO_AST_0006
;;
;; Status   : Theorem
;; Comments : Combines the remnant witness rule with astronomical-body and process taxonomies.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_AST_0006)
(category astronomy)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Astronomy.kif)

(query
  (=>
    (instance ?REMNANT StellarRemnant)
    (exists (?STAR ?PROCESS)
      (and
        (instance ?REMNANT SelfConnectedObject)
        (instance ?STAR Star)
        (instance ?PROCESS NaturalProcess)
        (result ?PROCESS ?REMNANT)
        (resource ?PROCESS ?STAR)))))

(answer yes)
