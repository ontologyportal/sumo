;;------------------------------------------------------------------------------
;; File     : SMO_AST_0007+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Sol emits electromagnetic radiation
;; Version  : Merge.kif + Mid-level-ontology.kif + Astronomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : Since Sol is a star, there is a light-radiation event originating from it.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Astronomy.kif
;; Names    : SMO_AST_0007
;;
;; Status   : Theorem
;; Comments : Combines Sol's star fact with the star-radiation rule and radiation taxonomy.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_AST_0007)
(category astronomy)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Astronomy.kif)

(query
  (exists (?LIGHT)
    (and
      (instance ?LIGHT RadiatingElectromagnetic)
      (origin ?LIGHT Sol))))

(answer yes)
