;;------------------------------------------------------------------------------
;; File     : SMO_AST_0008+1 : SUMO/CASC source.
;; Domain   : Astronomy and Space
;; Problem  : Supernova causes a light-radiation event
;; Version  : Merge.kif + Mid-level-ontology.kif + Astronomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : A supernova is a natural process that causes electromagnetic radiation in a region.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Astronomy.kif
;; Names    : SMO_AST_0008
;;
;; Status   : Theorem
;; Comments : Combines the supernova radiation witness with astronomical-process and radiation taxonomies.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_AST_0008)
(category astronomy)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Astronomy.kif)

(query
  (=>
    (instance ?SUPERNOVA Supernova)
    (exists (?LIGHT ?REGION)
      (and
        (instance ?SUPERNOVA NaturalProcess)
        (instance ?LIGHT RadiatingElectromagnetic)
        (instance ?REGION Region)
        (patient ?LIGHT ?REGION)
        (causes ?SUPERNOVA ?LIGHT)))))

(answer yes)
