;;------------------------------------------------------------------------------
;; File     : SMO_TRN_0008+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Distinct tracks in a multiple-track railway
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : A multiple-track railway contains at least two distinct stationary railroad tracks.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0008
;;
;; Status   : Theorem
;; Comments : Combines the multiple-track witness rule with RailroadTrack subclass StationaryArtifact.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TRN_0008)
(category transportation)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?RAILWAY MultipleTrackRailway)
    (exists (?TRACK1 ?TRACK2)
      (and
        (instance ?TRACK1 StationaryArtifact)
        (instance ?TRACK2 StationaryArtifact)
        (not (equal ?TRACK1 ?TRACK2))
        (part ?TRACK1 ?RAILWAY)
        (part ?TRACK2 ?RAILWAY)))))

(answer yes)
