;;------------------------------------------------------------------------------
;; File     : SMO_TRN_0003+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Vehicle in a land transportation service
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : A land transportation service includes a land trip using a vehicle.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0003
;;
;; Status   : Theorem
;; Comments : Combines the land-service witness rule with LandVehicle subclass Vehicle.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TRN_0003)
(category transportation)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?SERVICE LandTransportationService)
    (exists (?TRIP ?VEHICLE)
      (and
        (instance ?TRIP LandTransportation)
        (instance ?VEHICLE Vehicle)
        (instrument ?TRIP ?VEHICLE)
        (subProcess ?TRIP ?SERVICE)))))

(answer yes)
