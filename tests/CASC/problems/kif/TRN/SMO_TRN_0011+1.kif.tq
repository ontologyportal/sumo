;;------------------------------------------------------------------------------
;; File     : SMO_TRN_0011+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Merchant marine ship registration
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : A ship in an area's merchant marine has a registration possessed by the ship and recorded in the area's register.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0011
;;
;; Status   : Theorem
;; Comments : Uses the merchant-marine membership rule to infer a registration witness.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TRN_0011)
(category transportation)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

(query
  (=>
    (and
      (instance ?SHIP Ship)
      (instance ?AREA GeopoliticalArea)
      (member ?SHIP (MerchantMarineFn ?AREA)))
    (exists (?REGISTRATION)
      (and
        (instance ?REGISTRATION ShipRegistration)
        (possesses ?SHIP ?REGISTRATION)
        (subsumesContentInstance
          (ShipRegisterFn ?AREA)
          ?REGISTRATION)))))

(answer yes)
