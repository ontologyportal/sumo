;;------------------------------------------------------------------------------
;; File     : SMO_TRN_0010+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Container ship type and cargo
;; Version  : Merge.kif + Mid-level-ontology.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : A container ship is a water vehicle designed to carry ship containers.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Transportation.kif
;; Names    : SMO_TRN_0010
;;
;; Status   : Theorem
;; Comments : Combines the ContainerShip cargoType rule with the CargoShip-to-WaterVehicle hierarchy.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TRN_0010)
(category transportation)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?SHIP ContainerShip)
    (and
      (instance ?SHIP WaterVehicle)
      (cargoType ?SHIP ShipContainer))))

(answer yes)
