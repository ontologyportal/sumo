;;------------------------------------------------------------------------------
;; File     : SMO_TRN_0014+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Transitway junction connects two routes
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : A transitway junction connects two distinct transitways, both geographic areas.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0014
;;
;; Status   : Theorem
;; Comments : Combines the junction witness rule with Transitway subclass GeographicArea.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TRN_0014)
(category transportation)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?JUNCTION TransitwayJunction)
    (exists (?ROUTE1 ?ROUTE2)
      (and
        (instance ?ROUTE1 GeographicArea)
        (instance ?ROUTE2 GeographicArea)
        (not (equal ?ROUTE1 ?ROUTE2))
        (connects ?JUNCTION ?ROUTE1 ?ROUTE2)))))

(answer yes)
