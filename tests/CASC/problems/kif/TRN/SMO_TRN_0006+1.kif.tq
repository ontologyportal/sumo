;;------------------------------------------------------------------------------
;; File     : SMO_TRN_0006+1 : SUMO/CASC source.
;; Domain   : Transportation
;; Problem  : Airport apron location
;; Version  : Merge.kif + Transportation.kif axioms; +1 denotes FOF formulation 1.
;; English  : Every airport apron is located in an airport that is a geographic area.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Transportation.kif
;; Names    : SMO_TRN_0006
;;
;; Status   : Theorem
;; Comments : Combines the apron-location rule with Airport, AirTransitway, Transitway, and GeographicArea.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number and domain are assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_TRN_0006)
(category transportation)
(minLang fof)
(include Merge.kif)
(include Transportation.kif)

(query
  (=>
    (instance ?APRON AirportApron)
    (exists (?AIRPORT)
      (and
        (instance ?AIRPORT Airport)
        (instance ?AIRPORT GeographicArea)
        (located ?APRON ?AIRPORT)))))

(answer yes)
