;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0031_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Tangent at zero
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The tangent of zero is zero.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0031
;;
;; Status   : Theorem
;; Comments : Merge.kif defines TangentFn as SineFn divided by CosineFn.
;;          : Numeric sine and cosine values need additional support.
;;          : Its tangent axiom applies CosineFn to a RealNumber, although
;;          : CosineFn declares a PlaneAngleMeasure argument; typed
;;          : translation must address that mismatch.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0031)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (TangentFn 0.0) 0.0))

(answer yes)
