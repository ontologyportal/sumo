;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0001_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Every integer is less than itself plus one
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : For every integer N, N is less than N + 1.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0001
;;
;; Status   : Theorem
;; Comments : Expected from the Merge.kif successor and addition axioms.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0001)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (forall (?N)
    (=>
      (instance ?N Integer)
      (lessThan ?N (AdditionFn ?N 1)))))

(answer yes)
