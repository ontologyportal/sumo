;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0037_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Sum of a two-element list
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The sum of 2.0 and 3.0 in a list is 5.0.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0037
;;
;; Status   : Theorem
;; Comments : Tests ListSumFn on a two-element ListFn value.
;;          : TFF translation must preserve the list constructor,
;;          : length, element order, and sublist semantics needed by
;;          : Merge.kif's recursive ListSumFn axioms.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0037)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (ListSumFn (ListFn 2.0 3.0)) 5.0))

(answer yes)
