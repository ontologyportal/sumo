;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0009_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Signed multiplication of real literals
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Negative seven times six equals negative forty-two.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0009
;;
;; Status   : Theorem
;; Comments : Tests MultiplicationFn on negative and positive real literals.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0009)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (MultiplicationFn -7.0 6.0) -42.0))

(answer yes)
