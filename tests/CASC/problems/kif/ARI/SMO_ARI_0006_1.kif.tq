;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0006_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Predecessor reverses successor on integers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : For an integer N, the predecessor of its successor is N.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0006
;;
;; Status   : Theorem
;; Comments : Expected from the successor-predecessor inverse axiom in Merge.kif.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0006)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (=>
    (instance ?N Integer)
    (equal
      ?N
      (PredecessorFn (SuccessorFn ?N)))))

(answer yes)
