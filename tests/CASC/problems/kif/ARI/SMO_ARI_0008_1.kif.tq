;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0008_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Reversing a four-term sum with an absolute value
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : For real Y, Z, and W, |-5.0| + (Y + (Z + W)) equals
;;          : W + (Z + (Y + 5.0)).
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0008
;;
;; Status   : Theorem
;; Comments : Combines |-5.0| = 5.0 with associativity and commutativity of
;;          : AdditionFn; translation and proof have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0008)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (=>
    (and
      (instance ?Y RealNumber)
      (instance ?Z RealNumber)
      (instance ?W RealNumber))
    (equal
      (AdditionFn (AbsoluteValueFn -5.0)
        (AdditionFn ?Y (AdditionFn ?Z ?W)))
      (AdditionFn ?W
        (AdditionFn ?Z (AdditionFn ?Y 5.0))))))

(answer yes)
