;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0034_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Arc cosine of one
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The arc cosine of one is zero.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0034
;;
;; Status   : Theorem
;; Comments : Tests ArcCosineFn directly on a real-valued argument.
;;          : Merge.kif's inverse axiom does not determine this numeric
;;          : result; a translator interpretation or additional cosine
;;          : axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0034)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (ArcCosineFn 1.0) 0.0))

(answer yes)
