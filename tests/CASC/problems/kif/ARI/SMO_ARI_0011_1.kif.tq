;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0011_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Real division yields a non-integer quotient
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Seven divided by two equals three and one half.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0011
;;
;; Status   : Theorem
;; Comments : Tests DivisionFn with a nonzero divisor and a real quotient.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0011)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (DivisionFn 7.0 2.0) 3.5))

(answer yes)
