;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0036_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Real part of a real quotient
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The real part of 7.0 divided by 2.0 is 3.5.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0036
;;
;; Status   : Theorem
;; Comments : Tests RealNumberFn on a non-integer real-valued expression.
;;          : Merge.kif does not axiomatize RealNumberFn as the identity
;;          : on real inputs. A translator interpretation or additional
;;          : axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0036)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (RealNumberFn (DivisionFn 7.0 2.0)) 3.5))

(answer yes)
