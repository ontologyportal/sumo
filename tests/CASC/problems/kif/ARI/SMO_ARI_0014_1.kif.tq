;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0014_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Floor of a negative non-integer real number
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The floor of -2.3 is -3, rather than -2.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0014
;;
;; Status   : Theorem
;; Comments : Tests translation of FloorFn to interpreted TFF floor arithmetic.
;;          : Merge.kif documents the operation but comments out its rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0014)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (FloorFn -2.3) -3))

(answer yes)
