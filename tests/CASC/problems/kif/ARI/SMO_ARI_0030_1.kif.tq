;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0030_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Cosine of a zero-degree angle
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The cosine of an angle measuring zero degrees is one.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0030
;;
;; Status   : Theorem
;; Comments : MeasureFn with AngularDegree supplies a PlaneAngleMeasure,
;;          : matching the declared domain of CosineFn.
;;          : Merge.kif has no numeric cosine axiom, so a translator
;;          : interpretation or additional axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0030)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (CosineFn (MeasureFn 0.0 AngularDegree)) 1.0))

(answer yes)
