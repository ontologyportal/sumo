;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0010_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Subtraction yields a negative real result
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Three minus eight equals negative five.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0010
;;
;; Status   : Theorem
;; Comments : Tests SubtractionFn with real literals and a negative result.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0010)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (SubtractionFn 3.0 8.0) -5.0))

(answer yes)
