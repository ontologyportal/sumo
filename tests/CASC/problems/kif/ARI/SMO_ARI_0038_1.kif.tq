;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0038_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Average of a two-element list
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The average of 2.0 and 3.0 is 2.5.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0038
;;
;; Status   : Theorem
;; Comments : Tests AverageFn using ListSumFn and ListLengthFn.
;;          : Merge.kif defines the average of a nonempty list as its
;;          : sum divided by its length. TFF translation must preserve
;;          : the list operations required to evaluate that expression.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0038)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (AverageFn (ListFn 2.0 3.0)) 2.5))

(answer yes)
