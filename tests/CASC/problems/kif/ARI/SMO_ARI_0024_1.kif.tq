;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0024_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Denominator of a simple rational value
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The denominator of 0.5, reduced to 1/2, is 2.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0024
;;
;; Status   : Theorem
;; Comments : Tests DenominatorFn on a concrete rational value.
;;          : Merge.kif declares and documents DenominatorFn but has no
;;          : axiom that determines its result. A translator interpretation
;;          : or additional axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0024)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (DenominatorFn 0.5) 2))

(answer yes)
