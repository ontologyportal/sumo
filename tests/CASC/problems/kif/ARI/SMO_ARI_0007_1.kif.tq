;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0007_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : The absolute value of a negative number is positive
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The absolute value of -5.0 is 5.0.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0007
;;
;; Status   : Theorem
;; Comments : Expected from the negative-argument absolute-value axiom.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0007)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (AbsoluteValueFn -5.0) 5.0))

(answer yes)
