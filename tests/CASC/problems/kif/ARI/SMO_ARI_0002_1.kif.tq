;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0002_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Addition is commutative for real numbers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : For all real numbers X and Y, X + Y equals Y + X.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0002
;;
;; Status   : Theorem
;; Comments : Follows from AdditionFn being a CommutativeFunction.
;;          : Checked with sigma-rs TFF translation and Vampire.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0002)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (=>
    (and
      (instance ?X RealNumber)
      (instance ?Y RealNumber))
    (equal (AdditionFn ?X ?Y) (AdditionFn ?Y ?X))))

(answer yes)
