;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0016_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Rounding a positive non-half-integer real number
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Rounding 2.7 to the nearest integer yields 3.0.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0016
;;
;; Status   : Theorem
;; Comments : Tests RoundFn away from a halfway tie.
;;          : Merge.kif documents rounding but comments out its rule; a TFF
;;          : interpretation or axiom is needed. Proof has not been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0016)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (RoundFn 2.7) 3.0))

(answer yes)
