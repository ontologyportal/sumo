;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0015_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Ceiling of a positive non-integer real number
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The ceiling of 2.3 is 3, rather than 2.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0015
;;
;; Status   : Theorem
;; Comments : Tests translation of CeilingFn to interpreted TFF ceiling arithmetic.
;;          : Merge.kif documents the operation but comments out its rule.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0015)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (CeilingFn 2.3) 3))

(answer yes)
