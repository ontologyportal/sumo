;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0022_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Arc cosine reverses cosine at Pi
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Taking the arc cosine of the cosine of Pi returns Pi.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0022
;;
;; Status   : Theorem
;; Comments : Uses the ArcCosineFn/CosineFn inverse axiom and the
;;          : classification of Pi as a real number in Merge.kif.
;;          : CosineFn's declared domain is PlaneAngleMeasure, while the
;;          : inverse axiom applies to RealNumber; typed translation needs
;;          : to reconcile this mismatch.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0022)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (ArcCosineFn (CosineFn Pi)) Pi))

(answer yes)
