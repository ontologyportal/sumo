;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0022_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Reciprocal of negative one
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The reciprocal of -1 is -1.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0022
;;
;; Status   : Theorem
;; Comments : Tests ReciprocalFn directly. Merge.kif states that a nonzero
;;          : integer times its reciprocal is 1; interpreted multiplication
;;          : then determines this result for -1.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0022)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (ReciprocalFn -1) -1))

(answer yes)
