;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0026_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Logarithm with an exact integer result
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The base-2 logarithm of 8.0 is 3.0.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0026
;;
;; Status   : Theorem
;; Comments : Tests LogFn with the number first and the base second.
;;          : Merge.kif declares and documents LogFn but has no axiom
;;          : that determines its result. A translator interpretation or
;;          : additional axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0026)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (LogFn 8.0 2) 3.0))

(answer yes)
