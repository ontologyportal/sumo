;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0019_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Sign of a negative real number
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The sign of -5.0 is -1.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0019
;;
;; Status   : Theorem
;; Comments : Tests SignumFn on a negative numeric literal using the
;;          : negative-real sign axiom in Merge.kif. The translation must
;;          : recognize the literal as a NegativeRealNumber.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0019)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (SignumFn -5.0) -1))

(answer yes)
