;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0018_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Maximum of two distinct numbers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The maximum of 3 and 7 is 7.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0018
;;
;; Status   : Theorem
;; Comments : Tests the MaxFn result axiom with distinct numeric arguments.
;;          : Requires TFF numeric ordering; translation and prover result
;;          : have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0018)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (MaxFn 3 7) 7))

(answer yes)
