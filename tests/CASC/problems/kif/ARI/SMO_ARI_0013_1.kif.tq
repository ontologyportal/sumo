;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0013_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : A nonzero integer times its inverse power equals one
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : For a nonzero integer N, N * N^(-1) equals 1.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0013
;;
;; Status   : Theorem
;; Comments : Combines the reciprocal/exponent -1 axiom with the multiplicative
;;          : reciprocal axiom; translation and proof have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0013)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (=>
    (and
      (instance ?N Integer)
      (not (equal ?N 0)))
    (equal
      1
      (MultiplicationFn ?N (ExponentiationFn ?N -1)))))

(answer yes)
