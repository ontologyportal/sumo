;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0023_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Numerator of a simple rational value
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The numerator of 0.5, reduced to 1/2, is 1.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0023
;;
;; Status   : Theorem
;; Comments : Tests NumeratorFn on a concrete rational value.
;;          : Merge.kif declares and documents NumeratorFn but has no
;;          : axiom that determines its result. A translator interpretation
;;          : or additional axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0023)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (NumeratorFn 0.5) 1))

(answer yes)
