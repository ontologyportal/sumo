;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0017_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Minimum of two distinct numbers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The minimum of 3 and 7 is 3.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0017
;;
;; Status   : Theorem
;; Comments : Tests the MinFn result axiom with distinct numeric arguments.
;;          : Requires TFF numeric ordering; translation and prover result
;;          : have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0017)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (MinFn 3 7) 3))

(answer yes)
