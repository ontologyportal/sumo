;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0003_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Addition is associative for real numbers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : For real numbers X, Y, and Z, X + (Y + Z) equals (X + Y) + Z.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0003
;;
;; Status   : Theorem
;; Comments : Expected from AdditionFn being an AssociativeFunction.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0003)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (=>
    (and
      (instance ?X RealNumber)
      (instance ?Y RealNumber)
      (instance ?Z RealNumber))
    (equal
      (AdditionFn ?X (AdditionFn ?Y ?Z))
      (AdditionFn (AdditionFn ?X ?Y) ?Z))))

(answer yes)
