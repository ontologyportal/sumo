;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0027_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Greatest common divisor of two integers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The greatest common divisor of 12 and 18 is 6.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0027
;;
;; Status   : Theorem
;; Comments : Tests GreatestCommonDivisorFn with two arguments.
;;          : Its Merge.kif axioms constrain nonzero results but do not
;;          : exclude zero, so the exact result needs stronger axioms or
;;          : a translator interpretation. Variable arity also needs a
;;          : TFF encoding. Translation and proof have not been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0027)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (GreatestCommonDivisorFn 12 18) 6))

(answer yes)
