;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0032_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Arc sine reverses sine within its principal range
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Applying arc sine to the sine of 0.5 returns 0.5.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0032
;;
;; Status   : Theorem
;; Comments : Uses the ArcSineFn/SineFn inverse axiom in Merge.kif.
;;          : The chosen input lies within the usual principal range;
;;          : this checks inverse composition, not numeric sine evaluation.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0032)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (ArcSineFn (SineFn 0.5)) 0.5))

(answer yes)
