;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0005_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Less-than is transitive on real numbers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : If real numbers X < Y and Y < Z, then X < Z.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0005
;;
;; Status   : Theorem
;; Comments : Expected from lessThan being a TransitiveRelation.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0005)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (=>
    (and
      (instance ?X RealNumber)
      (instance ?Y RealNumber)
      (instance ?Z RealNumber)
      (lessThan ?X ?Y)
      (lessThan ?Y ?Z))
    (lessThan ?X ?Z)))

(answer yes)
