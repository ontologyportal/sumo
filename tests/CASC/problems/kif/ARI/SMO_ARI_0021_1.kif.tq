;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0021_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Squaring a square root
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The square of the square root of 2.0 is 2.0.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0021
;;
;; Status   : Theorem
;; Comments : Tests SquareRootFn through its active multiplication axiom.
;;          : Merge.kif does not axiomatize the nonnegative principal root,
;;          : so this tests the square relation rather than an exact root.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0021)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal
    (MultiplicationFn (SquareRootFn 2.0) (SquareRootFn 2.0))
    2.0))

(answer yes)
