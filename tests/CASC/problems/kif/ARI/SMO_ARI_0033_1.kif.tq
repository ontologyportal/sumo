;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0033_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Arc tangent reverses tangent within its principal range
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : Applying arc tangent to the tangent of 0.5 returns 0.5.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0033
;;
;; Status   : Theorem
;; Comments : Uses the ArcTangentFn/TangentFn inverse axiom in Merge.kif.
;;          : The chosen input lies within the usual principal range;
;;          : this checks inverse composition, not numeric tangent evaluation.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0033)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (ArcTangentFn (TangentFn 0.5)) 0.5))

(answer yes)
