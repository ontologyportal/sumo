;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0004_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : The successor function is injective on integers
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : If integers X and Y have the same successor, then X equals Y.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0004
;;
;; Status   : Theorem
;; Comments : Expected from the SuccessorFn injectivity axiom in Merge.kif.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0004)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (=>
    (and
      (instance ?X Integer)
      (instance ?Y Integer)
      (equal (SuccessorFn ?X) (SuccessorFn ?Y)))
    (equal ?X ?Y)))

(answer yes)
