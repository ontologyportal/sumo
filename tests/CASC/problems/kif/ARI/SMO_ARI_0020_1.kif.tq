;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0020_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Cube of a negative real number
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The cube of -3.0 is -27.0.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0020
;;
;; Status   : Theorem
;; Comments : Tests CubicFn using its multiplication axiom in Merge.kif.
;;          : Translation must interpret real multiplication; the prover
;;          : result has not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0020)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (CubicFn -3.0) -27.0))

(answer yes)
