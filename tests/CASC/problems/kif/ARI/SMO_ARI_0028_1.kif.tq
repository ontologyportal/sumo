;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0028_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Sine at zero
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The sine of zero is zero.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0028
;;
;; Status   : Theorem
;; Comments : Tests SineFn at an angle whose result is unambiguous.
;;          : Merge.kif declares and documents SineFn but has no numeric
;;          : evaluation axiom. A translator interpretation or additional
;;          : axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0028)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (SineFn 0.0) 0.0))

(answer yes)
