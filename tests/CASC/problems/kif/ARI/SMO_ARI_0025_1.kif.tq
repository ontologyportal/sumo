;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0025_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Integer square root of a perfect square
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The integer square root of 81 is 9.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0025
;;
;; Status   : Theorem
;; Comments : Tests IntegerSquareRootFn on a perfect square.
;;          : Merge.kif declares and documents IntegerSquareRootFn but
;;          : does not axiomatize its numeric result. A translator
;;          : interpretation or additional axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0025)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (IntegerSquareRootFn 81) 9))

(answer yes)
