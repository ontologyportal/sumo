;;------------------------------------------------------------------------------
;; File     : SMO_ARI_0035_1 : SUMO/CASC source.
;; Domain   : Arithmetic
;; Problem  : Rational representation of a terminating decimal
;; Version  : Merge.kif axioms; _1 denotes TFF formulation 1.
;; English  : The rational representation of 0.75 equals 3 divided by 4.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_ARI_0035
;;
;; Status   : Theorem
;; Comments : Tests RationalNumberFn on a value with an exact rational form.
;;          : Merge.kif declares and documents the function but does not
;;          : axiomatize its result. A translator interpretation or
;;          : additional axiom is required for a proof.
;;          : Translation and prover result have not yet been checked.
;;          : The TPTP problem number is assigned during release packaging.
;;------------------------------------------------------------------------------

(note SMO_ARI_0035)
(category arithmetic)
(minLang tff)
(include Merge.kif)

(query
  (equal (RationalNumberFn 0.75) (DivisionFn 3.0 4.0)))

(answer yes)
