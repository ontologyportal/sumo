(note TQG3_DISJOINT_LOCAL_RULE)
(category general)

(instance Number3-1 NonnegativeRealNumber)

(disjoint NonnegativeRealNumber NegativeRealNumber)

(=>
  (and
    (disjoint ?C1 ?C2)
    (instance ?X ?C1))
  (not
    (instance ?X ?C2)))

(query
  (not
    (instance Number3-1 NegativeRealNumber)))

(answer yes)