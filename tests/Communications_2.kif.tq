;; Written by Colin Seymour
;; Tests for Cellular&TelephoneArchitecture.kif

;Meta predicates
(note Communications_2)
(time 30)
(category Communications)

;Conjecture
(query
  (=>
    (instance ?S SARSatellite)
    (exists (?P ?R)
      (and
        (instance ?P SatellitePayload)
        (instance ?R Radar)
        (component ?P ?S)
        (component ?R ?P)))))

(answer yes)
