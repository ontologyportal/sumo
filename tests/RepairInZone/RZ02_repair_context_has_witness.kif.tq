;; A repair context yields an object witness bound to patient, possession and part.
(note RZ02_repair_context_has_witness)
(category general)
(time 30)
(file RepairInZone.kif)

(instance Repair1 Repairing)
(instance Org1 Organization)
(instance Zone1 NetworkZone)
(repairInZone Repair1 Org1 Zone1)

(query
  (exists (?OBJECT)
    (and
      (instance ?OBJECT Object)
      (patient Repair1 ?OBJECT)
      (possesses Org1 ?OBJECT)
      (part ?OBJECT Zone1))))
(answer yes)
