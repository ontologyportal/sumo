;; A repair of an organization-possessed object in a zone has repair context.
(note RZ01_repair_context_established)
(category general)
(time 30)
(file RepairInZone.kif)

(instance Repair1 Repairing)
(instance Org1 Organization)
(instance Obj1 Object)
(instance Zone1 NetworkZone)
(patient Repair1 Obj1)
(possesses Org1 Obj1)
(part Obj1 Zone1)

(query
  (repairInZone Repair1 Org1 Zone1))
(answer yes)
