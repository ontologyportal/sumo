;; A repair in an inner zone also has context in its explicitly containing zone.
(note RZ03_inner_repair_has_outer_context)
(category general)
(time 30)
(file RepairInZone.kif)

(instance Repair1 Repairing)
(instance Org1 Organization)
(instance Obj1 Object)
(instance ZoneInner NetworkZone)
(instance ZoneOuter NetworkZone)
(not
  (equal ZoneInner ZoneOuter))
(immediateSubNetwork ZoneInner ZoneOuter)
(patient Repair1 Obj1)
(possesses Org1 Obj1)
(part Obj1 ZoneInner)

(query
  (repairInZone Repair1 Org1 ZoneOuter))
(answer yes)
