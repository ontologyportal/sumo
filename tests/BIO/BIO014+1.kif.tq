;;------------------------------------------------------------------------------
;; File     : BIO014+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Shoulder joint connectivity
;; Version  : Merge.kif + Anatomy.kif axioms; +1 denotes FOF formulation 1.
;; English  : Use connected symmetry and anatomical class inheritance to classify and relate a concrete shoulder joint.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Anatomy.kif
;; Names    : SMO_BIO_0014
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO014+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Anatomy.kif)

;; Scenario
(instance ShoulderPatient Human)

(instance ShoulderHumerus LeftHumerus)

(instance ShoulderScapula LeftScapulaBone)

(part ShoulderHumerus ShoulderPatient)

(part ShoulderScapula ShoulderPatient)

(connected ShoulderHumerus ShoulderScapula)

;; Reasoning: Use connected symmetry and anatomical class inheritance to classify and
;; relate a concrete shoulder joint.
(query
  (and
    (connected ShoulderScapula ShoulderHumerus)
    (instance ShoulderHumerus BodyPart)
    (instance ShoulderScapula BodyPart)))

(answer yes)
