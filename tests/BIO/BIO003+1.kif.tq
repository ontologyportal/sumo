;;------------------------------------------------------------------------------
;; File     : BIO003+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Dolphins are animals
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Classify the named Dolphin specimen through its intermediate biological superclasses to Animal.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0003
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO003+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

;; Scenario
(instance BIO003Specimen Dolphin)

;; Reasoning: Classify the named Dolphin specimen through its intermediate biological
;; superclasses to Animal.
(query
  (instance BIO003Specimen Animal))

(answer yes)
