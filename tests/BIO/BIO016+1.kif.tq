;;------------------------------------------------------------------------------
;; File     : BIO016+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Raw food has no heating result
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : An item marked raw is food and is not the result of a heating process.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0002
;;
;; Status   : Theorem
;; Comments : Combines RawAttribute food classification and its exclusion of heating.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note BIO016+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (attribute ?FOOD RawAttribute)
    (and
      (instance ?FOOD Food)
      (not
        (exists (?HEAT)
          (and
            (instance ?HEAT Heating)
            (result ?HEAT ?FOOD)))))))

(answer yes)
