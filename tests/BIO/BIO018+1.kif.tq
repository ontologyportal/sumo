;;------------------------------------------------------------------------------
;; File     : BIO018+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Baking uses an oven
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Cooking -> Making (Merge.kif:16580).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0004
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO018+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(instance BIO018Bake Baking)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Cooking -> Making
;; (Merge.kif:16580).
(query
  (and
    (instance BIO018Bake Making)
    (instance BIO018Bake Heating)
    (exists (?OVEN) (and (instance ?OVEN Oven) (instrument BIO018Bake ?OVEN)))))

(answer yes)
