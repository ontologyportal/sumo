;;------------------------------------------------------------------------------
;; File     : BIO027+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Dry roasting is cooking and heating
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Food -> SelfConnectedObject (Merge.kif:19307).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0013
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO027+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(attribute BIO027Food DryRoastAttribute)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Food ->
;; SelfConnectedObject (Merge.kif:19307).
(query
  (and
    (instance BIO027Food SelfConnectedObject)
    (exists (?ROAST)
      (and
        (instance ?ROAST DryRoasting)
        (instance ?ROAST Cooking)
        (instance ?ROAST Heating)
        (result ?ROAST BIO027Food)))))

(answer yes)
