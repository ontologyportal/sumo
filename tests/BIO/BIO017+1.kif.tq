;;------------------------------------------------------------------------------
;; File     : BIO017+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Plant-derived food excludes meat
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Food -> SelfConnectedObject (Merge.kif:19307).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0003
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO017+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(instance BIO017Item FoodFromPlant)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Food ->
;; SelfConnectedObject (Merge.kif:19307).
(query
  (and (instance BIO017Item SelfConnectedObject) (not (instance BIO017Item Meat))))

(answer yes)
