;;------------------------------------------------------------------------------
;; File     : BIO028_1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Whole-milk butterfat proportion
;; Version  : Merge.kif + Food.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then ButterFat -> Oil (Food.kif:4098).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0014
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO028_1)
(category BIO)
(minLang tff)
(include Merge.kif)
(include Food.kif)

;; Scenario
(instance BIO028Milk WholeMilk)

(measure BIO028Milk (MeasureFn BIO028Volume BIO028Unit))

(instance BIO028Unit UnitOfVolume)

;; Reasoning: Instantiate the scenario; apply the domain rule, then ButterFat -> Oil
;; (Food.kif:4098).
(query
  (exists (?FAT ?FATVOLUME)
    (and
      (instance ?FAT Oil)
      (part ?FAT BIO028Milk)
      (measure ?FAT (MeasureFn ?FATVOLUME BIO028Unit))
      (greaterThanOrEqualTo ?FATVOLUME (MultiplicationFn 0.0325 BIO028Volume))
      (lessThanOrEqualTo ?FATVOLUME (MultiplicationFn 0.05 BIO028Volume)))))

(answer yes)
