;;------------------------------------------------------------------------------
;; File     : BIO020+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Fermented food has a fermentation history
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Food -> SelfConnectedObject (Merge.kif:19307).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0006
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO020+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(attribute BIO020Food FermentedAttribute)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Food ->
;; SelfConnectedObject (Merge.kif:19307).
(query
  (and
    (instance BIO020Food SelfConnectedObject)
    (exists (?FERMENT)
      (and
        (instance ?FERMENT Fermentation)
        (instance ?FERMENT PreservingFood)
        (instance ?FERMENT BiologicalProcess)
        (result ?FERMENT BIO020Food)))))

(answer yes)
