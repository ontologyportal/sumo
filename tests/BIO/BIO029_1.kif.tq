;;------------------------------------------------------------------------------
;; File     : BIO029_1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Skimmed-milk butterfat proportion
;; Version  : Merge.kif + Food.kif axioms; _1 denotes TFF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then ButterFat -> Oil (Food.kif:4098).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0015
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO029_1)
(category BIO)
(minLang tff)
(include Merge.kif)
(include Food.kif)

;; Scenario
(instance BIO029Milk SkimmedMilk)

(measure BIO029Milk (MeasureFn BIO029Volume BIO029Unit))

(instance BIO029Unit UnitOfVolume)

;; Reasoning: Instantiate the scenario; apply the domain rule, then ButterFat -> Oil
;; (Food.kif:4098).
(query
  (exists (?FAT ?FATVOLUME)
    (and
      (instance ?FAT Oil)
      (part ?FAT BIO029Milk)
      (measure ?FAT (MeasureFn ?FATVOLUME BIO029Unit))
      (greaterThanOrEqualTo ?FATVOLUME (MultiplicationFn 0.0 BIO029Volume))
      (lessThanOrEqualTo ?FATVOLUME (MultiplicationFn 0.005 BIO029Volume)))))

(answer yes)
