(note BIO013+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Anatomy.kif)

;; Scenario
(instance BIO013Specimen LeftParietalBone)

;; Reasoning: Classify the named LeftParietalBone specimen through its intermediate
;; biological superclasses to BodyPart.
(query
  (instance BIO013Specimen BodyPart))

(answer yes)
