;;------------------------------------------------------------------------------
;; File     : BIO030^1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Ingredient quantities imply a preparation
;; Version  : Merge.kif + Food.kif axioms; ^1 denotes THF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Flour -> PreparedFood (Food.kif:1790).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0016
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO030^1)
(category BIO)
(minLang thf)
(include Merge.kif)
(include Food.kif)

;; Scenario
(ingredientAmount Flour Bread (MeasureFn 100 Gram))

;; Reasoning: Instantiate the scenario; apply the domain rule, then Flour -> PreparedFood
;; (Food.kif:1790).
(query
  (exists (?PREPARATION ?INGREDIENT ?PRODUCT)
    (and
      (instance ?INGREDIENT PreparedFood)
      (measure ?INGREDIENT (MeasureFn 100 Gram))
      (instance ?PRODUCT Bread)
      (instance ?PREPARATION Process)
      (patient ?PREPARATION ?INGREDIENT)
      (result ?PREPARATION ?PRODUCT))))

(answer yes)
