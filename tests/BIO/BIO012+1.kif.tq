;;------------------------------------------------------------------------------
;; File     : BIO012+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Pecan tree material
;; Version  : Merge.kif + Mid-level-ontology.kif + Trees.kif axioms; +1 denotes FOF formulation 1.
;; English  : Follow the PecanTree/HickoryTree/BotanicalTree hierarchy; use the botanical wood-material rule and classify the inspected tree as an organism.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Trees.kif
;; Names    : SMO_BIO_0012
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO012+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Trees.kif)

;; Scenario
(instance OrchardPecan PecanTree)

(instance OrchardInspection Looking)

(patient OrchardInspection OrchardPecan)

;; Reasoning: Follow the PecanTree/HickoryTree/BotanicalTree hierarchy; use the botanical
;; wood-material rule and classify the inspected tree as an organism.
(query
  (exists (?TREE)
    (and
      (patient OrchardInspection ?TREE)
      (material Wood ?TREE)
      (instance ?TREE Organism))))

(answer yes)
