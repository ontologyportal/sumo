;;------------------------------------------------------------------------------
;; File     : BIO022+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Fruit puree results from pureeing fruit
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Mixture -> Substance (Merge.kif:1468).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO022+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(instance BIO022Puree FruitPuree)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Mixture -> Substance
;; (Merge.kif:1468).
(query
  (and
    (instance BIO022Puree Substance)
    (exists (?FRUIT ?PROCESS)
      (and
        (instance ?FRUIT Fruit)
        (instance ?PROCESS Grinding)
        (patient ?PROCESS ?FRUIT)
        (result ?PROCESS BIO022Puree)))))

(answer yes)
