;;------------------------------------------------------------------------------
;; File     : BIO023+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Meal members are human food
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then CollectionOfObjects -> Collection (Merge.kif:1610).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0009
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO023+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(instance BIO023Meal Meal)

(member BIO023Item BIO023Meal)

;; Reasoning: Instantiate the scenario; apply the domain rule, then CollectionOfObjects ->
;; Collection (Merge.kif:1610).
(query
  (and (instance BIO023Meal Collection) (instance BIO023Item (FoodForFn Human))))

(answer yes)
