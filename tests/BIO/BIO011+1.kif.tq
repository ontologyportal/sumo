;;------------------------------------------------------------------------------
;; File     : BIO011+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Pecan tree taxonomy
;; Version  : Merge.kif + Mid-level-ontology.kif + Trees.kif axioms; +1 denotes FOF formulation 1.
;; English  : Classify the named PecanTree specimen through its intermediate biological superclasses to Organism.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Trees.kif
;; Names    : SMO_BIO_0011
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO011+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Trees.kif)

;; Scenario
(instance BIO011Specimen PecanTree)

;; Reasoning: Classify the named PecanTree specimen through its intermediate biological
;; superclasses to Organism.
(query
  (instance BIO011Specimen Organism))

(answer yes)
