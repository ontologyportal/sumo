;;------------------------------------------------------------------------------
;; File     : BIO005+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Capybara habitat
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then WaterArea -> GeographicArea (Merge.kif:18272).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0005
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO005+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

;; Scenario
(instance BIO005C Capybara)

;; Reasoning: Instantiate the scenario; apply the domain rule, then WaterArea ->
;; GeographicArea (Merge.kif:18272).
(query
  (exists (?W ?L)
    (and
      (instance ?W GeographicArea)
      (instance ?L LandArea)
      (inhabits BIO005C ?W)
      (inhabits BIO005C ?L))))

(answer yes)
