;;------------------------------------------------------------------------------
;; File     : BIO001+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Bacteria are organisms
;; Version  : Merge.kif axioms; +1 denotes FOF formulation 1.
;; English  : Classify the named Bacterium specimen through its intermediate biological superclasses to Organism.
;;
;; Refs     :
;; Source   : SUMO Merge.kif
;; Names    : SMO_BIO_0001
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO001+1)
(category BIO)
(minLang fof)
(include Merge.kif)

;; Scenario
(instance BIO001Specimen Bacterium)

;; Reasoning: Classify the named Bacterium specimen through its intermediate biological
;; superclasses to Organism.
(query
  (instance BIO001Specimen Organism))

(answer yes)
