;;------------------------------------------------------------------------------
;; File     : BIO009+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Dolphin reproduction
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Birth -> OrganismProcess (Merge.kif:13057).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0009
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO009+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

;; Scenario
(instance BIO009D Dolphin)

(instance BIO009R Reproduction)

(agent BIO009R BIO009D)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Birth ->
;; OrganismProcess (Merge.kif:13057).
(query
  (exists (?B) (and (instance ?B OrganismProcess) (agent ?B BIO009D))))

(answer yes)
