;;------------------------------------------------------------------------------
;; File     : BIO008+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Eagle reproduction
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Egg -> ReproductiveBody (Merge.kif:19475).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0008
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO008+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

;; Scenario
(instance BIO008E Eagle)

(instance BIO008R Reproduction)

(agent BIO008R BIO008E)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Egg -> ReproductiveBody
;; (Merge.kif:19475).
(query
  (exists (?EGG) (and (instance ?EGG ReproductiveBody) (result BIO008R ?EGG))))

(answer yes)
