;;------------------------------------------------------------------------------
;; File     : BIO025+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Fermentation uses microorganisms and carbohydrates
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then BiologicalProcess -> InternalChange (Merge.kif:12989).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0011
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO025+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(instance BIO025Ferment Fermentation)

;; Reasoning: Instantiate the scenario; apply the domain rule, then BiologicalProcess ->
;; InternalChange (Merge.kif:12989).
(query
  (and
    (instance BIO025Ferment InternalChange)
    (instance BIO025Ferment PreservingFood)
    (exists (?CARBOHYDRATE ?MICROBE)
      (and
        (instance ?CARBOHYDRATE Carbohydrate)
        (instance ?MICROBE Microorganism)
        (instrument BIO025Ferment ?MICROBE)
        (resource BIO025Ferment ?CARBOHYDRATE)))))

(answer yes)
