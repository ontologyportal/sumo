;;------------------------------------------------------------------------------
;; File     : BIO026+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Hulled food has a peeling process
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Food -> SelfConnectedObject (Merge.kif:19307).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0012
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO026+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(attribute BIO026Food HulledAttribute)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Food ->
;; SelfConnectedObject (Merge.kif:19307).
(query
  (and
    (instance BIO026Food SelfConnectedObject)
    (exists (?HULLING)
      (and
        (instance ?HULLING Hulling)
        (instance ?HULLING Cooking)
        (instance ?HULLING Peeling)
        (result ?HULLING BIO026Food)))))

(answer yes)
