;;------------------------------------------------------------------------------
;; File     : BIO015+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Cooked food has a preparation process
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : An item marked cooked is food produced by cooking with a heating subprocess.
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0001
;;
;; Status   : Theorem
;; Comments : Combines the prepared-food attribute rule with the CookedAttribute production rule.
;;          : Translation and prover result have not yet been checked.
;;          : Numbering is local to SUMO; this is a KIF source, not an assigned TPTP entry.
;;------------------------------------------------------------------------------

(note BIO015+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

(query
  (=>
    (attribute ?FOOD CookedAttribute)
    (and
      (instance ?FOOD Food)
      (exists (?COOK ?HEAT)
        (and
          (instance ?COOK Cooking)
          (instance ?HEAT Heating)
          (subProcess ?HEAT ?COOK)
          (result ?COOK ?FOOD))))))

(answer yes)
