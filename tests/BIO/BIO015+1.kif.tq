;;------------------------------------------------------------------------------
;; File     : BIO015+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Cooked food has a preparation process
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Food -> SelfConnectedObject (Merge.kif:19307).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0001
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO015+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(attribute BIO015Food CookedAttribute)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Food ->
;; SelfConnectedObject (Merge.kif:19307).
(query
  (and
    (instance BIO015Food SelfConnectedObject)
    (exists (?COOK ?HEAT)
      (and
        (instance ?COOK Cooking)
        (instance ?HEAT Heating)
        (subProcess ?HEAT ?COOK)
        (result ?COOK BIO015Food)))))

(answer yes)
