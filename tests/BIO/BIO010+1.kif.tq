;;------------------------------------------------------------------------------
;; File     : BIO010+1 : SUMO/CASC source.
;; Domain   : Biology
;; Problem  : Cobra venom
;; Version  : Merge.kif + Animals.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then domain rule plus participant classification: Cobra -> Reptile (Animals.kif:2124).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Animals.kif
;; Names    : SMO_BIO_0010
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO010+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Animals.kif)

;; Scenario
(instance BIO010C Cobra)

;; Reasoning: Instantiate the scenario; apply the domain rule, then domain rule plus
;; participant classification: Cobra -> Reptile (Animals.kif:2124).
(query
  (and
    (exists (?T) (and (instance ?T Toxin) (part ?T BIO010C)))
    (instance BIO010C Reptile)))

(answer yes)
