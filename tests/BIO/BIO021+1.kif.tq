;;------------------------------------------------------------------------------
;; File     : BIO021+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Flour is ground cereal food
;; Version  : Merge.kif + Mid-level-ontology.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then Food -> SelfConnectedObject (Merge.kif:19307).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Mid-level-ontology.kif, Food.kif
;; Names    : SMO_FOD_0007
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO021+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Mid-level-ontology.kif)
(include Food.kif)

;; Scenario
(instance BIO021Flour Flour)

;; Reasoning: Instantiate the scenario; apply the domain rule, then Food ->
;; SelfConnectedObject (Merge.kif:19307).
(query
  (and
    (instance BIO021Flour SelfConnectedObject)
    (instance BIO021Flour PreparedFood)
    (instance BIO021Flour Mixture)
    (attribute BIO021Flour RawAttribute)
    (exists (?GRIND ?GRAIN)
      (and
        (instance ?GRIND Grinding)
        (instance ?GRAIN CerealGrain)
        (patient ?GRIND ?GRAIN)
        (result ?GRIND BIO021Flour)))))

(answer yes)
