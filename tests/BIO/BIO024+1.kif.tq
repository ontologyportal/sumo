;;------------------------------------------------------------------------------
;; File     : BIO024+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Vegan attribute excludes meat and dairy parts
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then attribute -> property (Merge.kif:2278).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0010
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO024+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(attribute BIO024Item Vegan)

;; Reasoning: Instantiate the scenario; apply the domain rule, then attribute -> property
;; (Merge.kif:2278).
(query
  (and
    (property BIO024Item Vegetarian)
    (not (exists (?MEAT) (and (instance ?MEAT Meat) (part ?MEAT BIO024Item))))
    (not
      (exists (?DAIRY) (and (instance ?DAIRY DairyArtifact) (part ?DAIRY BIO024Item))))))

(answer yes)
