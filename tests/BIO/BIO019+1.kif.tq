;;------------------------------------------------------------------------------
;; File     : BIO019+1 : SUMO/CASC source.
;; Domain   : Food
;; Problem  : Curing combines salt and drying
;; Version  : Merge.kif + Food.kif axioms; +1 denotes FOF formulation 1.
;; English  : Instantiate the scenario; apply the domain rule, then PreservingFood -> Keeping (Food.kif:214).
;;
;; Refs     :
;; Source   : SUMO Merge.kif, Food.kif
;; Names    : SMO_FOD_0005
;;
;; Status   : Theorem
;; Comments : Scenario and reasoning revised; full prover validation is separate.
;;------------------------------------------------------------------------------

(note BIO019+1)
(category BIO)
(minLang fof)
(include Merge.kif)
(include Food.kif)

;; Scenario
(instance BIO019Curing CuringFood)

;; Reasoning: Instantiate the scenario; apply the domain rule, then PreservingFood ->
;; Keeping (Food.kif:214).
(query
  (and
    (instance BIO019Curing Keeping)
    (exists (?FOOD ?PUTTING ?SALT ?DRYING)
      (and
        (instance ?FOOD Food)
        (patient BIO019Curing ?FOOD)
        (instance ?PUTTING Putting)
        (subProcess ?PUTTING BIO019Curing)
        (instance ?SALT SodiumChloride)
        (patient ?PUTTING ?SALT)
        (destination ?PUTTING ?FOOD)
        (instance ?DRYING Drying)
        (subProcess ?DRYING BIO019Curing)
        (patient ?DRYING ?FOOD)))))

(answer yes)
