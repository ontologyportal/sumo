(note "A software patching process inherits from software upgrading and is an intentional process.")
(time 30)
(file Merge.kif)
(file ComputingBrands.kif)
(file engineering.kif)

(instance SoftwarePatchingCase1 SoftwarePatching)

(query
  (and
    (instance SoftwarePatchingCase1 SoftwareUpgrading)
    (instance SoftwarePatchingCase1 IntentionalProcess)))

(answer yes)
