;; KRS025^1 -- scenario reasoning test

(category KRS)
(note KRS025^1)
(minLang thf)
(regen true)
(holUseModals true)

;; Scenario
(=> (modalAttribute ?A Permission) (not (modalAttribute (not ?A) Obligation)))

(=> (modalAttribute ?A Obligation) (modalAttribute ?A Permission))

(=> (modalAttribute ?A Prohibition) (modalAttribute (not ?A) Obligation))

(instance RescueAction Helping)

(instance RescueWorker Human)

(modalAttribute (agent RescueAction RescueWorker) Obligation)

;; Reasoning: For the concrete rescue action, derive Permission from Obligation, then use
;; permission to exclude an obligation to refrain.
(query
  (not (modalAttribute (not (agent RescueAction RescueWorker)) Obligation)))

(answer yes)
