(note KRS027^1)
(time 20)
(minLang thf)
(category KRS)
(file tinySUMO.kif)
(file tinyHOL.kif)

;; Scenario
(instance ScenarioVoyageDanger Attribute)

(instance ScenarioVoyage Circumnavigation)

(instance Joe Human)

(instance Bill Human)

(forall (?OBSERVER ?PREMISE ?CONCLUSION)
  (=>
    (and (believes ?OBSERVER (=> ?PREMISE ?CONCLUSION)) (believes ?OBSERVER ?PREMISE))
    (believes ?OBSERVER ?CONCLUSION)))

(believes
  Bill
  (and
    (instance ScenarioVoyage Circumnavigation)
    (located ScenarioVoyage Earth)
    (attribute Earth Flat)
    (agent ScenarioVoyage Joe)))

(believes
  Bill
  (=>
    (and
      (instance ScenarioVoyage Circumnavigation)
      (located ScenarioVoyage Earth)
      (attribute Earth Flat)
      (agent ScenarioVoyage Joe))
    (attribute Joe ScenarioVoyageDanger)))

(believes Bill (=> (attribute Joe ScenarioVoyageDanger) (attribute Joe Dead)))

;; Reasoning: In a deliberately fictional flat-Earth belief scenario, Bill believes a
;; concrete voyage puts Joe in danger and believes that this danger is fatal; apply belief
;; closure twice. These beliefs do not assert that Earth is flat or Joe is dead.
(query
  (believes Bill (attribute Joe Dead)))

(answer yes)
