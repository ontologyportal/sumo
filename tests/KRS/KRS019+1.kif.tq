;; KRS019+1 -- scenario reasoning test

(note KRS019+1)
(category KRS)
(time 900)

;; Scenario
(instance Class30-1 Class)

(subclass Class30-1 Reptile)

(subclass Reptile Class30-1)

(instance EnclosureLizard Class30-1)

;; Reasoning: Propagate the named lizard through the local class inclusion and
;; Reptile/Vertebrate/Animal hierarchy.
(query
  (instance EnclosureLizard Animal))

(answer yes)
