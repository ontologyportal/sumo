;; KRS018+1 -- scenario reasoning test

(note KRS018+1)
(category KRS)

;; Scenario
(instance Frog29-1 Amphibian)

(instance Animal29-1 Animal)

(equal Frog29-1 Animal29-1)

;; Reasoning: Substitute the frog/animal identity, then classify the amphibian through
;; Animal to Organism.
(query
  (instance Animal29-1 Organism))

(answer yes)
