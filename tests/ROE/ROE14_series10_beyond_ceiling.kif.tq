;; Rule 10 B reaches only the non-deadly subclass, so a deadly application is
;; outside what it authorizes. The class definitions are written in the
;; sufficient direction only, so a prover has no route to the negative and this
;; is expected to reach its bound rather than complete.
(note ROE14_series10_deadly_outside_nondeadly_measure)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpCharlie MilitaryOperation)

(instance Sailor2 Human)
(instance SelfDef3 UseOfForce)
(instance SelfDef3 IndividualSelfDefense)
(agent SelfDef3 Sailor2)
(property SelfDef3 DeadlyForce)

(instance Act10B ROEActivation)
(roeActivationMeasure Act10B ROE10B)
(roeActivationOperation Act10B OpCharlie)

(query (roeActionAuthorized SelfDef3 OpCharlie))
(answer no)
