;; Rule 61 D permits harassment that may result in physical damage, and here
;; it does. Before the Master correction this scenario made the knowledge base
;; inconsistent, since Harassment then carried a rule that it never causes
;; damage.
(note ROE23_series61_potentially_damaging_harassment_authorized)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpFoxtrot MilitaryOperation)
(instance Harass2 PotentiallyDamagingHarassment)
(instance Damage2 Damaging)
(causes Harass2 Damage2)

(instance Act61D ROEActivation)
(roeActivationMeasure Act61D ROE61D)
(roeActivationOperation Act61D OpFoxtrot)

(query (roeActionAuthorized Harass2 OpFoxtrot))
(answer yes)
