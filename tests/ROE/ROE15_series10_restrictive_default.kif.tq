;; No measure of Series 10 is in force, so no authority for force in individual
;; self-defense exists under the profile. Derived rather than obtained from a
;; failure to prove authorization.
(note ROE15_series10_restrictive_default)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpDelta MilitaryOperation)
(roeSeriesNotAddressed ROESeries10 OpDelta)

(instance Sailor3 Human)
(instance SelfDef4 UseOfForce)
(instance SelfDef4 IndividualSelfDefense)
(agent SelfDef4 Sailor3)

(query (roeActionUnauthorized SelfDef4 OpDelta))
(answer yes)
