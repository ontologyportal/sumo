;; Class membership is derived rather than asserted. Nothing states that
;; ResponseForce is force protecting the movement of the Force; that follows
;; from what it prevents and from the degree of force it applies.
(note ROE07_authorization_through_derived_class_membership)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpFreedom MilitaryOperation)

(instance Sailor1 Human)
(attribute Sailor1 MilitaryPerson)
(instance Blockade1 Process)
(hinders Blockade1 Translocation)
(patient Blockade1 Sailor1)

(instance ResponseForce UseOfForce)
(prevents ResponseForce ForceMovementInterference)
(property ResponseForce NonDeadlyForce)

(instance Act3 ROEActivation)
(roeActivationMeasure Act3 ROE21B)
(roeActivationOperation Act3 OpFreedom)

(query (roeActionAuthorized ResponseForce OpFreedom))
(answer yes)
