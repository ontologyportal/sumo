;; Warnings are permitted generally under 60 B, while fire control radar as a
;; means of warning is prohibited under 60 D. A fire control radar warning
;; falls within the prohibition. Asked positively, so the result carries a
;; derivation.
(note ROE21_series60_fire_control_radar_prohibited)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpEcho MilitaryOperation)
(instance Warn3 FireControlRadarWarning)

(instance Act60B ROEActivation)
(roeActivationMeasure Act60B ROE60B)
(roeActivationOperation Act60B OpEcho)

(instance Act60D ROEActivation)
(roeActivationMeasure Act60D ROE60D)
(roeActivationOperation Act60D OpEcho)

(query (roeActionProhibited Warn3 OpEcho))
(answer yes)
