;; ROE06_subsumption_negative -- scenario reasoning test

(note ROE06_no_subsumption_across_protected_groups)
(category general)
(time 300)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

;; Scenario
(instance ROE06Operation MilitaryOperation)

(instance ROE06Action NonDeadlyDesignatedMovementProtection)

(instance ROE06Activation ROEActivation)

(roeActivationMeasure ROE06Activation ROE21C)

(roeActivationOperation ROE06Activation ROE06Operation)

;; Reasoning: Classify the scenario action under the activated measure, then apply ROE
;; authorization. A no answer means non-entailment, not negation.
(query
  (roeActionAuthorized ROE06Action ROE06Operation))

(answer no)
