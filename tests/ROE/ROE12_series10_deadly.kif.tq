;; Rule 10 C authorizes force up to and including deadly force in individual
;; self-defense. A deadly application falls within the class it names.
(note ROE12_series10_deadly_force_authorized)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpCharlie MilitaryOperation)

(instance Sailor2 Human)
(instance SelfDef1 UseOfForce)
(instance SelfDef1 IndividualSelfDefense)
(agent SelfDef1 Sailor2)
(property SelfDef1 DeadlyForce)

(instance Act10C ROEActivation)
(roeActivationMeasure Act10C ROE10C)
(roeActivationOperation Act10C OpCharlie)

(query (roeActionAuthorized SelfDef1 OpCharlie))
(answer yes)
