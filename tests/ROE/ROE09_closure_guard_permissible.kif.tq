;; Guard for the scenario of ROE03. The closure fact asserted there is not
;; contradicted by any measure in force, so no conflict is derivable.
(note ROE09_no_closure_conflict_in_permissible_scenario)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpAlpha MilitaryOperation)

(instance Shot202 WarningShot)
(noProhibitionReaches Shot202 OpAlpha)

(instance Act1 ROEActivation)
(activationMeasure Act1 ROE23E)
(activationOperation Act1 OpAlpha)

(query (closureConflict Shot202 OpAlpha))
(answer no)
