;; Rule 10 B authorizes only non-deadly force in individual self-defense.
(note ROE13_series10_nondeadly_force_authorized)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpCharlie MilitaryOperation)

(instance Sailor2 Human)
(instance SelfDef2 UseOfForce)
(instance SelfDef2 IndividualSelfDefense)
(agent SelfDef2 Sailor2)
(property SelfDef2 NonDeadlyForce)

(instance Act10B ROEActivation)
(roeActivationMeasure Act10B ROE10B)
(roeActivationOperation Act10B OpCharlie)

(query (roeActionAuthorized SelfDef2 OpCharlie))
(answer yes)
