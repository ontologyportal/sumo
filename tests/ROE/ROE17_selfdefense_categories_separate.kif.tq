;; ROE17_selfdefense_categories_separate -- scenario reasoning test

(note ROE17_individual_selfdefense_does_not_cover_defense_of_others)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

;; Scenario
(instance ROE17Operation MilitaryOperation)

(instance ROE17Action ForceInDefenseOfOthers)

(instance ROE17Activation ROEActivation)

(roeActivationMeasure ROE17Activation ROE10C)

(roeActivationOperation ROE17Activation ROE17Operation)

;; Reasoning: Classify the scenario action under the activated measure, then apply ROE
;; authorization. A no answer means non-entailment, not negation.
(query
  (roeActionAuthorized ROE17Action ROE17Operation))

(answer no)
