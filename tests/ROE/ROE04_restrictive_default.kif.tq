;; Where no measure of the governing series has been placed in force, the
;; restrictive default applies. The conclusion is derived rather than obtained
;; from failure to prove authorization, so it carries an inference chain.
(note ROE04_restrictive_default_yields_no_authority)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpBravo MilitaryOperation)
(roeSeriesNotAddressed ROESeries23 OpBravo)

(instance Shot303 WarningShot)

(query (roeActionUnauthorized Shot303 OpBravo))
(answer yes)
