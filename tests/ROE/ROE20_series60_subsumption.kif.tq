;; ROE20_series60_subsumption -- scenario reasoning test

(note ROE20_series60_general_covers_fire_control_radar)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

;; Scenario
(instance ROE20Operation MilitaryOperation)

(instance ROE20Action FireControlRadarWarning)

(instance ROE20Activation ROEActivation)

(roeActivationMeasure ROE20Activation ROE60B)

(roeActivationOperation ROE20Activation ROE20Operation)

;; Reasoning: Classify the scenario action under the activated measure, then apply ROE
;; authorization. A no answer means non-entailment, not negation.
(query
  (roeActionAuthorized ROE20Action ROE20Operation))

(answer yes)
