;; Rule 60 B, warnings generally, covers rule 60 E, warnings by fire control
;; radar, because the second class is a subclass of the first.
(note ROE20_series60_general_covers_fire_control_radar)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(query (roeMeasureSubsumes ROE60B ROE60E))
(answer yes)
