;; A warning shot that the prohibition of rule 23 B does not reach is
;; permissible under rule 23 E. Absence of a prohibition is asserted rather
;; than inferred from failure to derive one.
(note ROE03_permissible_where_no_prohibition_reaches)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpAlpha MilitaryOperation)

(instance Shot202 WarningShot)
(noProhibitionReaches Shot202 OpAlpha)

(instance Act1 ROEActivation)
(activationMeasure Act1 ROE23E)
(activationOperation Act1 OpAlpha)

(query (actionPermissible Shot202 OpAlpha))
(answer yes)
