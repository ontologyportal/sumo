;; Rule 21 C authorizes force up to and including deadly force to protect the
;; movement of the Force; rule 21 B authorizes only non-deadly force to the same
;; end. The coverage relation is derived from subclass, not stipulated.
(note ROE05_subsumption_from_class_inclusion)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(query (measureSubsumes ROE21C ROE21B))
(answer yes)
