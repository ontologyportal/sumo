;; ROE05_subsumption -- scenario reasoning test

(note ROE05_subsumption_from_class_inclusion)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

;; Scenario
(instance ROE05Operation MilitaryOperation)

(instance ROE05Action NonDeadlyForceMovementProtection)

(instance ROE05Activation ROEActivation)

(roeActivationMeasure ROE05Activation ROE21C)

(roeActivationOperation ROE05Activation ROE05Operation)

;; Reasoning: Classify the scenario action under the activated measure, then apply ROE
;; authorization. A no answer means non-entailment, not negation.
(query
  (roeActionAuthorized ROE05Action ROE05Operation))

(answer yes)
