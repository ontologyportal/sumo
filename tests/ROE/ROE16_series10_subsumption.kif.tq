;; ROE16_series10_subsumption -- scenario reasoning test

(note ROE16_series10_subsumption_from_class_inclusion)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

;; Scenario
(instance ROE16Operation MilitaryOperation)

(instance ROE16Action NonDeadlyForceInIndividualSelfDefense)

(instance ROE16Activation ROEActivation)

(roeActivationMeasure ROE16Activation ROE10C)

(roeActivationOperation ROE16Activation ROE16Operation)

;; Reasoning: Classify the scenario action under the activated measure, then apply ROE
;; authorization. A no answer means non-entailment, not negation.
(query
  (roeActionAuthorized ROE16Action ROE16Operation))

(answer yes)
