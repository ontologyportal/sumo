;; Rule 60 C permits warnings directed towards specified elements. The
;; warning is directed at the vessel supplied as the activation parameter.
(note ROE19_series60_warning_to_specified_element)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpEcho MilitaryOperation)
(instance SsvResolute Ship)
(instance SsvResolute AutonomousAgent)

(instance Warn2 Warning)
(involvedInEvent Warn2 SsvResolute)

(instance Act60C ROEActivation)
(roeActivationMeasure Act60C ROE60C)
(roeActivationOperation Act60C OpEcho)
(roeActivationParameter Act60C SsvResolute)

(query (roeActionAuthorized Warn2 OpEcho))
(answer yes)
