;; The same check on the restrictive default: Series 23 is said not to be
;; addressed, yet rule 23 E is in force for the same operation.
(note ROE11_series_closure_conflict_is_detected)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpBravo MilitaryOperation)
(seriesNotAddressed ROESeries23 OpBravo)

(instance Act4 ROEActivation)
(activationMeasure Act4 ROE23E)
(activationOperation Act4 OpBravo)

(query (closureConflict ROESeries23 OpBravo))
(answer yes)
