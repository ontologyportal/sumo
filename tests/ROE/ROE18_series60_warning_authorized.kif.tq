;; Rule 60 B permits warnings generally.
(note ROE18_series60_warning_authorized)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

(instance OpEcho MilitaryOperation)
(instance Warn1 Warning)

(instance Act60B ROEActivation)
(roeActivationMeasure Act60B ROE60B)
(roeActivationOperation Act60B OpEcho)

(query (roeActionAuthorized Warn1 OpEcho))
(answer yes)
