;; ROE08_disabling_fire -- scenario reasoning test

(note ROE08_disjoint_halves_of_series_24)
(category general)
(time 60)
(file ROE_Master.kif)
(file ROE_Supplementary.kif)
(file ROE_Series.kif)

;; Scenario
(instance ROE08Operation MilitaryOperation)

(instance ROE08Action NonDisablingFire)

(instance ROE08Activation ROEActivation)

(roeActivationMeasure ROE08Activation ROE24F)

(roeActivationOperation ROE08Activation ROE08Operation)

;; Reasoning: Classify the scenario action under the activated measure, then apply ROE
;; authorization. A no answer means non-entailment, not negation.
(query
  (roeActionAuthorized ROE08Action ROE08Operation))

(answer no)
