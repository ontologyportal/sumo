;;-----------------------------------------------------------------------
;; US States

(instance Alabama AmericanState)
(meetsSpatially Alabama Mississippi)
(documentation Alabama EnglishWrittenLanguage "A state in the southeastern &%UnitedStates that 
borders on the &%GulfOfMexico.")
(instance Alaska AmericanState)
(documentation Alaska EnglishWrittenLanguage "The largest state in the &%UnitedStates.")
(=>
   (and
      (instance ?UNIT AreaMeasure)
      (measure Alaska (MeasureFn ?NUMBER1 ?UNIT))
      (measure ?STATE (MeasureFn ?NUMBER2 ?UNIT))
      (instance ?STATE AmericanState)
      (not (equal Alaska ?STATE)))
   (lessThan ?NUMBER2 ?NUMBER1))

(meetsSpatially Alaska Canada)
(meetsSpatially Alaska PacificOcean)
(meetsSpatially Alaska ArcticOcean)
(instance Arizona AmericanState)
(meetsSpatially Arizona Nevada)
(meetsSpatially Arizona California)
(meetsSpatially Arizona Mexico)
(documentation Arizona EnglishWrittenLanguage "A state in the southwestern &%UnitedStates that 
borders on &%Mexico.")
(instance Arkansas AmericanState)
(meetsSpatially Arkansas Oklahoma)
(meetsSpatially Arkansas Texas)
(meetsSpatially Arkansas Louisiana)
(documentation Arkansas EnglishWrittenLanguage "A state in the southeastern &%UnitedStates that was 
part of the Confederacy.")
(instance California AmericanState)
(documentation California EnglishWrittenLanguage "The &%AmericanState with the highest population.")

(=>
  (and
    (instance ?STATE AmericanState)
    (not (equal ?STATE California)))
  (exists (?CA_COUNT ?STATE_COUNT)
    (and
      (memberCount
        (ResidentFn California)
        ?CA_COUNT)
      (memberCount
        (ResidentFn ?STATE)
        ?STATE_COUNT)
      (greaterThan ?CA_COUNT ?STATE_COUNT))))

