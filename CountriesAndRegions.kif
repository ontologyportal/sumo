(instance NewYorkCityUnitedStates AmericanCity)
(documentation NewYorkCityUnitedStates EnglishWrittenLanguage "The largest &%City in the &%UnitedStates.  
A worldwide center of finance and culture, it is comprised of five boroughs.")
(=>
  (instance ?CITY AmericanCity)
  (exists (?CITY_COUNT ?NYC_COUNT)
    (and
      (memberCount
        (ResidentFn ?CITY)
        ?CITY_COUNT)
      (memberCount
        (ResidentFn NewYorkCityUnitedStates)
        ?NYC_COUNT)
      (lessThanOrEqualTo ?CITY_COUNT ?NYC_COUNT))))

