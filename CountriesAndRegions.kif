;;-----------------------------------------------------------------------
;; Country locations by region (per 2002 CIA WFB):
;; Note that some more major (or more western) countries are defined in MILO.


(subclass AmericanState StateOrProvince)
(documentation AmericanState EnglishWrittenLanguage "The class of states that make up the 
&%UnitedStates.")

(=>
   (instance ?STATE AmericanState)
   (part ?STATE UnitedStates))

(instance NewEngland GeographicArea)
(part NewEngland UnitedStates)
(documentation NewEngland EnglishWrittenLanguage "A &%GeographicArea in the &%UnitedStates that is 
made up of the states of Maine, New Hampshire, Vermont, Massachusetts, Rhode Island, 
and Connecticut.")

(subclass AmericanCity City)
(documentation AmericanCity EnglishWrittenLanguage "The class of cities that are in the 
&%UnitedStates.")

(=>
   (instance ?CITY AmericanCity)
   (part ?CITY UnitedStates))

(instance Europe Continent)
(documentation Europe EnglishWrittenLanguage "The second smallest &%Continent.")
(meetsSpatially Europe Asia)
(habitatOfOrganism Badger Europe)
(habitatOfOrganism Bear Europe)
(habitatOfOrganism Reindeer Europe)
(habitatOfOrganism Crocodile Europe)

(subclass EuropeanCity City)
(documentation EuropeanCity EnglishWrittenLanguage "The class of cities that are in &%Europe.")

(=>
   (instance ?CITY EuropeanCity)
   (part ?CITY Europe))
   
(instance ParisFrance EuropeanCity)
(part ParisFrance France)
(capitalCity ParisFrance France)
(documentation ParisFrance EnglishWrittenLanguage "The capital of &%France and the largest &%City of the country.")

(=>
  (and
    (instance ?CITY City)
    (part ?CITY France))
  (exists (?CITY_COUNT ?PARIS_COUNT)
    (and
      (memberCount
        (ResidentFn ?CITY)
        ?CITY_COUNT)
      (memberCount
        (ResidentFn ParisFrance)
        ?PARIS_COUNT)
      (lessThanOrEqualTo ?CITY_COUNT ?PARIS_COUNT))))

(instance LondonUnitedKingdom City)
(capitalCity LondonUnitedKingdom UnitedKingdom)
(instance LondonUnitedKingdom EuropeanCity)
(documentation LondonUnitedKingdom EnglishWrittenLanguage "The &%City of &%London in &%UnitedKingdom.
The capital city and the largest city of the &%UnitedKingdom.")

(subclass EuropeanNation Nation)
(documentation EuropeanNation EnglishWrittenLanguage "The class of nations that are in &%Europe.")

(=>
  (instance ?N EuropeanNation)
  (part ?N Europe))   

(instance SovietUnion EuropeanNation)
(documentation SovietUnion EnglishWrittenLanguage "The former communist nation of the Soviet Union.")

