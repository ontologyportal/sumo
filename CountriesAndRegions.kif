(part Scotland UnitedKingdom)
(documentation Scotland EnglishWrittenLanguage "A division of the &%UnitedKingdom.")
(instance WarsawPoland EuropeanCity)
(capitalCity WarsawPoland Poland)
(documentation WarsawPoland EnglishWrittenLanguage "The capital &%City and largest city in &%Poland.")
(instance LongIsland Island)
(part LongIsland NewYorkState)
(documentation LongIsland EnglishWrittenLanguage "A large Island off the coast of NewYorkState.  
The boroughs of Queens and Brooklyn make up the western end of this 
Island.")
(instance LosAngelesCalifornia AmericanCity)
(part LosAngelesCalifornia California)
(documentation LosAngelesCalifornia EnglishWrittenLanguage "The largest City in California.")

(=>
  (and
    (instance ?CITY AmericanCity)
    (part ?CITY California)
    (not (equal ?CITY LosAngelesCalifornia)))
  (exists (?LA_COUNT ?CITY_COUNT)
    (and
      (memberCount
        (ResidentFn LosAngelesCalifornia)
        ?LA_COUNT)
      (memberCount
        (ResidentFn ?CITY)
        ?CITY_COUNT)
      (greaterThan ?LA_COUNT ?CITY_COUNT))))

