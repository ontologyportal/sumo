; ;
; =========================================================================
; ; Final Terms ; Topic - Cellular and Telephone Communication
; Architecture ; Author - Colin Seymour ;
; =========================================================================
; 1
(instance ThirdGenerationPartnershipProject InternationalOrganization)
(documentation ThirdGenerationPartnershipProject EnglishWrittenLanguage "A global engineering consortium which develops standards to describe the protocols for third-generation (3G) and beyond digital cellular networks.")
(termFormat EnglishWrittenLanguage ThirdGenerationPartnershipProject "3rd Generation Partnership Project")

(exists (?X)
  (and
    (instance ?X Designing)
    (instance ?Y Network3G)
    (agent ?X ThirdGenerationPartnershipProject)
    (result ?X ?Y)))

(exists (?X ?Y)
  (and
    (instance ?X Designing)
    (instance ?Y Network4G)
    (agent ?X ThirdGenerationPartnershipProject)
    (result ?X ?Y)))

(exists (?X)
  (and
    (instance ?X Designing)
    (instance ?Y Network5G)
    (agent ?X ThirdGenerationPartnershipProject)
    (result ?X ?Y)))

(exists (?X ?Y)
  (and
    (instance ?X Designing)
    (instance ?Y Network6G)
    (agent ?X ThirdGenerationPartnershipProject)
    (result ?X ?Y)))

(=>
  (and
    (instance ?D MobileCellPhone)
    (instance ?X GPRSNetwork)
    (instance ?BTS BaseTransceiverStation)
    (instance ?Up Uplink)
    (instance ?Down Downlink)
    (origin ?Up ?D)
    (destination ?Up ?BTS)
    (origin ?Down ?BTS)
    (destination ?Down ?D)
    (component ?BTS ?X))
  (connected ?D Internet))

; 2
(subclass Network6G CellNetwork)
(documentation Network6G EnglishWrittenLanguage "6G is the sixth-generation cellular network technology. The industry association 3GPP is developing the specifications for 6G systems (targeting Release 21), a definition that is expected to come into general use as standards solidify ahead of commercial deployments around 2030. Others may reserve the term for systems that meet the requirements of the ITU's IMT-2030 framework. 3GPP will submit its 6G candidate technologies to the ITU. It follows 3G, 4G, and 5G and their respective associated technologies (such as UMTS, LTE, and 5G NR).")
(termFormat EnglishWrittenLanguage Network6G "6G network")

(=>
  (and
    (instance ?N Network6G)
    (instance ?B FunctionQuantity)
    (instance ?B TimeDependentQuantity)
    (equal ?B
      (MeasureFn ?M
        (TeraFn BitsPerSecond)))
    (bandwidth ?N ?B))
  (lessThan ?M 1))

; 3
(instance causalLatency TernaryPredicate)
(domainSubclass causalLatency 1 Process)
(domainSubclass causalLatency 2 Process)
(domain causalLatency 3 TimeMeasure)
(documentation causalLatency EnglishWrittenLanguage "A time (&%TimeMeasure) delay between the cause and the effect of some change in a system being observed.")
(format EnglishWrittenLanguage causalLatency "The %3 between the Process %1 taking place and the Process %2 occurring in which %1 is the cause of %2.")
(termFormat EnglishWrittenLanguage causalLatency "latency")

(=>
  (and
    (causalLatency ?X ?Y ?T)
    (instance ?XI ?X)
    (instance ?YI ?Y)
    (causes ?XI ?YI))
  (exists (?TU)
    (and
      (instance ?TU UnitOfDuration)
      (meetsTemporally
        (WhenFn ?XI)
        (WhenFn ?YI))
      (duration
        (WhenFn ?XI) ?TU)
      (approximateValue ?T ?TU))))

; 32
(instance networkLatency TernaryPredicate)
(subrelation networkLatency causalLatency)
(domainSubclass networkLatency 1 DataTransfer)
(domainSubclass networkLatency 2 Confirming)
(domain networkLatency 3 TimeDuration)
(documentation networkLatency EnglishWrittenLanguage "(networkLatency ?TRANSFER ?Confirming ?DELAY) gives the one-way delay from the beginning of a data transfer to the beginning of the corresponding reception. ?DELAY is a TimeDuration, for example (MeasureFn 10 (MilliFn SecondDuration)); it is not a round-trip measurement.")
(format EnglishWrittenLanguage networkLatency "the network latency from %1 to %2 is %3")
(termFormat EnglishWrittenLanguage networkLatency "network latency")

(=>
  (and
    (networkLatency ?X ?Y ?Z)
    (instance ?XI ?X)
    (instance ?YI ?Y))
  (exists (?D)
    (and
      (instance ?D DigitalData)
      (patient ?XI ?D)
      (patient ?YI ?D))))

(=>
  (and
    (instance ?X Network6G)
    (instance ?P MobileCellPhone)
    (subclass ?YA DataTransfer)
    (subclass ?YB Confirming)
    (instance ?YAI ?YA)
    (instance ?YBI ?YB)
    (instrument ?YAI ?X)
    (instrument ?YBI ?X)
    (component ?P ?X)
    (origin ?YAI ?P)
    (destination ?YAI ?X)
    (origin ?YBI ?X)
    (instance ?Z RealNumber)
    (instance ?DELAY TimeDuration)
    (equal ?DELAY
      (MeasureFn ?Z
        (MilliFn SecondDuration)))
    (networkLatency ?YA ?YB ?DELAY))
  (lessThan ?Z 1))

(=>
  (and
    (instance ?X Network5G)
    (instance ?P MobileCellPhone)
    (subclass ?YA DataTransfer)
    (subclass ?YB Confirming)
    (instance ?YAI ?YA)
    (instance ?YBI ?YB)
    (instrument ?YAI ?X)
    (instrument ?YBI ?X)
    (component ?P ?X)
    (origin ?YAI ?P)
    (destination ?YAI ?X)
    (origin ?YBI ?X)
    (instance ?Z RealNumber)
    (instance ?DELAY TimeDuration)
    (equal ?DELAY
      (MeasureFn ?Z
        (MilliFn SecondDuration)))
    (networkLatency ?YA ?YB ?DELAY))
  (and
    (greaterThan ?Z 1)
    (lessThan ?Z 20)))

(=>
  (and
    (instance ?X Network4G)
    (instance ?P MobileCellPhone)
    (subclass ?YA DataTransfer)
    (subclass ?YB Confirming)
    (instance ?YAI ?YA)
    (instance ?YBI ?YB)
    (instrument ?YAI ?X)
    (instrument ?YBI ?X)
    (component ?P ?X)
    (origin ?YAI ?P)
    (destination ?YAI ?X)
    (origin ?YBI ?X)
    (instance ?Z RealNumber)
    (instance ?DELAY TimeDuration)
    (equal ?DELAY
      (MeasureFn ?Z
        (MilliFn SecondDuration)))
    (networkLatency ?YA ?YB ?DELAY))
  (and
    (greaterThan ?Z 20)
    (lessThan ?Z 100)))

(=>
  (and
    (instance ?X Network3G)
    (instance ?P MobileCellPhone)
    (subclass ?YA DataTransfer)
    (subclass ?YB Confirming)
    (instance ?YAI ?YA)
    (instance ?YBI ?YB)
    (instrument ?YAI ?X)
    (instrument ?YBI ?X)
    (component ?P ?X)
    (origin ?YAI ?P)
    (destination ?YAI ?X)
    (origin ?YBI ?X)
    (instance ?Z RealNumber)
    (instance ?DELAY TimeDuration)
    (equal ?DELAY
      (MeasureFn ?Z
        (MilliFn SecondDuration)))
    (networkLatency ?YA ?YB ?DELAY))
  (and
    (greaterThan ?Z 100)
    (lessThan ?Z 500)))

(subclass Network2G GSMNetwork)

(=>
  (and
    (instance ?X Network2G)
    (instance ?P MobileCellPhone)
    (subclass ?YA DataTransfer)
    (subclass ?YB Confirming)
    (instance ?YAI ?YA)
    (instance ?YBI ?YB)
    (instrument ?YAI ?X)
    (instrument ?YBI ?X)
    (component ?P ?X)
    (origin ?YAI ?P)
    (destination ?YAI ?X)
    (origin ?YBI ?X)
    (instance ?Z RealNumber)
    (instance ?DELAY TimeDuration)
    (equal ?DELAY
      (MeasureFn ?Z
        (MilliFn SecondDuration)))
    (networkLatency ?YA ?YB ?DELAY))
  (and
    (greaterThan ?Z 300)
    (lessThan ?Z 1000)))

; 4
(subclass SatelliteMobileGroundStation MobileStructure)
(documentation SatelliteMobileGroundStation EnglishWrittenLanguage "A mobile facility which receives and sends data to satellites.")
(termFormat EnglishWrittenLanguage SatelliteMobileGroundStation "mobile ground station")

; 5
(subclass SatelliteFixedGroundStation Facility)
(documentation SatelliteFixedGroundStation EnglishWrittenLanguage "A facility which receives and sends data to satellites.")
(termFormat EnglishWrittenLanguage SatelliteFixedGroundStation "fixed ground station")

(=>
  (or
    (instance ?X SatelliteFixedGroundStation)
    (instance ?X SatelliteMobileGroundStation))
  (exists (?Y)
    (and
      (instance ?Y Transceiver)
      (component ?Y ?X))))

(=>
  (and
    (or
      (instance ?X SatelliteFixedGroundStation)
      (instance ?X SatelliteMobileGroundStation))
    (instance ?Y ArtificialSatellite)
    (lineOfSight ?X ?Y)
    (instance ?Z SatelliteNetworkArchitecture)
    (component ?X ?Z)
    (component ?Y ?Z))
  (exists (?U ?D)
    (and
      (instance ?U Uplink)
      (instance ?D Downlink)
      (origin ?U ?X)
      (destination ?U ?Y)
      (origin ?D ?Y)
      (destination ?D ?X))))

; 33
(subclass SatelliteNetworkArchitecture WirelessNetwork)
(documentation SatelliteNetworkArchitecture EnglishWrittenLanguage "The means by which satellites communicate with terrestrial centers. Satellite network architecture is divided into three primary segments: the space segment, the control segment, and the ground segment.")
(termFormat EnglishWrittenLanguage SatelliteNetworkArchitecture "satellite network architecture")

(=>
  (instance ?X SatelliteNetworkArchitecture)
  (exists (?Y ?Z ?S)
    (and
      (instance ?Y SatelliteMissionOperationsCenter)
      (or
        (instance ?Z SatelliteFixedGroundStation)
        (instance ?Z SatelliteMobileGroundStation))
      (instance ?S ArtificialSatellite)
      (component ?Y ?X)
      (component ?Z ?X)
      (component ?S ?X))))

; 34
(subclass SatelliteMissionOperationsCenter Facility)
(documentation SatelliteMissionOperationsCenter EnglishWrittenLanguage "The central processing hub that analyzes telemetry and dispatches corrective orbital or system commands.")
(termFormat EnglishWrittenLanguage SatelliteMissionOperationsCenter "mission operations center")

(=>
  (instance ?X SatelliteMissionOperationsCenter)
  (exists (?Y ?Z)
    (and
      (instance ?Y TelemetrySystem)
      (instance ?Z ArtificialSatellite)
      (component ?Y ?X)
      (hasPurpose ?Y
        (exists (?L)
          (and
            (instance ?L Locating)
            (patient ?L ?Z)))))))

; 6
(instance lineOfSight BinaryPredicate)
(instance lineOfSight SpatialRelation)
(instance lineOfSight SymmetricRelation)
(domain lineOfSight 1 Object)
(domain lineOfSight 2 Object)
(documentation lineOfSight EnglishWrittenLanguage "A binary spatial relation indicating an unobstructed, direct optical or radio signal propagation path between two physical entities.")
(format EnglishWrittenLanguage lineOfSight "%1 is %n line of sight of %2")
(termFormat EnglishWrittenLanguage lineOfSight "line of sight")

(=>
  (lineOfSight ?X ?Y)
  (exists (?L ?Z ?XP ?YP)
    (and
      (instance ?XP PointInSpace)
      (instance ?YP PointInSpace)
      (located ?XP ?X)
      (located ?YP ?Y)
      (endPointsOfLineInSpace ?XP ?YP ?L)
      (or
        (not
          (overlapsSpatially ?L ?Z))
        (equal ?Z ?X)
        (equal ?Z ?Y)
        (or
          (instance ?Z AtmosphericRegion)
          (instance ?Z SpaceRegion))))))

; 7
(subclass Uplink DataTransfer)
(documentation Uplink EnglishWrittenLanguage "The communication path from a cellular mobile terminal to a base transceiver station or from a ground station to a Spacecraft.")
(termFormat EnglishWrittenLanguage Uplink "uplink")

(=>
  (instance ?X Uplink)
  (or
    (exists (?GS ?Sat ?Data)
      (and
        (instance ?Sat ArtificialSatellite)
        (lineOfSight ?Sat ?GS)
        (or
          (instance ?GS SatelliteFixedGroundStation)
          (instance ?GS SatelliteMobileGroundStation))
        (origin ?X ?GS)
        (destination ?X ?Sat)
        (patient ?X ?Data)
        (instance ?Data DigitalData)))
    (exists (?BTS ?MU ?IMSI ?MSISDN ?Data)
      (and
        (instance ?MU MobileCellPhone)
        (instance ?BTS BaseTransceiverStation)
        (instance ?IMSI InternationalMobileSubscriberIdentity)
        (instance ?MSISDN TelecomNumber)
        (represents ?IMSI ?MU)
        (represents ?MSISDN ?MU)
        (origin ?X ?MU)
        (destination ?X ?BTS)
        (patient ?X ?Data)
        (instance ?Data DigitalData)))))

; 8
(subclass Downlink DataTransfer)
(documentation Downlink EnglishWrittenLanguage "The communication path from a base transceiver station to a cellular mobile terminal or from a Spacecraft to a ground station.")
(termFormat EnglishWrittenLanguage Downlink "downlink")

(=>
  (instance ?X Downlink)
  (or
    (exists (?GS ?Sat ?Data)
      (and
        (instance ?Sat ArtificialSatellite)
        (lineOfSight ?Sat ?GS)
        (or
          (instance ?GS SatelliteFixedGroundStation)
          (instance ?GS SatelliteMobileGroundStation))
        (origin ?X ?Sat)
        (destination ?X ?GS)
        (patient ?X ?Data)
        (instance ?Data DigitalData)))
    (exists (?BTS ?MU ?IMSI ?MSISDN ?Data)
      (and
        (instance ?MU MobileCellPhone)
        (instance ?BTS BaseTransceiverStation)
        (instance ?IMSI InternationalMobileSubscriberIdentity)
        (instance ?MSISDN TelecomNumber)
        (represents ?IMSI ?MU)
        (represents ?MSISDN ?MU)
        (origin ?X ?BTS)
        (destination ?X ?MU)
        (patient ?X ?Data)
        (instance ?Data DigitalData)))))

; 35
(subclass Crosslink DataTransfer)
(documentation Crosslink EnglishWrittenLanguage "The communication path from a Spacecraft to another Spacecraft.")
(termFormat EnglishWrittenLanguage Crosslink "crosslink")
(=>
  (instance ?X Crosslink)
  (exists (?Y ?Z ?Data)
    (and
      (instance ?Y ArtificialSatellite)
      (instance ?Z ArtificialSatellite)
      (lineOfSight ?Y ?Z)
      (origin ?X ?Y)
      (destination ?X ?Z)
      (patient ?X ?Data)
      (instance ?Data DigitalData))))

; Define what a satellite is and then define what every subsystem is
(subclass ArtificialSatellite PhysicalSystem)
(=>
  (instance ?X ArtificialSatellite)
  (exists (?Y ?Z)
    (and
      (instance ?Y SatelliteBus)
      (instance ?Z SatellitePayload)
      (contains ?X ?Y)
      (contains ?X ?Z)
      (subSystem ?X ?Y)
      (subSystem ?X ?Z))))

; 44
(subclass SatelliteBus PhysicalSystem)
(subclass SatelliteBus EngineeringComponent)
(documentation SatelliteBus EnglishWrittenLanguage "The satellite subsystem in charge of the vital infrastructure required to keep a spacecraft functioning in space.")
(termFormat EnglishWrittenLanguage SatelliteBus "bus")

(=>
  (instance ?X SatelliteBus)
  (exists (?EPS ?ACS ?T ?TCS ?GNC ?CDH)
    (and
      (instance ?EPS SatelliteElectricalPowerSystem)
      (instance ?ACS SatelliteAttitudeControlSystem)
      (instance ?T Thruster)
      (instance ?TCS SatelliteThermalControlSystem)
      (instance ?GNC SatelliteGuidanceNavigationAndControlSystem)
      (instance ?CDH SatelliteCommandAndDataHandlingSystem)
      (contains ?X ?EPS)
      (contains ?X ?ACS)
      (contains ?X ?T)
      (contains ?X ?TCS)
      (contains ?X ?GNC)
      (contains ?X ?CDH)
      (subSystem ?X ?EPS)
      (subSystem ?X ?ACS)
      (component ?X ?T)
      (subSystem ?X ?TCS)
      (subSystem ?X ?GNC)
      (subSystem ?X ?CDH))))

; 36
(subclass SatelliteElectricalPowerSystem PhysicalSystem)
(subclass SatelliteElectricalPowerSystem EngineeringComponent)
(documentation SatelliteElectricalPowerSystem EnglishWrittenLanguage "A subsystem for powering the various spacecraft subsystems.")
(termFormat EnglishWrittenLanguage SatelliteElectricalPowerSystem "electrical power system")
(termFormat EnglishWrittenLanguage SatelliteElectricalPowerSystem "EPS")
(=>
  (instance ?X SatelliteElectricalPowerSystem)
  (exists (?Y)
    (and
      (instance ?Y ArtificialSatellite)
      (subSystem ?X ?Y)
      (hasPurpose ?X
        (exists (?Z)
          (and
            (instance ?Z PowerGeneration)
            (origin ?Z ?X)
            (destination ?Z ?Y)))))))

(=>
  (instance ?X SatelliteElectricalPowerSystem)
  (exists (?Y ?Z ?P ?PD)
    (and
      (instance ?Y UninterruptiblePowerSupplyUnit)
      (instance ?Z RechargeableBattery)
      (part ?Y ?Z)
      (or
        (instance ?P SolarPowerGeneration)
        (instance ?P NuclearPowerGeneration)) ; either fission reactor
      ; or RTG
      (instance ?PD PowerSource)
      (instrument ?P ?PD)
      (systemPart ?X ?PD)
      (systemPart ?X ?Y))))

; 37
(subclass SatelliteAttitudeControlSystem PhysicalSystem)
(subclass SatelliteAttitudeControlSystem EngineeringComponent)
(documentation SatelliteAttitudeControlSystem EnglishWrittenLanguage "A subsystem for orientation in space and response to external forces.")
(termFormat EnglishWrittenLanguage SatelliteAttitudeControlSystem "attitude control system")
(termFormat EnglishWrittenLanguage SatelliteAttitudeControlSystem "ACS")

(=>
  (instance ?X SatelliteAttitudeControlSystem)
  (exists (?Y)
    (and
      (instance ?Y ArtificialSatellite)
      (subSystem ?X ?Y)
      (hasPurpose ?X
        (exists (?Z ?A ?B ?C ?D)
          (and
            (instance ?Z Rotating)
            (agent ?Z ?X)
            (patient ?Z ?Y)
            (instance ?A UnitOfAngularMeasure)
            (instance ?B UnitOfAngularMeasure)
            (instance ?C UnitOfAngularMeasure)
            (instance ?D Thruster)
            (instrument ?X ?D)
            (result ?Z ?A)
            (result ?Z ?B)
            (result ?Z ?C)
            (pitch ?Y ?A)
            (roll ?Y ?B)
            (yaw ?Y ?C)))))))

; 38
(subclass Thruster Machine)
(documentation Thruster EnglishWrittenLanguage "A small rocket engine that provides the thrust needed to maneuver a spacecraft.")
(termFormat EnglishWrittenLanguage Thruster "thruster")

(=>
  (instance ?X Thruster)
  (exists (?Y)
    (and
      (instance ?Y ArtificialSatellite)
      (subSystem ?X ?Y)
      (hasPurpose ?X
        (exists (?Z)
          (and
            (instance ?Z Motion)
            (agent ?Z ?X)
            (patient ?Z ?Y)))))))

; 45
(subclass ColdGasThruster Thruster)
(documentation ColdGasThruster EnglishWrittenLanguage "A thruster which stores pressurized inert gas like nitrogen or argon, releasing it through a nozzle without combustion for ultra-precise, delicate attitude control.")
(termFormat EnglishWrittenLanguage ColdGasThruster "cold gas thruster")

(=>
  (and
    (instance ?X ColdGasThruster)
    (instance ?Y Motion)
    (agent ?Y ?X))
  (exists (?Z ?T)
    (and
      (instance ?Z ElementalSubstance)
      (attribute ?Z Gas)
      (duration ?Y ?T)
      (holdsDuring ?T
        (exists (?A)
          (and
            (instance ?A Leaving)
            (patient ?A ?Z)
            (origin ?A ?X)
            (result ?A ?Y)))))))

; 46
(subclass IonThruster Thruster)
(documentation IonThruster EnglishWrittenLanguage "An electric thruster that produces thrust by accelerating ions using an electric field. Gridded ion thrusters use high-voltage grids to accelerate ions of a propellant such as xenon.")
(termFormat EnglishWrittenLanguage IonThruster "ion thruster")

(=>
  (and
    (instance ?X IonThruster)
    (instance ?Y Motion)
    (agent ?Y ?X))
  (exists (?Z ?T)
    (and
      (instance ?Z ElementalSubstance)
      (attribute ?Z Plasma)
      (duration ?Y ?T)
      (holdsDuring ?T
        (exists (?A ?B)
          (and
            (instance ?A Leaving)
            (instance ?B PowerSource)
            (connectedEngineeringComponents ?B ?X)
            (patient ?A ?Z)
            (origin ?A ?X)
            (result ?A ?Y)))))))

; 47
(subclass ChemicalThruster Thruster)
(subclass ChemicalThruster Rocket)
(documentation ChemicalThruster EnglishWrittenLanguage "A thruster that produces thrust using energy released by a chemical reaction of its propellant.")
(termFormat EnglishWrittenLanguage ChemicalThruster "chemical thruster")

(=>
  (and
    (instance ?X ChemicalThruster)
    (instance ?Y Motion)
    (agent ?Y ?X))
  (exists (?Z ?G ?T)
    (and
      (instance ?Z Fuel)
      (instance ?G Substance)
      (attribute ?G OxidizingSubstance)
      (or
        (and
          (attribute ?Z Gas)
          (attribute ?G Gas))
        (and
          (attribute ?Z Solid)
          (attribute ?G Solid)))
      (duration ?Y ?T)
      (holdsDuring ?T
        (exists (?A)
          (and
            (instance ?A Combustion)
            (resource ?A ?Z)
            (resource ?A ?G)
            (origin ?A ?X)
            (result ?A ?Y)))))))

; 39
(subclass SatelliteThermalControlSystem PhysicalSystem)
(subclass SatelliteThermalControlSystem EngineeringComponent)
(documentation SatelliteThermalControlSystem EnglishWrittenLanguage "A subsystem which protects equipment by dissipating excess heat and maintaining safe operating temperatures in extreme space environments.")
(termFormat EnglishWrittenLanguage SatelliteThermalControlSystem "thermal control system")
(termFormat EnglishWrittenLanguage SatelliteThermalControlSystem "TCS")

(=>
  (instance ?X SatelliteThermalControlSystem)
  (exists (?Y ?Z)
    (and
      (instance ?Y HeatingDevice)
      (instance ?Z CoolingDevice)
      (systemPart ?X ?Y)
      (systemPart ?X ?Z))))

(=>
  (instance ?X SatelliteThermalControlSystem)
  (exists (?Y ?Z ?T ?A ?UNIT)
    (and
      (instance ?Y ArtificialSatellite)
      (instance ?UNIT TemperatureMeasure)
      (measure ?Y
        (MeasureFn ?Z ?UNIT))
      (subSystem ?X ?Y)
      (hasPurpose ?X
        (and
          (=>
            (lessThan ?Z ?T)
            (holdsDuring ?A
              (exists (?B)
                (and
                  (instance ?B Heating)
                  (patient ?B ?Y)
                  (agent ?B ?X)))))
          (=>
            (greaterThan ?Z ?T)
            (holdsDuring ?A
              (exists (?B)
                (and
                  (instance ?B Cooling)
                  (patient ?B ?Y)
                  (agent ?B ?X))))))))))

; 40
(subclass SatelliteGuidanceNavigationAndControlSystem PhysicalSystem)
(subclass SatelliteGuidanceNavigationAndControlSystem TelemetrySystem)
(documentation SatelliteGuidanceNavigationAndControlSystem EnglishWrittenLanguage "A subsystem which accepts guidance commands to affect change in aerodynamic and/or engine controls as well as navigation for the spacecraft's current location.")
(termFormat EnglishWrittenLanguage SatelliteGuidanceNavigationAndControlSystem "guidance navigation and control system")
(termFormat EnglishWrittenLanguage SatelliteGuidanceNavigationAndControlSystem "GNC")

(=>
  (instance ?X SatelliteGuidanceNavigationAndControlSystem)
  (exists (?Y)
    (and
      (instance ?Y ArtificialSatellite)
      (subSystem ?X ?Y)
      (hasPurpose ?X
        (exists (?Z)
          (and
            (instance ?Z Locating)
            (agent ?Z ?X)
            (patient ?Z ?Y)))))))

; 41
(subclass SatelliteCommandAndDataHandlingSystem Computer)
(subclass SatelliteCommandAndDataHandlingSystem PhysicalSystem)
(documentation SatelliteCommandAndDataHandlingSystem EnglishWrittenLanguage "A subsystem which carries and stores data between the various electronics units and the ground segment, via the telemetry, tracking and command (TT&C) subsystem.")
(termFormat EnglishWrittenLanguage SatelliteCommandAndDataHandlingSystem "command and data handling system")
(termFormat EnglishWrittenLanguage SatelliteCommandAndDataHandlingSystem "C&DH")

(=>
  (instance ?X SatelliteCommandAndDataHandlingSystem)
  (exists (?Y)
    (and
      (instance ?Y ArtificialSatellite)
      (subSystem ?X ?Y)
      (hasPurpose ?X
        (exists (?Z ?A)
          (or
            (and
              (instance ?Z Crosslink)
              (agent ?Z ?X)
              (instance ?A ArtificialSatellite)
              (origin ?Z ?A))
            (and
              (instance ?Z Uplink)
              (agent ?Z ?X)
              (or
                (instance ?A SatelliteMissionOperationsCenter)
                (instance ?A SatelliteFixedGroundStation)
                (instance ?A SatelliteMobileGroundStation))
              (origin ?Z ?A))))))))

(=>
  (instance ?X SatelliteCommandAndDataHandlingSystem)
  (or
    (exists (?Y)
      (and
        (instance ?Y Transceiver)
        (systemPart ?X ?Y)))
    (exists (?Y ?Z)
      (and
        (instance ?Y Antenna)
        (instance ?Z ReceiverDevice)
        (systemPart ?X ?Y)
        (systemPart ?X ?Z)))))

; 42
(subclass LifeSupportSystem Machine)
(documentation LifeSupportSystem EnglishWrittenLanguage "A system which supports human life in situations where the outside environment is hostile, such as outer space or underwater, or medical situations where the health of the person is compromised to the extent that the risk of death would be high without the function of the equipment")
(termFormat EnglishWrittenLanguage LifeSupportSystem "life-support system")

(=>
  (and
    (instance ?X ArtificialSatellite)
    (instance ?Y Human)
    (hasPurpose ?X
      (contains ?X ?Y)))
  (exists (?Z)
    (and
      (instance ?Z LifeSupportSystem)
      (component ?Z ?X))))

(=>
  (and
    (instance ?X LifeSupportSystem)
    (instance ?Y ArtificialSatellite)
    (component ?X ?Y))
  (exists (?Z)
    (and
      (instance ?Z SatelliteBus)
      (subSystem ?X ?Z)
      (component ?Z ?Y))))

(subclass InvasiveVentilator LifeSupportSystem)

; 43
(subclass SatellitePayload PhysicalSystem)
(documentation SatellitePayload EnglishWrittenLanguage "A system which encompasses all missions systems onboard a satellite. ")
(termFormat EnglishWrittenLanguage SatellitePayload "satellite payload")

(=>
  (instance ?X CommunicationSatellite)
  (exists (?Z ?Y)
    (and
      (instance ?Z CommunicationSystem)
      (instance ?Y SatellitePayload)
      (component ?Y ?X)
      (component ?Z ?Y))))

; 9
(subclass Transceiver Antenna)
(subclass Transceiver ReceiverDevice)
(documentation Transceiver EnglishWrittenLanguage "An antenna comprising both a transmitter and a receiver that are combined and share common circuitry.")
(termFormat EnglishWrittenLanguage Transceiver "transceiver")

; 10
(subclass BaseTransceiverStation StationaryArtifact)
(documentation BaseTransceiverStation EnglishWrittenLanguage "A fixed communication tower featuring one or more two-way transceivers that serve as the network access point for a cellular network.")
(termFormat EnglishWrittenLanguage BaseTransceiverStation "base transceiver station")
(=>
  (instance ?X BaseTransceiverStation)
  (exists (?Y)
    (and
      (instance ?Y Transceiver)
      (component ?Y ?X))))

(=>
  (instance ?X BaseTransceiverStation)
  (exists (?Y)
    (and
      (instance ?Y CellNetwork)
      (component ?X ?Y))))

; 11
(subclass BaseStationController Facility)
(documentation BaseStationController EnglishWrittenLanguage "A ground site within a cellular network which manages frequency, channels, and handovers for one or more base transceiver stations.")
(termFormat EnglishWrittenLanguage BaseStationController "base station controller")

(=>
  (instance ?X BaseStationController)
  (exists (?Y ?Z)
    (and
      (instance ?Y WireLine)
      (instance ?Z BaseTransceiverStation)
      (connected ?Y ?Z)
      (connected ?Y ?X))))

; 12
(subclass MobileSwitchingCenter Facility)
(documentation MobileSwitchingCenter EnglishWrittenLanguage "A ground site within a cellular network which manages call setup and routing as well as fundamental switching operations for one or more base station controllers.")
(termFormat EnglishWrittenLanguage MobileSwitchingCenter "mobile switching center")

; The "Mobile" in mobile switching center is because it handles mobile
; cell phone data

(=>
  (or
    (instance ?X Network2G)
    (instance ?X GSMNetwork))
  (exists (?Y ?Z ?A ?M)
    (and
      (instance ?Y MobileSwitchingCenter)
      (component ?Y ?X)
      (instance ?Z BaseStationController)
      (component ?Z ?X)
      (instance ?M MobileCellPhone)
      (component ?M ?X)
      (instance ?A BaseTransceiverStation)
      (component ?A ?X))))

(=>
  (instance ?X MobileSwitchingCenter)
  (exists (?Y ?Z)
    (and
      (instance ?Y TelephoneLine)
      (instance ?Z BaseStationController)
      (connected ?Y ?Z)
      (connected ?Y ?X))))

(=>
  (instance ?X MobileSwitchingCenter)
  (exists (?H ?V ?A ?E ?G)
    (and
      (instance ?H HomeLocationRegister)
      (instance ?V VisitorLocationRegister)
      (instance ?A AuthenticationCenter)
      (instance ?E EquipmentIdentityRegister)
      (instance ?G GatewayMobileSwitchingCenter)
      (component ?H ?X)
      (component ?V ?X)
      (component ?A ?X)
      (component ?E ?X)
      (component ?G ?X))))

; 13
(subclass Handover AutomatedProcess)
(documentation Handover EnglishWrittenLanguage "The process of transferring an ongoing call or data session from one channel connected to the core network to another.")
(termFormat EnglishWrittenLanguage Handover "phone call handover")

(=>
  (and
    (instance ?B1 BaseTransceiverStation)
    (instance ?B2 BaseTransceiverStation)
    (instance ?X Handover)
    (agent ?X ?B1)
    (patient ?X ?B2))
  (exists (?T1 ?T2 ?Tele)
    (and
      (instance ?Tele Telephoning)
      (instance ?T1 TimeInterval)
      (instance ?T2 TimeInterval)
      (earlier ?T1
        (WhenFn ?Tele))
      (earlier
        (WhenFn ?Tele) ?T2)
      (holdsDuring ?T1
        (origin ?Tele ?B1))
      (holdsDuring ?T2
        (origin ?Tele ?B2)))))

; 14
(subclass TelecomState Attribute)
(documentation TelecomState EnglishWrittenLanguage "A state or condition of a telecommunications device or subscriber on a network.")
(termFormat EnglishWrittenLanguage TelecomState "telecommunication subscription plan")
; 15
(instance Roaming TelecomState)
(documentation Roaming EnglishWrittenLanguage "Roaming is a wireless telecommunication term that typically refers to a mobile phone or mobile device being used outside the range of its native network and connecting to another available cell network.")
(termFormat EnglishWrittenLanguage Roaming "roaming telecommunication subscription plan")
; 16
(instance Prepaid TelecomState)
(documentation Prepaid EnglishWrittenLanguage "A prepaid mobile device subscription, also known as a pay-as-you-go (PAYG), pay-as-you-talk, pay and go, go-phone, or prepay, is a servce for which credit is purchased in advance of service use.")
(termFormat EnglishWrittenLanguage Prepaid "prepaid telecommunication subscription plan")
; 17
(instance Postpaid TelecomState)
(documentation Postpaid EnglishWrittenLanguage "A mobile phone subscription plan for which service is provided by a prior arrangement with a mobile network operator. The user in this situation is billed after the fact according to their use of mobile services at the end of each month.")
(termFormat EnglishWrittenLanguage Postpaid "postpaid telecommunication subscription plan")

(=>
  (and
    (instance ?X MobileCellPhone)
    (instance ?Y Downlink)
    (destination ?Y ?X))
  (exists (?Z)
    (and
      (instance ?Z TelecomState)
      (attribute ?X ?Z))))

; 18
(subclass SimCard EngineeringComponent)
(documentation SimCard EnglishWrittenLanguage "An integrated circuit intended to securely store the international mobile subscriber identity number and its related key.")
(termFormat EnglishWrittenLanguage SimCard "subscriber identity module")
(termFormat EnglishWrittenLanguage SimCard "SIM card")

(=>
  (instance ?X SimCard)
  (exists (?Y)
    (and
      (instance ?Y InternationalMobileSubscriberIdentity)
      (containsInformation ?X ?Y))))

; 19
(subclass InternationalMobileSubscriberIdentity FormalIdentifier)
(subclass InternationalMobileSubscriberIdentity NumericIDString)
(documentation InternationalMobileSubscriberIdentity EnglishWrittenLanguage "A unique number associated with all cellular network users that securely identifies the individual subscriber.")
(termFormat EnglishWrittenLanguage InternationalMobileSubscriberIdentity "International Mobile Subscriber Identity")

(=>
  (and
    (instance ?X InternationalMobileSubscriberIdentity)
    (instance ?Y MobileCellPhone)
    (represents ?X ?Y))
  (exists (?H ?B ?T)
    (and
      (instance ?H Human)
      (instance ?B Organization)
      (attribute ?B WirelessTelecommunicationsCarriersExceptSatellite)
      (instance ?T Buying)
      (agent ?T ?H)
      (origin ?T ?B)
      (patient ?T ?X)
      (or
        (attribute ?Y Prepaid)
        (attribute ?Y Postpaid)
        (attribute ?Y Roaming)))))

(=>
  (and
    (instance ?X InternationalMobileSubscriberIdentity)
    (instance ?Y MobileCellPhone)
    (instance ?Z MobileCellPhone)
    (not
      (equal ?Y ?Z)))
  (and
    (represents ?X ?Y)
    (not
      (represents ?X ?Z))))

; 20
(subclass InternationalMobileEquipmentIdentity FormalIdentifier)
(subclass InternationalMobileEquipmentIdentity NumericIDString)
(documentation InternationalMobileEquipmentIdentity EnglishWrittenLanguage "A unique number used by a cellular network to identify valid physical mobile devices and equipment.")
(termFormat EnglishWrittenLanguage InternationalMobileEquipmentIdentity "International Mobile Equipment Identity")

(=>
  (instance ?X MobileCellPhone)
  (exists (?Y)
    (and
      (instance ?Y InternationalMobileEquipmentIdentity)
      (represents ?Y ?X))))

(=>
  (and
    (instance ?X InternationalMobileEquipmentIdentity)
    (instance ?Y MobileCellPhone)
    (instance ?Z MobileCellPhone)
    (not
      (equal ?Y ?Z)))
  (and
    (represents ?X ?Y)
    (not
      (represents ?X ?Z))))

; 21
(instance coverageRadius BinaryPredicate)
(domain coverageRadius 1 BaseTransceiverStation)
(domain coverageRadius 2 LengthMeasure)
(documentation coverageRadius EnglishWrittenLanguage "Relates a wireless transmitting device or base station to the maximum physical distance (&%LengthMeasure) over which its signal can be reliably received.")
(format EnglishWrittenLanguage coverageRadius "The range that %1 services cellular telephone network measured in %2.")
(termFormat EnglishWrittenLanguage coverageRadius "Base Tranceiver Station coverage radius")

; 22
(subclass Femtocell BaseStationController)
(documentation Femtocell EnglishWrittenLanguage "A small, low-power cellular base station, typically designed for use in a home or small business, covering a very limited area.")
(termFormat EnglishWrittenLanguage Femtocell "femtocell")

(=>
  (and
    (instance ?X Femtocell)
    (coverageRadius ?X ?Y))
  (and
    (equal ?Y
      (MeasureFn ?Y Meter))
    (lessThan ?Y 20)))

; 23
(subclass Picocell BaseStationController)
(documentation Picocell EnglishWrittenLanguage "A cell in a mobile phone network served by a low power cellular base transceiver station, covering a limited area.")
(termFormat EnglishWrittenLanguage Picocell "picocell")

(=>
  (and
    (instance ?X Picocell)
    (coverageRadius ?X ?Y)
    (not
      (instance ?X Femtocell)))
  (and
    (equal ?Y
      (MeasureFn ?Y Meter))
    (lessThan ?Y 200)))

; 24
(subclass Microcell BaseStationController)
(documentation Microcell EnglishWrittenLanguage "A cell in a mobile phone network served by a low power cellular base transceiver station, covering a limited area.")
(termFormat EnglishWrittenLanguage Microcell "microcell")

(=>
  (and
    (instance ?X Microcell)
    (coverageRadius ?X ?Y)
    (not
      (instance ?X Picocell)))
  (and
    (equal ?Y
      (MeasureFn ?Y Meter))
    (lessThan ?Y 2000)))

; 25
(subclass Macrocell BaseStationController)
(documentation Macrocell EnglishWrittenLanguage "A cell in a mobile phone network that provides radio coverage served by a high power cellular base transceiver station.")
(termFormat EnglishWrittenLanguage Macrocell "macrocell")

(=>
  (and
    (instance ?X Macrocell)
    (coverageRadius ?X ?Y)
    (not
      (instance ?X Microcell)))
  (and
    (equal ?Y
      (MeasureFn ?Y Meter))
    (lessThan ?Y 30000)))

; 26
(subclass HomeLocationRegister Facility)
(documentation HomeLocationRegister EnglishWrittenLanguage "A central database within a cellular network that contains details of each mobile unit subscriber authorized to use the core network.")
(termFormat EnglishWrittenLanguage HomeLocationRegister "Home Location Register")

(=>
  (instance ?X HomeLocationRegister)
  (exists (?M)
    (and
      (instance ?M MobileSwitchingCenter)
      (component ?X ?M))))

(=>
  (and
    (instance ?X MobileCellPhone)
    (or
      (attribute ?X Prepaid)
      (attribute ?X Postpaid)))
  (exists (?HLR ?IMSI)
    (and
      (instance ?IMSI InternationalMobileSubscriberIdentity)
      (represents ?IMSI ?X)
      (instance ?HLR HomeLocationRegister)
      (containsInformation ?IMSI ?HLR))))

; 27
(subclass VisitorLocationRegister Facility)
(documentation VisitorLocationRegister EnglishWrittenLanguage "A temporary database associated with a Mobile Switching Center that stores subscriber information for mobile units currently roaming or active within that switching center's service area.")
(termFormat EnglishWrittenLanguage VisitorLocationRegister "Visitor Location Register")
(=>
  (instance ?X VisitorLocationRegister)
  (exists (?M)
    (and
      (instance ?M MobileSwitchingCenter)
      (component ?X ?M))))

(=>
  (and
    (instance ?X MobileCellPhone)
    (attribute ?X Roaming))
  (exists (?VLR ?IMSI)
    (and
      (instance ?IMSI InternationalMobileSubscriberIdentity)
      (represents ?IMSI ?X)
      (instance ?VLR VisitorLocationRegister)
      (containsInformation ?IMSI ?VLR))))

; 28
(subclass AuthenticationCenter Facility)
(documentation AuthenticationCenter EnglishWrittenLanguage "A network entity connected to the Home Location Register that authenticates IMSI of the cellular telephone connecting to the network and manages security keys for encrypted radio communications.")
(termFormat EnglishWrittenLanguage AuthenticationCenter "Authentication Center")
(=>
  (instance ?X AuthenticationCenter)
  (exists (?M ?Y)
    (and
      (instance ?Y HomeLocationRegister)
      (connected ?Y ?X)
      (instance ?M MobileSwitchingCenter)
      (component ?Y ?M)
      (component ?X ?M))))

; 29
(subclass EquipmentIdentityRegister Facility)
(documentation EquipmentIdentityRegister EnglishWrittenLanguage "A network database that tracks mobile device hardware identifiers, such as IMEIs, to validate mobile devices and block stolen or blacklisted hardware from network access.")
(termFormat EnglishWrittenLanguage EquipmentIdentityRegister "Equipment Identity Register")
(=>
  (instance ?X EquipmentIdentityRegister)
  (exists (?M)
    (and
      (instance ?M MobileSwitchingCenter)
      (component ?X ?M))))

(=>
  (instance ?X EquipmentIdentityRegister)
  (exists (?Y)
    (and
      (instance ?Y InternationalMobileEquipmentIdentity)
      (containsInformation ?Y ?X))))

; 30
(subclass GatewayMobileSwitchingCenter Facility)
(documentation GatewayMobileSwitchingCenter EnglishWrittenLanguage "A specialized Mobile Switching Center that serves as the entry and exit point connecting a cellular network to external networks, such as the Public Switched Telephone Network or other cellular operators.")
(termFormat EnglishWrittenLanguage GatewayMobileSwitchingCenter "Gateway Mobile Switching Center")
(=>
  (instance ?X GatewayMobileSwitchingCenter)
  (exists (?M)
    (and
      (instance ?M MobileSwitchingCenter)
      (component ?X ?M))))

; 31
(subclass PublicSwitchedTelephoneNetwork TelephoneSystem)
(documentation PublicSwitchedTelephoneNetwork EnglishWrittenLanguage "The aggregate of the world's circuit-switched telephone networks, which provides landline telecommunications and connects to cellular networks via gateway switching centers.")
(termFormat EnglishWrittenLanguage PublicSwitchedTelephoneNetwork "Public Switched Telephone Network")
(termFormat EnglishWrittenLanguage PublicSwitchedTelephoneNetwork "PSTN")
(termFormat EnglishWrittenLanguage PublicSwitchedTelephoneNetwork "Plain Old Telephone Service")

(=>
  (and
    (instance ?X PublicSwitchedTelephoneNetwork)
    (instance ?Y CellNetwork))
  (not
    (component ?X ?Y)))

(=>
  (and
    (instance ?X MobileCellPhone)
    (instance ?Y FixedPhone)
    (instance ?Z Telephoning)
    (instrument ?Z ?X)
    (instrument ?Z ?Y))
  (exists (?G ?P)
    (and
      (instance ?G GatewayMobileSwitchingCenter)
      (instance ?P PublicSwitchedTelephoneNetwork)
      (component ?G ?P))))

(=>
  (and
    (instance ?X MobileCellPhone)
    (instance ?P PublicSwitchedTelephoneNetwork))
  (not
    (component ?X ?P)))

(=>
  (instance ?X FixedPhone)
  (exists (?P)
    (and
      (instance ?P PublicSwitchedTelephoneNetwork)
      (component ?X ?P))))

; 48
(subclass ReactionWheel Machine)
(documentation ReactionWheel EnglishWrittenLanguage "A motor-driven wheel used to control spacecraft attitude by exchanging angular momentum with the spacecraft as its rotational speed changes.")
(termFormat EnglishWrittenLanguage ReactionWheel "reaction wheel")

(=>
  (instance ?X ReactionWheel)
  (exists (?Y ?Z)
    (and
      (instance ?Y Wheel)
      (instance ?Z ElectricMotor)
      (component ?Y ?X)
      (component ?Z ?X))))

(=>
  (instance ?X ReactionWheel)
  (hasPurpose ?X
    (exists (?Y ?Z)
      (and
        (instance ?Y Rotating)
        (instance ?Z SatelliteAttitudeControlSystem)
        (component ?X ?Z)
        (instrument ?Y ?X)
        (patient ?Y ?Z)))))

; 49
(subclass GSMBaseStationSystem Facility)
(documentation GSMBaseStationSystem EnglishWrittenLanguage "A GSM radio-access equipment system containing a base station controller and one or more base transceiver stations in the conventional Abis-based architecture.")
(termFormat EnglishWrittenLanguage GSMBaseStationSystem "GSM base station system")
(termFormat EnglishWrittenLanguage GSMBaseStationSystem "BSS")

(=>
  (instance ?S GSMBaseStationSystem)
  (exists (?C ?B ?A)
    (and
      (instance ?C BaseStationController)
      (instance ?B BaseTransceiverStation)
      (instance ?A CellNetwork)
      (component ?C ?S)
      (component ?B ?S)
      (component ?S ?A))))

; 50
(subclass StarTracker MeasuringDevice)
(documentation StarTracker EnglishWrittenLanguage "An optical measuring device that determines its orientation by comparing observed star patterns with a star catalog. On a spacecraft it supports attitude determination by the guidance, navigation, or attitude-control system.")
(termFormat EnglishWrittenLanguage StarTracker "star tracker")

(=>
  (instance ?X StarTracker)
  (exists (?Y)
    (and
      (instance ?Y SatelliteGuidanceNavigationAndControlSystem)
      (component ?X ?Y))))

(=>
  (instance ?X StarTracker)
  (hasPurpose ?X
    (exists (?M ?S)
      (and
        (instance ?M Measuring)
        (instance ?S Star)
        (instrument ?M ?X)
        (patient ?M ?S)))))

; 51
(subclass SunSensor MeasuringDevice)
(documentation SunSensor EnglishWrittenLanguage "A measuring device that determines the direction of the Sun relative to the device. Spacecraft use sun sensors for attitude determination and solar-array pointing.")
(termFormat EnglishWrittenLanguage SunSensor "sun sensor")

(=>
  (instance ?X SunSensor)
  (exists (?Y)
    (and
      (instance ?Y SatelliteGuidanceNavigationAndControlSystem)
      (component ?X ?Y))))

(=>
  (instance ?X SunSensor)
  (hasPurpose ?X
    (exists (?M)
      (and
        (instance ?M Measuring)
        (instrument ?M ?X)
        (patient ?M Sol)))))

; 52
(subclass HorizonSensor MeasuringDevice)
(documentation HorizonSensor EnglishWrittenLanguage "A measuring device that detects a planetary horizon to help determine orientation relative to that planet. It can provide attitude information to a spacecraft guidance and control system.")
(termFormat EnglishWrittenLanguage HorizonSensor "horizon sensor")

(=>
  (instance ?X HorizonSensor)
  (exists (?Y)
    (and
      (instance ?Y SatelliteGuidanceNavigationAndControlSystem)
      (component ?X ?Y))))

(=>
  (instance ?X HorizonSensor)
  (hasPurpose ?X
    (exists (?M ?P)
      (and
        (instance ?M Measuring)
        (instance ?P Planet)
        (instrument ?M ?X)
        (patient ?M ?P)))))

(=>
  (instance ?X GPRSNetwork)
  (exists (?Y ?Z ?A ?M ?S ?G)
    (and
      (instance ?S ServingGPRSSupportNode)
      (component ?S ?X)
      (instance ?G GatewayGPRSSupportNode)
      (component ?G ?X)
      (instance ?Y MobileSwitchingCenter)
      (component ?Y ?X)
      (instance ?Z BaseStationController)
      (component ?Z ?X)
      (instance ?M MobileCellPhone)
      (component ?M ?X)
      (instance ?A BaseTransceiverStation)
      (component ?A ?X))))

; 53
(subclass ServingGPRSSupportNode CommunicationDevice)
(documentation ServingGPRSSupportNode EnglishWrittenLanguage "An implemented Serving GPRS Support Node (SGSN) in a GPRS packet core. It handles packet-data delivery and mobility management for the mobile stations it serves and exchanges packet traffic with gateway GPRS support nodes.")
(termFormat EnglishWrittenLanguage ServingGPRSSupportNode "serving GPRS support node")
(termFormat EnglishWrittenLanguage ServingGPRSSupportNode "SGSN")

(=>
  (instance ?S ServingGPRSSupportNode)
  (exists (?N)
    (and
      (instance ?N GPRSNetwork)
      (component ?S ?N))))

(=>
  (instance ?S ServingGPRSSupportNode)
  (hasPurpose ?S
    (exists (?T ?M ?G ?D)
      (and
        (instance ?T DataTransfer)
        (instance ?M MobileCellPhone)
        (instance ?G GatewayGPRSSupportNode)
        (instance ?D DigitalData)
        (instrument ?T ?S)
        (patient ?T ?D)
        (or
          (and
            (origin ?T ?M)
            (destination ?T ?G))
          (and
            (origin ?T ?G)
            (destination ?T ?M)))))))

; 54
(subclass GatewayGPRSSupportNode CommunicationDevice)
(documentation GatewayGPRSSupportNode EnglishWrittenLanguage "An implemented Gateway GPRS Support Node (GGSN) providing the interface between a GPRS packet core and external packet-data networks. It routes outgoing subscriber packets to an external network and incoming packets toward the subscriber's serving SGSN. The external network may be the Internet or a private data network.")
(termFormat EnglishWrittenLanguage GatewayGPRSSupportNode "gateway GPRS support node")
(termFormat EnglishWrittenLanguage GatewayGPRSSupportNode "GGSN")

(=>
  (instance ?G GatewayGPRSSupportNode)
  (exists (?N)
    (and
      (instance ?N GPRSNetwork)
      (component ?G ?N))))

(=>
  (instance ?G GatewayGPRSSupportNode)
  (hasPurpose ?G
    (exists (?T ?S ?N ?D)
      (and
        (instance ?T DataTransfer)
        (instance ?S ServingGPRSSupportNode)
        (instance ?N ComputerNetwork)
        (instance ?D DigitalData)
        (instrument ?T ?G)
        (patient ?T ?D)
        (or
          (and
            (origin ?T ?S)
            (destination ?T ?N))
          (and
            (origin ?T ?N)
            (destination ?T ?S)))))))

; 55
(subclass SatelliteCommandData DigitalData)
(documentation SatelliteCommandData EnglishWrittenLanguage "Digital instructions prepared at a satellite mission operations center and addressed to an artificial satellite. The content specifies a plan for requested operations, such as switching an instrument on or changing an operating mode.")
(termFormat EnglishWrittenLanguage SatelliteCommandData "satellite command data")

(=>
  (instance ?D SatelliteCommandData)
  (exists (?S)
    (and
      (instance ?S ArtificialSatellite)
      (refers ?D ?S))))

(=>
  (instance ?D SatelliteCommandData)
  (exists (?MOC ?PREP)
    (and
      (instance ?MOC SatelliteMissionOperationsCenter)
      (instance ?PREP ContentDevelopment)
      (eventLocated ?PREP ?MOC)
      (result ?PREP ?D))))

(=>
  (instance ?D SatelliteCommandData)
  (exists (?PLAN ?S)
    (and
      (instance ?PLAN Plan)
      (instance ?S ArtificialSatellite)
      (containsInformation ?D ?PLAN)
      (refers ?D ?S)
      (refers ?PLAN ?S))))

; 56
(subclass UMTSNetwork Network3G)
(documentation UMTSNetwork EnglishWrittenLanguage "A third-generation cellular network using the 3GPP Universal Mobile Telecommunications System architecture. The Universal Mobile Telecommunications System (UMTS) is a 3G mobile cellular system for networks based on the GSM standard. UMTS uses wideband code-division multiple access (W-CDMA) radio access technology to offer greater spectral efficiency and bandwidth to mobile network operators compared to previous 2G systems like GPRS and CSD.")
(termFormat EnglishWrittenLanguage UMTSNetwork "UMTS network")

(=>
  (instance ?N UMTSNetwork)
  (exists (?RNS ?MSC ?SGSN ?GGSN)
    (and
      (instance ?RNS RadioNetworkSubsystem)
      (instance ?MSC MobileSwitchingCenter)
      (instance ?SGSN ServingGPRSSupportNode)
      (instance ?GGSN GatewayGPRSSupportNode)
      (component ?RNS ?N)
      (component ?MSC ?N)
      (component ?SGSN ?N)
      (component ?GGSN ?N))))

; 57
(subclass RadioNetworkSubsystem Facility)
(documentation RadioNetworkSubsystem EnglishWrittenLanguage "A Radio Network Subsystem (RNS) is a building block in a UMTS (3G) mobile network that handles the transmission of data and voice between a mobile phone and the core network.")
(termFormat EnglishWrittenLanguage RadioNetworkSubsystem "radio network subsystem")
(termFormat EnglishWrittenLanguage RadioNetworkSubsystem "RNS")

(=>
  (instance ?RNS RadioNetworkSubsystem)
  (exists (?RNC ?B ?N)
    (and
      (instance ?RNC RadioNetworkController)
      (instance ?B NodeB)
      (instance ?N UMTSNetwork)
      (component ?RNC ?RNS)
      (component ?B ?RNS)
      (component ?RNS ?N)
      (forall (?OTHER)
        (=>
          (and
            (instance ?OTHER RadioNetworkController)
            (component ?OTHER ?RNS))
          (equal ?OTHER ?RNC))))))

; 58
(subclass RadioNetworkController CommunicationDevice)
(documentation RadioNetworkController EnglishWrittenLanguage "An implemented UMTS radio network controller that manages the radio resources of one or more Node B base stations in its radio network system. Its responsibilities include radio-resource allocation and handover control.")
(termFormat EnglishWrittenLanguage RadioNetworkController "radio network controller")
(termFormat EnglishWrittenLanguage RadioNetworkController "RNC")

(=>
  (instance ?RNC RadioNetworkController)
  (exists (?RNS ?B)
    (and
      (instance ?RNS RadioNetworkSubsystem)
      (instance ?B NodeB)
      (component ?RNC ?RNS)
      (component ?B ?RNS))))

; 59
(subclass NodeB StationaryArtifact)
(documentation NodeB EnglishWrittenLanguage "An implemented UMTS base station providing radio transmission and reception for one or more cells. It belongs to a radio network system whose radio network controller manages its radio resources.")
(termFormat EnglishWrittenLanguage NodeB "Node B")
(termFormat EnglishWrittenLanguage NodeB "UMTS base station")

(=>
  (instance ?B NodeB)
  (exists (?RNS ?T)
    (and
      (instance ?RNS RadioNetworkSubsystem)
      (instance ?T Transceiver)
      (component ?B ?RNS)
      (component ?T ?B))))

; 60
(subclass HomeSubscriberServer Computer)
(documentation HomeSubscriberServer EnglishWrittenLanguage "A subscriber-data server implementing the 3GPP Home Subscriber Server (HSS) role. It maintains subscription information used by network entities handling calls and data sessions, including subscriber identities and service authorization information.")
(termFormat EnglishWrittenLanguage HomeSubscriberServer "home subscriber server")
(termFormat EnglishWrittenLanguage HomeSubscriberServer "HSS")

; An operational HSS maintains subscriber records referring to IMSIs.
(=>
  (instance ?HSS HomeSubscriberServer)
  (exists (?RECORD ?IMSI)
    (and
      (instance ?RECORD DigitalData)
      (instance ?IMSI InternationalMobileSubscriberIdentity)
      (located ?RECORD ?HSS)
      (refers ?RECORD ?IMSI))))

(=>
  (instance ?HSS HomeSubscriberServer)
  (exists (?N)
    (and
      (or
        (instance ?N Network3G)
        (instance ?N Network4G)
        (instance ?N Network5G)
        (instance ?N Network6G))
      (component ?HSS ?N))))

; 61
(subclass CellularNetworkRegistration AutomatedProcess)
(documentation CellularNetworkRegistration EnglishWrittenLanguage "An automated signaling process through which a mobile phone establishes or updates its registration with a cellular network.")
(termFormat EnglishWrittenLanguage CellularNetworkRegistration "cellular network registration")

(=>
  (instance ?R CellularNetworkRegistration)
  (exists (?T ?D ?N ?NUMBER ?IMEI ?IMSI ?STATE ?SUBSCRIBER)
    (and
      (instance ?T DataTransfer)
      (instance ?D MobileCellPhone)
      (instance ?N CellNetwork)
      (instance ?NUMBER TelecomNumber)
      (instance ?IMEI InternationalMobileEquipmentIdentity)
      (instance ?IMSI InternationalMobileSubscriberIdentity)
      (instance ?STATE TelecomState)
      (instance ?SUBSCRIBER AutonomousAgent)
      (mobilePhoneNumber ?NUMBER ?SUBSCRIBER)
      (represents ?NUMBER ?D)
      (represents ?IMEI ?D)
      (represents ?IMSI ?SUBSCRIBER)
      (holdsDuring
        (WhenFn ?R)
        (attribute ?D ?STATE))
      (subProcess ?T ?R)
      (instrument ?T ?D)
      (instrument ?T ?N)
      (patient ?T ?NUMBER)
      (patient ?T ?IMEI)
      (patient ?T ?IMSI))))

; 62
(instance homogenouslyDispersed TernaryPredicate)
(domain homogenouslyDispersed 1 Collection)
(domain homogenouslyDispersed 2 Region)
(domain homogenouslyDispersed 3 VolumeMeasure)
(documentation homogenouslyDispersed EnglishWrittenLanguage "Relates a Collection of things are evenly distributed throughout some region.")
(format EnglishWrittenLanguage homogenouslyDispersed "The %1 is %n evenly distributed throughout %2 with %3 granularity.")
(termFormat EnglishWrittenLanguage homogenouslyDispersed "homogenously dispersed")

(=>
  (and
    (homogenouslyDispersed ?X ?R ?MINV)
    (instance ?P1 Region)
    (instance ?X1 Collection)
    (subCollection ?X1 ?X)
    (part ?P1 ?R)
    (instance ?X1M Object)
    (member ?X1M ?X1)
    (not
      (member ?X1M ?X2))
    (not
      (member ?X1M ?X3))
    (contains ?P1 ?X1M)
    (instance ?P2 Region)
    (instance ?X2 Collection)
    (subCollection ?X2 ?X)
    (part ?P2 ?R)
    (instance ?X2M Object)
    (member ?X2M ?X2)
    (not
      (member ?X2M ?X1))
    (not
      (member ?X2M ?X3))
    (contains ?P2 ?X2M)
    (instance ?X3 Collection)
    (subCollection ?X3 ?X)
    (instance ?X3M Object)
    (not
      (member ?X3M ?X1))
    (not
      (member ?X3M ?X2))
    (member ?X3M ?X3)
    (not
      (contains ?P1 ?X3M))
    (not
      (contains ?P2 ?X3M))
    (memberCount ?X1 ?C1)
    (memberCount ?X2 ?C2)
    (memberCount ?X3 ?C3)
    (memberCount ?X ?CT)
    (equal ?CT
      (AdditionFn ?C1
        (AdditionFn?C2 ?C3)))
    (not
      (overlapsSpatially ?P1 ?P2))
    (instance ?V VolumeMeasure)
    (greaterThan ?V ?MINV)
    (equal ?V
      (MeasureFn ?P1 UnitOfVolume))
    (equal ?V
      (MeasureFn ?P2 UnitOfVolume)))
  (approximateValue ?C2 ?C1))

; 63
(subclass WeatherSatellite ArtificialSatellite)
(documentation WeatherSatellite EnglishWrittenLanguage "A satellite which was designed to collect meteorological data.")
(termFormat EnglishWrittenLanguage WeatherSatellite "weather satellite")

; ; Term "DataCollection" was not defined, but is used below. Term
; defined by Shaun Rose 9-28-26 after Colin's submission
(subclass DataCollection IntentionalProcess)
(documentation DataCollection EnglishWrittenLanguage "A process in which an Agent obtains and records information about some object, process, event, or condition, resulting in a ContentBearingObject that is stored on a DataStorageDevice.")
(termFormat EnglishWrittenLanguage DataCollection "data collection")

(=>
  (instance ?COLLECTION DataCollection)
  (exists (?DATA ?STORAGE)
    (and
      (instance ?DATA ContentBearingObject)
      (instance ?STORAGE DataStorageDevice)
      (result ?COLLECTION ?DATA)
      (dataStored ?DATA ?STORAGE))))

(=>
  (instance ?X WeatherSatellite)
  (exists (?Y ?Z ?D)
    (and
      (hasPurpose ?X
        (exists (?D ?W)
          (and
            (instance ?D DataCollection)
            (instance ?W WeatherProcess)
            (agent ?D ?X)
            (destination ?D ?W))))
      (instance ?Y SatellitePayload)
      (instance ?Z SensorAppliance)
      (component ?Y ?X)
      (component ?Z ?Y))))

; 64
(subclass GNSSSatellite ArtificialSatellite)
(documentation GNSSSatellite EnglishWrittenLanguage "A satellite which was designed to provide position, navigation, and timing.")
(termFormat EnglishWrittenLanguage GNSSSatellite "Global Navigation Satellite Systems satellite")

(=>
  (instance ?X GNSSSatellite)
  (exists (?Y ?Z ?D)
    (and
      (hasPurpose ?X
        (exists (?D ?W)
          (and
            (instance ?D Locating)
            (instance ?W ElectricDevice)
            (attribute ?W GNSSCapableDevice)
            (instrument ?D ?X)
            (instrument ?D ?W))))
      (instance ?Y SatellitePayload)
      (instance ?Z Antenna)
      (component ?Y ?X)
      (component ?Z ?Y))))

; 65
(instance GNSSCapableDevice Attribute)
(documentation GNSSCapableDevice EnglishWrittenLanguage "An electronic device that is capable of receiving locational services from at least one Global Navigation Satellite System.")
(termFormat EnglishWrittenLanguage GNSSCapableDevice "Global Navigation Satellite System capable device")

(=>
  (attribute ?X GNSSCapableDevice)
  (hasPurpose ?X
    (exists (?D ?W)
      (and
        (instance ?D Locating)
        (instance ?W GNSSSatellite)
        (instrument ?D ?X)
        (instrument ?D ?W)))))

; 66
(subclass BurnerPhone MobileCellPhone)
(documentation BurnerPhone EnglishWrittenLanguage "A mobile cell phone with the purpose of being thrown away after use")
(termFormat EnglishWrittenLanguage BurnerPhone "burner phone")

(=>
  (instance ?X BurnerPhone)
  (hasPurpose ?X
    (exists (?Y ?Z)
      (and
        (attribute ?X Prepaid)
        (instance ?Y Telephoning)
        (instance ?Z Removing)
        (instrument ?Y ?X)
        (patient ?Z ?X)
        (earlier
          (WhenFn ?Y)
          (WhenFn ?Z))))))

; 67
(subclass OpticalImagingSatellite ArtificialSatellite)
(documentation OpticalImagingSatellite EnglishWrittenLanguage "An artificial satellite carrying an optical imaging instrument to produce images from visible or infrared radiation. In this model optical imaging includes infrared imaging, and a satellite can also carry other kinds of instruments.")
(termFormat EnglishWrittenLanguage OpticalImagingSatellite "optical imaging satellite")

(=>
  (instance ?S OpticalImagingSatellite)
  (exists (?P ?C)
    (and
      (instance ?P SatellitePayload)
      (instance ?C Camera)
      (component ?P ?S)
      (component ?C ?P)
      (hasPurpose ?C
        (exists (?PHOTO ?IMAGE ?LIGHT)
          (and
            (instance ?PHOTO Photographing)
            (instance ?IMAGE Photograph)
            (or
              (instance ?LIGHT RadiatingVisibleLight)
              (instance ?LIGHT RadiatingInfrared))
            (instrument ?PHOTO ?C)
            (result ?PHOTO ?IMAGE)
            (subProcess ?LIGHT ?PHOTO)
            (destination ?LIGHT ?C)))))))

; 68
(subclass InfraredImagingSatellite OpticalImagingSatellite)
(documentation InfraredImagingSatellite EnglishWrittenLanguage "An optical imaging satellite equipped to form images from infrared radiation. Depending on the instrument's wavelength range, this can include reflected near-infrared radiation or emitted thermal radiation; infrared imaging is not limited to measuring temperature.")
(termFormat EnglishWrittenLanguage InfraredImagingSatellite "infrared imaging satellite")

(=>
  (instance ?S InfraredImagingSatellite)
  (exists (?P ?C)
    (and
      (instance ?P SatellitePayload)
      (instance ?C Camera)
      (component ?P ?S)
      (component ?C ?P)
      (hasPurpose ?C
        (exists (?PHOTO ?IMAGE ?IR)
          (and
            (instance ?PHOTO Photographing)
            (instance ?IMAGE Photograph)
            (instance ?IR RadiatingInfrared)
            (instrument ?PHOTO ?C)
            (result ?PHOTO ?IMAGE)
            (subProcess ?IR ?PHOTO)
            (destination ?IR ?C)))))))

; 69
(subclass SARSatellite ArtificialSatellite)
(documentation SARSatellite EnglishWrittenLanguage "An artificial satellite carrying synthetic aperture radar as part of its payload for producing radar images of observed surfaces. SAR stands for synthetic aperture radar.")
(termFormat EnglishWrittenLanguage SARSatellite "synthetic aperture radar satellite")
(termFormat EnglishWrittenLanguage SARSatellite "SAR satellite")

(=>
  (instance ?S SARSatellite)
  (exists (?P ?R)
    (and
      (instance ?P SatellitePayload)
      (instance ?R SyntheticApertureRadar)
      (component ?P ?S)
      (component ?R ?P))))

; 70
(subclass SyntheticApertureRadar Radar)
(documentation SyntheticApertureRadar EnglishWrittenLanguage "A radar that forms images by coherently combining echoes collected at successive antenna positions along a path. Relative motion synthesizes a larger effective antenna aperture. The instrument can be carried by a satellite, aircraft, or another moving platform.")
(termFormat EnglishWrittenLanguage SyntheticApertureRadar "synthetic aperture radar")
(termFormat EnglishWrittenLanguage SyntheticApertureRadar "SAR")

(=>
  (instance ?R SyntheticApertureRadar)
  (and
    (exists (?A)
      (and
        (instance ?A Antenna)
        (component ?A ?R)))
    (hasPurpose ?R
      (exists (?IMAGING ?IMAGE ?MOTION ?COMPUTER)
        (and
          (instance ?IMAGING ContentDevelopment)
          (instance ?IMAGE Image)
          (instance ?MOTION Motion)
          (instance ?COMPUTER Computer)
          (instrument ?IMAGING ?R)
          (instrument ?IMAGING ?COMPUTER)
          (result ?IMAGING ?IMAGE)
          (subProcess ?MOTION ?IMAGING)
          (patient ?MOTION ?R))))))

; 71
(subclass MobilePhoneCharger Charger)
(documentation MobilePhoneCharger EnglishWrittenLanguage "A charger that has the purpose of charging mobile cell phone.")
(termFormat EnglishWrittenLanguage MobilePhoneCharger "mobile phone charger")

(=>
  (instance ?CH Charger)
  (hasPurpose ?CH
    (exists (?P ?Z)
      (and
        (instance ?P Charging)
        (instance ?Z MobileCellPhone)
        (patient ?P ?Z)
        (instrument ?P ?CH)))))

; 72
(subclass SimCardReader ElectricDevice)
(documentation SimCardReader EnglishWrittenLanguage "An electronic device or device component that communicates with a SIM card to read information made available by the card, such as its international mobile subscriber identity. It may be built into a phone or used as a separate reader.")
(termFormat EnglishWrittenLanguage SimCardReader "SIM card reader")

(=>
  (instance ?R SimCardReader)
  (hasPurpose ?R
    (exists (?T ?SIM ?IMSI)
      (and
        (instance ?T DataTransfer)
        (instance ?SIM SimCard)
        (instance ?IMSI InternationalMobileSubscriberIdentity)
        (origin ?T ?SIM)
        (destination ?T ?R)
        (instrument ?T ?R)
        (patient ?T ?IMSI)))))

; 73
(subclass EvolvedNodeB CommunicationDevice)
(documentation EvolvedNodeB EnglishWrittenLanguage "An implemented LTE base station, also called an eNodeB or eNB. It provides radio access for user equipment and handles radio-resource functions. It connects to an MME for control signaling and to a Serving Gateway for user packet traffic.")
(termFormat EnglishWrittenLanguage EvolvedNodeB "evolved Node B")
(termFormat EnglishWrittenLanguage EvolvedNodeB "eNodeB")

(=>
  (instance ?B EvolvedNodeB)
  (exists (?N ?CORE)
    (and
      (instance ?N Network4G)
      (instance ?CORE EvolvedPacketCore)
      (component ?B ?N)
      (component ?CORE ?N))))

(=>
  (instance ?B EvolvedNodeB)
  (hasPurpose ?B
    (exists (?T ?M ?G ?D)
      (and
        (instance ?T DataTransfer)
        (instance ?M MobileCellPhone)
        (instance ?G ServingGateway)
        (instance ?D DigitalData)
        (instrument ?T ?B)
        (patient ?T ?D)
        (or
          (and
            (origin ?T ?M)
            (destination ?T ?G))
          (and
            (origin ?T ?G)
            (destination ?T ?M)))))))

; 74
(subclass MobilityManagementEntity CommunicationDevice)
(documentation MobilityManagementEntity EnglishWrittenLanguage "An implemented LTE core-network control node, abbreviated MME, responsible for functions including registration, mobility management and coordinating subscriber authentication. Ordinary user packet forwarding is performed by gateways rather than by the MME.")
(termFormat EnglishWrittenLanguage MobilityManagementEntity "mobility management entity")
(termFormat EnglishWrittenLanguage MobilityManagementEntity "MME")

(=>
  (instance ?M MobilityManagementEntity)
  (exists (?CORE)
    (and
      (instance ?CORE EvolvedPacketCore)
      (component ?M ?CORE))))

(=>
  (instance ?M MobilityManagementEntity)
  (hasPurpose ?M
    (exists (?R ?HSS)
      (and
        (instance ?R CellularNetworkRegistration)
        (instance ?HSS HomeSubscriberServer)
        (instrument ?R ?M)
        (instrument ?R ?HSS)))))

; 75
(subclass NetworkGateway CommunicationDevice)
(documentation NetworkGateway EnglishWrittenLanguage "A communication device whose purpose is transferring information between distinct computer networks. A gateway can provide routing, protocol translation, or other interconnection functions; protocol translation is not required of every gateway.")
(termFormat EnglishWrittenLanguage NetworkGateway "network gateway")

(=>
  (instance ?G NetworkGateway)
  (hasPurpose ?G
    (exists (?T ?N1 ?N2 ?D)
      (and
        (instance ?T DataTransfer)
        (instance ?N1 ComputerNetwork)
        (instance ?N2 ComputerNetwork)
        (instance ?D DigitalData)
        (not
          (equal ?N1 ?N2))
        (origin ?T ?N1)
        (destination ?T ?N2)
        (instrument ?T ?G)
        (patient ?T ?D)))))

; 76
(subclass ServingGateway NetworkGateway)
(documentation ServingGateway EnglishWrittenLanguage "An LTE Serving Gateway, also called an S-GW or SGW. It forwards user packets between the radio-access network and a Packet Data Network Gateway, and provides a mobility anchor during movement between LTE base stations.")
(termFormat EnglishWrittenLanguage ServingGateway "serving gateway")
(termFormat EnglishWrittenLanguage ServingGateway "S-GW")

(=>
  (instance ?G ServingGateway)
  (exists (?CORE)
    (and
      (instance ?CORE EvolvedPacketCore)
      (component ?G ?CORE))))

(=>
  (instance ?G ServingGateway)
  (hasPurpose ?G
    (exists (?T ?B ?P ?D)
      (and
        (instance ?T DataTransfer)
        (instance ?B EvolvedNodeB)
        (instance ?P PacketDataNetworkGateway)
        (instance ?D DigitalData)
        (instrument ?T ?G)
        (patient ?T ?D)
        (or
          (and
            (origin ?T ?B)
            (destination ?T ?P))
          (and
            (origin ?T ?P)
            (destination ?T ?B)))))))

; 77
(subclass PacketDataNetworkGateway NetworkGateway)
(documentation PacketDataNetworkGateway EnglishWrittenLanguage "An LTE Packet Data Network Gateway, also called a PDN Gateway or P-GW. It connects the cellular packet core to a packet-data network, such as the Internet or a private network, and supports functions such as UE address allocation and policy enforcement.")
(termFormat EnglishWrittenLanguage PacketDataNetworkGateway "packet data network gateway")
(termFormat EnglishWrittenLanguage PacketDataNetworkGateway "P-GW")

(=>
  (instance ?G PacketDataNetworkGateway)
  (exists (?CORE)
    (and
      (instance ?CORE EvolvedPacketCore)
      (component ?G ?CORE))))

(=>
  (instance ?G PacketDataNetworkGateway)
  (hasPurpose ?G
    (exists (?T ?S ?N ?D)
      (and
        (instance ?T DataTransfer)
        (instance ?S ServingGateway)
        (instance ?N ComputerNetwork)
        (instance ?D DigitalData)
        (instrument ?T ?G)
        (patient ?T ?D)
        (or
          (and
            (origin ?T ?S)
            (destination ?T ?N))
          (and
            (origin ?T ?N)
            (destination ?T ?S)))))))

; 78
(subclass EvolvedPacketCore PhysicalSystem)
(subclass EvolvedPacketCore EngineeringComponent)
(documentation EvolvedPacketCore EnglishWrittenLanguage "The packet-switched core system of a conventional LTE deployment. This structural model includes mobility management entities, Serving Gateways and Packet Data Network Gateways. Subscriber information is supplied by a Home Subscriber Server. LTE base stations belong to the radio-access network outside the core.")
(termFormat EnglishWrittenLanguage EvolvedPacketCore "evolved packet core")
(termFormat EnglishWrittenLanguage EvolvedPacketCore "EPC")

(=>
  (instance ?CORE EvolvedPacketCore)
  (exists (?MME ?SGW ?PGW ?N)
    (and
      (instance ?MME MobilityManagementEntity)
      (instance ?SGW ServingGateway)
      (instance ?PGW PacketDataNetworkGateway)
      (instance ?N Network4G)
      (component ?MME ?CORE)
      (component ?SGW ?CORE)
      (component ?PGW ?CORE)
      (component ?CORE ?N))))

; 79
(subclass ShortMessageServiceCenter CommunicationDevice)
(documentation ShortMessageServiceCenter EnglishWrittenLanguage "An implemented cellular-network service node that stores and forwards Short Message Service (SMS) messages. It accepts messages for delivery and can retain them for later delivery attempts when the recipient is unavailable.")
(termFormat EnglishWrittenLanguage ShortMessageServiceCenter "short message service center")
(termFormat EnglishWrittenLanguage ShortMessageServiceCenter "SMSC")

(=>
  (instance ?C ShortMessageServiceCenter)
  (hasPurpose ?C
    (exists (?T ?MESSAGE)
      (and
        (instance ?T Texting)
        (instance ?MESSAGE Text)
        (instrument ?T ?C)
        (patient ?T ?MESSAGE)))))

; 80
(subclass Texting DoNetworkMessaging)
(subclass Texting WrittenCommunication)
(documentation Texting EnglishWrittenLanguage "Network messaging in which users send or receive text messages. This includes SMS texting and text messaging through network applications.")
(termFormat EnglishWrittenLanguage Texting "texting")
(termFormat EnglishWrittenLanguage Texting "text messaging")

(=>
  (instance ?T Texting)
  (exists (?MESSAGE)
    (and
      (instance ?MESSAGE Text)
      (patient ?T ?MESSAGE))))

; 81
(subclass DualSimPhone MobileCellPhone)
(documentation DualSimPhone EnglishWrittenLanguage "A mobile cell phone designed to support two cellular subscriptions using distinct international mobile subscriber identities. The subscriptions may use physical SIM cards, eSIM profiles, or a combination.")
(termFormat EnglishWrittenLanguage DualSimPhone "dual SIM phone")

(=>
  (instance ?P DualSimPhone)
  (hasPurpose ?P
    (exists (?R1 ?R2 ?T1 ?T2 ?IMSI1 ?IMSI2)
      (and
        (instance ?R1 CellularNetworkRegistration)
        (instance ?R2 CellularNetworkRegistration)
        (instance ?T1 DataTransfer)
        (instance ?T2 DataTransfer)
        (instance ?IMSI1 InternationalMobileSubscriberIdentity)
        (instance ?IMSI2 InternationalMobileSubscriberIdentity)
        (not
          (equal ?IMSI1 ?IMSI2))
        (not
          (equal ?R1 ?R2))
        (instrument ?R1 ?P)
        (instrument ?R2 ?P)
        (subProcess ?T1 ?R1)
        (subProcess ?T2 ?R2)
        (origin ?T1 ?P)
        (origin ?T2 ?P)
        (patient ?T1 ?IMSI1)
        (patient ?T2 ?IMSI2)))))

; 82
(subclass NetworkSwitch ElectricDevice)
(subclass NetworkSwitch HomeOfficeAppliance)
(subclass NetworkSwitch CommunicationDevice)
(documentation NetworkSwitch EnglishWrittenLanguage "An electronic communication device that connects network devices and forwards data through selected ports according to destination addressing information.")
(termFormat EnglishWrittenLanguage NetworkSwitch "network switch")

(=>
  (instance ?S NetworkSwitch)
  (hasPurpose ?S
    (exists (?T ?SOURCE ?DESTINATION ?DATA)
      (and
        (instance ?T DataTransfer)
        (instance ?SOURCE CommunicationDevice)
        (instance ?DESTINATION CommunicationDevice)
        (instance ?DATA DigitalData)
        (not
          (equal ?SOURCE ?DESTINATION))
        (instrument ?T ?S)
        (origin ?T ?SOURCE)
        (destination ?T ?DESTINATION)
        (patient ?T ?DATA)))))

; 83
(subclass NetworkFirewall SoftwarePackage)
(documentation NetworkFirewall EnglishWrittenLanguage "A software package that monitors and filters network traffic according to configured security rules, allowing permitted traffic and blocking prohibited traffic.")
(termFormat EnglishWrittenLanguage NetworkFirewall "network firewall")

; The purpose belongs to an execution of the software, since
; SoftwarePackage is a subclass of Procedure rather than Physical.
(=>
  (and
    (instance ?F NetworkFirewall)
    (instance ?RUN ComputerProcess)
    (realization ?RUN ?F))
  (hasPurpose ?RUN
    (exists (?T ?PACKET)
      (and
        (instance ?T NetworkCommunication)
        (instance ?PACKET Packet)
        (patient ?T ?PACKET)
        (prevents ?RUN ?T)))))

; 84
(subclass WAN ComputationalSystem)
(subclass WAN ComputerNetwork)
(documentation WAN EnglishWrittenLanguage "A wide-area computer network that provides communication across a large geographic area, such as between sites in different cities or regions. It can interconnect local networks using public or private communication links.")
(termFormat EnglishWrittenLanguage WAN "wide area network")
(termFormat EnglishWrittenLanguage WAN "WAN")

(=>
  (instance ?W WAN)
  (hasPurpose ?W
    (exists (?T ?N1 ?N2 ?DATA)
      (and
        (instance ?T DataTransfer)
        (instance ?N1 LAN)
        (instance ?N2 LAN)
        (instance ?DATA DigitalData)
        (not
          (equal ?N1 ?N2))
        (instrument ?T ?W)
        (origin ?T ?N1)
        (destination ?T ?N2)
        (patient ?T ?DATA)))))