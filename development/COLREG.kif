;; ===========================================================================
;; COLREG.kif
;;
;; The International Regulations for Preventing Collisions at Sea (COLREGs,
;; the Rules of the Road): vessel categories, lights and day shapes, encounter
;; geometry, and the head-on, crossing and overtaking situations, with the
;; give-way and stand-on duties and the obligatory next action of each vessel.
;;
;; Based on the Rules of the Road ontology by James W. Timberlake (NPS
;; thesis, March 2025). Revised by Onur Orkut Genisel so that it loads with
;; current SUMO and can serve as the COLREGs module of a combined COLREGs and
;; ROE knowledge base (ROE_Master.kif, ROE_Supplementary.kif, ROE_Series.kif).
;;
;; Main changes from the original:
;;  - Parentheses, misspelled terms and wrong arities are fixed. Terms are
;;    aligned with SUMO (ShipCaptain, Decelerating, DirectionChange, Near,
;;    EnglishWrittenLanguage). Sail, Starting and Stopping come from MILO.
;;  - holdsObligation is used in (agent formula) order. Measures are typed
;;    through (equal ?Q (MeasureFn ?N Unit)); distances are in nautical miles
;;    and times in minutes.
;;  - speedOverGround and courseOverGround are ternary (vessel, value, time).
;;  - Rules that only created Skolem terms, or that cannot fire under the
;;    open-world assumption, are commented out, with the reason above each.
;;  - Scenario facts are not in this file. A scenario asserts the vessels and
;;    their attributes, courses, speeds, relative bearing, cpa and cpat at a
;;    time, and the cpa thresholds of own vessel.
;;
;; Requires Merge.kif, Mid-level-ontology.kif, Geography.kif,
;; Transportation.kif, Weather.kif and engineering.kif.
;; ===========================================================================

; *******************************************************************
; ************************** HIERARCHY ******************************
; ******************************************************************* 

(instance OwnVessel RotrAttribute) 
(documentation OwnVessel EnglishWrittenLanguage "In reference to a rules of
the road situation, own vessel refers to the 1st person view of the
operators vessel. This is a linguistic deictic expression, it is 
external to the formal system.")
(termFormat EnglishWrittenLanguage OwnVessel "own vessel")  


(=>
  (and
    (instance ?VES WaterVehicle)
    (attribute ?VES OwnVessel))
  (not (attribute ?VES TargetVessel)))

  
(instance TargetVessel RotrAttribute) 
(documentation TargetVessel EnglishWrittenLanguage "In reference to a rules 
of the road situation, target vessel refers to another vessel that
is of interest to own vessel.")
(termFormat EnglishWrittenLanguage TargetVessel "target vessel")  

(=>
  (and
    (instance ?VES WaterVehicle)
    (attribute ?VES TargetVessel))
  (not (attribute ?VES OwnVessel)))
  
  

; Seamanship
(subclass Seamanship FieldOfStudy)
(documentation Seamanship EnglishWrittenLanguage "The knowledge and skills
required to operate a boat or ship.")
(termFormat EnglishWrittenLanguage Seamanship "seamanship")   

(=>
  (attribute ?P Sailor)
  (hasExpertise ?P Seamanship))
 
(=>
  (attribute ?P ShipDriver)
  (hasExpertise ?P Seamanship))  
  
(=>
  (attribute ?P ShipCaptain)
  (hasExpertise ?P Seamanship))

; define seamanship more
  
  
; responsibleFor
(instance responsibleFor CaseRole)
(documentation responsibleFor EnglishWrittenLanguage "(responsibleFor ?PROCESS 
?AGENT) means that ?AGENT is overall responsible for the Process 
?PROCESS.")
(termFormat EnglishWrittenLanguage responsibleFor "responsible for")   
(domain responsibleFor 1 Process)
(domain responsibleFor 2 AutonomousAgent)
(format EnglishWrittenLanguage responsibleFor "%2 is %n responsible for %1")

    
(=>
  (and
    (instance ?SHIP WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?SHIP))
  (exists (?CAPT)
    (holdsDuring (WhenFn ?TRANS)
      (and
        (instance ?CAPT AutonomousAgent)
        (responsibleFor ?TRANS ?CAPT)
        (attribute ?CAPT ShipCaptain)))))

(=>
  (and
    (instance ?V Vehicle)
    (instance ?TRANS Translocation)
    (instance ?DRIVE Driving) 
    (objectTransferred ?TRANS ?V)
    (agent ?DRIVE ?DRIVER)
    (patient ?DRIVE ?V))
  (holdsDuring (WhenFn ?TRANS)
    (responsibleFor ?TRANS ?DRIVER)))
        
        
; ShipDriver
(subAttribute ShipDriver Sailor)
(documentation ShipDriver EnglishWrittenLanguage "A ship driver is responsible
for the navigation of a water vessel.")
(termFormat EnglishWrittenLanguage ShipDriver "ship driver")   

(=>
  (and
    (instance ?SHIP WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?SHIP))
  (holdsDuring (WhenFn ?TRANS)
    (exists (?DRIVER ?DRIVING)
      (and
        (instance ?DRIVER AutonomousAgent)
        (instance ?DRIVING Driving)
        (patient ?DRIVING ?SHIP)
        (agent ?DRIVING ?DRIVER)
        (attribute ?DRIVER ShipDriver)))))


(subclass RotrAttribute Attribute)
(documentation RotrAttribute EnglishWrittenLanguage "an attribute of a 
water vehicle as defined by the COLREGs Rules of the Road.")
(termFormat EnglishWrittenLanguage RotrAttribute "rules of the road attribute") 



(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 NotUnderCommand))
  (not
    (or
      (attribute ?VES1 RestrictedInAbilityToManeuver)
      (attribute ?VES1 ConstrainedByDraft)
      (attribute ?VES1 VesselEngagedInFishing)
      (attribute ?VES1 SailingVessel)
      (attribute ?VES1 PowerDrivenVessel))))

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 RestrictedInAbilityToManeuver))
  (not
    (or
      (attribute ?VES1 NotUnderCommand)
      (attribute ?VES1 ConstrainedByDraft)
      (attribute ?VES1 VesselEngagedInFishing)
      (attribute ?VES1 SailingVessel)
      (attribute ?VES1 PowerDrivenVessel))))
      
(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 ConstrainedByDraft))
  (not
    (or
      (attribute ?VES1 NotUnderCommand)
      (attribute ?VES1 RestrictedInAbilityToManeuver)
      (attribute ?VES1 VesselEngagedInFishing)
      (attribute ?VES1 SailingVessel)
      (attribute ?VES1 PowerDrivenVessel))))

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 VesselEngagedInFishing))
  (not
    (or
      (attribute ?VES1 NotUnderCommand)
      (attribute ?VES1 RestrictedInAbilityToManeuver)
      (attribute ?VES1 ConstrainedByDraft)
      (attribute ?VES1 SailingVessel)
      (attribute ?VES1 PowerDrivenVessel))))
     
(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 SailingVessel))
  (not
    (or
      (attribute ?VES1 NotUnderCommand)
      (attribute ?VES1 RestrictedInAbilityToManeuver)
      (attribute ?VES1 ConstrainedByDraft)
      (attribute ?VES1 VesselEngagedInFishing)
      (attribute ?VES1 PowerDrivenVessel))))

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 PowerDrivenVessel))
  (not
    (or
      (attribute ?VES1 NotUnderCommand)
      (attribute ?VES1 RestrictedInAbilityToManeuver)
      (attribute ?VES1 ConstrainedByDraft)
      (attribute ?VES1 VesselEngagedInFishing)
      (attribute ?VES1 SailingVessel))))

                   
; NotUnderCommand
(instance NotUnderCommand RotrAttribute)
(documentation NotUnderCommand EnglishWrittenLanguage "A vessel which through
some exceptional circumstance is unable to maneuver as required by these
Rules and is therefore unable to keep out of the way of another vessel.")
(termFormat EnglishWrittenLanguage NotUnderCommand "not under command")  


;; DISABLED: NUC derivation: (not (instance ?NOTMOVE Maneuver)) with a free ?NOTMOVE; fires on any non-maneuver process. NUC is asserted per scenario.
;(=>
;  (and
;    (instance ?VES WaterVehicle)
;    (instance ?TRANS Translocation)
;    (objectTransferred ?TRANS ?VES)
;    (not (instance ?NOTMOVE Maneuver))
;    (agent ?NOTMOVE ?VES))
;  (holdsDuring (WhenFn ?TRANS)
;    (attribute ?VES NotUnderCommand)))
    
    
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES NotUnderCommand)
    (attribute ?CO ShipCaptain)
    (or
      (and
        (instance ?NIGHT NightTime)
        (during (WhenFn ?TRANS) ?NIGHT))     
      (and
        (stoppingDistance ?VES ?SDQ)
        (equal ?SDQ (MeasureFn ?SD NauticalMile))
        (visibilityInMeteorology (WhereFn ?VES (BeginFn (WhenFn ?TRANS))) (WhenFn ?TRANS) ?VISQ)
        (equal ?VISQ (MeasureFn ?VIS NauticalMile))
        (lessThanOrEqualTo ?VIS ?SD)))
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?L1 ?L2 ?MAST) 
      (and
        (instance ?L1 TaskingLight)
        (instance ?L2 TaskingLight)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (color ?L1 Red)
        (color ?L2 Red)
        (orientation ?L1 ?L2 Vertical)
        (located ?L1 ?MAST)
        (located ?L2 ?MAST)))))
    
    
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES NotUnderCommand)
    (attribute ?CO ShipCaptain)
    (instance ?DAY DayTime)
    (during (WhenFn ?TRANS) ?DAY)   
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?DS1 ?DS2 ?MAST) 
      (and
        (instance ?DS1 Artifact)
        (instance ?DS2 Artifact)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (color ?DS1 Black)
        (color ?DS2 Black)
        (shape ?DS1 Sphere)
        (shape ?DS2 Sphere)
        (orientation ?DS1 ?DS2 Vertical)
        (located ?DS1 ?MAST)
        (located ?DS2 ?MAST)))))

; RestrictedAbilityToManeuver
(instance RestrictedInAbilityToManeuver RotrAttribute)
(documentation RestrictedInAbilityToManeuver EnglishWrittenLanguage "a vessel which from 
the nature of her work is restricted in her ability to maneuver as
required by these Rules and is therefore unable to keep out of the way 
of another vessel")
(termFormat EnglishWrittenLanguage RestrictedInAbilityToManeuver "restricted 
in her ability to maneuver")  

;; DISABLED: RAM derivation: same open-world pattern as NUC. RAM is asserted per scenario or derived by the COLREG-ROE bridge.
;(=>
;  (and
;    (instance ?VES WaterVehicle)
;    (instance ?TRANS Translocation)
;    (instance ?WORK Working)
;    (instance ?SAILOR Sailor)
;    (not (instance ?NOTMOVE Maneuver))
;    (objectTransferred ?TRANS ?VES)
;    (agent ?WORK ?SAILOR)
;    (eventLocated ?WORK ?VES)
;    (agent ?NOTMOVE ?VES))
;  (holdsDuring (WhenFn ?TRANS)
;    (attribute ?VES RestrictedInAbilityToManeuver)))



(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 RestrictedInAbilityToManeuver)
    (instance ?VES2 WaterVehicle)
    (attribute ?VES2 NotUnderCommand)
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW))
  (and
    (giveWayVessel ?VES1 ?VES2 ?TIMENOW)
    (standOnVessel ?VES2 ?VES1 ?TIMENOW)))

    
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES RestrictedInAbilityToManeuver)
    (attribute ?CO ShipCaptain)
    (or
      (and
        (instance ?NIGHT NightTime)
        (during (WhenFn ?TRANS) ?NIGHT))     
      (and
        (stoppingDistance ?VES ?SDQ)
        (equal ?SDQ (MeasureFn ?SD NauticalMile))
        (visibilityInMeteorology (WhereFn ?VES (BeginFn (WhenFn ?TRANS))) (WhenFn ?TRANS) ?VISQ)
        (equal ?VISQ (MeasureFn ?VIS NauticalMile))
        (lessThanOrEqualTo ?VIS ?SD)))
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?L1 ?L2 ?L3 ?MAST) 
      (and
        (instance ?L1 TaskingLight)
        (instance ?L2 TaskingLight)
        (instance ?L3 TaskingLight)
        (instance ?MAST Mast)
        (color ?L1 Red)
        (color ?L2 White)
        (color ?L3 Red)
        (orientation ?L1 ?L2 Vertical)
        (orientation ?L2 ?L3 Vertical)
        (orientation ?L1 ?L2 Above)
        (orientation ?L2 ?L3 Above)
        (located ?L1 ?MAST)
        (located ?L2 ?MAST)
        (located ?L3 ?MAST)))))
 
    
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES ConstrainedByDraft)
    (attribute ?CO ShipCaptain)
    (instance ?DAY DayTime)
    (during (WhenFn ?TRANS) ?DAY)   
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?DS1 ?DS2 ?DS3 ?MAST) 
      (and
        (instance ?DS1 Artifact)
        (instance ?DS2 Artifact)
        (instance ?DS3 Artifact)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (color ?DS1 Black)
        (color ?DS2 Black)
        (color ?DS3 Black)
        (shape ?DS1 Sphere)
        (shape ?DS2 Cube)
        (shape ?DS3 Sphere)
        (orientation ?DS1 ?DS2 Vertical)
        (orientation ?DS2 ?DS3 Vertical)
        (orientation ?DS1 ?DS2 Above)
        (orientation ?DS2 ?DS3 Above)
        (located ?DS1 ?MAST)
        (located ?DS2 ?MAST)
        (located ?DS3 ?MAST)))))
    
       
; ContstrainedByDraft
(instance ConstrainedByDraft RotrAttribute)
(documentation ConstrainedByDraft EnglishWrittenLanguage "A power-driven
vessel which, because of her draft in relation to the available depth 
and width of navigable water is severely restricted in her ability to 
deviate from the course she is following.")
(termFormat EnglishWrittenLanguage ConstrainedByDraft "constrained by her draft")  

(=>
  (and
    (instance ?VES WaterVehicle)
    (instance ?HULL ShipsHull)
    (part ?HULL ?VES)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (instance ?AREA WaterArea)
    (instance ?FLOOR SeabedArea)
    (part ?FLOOR ?AREA)
    (eventLocated ?TRANS ?AREA)
    (instance ?INLAND InlandWaterSystem)
    (not (equal ?INLAND ?AREA))
    (orientation ?VES ?FLOOR Near))
  (holdsDuring (WhenFn ?TRANS)
    (attribute ?VES ConstrainedByDraft)))

  


(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 ConstrainedByDraft)
    (instance ?VES2 WaterVehicle)
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)
    (or
      (attribute ?VES2 NotUnderCommand)
      (attribute ?VES2 RestrictedInAbilityToManeuver))
    (not
      (overtakingSituation ?VES2 ?VES1 ?TIMENOW)))
  (and
    (giveWayVessel ?VES1 ?VES2 ?TIMENOW)
    (standOnVessel ?VES2 ?VES1 ?TIMENOW)))

    
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES ConstrainedByDraft)
    (attribute ?CO ShipCaptain)
    (or
      (and
        (instance ?NIGHT NightTime)
        (during (WhenFn ?TRANS) ?NIGHT))     
      (and
        (stoppingDistance ?VES ?SDQ)
        (equal ?SDQ (MeasureFn ?SD NauticalMile))
        (visibilityInMeteorology (WhereFn ?VES (BeginFn (WhenFn ?TRANS))) (WhenFn ?TRANS) ?VISQ)
        (equal ?VISQ (MeasureFn ?VIS NauticalMile))
        (lessThanOrEqualTo ?VIS ?SD)))
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?L1 ?L2 ?L3 ?MAST) 
      (and
        (instance ?L1 TaskingLight)
        (instance ?L2 TaskingLight)
        (instance ?L3 TaskingLight)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (color ?L1 Red)
        (color ?L2 Red)
        (color ?L3 Red)
        (orientation ?L1 ?L2 Vertical)
        (orientation ?L2 ?L3 Vertical)
        (located ?L1 ?MAST)
        (located ?L2 ?MAST)
        (located ?L3 ?MAST)))))

    
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES ConstrainedByDraft)
    (attribute ?CO ShipCaptain)
    (instance ?DAY DayTime)
    (during (WhenFn ?TRANS) ?DAY)   
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?DS ?MAST) 
      (and
        (instance ?DS Artifact)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (color ?DS Black)
        (shape ?DS Cylinder)
        (located ?DS ?MAST)))))
      
    
; Fishing
(instance VesselEngagedInFishing RotrAttribute)
(documentation VesselEngagedInFishing EnglishWrittenLanguage "Any vessel fishing with
nets, lines, trawls or other fishing apparatus which restrict maneuverability,
but does not include a vessel fishing with trolling lines or other fishing
apparatus which do not restrict maneuverability")
(termFormat EnglishWrittenLanguage VesselEngagedInFishing "fishing vessel")  

(=>
  (and
    (instance ?VES FishingShip)
    (instance ?TRANS Translocation)
    (instance ?FISHING Fishing)
    (objectTransferred ?TRANS ?VES)
    (eventLocated ?FISHING ?VES))
  (holdsDuring (WhenFn ?TRANS)
    (attribute ?VES VesselEngagedInFishing)))



(=>
  (and
    (instance ?VES1 WaterVehicle)                 
    (attribute ?VES1 VesselEngagedInFishing)
    (instance ?VES2 WaterVehicle)                 
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)  
    (or
      (attribute ?VES2 NotUnderCommand)
      (attribute ?VES2 RestrictedInAbilityToManeuver)
      (attribute ?VES2 ConstrainedByDraft))
    (not
      (overtakingSituation ?VES2 ?VES1 ?TIMENOW)))
  (and
    (giveWayVessel ?VES1 ?VES2 ?TIMENOW)
    (standOnVessel ?VES2 ?VES1 ?TIMENOW)))

(=>
  (and
    (instance ?VES1 WaterVehicle)                
    (attribute ?VES1 VesselEngagedInFishing)      
    (instance ?VES2 WaterVehicle)                 
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)  
    (or
      (attribute ?VES2 SailingVessel)
      (attribute ?VES2 PowerDrivenVessel))       
    (not
      (overtakingSituation ?VES1 ?VES2 ?TIMENOW)))  
  (and
    (giveWayVessel ?VES2 ?VES1 ?TIMENOW)
    (standOnVessel ?VES1 ?VES2 ?TIMENOW)))

   
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES VesselEngagedInFishing)
    (attribute ?CO ShipCaptain)
    (or
      (and
        (instance ?NIGHT NightTime)
        (during (WhenFn ?TRANS) ?NIGHT))     
      (and
        (stoppingDistance ?VES ?SDQ)
        (equal ?SDQ (MeasureFn ?SD NauticalMile))
        (visibilityInMeteorology (WhereFn ?VES (BeginFn (WhenFn ?TRANS))) (WhenFn ?TRANS) ?VISQ)
        (equal ?VISQ (MeasureFn ?VIS NauticalMile))
        (lessThanOrEqualTo ?VIS ?SD)))
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?L1 ?L2 ?MAST) 
      (and
        (instance ?L1 TaskingLight)
        (instance ?L2 TaskingLight)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (or
          (and
            (color ?L1 Red)
            (color ?L2 White))
          (and
            (color ?L1 Green)
            (color ?L2 White)))
        (orientation ?L1 ?L2 Vertical)
        (orientation ?L1 ?L2 Above)
        (located ?L1 ?MAST)
        (located ?L2 ?MAST)))))
    
     
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES VesselEngagedInFishing)
    (attribute ?CO ShipCaptain)
    (instance ?DAY DayTime)
    (during (WhenFn ?TRANS) ?DAY)   
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?DS1 ?DS2 ?MAST) 
      (and
        (instance ?DS1 Artifact)
        (instance ?DS2 Artifact)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (color ?DS1 Black)
        (color ?DS2 Black)
        (shape ?DS1 Cone)           ; Needs to be upside down
        (shape ?DS2 Cone)
        (orientation ?DS1 ?DS2 On) 
        (located ?DS1 ?MAST)
        (located ?DS2 ?MAST)))))
    
    
; Sail
;; DISABLED: Sail is already a class in Mid-level-ontology.kif (subclass Sail Artifact); local (instance Sail Machine) clashed with it.
;(instance Sail Machine)
;(documentation Sail EnglishWrittenLanguage "an object used to convert wind
;power into motion.")
;(termFormat EnglishWrittenLanguage Sail "sail")  
    

(=>
  (and
    (instance ?VES Sailboat)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES))
  (exists (?SAIL)
    (and 
      (instance ?SAIL Sail)
      (hasPurpose ?SAIL
        (instrument ?TRANS ?SAIL)))))
    
       
; Sailing
(instance SailingVessel RotrAttribute)
(documentation SailingVessel EnglishWrittenLanguage "any vessel under sail 
provided that propelling machinery, if fitted, is not being used.")
(termFormat EnglishWrittenLanguage SailingVessel "sailing vessel")  

;; DISABLED: (not (exists ?MOT ...)) in the antecedent. Absence of a motor is never provable in an open world, so the rule cannot fire; SailingVessel is asserted per scenario.
;(=>
;  (and
;    (instance ?VES Sailboat)
;    (instance ?TRANS Translocation)
;    (objectTransferred ?TRANS ?VES)
;    (instance ?SAIL Sail)
;    (instrument ?TRANS ?SAIL)
;    (not
;      (exists (?MOT)
;        (and
;          (instance ?MOT Motor)
;          (instrument ?TRANS ?MOT)))))
;  (holdsDuring (WhenFn ?TRANS)
;    (attribute ?VES SailingVessel))) 

    
    
(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES SailingVessel)
    (attribute ?CO ShipCaptain)
    (or
      (and
        (instance ?NIGHT NightTime)
        (during (WhenFn ?TRANS) ?NIGHT))     
      (and
        (stoppingDistance ?VES ?SDQ)
        (equal ?SDQ (MeasureFn ?SD NauticalMile))
        (visibilityInMeteorology (WhereFn ?VES (BeginFn (WhenFn ?TRANS))) (WhenFn ?TRANS) ?VISQ)
        (equal ?VISQ (MeasureFn ?VIS NauticalMile))
        (lessThanOrEqualTo ?VIS ?SD)))
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?L1 ?L2 ?MAST) 
      (and
        (instance ?L1 TaskingLight)
        (instance ?L2 TaskingLight)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (color ?L1 Red)
        (color ?L2 Green)
        (orientation ?L1 ?L2 Vertical)
        (orientation ?L1 ?L2 Above)
        (located ?L1 ?MAST)
        (located ?L2 ?MAST)))))

(=> 
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (attribute ?VES VesselEngagedInFishing)
    (attribute ?CO ShipCaptain)
    (instance ?DAY DayTime)
    (during (WhenFn ?TRANS) ?DAY)   
    (responsibleFor ?TRANS ?CO))
  (holdsObligation ?CO
    (exists (?DS ?MAST) 
      (and
        (instance ?DS Artifact)
        (instance ?MAST Mast)
        (part ?MAST ?VES)
        (color ?DS Black)
        (shape ?DS Cone)            ; needs to be upside down
        (located ?DS ?MAST)))))

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 SailingVessel)
    (instance ?VES2 WaterVehicle)
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)
    (or
      (attribute ?VES2 NotUnderCommand)
      (attribute ?VES2 RestrictedInAbilityToManeuver)
      (attribute ?VES2 ConstrainedByDraft)
      (attribute ?VES2 VesselEngagedInFishing))
    (not
      (overtakingSituation ?VES2 ?VES1 ?TIMENOW)))
  (and
    (giveWayVessel ?VES1 ?VES2 ?TIMENOW)
    (standOnVessel ?VES2 ?VES1 ?TIMENOW)))

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 SailingVessel)
    (instance ?VES2 WaterVehicle)
    (attribute ?VES2 PowerDrivenVessel)
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)
    (not
      (overtakingSituation ?VES1 ?VES2 ?TIMENOW)))
  (and
    (giveWayVessel ?VES2 ?VES1 ?TIMENOW)
    (standOnVessel ?VES1 ?VES2 ?TIMENOW)))
    
; PowerDrivenVessel 
(instance PowerDrivenVessel RotrAttribute)
(documentation PowerDrivenVessel EnglishWrittenLanguage "Any maritime vessel
propelled by machinery")
(termFormat EnglishWrittenLanguage PowerDrivenVessel "power-driven vessel")  

(=>
  (and
    (instance ?VES WaterVehicle)
    (instance ?TRANS Translocation)
    (objectTransferred ?TRANS ?VES)
    (instance ?X Motor)
    (instrument ?TRANS ?X))
  (holdsDuring (WhenFn ?TRANS)
    (attribute ?VES PowerDrivenVessel)))



(=>
  (and
    (instance ?VES1 WaterVehicle)                     
    (attribute ?VES1 PowerDrivenVessel)
    (instance ?VES2 WaterVehicle)                     
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)      
    (or
      (attribute ?VES2 NotUnderCommand)
      (attribute ?VES2 RestrictedInAbilityToManeuver)
      (attribute ?VES2 ConstrainedByDraft)
      (attribute ?VES2 VesselEngagedInFishing)        
      (attribute ?VES2 SailingVessel))
    (not
      (overtakingSituation ?VES2 ?VES1 ?TIMENOW)))    
  (and
    (giveWayVessel ?VES1 ?VES2 ?TIMENOW)
    (standOnVessel ?VES2 ?VES1 ?TIMENOW)))
    


