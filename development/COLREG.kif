; courseOverGround
(instance courseOverGround TernaryPredicate)
(domain courseOverGround 1 WaterVehicle)
;(domain courseOverGround 2 PlaneAngleMeasure)
(domain courseOverGround 2 RealNumber)
;(domain courseOverGround 3 Translocation)
(domain courseOverGround 3 TimeInterval) 
(documentation courseOverGround EnglishWrittenLanguage "The direction in 
reference to the ground in which a vessel is actually following 
expressed as angular distance from north, usually from 000' at north, 
clockwise through 360' {from Bowditch}. (courseOverGround ?VEH 
?HEADING) means that the course heading of the vehicle is ?HEADING, 
in AngularDegrees, with the reference point of 000 degrees being true
North.")
(termFormat EnglishWrittenLanguage courseOverGround "course over ground")
(format EnglishWrittenLanguage courseOverGround "the course over ground of %1 is %2
at time %3")

; subrelation COG Trajectory 
; 3D - trajectory 
; 2D - COG
; Trajectory is a sequence of points in multi-dimensional space 
; vector is a time and list of points 


        
;; DISABLED: Skolem generator for COG; also used undefined ObjectTransferred and an unbound ?VES.
;(=>
;  (and 
;    (instance ?VES WaterVehicle)
;    (instance ?TRANS Translocation)
;    (ObjectTransferred ?TRANS ?W))
