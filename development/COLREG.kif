; rangeBetweenVessels
(instance rangeBetweenVessels QuaternaryPredicate)
(domain rangeBetweenVessels 1 WaterVehicle)
(domain rangeBetweenVessels 2 WaterVehicle)
;(domain rangeBetweenVessels 3 UnitOfLength) 
(domain rangeBetweenVessels 3 RealNumber)
(domain rangeBetweenVessels 4 TimeInterval)
(documentation rangeBetweenVessels EnglishWrittenLanguage "The range between 
VES1 and VES2 at time ?TIME.")
(termFormat EnglishWrittenLanguage rangeBetweenVessels "range between vessels")
(format EnglishWrittenLanguage rangeBetweenVessels "the range between %1 and %2 
is %3 at time %4")

(=>
  (and
    (instance ?V1 WaterVehicle)
    (instance ?V2 WaterVehicle) 
    (orientation ?V1 ?V2 Near)
    (instance ?TRANS1 Translocation)
    (instrument ?TRANS1 ?V1))
  (exists (?X ?DIST)
    (and
      (equal ?X (MeasureFn ?DIST NauticalMile))
      (distance ?V1 ?V2 ?X)
      (rangeBetweenVessels ?V1 ?V2 ?DIST (WhenFn ?TRANS1)))))


(subclass ColregsLights VehicleLight)
(documentation ColregsLights EnglishWrittenLanguage "Lights defined under
rule 21 of COLREGs.")
(termFormat EnglishWrittenLanguage ColregsLights "COLREGs lights")

(=>
  (and 
    (instance ?V WaterVehicle)
    (instance ?ATTR RotrAttribute)
    (attribute ?V ?ATTR))
  (exists (?L)
    (and
      (instance ?L ColregsLights)
      (located ?L ?V))))

(subclass MastHeadLight ColregsLights)
(documentation MastHeadLight EnglishWrittenLanguage "A white light placed over
the fore and aft centerline of the vessel showing an ubroken light over
an arc of the horizon of 225 degrees and so fixed as to show the light
from right ahead to 22.5 degrees abaft the beam on either side of
the vessel {from COLREGs}.")
(termFormat EnglishWrittenLanguage MastHeadLight "masthead light")

(=>
  (instance ?L MastHeadLight)
  (exists (?V ?M)
    (and
      (instance ?V WaterVehicle)
      (instance ?M Mast)
      (color ?L White)
      (part ?M ?V)
      (orientation ?L ?M On))))
      
(subclass TaskingLight ColregsLights)
(documentation TaskingLight EnglishWrittenLanguage "A light on the mast of a 
vessel whose color indicates the type of vessel.")
(termFormat EnglishWrittenLanguage TaskingLight "tasking light")

(=>
  (instance ?L TaskingLight)
  (exists (?V ?M)
    (and
      (instance ?V WaterVehicle)
      (instance ?M Mast)
      (part ?M ?V)
      (orientation ?L ?M On))))


(subclass SternLight ColregsLights)
(documentation SternLight EnglishWrittenLanguage "a white light placed as 
nearly as practicable at the stern showing an unbroken light over an 
arc of the horizon of 135 degrees and so fixed as to show the light 
67.5 degrees from right aft on each side of the vessel. {from COLREGs}")
(termFormat EnglishWrittenLanguage SternLight "stern light")


(=>
  (instance ?L SternLight)
  (exists (?V)
    (and
      (instance ?V WaterVehicle)
      (color ?L White)
      (part ?L
        (BackFn ?V)))))


(subclass PortSideLight ColregsLights)
(documentation PortSideLight EnglishWrittenLanguage "a red light on the port 
side showing an unbroken light over an arc of the horizon of 112.5 
degrees and so fixed as to show the light from right ahead to 22.5 
degrees abaft the beam on it respective side. {from COLREGs}")
(termFormat EnglishWrittenLanguage PortSideLight "port side light")

(=>
  (instance ?L PortSideLight)
  (exists (?V)
    (and
      (instance ?V WaterVehicle)
      (color ?L Red)
      (part ?L (FrontFn ?V))
      (orientation ?L ?V Left))))

(subclass StarboardSideLight ColregsLights)
(documentation StarboardSideLight EnglishWrittenLanguage "a green light on the 
starboard side showing an unbroken light over an arc of the horizon of 112.5 
degrees and so fixed as to show the light from right ahead to 22.5 
degrees abaft the beam on it respective side. {from COLREGs}")
(termFormat EnglishWrittenLanguage StarboardSideLight "starboard side light")

(=>
  (instance ?L StarboardSideLight)
  (exists (?V)
    (and
      (instance ?V WaterVehicle)
      (color ?L Green)
      (part ?L (FrontFn ?V))
      (orientation ?L ?V Right))))

(subclass TowingLight ColregsLights)
(documentation TowingLight EnglishWrittenLanguage "a yellow light having the 
same characteristics as a sternlight. {from COLREGs}")
(termFormat EnglishWrittenLanguage TowingLight "towing light")



(=>
  (instance ?L TowingLight)
  (exists (?V)
    (and
      (instance ?V WaterVehicle)
      (color ?L Yellow)
      (part ?L
        (BackFn ?V)))))


(subclass AllroundLight ColregsLights)
(documentation AllroundLight EnglishWrittenLanguage "a light showing an 
unbroken light over an arc of the horizon of 360 degrees. from {COLREGs}")
(termFormat EnglishWrittenLanguage AllroundLight "allround light")


(=>
  (instance ?L AllroundLight)
  (exists (?V ?M)
    (and
      (instance ?V WaterVehicle)
      (instance ?M Mast)
      (part ?M ?V)
      (orientation ?L ?M On))))

(subclass FlashingMaritimeVesselLight ColregsLights)
(documentation FlashingMaritimeVesselLight EnglishWrittenLanguage "a light flashing at regular
intervals at a frequency of 120 flashes or more per minute. {from COLREGs}")
(termFormat EnglishWrittenLanguage FlashingMaritimeVesselLight "flashing light")
