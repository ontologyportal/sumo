;    (or
;      (overtakingSituation ?VES1 ?VES2 ?TIMENOW)
;      (crossingSituation ?VES1 ?VES2 ?TIMENOW)
;      (headOnSituation ?VES1 ?VES2 ?TIMENOW)))
;  (noRotrSituation ?VES1 ?VES2 ?TIMENOW))


