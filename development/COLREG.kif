; CPA  
(instance cpa QuaternaryPredicate)
(domain cpa 1 WaterVehicle)
(domain cpa 2 WaterVehicle)
;(domain cpa 3 LengthMeasure)
(domain cpa 3 RealNumber)
(domain cpa 4 TimeInterval)  
(documentation cpa EnglishWrittenLanguage "An estimated point in which the 
distance between two objects, of which at least one is in motion, 
will reach its minimum value. {from Wiktionary}")
(termFormat EnglishWrittenLanguage cpa "Closest Point of Approach (CPA)")  
(format EnglishWrittenLanguage cpa "the CPA between %1 and %2 is %3 
at time %4")


(=>
  (and
    (instance ?V1 WaterVehicle)
    (instance ?V2 WaterVehicle) 
    (instance ?TRANS1 Translocation)
    (instance ?TRANS2 Translocation)
    (instrument ?TRANS1 ?V1)
    (instrument ?TRANS2 ?V2)
    (equal (WhenFn ?TRANS1) (WhenFn ?TRANS2))
    (equal ?TIME (WhenFn ?TRANS1))
    (instance ?UNIT UnitOfLength)
    (holdsDuring ?T2
      (distance ?V1 ?V2 (MeasureFn ?N ?UNIT)))
    (during ?T2 ?TIME)
    (not 
      (exists (?T3 ?N2)
        (and
          (holdsDuring ?T3
            (distance ?V1 ?V2 (MeasureFn ?N2 ?UNIT)))
          (during ?T3 ?TIME)
          (lessThan ?N2 ?N)))))
  (and
    (cpa ?V1 ?V2 ?N ?TIME)))
    
;(cpat ?V1 ?V2 ?T2 ?TIME)))
  

; CPAt  
(instance cpat QuaternaryPredicate)
(domain cpat 1 WaterVehicle)
(domain cpat 2 WaterVehicle)
;(domain cpat 3 TimePoint)
(domain cpat 3 RealNumber)
(domain cpat 4 TimeInterval)  
(documentation cpat EnglishWrittenLanguage "The time remaining until CPA
 is reached. (cpat ?V1 ?V2 ?TIME ?TIMENOW) means at ?TIMENOW, the
 time until cpa happens is ?TIME.")
(termFormat EnglishWrittenLanguage cpat "CPA time")  
(format EnglishWrittenLanguage cpat "the CPAt between %1 and %2 is %3 
at time %4")


(=>
  (cpa ?V1 ?V2 ?N ?TIME)
  (exists (?T2) 
    (cpat ?V1 ?V2 ?T2 ?TIME)))


; CPAThresh
(instance cpaThresh TernaryPredicate)
(domain cpaThresh 1 WaterVehicle)
(domain cpaThresh 2 Translocation)
(domain cpaThresh 3 RealNumber)  
(documentation cpaThresh EnglishWrittenLanguage "An input from a vessel's 
operator or captain pertaining to the relative confort level for how 
close they would allow other vessels to get to own vessel")
(termFormat EnglishWrittenLanguage cpaThresh "CPA Threshold")  
(format EnglishWrittenLanguage cpaThresh "the CPA threshold of %1 during 
translocation %2 is %3")

; CPAtThresh 
(instance cpaTThresh TernaryPredicate)
(domain cpaTThresh 1 WaterVehicle)
(domain cpaTThresh 2 Translocation)
(domain cpaTThresh 3 RealNumber)  
(documentation cpaTThresh EnglishWrittenLanguage "An input from a vessel's 
operator or captain pertaining to the threshold for how long until 
CPA is reached by another vessel")
(termFormat EnglishWrittenLanguage cpaTThresh "CPAt Threshold, set by the ship")  
(format EnglishWrittenLanguage cpaTThresh "the CPAt threshold of %1 during 
translocation %2 is %3")

(=>
  (and
    (instance ?V WaterVehicle)
    (instance ?T Translocation)
    (objectTransferred ?T ?V)
    (attribute ?CO Sailor)
    (attribute ?CO ShipCaptain)
    (responsibleFor ?T ?CO))
  (exists (?A ?B) 
    (and
      (cpaTThresh ?V ?T ?A)
      (cpaThresh ?V ?T ?B))))


; relativeBearingTo
(instance relativeBearingTo QuaternaryPredicate)
(domain relativeBearingTo 1 WaterVehicle)
(domain relativeBearingTo 2 WaterVehicle)
(domain relativeBearingTo 3 RealNumber)  
(domain relativeBearingTo 4 TimeInterval) 
(documentation relativeBearingTo EnglishWrittenLanguage "the relative bearing 
from VES1 to VES2 at time ?TIME. (relativeBearingTo ?VES1 ?VES2 
?REALNUM ?TIME) means the relative bearing from VES1 to VES2 is 
REALNUM at time ?TIME")
(termFormat EnglishWrittenLanguage relativeBearingTo "relative bearing to")  
(format EnglishWrittenLanguage relativeBearingTo "the relative bearing between 
%1 and %2 is %3 at time %4")

