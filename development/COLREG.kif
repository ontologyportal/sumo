; speedOverGround
(instance speedOverGround TernaryPredicate)
(domain speedOverGround 1 WaterVehicle)
;(domain speedOverGround 2 FunctionQuantity)
(domain speedOverGround 2 RealNumber)
;(domain speedOverGround 3 Translocation)
(domain speedOverGround 3 TimeInterval) 
(documentation speedOverGround EnglishWrittenLanguage "The speed in 
reference to the ground in which a vessel is moving.")
(termFormat EnglishWrittenLanguage speedOverGround "speed over ground")
(format EnglishWrittenLanguage speedOverGround "the speed over ground of %1 is %2
at time %3")

