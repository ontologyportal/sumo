; stoppingDistance
(instance stoppingDistance BinaryPredicate)
(domain stoppingDistance 1 Vehicle)
(domain stoppingDistance 2 LengthMeasure)
(documentation stoppingDistance EnglishWrittenLanguage "The distance it would 
take a vehicle to come to a complete stop without external interference.")
(termFormat EnglishWrittenLanguage stoppingDistance "stopping distance")
(format EnglishWrittenLanguage stoppingDistance "the stopping distance of %1 is 
%2")
;just for relations

(=>
  (and
    (stoppingDistance ?V ?SDQ)
    (equal ?SDQ (MeasureFn ?N1 NauticalMile))
    (instance ?STOP Stopping)
    (objectTransferred ?STOP ?V)
    (path ?STOP ?P)
    (distanceOnPath ?DQ ?P)
    (equal ?DQ (MeasureFn ?N2 NauticalMile)))
  (greaterThanOrEqualTo ?N2 ?N1))

; stoppingTime
(instance stoppingTime BinaryPredicate)
(domain stoppingTime 1 Vehicle)
(domain stoppingTime 2 TimeDuration)
(documentation stoppingTime EnglishWrittenLanguage "The time it would 
take a vehicle to come to a complete stop without external interference.")
(termFormat EnglishWrittenLanguage stoppingTime "stopping time")
(format EnglishWrittenLanguage stoppingTime "the stopping time of %1 is 
%2")


(=>
  (and
    (stoppingTime ?O ?STQ)
    (equal ?STQ (MeasureFn ?T1 MinuteDuration))
    (instance ?STOP Stopping)
    (objectTransferred ?STOP ?O)
    (duration (WhenFn ?STOP) ?DUR)
    (equal ?DUR (MeasureFn ?T2 MinuteDuration)))
  (greaterThanOrEqualTo ?T2 ?T1))



; standOnVessel 
(instance standOnVessel TernaryPredicate)
(instance standOnVessel Relation)
(domain standOnVessel 1 WaterVehicle)
(domain standOnVessel 2 WaterVehicle)
(domain standOnVessel 3 TimeInterval)
(documentation standOnVessel EnglishWrittenLanguage "Where one of two vessels 
is to keep out of the way the other shall keep her course and speed.
The latter vessel may however take action to avoid collision by her
maneuver alone, as soon as it becomes apparent to her that the vessel
required to keep out of the way is not taking appropriate action in
compliance with these Rules. When, from any cause, the vessel required 
to keep her course and speed finds herself so close that collision 
cannot be avoided by the action of the give-way vessel alone, she shall 
take such action as will best aid to avoid collision
(standOnVessel ?VES1 ?VES2) means VES1 stands on to VES2")
(termFormat EnglishWrittenLanguage standOnVessel "stand on vessel")
(format EnglishWrittenLanguage standOnVessel "vessel %1 stands on to vessel 
%2 at time %3")


; giveWayVessel 
(instance giveWayVessel TernaryPredicate)
(instance giveWayVessel Relation)
(domain giveWayVessel 1 WaterVehicle)
(domain giveWayVessel 2 WaterVehicle)
(domain giveWayVessel 3 TimeInterval)
(documentation giveWayVessel EnglishWrittenLanguage "Every vessel which is 
directed to keep out of the way of another vessel shall, so far as 
possible, take early and substantial action to keep well clear.
(giveWayVessel ?VES1 ?VES2) means VES1 shall give way to VES2")
(termFormat EnglishWrittenLanguage giveWayVessel "give way vessel")  
(format EnglishWrittenLanguage giveWayVessel "vessel %1 gives way to vessel 
%2 at time %3")
  
      
; mutuallyVisibleAtTime
(instance mutuallyVisibleAtTime TernaryPredicate)
(instance mutuallyVisibleAtTime Relation)
(domain mutuallyVisibleAtTime 1 WaterVehicle)
(domain mutuallyVisibleAtTime 2 WaterVehicle)
(domain mutuallyVisibleAtTime 3 TimeInterval)
(format EnglishWrittenLanguage mutuallyVisibleAtTime "vessel %1 and vessel %2 are %n mutually visible at time %3")
(documentation mutuallyVisibleAtTime EnglishWrittenLanguage 
"(mutuallyVisibleAtTime ?OBJ1 ?OB2 ?TIME) means that ?OBJ1 and ?OBJ2 
are in sight of eachother during time interval ?TIME")
(termFormat EnglishWrittenLanguage mutuallyVisibleAtTime "mutually visible 
at time")

(=>
  (mutuallyVisibleAtTime ?V1 ?V2 ?TIMENOW)
  (mutuallyVisibleAtTime ?V2 ?V1 ?TIMENOW))
  
; reciprocalCourse
(instance reciprocalCourse TernaryPredicate)
(instance reciprocalCourse Relation)
(domain reciprocalCourse 1 WaterVehicle)
(domain reciprocalCourse 2 WaterVehicle)
(domain reciprocalCourse 3 TimeInterval)
(format EnglishWrittenLanguage reciprocalCourse "vessel %1 is %n on a reciprocal course to vessel %2 at time %3")
(documentation reciprocalCourse EnglishWrittenLanguage "(reciprocalCourse 
?OBJ1 ?OBJ2) means the direction OBJ1 is heading is nearly reciprocal 
to the direction OBJ2 is heading. If OBJ1 is on course 090 True, then 
OBJ2 is on course 270 True")
(termFormat EnglishWrittenLanguage reciprocalCourse "reciprocal course")  
 

  

(=>
  (and
    (instance ?V1 WaterVehicle)
    (attribute ?V1 OwnVessel)
    (courseOverGround ?V1 ?COG1 ?TIMENOW)
    (instance ?V2 WaterVehicle)
    (attribute ?V2 TargetVessel)
    (courseOverGround ?V2 ?COG2 ?TIMENOW)
    (equal ?RECIP (RemainderFn (AdditionFn ?COG2 180.0) 360.0))
    (equal ?ZERO (SubtractionFn ?RECIP ?COG1))
    (greaterThanOrEqualTo ?ZERO -15.0)
    (lessThanOrEqualTo ?ZERO 15.0))
  (reciprocalCourse ?V1 ?V2 ?TIMENOW))


(=>
  (and
    (instance ?V1 WaterVehicle)
    (attribute ?V1 OwnVessel)
    (courseOverGround ?V1 ?COG1 ?TIMENOW)
    (instance ?V2 WaterVehicle)
    (attribute ?V2 TargetVessel)
    (courseOverGround ?V2 ?COG2 ?TIMENOW)
    (equal ?RECIP (RemainderFn (AdditionFn ?COG2 180.0) 360.0))
    (equal ?ZERO (SubtractionFn ?RECIP ?COG1))
    (or
      (lessThanOrEqualTo ?ZERO -16.0)
      (greaterThanOrEqualTo ?ZERO 16.0)))
  (not (reciprocalCourse ?V1 ?V2 ?TIMENOW)))
   
    
; similarCourse
(instance similarCourse TernaryPredicate)
(instance similarCourse Relation)
(domain similarCourse 1 WaterVehicle)
(domain similarCourse 2 WaterVehicle)
(domain similarCourse 3 TimeInterval)
(format EnglishWrittenLanguage similarCourse "vessel %1 is %n on a similar course to vessel %2 at time %3")
(documentation similarCourse EnglishWrittenLanguage "(similarCourse
?OBJ1 ?OBJ2 ?TIME) means the course over ground of OBJ1 is within 10
degrees of the course over ground of OBJ2 at time ?TIME.")
(termFormat EnglishWrittenLanguage similarCourse "similar course")

  
(=>
  (and
    (instance ?V1 WaterVehicle)
    (attribute ?V1 OwnVessel)
    (courseOverGround ?V1 ?COG1 ?TIMENOW)
    (instance ?V2 WaterVehicle)
    (attribute ?V2 TargetVessel)
    (courseOverGround ?V2 ?COG2 ?TIMENOW)
    (equal ?ZERO (SubtractionFn ?COG1 ?COG2))
    (or
      (and
        (greaterThanOrEqualTo ?ZERO -10.0)
        (lessThanOrEqualTo ?ZERO 10.0))
      (or
        (greaterThanOrEqualTo ?ZERO 350.0)
        (lessThanOrEqualTo ?ZERO -350.0))))
  (similarCourse ?V1 ?V2 ?TIMENOW))


  
(=>
  (and
    (instance ?V1 WaterVehicle)
    (attribute ?V1 OwnVessel)
    (courseOverGround ?V1 ?COG1 ?TIMENOW)
    (instance ?V2 WaterVehicle)
    (attribute ?V2 TargetVessel)
    (courseOverGround ?V2 ?COG2 ?TIMENOW)
    (equal ?ZERO (SubtractionFn ?COG1 ?COG2))
    (or
      (and
        (greaterThanOrEqualTo ?ZERO -349.0)
        (lessThanOrEqualTo ?ZERO -11.0))
      (and
        (greaterThanOrEqualTo ?ZERO 11.0)
        (lessThanOrEqualTo ?ZERO 349.0))))
  (not (similarCourse ?V1 ?V2 ?TIMENOW)))
    
     
; concurrentTranslocationAtTime 
(instance concurrentTranslocationAtTime TernaryPredicate)
(instance concurrentTranslocationAtTime Relation)
(domain concurrentTranslocationAtTime 1 WaterVehicle)
(domain concurrentTranslocationAtTime 2 WaterVehicle)
(domain concurrentTranslocationAtTime 3 TimeInterval)
(documentation concurrentTranslocationAtTime EnglishWrittenLanguage 
"(concurrentTranslocationAtTime ?OBJ1 ?OB2 ?TIME) means that ?OBJ1 and ?OBJ2 
are transiting at the same time ?TIME")
(termFormat EnglishWrittenLanguage concurrentTranslocationAtTime "concurrent
translocation at time")
(format EnglishWrittenLanguage concurrentTranslocationAtTime "vessel %1 and 
vessel %2 are concurrently translocating at time %3") 

(=>
  (concurrentTranslocationAtTime ?V1 ?V2 ?TIMENOW)
  (concurrentTranslocationAtTime ?V2 ?V1 ?TIMENOW))

  
(=>
  (and
    (instance ?V1 WaterVehicle)
    (instance ?V2 WaterVehicle) 
    (instance ?TRANS1 Translocation)
    (instance ?TRANS2 Translocation)
    (objectTransferred ?TRANS1 ?V1)
    (objectTransferred ?TRANS2 ?V2)
    (orientation ?V1 ?V2 Near)
    (equal 
      (WhenFn ?TRANS1) 
      (WhenFn ?TRANS2)))
  (concurrentTranslocationAtTime ?V1 ?V2 (WhenFn ?TRANS1)))
  

; isStarboardOf
(instance isStarboardOf TernaryPredicate)
(instance isStarboardOf Relation)
(domain isStarboardOf 1 WaterVehicle)
(domain isStarboardOf 2 WaterVehicle)
(domain isStarboardOf 3 TimeInterval)
(documentation isStarboardOf EnglishWrittenLanguage "(isStarboardOf ?VES2 ?VES1)
returns true if the relative bearing from VES1 to VES2 is greater than 0 
and less than 112.5, meaning VES2 is to starboard of VES1")
(termFormat EnglishWrittenLanguage isStarboardOf "is starboard of")  
(format EnglishWrittenLanguage isStarboardOf "vessel %1 is starboard of vessel 
%2 at time %3") 

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 OwnVessel)
    (instance ?VES2 WaterVehicle)
    (attribute ?VES2 TargetVessel)
    (relativeBearingTo ?VES1 ?VES2 ?RELBEAR ?TIMENOW)
    (greaterThan ?RELBEAR 0.0)
    (lessThan ?RELBEAR 112.0))
  (isStarboardOf ?VES2 ?VES1 ?TIMENOW))

;(greaterThan ?RELBEAR 15)

  
(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 OwnVessel)
    (instance ?VES2 WaterVehicle)
    (attribute ?VES2 TargetVessel)
    (relativeBearingTo ?VES1 ?VES2 ?RELBEAR ?TIMENOW)
    (or
      (lessThanOrEqualTo ?RELBEAR 0.0)
      (greaterThanOrEqualTo ?RELBEAR 112.0)))
  (not
    (isStarboardOf ?VES2 ?VES1 ?TIMENOW)))

;(lessThanOrEqualTo ?RELBEAR 15)

    
; isPortOf
(instance isPortOf TernaryPredicate)
(instance isPortOf Relation)
(domain isPortOf 1 WaterVehicle)
(domain isPortOf 2 WaterVehicle)
(domain isPortOf 3 TimeInterval)
(documentation isPortOf EnglishWrittenLanguage "(isPortOf ?VES2 ?VES1)
returns true if the relative bearing from VES1 to VES2 is greater than 
247.5 and less than 360, meaning VES2 is to port of VES1")
(termFormat EnglishWrittenLanguage isPortOf "is port of")  
(format EnglishWrittenLanguage isPortOf "vessel %1 is port of vessel %2 at time %3") 

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 OwnVessel)
    (instance ?VES2 WaterVehicle)
    (attribute ?VES2 TargetVessel)
    (relativeBearingTo ?VES1 ?VES2 ?RELBEAR ?TIMENOW)
    (greaterThan ?RELBEAR 247.0)
    (lessThan ?RELBEAR 360.0))
  (isPortOf ?VES2 ?VES1 ?TIMENOW))

;(lessThan ?RELBEAR 345)
  
(=>
  (and
    (instance ?VES1 WaterVehicle)
    (attribute ?VES1 OwnVessel)
    (instance ?VES2 WaterVehicle)
    (attribute ?VES2 TargetVessel)
    (relativeBearingTo ?VES1 ?VES2 ?RELBEAR ?TIMENOW)
    (or
      (lessThanOrEqualTo ?RELBEAR 247.0)
      (greaterThanOrEqualTo ?RELBEAR 360.0)))
  (not
    (isPortOf ?VES2 ?VES1 ?TIMENOW)))


    
; showingStarboardAspect
(instance showingStarboardAspect TernaryPredicate)
(instance showingStarboardAspect Relation)
(domain showingStarboardAspect 1 WaterVehicle)
(domain showingStarboardAspect 2 WaterVehicle)
(domain showingStarboardAspect 3 TimeInterval)
(documentation showingStarboardAspect EnglishWrittenLanguage "(showingStarboardAspect
 ?VES2 ?VES1 ?TIME) returns true if VES1 can see VES2's port bow")
(termFormat EnglishWrittenLanguage showingStarboardAspect "showing starboard aspect")  
(format EnglishWrittenLanguage showingStarboardAspect "vessel %1 is showing her 
starboard aspect to vessel %2 at time %3") 

(=>
  (and
    (instance ?V1 WaterVehicle)
    (attribute ?V1 OwnVessel)
    (courseOverGround ?V1 ?COG1 ?TIMENOW)
    (instance ?V2 WaterVehicle)
    (attribute ?V2 TargetVessel)
    (courseOverGround ?V2 ?COG2 ?TIMENOW)
    (relativeBearingTo ?V1 ?V2 ?RELBEAR ?TIMENOW)
    (equal ?TB 
      (RemainderFn 
        (AdditionFn ?COG1 ?RELBEAR) 360.0))
    (equal ?TA 
      (RemainderFn
        (AdditionFn 
          (SubtractionFn ?TB ?COG2) 360.0) 360.0))
    (greaterThanOrEqualTo ?TA 180.0)
    (lessThanOrEqualTo ?TA 292.0))
  (and
    (showingStarboardAspect ?V2 ?V1 ?TIMENOW)
    (not (showingPortAspect ?V2 ?V1 ?TIMENOW))))


; showingPortAspect
(instance showingPortAspect TernaryPredicate)
(instance showingPortAspect Relation)
(domain showingPortAspect 1 WaterVehicle)
(domain showingPortAspect 2 WaterVehicle)
(domain showingPortAspect 3 TimeInterval)
(documentation showingPortAspect EnglishWrittenLanguage "(showingPortAspect
 ?VES2 ?VES1 ?TIME) returns true if VES1 can see VES2's port bow")
(termFormat EnglishWrittenLanguage showingPortAspect "showing port aspect")  
(format EnglishWrittenLanguage showingPortAspect "vessel %1 is showing her port aspect
to vessel %2 at time %3") 

(=>
  (and
    (instance ?V1 WaterVehicle)
    (attribute ?V1 OwnVessel)
    (courseOverGround ?V1 ?COG1 ?TIMENOW)
    (instance ?V2 WaterVehicle)
    (attribute ?V2 TargetVessel)
    (courseOverGround ?V2 ?COG2 ?TIMENOW)
    (relativeBearingTo ?V1 ?V2 ?RELBEAR ?TIMENOW)
    (equal ?TB 
      (RemainderFn 
        (AdditionFn ?COG1 ?RELBEAR) 360.0))
    (equal ?TA 
      (RemainderFn
        (AdditionFn 
          (SubtractionFn ?TB ?COG2) 360.0) 360.0))
    (greaterThanOrEqualTo ?TA 68.0)
    (lessThanOrEqualTo ?TA 179.0))
  (and
    (showingPortAspect ?V2 ?V1 ?TIMENOW)
    (not (showingStarboardAspect ?V2 ?V1 ?TIMENOW))))
    
; showingSternAspect
(instance showingSternAspect TernaryPredicate)
(instance showingSternAspect Relation)
(domain showingSternAspect 1 WaterVehicle)
(domain showingSternAspect 2 WaterVehicle)
(domain showingSternAspect 3 TimeInterval)
(documentation showingSternAspect EnglishWrittenLanguage "(showingSternAspect
 ?VES2 ?VES1 ?TIME) returns true if VES1 can see VES2's stern")
(termFormat EnglishWrittenLanguage showingSternAspect "showing stern aspect")  
(format EnglishWrittenLanguage showingSternAspect "vessel %1 is showing her stern
to vessel %2 at time %3") 

(=>
  (and
    (instance ?V1 WaterVehicle)
    (attribute ?V1 OwnVessel)
    (courseOverGround ?V1 ?COG1 ?TIMENOW)
    (instance ?V2 WaterVehicle)
    (attribute ?V2 TargetVessel)
    (courseOverGround ?V2 ?COG2 ?TIMENOW)
    (relativeBearingTo ?V1 ?V2 ?RELBEAR ?TIMENOW)
    (equal ?TB 
      (RemainderFn 
        (AdditionFn ?COG1 ?RELBEAR) 360.0))
    (equal ?TA 
      (RemainderFn
        (AdditionFn 
          (SubtractionFn ?TB ?COG2) 360.0) 360.0))
    (or
      (greaterThanOrEqualTo ?TA 293.0)
      (lessThanOrEqualTo ?TA 67.0)))
  (and
    (showingSternAspect ?V2 ?V1 ?TIMENOW)
    (not (showingStarboardAspect ?V2 ?V1 ?TIMENOW))
    (not (showingPortAspect ?V2 ?V1 ?TIMENOW)))) 


    
; riskOfCollision 
(instance riskOfCollision TernaryPredicate)
(instance riskOfCollision Relation)
(domain riskOfCollision 1 WaterVehicle)
(domain riskOfCollision 2 WaterVehicle)
(domain riskOfCollision 3 TimeInterval)
(documentation riskOfCollision EnglishWrittenLanguage "Define Risk of Collision")
(termFormat EnglishWrittenLanguage riskOfCollision "risk of collision") 
(format EnglishWrittenLanguage riskOfCollision "there is risk of collision 
between %1 and %2 at time %3") 
  
(=> 
  (and
    (instance ?PDV1 WaterVehicle)
    (attribute ?PDV1 OwnVessel)
    (instance ?PDV2 WaterVehicle)
    (attribute ?PDV2 TargetVessel)
    (cpaThresh ?PDV1 ?TRANS1 ?CPAMIN)
    (cpaTThresh ?PDV1 ?TRANS1 ?CPATMIN)
    (cpa ?PDV1 ?PDV2 ?CPA ?TIMENOW)          
    (cpat ?PDV1 ?PDV2 ?CPAT ?TIMENOW)       
    (lessThanOrEqualTo ?CPA ?CPAMIN)         
    (lessThanOrEqualTo ?CPAT ?CPATMIN)            
    (greaterThanOrEqualTo ?CPAT 0.0))               
  (riskOfCollision ?PDV1 ?PDV2 ?TIMENOW))

(=> 
  (and
    (instance ?PDV1 WaterVehicle)
    (attribute ?PDV1 OwnVessel)
    (instance ?PDV2 WaterVehicle)
    (attribute ?PDV2 TargetVessel)
    (cpaThresh ?PDV1 ?TRANS1 ?CPAMIN)
    (cpaTThresh ?PDV1 ?TRANS1 ?CPATMIN)
    (cpa ?PDV1 ?PDV2 ?CPA ?TIMENOW)          
    (cpat ?PDV1 ?PDV2 ?CPAT ?TIMENOW)       
    (or
      (greaterThan ?CPA ?CPAMIN)                   
      (greaterThan ?CPAT ?CPATMIN)                 
      (lessThan ?CPAT 0.0)))                   
  (not
    (riskOfCollision ?PDV1 ?PDV2 ?TIMENOW)))
  
(=>
  (and
    (instance ?PDV1 WaterVehicle)
    (attribute ?PDV1 OwnVessel)
    (instance ?PDV2 WaterVehicle)
    (attribute ?PDV2 TargetVessel)
    (riskOfCollision ?PDV1 ?PDV2 ?TIMENOW))
  (riskOfCollision ?PDV2 ?PDV1 ?TIMENOW))
    
  
  
(=>
  (riskOfCollision ?V1 ?V2 ?T)
  (holdsDuring ?T 
    (maritimeHazard ?V1 ?V2)))
  
     
(subclass MaritimeVesselManeuver Translocation)
(documentation MaritimeVesselManeuver EnglishWrittenLanguage "A class of 
actions a maritime may take.")
(termFormat EnglishWrittenLanguage MaritimeVesselManeuver "maritime vessel 
maneuver") 

;; DISABLED: Skolem generator: every vessel translocation creates a MaritimeVesselManeuver, which is itself a Translocation, so it loops. The exists also had two bodies without and.
;(=>
;  (and
;    (instance ?V WaterVehicle)
;    (instance ?T Translocation)
;    (objectTransferred ?T ?V))
;  (exists (?A)
;    (instance ?A MaritimeVesselManeuver)
;    (objectTransferred ?A ?V)))


(subclass SpeedChange MaritimeVesselManeuver)
(documentation SpeedChange EnglishWrittenLanguage "The process of an object
changing the speed of it's motion.")
(termFormat EnglishWrittenLanguage SpeedChange "speed change")



(=>
  (and
    (instance ?OBJ Object)
    (instance ?PROC Motion) 
    (objectTransferred ?PROC ?OBJ)
    (during ?T1 (WhenFn ?PROC))
    (during ?T2 (WhenFn ?PROC))
    (not (equal ?T1 ?T2))
    (holdsDuring ?T1
      (measure ?OBJ (SpeedFn ?L ?T)))
    (holdsDuring ?T2
      (measure ?OBJ (SpeedFn ?L2 ?T)))
    (not (equal ?L ?L2)))
  (instance ?PROC SpeedChange))

     
(=>
  (and 
    (instance ?PROC SpeedChange)
    (instance ?OBJ Object)
    (objectTransferred ?PROC ?OBJ))
  (exists (?T ?T1 ?T2 ?L ?L2)
    (and
      (during ?T1 (WhenFn ?PROC))
      (during ?T2 (WhenFn ?PROC))
      (not (equal ?T1 ?T2))
      (holdsDuring ?T1
        (measure ?OBJ (SpeedFn ?L ?T)))
      (holdsDuring ?T2
        (measure ?OBJ (SpeedFn ?L2 ?T)))
      (not (equal ?L ?L2)))))

      
(=> 
  (and
    (instance ?V WaterVehicle)
    (instance ?S SpeedChange)
    (objectTransferred ?S ?V))
  (exists (?A) 
    (and
      (or
        (and
          (instance ?A Accelerating)
          (not (instance ?A Decelerating)))
        (and
          (instance ?A Decelerating)
          (not (instance ?A Accelerating))))
      (objectTransferred ?A ?V))))


(subclass AlterCourseStarboard MaritimeVesselManeuver)
(documentation AlterCourseStarboard EnglishWrittenLanguage "The act of altering
a vessel's course to starboard")
(termFormat EnglishWrittenLanguage AlterCourseStarboard "alter course to 
starboard")  

(=>
  (and
    (instance ?VES WaterVehicle)
    (instance ?MVM AlterCourseStarboard)
    (objectTransferred ?MVM ?VES))
  (exists (?TURN)
    (and
      (instance ?TURN DirectionChange)
      (patient ?TURN ?VES))))


(subclass AlterCoursePort MaritimeVesselManeuver)
(documentation AlterCoursePort EnglishWrittenLanguage "The act of altering a 
vessel's course to port.")
(termFormat EnglishWrittenLanguage AlterCoursePort "alter course to 
port")  


(=>
  (and
    (instance ?VES WaterVehicle)
    (instance ?MVM AlterCoursePort)
    (objectTransferred ?MVM ?VES))
  (exists (?TURN)
    (and
      (instance ?TURN DirectionChange)
      (objectTransferred ?TURN ?VES))))


      
(subclass SlowDown MaritimeVesselManeuver)
(documentation SlowDown EnglishWrittenLanguage "The act of reducing a
vessel's speed so as to avoid collision or allow more time to assess
the situation (COLREGs Rule 8(e)).")
(termFormat EnglishWrittenLanguage SlowDown "slow down")

; *************************************************************
; ***** Accelerating exists... but not in the consequent ******
; *************************************************************

; (subclass SpeedUp MaritimeVesselManeuver)
; (documentation SpeedUp EnglishWrittenLanguage "The process of an object
; increasing the speed of it's motion.")
; (termFormat EnglishWrittenLanguage SpeedUp "speed up") 
  
(=>
  (and
    (instance ?OBJ Object)
    (instance ?PROC Motion) 
    (objectTransferred ?PROC ?OBJ)
    (during ?T1 (WhenFn ?PROC))
    (during ?T2 (WhenFn ?PROC))
    (before ?T1 ?T2)
    (holdsDuring ?T1
      (measure ?OBJ (SpeedFn ?L ?T)))
    (holdsDuring ?T2
      (measure ?OBJ (SpeedFn ?L2 ?T)))
    (greaterThan ?L2 ?L))
  (instance ?PROC Accelerating))
  
 
;(=>
;  (and 
;    (instance ?PROC SpeedUp)
;    (instance ?OBJ Object)
;    (objectTransferred ?PROC ?OBJ))
;  (exists (?T ?T1 ?T2 ?L ?L2)
;    (and
;      (during ?T1 (WhenFn ?PROC))
;      (during ?T2 (WhenFn ?PROC))
;      (before ?T1 ?T2)
;      (holdsDuring ?T1
;        (measure ?OBJ (SpeedFn ?L ?T)))
;      (holdsDuring ?T2
;        (measure ?OBJ (SpeedFn ?L2 ?T)))
;      (greaterThan ?L2 ?L))))
  


; *************************************************************
; ***** Decelerating exists... but not defined like this *****
; *************************************************************
   
;(subclass SlowDown SpeedChange)
;(documentation SlowDown EnglishWrittenLanguage "The process of an object
;decreasing the speed of it's motion.")
;(termFormat EnglishWrittenLanguage SlowDown "slow down") 
  
(=>
  (and
    (instance ?OBJ Object)
    (instance ?PROC Motion) 
    (objectTransferred ?PROC ?OBJ)
    (during ?T1 (WhenFn ?PROC))
    (during ?T2 (WhenFn ?PROC))
    (before ?T1 ?T2)
    (not (equal ?T1 ?T2))
    (holdsDuring ?T1
      (measure ?OBJ (SpeedFn ?L ?T)))
    (holdsDuring ?T2
      (measure ?OBJ (SpeedFn ?L2 ?T)))
    (lessThan ?L2 ?L))
  (instance ?PROC Decelerating))


;(=>
;  (and 
;    (instance ?PROC SlowDown)
;    (instance ?OBJ Object)
;    (objectTransferred ?PROC ?OBJ))
;  (exists (?T ?T1 ?T2 ?L ?L2)
;    (and
;      (during ?T1 (WhenFn ?PROC))
;      (during ?T2 (WhenFn ?PROC))
;      (before ?T1 ?T2)
;      (holdsDuring ?T1
;        (measure ?OBJ (SpeedFn ?L ?T)))
;      (holdsDuring ?T2
;        (measure ?OBJ (SpeedFn ?L2 ?T)))
;      (lessThan ?L2 ?L)))) 

(subclass BackDownEngines MaritimeVesselManeuver)
(documentation BackDownEngines EnglishWrittenLanguage "The act of turning a 
vessel's engines in the astern direction. This does not necessarily
indicate movement backwards.")
(termFormat EnglishWrittenLanguage BackDownEngines "back down engines")  

(=>
  (and
    (instance ?VES WaterVehicle)
    (instance ?MVM BackDownEngines)
    (agent ?MVM ?VES))
  (exists (?BACK)
    (and
      (instance ?BACK Reversing)
      (patient ?BACK ?VES))))


(subclass MaintainCourseAndSpeed MaritimeVesselManeuver)
(documentation MaintainCourseAndSpeed EnglishWrittenLanguage "The vessel is
not to adjust course or speed")
(termFormat EnglishWrittenLanguage MaintainCourseAndSpeed "maintain course
and speed")  

(=>
  (and
    (instance ?VES WaterVehicle)
    (instance ?MVM MaintainCourseAndSpeed)
    (agent ?MVM ?VES))
  (not 
    (exists (?TURN)
      (and
        (instance ?TURN DirectionChange)
        (patient ?TURN ?VES)))))
        
(=>
  (and
    (instance ?VES WaterVehicle)
    (instance ?MVM MaintainCourseAndSpeed)
    (agent ?MVM ?VES))
  (not 
    (exists (?SPEED)
      (and
        (instance ?SPEED SpeedChange)
        (objectTransferred ?SPEED ?VES)))))

(subclass PassPortToPort MaritimeVesselManeuver)
(documentation PassPortToPort EnglishWrittenLanguage "Indicates that two vessels
meeting should pass with the other on her port side.")
(termFormat EnglishWrittenLanguage PassPortToPort "pass port to port")  

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (instance ?PTP PassPortToPort)
    (agent ?PTP ?VES1))
  (exists (?VES2)
    (and
      (instance ?VES2 WaterVehicle)
      (orientation ?VES1 ?VES2 Left)
      (orientation ?VES2 ?VES1 Left))))



(subclass PassAtASafeDistance MaritimeVesselManeuver)
(documentation PassAtASafeDistance EnglishWrittenLanguage "Indicates one vessel
should pass another at a safe distance.")
(termFormat EnglishWrittenLanguage PassAtASafeDistance "pass at a safe 
distance")  

(=>
  (and
    (instance ?VES1 WaterVehicle)
    (instance ?SAFE PassAtASafeDistance)
    (agent ?SAFE ?VES1))
  (exists (?VES2)
    (and
      (instance ?VES2 WaterVehicle)
      (not (orientation ?VES1 ?VES2 Near)))))

  
; obligatoryNextAction 
(instance obligatoryNextAction QuaternaryPredicate)
(instance obligatoryNextAction Relation)
(domain obligatoryNextAction 1 WaterVehicle)
(domain obligatoryNextAction 2 WaterVehicle)
(domainSubclass obligatoryNextAction 3 Translocation)
(domain obligatoryNextAction 4 TimeInterval)
(documentation obligatoryNextAction EnglishWrittenLanguage "A predicate to 
indicate the obligatory action for a vessel that is meeting another
vessel where a COLREGs situation exists")
(termFormat EnglishWrittenLanguage obligatoryNextAction "obligatory next action")
(format EnglishWrittenLanguage obligatoryNextAction "the obligatory next action 
of %1 in relation to %2 is %3 at time %4")

;; DISABLED: Skolem generator: obligatoryNextAction with unknown ?Y ?Z. The situation rules already give concrete actions.
;(=>
;  (or
;    (headOnSituation ?V1 ?V2 ?TIME)
;    (crossingSituation ?V1 ?V2 ?TIME)
;    (overtakingSituation ?V1 ?V2 ?TIME)
;    (overtakingSituation ?V2 ?V1 ?TIME))
;  (exists (?Y ?Z)
;    (and
;      (obligatoryNextAction ?V1 ?V2 ?Y ?TIME)
;      (obligatoryNextAction ?V2 ?V1 ?Z ?TIME))))


  
; *******************************************************************
; *************************** RULES *********************************
; *******************************************************************    

  
; headOnSituation 
(instance headOnSituation TernaryPredicate)
(instance headOnSituation Relation)
(domain headOnSituation 1 WaterVehicle)
(domain headOnSituation 2 WaterVehicle)
(domain headOnSituation 3 TimeInterval)
(documentation headOnSituation EnglishWrittenLanguage "When two power-driven vessels 
are meeting on reciprocal or nearly reciprocal courses so as to involve 
risk of collision each shall alter her course to starboard so that each 
shall pass on the port side of the other. When a vessel is in any doubt 
as to whether such a situation exists she shall assume that it does exist 
and act accordingly.")
(termFormat EnglishWrittenLanguage headOnSituation "head-on situation")  
(format EnglishWrittenLanguage headOnSituation "there is a head on situation 
between %1 and %2 at time %3")


(=>
  (and
    (instance ?PDV1 WaterVehicle)
    (attribute ?PDV1 PowerDrivenVessel)
    (attribute ?PDV1 OwnVessel)
    (instance ?PDV2 WaterVehicle)
    (attribute ?PDV2 PowerDrivenVessel)
    (attribute ?PDV2 TargetVessel)  
    (mutuallyVisibleAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (concurrentTranslocationAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (reciprocalCourse ?PDV1 ?PDV2 ?TIMENOW)
    (riskOfCollision ?PDV1 ?PDV2 ?TIMENOW))
  (and
    (headOnSituation ?PDV1 ?PDV2 ?TIMENOW)
    (giveWayVessel ?PDV1 ?PDV2 ?TIMENOW)
    (giveWayVessel ?PDV2 ?PDV1 ?TIMENOW)
    (obligatoryNextAction ?PDV1 ?PDV2 AlterCourseStarboard ?TIMENOW)
    (obligatoryNextAction ?PDV2 ?PDV1 AlterCourseStarboard ?TIMENOW)
    (obligatoryNextAction ?PDV1 ?PDV2 PassPortToPort ?TIMENOW)
    (obligatoryNextAction ?PDV2 ?PDV1 PassPortToPort ?TIMENOW)))


(=>
  (and
    (instance ?PDV1 WaterVehicle)
    (attribute ?PDV1 OwnVessel)
    (instance ?PDV2 WaterVehicle)
    (attribute ?PDV2 TargetVessel)  
    (mutuallyVisibleAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (concurrentTranslocationAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (or
      (not (attribute ?PDV2 PowerDrivenVessel))
      (not (attribute ?PDV1 PowerDrivenVessel))
      (not (reciprocalCourse ?PDV1 ?PDV2 ?TIMENOW))
      (not (riskOfCollision ?PDV1 ?PDV2 ?TIMENOW))))
  (not (headOnSituation ?PDV1 ?PDV2 ?TIMENOW)))

    
; crossingSituation
(instance crossingSituation TernaryPredicate)
(instance crossingSituation Relation)
(domain crossingSituation 1 WaterVehicle)
(domain crossingSituation 2 WaterVehicle)
(domain crossingSituation 3 TimeInterval)
(documentation crossingSituation EnglishWrittenLanguage "When two power-driven vessels are 
crossing so as to involve risk of collision, the vessel which has the 
other on her own starboard side shall keep out of the way and shall, 
if the circumstances of the case admit, avoid crossing ahead of the 
other vessel. (crossingSituation ?PDV1 ?PDV2 ?TIMENOW) means there
is a crossing situation and ?PDV1 is the give-way vessel.")
(termFormat EnglishWrittenLanguage crossingSituation "crossing situation") 
(format EnglishWrittenLanguage crossingSituation "there is a crossing 
situation between %1 and %2 at time %3")


(=>
  (and
    (instance ?PDV1 WaterVehicle)
    (attribute ?PDV1 PowerDrivenVessel)
    (attribute ?PDV1 OwnVessel)
    (instance ?PDV2 WaterVehicle)
    (attribute ?PDV2 PowerDrivenVessel)
    (attribute ?PDV2 TargetVessel)  
    (isStarboardOf ?PDV2 ?PDV1 ?TIMENOW)
    (showingPortAspect ?PDV2 ?PDV1 ?TIMENOW)
    (mutuallyVisibleAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (concurrentTranslocationAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (riskOfCollision ?PDV1 ?PDV2 ?TIMENOW)
    (not (reciprocalCourse ?PDV1 ?PDV2 ?TIMENOW))
    (not (similarCourse ?PDV1 ?PDV2 ?TIMENOW)))
  (and
    (crossingSituation ?PDV1 ?PDV2 ?TIMENOW)
    (giveWayVessel ?PDV1 ?PDV2 ?TIMENOW)
    (not (giveWayVessel ?PDV2 ?PDV1 ?TIMENOW))
    (or
      (obligatoryNextAction ?PDV1 ?PDV2 AlterCourseStarboard ?TIMENOW)
      (obligatoryNextAction ?PDV1 ?PDV2 SlowDown ?TIMENOW))
    (not (obligatoryNextAction ?PDV1 ?PDV2 MaintainCourseAndSpeed ?TIMENOW))
    (standOnVessel ?PDV2 ?PDV1 ?TIMENOW)
    (not (standOnVessel ?PDV1 ?PDV2 ?TIMENOW))
    (obligatoryNextAction ?PDV2 ?PDV1 MaintainCourseAndSpeed ?TIMENOW)
    (not (obligatoryNextAction ?PDV2 ?PDV1 AlterCourseStarboard ?TIMENOW))
    (not (obligatoryNextAction ?PDV2 ?PDV1 SlowDown ?TIMENOW))
    (not (obligatoryNextAction ?PDV2 ?PDV1 AlterCoursePort ?TIMENOW))))
    

(=>
  (and
    (instance ?PDV1 WaterVehicle)
    (attribute ?PDV1 PowerDrivenVessel)
    (attribute ?PDV1 OwnVessel)
    (instance ?PDV2 WaterVehicle)
    (attribute ?PDV2 PowerDrivenVessel)
    (attribute ?PDV2 TargetVessel)  
    (isPortOf ?PDV2 ?PDV1 ?TIMENOW)
    (showingStarboardAspect ?PDV2 ?PDV1 ?TIMENOW)
    (mutuallyVisibleAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (concurrentTranslocationAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (riskOfCollision ?PDV1 ?PDV2 ?TIMENOW)
    (not (reciprocalCourse ?PDV1 ?PDV2 ?TIMENOW))
    (not (similarCourse ?PDV1 ?PDV2 ?TIMENOW)))
  (and
    (crossingSituation ?PDV2 ?PDV1 ?TIMENOW)
    (giveWayVessel ?PDV2 ?PDV1 ?TIMENOW)
    (not (giveWayVessel ?PDV1 ?PDV2 ?TIMENOW))
    (or
      (obligatoryNextAction ?PDV2 ?PDV1 AlterCourseStarboard ?TIMENOW)
      (obligatoryNextAction ?PDV2 ?PDV1 SlowDown ?TIMENOW))
    (not (obligatoryNextAction ?PDV2 ?PDV1 MaintainCourseAndSpeed ?TIMENOW))
    (standOnVessel ?PDV1 ?PDV2 ?TIMENOW)
    (not (standOnVessel ?PDV2 ?PDV1 ?TIMENOW))
    (obligatoryNextAction ?PDV1 ?PDV2 MaintainCourseAndSpeed ?TIMENOW)
    (not (obligatoryNextAction ?PDV1 ?PDV2 AlterCourseStarboard ?TIMENOW))
    (not (obligatoryNextAction ?PDV1 ?PDV2 SlowDown ?TIMENOW))
    (not (obligatoryNextAction ?PDV1 ?PDV2 AlterCoursePort ?TIMENOW))))


     
(=>
  (and
    (instance ?PDV1 WaterVehicle)
    (attribute ?PDV1 OwnVessel)       
    (instance ?PDV2 WaterVehicle) 
    (attribute ?PDV2 TargetVessel)
    (mutuallyVisibleAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (concurrentTranslocationAtTime ?PDV1 ?PDV2 ?TIMENOW)
    (or
      (similarCourse ?PDV1 ?PDV2 ?TIMENOW)
      (reciprocalCourse ?PDV1 ?PDV2 ?TIMENOW)
      (not (attribute ?PDV1 PowerDrivenVessel))
      (not (attribute ?PDV2 PowerDrivenVessel))
      (not (riskOfCollision ?PDV1 ?PDV2 ?TIMENOW))
      (and
        (not (isPortOf ?PDV2 ?PDV1 ?TIMENOW))
        (not (isStarboardOf ?PDV2 ?PDV1 ?TIMENOW)))
      (and
        (isStarboardOf ?PDV2 ?PDV1 ?TIMENOW)
        (not (showingPortAspect ?PDV2 ?PDV1 ?TIMENOW)))
      (and
        (isPortOf ?PDV2 ?PDV1 ?TIMENOW)
        (not (showingStarboardAspect ?PDV2 ?PDV1 ?TIMENOW)))))
  (and
    (not (crossingSituation ?PDV1 ?PDV2 ?TIMENOW))
    (not (crossingSituation ?PDV2 ?PDV1 ?TIMENOW))))
      
    
; overtakingSituation
(instance overtakingSituation TernaryPredicate)
(instance overtakingSituation Relation)
(domain overtakingSituation 1 WaterVehicle)
(domain overtakingSituation 2 WaterVehicle)
(domain overtakingSituation 3 TimeInterval)
(documentation overtakingSituation EnglishWrittenLanguage "A vessel shall be 
deemed to be overtaking when coming up with another vessel from a 
direction more than 22.5 degrees abaft her beam. (overtaking ?VES1 ?VES2) 
means VES1 is overtaking VES2.")
(termFormat EnglishWrittenLanguage overtakingSituation "overtaking") 
(format EnglishWrittenLanguage overtakingSituation "there is an overtaking 
situation between %1 and %2 at time %3")

; VES2 overtaking VES1
; POV of VES1 "I am being overtaken" 
(=>
  (and
    (instance ?VES1 WaterVehicle)  
    (attribute ?VES1 OwnVessel)      
    (instance ?VES2 WaterVehicle) 
    (attribute ?VES2 TargetVessel)
    (speedOverGround ?VES1 ?SPEED1 ?TIMENOW)
    (speedOverGround ?VES2 ?SPEED2 ?TIMENOW)
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)
    (concurrentTranslocationAtTime ?VES1 ?VES2 ?TIMENOW)
    (similarCourse ?VES1 ?VES2 ?TIMENOW)
    (relativeBearingTo ?VES1 ?VES2 ?RELBEAR ?TIMENOW)
    (greaterThanOrEqualTo ?RELBEAR 112.0)
    (lessThanOrEqualTo ?RELBEAR 247.0)
    (greaterThanOrEqualTo ?SPEED2 ?SPEED1))
  (and
    (overtakingSituation ?VES2 ?VES1 ?TIMENOW)
    (giveWayVessel ?VES2 ?VES1 ?TIMENOW)
    (standOnVessel ?VES1 ?VES2 ?TIMENOW)
    (obligatoryNextAction ?VES2 ?VES1 PassAtASafeDistance ?TIMENOW)
    (obligatoryNextAction ?VES1 ?VES2 MaintainCourseAndSpeed ?TIMENOW)))

; "I am NOT being overtaken"
(=>
  (and
    (instance ?VES1 WaterVehicle) 
    (attribute ?VES1 OwnVessel)       
    (instance ?VES2 WaterVehicle) 
    (attribute ?VES2 TargetVessel)
    (speedOverGround ?VES1 ?SPEED1 ?TIMENOW)
    (speedOverGround ?VES2 ?SPEED2 ?TIMENOW)
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)
    (concurrentTranslocationAtTime ?VES1 ?VES2 ?TIMENOW)
    (relativeBearingTo ?VES1 ?VES2 ?RELBEAR ?TIMENOW)
    (or
      (not (similarCourse ?VES1 ?VES2 ?TIMENOW))
      (lessThanOrEqualTo ?RELBEAR 111.0)
      (greaterThanOrEqualTo ?RELBEAR 248.0)
      (lessThan ?SPEED2 ?SPEED1)))
  (not
    (overtakingSituation ?VES2 ?VES1 ?TIMENOW)))
  
    
; VES1 overtaking VES2
; "I am overtaking"
(=>
  (and
    (instance ?VES1 WaterVehicle) 
    (attribute ?VES1 OwnVessel)       
    (instance ?VES2 WaterVehicle) 
    (attribute ?VES2 TargetVessel)
    (speedOverGround ?VES1 ?SPEED1 ?TIMENOW)
    (speedOverGround ?VES2 ?SPEED2 ?TIMENOW)
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)
    (concurrentTranslocationAtTime ?VES1 ?VES2 ?TIMENOW)
    (similarCourse ?VES1 ?VES2 ?TIMENOW)
    (relativeBearingTo ?VES1 ?VES2 ?RELBEAR ?TIMENOW)
    (or
      (greaterThanOrEqualTo ?RELBEAR 292.0)
      (lessThanOrEqualTo ?RELBEAR 68.0))
    (greaterThanOrEqualTo ?SPEED1 ?SPEED2))
  (and
    (overtakingSituation ?VES1 ?VES2 ?TIMENOW)
    (giveWayVessel ?VES1 ?VES2 ?TIMENOW)
    (standOnVessel ?VES2 ?VES1 ?TIMENOW)
    (obligatoryNextAction ?VES1 ?VES2 PassAtASafeDistance ?TIMENOW)
    (obligatoryNextAction ?VES2 ?VES1 MaintainCourseAndSpeed ?TIMENOW)))

; "I am NOT overtaking them"
(=>
  (and
    (instance ?VES1 WaterVehicle) 
    (attribute ?VES1 OwnVessel)       
    (instance ?VES2 WaterVehicle) 
    (attribute ?VES2 TargetVessel)
    (speedOverGround ?VES1 ?SPEED1 ?TIMENOW)
    (speedOverGround ?VES2 ?SPEED2 ?TIMENOW)
    (mutuallyVisibleAtTime ?VES1 ?VES2 ?TIMENOW)
    (concurrentTranslocationAtTime ?VES1 ?VES2 ?TIMENOW)
    (relativeBearingTo ?VES1 ?VES2 ?RELBEAR ?TIMENOW)
    (or
      (not (similarCourse ?VES1 ?VES2 ?TIMENOW))
      (lessThan ?SPEED1 ?SPEED2)
      (and
        (lessThanOrEqualTo ?RELBEAR 291.0)
        (greaterThanOrEqualTo ?RELBEAR 69.0))))
  (not
    (overtakingSituation ?VES1 ?VES2 ?TIMENOW)))

          

    
; noRotrSituation    
(instance noRotrSituation TernaryPredicate)
(instance noRotrSituation Relation)
(domain noRotrSituation 1 WaterVehicle)
(domain noRotrSituation 2 WaterVehicle)
(domain noRotrSituation 3 TimeInterval)
(format EnglishWrittenLanguage noRotrSituation "vessel %1 and vessel %2 are %n free of any rules of the road situation at time %3")
(documentation noRotrSituation EnglishWrittenLanguage "VES1 and VES2 are not
in a Rules of the Road situation")
(termFormat EnglishWrittenLanguage noRotrSituation "no rules of the road situation") 

