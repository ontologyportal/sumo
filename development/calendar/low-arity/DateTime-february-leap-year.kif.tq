;; Load Merge.kif and this directory's DateTime.kif before running.
(note DateTime_february_leap_year)
(category general)
(time 10)

;; A year divisible by 4, but not by 100.
(instance CalendarLeapTestYear Integer)
(equal (RemainderFn CalendarLeapTestYear 4) 0)
(not (equal (RemainderFn CalendarLeapTestYear 100) 0))

(query (daysInMonth 2 CalendarLeapTestYear 29))
(answer yes)
