;; Load Merge.kif and this directory's DateTime.kif before running.
(note DateTime_january_last_day_finishes_month)
(category general)
(time 10)

;; Isolate the interval bridge from month-length arithmetic.
(daysInMonth 1 2026 31)

(query
  (finishes
    (DayIntervalFn 2026 1 31)
    (MonthIntervalFn 2026 1)))

(answer yes)
