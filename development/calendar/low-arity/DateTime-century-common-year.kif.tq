;; Load Merge.kif and this directory's DateTime.kif before running.
(note DateTime_century_common_year)
(category general)
(time 10)

;; A century year divisible by 4 and 100, but not by 400 (as in 1900).
(instance CalendarCommonCenturyTestYear Integer)
(equal (RemainderFn CalendarCommonCenturyTestYear 4) 0)
(equal (RemainderFn CalendarCommonCenturyTestYear 100) 0)
(not (equal (RemainderFn CalendarCommonCenturyTestYear 400) 0))

(query (daysInMonth 2 CalendarCommonCenturyTestYear 28))
(answer yes)
