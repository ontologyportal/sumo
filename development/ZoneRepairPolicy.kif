;; Zone Repair Policy
;; Author: Jonathan Goohs Jr.
;; License: GNU General Public License, version 3 or later.
;;
;; Role requirements for physical repairs of organization-owned objects
;; in network zones. Software-content correction is outside this ontology.

(instance requiresRoleForRepair TernaryPredicate)
(domain requiresRoleForRepair 1 Organization)
(domain requiresRoleForRepair 2 OccupationalRole)
(domain requiresRoleForRepair 3 Repairing)
(documentation requiresRoleForRepair EnglishWrittenLanguage "(&%requiresRoleForRepair
?ORG ?OCCUPATION ?REPAIR) means that the policy of ?ORG requires every agent of
?REPAIR to hold ?OCCUPATION. Each stated role is a requirement, not an
alternative permission. The requirement does not imply that an agent actually
holds the role. Credentials and skills are not inferred from this relation.")
(termFormat EnglishWrittenLanguage requiresRoleForRepair "requires role for repair")
(format EnglishWrittenLanguage requiresRoleForRepair "%1 requires %2 for %3")

(instance violatesZoneRepairPolicy BinaryPredicate)
(domain violatesZoneRepairPolicy 1 Repairing)
(domain violatesZoneRepairPolicy 2 Organization)
(documentation violatesZoneRepairPolicy EnglishWrittenLanguage "(&%violatesZoneRepairPolicy
?REPAIR ?ORG) means that ?REPAIR is a &%repairInZone of ?ORG and at least one
agent of ?REPAIR lacks an &%OccupationalRole that ?ORG &%requiresRoleForRepair.
An unknown role membership does not establish its negation. This relation
detects a missing required role, not every possible policy violation.")
(termFormat EnglishWrittenLanguage violatesZoneRepairPolicy "violates zone repair policy")
(format EnglishWrittenLanguage violatesZoneRepairPolicy "%1 violates the zone repair policy of %2")

(=>
  (and
    (repairInZone ?REPAIR ?ORG ?ZONE)
    (agent ?REPAIR ?AGENT)
    (requiresRoleForRepair ?ORG ?OCCUPATION ?REPAIR)
    (not
      (attribute ?AGENT ?OCCUPATION)))
  (violatesZoneRepairPolicy ?REPAIR ?ORG))

(=>
  (violatesZoneRepairPolicy ?REPAIR ?ORG)
  (exists (?ZONE ?AGENT ?OCCUPATION)
    (and
      (repairInZone ?REPAIR ?ORG ?ZONE)
      (agent ?REPAIR ?AGENT)
      (requiresRoleForRepair ?ORG ?OCCUPATION ?REPAIR)
      (not
        (attribute ?AGENT ?OCCUPATION)))))
