;; Network Relations
;; Author: Jonathan Goohs Jr.
;; License: GNU General Public License, version 3 or later.

(instance subNetwork BinaryPredicate)
(instance subNetwork TransitiveRelation)
(instance subNetwork AsymmetricRelation)
(subrelation subNetwork properPart)
(domain subNetwork 1 ComputerNetwork)
(domain subNetwork 2 ComputerNetwork)
(documentation subNetwork EnglishWrittenLanguage "(&%subNetwork ?SUB ?NET) means that the
&%ComputerNetwork ?SUB is a network within the larger &%ComputerNetwork ?NET, at any
depth: a &%subNetwork of a &%subNetwork of ?NET is also a &%subNetwork of ?NET. It is a
&%properPart of ?NET, so anything that is a &%part of ?SUB is also a &%part of ?NET.")
(termFormat EnglishWrittenLanguage subNetwork "subnetwork")
(format EnglishWrittenLanguage subNetwork "%1 is a subnetwork of %2")

;; Explicit first-order rules preserve these consequences in translations
;; that do not instantiate every relation-property declaration.

(=>
  (and
    (subNetwork ?SUB ?MID)
    (subNetwork ?MID ?NET))
  (subNetwork ?SUB ?NET))

(=>
  (subNetwork ?SUB ?NET)
  (not
    (subNetwork ?NET ?SUB)))

(=>
  (subNetwork ?SUB ?NET)
  (properPart ?SUB ?NET))

(instance immediateSubNetwork BinaryPredicate)
(instance immediateSubNetwork AsymmetricRelation)
(instance immediateSubNetwork IntransitiveRelation)
(domain immediateSubNetwork 1 ComputerNetwork)
(domain immediateSubNetwork 2 ComputerNetwork)
(documentation immediateSubNetwork EnglishWrittenLanguage "(&%immediateSubNetwork ?SUB ?NET)
means that the &%ComputerNetwork ?SUB is a &%subNetwork of the &%ComputerNetwork ?NET
and there is no network in between, that is, no &%subNetwork of ?NET of which ?SUB is a
&%subNetwork.")
(termFormat EnglishWrittenLanguage immediateSubNetwork "immediate subnetwork")
(format EnglishWrittenLanguage immediateSubNetwork "%1 is an immediate subnetwork of %2")

(=>
  (immediateSubNetwork ?SUB ?NET)
  (subNetwork ?SUB ?NET))

(=>
  (immediateSubNetwork ?SUB ?NET)
  (not
    (exists (?MID)
      (and
        (subNetwork ?SUB ?MID)
        (subNetwork ?MID ?NET)))))

(=>
  (and
    (subNetwork ?SUB ?NET)
    (forall (?MID)
      (not
        (and
          (subNetwork ?SUB ?MID)
          (subNetwork ?MID ?NET)))))
  (immediateSubNetwork ?SUB ?NET))
