;; Repair In Zone Context
;; Author: Jonathan Goohs Jr.
;; License: GNU General Public License, version 3 or later.
;;
;; Repair context of physical repairs of organization-owned objects in
;; network zones. Software-content correction is outside this ontology.

(instance repairInZone TernaryPredicate)
(domain repairInZone 1 Repairing)
(domain repairInZone 2 Organization)
(domain repairInZone 3 NetworkZone)
(documentation repairInZone EnglishWrittenLanguage "(&%repairInZone ?REPAIR ?ORG ?ZONE)
means that ?REPAIR has an &%Object as its &%patient, ?ORG &%possesses that object,
and the object is a &%part of ?ZONE. This relation concerns physical repair,
not the correction of a &%ComputerProgram.")
(termFormat EnglishWrittenLanguage repairInZone "repair in zone")
(format EnglishWrittenLanguage repairInZone "%1 is a repair of something %2 possesses in %3")

;; The three roles must be bound jointly: the same witness is the repair's
;; patient, is possessed by the organization, and is part of the zone.
(=>
  (and
    (instance ?REPAIR Repairing)
    (instance ?ORG Organization)
    (instance ?OBJ Object)
    (patient ?REPAIR ?OBJ)
    (possesses ?ORG ?OBJ)
    (part ?OBJ ?ZONE)
    (instance ?ZONE NetworkZone))
  (repairInZone ?REPAIR ?ORG ?ZONE))

(=>
  (repairInZone ?REPAIR ?ORG ?ZONE)
  (exists (?OBJ)
    (and
      (instance ?OBJ Object)
      (patient ?REPAIR ?OBJ)
      (possesses ?ORG ?OBJ)
      (part ?OBJ ?ZONE))))
