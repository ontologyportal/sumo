;; ===========================================================================
;; ROE_Master.kif
;;
;; Terms drawn from the Newport ROE Handbook: the Annex D glossary, the
;; Annex B series notes, and the body of the Handbook, together with the
;; instruments it cites (MTP-01, UNCLOS, the UN Charter, the North Atlantic
;; Treaty). Each documentation string names its source.
;;
;; This file defines the subject matter. The machinery for representing ROE
;; measures is in ROE_Supplementary.kif, and the measures themselves are in
;; ROE_Series.kif. Load this file first.
;; ===========================================================================

;; 1. HostileAct
(subclass HostileAct Attack)
(subclass HostileAct CriminalAction)

;; Documentation
(documentation HostileAct EnglishWrittenLanguage
  "An unlawful attack or other use of force against a State, the Force, or
   other designated persons or property. A hostile act includes traditional
   uses of force, such as the firing of weapons, and the taking or holding of
   hostages against their will. It does not include harassment.")

;; Term format
(termFormat EnglishWrittenLanguage HostileAct "hostile act")

;; Rule 1: Every HostileAct has some agent. That it is unlawful follows from
;; &%CriminalAction, an intentional process that violates a law. An earlier
;; version also stated (property ?HA Illegal); &%Illegal is a
;; &%DeonticAttribute, which applies to a formula through &%modalAttribute,
;; not to a process.
(=>
  (instance ?HA HostileAct)
  (exists (?AGENT)
    (and
      (instance ?AGENT AutonomousAgent)
      (agent ?HA ?AGENT))))

;; Rule 2: HostileAct is NOT harassment
(disjoint HostileAct Harassment)

;; Rule 3: Taking military personnel hostage is a HostileAct. This is a
;; sufficient condition for one protected group, not a definition: a hostile
;; act is directed against a State, the Force, or designated persons or
;; property, so the hostage taking of other protected persons, such as a
;; civilian under the protection of the Force, may also be one and needs rules
;; of its own. An earlier version made every hostage taking of a human a
;; hostile act, and so a military &%Attack, including a hostage taking in a
;; robbery ashore.
(=>
  (and
    (instance ?HT HostageTaking)
    (patient ?HT ?VICTIM)
    (attribute ?VICTIM MilitaryPerson))
  (instance ?HT HostileAct))

;; 2. HostileIntent
(subclass HostileIntent Threatening)

;; Documentation
;; In this ontology, hostile intent is employed in relation to self-defense,
;; following the Newport Rules of Engagement (ROE) Handbook. Note that other ROE
;; systems may employ hostile intent in relation to Law of Armed Conflict
;; (LOAC)-based attack authorizations rather than self-defense. Targets of
;; hostile intent are related by patient rather than victim, because Threatening
;; is not a CriminalAction.
(documentation HostileIntent EnglishWrittenLanguage
  "The threat of an imminent hostile act. A determination of hostile intent is
   based on an identifiable threat comprising both the capability and
   intention to conduct a hostile act.")

;; Term format
(termFormat EnglishWrittenLanguage HostileIntent "hostile intent")

;; Rule 1: HostileIntent indicates a possible imminent HostileAct by the same
;; actor
(=>
  (instance ?HI HostileIntent)
  (exists (?ACTOR)
    (and
      (agent ?HI ?ACTOR)
      (modalAttribute
        (exists (?HA)
          (and
            (instance ?HA HostileAct)
            (agent ?HA ?ACTOR)
            (during
              (WhenFn ?HA)
              (ImmediateFutureFn
                (WhenFn ?HI))))) Possibility))))

;; Rule 2: HostileIntent is not yet a HostileAct
(disjoint HostileIntent HostileAct)

;; Rule 3: HostileIntent involves an actor with capability AND
;; an observed preparatory action directed at the target
(=>
  (instance ?HI HostileIntent)
  (exists (?ACTOR ?TARGET ?PREP)
    (and
      (agent ?HI ?ACTOR)
      (patient ?HI ?TARGET)
      (instance ?PREP IntentionalProcess)
      (agent ?PREP ?ACTOR)
      (destination ?PREP ?TARGET)
      (during
        (WhenFn ?PREP)
        (WhenFn ?HI))
      (believes ?TARGET
        (exists (?X)
          (and
            (instance ?X HostileAct)
            (causes ?PREP ?X)
            (destination ?X ?TARGET)))))))

;; 2a. HostileConduct
;; The unified trigger for self-defense. The Newport Handbook states the
;; conditions for self-defense as "a hostile act or hostile intent" wherever it
;; states them at all, and this class carries that disjunction as a single type.
;;
;; The class is not merely notational. Writing the disjunction inline, as
;; (instance ?T HostileConduct), binds one variable
;; to two classes that share no common subtype, and SUMOtoTFAform rejects such a
;; formula with inconsistentVarTypes because TFF requires every variable to
;; carry a single sort. Six rules in this file carried that pattern.
;;
;; Numbered 2a rather than given a new number so that cross-references from
;; ROE_Supplementary.kif and ROE_Series.kif remain valid.

(subclass HostileConduct SocialInteraction)
(documentation HostileConduct EnglishWrittenLanguage
  "Conduct that triggers the right of self-defense under the Newport ROE
   Handbook: either a hostile act, which is an attack or other use of force
   already under way, or hostile intent, which is the threat of an imminent
   hostile act. Harassment is excluded.")
(termFormat EnglishWrittenLanguage HostileConduct "hostile conduct")

(subclass HostileAct HostileConduct)
(subclass HostileIntent HostileConduct)

;; Stated with disjoint rather than partition. No rule depends on the two
;; subclasses being jointly exhaustive of HostileConduct, and partition is a
;; VariableArityRelation whose axiom carries a row variable and expands in both
;; directions into exhaustiveDecomposition and disjointDecomposition, which
;; measurably enlarges the search space.
(disjoint HostileAct HostileIntent)
(disjoint Harassment HostileConduct)

;; 2b. Interference
;; Scaffolding for item 3 and for the interference classes of Series 20 and 21.
;; Declared here rather than in ROE_Supplementary.kif because &%Harassment
;; depends on it and ROE_Master.kif loads first.

(subclass Interference SocialInteraction)
(documentation Interference EnglishWrittenLanguage
  "A &%SocialInteraction in which an agent has the purpose of making it
   possible that another agent does not carry out, during the interference, an
   activity that the other agent desires to perform. The target of the
   interference is that agent or, when the target is a &%Ship, the ship whose
   captain that agent is. An interference that fails is still an interference.")
(termFormat EnglishWrittenLanguage Interference "interference")

;; Rule 1: An interference has an agent, a target, and a cognitive agent whose
;; desired activity it is meant to stop during the interference. That agent is
;; the target itself or, when the target is a ship, its captain: desires
;; requires a CognitiveAgent, and a ship is an Artifact.
;; The purpose is stated in two ways, as Prof. Pease suggested (28 Oct 2026):
;; that it be possible that no such activity occurs during the interference,
;; and that the interference hinders the class of such activities by that
;; agent. SUMO scopes &%hinders to the time and location of the hindering
;; process, here the interference itself. &%KappaFn has no axiomatic support
;; and its use is discouraged in SUMO, so the second form is a formalization
;; for the record rather than one a prover can reason with yet. Its range is
;; &%Entity, so the class it forms is not passed to &%hinders directly; as in
;; SUMO's own Respirator axiom (Cars.kif), a class variable is declared a
;; subclass of it, and the variable of &%KappaFn is also listed in the
;; enclosing exists, as there, since the semantic checker does not treat
;; &%KappaFn as binding it. Both are purposes, so an interference that fails is
;; still an interference.
;; &%ProcessSuccess (QoSontology.kif) may state that an interference achieved
;; its purpose, for example by delaying the activity; it does not imply
;; complete prevention, so no rule derives &%prevents from it. An interference
;; that actually prevents the activity is stated separately in the scenario,
;; with &%prevents and a subclass of the corresponding &%KappaFn class.
(=>
  (instance ?I Interference)
  (exists (?A ?T ?B ?C)
    (and
      (agent ?I ?A)
      (patient ?I ?T)
      (instance ?B CognitiveAgent)
      (not
        (equal ?A ?B))
      (or
        (equal ?B ?T)
        (and
          (instance ?T Ship)
          (member ?B
            (ShipCrewFn ?T))
          (attribute ?B ShipCaptain)))
      (subclass ?C IntentionalProcess)
      (desires ?B
        (exists (?P)
          (and
            (instance ?P ?C)
            (agent ?P ?B))))
      (hasPurposeForAgent ?I ?A
        (modalAttribute
          (not
            (exists (?P)
              (and
                (instance ?P ?C)
                (agent ?P ?B)
                (overlapsTemporally
                  (WhenFn ?P)
                  (WhenFn ?I)))))
          Possibility))
      (hasPurposeForAgent ?I ?A
        (exists (?H ?P2)
          (and
            (subclass ?H
              (KappaFn ?P2
                (and
                  (instance ?P2 ?C)
                  (agent ?P2 ?B))))
            (hinders ?I ?H)))))))

;; 3. Harassment
(subclass Harassment Interference)

;; The line between harassment and hostile intent depends on context: the same
;; act may be one or the other depending on the level of tension.
(documentation Harassment EnglishWrittenLanguage
  "Actions or demonstrations that do not constitute a &%HostileAct but are
   calculated to inconvenience, disrupt, or alarm. Harassment is provocative
   in nature but falls short of &%HostileIntent or a &%HostileAct, and
   therefore does not trigger the right of self-defense (Newport ROE
   Handbook).")

(termFormat EnglishWrittenLanguage Harassment "harassment")

;; Rule 1: Harassment is disjoint from HostileAct and HostileIntent
(disjoint Harassment HostileAct)
(disjoint Harassment HostileIntent)

;; Rule 2 removed. It stated that harassment never causes physical damage,
;; which rules 61 C and 61 D contradict: both regulate "harassment that may
;; result in physical damage". The no-damage condition belongs to the 61 B
;; subclass, NonDamagingHarassment in ROE_Series.kif, and is stated there.

;; Rule 3 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; Rule 4 removed. It stated that harassment has the purpose of hindering an
;; activity its target desires to perform; Harassment now inherits this, in a
;; stronger form, from the definition of Interference at item 2b.

;; 4. SelfDefense
(subclass SelfDefense UseOfForce)

;; Documentation
;; Self-defense is available in all situations, including armed conflict. This
;; ontology follows the Newport Rules of Engagement (ROE) Handbook categories:
;; individual self-defense, unit self-defense, defense of others, national
;; self-defense, and collective self-defense. Necessity exists when one faces a
;; hostile act or hostile intent, and the authority continues so long as that
;; act or intent continues.
(documentation SelfDefense EnglishWrittenLanguage
  "The use of force to defend against an attack (hostile act) or imminent
   attack (hostile intent).")

;; Term format
(termFormat EnglishWrittenLanguage SelfDefense "self-defense")

;; Rule 1: Every SelfDefense action has an agent
(=>
  (instance ?S SelfDefense)
  (exists (?A)
    (and
      (instance ?A AutonomousAgent)
      (agent ?S ?A))))

;; Rule 2: SelfDefense is caused by a HostileAct or HostileIntent
;; directed at the defending agent
(=>
  (instance ?S SelfDefense)
  (exists (?A ?T)
    (and
      (instance ?A AutonomousAgent)
      (agent ?S ?A)
      (instance ?T HostileConduct)
      (patient ?T ?A)
      (causes ?T ?S))))

;; 5. IndividualSelfDefense
(subclass IndividualSelfDefense SelfDefense)

(documentation IndividualSelfDefense EnglishWrittenLanguage
  "The right of an individual to defend himself or herself against hostile
   acts or hostile intent.")

;; Term format
(termFormat EnglishWrittenLanguage IndividualSelfDefense
  "individual self-defense")

;; Rule 1: the agent of an act of individual self-defense is a person.
(=>
  (instance ?S IndividualSelfDefense)
  (exists (?A)
    (and
      (instance ?A Human)
      (agent ?S ?A))))

;; Rule 1b: and that agent is unique. Stated as a condition on any two agents
;; rather than as "there exists exactly one", which is the same claim but
;; requires no witness: the rule fires only where a scenario actually records
;; two agent assertions, and produces no Skolem constant otherwise. The earlier
;; form, a nested negated existential inside an existential, produced one on
;; every instance of the class.
;;
;; The uniqueness itself is a reading rather than a quotation. Annex D says
;; individual self-defense is the right of an individual to defend himself or
;; herself; it does not say that such an act has exactly one agent. The
;; condition is read in from the word "individual" and is recorded here as an
;; interpretation.
(=>
  (and
    (instance ?S IndividualSelfDefense)
    (agent ?S ?A1)
    (agent ?S ?A2))
  (equal ?A1 ?A2))

;; Rule 2 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 6. UnitSelfDefense
(subclass UnitSelfDefense SelfDefense)

;; In some States, this is both a right and an obligation, in others only a
;; right.
(documentation UnitSelfDefense EnglishWrittenLanguage
  "The right of a unit commander to defend his or her unit and other units
   from the same State against hostile acts or hostile intent.")

;; Term format
(termFormat EnglishWrittenLanguage UnitSelfDefense "unit self-defense")

;; Rule 1: UnitSelfDefense agent is a MilitaryOrganization
(=>
  (instance ?S UnitSelfDefense)
  (exists (?U)
    (and
      (instance ?U MilitaryOrganization)
      (agent ?S ?U))))

;; Rule 2 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; Rule 3 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 7. DefenseOfOthers
(subclass DefenseOfOthers SelfDefense)

(documentation DefenseOfOthers EnglishWrittenLanguage
  "The use of force in defense of specified persons (who are not part of the
   Force) and their property against hostile acts or hostile intent.")

;; Term format
(termFormat EnglishWrittenLanguage DefenseOfOthers "defense of others")

;; Rule moved to ROE_Deontic.kif (deontic layer, kept out of the main knowledge
;; base).

;; 8. NationalSelfDefense
(subclass NationalSelfDefense SelfDefense)

(documentation NationalSelfDefense EnglishWrittenLanguage
  "As recognized in Article 51 of the UN Charter and customary international
   law, the right of a State to use force to defend itself, its nationals, and
   their property against hostile acts and hostile intent.")

;; Term format
(termFormat EnglishWrittenLanguage NationalSelfDefense "national self-defense")

;; Rule moved to ROE_Deontic.kif (deontic layer, kept out of the main knowledge
;; base).

;; 9. CollectiveSelfDefense
(subclass CollectiveSelfDefense SelfDefense)

(documentation CollectiveSelfDefense EnglishWrittenLanguage
  "As recognized in Article 51 of the UN Charter and customary international
   law, the right of a State to use force to defend another State, its
   persons, its forces, and/or its property in response to an armed attack or
   imminent armed attack.")

;; Term format
(termFormat EnglishWrittenLanguage CollectiveSelfDefense
  "collective self-defense")

;; Rule moved to ROE_Deontic.kif (deontic layer, kept out of the main knowledge
;; base).

;; 10. Declared Hostile Force
(instance DeclaredHostileStatus RelationalAttribute)

;; Forces with this status may be engaged without requiring an observed hostile
;; act or hostile intent. The status arises only from a declaration by competent
;; authority; being engaged in hostilities does not by itself confer it. Used in
;; Newport ROE Series 30 and measure 12 F.
(documentation DeclaredHostileStatus EnglishWrittenLanguage
  "An attribute indicating that a force or individual has been declared
   hostile by competent authority under the applicable Rules of Engagement
   (ROE).")

(termFormat EnglishWrittenLanguage DeclaredHostileStatus "declared hostile")

;; Rule 1: DeclaredHostileStatus arises only from a declaration by competent
;; authority
(=>
  (property ?F DeclaredHostileStatus)
  (exists (?HQ ?DECL)
    (and
      (instance ?HQ HigherHeadquarters)
      (instance ?DECL Directing)
      (agent ?DECL ?HQ)
      (patient ?DECL ?F))))

;; Rule 2 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 11. UseOfForce
(subclass UseOfForce IntentionalProcess)

(documentation UseOfForce EnglishWrittenLanguage
  "A process in which an agent intentionally applies physical force, violence,
   or coercive power against persons or property. Use of force includes both
   lawful applications (such as self-defense) and unlawful applications (such
   as attacks).")

(termFormat EnglishWrittenLanguage UseOfForce "use of force")

;; Rule 1: Every Attack is a UseOfForce (Newport: traditional uses of force)
(subclass Attack UseOfForce)

;; Rule 2: UseOfForce involves an agent
(=>
  (instance ?UOF UseOfForce)
  (exists (?AGENT)
    (and
      (instance ?AGENT AutonomousAgent)
      (agent ?UOF ?AGENT))))

;; Rule 3a: Weapon use that causes damage is UseOfForce
(=>
  (and
    (instance ?PROC Process)
    (instance ?W Weapon)
    (instrument ?PROC ?W)
    (instance ?D Damaging)
    (causes ?PROC ?D))
  (instance ?PROC UseOfForce))

;; Rule 3b: Striking/hitting that causes damage is UseOfForce
(=>
  (and
    (instance ?PROC Impelling)
    (instance ?AGENT AutonomousAgent)
    (agent ?PROC ?AGENT)
    (instance ?D Damaging)
    (causes ?PROC ?D))
  (instance ?PROC UseOfForce))

;; 12. Deadly Force
(subclass ForceCharacter RelationalAttribute)

;; Per the Newport glossary the distinction is a property of the force applied,
;; not of the weapon employed: the same weapon may be used in a deadly or a
;; non-deadly manner. It is a relation between the agent, the weapon and the
;; target, since whether force is deadly depends on what the agent intends and
;; on what the force is likely to cause to the target.
(documentation ForceCharacter EnglishWrittenLanguage
  "An attribute characterizing the nature of force used, such as deadly or
   non-deadly, in rules of engagement contexts.")
(termFormat EnglishWrittenLanguage ForceCharacter "force character")

(instance DeadlyForce ForceCharacter)

(documentation DeadlyForce EnglishWrittenLanguage
  "Force intended or likely to cause death or serious injury, regardless of
   whether death or serious injury results (Newport ROE Handbook, glossary).")

(termFormat EnglishWrittenLanguage DeadlyForce "deadly force")

;; Rule 1: Deadly force is intended or likely to cause death or injury. SUMO
;; has no class for serious injury, so &%Injuring stands for it.
(=>
  (and
    (property ?P DeadlyForce)
    (agent ?P ?A))
  (or
    (hasPurposeForAgent ?P ?A
      (exists (?E)
        (and
          (or
            (instance ?E Death)
            (instance ?E Injuring))
          (causes ?P ?E))))
    (modalAttribute
      (exists (?E)
        (and
          (or
            (instance ?E Death)
            (instance ?E Injuring))
          (causes ?P ?E)))
      Likely)))

;; Earlier sufficient rules removed. One made every process causing &%Death an
;; application of deadly force, another every process causing &%Injuring. The
;; Handbook defines deadly force by intent or likelihood, regardless of the
;; result, so the character cannot be derived from the result: a non-deadly
;; application that unexpectedly caused death or injury received both
;; characters, and &%contraryAttribute made the knowledge base inconsistent.

;; 13. Non-deadly Force
(instance NonDeadlyForce ForceCharacter)

(documentation NonDeadlyForce EnglishWrittenLanguage
  "Force not intended or likely to cause death or serious injury (Newport ROE
   Handbook, glossary).")

(termFormat EnglishWrittenLanguage NonDeadlyForce "non-deadly force")

;; Rule 1: Deadly and non-deadly force are mutually exclusive
(contraryAttribute DeadlyForce NonDeadlyForce)

;; Rule 2: Ordering on the force scale, for the "up to and including deadly
;; force" ceiling used by the Newport measures
(successorAttribute NonDeadlyForce DeadlyForce)

;; 14. Warning Shot
(subclass WarningShot Shooting)

(documentation WarningShot EnglishWrittenLanguage
  "A shot fired in the vicinity of a person, vessel, or aircraft as a signal
   to stop or comply with instructions, without the intent to cause damage or
   injury (Newport ROE Handbook).")

(termFormat EnglishWrittenLanguage WarningShot "warning shot")

;; Rule 1: A WarningShot does not have the purpose of causing damage
(=>
  (and
    (instance ?WS WarningShot)
    (patient ?WS ?TARGET))
  (not
    (hasPurpose ?WS
      (exists (?D)
        (and
          (instance ?D Damaging)
          (patient ?D ?TARGET))))))

;; Rule 2: WarningShot is an application of non-deadly force
(=>
  (instance ?WS WarningShot)
  (property ?WS NonDeadlyForce))

;; Rule 3: WarningShot projectile does not hit the target
(=>
  (and
    (instance ?WS WarningShot)
    (patient ?WS ?TARGET)
    (instrument ?WS ?PROJ)
    (instance ?PROJ Projectile))
  (not
    (meetsSpatially ?PROJ ?TARGET)))

;; 15. Disabling Fire
(subclass DisablingFire Shooting)

;; DisablingFire is a UseOfForce by its purpose, so it is classified before it
;; is fired. Deriving that status only from damage actually caused, through
;; Rule 3a, would make the same planned act a use of force after the fact and
;; not before, and a decision taken before firing could not rely on it.
;; Warning shots and non-disabling fire are not fired to damage and are not
;; classified as a use of force.
(subclass DisablingFire UseOfForce)

;; It is a &%UseOfForce because it is fired in order to cause damage, whether or
;; not damage results.
(documentation DisablingFire EnglishWrittenLanguage
  "Fire directed at a target, usually a vessel or vehicle, in order to impair
   its ability to function or maneuver, without necessarily destroying it
   (Newport ROE Handbook).")

(termFormat EnglishWrittenLanguage DisablingFire "disabling fire")

;; Rule 1: DisablingFire has the purpose of impairing the target's function
(=>
  (and
    (instance ?S DisablingFire)
    (patient ?S ?DEV)
    (instance ?DEV Device))
  (hasPurpose ?S
    (attribute ?DEV Malfunctioning)))

;; Rule 2: After DisablingFire, the device is impaired
(=>
  (and
    (instance ?S DisablingFire)
    (patient ?S ?DEV)
    (instance ?DEV Device)
    (result ?S ?STATE))
  (holdsDuring ?STATE
    (attribute ?DEV Malfunctioning)))

;; 16. Non-disabling Fire
(subclass NonDisablingFire Shooting)

(documentation NonDisablingFire EnglishWrittenLanguage
  "Fire that is not intended to impair the target's ability to function, and
   may serve primarily as a warning or signal short of disabling or deadly
   force (Newport ROE Handbook).")

(termFormat EnglishWrittenLanguage NonDisablingFire "non-disabling fire")

;; Rule 1: NonDisablingFire and DisablingFire are disjoint
(disjoint NonDisablingFire DisablingFire)

;; Rule 2: NonDisablingFire does not have the purpose of disabling
(=>
  (instance ?S NonDisablingFire)
  (not
    (hasPurpose ?S
      (exists (?D)
        (and
          (instance ?D Device)
          (attribute ?D Malfunctioning))))))

;; 17. InternationalWaters
(subclass InternationalWaters Sea)
(subclass InternationalWaters GeographicArea)
(subclass InternationalWaters SaltWaterArea)

(documentation InternationalWaters EnglishWrittenLanguage
  "Sea areas beyond any national maritime claim, where no State sovereignty
   applies, also called the high seas (UNCLOS Article 86).")

(termFormat EnglishWrittenLanguage InternationalWaters "international waters")

;; Rule 1: International waters and maritime claim areas are disjoint
(disjoint InternationalWaters MaritimeClaimArea)

;; Rule 2: No State exercises sovereignty over international waters
(=>
  (instance ?IW InternationalWaters)
  (not
    (exists (?STATE)
      (and
        (instance ?STATE Nation)
        (possesses ?STATE ?IW)))))

;; Rule 3: No State has a territorial claim over international waters
(=>
  (instance ?IW InternationalWaters)
  (not
    (exists (?STATE)
      (and
        (instance ?STATE Nation)
        (claimedTerritory ?IW ?STATE)))))

;; 18. MaritimeOperation
(subclass MaritimeOperation MilitaryOperation)

(documentation MaritimeOperation EnglishWrittenLanguage
  "A military operation conducted primarily in the maritime domain, including
   sea surface, subsurface (underwater regions), the overlying airspace, and
   adjacent coastal land areas.")

(termFormat EnglishWrittenLanguage MaritimeOperation "maritime operation")

;; Rule: A MaritimeOperation's area of operation is maritime-related
(=>
  (instance ?OP MaritimeOperation)
  (exists (?REGION)
    (and
      (areaOfOperation ?REGION ?OP)
      (or
        (instance ?REGION Sea)
        (instance ?REGION UnderwaterRegion)
        (exists (?SHORE)
          (and
            (instance ?SHORE ShoreArea)
            (part ?SHORE ?REGION)))
        (exists (?SEA)
          (and
            (instance ?SEA Sea)
            (or
              (orientation ?REGION ?SEA Above)
              (meetsSpatially ?REGION ?SEA))))))))

;; 19. TacticalQuestioning
(subclass TacticalQuestioning Questioning)
(subclass TacticalQuestioning MilitaryProcess)

(documentation TacticalQuestioning EnglishWrittenLanguage
  "The field-expedient initial questioning for information of immediate
   tactical value of a captured or detained person at or near the point of
   capture and before the individual is placed in a detention facility
   (Newport ROE Handbook, glossary).")

(termFormat EnglishWrittenLanguage TacticalQuestioning "tactical questioning")

;; Rule 1: Tactical questioning involves a human subject
(=>
  (instance ?TQ TacticalQuestioning)
  (exists (?P)
    (and
      (instance ?P Human)
      (patient ?TQ ?P))))

;; Rule 2: The person questioned is held, captured or detained, during the
;; questioning. This is a necessary condition that distinguishes tactical
;; questioning from other questioning; it is not a full definition, since not
;; every &%Confining is a military capture or detention.
(=>
  (and
    (instance ?TQ TacticalQuestioning)
    (patient ?TQ ?P))
  (exists (?D)
    (and
      (instance ?D Confining)
      (patient ?D ?P)
      (during
        (WhenFn ?TQ)
        (WhenFn ?D)))))

;; 19b. VesselHailing
(subclass VesselHailing Questioning)

;; The answers are recorded and reported, and they may lead to a boarding.
(documentation VesselHailing EnglishWrittenLanguage
  "A &%Questioning in which a ship, aircraft or shore station calls a vessel,
   usually by radio, to ask its identity, flag State, cargo, last port of call
   and destination. The vessel is not under the control of the hailing party
   and may refuse to answer.")

(termFormat EnglishWrittenLanguage VesselHailing "hailing a vessel")

;; Rule 1: A hailing is addressed to a vessel
(=>
  (instance ?H VesselHailing)
  (exists (?V)
    (and
      (instance ?V WaterVehicle)
      (destination ?H ?V))))

;; Rule 2: The hailing party does not detain the crew of the hailed vessel
;; during the hailing. This is what distinguishes hailing from tactical
;; questioning. A detention by another party, such as the crew of a seized
;; vessel held by another unit, is not excluded. Other forms of control, such
;; as restricting movement without detention, are not covered.
(=>
  (and
    (instance ?H VesselHailing)
    (agent ?H ?A)
    (destination ?H ?V)
    (member ?P
      (ShipCrewFn ?V)))
  (not
    (exists (?D)
      (and
        (instance ?D Detention)
        (agent ?D ?A)
        (patient ?D ?P)
        (overlapsTemporally
          (WhenFn ?D)
          (WhenFn ?H))))))

;; Rule 3 (the obligation to report a doubtful activity) is in ROE_Deontic.kif.

;; 20. BoardingOperation
(subclass BoardingOperation MaritimeOperation)
(subclass BoardingOperation Boarding)

(disjoint CompliantBoarding NonCompliantBoarding)

(documentation BoardingOperation EnglishWrittenLanguage
  "The process of entering a vessel, typically a &%Ship, in order to search,
   inspect, or take control of it (Newport ROE Handbook).")

(termFormat EnglishWrittenLanguage BoardingOperation "boarding operation")

;; Rule 1: A boarding operation involves a ship
(=>
  (instance ?BO BoardingOperation)
  (exists (?S)
    (and
      (instance ?S Ship)
      (patient ?BO ?S))))

;; Rule 2: After a boarding operation, the agent is onboard the ship
(=>
  (and
    (instance ?BO BoardingOperation)
    (agent ?BO ?A)
    (patient ?BO ?S)
    (instance ?S Ship))
  (holdsDuring
    (EndFn
      (WhenFn ?BO))
    (onboard ?A ?S)))

;; Rule 3 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 21. CompliantBoarding
(subclass CompliantBoarding BoardingOperation)

(documentation CompliantBoarding EnglishWrittenLanguage
  "A boarding operation conducted with the consent and cooperation of the
   ship's master (Newport ROE Handbook).")

(termFormat EnglishWrittenLanguage CompliantBoarding "compliant boarding")

;; ShipCaptain is defined in SUMO (Mid-level-ontology.kif, a subAttribute of
;; Sailor, with its documentation and termFormat), so it is not redeclared
;; here. An earlier declaration as an instance of Position duplicated it and
;; added a second documentation string.

;; Rule 1: A compliant boarding involves cooperation from the ship's captain
(=>
  (and
    (instance ?CB CompliantBoarding)
    (patient ?CB ?S)
    (instance ?S Ship)
    (agent ?CB ?TEAM)
    (attribute ?CAPTAIN ShipCaptain)
    (member ?CAPTAIN
      (ShipCrewFn ?S)))
  (exists (?COOP)
    (and
      (instance ?COOP Cooperation)
      (agent ?COOP ?CAPTAIN)
      (agent ?COOP ?TEAM)
      (subProcess ?COOP ?CB))))

;; Rule 2: In a compliant boarding, no force subprocess is an attack
(=>
  (and
    (instance ?CB CompliantBoarding)
    (subProcess ?F ?CB))
  (not
    (instance ?F Attack)))

;; 22. NonCompliantBoarding
(subclass NonCompliantBoarding BoardingOperation)

(documentation NonCompliantBoarding EnglishWrittenLanguage
  "A boarding where available intelligence does not indicate a specific
   threat, but the vessel employs active or passive measures to prevent and/or
   impede the boarding phase of the operation, and any or all of the following
   conditions are met: the vessel fails to comply with on-scene commander
   directions; passive measures in place are intended to delay, impede,
   complicate, and/or deter access to spaces required for control of the
   vessel, but can be overcome by mechanical means; passive resistance
   measures in place are intended only to delay, impede, complicate, and/or
   deter search and seizure of the suspect vessel and can be overcome by
   mechanical means (Newport ROE Handbook, glossary).")

(termFormat EnglishWrittenLanguage NonCompliantBoarding
  "non-compliant boarding")

;; Rule 1: Compliant and non-compliant are disjoint
(disjoint CompliantBoarding NonCompliantBoarding)

;; Rule 2: Non-compliant boarding lacks cooperation
(=>
  (and
    (instance ?NCB NonCompliantBoarding)
    (patient ?NCB ?S)
    (instance ?S Ship)
    (agent ?NCB ?TEAM)
    (attribute ?CAPTAIN ShipCaptain)
    (member ?CAPTAIN
      (ShipCrewFn ?S)))
  (not
    (exists (?COOP)
      (and
        (instance ?COOP Cooperation)
        (agent ?COOP ?CAPTAIN)
        (agent ?COOP ?TEAM)
        (subProcess ?COOP ?NCB)))))

;; Rule 3: NonCompliant boarding may involve force
(=>
  (instance ?NCB NonCompliantBoarding)
  (modalAttribute
    (exists (?F ?S)
      (and
        (instance ?F Attack)
        (subProcess ?F ?NCB)
        (patient ?F ?S)
        (instance ?S Ship))) Possibility))
;; Rule 4: During a non-compliant boarding, the captain of the boarded ship
;; desires that his ship not be boarded. A desire is not a fact: the boarding
;; that takes place does not contradict it. Known limit: the rule reaches every
;; crew member bearing ShipCaptain; that the captain is in command at the time
;; is not stated separately.
(=>
  (and
    (instance ?NCB NonCompliantBoarding)
    (patient ?NCB ?S)
    (instance ?S Ship)
    (member ?CAPT
      (ShipCrewFn ?S))
    (attribute ?CAPT ShipCaptain))
  (holdsDuring
    (WhenFn ?NCB)
    (desires ?CAPT
      (not
        (exists (?B)
          (and
            (instance ?B BoardingOperation)
            (patient ?B ?S)
            (overlapsTemporally
              (WhenFn ?B)
              (WhenFn ?NCB))))))))

;; Rule 5: In a non-compliant boarding, the crew of the boarded ship takes a
;; measure, active or passive, whose purpose is to hinder boarding. The
;; measure begins no later than the end of the boarding, so a measure put in
;; place beforehand, such as locking doors, counts; that its effect still
;; lasts during the boarding is not stated, a known limit. Its success is not
;; required: the Handbook says the measures can be overcome. &%hinders takes a
;; class as its second argument (domainSubclass), and its axiom concerns the
;; likelihood of an instance of the class at the time and place of the measure,
;; so the purpose bears on this boarding.
(=>
  (and
    (instance ?NCB NonCompliantBoarding)
    (patient ?NCB ?S)
    (instance ?S Ship))
  (exists (?MEAS ?X)
    (and
      (instance ?MEAS IntentionalProcess)
      (agent ?MEAS ?X)
      (member ?X
        (ShipCrewFn ?S))
      (beforeOrEqual
        (BeginFn
          (WhenFn ?MEAS))
        (EndFn
          (WhenFn ?NCB)))
      (hasPurpose ?MEAS
        (hinders ?MEAS BoardingOperation)))))

;; 23. SearchOperation
(subclass SearchOperation Investigating)
(subclass SearchOperation MilitaryOperation)

(documentation SearchOperation EnglishWrittenLanguage
  "The systematic inspection of persons, vehicles, vessels, aircraft, or
   premises to locate weapons, contraband, or designated persons (Newport ROE
   Handbook).")

(termFormat EnglishWrittenLanguage SearchOperation "search")

;; Rule 1: A search operation takes place at a person, a vehicle or premises,
;; and its purpose is to learn whether something of a kind is there. The
;; parent is &%Investigating, not &%Searching: SUMO's &%Searching asserts that
;; the object sought exists and is located somewhere, so a search that finds
;; nothing could not be a &%Searching. Either outcome serves the purpose here.
(=>
  (and
    (instance ?S SearchOperation)
    (agent ?S ?A))
  (exists (?PLACE ?C)
    (and
      (eventLocated ?S ?PLACE)
      (or
        (instance ?PLACE Human)
        (instance ?PLACE Vehicle)
        (instance ?PLACE StationaryArtifact))
      (subclass ?C Physical)
      (hasPurposeForAgent ?S ?A
        (or
          (knows ?A
            (exists (?OBJ)
              (and
                (instance ?OBJ ?C)
                (located ?OBJ ?PLACE))))
          (knows ?A
            (not
              (exists (?OBJ)
                (and
                  (instance ?OBJ ?C)
                  (located ?OBJ ?PLACE))))))))))

;; Rule 2 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 24. Detention
(subclass Detention Confining)
(subclass Detention MilitaryProcess)
(disjoint Detention Imprisoning)

(documentation Detention EnglishWrittenLanguage
  "The temporary holding of a &%Human by an agent acting on authority
   conferred by a competent military authority, for example to prevent escape
   or to maintain security. Unlike &%Imprisoning, it is not the execution of a
   sentence, and unlike an arrest in law enforcement it does not place the
   person in judicial custody (Newport ROE Handbook).")

(termFormat EnglishWrittenLanguage Detention "detention")

;; Rule 1: Every patient of a detention is a human. &%Confining also covers
;; animals; a detention does not.
(=>
  (and
    (instance ?D Detention)
    (patient ?D ?P))
  (instance ?P Human))

;; Rule 2: The detaining agent acts on authority conferred by a higher
;; headquarters. Holding a person without such authority is not a detention:
;; it remains a &%Confining, or, with the purpose of leverage, a
;; &%HostageTaking. An earlier version stated (property ?D Legal), but &%Legal
;; applies to formulas, not to processes.
(=>
  (and
    (instance ?D Detention)
    (agent ?D ?A)
    (instance ?A CognitiveAgent))
  (exists (?HQ)
    (and
      (instance ?HQ HigherHeadquarters)
      (confersRight ?HQ ?A
        (agent ?D ?A)))))

;; 25. AutonomousWeaponSystem
(subclass AutonomousWeaponSystem Weapon)

(documentation AutonomousWeaponSystem EnglishWrittenLanguage
  "A weapon system that, once activated, can select and engage targets without
   further intervention by a human operator (Newport ROE Handbook, glossary).")

(termFormat EnglishWrittenLanguage AutonomousWeaponSystem
  "autonomous weapon system")

;; Rule 1: An autonomous weapon system can be the instrument of an autonomous
;; engagement. This states a capability of the kind of system, not a fact
;; about every use: a manual use does not contradict it. SUMO's axiom on
;; &%capability derives, for each instance that is a &%Device and is not
;; DeviceDamaged, the possibility of such an engagement; under the open world
;; that requires the absence of damage to be stated. The earlier rule stated as
;; a fact of every attack with the system that no human classified its target,
;; which a manual use contradicted.
(capability AutonomousEngagement instrument AutonomousWeaponSystem)

;; 26. SemiAutonomousWeaponSystem
(subclass SemiAutonomousWeaponSystem Weapon)

(documentation SemiAutonomousWeaponSystem EnglishWrittenLanguage
  "A weapon system that, once activated, is intended to only engage individual
   targets or specific target groups that have been selected by a human
   operator (Newport ROE Handbook, glossary).")

(termFormat EnglishWrittenLanguage SemiAutonomousWeaponSystem
  "semi-autonomous weapon system")

;; Rule 1: A semi-autonomous weapon system is made so that it attacks no
;; target that a human did not select for that attack: the "only" of the
;; Handbook definition. It is a purpose, so a use against the purpose remains
;; possible. Two limits: the link between a human selection and the attack is
;; the purpose of the selection, not a proof that it determined the attack;
;; and a selection of an individual target is represented, while the
;; Handbook's "specific target groups" is not treated separately.
(=>
  (instance ?SAWS SemiAutonomousWeaponSystem)
  (hasPurpose ?SAWS
    (not
      (exists (?ATTACK ?TARGET)
        (and
          (instance ?ATTACK Attack)
          (instrument ?ATTACK ?SAWS)
          (targetInAttack ?ATTACK ?TARGET)
          (not
            (exists (?H ?SEL)
              (and
                (instance ?H Human)
                (instance ?SEL Selecting)
                (agent ?SEL ?H)
                (patient ?SEL ?TARGET)
                (hasPurposeForAgent ?SEL ?H
                  (targetInAttack ?ATTACK ?TARGET))))))))))

;; Rule 2 removed. It made autonomous and semi-autonomous weapon systems
;; disjoint, so a system declared as both, such as a multi-mode close-in weapon
;; system, made the knowledge base inconsistent. A system may now be both; its
;; use then falls under Series 83 and Series 84, and the means clearance of
;; ROE_Supplementary.kif requires both to clear it, so the restrictive default
;; of Series 84 still governs. Being both is not implied by having a manual
;; mode: a system with an autonomous mode is not intended to only engage
;; targets selected by a human.

;; 26b. AutonomousEngagement
(subclass AutonomousEngagement Attack)

(documentation AutonomousEngagement EnglishWrittenLanguage
  "An &%Attack in which the weapon system used selects and engages the target
   without further intervention by a human operator after it is activated: the
   target is determined by a process that uses the system itself, and no human
   act brings about the engagement or is carried out to give it this target.")

(termFormat EnglishWrittenLanguage AutonomousEngagement "autonomous engagement")

;; Rule 1: In an autonomous engagement, a process that uses the weapon system
;; itself determines the target and brings about the engagement, and no human
;; act either brings it about directly or is carried out with the purpose that
;; it have this target. Activating the system or setting its parameters is
;; not excluded: its purpose is general, not this target for this attack, and
;; its effect on the engagement is mediated by the system's own process, since
;; &%causes is not transitive. An approval required for each engagement brings
;; the engagement about and is excluded. The &%Attack still has a cognitive
;; agent, as an &%IntentionalProcess; this does not say who that agent is.
;;
;; Known limits. This is a necessary condition, not a complete definition of
;; the Handbook notion. The process ?P uses the system and has the target as
;; patient, but nothing types it as a target selection, so a tracking process
;; of the weapon fed with a target chosen by another automated system is not
;; excluded. Whether a human act counts as a direct cause depends on how the
;; scenario states causation: a scenario that states the activation itself as
;; a cause of the engagement excludes it. The capability axiom of item 25 says
;; that such an engagement is possible with an undamaged system, not that one
;; occurs.
(=>
  (and
    (instance ?E AutonomousEngagement)
    (instrument ?E ?W)
    (instance ?W Weapon)
    (targetInAttack ?E ?TARGET))
  (and
    (exists (?P)
      (and
        (instrument ?P ?W)
        (patient ?P ?TARGET)
        (causes ?P ?E)))
    (not
      (exists (?H ?ACT)
        (and
          (instance ?H Human)
          (instance ?ACT IntentionalProcess)
          (agent ?ACT ?H)
          (or
            (causes ?ACT ?E)
            (hasPurposeForAgent ?ACT ?H
              (targetInAttack ?E ?TARGET))))))))

;; 27. HigherHeadquarters
(subclass HigherHeadquarters MilitaryOrganization)

(documentation HigherHeadquarters EnglishWrittenLanguage
  "A higher-level military headquarters that exercises command and control
   over subordinate units, including authority to approve or deny Rules of
   Engagement (ROE)-regulated operations.")

(termFormat EnglishWrittenLanguage HigherHeadquarters "higher headquarters")

;; Rule 1: HigherHeadquarters has at least one subordinate unit
(=>
  (instance ?HQ HigherHeadquarters)
  (exists (?UNIT)
    (and
      (instance ?UNIT MilitaryOrganization)
      (ancestorOrganization ?UNIT ?HQ))))

;; Rule 2: HigherHeadquarters has the power to approve requests from
;; subordinates
(=>
  (and
    (instance ?HQ HigherHeadquarters)
    (instance ?UNIT MilitaryOrganization)
    (ancestorOrganization ?UNIT ?HQ)
    (instance ?REQ Requesting)
    (agent ?REQ ?UNIT)
    (destination ?REQ ?HQ))
  (modalAttribute
    (approves ?HQ ?UNIT) Possibility))

;; Rule 3 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 28. OpposedBoarding
(subclass OpposedBoarding NonCompliantBoarding)
(documentation OpposedBoarding EnglishWrittenLanguage
  "A boarding operation where active or passive resistance measures are
   intended to inflict serious bodily harm or death to the boarding team, the
   suspect vessel has demonstrated intent to actively oppose the boarding,
   intelligence indicates a known threat, or any hostile action including
   threatening display of weapons is present (Newport ROE Handbook).")

(termFormat EnglishWrittenLanguage OpposedBoarding "opposed boarding")

;; Rule 1: OpposedBoarding involves HostileAct or HostileIntent
;; directed at the boarding team
(=>
  (and
    (instance ?OB OpposedBoarding)
    (agent ?OB ?TEAM)
    (instance ?TEAM MilitaryOrganization))
  (exists (?T)
    (and
      (instance ?T HostileConduct)
      (patient ?T ?TEAM))))

;; Rule 2 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; Rule 3 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 29. InnocentPassage
(subclass InnocentPassage MaritimeOperation)
(documentation InnocentPassage EnglishWrittenLanguage
  "The right of foreign ships to pass through a State's territorial sea
   continuously and expeditiously, provided the passage is not prejudicial to
   the peace, good order, or security of the coastal State (UNCLOS Article
   17-19).")
(termFormat EnglishWrittenLanguage InnocentPassage "innocent passage")

;; Rule 1: InnocentPassage occurs in TerritorialSea
(=>
  (instance ?IP InnocentPassage)
  (exists (?TS)
    (and
      (instance ?TS TerritorialSea)
      (areaOfOperation ?TS ?IP))))

;; Rule 2: InnocentPassage involves no HostileAct
(=>
  (instance ?IP InnocentPassage)
  (not
    (exists (?HA)
      (and
        (instance ?HA HostileAct)
        (subProcess ?HA ?IP)))))

;; Rule 3: Coastal State cannot blockade InnocentPassage
(=>
  (and
    (instance ?IP InnocentPassage)
    (instance ?SHIP Ship)
    (agent ?IP ?SHIP)
    (instance ?TS TerritorialSea)
    (areaOfOperation ?TS ?IP)
    (instance ?STATE Nation)
    (claimedTerritory ?TS ?STATE))
  (not
    (exists (?BL)
      (and
        (instance ?BL Blockade)
        (agent ?BL ?STATE)
        (patient ?BL ?SHIP)))))

;; 30. TransitPassage
(subclass TransitPassage MaritimeOperation)
(documentation TransitPassage EnglishWrittenLanguage
  "The right of ships and aircraft to pass through straits used for
   international navigation continuously and expeditiously. Unlike innocent
   passage, transit passage cannot be suspended by the bordering State (UNCLOS
   Article 37-44).")
(termFormat EnglishWrittenLanguage TransitPassage "transit passage")

;; Rule 1: TransitPassage occurs through a Strait
(=>
  (instance ?TP TransitPassage)
  (exists (?ST)
    (and
      (instance ?ST Strait)
      (areaOfOperation ?ST ?TP))))

;; Rule 2: TransitPassage cannot be suspended by bordering State
(=>
  (and
    (instance ?TP TransitPassage)
    (instance ?ST Strait)
    (areaOfOperation ?ST ?TP)
    (instance ?STATE Nation)
    (claimedTerritory ?ST ?STATE))
  (not
    (exists (?BL)
      (and
        (instance ?BL Blockade)
        (agent ?BL ?STATE)
        (patient ?BL ?TP)))))

;; Rule 3: InnocentPassage and TransitPassage are disjoint
(disjoint InnocentPassage TransitPassage)

;; 31. EscalationOfForce
(subclass EscalationOfForce UseOfForce)

;; Per the Newport Handbook, escalation of force procedures do not limit the
;; right of self-defense.
(documentation EscalationOfForce EnglishWrittenLanguage
  "A process in which an agent increases the level or intensity of force in
   response to a developing threat, typically moving from non-lethal measures
   such as warnings and warning shots to disabling fire and, if necessary,
   deadly force.")
(termFormat EnglishWrittenLanguage EscalationOfForce "escalation of force")

;; Rule 1: EscalationOfForce is composed of two ordered subprocesses, the later
;; a UseOfForce. The earlier need not be one: Rule 2 builds an escalation from a
;; warning shot, which is not a use of force in this ontology, and requiring
;; two uses of force made Rule 2 conjure a use of force that never occurred.
(=>
  (instance ?EOF EscalationOfForce)
  (exists (?U1 ?U2)
    (and
      (instance ?U1 Process)
      (instance ?U2 UseOfForce)
      (subProcess ?U1 ?EOF)
      (subProcess ?U2 ?EOF)
      (not
        (equal ?U1 ?U2))
      (earlier
        (WhenFn ?U1)
        (WhenFn ?U2)))))

;; Rule 2: WarningShot followed by DisablingFire is an EscalationOfForce
(=>
  (and
    (instance ?WS WarningShot)
    (instance ?DF DisablingFire)
    (agent ?WS ?A)
    (agent ?DF ?A)
    (patient ?WS ?TARGET)
    (patient ?DF ?TARGET)
    (earlier
      (WhenFn ?WS)
      (WhenFn ?DF)))
  (exists (?EOF)
    (and
      (instance ?EOF EscalationOfForce)
      (agent ?EOF ?A)
      (subProcess ?WS ?EOF)
      (subProcess ?DF ?EOF))))

;; Rule 3: DisablingFire followed by Attack is an EscalationOfForce
(=>
  (and
    (instance ?DF DisablingFire)
    (instance ?ATK Attack)
    (agent ?DF ?A)
    (agent ?ATK ?A)
    (patient ?DF ?TARGET)
    (patient ?ATK ?TARGET)
    (earlier
      (WhenFn ?DF)
      (WhenFn ?ATK)))
  (exists (?EOF)
    (and
      (instance ?EOF EscalationOfForce)
      (agent ?EOF ?A)
      (subProcess ?DF ?EOF)
      (subProcess ?ATK ?EOF))))

;; 32. MaritimeInterdictionOperation
(subclass MaritimeInterdictionOperation MaritimeOperation)

(documentation MaritimeInterdictionOperation EnglishWrittenLanguage
  "A maritime operation in which naval or coalition forces monitor, query,
   stop, board, search, and possibly divert or detain vessels to enforce
   sanctions, embargoes, or other mandates authorized by competent authority,
   such as the UN Security Council.")

(termFormat EnglishWrittenLanguage MaritimeInterdictionOperation
  "maritime interdiction operation")

;; Rule 1: A maritime interdiction operation may include a boarding. An
;; earlier version required one in every operation, but an interdiction may
;; consist only of monitoring and querying. Whether the master of a vessel
;; desires the interdiction is not stated for the class: a vessel may comply
;; willingly, so an unwillingness is stated per scenario.
(=>
  (instance ?MIO MaritimeInterdictionOperation)
  (modalAttribute
    (exists (?BO)
      (and
        (instance ?BO BoardingOperation)
        (subProcess ?BO ?MIO)))
    Possibility))

;; Rule 2 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 33. VisitAndSearchOperation
(subclass VisitAndSearchOperation MaritimeInterdictionOperation)

(documentation VisitAndSearchOperation EnglishWrittenLanguage
  "A maritime interdiction operation in which a warship or authorized vessel
   stops, boards, and searches a merchant or suspect vessel to verify its
   identity, cargo, and compliance with applicable mandates, typically without
   an initial intent to detain or divert the vessel.")

(termFormat EnglishWrittenLanguage VisitAndSearchOperation
  "visit and search operation")

;; Rule 1: VisitAndSearchOperation involves a BoardingOperation and a
;; SearchOperation as subprocesses
(=>
  (instance ?VAS VisitAndSearchOperation)
  (exists (?BO ?SO)
    (and
      (instance ?BO BoardingOperation)
      (instance ?SO SearchOperation)
      (subProcess ?BO ?VAS)
      (subProcess ?SO ?VAS)
      (subProcess ?SO ?BO))))

;; Rule 2 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).

;; 34. IndirectFire
(subclass IndirectFire Shooting)

(documentation IndirectFire EnglishWrittenLanguage
  "A form of shooting in which a weapon delivers fire at a target that is not
   visible to the firer, typically using calculated firing data and observer
   corrections, as in artillery or naval gunfire support.")
(termFormat EnglishWrittenLanguage IndirectFire "indirect fire")

;; Rule: During indirect fire, the firer does not see the target. Seeing it
;; before or after the fire, for example to verify the effect, is not
;; excluded. Partial overlap is enough to count as seeing during the fire.
(=>
  (and
    (instance ?IF IndirectFire)
    (agent ?IF ?A)
    (patient ?IF ?T))
  (not
    (exists (?SEE)
      (and
        (instance ?SEE Seeing)
        (agent ?SEE ?A)
        (patient ?SEE ?T)
        (overlapsTemporally
          (WhenFn ?SEE)
          (WhenFn ?IF))))))

;; 35. ObservedIndirectFire
(subclass ObservedIndirectFire IndirectFire)
(documentation ObservedIndirectFire EnglishWrittenLanguage
  "Indirect fire in which a forward observer or spotter observes the fall of
   shot and provides corrections to improve accuracy.")
(termFormat EnglishWrittenLanguage ObservedIndirectFire
  "observed indirect fire")

;; Rule: During observed indirect fire, an observer who is not the firer, and
;; who belongs to the firer's organization or to an allied one, sees where
;; the fire falls. The same scope of observer is used in item 36, so the two
;; classes divide indirect fire by the presence of a friendly observer. The
;; target stands for the point of impact or burst, for which SUMO has no term;
;; this is an approximation, not a full formalization of the Handbook notion.
(=>
  (and
    (instance ?OIF ObservedIndirectFire)
    (agent ?OIF ?A)
    (patient ?OIF ?T)
    (member ?A ?ORG))
  (exists (?OBS ?SEE)
    (and
      (instance ?SEE Seeing)
      (agent ?SEE ?OBS)
      (patient ?SEE ?T)
      (not
        (agent ?OIF ?OBS))
      (overlapsTemporally
        (WhenFn ?SEE)
        (WhenFn ?OIF))
      (or
        (member ?OBS ?ORG)
        (exists (?ORG2)
          (and
            (member ?OBS ?ORG2)
            (allied ?ORG ?ORG2)))))))

;; 36. UnobservedIndirectFire
(subclass UnobservedIndirectFire IndirectFire)
(documentation UnobservedIndirectFire EnglishWrittenLanguage
  "Indirect fire delivered without a forward observer, relying solely on
   pre-calculated firing data without real-time corrections.")
(termFormat EnglishWrittenLanguage UnobservedIndirectFire
  "unobserved indirect fire")

;; Rule: During unobserved indirect fire, no member of the firer's
;; organization or of an allied organization sees where the fire falls. An
;; observation by the adversary or by a third party is not excluded. The
;; target stands for the point of impact or burst, as in item 35.
(=>
  (and
    (instance ?UIF UnobservedIndirectFire)
    (agent ?UIF ?A)
    (patient ?UIF ?T)
    (member ?A ?ORG))
  (not
    (exists (?OBS ?SEE)
      (and
        (instance ?SEE Seeing)
        (agent ?SEE ?OBS)
        (patient ?SEE ?T)
        (overlapsTemporally
          (WhenFn ?SEE)
          (WhenFn ?UIF))
        (or
          (member ?OBS ?ORG)
          (exists (?ORG2)
            (and
              (member ?OBS ?ORG2)
              (allied ?ORG ?ORG2))))))))

;; Partition
(disjoint ObservedIndirectFire UnobservedIndirectFire)

;; 37. DirectFire
(subclass DirectFire Shooting)

(documentation DirectFire EnglishWrittenLanguage
  "Fire directed at a target that is visible to the aimer. The target itself
   is used as a point of aim for either the weapon or the director.")

(termFormat EnglishWrittenLanguage DirectFire "direct fire")

;; Rule 1: During direct fire, the firer sees the target. Partial overlap is
;; enough to count as seeing during the fire.
(=>
  (and
    (instance ?DF DirectFire)
    (agent ?DF ?A)
    (patient ?DF ?T))
  (exists (?SEE)
    (and
      (instance ?SEE Seeing)
      (agent ?SEE ?A)
      (patient ?SEE ?T)
      (overlapsTemporally
        (WhenFn ?SEE)
        (WhenFn ?DF)))))

;; Rule 2: DirectFire and IndirectFire disjoint
(disjoint DirectFire IndirectFire)

;; 38. DirectedEnergyWeapon
(subclass DirectedEnergyWeapon Weapon)
(documentation DirectedEnergyWeapon EnglishWrittenLanguage
  "A weapon or system that uses highly focused or directed energy, such as
   lasers, microwaves, and particle beams, to incapacitate, damage, or destroy
   enemy equipment, facilities, and/or personnel.")
(termFormat EnglishWrittenLanguage DirectedEnergyWeapon
  "directed energy weapon")

;; Rule 1: A directed energy weapon can be the instrument of a process in
;; which energy is radiated, whether or not the process is a use of force, for
;; example a test against a mountain. &%Radiating rather than
;; &%RadiatingElectromagnetic, since particle beams are directed energy but not
;; electromagnetic. This is a capability: it does not produce a radiating
;; event, and it does not classify every use of the weapon as radiating. An
;; earlier rule produced radiation only within a use of force.
(capability Radiating instrument DirectedEnergyWeapon)

;; Rule 2: A laser employed as a weapon is a DirectedEnergyWeapon
(subclass LaserWeapon DirectedEnergyWeapon)
(subclass LaserWeapon Laser)
(documentation LaserWeapon EnglishWrittenLanguage
  "A laser device employed as a weapon, that is, one whose emitted energy is
   directed at persons or materiel in order to incapacitate, damage, or
   destroy.")
(termFormat EnglishWrittenLanguage LaserWeapon "laser weapon")

;; Rule 3: DEW use in an attack is a use of force
(=>
  (and
    (instance ?DEW DirectedEnergyWeapon)
    (instance ?PROC Attack)
    (instrument ?PROC ?DEW))
  (instance ?PROC UseOfForce))

;; 39. ExclusionZone
(subclass ExclusionZone GeographicArea)
(documentation ExclusionZone EnglishWrittenLanguage
  "A zone established by a sanctioning body to prohibit specific activities in
   a specific geographic area (Newport ROE Handbook, glossary).")
(termFormat EnglishWrittenLanguage ExclusionZone "exclusion zone")

;; Supporting relation for items 39, 51 and 57: a restriction an authority
;; announces for a zone. The announcement aims at a prohibition; it does not by
;; itself confer one, so a process falling under it is not thereby prohibited
;; or unlawful. The valid prohibition is the separate relation
;; &%zoneProhibition in ROE_Deontic.kif.
;; Known limits: the relation entails that an announcement took place and that
;; it refers to the zone, but not that the announcement established the zone,
;; nor when it was made or from when and for how long the restriction applies.
;; The restricted processes and agents are given positively, as classes; a
;; scope such as "everyone except the coalition" needs a positive class of its
;; own, since under the open world assumption the absence of membership cannot
;; be derived.
(instance zoneRestriction QuaternaryPredicate)
(domain zoneRestriction 1 AutonomousAgent)
(domain zoneRestriction 2 GeographicArea)
(domainSubclass zoneRestriction 3 Process)
(domainSubclass zoneRestriction 4 AutonomousAgent)
(documentation zoneRestriction EnglishWrittenLanguage
  "(&%zoneRestriction ?AUTH ?ZONE ?PROC ?AGENT) means that ?AUTH announces
   that processes of type ?PROC located in ?ZONE, whose agent is an instance
   of ?AGENT, are prohibited.")
(termFormat EnglishWrittenLanguage zoneRestriction "zone restriction")
(format EnglishWrittenLanguage zoneRestriction
  "%1 %n announces a prohibition of %3 in %2 by %4")

;; Rule: A zone restriction is made by an announcement of the authority that
;; refers to the zone and whose purpose is the prohibition. &%hasPurpose does
;; not entail that the prohibition holds.
(=>
  (zoneRestriction ?AUTH ?ZONE ?PROC ?AGENT)
  (exists (?ANN)
    (and
      (instance ?ANN Stating)
      (agent ?ANN ?AUTH)
      (refers ?ANN ?ZONE)
      (hasPurpose ?ANN
        (modalAttribute
          (exists (?X ?A)
            (and
              (instance ?X ?PROC)
              (eventLocated ?X ?ZONE)
              (agent ?X ?A)
              (instance ?A ?AGENT)))
          Prohibition)))))

;; Rule 1: A sanctioning body announces a restriction on some specific kind of
;; activity in an exclusion zone, by some class of agents; which kinds are
;; stated per scenario with &%zoneRestriction. An exclusion zone is a type of
;; maritime warning zone, so the restriction is one the body purports to
;; impose: entering the zone is not thereby unlawful. An earlier version
;; conferred a prohibition on every translocation in the zone.
(=>
  (instance ?EZ ExclusionZone)
  (exists (?AUTH ?PROC ?AGENT)
    (zoneRestriction ?AUTH ?EZ ?PROC ?AGENT)))

;; Rule 2 removed: it concluded (attribute ?SHIP Illegal) for a ship in the
;; zone without permission. Its negated antecedent could never be proved under
;; the open world assumption, &%Illegal applies to formulas rather than
;; objects, and being in the zone does not by itself make a ship's conduct
;; unlawful.

;; 40. ForceProtection
(subclass ForceProtection Protecting)
(documentation ForceProtection EnglishWrittenLanguage
  "Actions taken to prevent or mitigate hostile actions against personnel
   (including family members), resources, facilities, and critical
   information. Force protection does not include actions to defeat the enemy
   or protect against accidents, weather, or disease (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage ForceProtection "force protection")

;; Rule 1: ForceProtection protects personnel, resources, or facilities
(=>
  (instance ?FP ForceProtection)
  (exists (?P)
    (and
      (instance ?P Object)
      (patient ?FP ?P))))

;; Rule 2: Force protection includes no attack other than self-defense. The
;; Handbook excludes "actions to defeat the enemy"; fire in self-defense
;; against an attacker may still be part of protecting the force. An earlier
;; version excluded every attack, including defensive fire.
(=>
  (instance ?FP ForceProtection)
  (not
    (exists (?ATK)
      (and
        (instance ?ATK Attack)
        (subProcess ?ATK ?FP)
        (not
          (instance ?ATK SelfDefense))))))

;; Rule 3: The purpose of force protection is that no hostile act is committed
;; against what it protects while it lasts. It is a purpose, so a protection
;; that fails is still force protection. The "mitigate" of the Handbook, a
;; reduction of the harm done, is not represented.
(=>
  (and
    (instance ?FP ForceProtection)
    (patient ?FP ?P))
  (hasPurpose ?FP
    (not
      (exists (?H)
        (and
          (instance ?H HostileAct)
          (patient ?H ?P)
          (overlapsTemporally
            (WhenFn ?H)
            (WhenFn ?FP)))))))

;; 41. HorsDeCombat
(instance HorsDeCombat SocialRole)
(documentation HorsDeCombat EnglishWrittenLanguage
  "A person who: (1) is in the power of an adverse party; (2) clearly
   expresses an intention to surrender; or (3) has been rendered unconscious
   or incapacitated by wounds or sickness, or shipwreck, and is incapable of
   defending himself, provided they abstain from hostilities and do not try to
   escape.")
(termFormat EnglishWrittenLanguage HorsDeCombat "hors de combat")

;; Supporting terms
(subclass Surrendering IntentionalProcess)
(documentation Surrendering EnglishWrittenLanguage
  "An intentional process by which a person clearly expresses the intention to
   cease resistance and submit to an adverse party.")
(termFormat EnglishWrittenLanguage Surrendering "surrendering")

(instance Incapacitated BiologicalAttribute)
;; A person bearing it is hors de combat under the law of armed conflict
;; (Newport ROE Handbook, Annex D).
(documentation Incapacitated EnglishWrittenLanguage
  "The attribute of a person rendered unable to fight by wounds, sickness or
   other cause (Newport ROE Handbook, Annex D).")
(termFormat EnglishWrittenLanguage Incapacitated "incapacitated")
(instance Wounded BiologicalAttribute)
;; Being wounded does not by itself make a person hors de combat: under the law
;; of armed conflict that requires being incapacitated by the wounds, and
;; therefore incapable of defending oneself (Newport ROE Handbook, glossary).
(documentation Wounded EnglishWrittenLanguage
  "The attribute of a person who has been wounded (Newport ROE Handbook,
   glossary).")
(termFormat EnglishWrittenLanguage Wounded "wounded")
(instance Shipwrecked SocialRole)
;; A shipwrecked person who abstains from hostile acts is hors de combat under
;; the law of armed conflict (Newport ROE Handbook, Annex D).
(documentation Shipwrecked EnglishWrittenLanguage
  "The attribute of a person in peril at sea as a result of misfortune
   affecting the person or the vessel or aircraft carrying them (Newport ROE
   Handbook, Annex D).")
(termFormat EnglishWrittenLanguage Shipwrecked "shipwrecked")

;; Rule 1: Under the law of armed conflict, an attack must not be directed at
;; a person who is hors de combat when the attack begins (Additional Protocol I
;; Article 41). The status is in the antecedent, so for a particular attack
;; and person the rule gives the obligation (not (targetInAttack ?ATK ?P))
;; directly, and modals.kif turns it into the prohibition of
;; (targetInAttack ?ATK ?P) with no further reasoning inside the modal
;; formula. It is the de re form: one obligation for each attack and person.
;; Known limits: Article 41 also requires that the person is, or should in the
;; circumstances be, recognized as hors de combat; that epistemic threshold is
;; not represented. The status is evaluated at the beginning of the attack, so
;; a person who surrenders during an ongoing attack is not reassessed within
;; the same attack. An earlier version, in ROE_Deontic.kif, prohibited any
;; attack with the person as a patient overlapping the period of the status,
;; stated with &%Prohibition rather than under &%LawOfArmedConflict; before
;; that it withheld the attacker's own permission.
(=>
  (and
    (instance ?ATK Attack)
    (instance ?P Human)
    (holdsDuring (BeginFn (WhenFn ?ATK))
      (attribute ?P HorsDeCombat)))
  (modalAttribute
    (not
      (targetInAttack ?ATK ?P))
    LawOfArmedConflict))

;; Rule 2: While a person is hors de combat, the person is held, has
;; surrendered, or is incapacitated or shipwrecked, and during that time does
;; not commit a hostile act or try to escape (the proviso of the Handbook
;; definition). The status is stated per scenario for a period; it is not
;; derived from an event, because the proviso cannot be checked in the
;; antecedent of a sufficient rule. Known limits: &%Confining stands for "in
;; the power of an adverse party", which is broader than being held; and a
;; person declared hors de combat who commits a hostile act in the same period
;; makes the knowledge base inconsistent rather than ending the status.
;; An earlier version had three sufficient rules (detention, surrender,
;; incapacitation) with no time and no proviso, and counted any wounded person.
(=>
  (holdsDuring ?T
    (attribute ?P HorsDeCombat))
  (and
    (or
      (exists (?C)
        (and
          (instance ?C Confining)
          (patient ?C ?P)
          (overlapsTemporally
            (WhenFn ?C)
            ?T)))
      (exists (?S)
        (and
          (instance ?S Surrendering)
          (agent ?S ?P)
          (beforeOrEqual
            (EndFn
              (WhenFn ?S))
            (BeginFn ?T))))
      (holdsDuring ?T
        (attribute ?P Incapacitated))
      (holdsDuring ?T
        (attribute ?P Shipwrecked)))
    (not
      (exists (?H)
        (and
          (instance ?H HostileConduct)
          (agent ?H ?P)
          (overlapsTemporally
            (WhenFn ?H)
            ?T))))
    (not
      (exists (?E)
        (and
          (instance ?E Escaping)
          (agent ?E ?P)
          (overlapsTemporally
            (WhenFn ?E)
            ?T))))))

;; 42. HostNation
;; HostNation is defined in SUMO (MilitaryProcesses.kif), with the same
;; superclass, documentation and termFormat, so it is not redeclared here. The
;; rules below use the SUMO term.

;; Rule 1: HostNation consents to foreign forces operating on or transiting
;; its territory
(=>
  (and
    (instance ?HN HostNation)
    (instance ?UNIT MilitaryOrganization)
    (instance ?STATE Nation)
    (not
      (equal ?HN ?STATE))
    (member ?UNIT ?STATE))
  (confersNorm ?HN Permission
    (exists (?OP)
      (and
        (or
          (instance ?OP MilitaryOperation)
          (instance ?OP Translocation))
        (agent ?OP ?UNIT)
        (eventLocated ?OP ?HN)))))

;; 43. HumanSupervisedAutonomousWeaponSystem
(subclass HumanSupervisedAutonomousWeaponSystem AutonomousWeaponSystem)
(documentation HumanSupervisedAutonomousWeaponSystem EnglishWrittenLanguage
  "An autonomous weapon system that is designed to provide human operators
   with the ability to intervene and terminate engagement at any point during
   operation (Newport ROE Handbook, glossary).")
(termFormat EnglishWrittenLanguage HumanSupervisedAutonomousWeaponSystem
  "human-supervised autonomous weapon system")

;; Rule 1: HumanSupervisedAutonomousWeaponSystem has a human operator
(=>
  (instance ?HSAWS HumanSupervisedAutonomousWeaponSystem)
  (exists (?OP)
    (and
      (instance ?OP Human)
      (operator ?HSAWS ?OP))))

;; Rule 2: Human operator is permitted to decide to cease engagement
(=>
  (and
    (instance ?HSAWS HumanSupervisedAutonomousWeaponSystem)
    (instance ?OP Human)
    (operator ?HSAWS ?OP)
    (instance ?ENG MilitaryOperation)
    (instrument ?ENG ?HSAWS))
  (modalAttribute
    (exists (?DEC)
      (and
        (instance ?DEC Deciding)
        (agent ?DEC ?OP)
        (patient ?DEC ?ENG))) Permission))

;; 44. TacticalIllumination
(subclass TacticalIllumination MilitaryOperation)
;; Illuminating a target creates the technical capability to engage it; it
;; confers no authorization to do so, and per Appendix 4 paragraph 4.3 of the
;; Handbook illumination may itself be read by the other party as a hostile
;; intent indicator in conditions of high or escalating tension.
(documentation TacticalIllumination EnglishWrittenLanguage
  "The process of adding infrared or visible light to the zone of action by
   various means, including searchlights, thermal imagery, lasers,
   pyrotechnics, and flares, for purposes including targeting and improving
   visibility. For ROE purposes, also includes the use of fire control radar
   to generate a firing solution (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage TacticalIllumination "tactical illumination")

;; Rule 1: TacticalIllumination results in Illuminated attribute
;; on the target area
(=>
  (and
    (instance ?TI TacticalIllumination)
    (patient ?TI ?REGION)
    (instance ?REGION Region))
  (holdsDuring
    (WhenFn ?TI)
    (attribute ?REGION Illuminated)))

;; Rule 2: TacticalIllumination involves RadiatingElectromagnetic
(=>
  (instance ?TI TacticalIllumination)
  (exists (?RAD)
    (and
      (instance ?RAD RadiatingElectromagnetic)
      (subProcess ?RAD ?TI))))

;; Rule 3: TacticalIllumination makes engagement technically possible
(=>
  (and
    (instance ?TI TacticalIllumination)
    (agent ?TI ?A)
    (patient ?TI ?TARGET))
  (modalAttribute
    (exists (?ATK)
      (and
        (instance ?ATK Attack)
        (agent ?ATK ?A)
        (patient ?ATK ?TARGET))) Possibility))

;; 45. InformationEnvironment
(subclass InformationEnvironment CollectionOfObjects)
(documentation InformationEnvironment EnglishWrittenLanguage
  "The aggregate of individuals, organizations, and systems that collect,
   process, disseminate, or act on information. The information environment is
   where humans and automated systems observe, orient, decide, and act upon
   information (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage InformationEnvironment
  "information environment")

;; Rule 1: InformationEnvironment contains agents and systems
(=>
  (instance ?IE InformationEnvironment)
  (exists (?A ?S)
    (and
      (instance ?A CognitiveAgent)
      (instance ?S ComputerSystem)
      (member ?A ?IE)
      (member ?S ?IE))))

;; Rule 2: InformationEnvironment is the domain of InformationOperation
(=>
  (instance ?IO InformationOperation)
  (exists (?IE ?A)
    (and
      (instance ?IE InformationEnvironment)
      (agent ?IO ?A)
      (member ?A ?IE)
      (areaOfOperation ?IE ?IO))))

;; 46. Airspace
(subclass Airspace AtmosphericRegion)
(documentation Airspace EnglishWrittenLanguage
  "A defined volume of EarthsAtmosphere above a specific geographic area,
   extending from the earth's surface upward, over which a State may exercise
   sovereignty or which may be designated for specific uses under
   international law.")
(termFormat EnglishWrittenLanguage Airspace "airspace")

;; Rule 1: Airspace is above a GeographicArea
(=>
  (instance ?AS Airspace)
  (exists (?GA)
    (and
      (instance ?GA GeographicArea)
      (orientation ?AS ?GA Above))))

;; Rule 2 moved to ROE_Deontic.kif (legal status of flight, kept out of the main
;; knowledge base).

;; 47. InternationalAirspace
(subclass InternationalAirspace Airspace)
(documentation InternationalAirspace EnglishWrittenLanguage
  "Areas of airspace not subject to the sovereignty of a State, including
   airspace over the contiguous zone, EEZ, high seas, and territories not
   subject to national sovereignty.")
(termFormat EnglishWrittenLanguage InternationalAirspace
  "international airspace")

;; Rule 1: No sovereignty
(=>
  (instance ?IA InternationalAirspace)
  (not
    (exists (?STATE)
      (and
        (instance ?STATE Nation)
        (possesses ?STATE ?IA)))))

;; Rule 2: Airspace above international waters is international airspace
(=>
  (and
    (instance ?IW InternationalWaters)
    (instance ?AS Airspace)
    (orientation ?AS ?IW Above))
  (instance ?AS InternationalAirspace))

;; Rule 3 moved to ROE_Deontic.kif (legal status of flight, kept out of the main
;; knowledge base).

;; 48. LawOfArmedConflict
;; A deontic attribute, as SUMO represents law: (modalAttribute ?F
;; LawOfArmedConflict) means that ?F is required under the law of armed
;; conflict. A prohibition is the requirement of a negation. An earlier
;; version made it an &%Agreement, which customary law is not.
;; Known limits: the attribute represents obligations arising under LOAC. It
;; does not by itself represent the complete body of LOAC, including the
;; permissions and authorizations it gives (such as belligerent rights) and
;; the conditions under which it applies to a particular armed conflict. Since
;; &%modalAttribute is a subrelation of &%property and &%subAttribute is
;; inherited through &%property, what follows from (modalAttribute ?F
;; LawOfArmedConflict) is (property ?F InternationalLaw), not (modalAttribute
;; ?F InternationalLaw); that entailment is untested.
(instance LawOfArmedConflict DeonticAttribute)
(subAttribute LawOfArmedConflict InternationalLaw)
(documentation LawOfArmedConflict EnglishWrittenLanguage
  "An &%Attribute that applies to &%Propositions that express the
   international law governing the conduct of armed conflict, also known as
   International Humanitarian Law (IHL) or the Law of War, including the
   Geneva Conventions, the Hague Conventions and customary international
   law.")
(termFormat EnglishWrittenLanguage LawOfArmedConflict "law of armed conflict")
(conventionalShortName "LOAC" LawOfArmedConflict)
(conventionalLongName "Law of Armed Conflict" LawOfArmedConflict)

;; 49. MaritimeSecurityOperation
(subclass MaritimeSecurityOperation MaritimeOperation)
(documentation MaritimeSecurityOperation EnglishWrittenLanguage
  "All maritime operations that are not conducted under Law of Armed Conflict
   (LOAC)-based authorizations, including maritime interdiction operations,
   counter-piracy operations, maritime law enforcement operations, and UN
   Security Council sanctions enforcement operations (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage MaritimeSecurityOperation
  "maritime security operation")

;; Rule 1 removed. It stated that the law of armed conflict did not confer a
;; permission on the formula that the operation is a maritime security
;; operation, which says nothing about the operation; and &%confersNorm is an
;; act of conferring, not a standing state. What distinguishes a maritime
;; security operation is the legal basis of its authority (a UN Security
;; Council resolution, flag State consent, domestic law) rather than the law of
;; armed conflict. That is not derivable from whether the operation is part of
;; an armed conflict, since an operation on a non-LOAC basis may be part of a
;; wider campaign. A positive relation for the legal basis of an operation is
;; left for the normative architecture (Group 5).

;; Rule 2: MIO is a subclass of MaritimeSecurityOperation
(subclass MaritimeInterdictionOperation MaritimeSecurityOperation)

;; Rule 3: CounterPiracyOperation is a subclass
(subclass CounterPiracyOperation MaritimeSecurityOperation)
(documentation CounterPiracyOperation EnglishWrittenLanguage
  "A maritime security operation conducted to deter, suppress, or respond to
   acts of piracy, including the boarding, search, and detention of vessels
   reasonably suspected of piracy in international waters.")
(termFormat EnglishWrittenLanguage CounterPiracyOperation
  "counter-piracy operation")

;; Rule 4: MaritimeLawEnforcementOperation is a subclass
(subclass MaritimeLawEnforcementOperation MaritimeSecurityOperation)
(documentation MaritimeLawEnforcementOperation EnglishWrittenLanguage
  "A maritime security operation conducted to enforce domestic or
   international law at sea, including fisheries, customs, migration, and
   narcotics enforcement.")
(termFormat EnglishWrittenLanguage MaritimeLawEnforcementOperation
  "maritime law enforcement operation")

;; Rule 5: The purpose of a counter-piracy operation is that no maritime piracy
;; takes place in its area while it lasts. It is a purpose, so piracy during
;; the operation does not contradict it. Limits: the area is the one the
;; operation is located in, which may not be the whole area it covers; and a
;; reduction or deterrence of piracy short of its absence is not represented.
(=>
  (instance ?CPO CounterPiracyOperation)
  (exists (?AREA)
    (and
      (eventLocated ?CPO ?AREA)
      (hasPurpose ?CPO
        (not
          (exists (?P)
            (and
              (instance ?P MaritimePiracy)
              (eventLocated ?P ?AREA)
              (overlapsTemporally
                (WhenFn ?P)
                (WhenFn ?CPO)))))))))

;; Rule 6: The purpose of a maritime law enforcement operation is that no
;; criminal action takes place in its area while it lasts. The same limits
;; as Rule 5 apply.
(=>
  (instance ?LE MaritimeLawEnforcementOperation)
  (exists (?AREA)
    (and
      (eventLocated ?LE ?AREA)
      (hasPurpose ?LE
        (not
          (exists (?C)
            (and
              (instance ?C CriminalAction)
              (eventLocated ?C ?AREA)
              (overlapsTemporally
                (WhenFn ?C)
                (WhenFn ?LE)))))))))

;; 50. RulesOfEngagement
(subclass RulesOfEngagement Ordering)
;; ROE do not alter pre-existing rights and obligations under LOAC, and must
;; always remain consistent with LOAC obligations (Newport ROE Handbook).
;; RulesOfEngagement is a subclass of Ordering, hence a Process, so instances
;; are promulgation events. The normative content they carry is expressed by
;; confersNorm and modalAttribute rather than by the event itself. An action
;; forbidden by ROE but permitted by LOAC is unauthorized, not unlawful.
(documentation RulesOfEngagement EnglishWrittenLanguage
  "Directives issued by competent military authority that delineate the
   circumstances, conditions, degree, and manner in which the use of force may
   be applied.")
(termFormat EnglishWrittenLanguage RulesOfEngagement "rules of engagement")
(conventionalShortName "ROE" RulesOfEngagement)

;; Rule 1: LOAC ceiling -- no authority may permit what LOAC prohibits
(=>
  (modalAttribute ?F Prohibition)
  (not
    (exists (?AUTH)
      (confersNorm ?AUTH Permission ?F))))

;; 51. MaritimeWarningZone
(subclass MaritimeWarningZone GeographicArea)
(documentation MaritimeWarningZone EnglishWrittenLanguage
  "A designated ocean area and superjacent airspace in which a State purports
   to restrict or otherwise limit the freedom of navigation and/or overflight
   of other users, or otherwise impacts the exercise of those freedoms (JP
   3-32; Newport ROE Handbook, glossary).")
(termFormat EnglishWrittenLanguage MaritimeWarningZone "maritime warning zone")

;; Rule 1: MaritimeWarningZone contains InternationalWaters
(=>
  (instance ?MWZ MaritimeWarningZone)
  (exists (?IW)
    (and
      (instance ?IW InternationalWaters)
      (part ?IW ?MWZ))))

;; Rule 2: A State announces the zone, and the announcement concerns some kind
;; of navigation or overflight. This is the part common to exclusion zones,
;; which announce a restriction, and warning areas, which only warn. An earlier
;; version conferred a prohibition on every translocation in the zone, which
;; warning areas then inherited. &%hinders is not used: SUMO scopes it to the
;; time and location of the hindering process itself, here the announcement,
;; not the zone.
(=>
  (instance ?MWZ MaritimeWarningZone)
  (exists (?ST ?ANN ?C)
    (and
      (instance ?ST Nation)
      (instance ?ANN Stating)
      (agent ?ANN ?ST)
      (refers ?ANN ?MWZ)
      (subclass ?C Translocation)
      (refers ?ANN ?C))))

;; Rule 3: ExclusionZone and WarningArea are subclasses
(subclass ExclusionZone MaritimeWarningZone)
(subclass WarningArea MaritimeWarningZone)
(documentation WarningArea EnglishWrittenLanguage
  "A designated maritime area within which a State advises that military
   activity is taking place and that entry may be hazardous, without
   purporting to prohibit entry outright.")
(termFormat EnglishWrittenLanguage WarningArea "warning area")

;; Rule 4: An authority announces a warning area with the purpose that no one
;; be in it, because entering it is hazardous. It is a purpose, not a
;; prohibition: entering the area is not thereby unlawful.
;; Known limits: the purpose covers every human, not only those at risk; and
;; the rule does not entail that the hazard exists or that the warning is
;; effective.
(=>
  (instance ?WA WarningArea)
  (exists (?AUTH ?ANN)
    (and
      (instance ?AUTH AutonomousAgent)
      (instance ?ANN Stating)
      (agent ?ANN ?AUTH)
      (refers ?ANN ?WA)
      (hasPurpose ?ANN
        (not
          (exists (?X)
            (and
              (instance ?X Human)
              (located ?X ?WA))))))))

;; 52. TargetMarking
(subclass TargetMarking MilitaryOperation)
(documentation TargetMarking EnglishWrittenLanguage
  "A military operation in which a unit maintains contact with a target from a
   position that provides an immediate offensive capability against that
   target (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage TargetMarking "marking")

;; Rule 1: During target marking, a member of the marking unit sees the
;; target, directly or on a display such as a radar screen. An earlier version
;; used &%connected, which means physical contact. This is a necessary
;; condition, not a definition: seeing a target is not yet marking it. The
;; human observer is a limit of the current model: fully automated marking
;; systems are not covered, since a device cannot be the agent of &%Seeing and
;; SUMO's &%Sensing excludes animal agents.
(=>
  (instance ?M TargetMarking)
  (exists (?A ?T ?OBS ?X)
    (and
      (instance ?A MilitaryOrganization)
      (agent ?M ?A)
      (patient ?M ?T)
      (instance ?OBS Seeing)
      (agent ?OBS ?X)
      (instance ?X Human)
      (member ?X ?A)
      (patient ?OBS ?T)
      (overlapsTemporally
        (WhenFn ?OBS)
        (WhenFn ?M)))))

;; Rule 2: The purpose of target marking is that the marking unit can attack
;; the target during the marking. It states a possibility, not a permission.
(=>
  (and
    (instance ?M TargetMarking)
    (agent ?M ?A)
    (patient ?M ?T))
  (hasPurpose ?M
    (modalAttribute
      (exists (?ATK)
        (and
          (instance ?ATK Attack)
          (agent ?ATK ?A)
          (targetInAttack ?ATK ?T)
          (overlapsTemporally
            (WhenFn ?ATK)
            (WhenFn ?M))))
      Possibility)))

;; 53. MilitaryDeception
(subclass MilitaryDeception MilitaryOperation)
(documentation MilitaryDeception EnglishWrittenLanguage
  "An information operations tool involving actions executed to deliberately
   mislead adversary military, paramilitary, or violent extremist organization
   decision makers, causing the adversary to take specific actions or
   inactions that contribute to the accomplishment of the friendly force
   mission (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage MilitaryDeception "military deception")
(conventionalShortName "MILDEC" MilitaryDeception)

;; Rule 1: MilitaryDeception targets adversary decision makers
(=>
  (instance ?MD MilitaryDeception)
  (exists (?A ?TARGET)
    (and
      (instance ?A MilitaryOrganization)
      (agent ?MD ?A)
      (instance ?TARGET CognitiveAgent)
      (patient ?MD ?TARGET))))

;; Rule 2: The purpose of a military deception is that the adversary does an
;; act the deception brings about, or does not do an act he desires to do: the
;; "actions or inactions" of the Handbook. The desire is stated outside the
;; purpose, so the inaction concerns an existing desire of the adversary. The
;; kinds of act are existential; a scenario states which ones. A third purpose
;; Prof. Pease named, that the deceiving side can do what it wants, is not
;; represented, since an organization cannot be the agent of &%desires.
(=>
  (and
    (instance ?MD MilitaryDeception)
    (patient ?MD ?TARGET)
    (instance ?TARGET CognitiveAgent))
  (exists (?C1 ?C2)
    (and
      (subclass ?C1 IntentionalProcess)
      (subclass ?C2 IntentionalProcess)
      (desires ?TARGET
        (exists (?ACT)
          (and
            (instance ?ACT ?C2)
            (agent ?ACT ?TARGET))))
      (hasPurpose ?MD
        (or
          (exists (?ACT)
            (and
              (instance ?ACT ?C1)
              (agent ?ACT ?TARGET)
              (causes ?MD ?ACT)))
          (not
            (exists (?ACT)
              (and
                (instance ?ACT ?C2)
                (agent ?ACT ?TARGET)))))))))

;; Rule 3: The purpose of a military deception is that the adversary decision
;; maker believes something false. It does not follow that the false belief is
;; formed.
(=>
  (and
    (instance ?MD MilitaryDeception)
    (patient ?MD ?TARGET)
    (instance ?TARGET CognitiveAgent))
  (exists (?F)
    (and
      (instance ?F Formula)
      (truth ?F False)
      (hasPurpose ?MD
        (believes ?TARGET ?F)))))

;; 54. NationalAirspace
(subclass NationalAirspace Airspace)
(documentation NationalAirspace EnglishWrittenLanguage
  "Airspace above the territory, internal waters, territorial sea, and
   archipelagic waters of a State (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage NationalAirspace "national airspace")

;; Rule 1: NationalAirspace is above a Nation's territory
(=>
  (instance ?NA NationalAirspace)
  (exists (?STATE ?TERR)
    (and
      (instance ?STATE Nation)
      (instance ?TERR GeographicArea)
      (claimedTerritory ?TERR ?STATE)
      (orientation ?NA ?TERR Above))))

;; Rule 2 moved to ROE_Deontic.kif (legal status of flight, kept out of the main
;; knowledge base).

;; Rule 3: NationalAirspace and InternationalAirspace are disjoint
(disjoint NationalAirspace InternationalAirspace)

;; 55. NavalMine
(subclass NavalMine Bomb)
(documentation NavalMine EnglishWrittenLanguage
  "An explosive device laid in the water, on the seabed, or in the subsoil
   thereof, with the intention of damaging or sinking ships or of deterring
   ships from entering an area (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage NavalMine "naval mine")

;; Rule 1: A naval mine has the purpose of being laid in the water or on the
;; seabed. It is a mine before it is laid, as soon as it is manufactured; an
;; earlier version stated that every mine is located there.
(=>
  (instance ?NM NavalMine)
  (hasPurpose ?NM
    (exists (?LOC)
      (and
        (or
          (instance ?LOC WaterArea)
          (instance ?LOC UnderwaterRegion))
        (located ?NM ?LOC)))))

;; Rule 2: A naval mine has the purpose of damaging a ship, or of keeping
;; every ship out of the area where it is laid. The purposes are alternatives
;; (the Handbook says "or"): two separate purpose rules would give every mine
;; both. A ship passing through the area is covered by &%eventLocated, which
;; &%destination would miss. Known limits: ?LOC is only some region where the
;; mine is located, not the boundary of the mined area, which SUMO has no term
;; for; and the time during which ships are to be kept out is not stated. An
;; earlier version stated, for deterrence, that no ship moves the mine.
(=>
  (instance ?NM NavalMine)
  (hasPurpose ?NM
    (or
      (exists (?S ?D)
        (and
          (instance ?S Ship)
          (instance ?D Damaging)
          (patient ?D ?S)
          (instrument ?D ?NM)))
      (exists (?LOC)
        (and
          (located ?NM ?LOC)
          (not
            (exists (?S ?T)
              (and
                (instance ?S Ship)
                (instance ?T Translocation)
                (patient ?T ?S)
                (eventLocated ?T ?LOC)))))))))

;; 56. Neutralizing
(subclass Neutralizing MilitaryOperation)
(documentation Neutralizing EnglishWrittenLanguage
  "A military operation that renders a target ineffective, either temporarily
   or permanently (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage Neutralizing "neutralize")

;; Rule 1: Neutralizing a device has the purpose of rendering it ineffective,
;; either without physical damage, by malfunctioning during part of the
;; neutralizing (for example jamming), or through physical damage that holds
;; immediately after it. &%Malfunctioning (Mid-level) is a device not
;; performing its intended function, with no damage required; &%DeviceDamaged
;; (Merge) is damage that stops the device functioning until it is repaired,
;; so it is not permanent ineffectiveness. &%causes is not used: it would
;; require the neutralizing to end before any effect begins.
;; Known limits: the rule states a purpose; whether a failed attempt is a
;; neutralizing is not decided by it, and the documentation ("renders") reads
;; as a completed effect. A device can be operationally ineffective without
;; malfunctioning (a radar deceived into tracking a false target), which
;; neither option covers. Targets that are not devices are not covered. The
;; length of the interval after the neutralizing is not stated.
;; Earlier rules required a damaging caused by every neutralizing (jamming
;; damages nothing), made every neutralized device malfunction during the
;; whole neutralizing, and stated a possibility of destruction.
(=>
  (and
    (instance ?N Neutralizing)
    (patient ?N ?T)
    (instance ?T Device))
  (hasPurpose ?N
    (or
      (exists (?TI)
        (and
          (instance ?TI TimeInterval)
          (temporalPart ?TI
            (WhenFn ?N))
          (holdsDuring ?TI
            (attribute ?T Malfunctioning))))
      (holdsDuring
        (ImmediateFutureFn
          (WhenFn ?N))
        (attribute ?T DeviceDamaged)))))

;; 57. NoFlyZone
(subclass NoFlyZone Airspace)
(documentation NoFlyZone EnglishWrittenLanguage
  "A territory or area over which aircraft are not permitted to fly, or may
   fly only with the permission of the authority enforcing the zone (Newport
   ROE Handbook).")
(termFormat EnglishWrittenLanguage NoFlyZone "no-fly zone")

;; Rule 1: An authority announces a restriction on some kind of flying in a
;; no-fly zone, by some class of agents. Aircraft of the enforcing authority
;; are outside the zone's restriction by not being in that class, not by a
;; permission. A permission for a particular flight within the restricted
;; class, and how it interacts with a valid general prohibition, is not yet
;; modelled. An earlier version conferred a prohibition on every flight in the
;; zone.
(=>
  (instance ?NFZ NoFlyZone)
  (exists (?AUTH ?PROC ?AGENT)
    (and
      (subclass ?PROC Flying)
      (zoneRestriction ?AUTH ?NFZ ?PROC ?AGENT))))

;; Rule 2 moved to ROE_Deontic.kif (legal status of flight, kept out of the main
;; knowledge base).

;; 58. Combatant
(instance Combatant OccupationalRole)
;; A combatant may be targeted as such.
(documentation Combatant EnglishWrittenLanguage
  "A member of the armed forces of a party to an armed conflict who has the
   right to participate directly in hostilities under LOAC (Newport ROE
   Handbook, Geneva Convention III).")
(termFormat EnglishWrittenLanguage Combatant "combatant")

;; Rule 1: A Combatant may take part in hostilities
(=>
  (property ?P Combatant)
  (modalAttribute
    (exists (?VC)
      (and
        (instance ?VC ViolentContest)
        (agent ?VC ?P))) Possibility))

;; 59. NonCombatant
;; Not a subattribute of &%Civilian: military medical personnel and chaplains
;; are non-combatants but members of the armed forces, and SUMO makes
;; &%Civilian contrary to &%MilitaryPerson. A civilian is not thereby a
;; non-combatant either, since a civilian who directly participates in
;; hostilities is not one; the attribute is stated per scenario.
(instance NonCombatant OccupationalRole)
;; NonCombatants are protected under LOAC and may not be targeted (Newport ROE
;; Handbook, Geneva Convention IV).
(documentation NonCombatant EnglishWrittenLanguage
  "A person who does not directly participate in hostilities and may not be
   made the object of attack, including civilians and the medical and
   religious personnel of the armed forces (Newport ROE Handbook, Geneva
   Convention IV).")
(termFormat EnglishWrittenLanguage NonCombatant "non-combatant")

;; Rule 1: While a person is a non-combatant, the person is not the agent of
;; an attack during that time. This is a necessary condition, not a full
;; definition: a person who does not attack is not thereby a non-combatant.
;; Self-defense is a &%UseOfForce and not a subclass of &%Attack, so medical
;; personnel defending themselves or their patients are not meant to be
;; excluded; but nothing makes the two classes disjoint, so an act stated to be
;; both would still be excluded. Known limit: as for item 41, a person stated
;; to be a non-combatant who attacks in the same period makes the knowledge
;; base inconsistent rather than ending the status. The rule against
;; targeting a non-combatant is item 83 Rule 1.
(=>
  (holdsDuring ?T
    (attribute ?P NonCombatant))
  (not
    (exists (?ATK)
      (and
        (instance ?ATK Attack)
        (agent ?ATK ?P)
        (overlapsTemporally
          (WhenFn ?ATK)
          ?T)))))

;; Rule 2: Combatant and NonCombatant are disjoint
(contraryAttribute Combatant NonCombatant)

;; 60. NonCombatantEvacuationOperation
(subclass NonCombatantEvacuationOperation MilitaryOperation)
(documentation NonCombatantEvacuationOperation EnglishWrittenLanguage
  "An operation directed by national authority whereby non-combatants are
   evacuated from foreign States to safe havens when their lives are
   endangered by war, civil unrest, or natural disaster (Newport ROE
   Handbook).")
(termFormat EnglishWrittenLanguage NonCombatantEvacuationOperation
  "non-combatant evacuation operation")
(conventionalShortName "NEO" NonCombatantEvacuationOperation)

;; Rule 1: NEO is directed by national authority
(=>
  (instance ?NEO NonCombatantEvacuationOperation)
  (exists (?AUTH)
    (and
      (instance ?AUTH Nation)
      (agent ?NEO ?AUTH))))

;; Rule 2: NEO evacuates NonCombatants from a foreign State
(=>
  (instance ?NEO NonCombatantEvacuationOperation)
  (exists (?P ?STATE)
    (and
      (property ?P NonCombatant)
      (instance ?STATE Nation)
      (patient ?NEO ?P)
      (origin ?NEO ?STATE))))

;; Rule 3: NEO is triggered by armed conflict, civil unrest, or natural disaster
(=>
  (instance ?NEO NonCombatantEvacuationOperation)
  (or
    (exists (?VC)
      (and
        (instance ?VC ViolentContest)
        (causes ?VC ?NEO)))
    (exists (?GP)
      (and
        (instance ?GP GeologicalProcess)
        (causes ?GP ?NEO)))))

;; Rule 4: Attack is not permitted during NEO
(=>
  (and
    (instance ?NEO NonCombatantEvacuationOperation)
    (subProcess ?ATK ?NEO)
    (instance ?ATK Attack))
  (property ?ATK Illegal))

;; 61. NoStrikeList
(subclass NoStrikeList UniqueList)
(documentation NoStrikeList EnglishWrittenLanguage
  "A list of objects or entities protected from the effects of military
   operations under the law of armed conflict and/or rules of engagement
   (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage NoStrikeList "no-strike list")

;; Rule 1 and Rule 2 removed. Rule 2 stated that some organization conferred
;; a prohibition on attacking any member of the list, with &%confersNorm, an
;; act of conferring, and with no time or operation; Rule 1, in
;; ROE_Deontic.kif, withheld the attacker's own permission. Following Prof.
;; Pease (30 Oct 2026), the restriction is a ternary relation between the
;; organization, the operation and the object, &%noStrike, rather than a list:
;; one assertion for each protected object ("do not strike the school during
;; this operation"). &%NoStrikeList remains the term for the document.
(instance noStrike TernaryPredicate)
(domain noStrike 1 Organization)
(domain noStrike 2 MilitaryOperation)
(domain noStrike 3 Object)
(documentation noStrike EnglishWrittenLanguage
  "(&%noStrike ?ORG ?OP ?OBJ) means that ?ORG directs that ?OBJ must not be
   targeted during the military operation ?OP.")
(termFormat EnglishWrittenLanguage noStrike "no strike")
(format EnglishWrittenLanguage noStrike
  "%1 %n directs that %3 must not be targeted during %2")

;; Rule 1: An attack that is part of the operation must not be directed at the
;; object. The operation supplies the time and place. The prohibition is
;; de re, one for each attack, so a particular attack on the object is
;; prohibited, and an attack that occurs is a violation, not an
;; inconsistency. Known limits: being an &%Organization does not establish
;; that ?ORG has the authority to impose the restriction; and the restriction
;; holds for the whole operation, so a change to the list during the
;; operation is not represented.
(=>
  (and
    (noStrike ?ORG ?OP ?OBJ)
    (instance ?ATK Attack)
    (subProcess ?ATK ?OP))
  (modalAttribute
    (targetInAttack ?ATK ?OBJ)
    Prohibition))

;; 62. MaritimePiracy
;; Not a &%Hijacking: piracy may be violence, detention or depredation without
;; taking the vessel and driving it away.
(subclass MaritimePiracy CriminalAction)
(documentation MaritimePiracy EnglishWrittenLanguage
  "An illegal act of violence, depredation, or detention committed for private
   ends by the crew or passengers of a private ship or aircraft against
   another ship or aircraft, or against persons or property on board,
   occurring in or over international waters (Newport ROE Handbook, UNCLOS
   Art. 101).")
(termFormat EnglishWrittenLanguage MaritimePiracy "maritime piracy")

;; Rule 1: Piracy occurs on the high seas, in an exclusive economic zone
;; (UNCLOS Article 58(2) applies the piracy articles there), or in the airspace
;; over them. Known limit: a place outside the jurisdiction of any State (UNCLOS
;; Article 101(a)(ii)) is not covered.
(=>
  (instance ?P MaritimePiracy)
  (exists (?LOC)
    (and
      (or
        (instance ?LOC InternationalWaters)
        (instance ?LOC MaritimeExclusiveEconomicZone)
        (instance ?LOC InternationalAirspace))
      (eventLocated ?P ?LOC))))

;; Rule 2: Piracy is an act of violence, detention or depredation: some part of
;; it is a use of force, a confining or a robbing. A use of force counts
;; whether or not it causes damage, so shots that miss are already violence.
;; The class covers the completed act only; an approach that is abandoned
;; before any violence, detention or depredation is not in it. Known limits:
;; &%UseOfForce is not the full sense of violence, and &%Robbing does not cover
;; every form of depredation. An earlier version stated the possession of a
;; non-military vehicle and nothing about the act itself.
(=>
  (instance ?P MaritimePiracy)
  (exists (?S)
    (and
      (subProcess ?S ?P)
      (or
        (instance ?S UseOfForce)
        (instance ?S Confining)
        (instance ?S Robbing)))))

;; Rule 3: Piracy is committed by a person who, when it begins, is on board a
;; ship or aircraft that is not military and is the instrument of the act,
;; against another ship or aircraft, or a person or property on board it when
;; the act begins. The time is the beginning of the act because pirates who
;; board leave their own vessel, and the target may be moved off its own.
;; Crew and passengers are both covered by being on board. Known limits: "for
;; private ends" is not represented; not being a &%MilitaryVehicle is weaker
;; than being a private ship, since government ships on non-commercial service
;; are not excluded; the mutiny case of UNCLOS Article 102 is excluded; and
;; voluntary participation and facilitation (Article 101(b) and (c)) are not
;; covered.
(=>
  (instance ?P MaritimePiracy)
  (exists (?A ?V ?V2 ?T)
    (and
      (instance ?A Human)
      (agent ?P ?A)
      (instrument ?P ?V)
      (or
        (instance ?V WaterVehicle)
        (instance ?V Aircraft))
      (not
        (instance ?V MilitaryVehicle))
      (holdsDuring (BeginFn (WhenFn ?P))
        (located ?A ?V))
      (or
        (instance ?V2 WaterVehicle)
        (instance ?V2 Aircraft))
      (not
        (equal ?V ?V2))
      (patient ?P ?T)
      (or
        (equal ?T ?V2)
        (holdsDuring (BeginFn (WhenFn ?P))
          (located ?T ?V2))))))

;; Rule 3 removed: it made every act of piracy a &%HostileAct, and through
;; &%Attack a part of a &%ViolentContest. Piracy against a merchant ship is not
;; a hostile act against the Force; it is one only when it is directed against
;; a State, the Force, or designated persons or property, which follows from
;; &%HostileAct, not from piracy.

;; 63. PositiveFoeIdentification
(subclass PositiveFoeIdentification Classifying)
(subclass PositiveFoeIdentification MilitaryOperation)
;; Note: the term PositiveFoeIdentification is used here to distinguish this
;; concept from general classification processes; the conventional military
;; abbreviation remains PID (Newport ROE Handbook).
(documentation PositiveFoeIdentification EnglishWrittenLanguage
  "A military identification process that determines with reasonable certainty
   that an object of attack is a legitimate military target and not a friendly
   or neutral force, in accordance with the law of armed conflict and
   applicable rules of engagement. Encompasses Identification Friend or Foe
   (IFF) procedures (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage PositiveFoeIdentification
  "positive foe identification")
(conventionalShortName "PID" PositiveFoeIdentification)

;; Rule 1: PFI requires a cognitive agent
(=>
  (instance ?PID PositiveFoeIdentification)
  (exists (?A)
    (and
      (instance ?A CognitiveAgent)
      (agent ?PID ?A))))

;; Rule 2 removed. It stated that the target of every identification is a
;; combatant, so a mistaken identification was impossible, and it left out
;; objects. Prof. Pease (30 Oct 2026): the purpose of the identification is
;; that someone knows the target is part of an enemy force. The intended form
;; is (hasPurpose ?PID (holdsDuring (EndFn (WhenFn ?PID)) (knows ?A ?F))) with
;; ?A the agent of the identification. It is a purpose because an
;; identification reaches at most a belief with reasonable certainty, while
;; &%knows also entails that ?F is true. It is not stated yet because no ?F is
;; available that holds for every identification: membership in or ownership
;; by an enemy force is not the legal criterion (an enemy-owned relief ship is
;; not a lawful target); a combatant or a military objective leaves out
;; organized armed groups and civilians directly participating in
;; hostilities; and "not friendly" or "not neutral" cannot be stated through
;; shared membership in some organization. Whether an identification is still
;; valid when an attack is made is for item 77.

;; Rule 3 removed. It stated that every attack permitted under the ROE is
;; preceded by an identification of its target: a requirement stated as a
;; fact, so an attack without one would be impossible rather than a breach
;; (Prof. Pease, 30 Oct 2026). It also made a &%RulesOfEngagement the entity
;; conferring the norm. A requirement of identification belongs to the
;; weapon control statuses (item 77), as an obligation, and its scope must
;; come from the ROE that actually require it, with their exceptions.

;; Rule 4 removed. It stated that a target with declared hostile status is a
;; combatant and has been identified. A force being declared hostile does not
;; establish that a particular person or object encountered belongs to that
;; force, so it neither creates an identification nor replaces one.

;; 64. PrecisionGuidedMunition
(subclass PrecisionGuidedMunition Projectile)
(documentation PrecisionGuidedMunition EnglishWrittenLanguage
  "A projectile that uses precision guidance technology to strike targets more
   accurately, with the intention of reducing unintended damage to persons or
   property compared to non-precision-guided munitions. Sometimes referred to
   as smart munitions (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage PrecisionGuidedMunition
  "precision-guided munition")
(conventionalShortName "PGM" PrecisionGuidedMunition)

;; Rule 1: PGM is directed toward a specific target
(=>
  (and
    (instance ?PGM PrecisionGuidedMunition)
    (instance ?ATK Attack)
    (instrument ?ATK ?PGM))
  (exists (?T)
    (and
      (instance ?T Physical)
      (target ?ATK ?T))))

;; Rule 2: PGM use has the purpose of confining damage to military objectives
(=>
  (and
    (instance ?PGM PrecisionGuidedMunition)
    (instance ?ATK Attack)
    (instrument ?ATK ?PGM))
  (hasPurpose ?ATK
    (not
      (exists (?CD)
        (and
          (instance ?CD CollateralDamage)
          (causes ?ATK ?CD))))))

;; 65. ArticleFive
;; Article 5 is a provision of the North Atlantic Treaty, not a process. A
;; collective self-defense carried out under it is an Article5Process
;; (Pease, 30 Oct).
(instance NorthAtlanticTreaty Treaty)
(documentation NorthAtlanticTreaty EnglishWrittenLanguage
  "The &%Treaty signed in Washington on 4 April 1949 that established the
   &%NorthAtlanticTreatyOrganization.")
(termFormat EnglishWrittenLanguage NorthAtlanticTreaty
  "North Atlantic Treaty")

(instance ArticleFive PrescriptiveContent)
(subProposition ArticleFive NorthAtlanticTreaty)
(documentation ArticleFive EnglishWrittenLanguage
  "Article 5 of the &%NorthAtlanticTreaty, by which the parties agree that an
   armed attack against one or more of them in Europe or North America shall
   be considered an attack against them all, and that each of them will
   assist the party or parties so attacked by taking such action as it deems
   necessary, including the use of armed force.")
(termFormat EnglishWrittenLanguage ArticleFive "Article 5")

;; Known limits:
;; - The obligation to assist is not formalized as a norm. Article 5 does not
;;   require force: each party takes the action it deems necessary, and that
;;   judgment needs a representation of a State's assessment that is not yet
;;   available.
;; - The geographic and material scope of Article 6, and the request or
;;   consent of the attacked State, are not represented.
;; - The political assessment and decision of the North Atlantic Council are
;;   not represented. A Council decision is not assumed to be a necessary
;;   precondition of the treaty obligation in every case.
;; - No rule derives an Article5Process or a use of force from an attack.

(subclass Article5Process CollectiveSelfDefense)
(documentation Article5Process EnglishWrittenLanguage
  "A &%CollectiveSelfDefense in which a party to the &%NorthAtlanticTreaty
   defends another party against an armed attack, as provided by
   &%ArticleFive.")
(termFormat EnglishWrittenLanguage Article5Process "Article 5 process")

;; Rule 1: An Article 5 process is carried out by a member State of NATO.
(=>
  (instance ?P Article5Process)
  (exists (?N)
    (and
      (instance ?N Nation)
      (member ?N NorthAtlanticTreatyOrganization)
      (agent ?P ?N))))

;; member is used, not partyToAgreement: partyToAgreement requires an
;; Agreement, and in SUMO a Treaty is a Contract, which is not declared a
;; subclass of Agreement. The rule does not say which attack is answered or
;; which State is assisted.

;; Article5Process is a use of force, because CollectiveSelfDefense is the use
;; of force to defend another State. Measures under Article 5 that use no
;; force (for example air surveillance patrols) are still Article 5 measures,
;; not non-Article 5 operations; they are not represented yet. The difference
;; between Article 5 and non-Article 5 operations is their legal basis, not
;; whether force is used.
;; Further rules need three things modelled first: the armed attack of
;; Article 5, the assisted State, and the purpose of the assistance. Attack
;; alone is not enough: not every Attack reaches the armed-attack threshold,
;; and in an attack on a warship or a unit the patient is the object
;; attacked, not the State.

;; NATO member States. SUMO has no member facts for
;; NorthAtlanticTreatyOrganization. Membership changes over time, and member
;; is not yet linked to partyToAgreement for the NorthAtlanticTreaty.
(member Albania NorthAtlanticTreatyOrganization)
(member Belgium NorthAtlanticTreatyOrganization)
(member Bulgaria NorthAtlanticTreatyOrganization)
(member Canada NorthAtlanticTreatyOrganization)
(member Croatia NorthAtlanticTreatyOrganization)
(member CzechRepublic NorthAtlanticTreatyOrganization)
(member Denmark NorthAtlanticTreatyOrganization)
(member Estonia NorthAtlanticTreatyOrganization)
(member Finland NorthAtlanticTreatyOrganization)
(member France NorthAtlanticTreatyOrganization)
(member Germany NorthAtlanticTreatyOrganization)
(member Greece NorthAtlanticTreatyOrganization)
(member Hungary NorthAtlanticTreatyOrganization)
(member Iceland NorthAtlanticTreatyOrganization)
(member Italy NorthAtlanticTreatyOrganization)
(member Latvia NorthAtlanticTreatyOrganization)
(member Lithuania NorthAtlanticTreatyOrganization)
(member Luxembourg NorthAtlanticTreatyOrganization)
(member Montenegro NorthAtlanticTreatyOrganization)
(member Netherlands NorthAtlanticTreatyOrganization)
(member Macedonia NorthAtlanticTreatyOrganization)
(member Norway NorthAtlanticTreatyOrganization)
(member Poland NorthAtlanticTreatyOrganization)
(member Portugal NorthAtlanticTreatyOrganization)
(member Romania NorthAtlanticTreatyOrganization)
(member Slovakia NorthAtlanticTreatyOrganization)
(member Slovenia NorthAtlanticTreatyOrganization)
(member Spain NorthAtlanticTreatyOrganization)
(member Sweden NorthAtlanticTreatyOrganization)
(member Turkey NorthAtlanticTreatyOrganization)
(member UnitedKingdom NorthAtlanticTreatyOrganization)
(member UnitedStates NorthAtlanticTreatyOrganization)

;; 66. Covert
(instance Covert RelationalAttribute)
;; It is a &%RelationalAttribute because whether an operation is covert depends
;; on who observes it; SUMO has no closer class for attributes of processes.
(documentation Covert EnglishWrittenLanguage
  "An attribute indicating that an operation or action is planned and executed
   so as to conceal the identity of the sponsor or to permit plausible
   deniability (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage Covert "covert")
(contraryAttribute Covert Overt)

;; Rule 1: A covert entity's sponsor is not known to the opposing agent
(=>
  (and
    (property ?OP Covert)
    (instance ?OP Process)
    (agent ?OP ?A)
    (instance ?TARGET CognitiveAgent)
    (not
      (equal ?A ?TARGET)))
  (not
    (knows ?TARGET
      (agent ?OP ?A))))

;; 67. Overt
(instance Overt RelationalAttribute)
;; It is a &%RelationalAttribute for the same reason as &%Covert.
(documentation Overt EnglishWrittenLanguage
  "An attribute indicating that an operation or action is conducted openly,
   without concealment of the identity of the sponsor or the nature of the
   operation (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage Overt "overt")

;; Old Rule 1 (an observer who sees an overt operation knows its agent) was
;; removed: observing an operation does not give knowledge of who carried it
;; out (a radar contact can be detected without being identified).
;; No rule yet. Known limits and open points:
;; - Conducting an operation openly does not mean that others observe it or
;;   know who carried it out.
;; - The absence of a purpose of concealment does not mean that disclosure is
;;   intended or that the agent accepts it.
;; - Overt and Covert depend on how the operation is conducted, on the identity
;;   of the sponsor (who is not always the agent), and on the parties from
;;   whom something is or is not concealed. These must be settled for both
;;   terms together.
;; - Possibility of knowledge (Pease, 30 Oct) is not used: that it is possible
;;   for the opponent to know is a different proposition from the opponent
;;   knowing being acceptable to the agent.

;; 68. CovertOperation
(subclass CovertOperation MilitaryOperation)
(documentation CovertOperation EnglishWrittenLanguage
  "A military operation planned and executed so as to conceal the identity of
   the sponsor. A covert operation differs from a clandestine operation in
   that emphasis is placed on concealment of the sponsor rather than
   concealment of the operation itself (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage CovertOperation "covert operation")

;; Rule 1: Every CovertOperation has the Covert attribute
(=>
  (instance ?CO CovertOperation)
  (property ?CO Covert))

;; Rule 2: In a CovertOperation, the sponsor is concealed from the target
(=>
  (and
    (instance ?CO CovertOperation)
    (agent ?CO ?SPONSOR)
    (patient ?CO ?TARGET)
    (instance ?TARGET CognitiveAgent))
  (not
    (knows ?TARGET
      (agent ?CO ?SPONSOR))))

;; 69. OvertOperation
(subclass OvertOperation MilitaryOperation)
(documentation OvertOperation EnglishWrittenLanguage
  "A military operation conducted openly, without concealment of the identity
   of the sponsor or the nature of the operation (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage OvertOperation "overt operation")

;; Rule 1: Every OvertOperation has the Overt attribute
(=>
  (instance ?OO OvertOperation)
  (property ?OO Overt))

;; Rule 2: OvertOperation is disjoint from CovertOperation
(disjoint OvertOperation CovertOperation)

;; 70. SurveillanceOperation
(subclass SurveillanceOperation MilitaryOperation)
;; Surveillance may be of a tactical or strategic nature and may be followed by
;; reconnaissance. Surveillance missions are normally designated by delineating
;; the area and type of surveillance (Newport ROE Handbook).
(documentation SurveillanceOperation EnglishWrittenLanguage
  "A military operation consisting of the systematic observation of aerospace,
   surface or subsurface areas, places, persons, or things, by visual, aural,
   electronic, photographic, or other means.")
(termFormat EnglishWrittenLanguage SurveillanceOperation
  "surveillance operation")

;; Rule 1: A surveillance operation is carried out by a military
;; organization. The platform or sensor that observes (a ship, an unmanned
;; vehicle, a fixed radar) is not required here; its role belongs to the
;; subprocesses.
(=>
  (instance ?S SurveillanceOperation)
  (exists (?UNIT)
    (and
      (instance ?UNIT MilitaryOrganization)
      (agent ?S ?UNIT))))

;; Removed: the operation is located in a GeographicArea (the place of the
;; observer is not the observed area, and space-based surveillance is not in a
;; GeographicArea); the operation uses a Vehicle (fixed radars and sensors do
;; not); reconnaissance may follow (Possibility is near-vacuous; the Handbook
;; note above keeps the information).
;; SurveillanceOperation is not made a subclass of Investigating, because
;; PsychologicalProcess requires an Animal experiencer, which unmanned
;; surveillance does not have.

;; Rule 2: A surveillance operation has the purpose that, when it ends, some
;; cognitive agent knows something that refers to what is observed (Pease,
;; 30 Oct).
(=>
  (and
    (instance ?S SurveillanceOperation)
    (patient ?S ?X))
  (hasPurpose ?S
    (exists (?AG ?F)
      (and
        (instance ?AG CognitiveAgent)
        (refers ?F ?X)
        (holdsDuring (EndFn (WhenFn ?S))
          (knows ?AG ?F))))))

;; Knowledge is a purpose, not an outcome: a failed surveillance does not
;; contradict this rule. The knower is not required to be the agent (an
;; organization is not a CognitiveAgent) and may be, for example, the
;; commander who receives the report. It is not required that the information
;; was unknown before: keeping track of a known contact is also surveillance.
;; containsFormula, as in ReconnaissanceOperation, is not used: its first
;; argument must be a ContentBearingPhysical, which a SurveillanceOperation
;; is not. ?F is a formula variable; see Pease's THF note on Investigating
;; in Merge.kif.
;; Known limits: refers is broader than "is about": ?F may refer to ?X without
;; being the information the surveillance seeks (for example the year the
;; observed ship was built). The rule gives the purpose of acquiring
;; information at a general level only; mission-relevant information is not
;; represented. The rule applies to every patient of the operation.

;; 71. Shadowing
(subclass Shadowing SurveillanceOperation)
(disjoint Shadowing TargetMarking)
;; It is important that shadowing is not mistaken for target marking, as this
;; may cause an unwanted escalatory effect (Newport ROE Handbook).
(documentation Shadowing EnglishWrittenLanguage
  "A military operation that observes and maintains contact with an object,
   normally as a follow-up to surveillance or reconnaissance, with
   effectiveness measured by the ability to obtain and report required
   information. Shadowing may be carried out overtly or covertly by aircraft,
   submarines, ships, or combinations thereof (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage Shadowing "shadowing")

;; Rule 1: Shadowing has a physical target
(=>
  (instance ?SH Shadowing)
  (exists (?TARGET)
    (and
      (instance ?TARGET Physical)
      (patient ?SH ?TARGET))))

;; Rule 2: Shadowing may be covert or overt
(=>
  (instance ?SH Shadowing)
  (or
    (property ?SH Covert)
    (property ?SH Overt)))

;; The Handbook says shadowing "may be carried out overtly or covertly"; the
;; disjunction adds the assumption that the two cases are exhaustive. Kept
;; until Covert, Overt and CovertOperation (66-68) are revised together.
;; Removed: covert shadowing means the target does not know it is shadowed
;; (a claim about reality; a detected covert shadowing is still covert
;; shadowing). A purpose form is kept as a candidate for the 66-68 work,
;; since covert shadowing hides the shadowing itself, while Covert hides the
;; sponsor.

;; Rule 3: Shadowing is conducted with a military vehicle (aircraft,
;; submarines or ships, Newport ROE Handbook). The military organization as
;; agent is inherited from SurveillanceOperation.
(=>
  (instance ?SH Shadowing)
  (exists (?V)
    (and
      (instance ?V MilitaryVehicle)
      (instrument ?SH ?V))))

;; Rule 4: Shadowing has the purpose that, throughout it, some cognitive
;; agent knows where the target is.
(=>
  (and
    (instance ?SH Shadowing)
    (patient ?SH ?X))
  (hasPurpose ?SH
    (holdsDuring (WhenFn ?SH)
      (exists (?AG ?L)
        (and
          (instance ?AG CognitiveAgent)
          (knows ?AG
            (located ?X ?L)))))))

;; Knowledge is a purpose, not an outcome. The knower and the location may
;; change during the shadowing; SUMO does not fix whether an exists inside
;; holdsDuring is constant over the interval, and the variable reading is
;; intended here. located does not give the precision of the known position,
;; so close contact keeping is not fully defined. The removed Rule 5
;; (shadowing usually follows surveillance or reconnaissance) did not hold:
;; a patrol can come upon a contact and shadow it without prior surveillance
;; (Pease, 30 Oct).

;; 72. ROERequest
(subclass ROERequest Requesting)
(subclass ROERequest MilitaryProcess)
;; Any commander in the operational chain of command can originate a ROEREQ.
;; Each request must include an explanation of why the ROE are required and the
;; consequences should the ROE not be approved (Newport ROE Handbook).
(documentation ROERequest EnglishWrittenLanguage
  "A formal message (ROEREQ) used by a commander to seek the implementation,
   modification, or cancellation of rules of engagement from a superior
   commander (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage ROERequest "ROE request")
(conventionalShortName "ROEREQ" ROERequest)

;; Rule 1: ROERequest is from a subordinate unit to HigherHeadquarters
(=>
  (instance ?REQ ROERequest)
  (exists (?CMD ?HQ)
    (and
      (instance ?CMD MilitaryOrganization)
      (instance ?HQ HigherHeadquarters)
      (agent ?REQ ?CMD)
      (destination ?REQ ?HQ)
      (ancestorOrganization ?CMD ?HQ))))

;; Rule 2: ROERequest is originated by a commander to a superior commander
(=>
  (instance ?REQ ROERequest)
  (exists (?CMD ?SUP ?MIL ?POS_CMD ?POS_SUP)
    (and
      (instance ?CMD Human)
      (instance ?SUP Human)
      (attribute ?CMD MilitaryCommander)
      (attribute ?SUP MilitaryCommander)
      (instance ?MIL MilitaryForce)
      (agent ?REQ ?CMD)
      (destination ?REQ ?SUP)
      (occupiesPosition ?CMD ?POS_CMD ?MIL)
      (occupiesPosition ?SUP ?POS_SUP ?MIL)
      (subordinatePosition ?MIL ?POS_CMD ?POS_SUP))))

;; Rule 3: ROERequest concerns RulesOfEngagement
(=>
  (instance ?REQ ROERequest)
  (exists (?ROE)
    (and
      (instance ?ROE RulesOfEngagement)
      (patient ?REQ ?ROE))))

;; Rule 4: ROERequest includes a justification
(=>
  (instance ?REQ ROERequest)
  (exists (?JUST)
    (and
      (instance ?JUST Stating)
      (subProcess ?JUST ?REQ))))

;; Stating is the speech act; a Statement is a sentence and cannot be a
;; subprocess. The rule does not show that what is stated is the
;; justification of the request; that link is not represented.

;; 73. ROEAuthorization
(subclass ROEAuthorization Declaring)
(subclass ROEAuthorization MilitaryProcess)
;; Each ROEAUTH message should be numbered sequentially (Newport ROE Handbook).
;; It is a Declaring, not a Directing: authorizing is giving permission
;; (Pease, 30 Oct), an institutional alteration by competent authority. A
;; message that only denies changes no norm and is not covered by this class.
(documentation ROEAuthorization EnglishWrittenLanguage
  "A formal message (ROEAUTH) by which the appropriate higher headquarters
   authorizes rules of engagement. The same message may deny other rules of
   engagement (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage ROEAuthorization "ROE authorization")
(conventionalShortName "ROEAUTH" ROEAuthorization)

;; Rule 1: ROEAuthorization is issued by HigherHeadquarters
(=>
  (instance ?AUTH ROEAuthorization)
  (exists (?HQ ?UNIT)
    (and
      (instance ?HQ HigherHeadquarters)
      (instance ?UNIT MilitaryOrganization)
      (agent ?AUTH ?HQ)
      (destination ?AUTH ?UNIT)
      (ancestorOrganization ?UNIT ?HQ))))

;; Removed: every ROEAUTH is a response to a ROEREQ and is caused by it. An
;; ROEAUTH can be issued without a request (initial ROE). When it answers a
;; request, earlier gives only the order of the two messages, not the
;; response relation, which is not represented yet.

;; Rule 3: ROEAuthorization concerns RulesOfEngagement
(=>
  (instance ?AUTH ROEAuthorization)
  (exists (?ROE)
    (and
      (instance ?ROE RulesOfEngagement)
      (patient ?AUTH ?ROE))))

;; Rule 4: An ROE authorization approves at least one ROE measure.
(=>
  (instance ?AUTH ROEAuthorization)
  (exists (?M)
    (and
      (instance ?M ROEMeasure)
      (roeAuthorizesMeasure ?AUTH ?M))))

;; Containing a measure is not approving it: the same message may list a
;; measure as authorized, as denied, or as already in force (Newport ROE
;; Handbook, sample ROEAUTH); see roeAuthorizesMeasure. The old Rule 4 (the
;; ROE confers or deprives the Permission of a single act) was removed: the
;; norm was given by the ROE instead of the headquarters, authorization
;; concerns kinds of action, and a plain denial fits neither case.

;; 74. ROEImplementation
(subclass ROEImplementation Directing)
(subclass ROEImplementation ContentDevelopment)
(subclass ROEImplementation MilitaryProcess)
;; It is a ContentDevelopment because the implementing commander may add
;; guidance or restrictions to the authorized ROE (Pease, 30 Oct). Preparing
;; the message and passing its content to the units may be different
;; processes; this is not represented.
;; ROEIMP messages may contain additional guidance or restrictions, may retain
;; certain ROE authorized by higher headquarters, or may implement dormant ROE
;; that become available only when specified events occur (Newport ROE
;; Handbook).
(documentation ROEImplementation EnglishWrittenLanguage
  "A formal message (ROEIMP) used by a subordinate commander to control the
   application of rules of engagement that have been authorized by a higher
   headquarters (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage ROEImplementation "ROE implementation")
(conventionalShortName "ROEIMP" ROEImplementation)

;; Rule 1: ROEImplementation is issued by a subordinate unit
;;         that received a ROEAuthorization
(=>
  (instance ?IMP ROEImplementation)
  (exists (?UNIT ?AUTH)
    (and
      (instance ?UNIT MilitaryOrganization)
      (instance ?AUTH ROEAuthorization)
      (destination ?AUTH ?UNIT)
      (agent ?IMP ?UNIT)
      (earlier
        (WhenFn ?AUTH)
        (WhenFn ?IMP)))))

;; Rule 2: ROEImplementation concerns RulesOfEngagement
(=>
  (instance ?IMP ROEImplementation)
  (exists (?ROE)
    (and
      (instance ?ROE RulesOfEngagement)
      (patient ?IMP ?ROE))))

;; Rule 3: An implementation that places an authorizing measure in force is
;; preceded by an ROE authorization that approves that measure.
(=>
  (and
    (instance ?IMP ROEImplementation)
    (containsInformation ?IMP ?ACTV)
    (instance ?ACTV ROEActivation)
    (roeActivationMeasure ?ACTV ?M)
    (roeMeasureAuthorizes ?M ?C))
  (exists (?AUTH)
    (and
      (instance ?AUTH ROEAuthorization)
      (roeAuthorizesMeasure ?AUTH ?M)
      (earlier
        (WhenFn ?AUTH)
        (WhenFn ?IMP)))))

;; A necessary condition only. Restricting measures need no authorization,
;; since a subordinate commander may restrict on his own authority. The rule
;; follows the definition of the class (ROE "authorized by a higher
;; headquarters"); an unauthorized ROEIMP message is not an instance of it. A
;; prior approval does not show that the implementation is within the limits
;; of the authorization (the authority of the headquarters, the unit and
;; operation, the duration, and later changes are not represented).
;; Removed: the authorization causes the implementation. It does not: an
;; ROEIMP may retain ROE that were authorized (Newport ROE Handbook).

;; 75. WeaponControlStatus
;; A status of a unit, not a norm applied to a formula: the norms that come
;; with the statuses are in items 77 and 78. An earlier version made it a
;; &%DeonticAttribute.
(subclass WeaponControlStatus RelationalAttribute)
;; Weapon control status is general in nature and does not overrule ROE, weapon
;; system management, specific weapon control orders, specific engagement
;; orders, or command by veto (MTP-01).
(documentation WeaponControlStatus EnglishWrittenLanguage
  "A status issued by the Officer in Tactical Command (OTC) or the relevant
   warfare commander to state general direction or policy with regard to
   weapon employment for all or a particular warfare area (MTP-01).")
(termFormat EnglishWrittenLanguage WeaponControlStatus "weapon control status")

;; Rule 1: While a unit has a weapon control status, the status is associated
;; with an earlier declaring by a military commander: the declaring affects
;; the unit, refers to the status, is followed immediately by the unit having
;; it, and ends no later than the beginning of the period. &%Declaring is
;; "effect[ing] an institutional alteration when performed by competent
;; authority", and the before-and-after form is SUMO's own for &%Appointing.
;; It is a partial formalization of the assignment with existing SUMO terms:
;; neither &%refers nor the following status shows that the declaring
;; established the status. The same process may also be classified as an
;; &%Ordering, though that the two classes can hold together is untested.
;; Known limits: it is a necessary condition, not a sufficient one, so a
;; declaring does not by itself give a unit a status for any period; the
;; status is not stated to continue from the declaring to the period; the
;; commander's authority over the unit is not established; and conflicting
;; or later directives are not represented. The norms that come with the
;; statuses are in items 77, 78 and 61. Rule 2 removed: it derived a status
;; from any directive with no time, so the status held forever. An earlier
;; Rule 1 had no time and made the status the result of the directive.
(=>
  (and
    (instance ?T TimeInterval)
    (holdsDuring ?T
      (attribute ?UNIT ?WCS))
    (instance ?WCS WeaponControlStatus)
    (instance ?UNIT MilitaryOrganization))
  (exists (?CMD ?D)
    (and
      (attribute ?CMD MilitaryCommander)
      (instance ?D Declaring)
      (agent ?D ?CMD)
      (patient ?D ?UNIT)
      (refers ?D ?WCS)
      (holdsDuring
        (ImmediateFutureFn
          (WhenFn ?D))
        (attribute ?UNIT ?WCS))
      (beforeOrEqual
        (EndFn
          (WhenFn ?D))
        (BeginFn ?T)))))

;; 76. WeaponsFree
(instance WeaponsFree WeaponControlStatus)
(documentation WeaponsFree EnglishWrittenLanguage
  "A weapon control status in which fire may be opened on any target that has
   not been identified as friendly (MTP-01).")
(termFormat EnglishWrittenLanguage WeaponsFree "weapons free")

;; Rules 1 and 2 removed (from ROE_Deontic.kif). Rule 1 permitted, with no
;; time, every attack on a combatant; Rule 2 withdrew that permission for
;; objects on a no-strike list. Under modals.kif a permission and a
;; prohibition of the same formula are inconsistent, so the pair made the
;; knowledge base inconsistent. Weapons free is the least restrictive weapon
;; control status, but it does not override the ROE or specific engagement
;; orders (MTP-01), so it produces no permission of its own; its effect is
;; that the restrictions of items 77 and 78 do not apply while it holds. That
;; is not a positive authorization to engage, which is for the ROE
;; authorization layer. A no-strike restriction (item 61) applies under any
;; status.

;; 77. WeaponsTight
(instance WeaponsTight WeaponControlStatus)
(documentation WeaponsTight EnglishWrittenLanguage
  "A weapon control status in which fire may not be opened unless the target
   has been positively identified as hostile (MTP-01).")
(termFormat EnglishWrittenLanguage WeaponsTight "weapons tight")

;; Rule: Under WeaponsTight, attack requires positive hostile identification
(=>
  (and
    (attribute ?UNIT WeaponsTight)
    (instance ?UNIT MilitaryOrganization)
    (instance ?ATK Attack)
    (agent ?ATK ?UNIT)
    (patient ?ATK ?TARGET))
  (exists (?PID)
    (and
      (instance ?PID PositiveFoeIdentification)
      (patient ?PID ?TARGET)
      (earlier
        (WhenFn ?PID)
        (WhenFn ?ATK)))))

;; 78. WeaponsSafe
(instance WeaponsSafe WeaponControlStatus)
(documentation WeaponsSafe EnglishWrittenLanguage
  "A weapon control status in which fire may not be opened or must cease. Fire
   may be opened only in self-defense or in response to a formal order
   (MTP-01).")
(termFormat EnglishWrittenLanguage WeaponsSafe "weapons safe")

;; Rule: Under WeaponsSafe, attack is only permitted in self-defense
(=>
  (and
    (attribute ?UNIT WeaponsSafe)
    (instance ?UNIT MilitaryOrganization)
    (instance ?ATK Attack)
    (agent ?ATK ?UNIT))
  (or
    (exists (?SD)
      (and
        (instance ?SD SelfDefense)
        (agent ?SD ?UNIT)
        (causes ?SD ?ATK)))
    (exists (?ORD)
      (and
        (instance ?ORD Directing)
        (destination ?ORD ?UNIT)
        (causes ?ORD ?ATK)))))

;; Contrary attributes -- mutually exclusive
(contraryAttribute WeaponsFree WeaponsTight WeaponsSafe)

;; 79. CollateralDamage
(subclass CollateralDamage Damaging)
;; Collateral damage is a key consideration in the application of the law of
;; armed conflict principles of distinction and proportionality. Commanders must
;; take feasible precautions to minimize collateral damage (Newport ROE
;; Handbook).
(documentation CollateralDamage EnglishWrittenLanguage
  "Unintentional or incidental injury or damage to persons or property that is
   not the target of an attack (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage CollateralDamage "collateral damage")

;; Rule 1: Collateral damage is the incidental effect of an attack on some
;; person or object. An earlier version stated that it is caused by an attack;
;; through &%causes this required the attack to end before the damage begins.
(=>
  (instance ?CD CollateralDamage)
  (exists (?ATK ?X)
    (and
      (instance ?ATK Attack)
      (incidentalEffectOn ?ATK ?CD ?X))))

;; Rule 2: A person or object that an attack affects incidentally is not a
;; target of that attack. An earlier version compared every patient of the
;; damage with every patient of the attack. Collateral damage is not derived
;; from &%incidentalEffectOn: one damaging may affect both a target and other
;; objects, and every patient being a non-target cannot be stated positively.
;; It is stated per scenario; item 80 can rely on &%incidentalEffectOn for the
;; harm to particular persons and objects.
(=>
  (and
    (instance ?ATK Attack)
    (incidentalEffectOn ?ATK ?DMG ?X))
  (not
    (targetInAttack ?ATK ?X)))

;; Rule 3 removed. It made every human harmed by collateral damage a
;; non-combatant. Under the Newport definition, collateral damage is harm to a
;; person or object that is not the target of the attack, which may be a
;; combatant: a soldier wounded incidentally in an attack on a bridge. Which
;; incidental harm counts in the proportionality assessment is a question for
;; item 80, not part of the definition of collateral damage.

;; Rule 4: PrecisionGuidedMunition has the purpose of decreasing
;; CollateralDamage
(=>
  (and
    (instance ?ATK Attack)
    (instance ?PGM PrecisionGuidedMunition)
    (instrument ?ATK ?PGM))
  (hasPurpose ?ATK
    (exists (?D ?CD)
      (and
        (instance ?D Decreasing)
        (instance ?CD CollateralDamage)
        (patient ?D ?CD)
        (causes ?ATK ?D)))))

;; 80. ProportionateAttack
(instance ProportionateAttack DeonticAttribute)
;; This is the LOAC sense of proportionality. It is distinct from proportionate
;; response in self-defense, where the nature, duration, and scope of the force
;; used should not exceed what is required to neutralize the threat, and where a
;; decisive response may exceed the means and intensity of the hostile act or
;; hostile intent.
(documentation ProportionateAttack EnglishWrittenLanguage
  "An attribute of an attack that complies with the principle of
   proportionality; expected collateral damage is not excessive relative to
   the concrete and direct military advantage anticipated (Newport ROE
   Handbook).")
(termFormat EnglishWrittenLanguage ProportionateAttack "proportionate attack")

;; Rule: If an attack is NOT proportionate and causes collateral damage,
;; it is Illegal
(=>
  (and
    (instance ?ATK Attack)
    (instance ?CD CollateralDamage)
    (causes ?ATK ?CD)
    (not
      (property ?ATK ProportionateAttack)))
  (property ?ATK Illegal))

;; 81. MilitaryNecessity
;; A principle, represented as a &%Proposition. It is not a &%NormativeAttribute
;; of an operation: an earlier version stated (property ?OP MilitaryNecessity).
(instance MilitaryNecessity Proposition)
;; Military necessity does not authorize acts otherwise prohibited by LOAC
;; (Newport ROE Handbook).
(documentation MilitaryNecessity EnglishWrittenLanguage
  "The principle whereby a belligerent has the right to apply any measures
   that are required to bring about the successful conclusion of a military
   operation and which are not forbidden by the law of armed conflict. It
   forbids the intentional destruction or seizure of enemy property unless
   imperatively demanded by the necessities of war (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage MilitaryNecessity "military necessity")

;; Rule 1 removed. It concluded that an operation under military necessity has
;; the purpose that some intentional process exist, which holds of every
;; operation and constrained nothing. Binding a real purpose would need the
;; objective of the operation, which is not represented.

;; Rule 2 removed. "Military necessity does not override LOAC" is not an
;; axiom but a property of the knowledge base: no rule may derive a permission
;; from military necessity. It is to be checked by a competency question and
;; regression tests, not stated. The rule concluded that an operation is
;; illegal if LOAC prohibited the formula that it is a military operation,
;; which says nothing about the operation.

;; Rule 3 removed. It concluded that a military operation is illegal if it
;; destroys property and lacks military necessity, a negated antecedent that
;; can never be proved under the open world assumption. Its content is the
;; prohibition of Hague Regulations Article 23(g): to destroy or seize the
;; enemy's property unless imperatively demanded by the necessities of war.
;; It is not restated as an axiom yet, for these reasons:
;; - The exception is a legal judgment that SUMO terms do not define. Three
;;   things differ: that an act furthers an end in the war (&%furthers), that
;;   the war cannot achieve its purpose without it (&%necessaryFor), and that
;;   it is imperatively demanded by the necessities of war. The second is far
;;   stricter than the legal standard: a bridge may lawfully be destroyed to
;;   delay an enemy advance although the war could be won without it. A
;;   primitive relation for the third, stated per scenario, would name the
;;   judgment without defining it.
;; - Military necessity does not by itself produce a permission. It is an
;;   exception to a particular prohibition; every other obligation under LOAC
;;   still applies to an act it covers.
;; - Scope: the rule concerns destruction outside attacks, which are governed
;;   by distinction (item 83) and proportionality. Seizure (booty, prize,
;;   requisition) has its own regimes; prize law allows the capture of enemy
;;   merchant ships without imperative necessity. Enemy property may include
;;   property in enemy territory regardless of ownership (DoD Law of War
;;   Manual 5.17.1).
;; The rule is to be restated when the inference layer of Group 5 shows what
;; the exception must provide.

;; 82. MilitaryObjective
(subclass MilitaryObjective Object)
(documentation MilitaryObjective EnglishWrittenLanguage
  "An object which by its nature, location, purpose, or use makes an effective
   contribution to military action and whose total or partial destruction,
   capture, or neutralization, in the circumstances at the time, offers a
   definite military advantage (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage MilitaryObjective "military objective")

;; Rule 1 removed. It made a military objective a &%resource of some military
;; operation, which is something used up; an object may be a military
;; objective by its location without being used, and &%involvedInEvent would
;; still require that it takes part in an operation. The two conditions of the
;; definition, an effective contribution to military action and a definite
;; military advantage in the circumstances ruling at the time (Customary IHL
;; Rule 8), are not represented by the available relations. The term keeps its
;; meaning in the law of armed conflict, an object; an operational objective,
;; a state of affairs a military unit's commander wants to bring about, is a
;; different concept, for a separate relation when needed.

;; Rule 2 removed. It concluded (property ?OP MilitaryNecessity) for an
;; operation that destroys or neutralizes a military objective; military
;; necessity is a principle, not an attribute of an operation, and the
;; military advantage the destruction offers is not represented.

;; Rule 3 removed. It concluded that an attack on an object that is neither a
;; military objective nor a combatant is illegal, the same content as the
;; former Rule 1 of item 83, with negated antecedents that can never be proved.
;; The distinction principle is to be stated as an obligation under
;; &%LawOfArmedConflict (item 83).

;; 83. DistinctionPrinciple
;; A principle, represented as a &%Proposition, like &%MilitaryNecessity.
(instance DistinctionPrinciple Proposition)
(documentation DistinctionPrinciple EnglishWrittenLanguage
  "The principle of the law of armed conflict that parties to a conflict
   distinguish at all times between combatants and civilians, and between
   military objectives and civilian property, and direct attacks only against
   combatants and military objectives (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage DistinctionPrinciple "distinction principle")

;; The former norm conferral and Rules 1 and 2 removed. &%confersNorm is an
;; act of conferring and &%LawOfArmedConflict is now a deontic attribute, not a
;; conferring entity; Rule 1 rested on negated antecedents that can never be
;; proved; and both concluded &%Illegal of an attack without stating what LOAC
;; requires.

;; Rule 1: Under the law of armed conflict, no attack is directed at a person
;; who is a non-combatant, or at an object that is civilian property, when the
;; attack begins. &%targetInAttack is what the attack is directed at, so
;; incidental harm, which is &%CollateralDamage and a matter of
;; proportionality, is not covered. The beginning of the attack is used as a
;; temporal reference for the target's protected status; the model does not
;; separately represent the time of the targeting decision. Civilian property
;; is meant in the legal sense of a civilian object, not of property owned by
;; civilians; an object that becomes a military objective by its use is not
;; civilian property at that time.
;; Known limits: the status must be stated for the beginning of the attack, or
;; derived by a temporal rule. That an object is stated to be a military
;; objective at that time does not establish that it is not civilian property:
;; the timeless (disjoint CivilianProperty MilitaryObjective) does not exclude
;; that both classifications are stated with &%holdsDuring for the same time,
;; and a temporal rule of mutual exclusion is left for Group 5. The obligation
;; is general; it does not by itself derive that a particular attack is
;; prohibited or &%Illegal.
(modalAttribute
  (not
    (exists (?ATK ?T)
      (and
        (instance ?ATK Attack)
        (targetInAttack ?ATK ?T)
        (or
          (holdsDuring (BeginFn (WhenFn ?ATK))
            (attribute ?T NonCombatant))
          (holdsDuring (BeginFn (WhenFn ?ATK))
            (instance ?T CivilianProperty))))))
  LawOfArmedConflict)

;; 84. DormantROE
(subclass DormantROE RulesOfEngagement)
(documentation DormantROE EnglishWrittenLanguage
  "Rules of engagement that have been authorized by higher headquarters but
   are not immediately in effect. Dormant ROE become active only when
   specified triggering events occur, as implemented through ROEIMP messages
   (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage DormantROE "dormant ROE")

;; Rule 1: DormantROE is authorized by ROEAuthorization
(=>
  (instance ?DROE DormantROE)
  (exists (?AUTH)
    (and
      (instance ?AUTH ROEAuthorization)
      (patient ?AUTH ?DROE))))

;; Rule 2: Trigger event plus ROEImplementation activates DormantROE
(=>
  (and
    (instance ?DROE DormantROE)
    (instance ?EVENT Process)
    (causes ?EVENT ?IMP)
    (instance ?IMP ROEImplementation)
    (patient ?IMP ?DROE)
    (instance ?OP MilitaryOperation)
    (earlier
      (WhenFn ?IMP)
      (WhenFn ?OP)))
  (confersNorm ?DROE Permission
    (instance ?OP MilitaryOperation)))

;; 85. CivilianProperty
(subclass CivilianProperty Object)
(disjoint CivilianProperty MilitaryObjective)
;; Civilian property is protected under the law of armed conflict and the
;; principle of distinction. Attacks directed against civilian property are
;; prohibited (Newport ROE Handbook).
(documentation CivilianProperty EnglishWrittenLanguage
  "Property that is not a military objective (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage CivilianProperty "civilian property")

;; Rule 1 removed. It concluded that an attack with civilian property as its
;; patient is illegal. Being a patient of an attack does not show that the
;; object was targeted, and the status of the object was not tied to the time
;; of the attack. The prohibition is stated in item 83 Rule 1 as an obligation
;; under &%LawOfArmedConflict; deriving that a particular attack is prohibited
;; or &%Illegal is left for Group 5.

;; Rule 2 removed. It made any damage to civilian property caused by an attack
;; a &%CollateralDamage. Damage to civilian property caused by an attack is
;; not necessarily collateral, even when the attack also targets a military
;; objective, since the same attack may target the civilian property as well.
;; Collateral damage requires a distinction between the intended target of an
;; attack and the incidental harm that results from it, which is not
;; represented by the available relations; incidental harm need not be
;; accidental or unforeseen. For now, &%CollateralDamage must be asserted in a
;; scenario or derived from a future rule that represents the incidental
;; nature of the damage (Group 5).

;; Behavioural predicate with no SUMO equivalent, used by the COLREGs
;; scenario pipeline.

;; 86. FriendlyForce
(subclass FriendlyForce MilitaryOrganization)
;; Positive identification of friendly forces is essential to prevent
;; fratricide. Friendly forces must not be engaged under any weapon control
;; status (Newport ROE Handbook).
(documentation FriendlyForce EnglishWrittenLanguage
  "A military force that is allied or cooperating with one's own force
   (Newport ROE Handbook).")
(termFormat EnglishWrittenLanguage FriendlyForce "friendly force")

;; Rule 1: FriendlyForce cannot have DeclaredHostileStatus
(=>
  (instance ?FF FriendlyForce)
  (not
    (property ?FF DeclaredHostileStatus)))

;; Rule 2: Attack on FriendlyForce is Illegal
(=>
  (and
    (instance ?ATK Attack)
    (patient ?ATK ?FF)
    (instance ?FF FriendlyForce))
  (property ?ATK Illegal))

;; Rule 3 moved to ROE_Deontic.kif (deontic layer, kept out of the main
;; knowledge base).
