;; The last day of February in a leap year finishes the month.
(note DateTime_leap_february_last_day_finishes_month)
(category general)
(time 10)

(instance CalendarBoundaryYear Integer)
(equal (RemainderFn CalendarBoundaryYear 4) 0)
(equal (RemainderFn CalendarBoundaryYear 100) 0)
(equal (RemainderFn CalendarBoundaryYear 400) 0)

(instance CalendarBoundaryMonth Integer)
(equal CalendarBoundaryMonth 2)
(instance CalendarBoundaryDay Integer)
(equal CalendarBoundaryDay 29)

(query
  (finishes
    (DayIntervalFn
      CalendarBoundaryYear
      CalendarBoundaryMonth
      CalendarBoundaryDay)
    (MonthIntervalFn
      CalendarBoundaryYear
      CalendarBoundaryMonth)))
(answer yes)