in which a long utterance is produced.")

(subclass SpeakingAShortUtterance EmotionalSpeakingBehavior)
(documentation SpeakingAShortUtterance EnglishWrittenLanguage "Speaking
behavior in which a short utterance is produced.")
(termFormat EnglishWrittenLanguage SpeakingAShortUtterance "speaking a short
utterance")

(=>
   (and
      (instance ?SS SpeakingAShortUtterance)
      (instance ?SL SpeakingALongUtterance)
      (instance ?U UnitOfDuration)
      (instance ?TIMED1 TimeDuration)
      (equal ?TIMED1 (MeasureFn ?D1 ?U))
      (instance ?TIMED2 TimeDuration)
      (equal ?TIMED2 (MeasureFn ?D2 ?U))
      (duration
         (WhenFn ?SS) ?TIMED1)
      (duration
         (WhenFn ?SL) 
         ?TIMED2))
   (greaterThan ?D2 ?D1))

(instance attitudeForObject TernaryPredicate)
(documentation attitudeForObject EnglishWrittenLanguage "Relates an &%EmotionalState 
of an &%AutonomousAgent to an &%Object.")
(domain attitudeForObject 1 EmotionalState)
(domain attitudeForObject 2 AutonomousAgent)
(domain attitudeForObject 3 Physical)

(documentation attitudeForFormula EnglishWrittenLanguage "The &%attitudeForFormula is a kind of &%TernaryPredicate that relates an agent, a specific &%formula, and the mental or emotional attitude that the agent holds toward that &%formula.")
(instance attitudeForFormula TernaryPredicate)
(documentation attitudeForObject EnglishWrittenLanguage "Relates an &%EmotionalState 
of an &%AutonomousAgent a &%Formula.")
(domain attitudeForFormula 1 EmotionalState)
(domain attitudeForFormula 2 AutonomousAgent)
(domain attitudeForFormula 3 Formula)