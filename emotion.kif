(termFormat EnglishWrittenLanguage Pride "pride")
(termFormat FrenchWrittenLanguage Pride "fierté")
(termFormat GermanWrittenLanguage Pride "stolz")
(termFormat SpanishWrittenLanguage Pride "orgullo")
(utterance EnglishWrittenLanguage Pride "proud")
(instance Pride EmotionalState)
