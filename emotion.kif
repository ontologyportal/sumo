;; Pease, A., (2011). Ontology: A Practical Guide. Articulate Software Press,
;; Angwin, CA. ISBN 978-1-889455-10-5.

;; This ontology used the BFO Emotion Ontology as a starting point.
;; The comments below are credits for this source material.

;; The original ontology is under Creative Commons license
;; The Emotion Ontology is an ontology for affective phenomena such
;; as emotions and moods. It is being developed collaboratively
;; between the Swiss Centre of Affective Sciences and the University
;; at Buffalo. It builds on the Ontology of Mental Functioning (MFO)
;; and the Basic Formal Ontology (BFO). The latest version of the
;; ontology can always be found at
;; http://code.google.com/p/emotion_ontology/source/browse/#svn%2Ftrunk%2Fontology.
;; versionInfo "beta 2013-03-25"
;; dc_contributor "Barry Smith"
;; dc_contributor "Janna Hastings"
;; dc_contributor "Kevin Mulligan"

;; Sources for terms and synonyms / translations :
;;   GRID project vocabulary resources (Cristina Soriano)

;; Sources for definitions: OCEAS => Oxford Companion to Emotion and the
;; Affective Sciences, ed. David Sander and Klaus Scherer, Oxford University Press, 2009.

;; MFOEM was been translated into SUO_KIF and lightly aligned with SUMO beginning on 4/7/2013
;; substantial expansion and reworking 6/2/2013

;; -------------- Basic concepts --------------

(subclass AppraisalProcess IntentionalPsychologicalProcess)
(documentation AppraisalProcess EnglishWrittenLanguage "An appraisal process is
a mental process that gives rise to an appraisal of one's own current
emotional state.  It is the conscious
realization that one has unconsciously arrived at a particular mood.")
(termFormat EnglishWrittenLanguage AppraisalProcess "appraisal process")
(relatedInternalConcept Appraisal AppraisalProcess)

(=>
   (and
      (instance ?X AppraisalProcess)
      (agent ?X ?A))
   (exists (?APP)
      (and
         (instance ?APP Appraisal)
         (knows ?A
            (attribute ?A ?APP)))))

(=>
   (and
      (instance ?EBP EmotionalBehavioralProcess)
      (agent ?EBP ?A))
   (exists (?APP)
      (and
         (instance ?APP AppraisalProcess)
         (agent ?APP ?A)
         (causes ?APP ?EBP))))

(termFormat EnglishWrittenLanguage SubjectiveEmotionalFeeling "subjective
emotional feeling")
(documentation SubjectiveEmotionalFeeling EnglishWrittenLanguage "Excluded the
following subjective feelings which appear on the GRID questionnaire
since they seem debatable to what extent they are really *feelings* and
to what extent they are actually *evaluations* or other things: -- felt
submissive/dominant -- felt powerless/powerful")
(subclass SubjectiveEmotionalFeeling EmotionalState)
(documentation SubjectiveEmotionalFeeling EnglishWrittenLanguage "The
subjective emotional feeling is an affective representation, that is, a
representation that the organism has about its own affect.")

(termFormat EnglishWrittenLanguage Appraisal "appraisal")
(subclass Appraisal StateOfMind)
(documentation Appraisal EnglishWrittenLanguage "An appraisal is a cognitive
representation which represents an evaluation of the relevance of some
triggering object or event to the organism.")

(termFormat EnglishWrittenLanguage EmotionalSpeakingBehavior "emotional
speaking behavior")
(documentation EmotionalSpeakingBehavior EnglishWrittenLanguage "An &%EmotionalSpeakingBehavior is a kind of &%Speaking that is characterized by the expression of an emotional state through the vocalization and modulation of language, serving as a specific instance of an &%EmotionalBehavioralProcess within the broader context of &%LinguisticCommunication.")
(subclass EmotionalSpeakingBehavior Speaking)
(subclass EmotionalSpeakingBehavior EmotionalBehavioralProcess)

(termFormat EnglishWrittenLanguage EmotionalVoiceUtterances "emotional voice
utterances")
(documentation EmotionalVoiceUtterances EnglishWrittenLanguage "The vocal
utterances associated with the characteristic sound of an emotion.
Obviously, any particular emotional instance may be associated with a
great variety of different types of voice utterances or no voice
utterances at all. However, &quot;canonical&quot; or characteristic
voice utterances can be associated with core emotions.")
(subclass EmotionalVoiceUtterances EmotionalSpeakingBehavior)

(=>
   (instance ?EVU EmotionalVoiceUtterances)
   (exists (?A)
      (causesProposition
         (exists (?E ?A)
            (and
               (instance ?E EmotionalState)
               (attribute ?A ?E)))
         (agent ?EVU ?A))))

(instance emotionTendency BinaryPredicate)
(domain emotionTendency 1 AutonomousAgent)
(domain emotionTendency 2 EmotionalState)
(documentation emotionTendency EnglishWrittenLanguage "A tendency of an &%Agent
to exhibit a particular emotion.  Someone with such a tendency is more likely to
exhibit an emotion, a priori, than someone without such tendency.")

(=>
   (emotionTendency ?A ?ES)
   (greaterThan
      (ProbabilityFn
         (attribute ?A ?ES))
      (ProbabilityFn
         (not
            (attribute ?A ?ES)))))

(instance actionTendency BinaryPredicate)
(domain actionTendency 1 EmotionalState)
(domainSubclass actionTendency 2 EmotionalBehavioralProcess)
(documentation actionTendency EnglishWrittenLanguage "A tendency of an emotion
to cause a particular type of action.")

(=>
   (and
      (holdsDuring ?T
         (attribute ?A ?ES))
      (actionTendency ?ES ?PI))
   (modalAttribute
      (exists (?P)
         (and
            (instance ?P ?PI)
            (during
               (WhenFn ?P) ?T)
            (experiencer ?P ?A)))
      Likely))

(actionTendency Surprise SurprisedFacialExpression)
(actionTendency Grief Weeping)
(actionTendency Happiness Laughing)
(actionTendency Happiness Smiling)
(actionTendency Unhappiness Frowning)
(actionTendency Surprise JawDropping)
(actionTendency Surprise OpeningEyesWidely)
(actionTendency Surprise RaisingEyebrows)
(actionTendency Disgust DisgustedFacialExpression)
(actionTendency Fear FearfulFacialExpression)
(actionTendency Happiness HappyFacialExpression)
(actionTendency Sadness SadFacialExpression)
(actionTendency Anger AngryFacialExpression)

(instance utterance TernaryPredicate)
(documentation utterance EnglishWrittenLanguage "A prototypical linguistic
statement incorporating the concept in a phrase or sentence.")
(domain utterance 1 HumanLanguage)
(domain utterance 2 Entity)
(domain utterance 3 SymbolicString)
(utterance EnglishWrittenLanguage Surprise "surprised")

(instance pastTense TernaryPredicate)
(documentation pastTense EnglishWrittenLanguage "The past tense form of a
concept when stated in the given language.")
(domain pastTense 1 HumanLanguage)
(domain pastTense 2 Entity)
(domain pastTense 3 SymbolicString)

;; -------------- Appraisal --------------

(termFormat EnglishWrittenLanguage AppraisalOfGoalImportance "appraisal of goal
importance")
(documentation AppraisalOfGoalImportance EnglishWrittenLanguage "Like
pleasantness, the GRID questionnaire distinguishes between evaluations
of goal importance/relevance for SELF and for an OTHER.")
(subclass AppraisalOfGoalImportance Appraisal)
(documentation AppraisalOfGoalImportance EnglishWrittenLanguage "An appraisal
that represents an evaluation of whether an event or object is important
to the person&apos;s goals or needs.")
(exhaustiveAttribute AppraisalOfGoalImportance
   EvaluationAsImportantToGoals EvaluationAsNotImportantToGoals)

(instance EvaluationAsImportantToGoals AppraisalOfGoalImportance)
(utterance EnglishWrittenLanguage  EvaluationAsImportantToGoals "this is
important for my goals")
(documentation EvaluationAsImportantToGoals EnglishWrittenLanguage "An
appraisal that represents an evaluation that the event or object is
important to the person&apos;s goals or needs.")
(termFormat EnglishWrittenLanguage EvaluationAsImportantToGoals "evaluation as
important to goals")

(documentation EvaluationAsNotImportantToGoals EnglishWrittenLanguage "An
appraisal that represents an evaluation that the event or object is not
important to the person&apos;s goals or needs.")
(instance EvaluationAsNotImportantToGoals AppraisalOfGoalImportance)
(termFormat EnglishWrittenLanguage EvaluationAsNotImportantToGoals "evaluation
as not important to goals")
(utterance EnglishWrittenLanguage EvaluationAsNotImportantToGoals "this is not
important for my goals")


(termFormat EnglishWrittenLanguage AppraisalOfPredictability "appraisal of
predictability")
(documentation AppraisalOfPredictability EnglishWrittenLanguage "An appraisal
that represents an evaluation of how predictable an event was.")
(subclass AppraisalOfPredictability Appraisal)
(exhaustiveAttribute AppraisalOfPredictability AppraisalAsPredictable
   AppraisalAsNotPredictable)

(documentation AppraisalAsPredictable EnglishWrittenLanguage "An appraisal that
represents an evaluation that an event was easy to predict.")
(utterance EnglishWrittenLanguage AppraisalAsPredictable "this is predictable")
(instance AppraisalAsPredictable AppraisalOfPredictability)
(termFormat EnglishWrittenLanguage AppraisalAsPredictable "appraisal as
predictable")

(utterance EnglishWrittenLanguage AppraisalAsNotPredictable "this is not
predictable")
(documentation AppraisalAsNotPredictable EnglishWrittenLanguage "An appraisal
that represents an evaluation that an event was not easy to predict.")
(termFormat EnglishWrittenLanguage AppraisalAsNotPredictable "appraisal as not
predictable")
(instance AppraisalAsNotPredictable AppraisalOfPredictability)


(utterance EnglishWrittenLanguage AppraisalOfLoss "I have irrevocably lost
something important")
(documentation AppraisalOfLoss EnglishWrittenLanguage "An appraisal that
represents a belief that something or someone that is important to the
person has been lost to the person.")
(documentation AppraisalOfLoss EnglishWrittenLanguage "This appraisal category
stands alone: appraisal of loss is not a continuum like the others
(pleasant---unpleasant; expected---unexpected). Rather it is quite
discrete, loss or no loss, and is better defined by WHAT has been lost,
or at least, in which relation the thing that has been lost stands to
the person experiencing the emotion. Loss of a loved person, loss of the
expectation of achieving a hoped for life goal, and loss of a limb are
all kinds of loss. While it is tempting not to categorise this as an
appraisal at all, it should be noted that the loss does not actually
have to occur -- it only has to be believed, judged, or (in other words)
appraised to have occurred -- for the emotion to take place.")
(subclass AppraisalOfLoss Appraisal)
(termFormat EnglishWrittenLanguage AppraisalOfLoss "appraisal of loss")


(termFormat EnglishWrittenLanguage AppraisalOfAvoidabilityOfConsequences
   "appraisal of avoidability of consequences")
(subclass AppraisalOfAvoidabilityOfConsequences Appraisal)
(documentation AppraisalOfAvoidabilityOfConsequences EnglishWrittenLanguage "An
appraisal which represents a judgement about how avoidable the expected
consequences of an event will be.")
(exhaustiveAttribute AppraisalOfAvoidabilityOfConsequences
   AppraisalAsAvoidableConsequences AppraisalAsUnavoidableConsequences)

(utterance EnglishWrittenLanguage AppraisalAsAvoidableConsequences "there are
consequences but they are avoidable")
(instance AppraisalAsAvoidableConsequences
   AppraisalOfAvoidabilityOfConsequences)
(documentation AppraisalAsAvoidableConsequences EnglishWrittenLanguage "An
appraisal that represents a judgement that the expected consequences of
an event are in principle avoidable or modfiable.")
(termFormat EnglishWrittenLanguage AppraisalAsAvoidableConsequences "appraisal
as avoidable consequences")

(termFormat EnglishWrittenLanguage AppraisalAsUnavoidableConsequences
   "appraisal as unavoidable consequences")
(instance AppraisalAsUnavoidableConsequences
   AppraisalOfAvoidabilityOfConsequences)
(utterance EnglishWrittenLanguage AppraisalAsUnavoidableConsequences "there are
consequences and they are unavoidable")
(documentation AppraisalAsUnavoidableConsequences EnglishWrittenLanguage "An
appraisal that represents a judgement that the expected consequences of
an event will be difficult to avoid or modify.")


(documentation AppraisalOfFamiliarity EnglishWrittenLanguage "An appraisal that
represents an evaluation of how familiar an object or event is.")
(termFormat EnglishWrittenLanguage AppraisalOfFamiliarity "appraisal of
familiarity")
(subclass AppraisalOfFamiliarity Appraisal)
(exhaustiveAttribute AppraisalOfFamiliarity AppraisalAsFamiliar
   AppraisalAsNotFamiliar)

(documentation AppraisalAsFamiliar EnglishWrittenLanguage "An appraisal that
represents an evaluation that an object or event is familiar.")
(instance AppraisalAsFamiliar AppraisalOfFamiliarity)
(utterance EnglishWrittenLanguage AppraisalAsFamiliar "this is familiar")
(termFormat EnglishWrittenLanguage AppraisalAsFamiliar "appraisal as familiar")

(termFormat EnglishWrittenLanguage AppraisalAsNotFamiliar "appraisal as not
familiar")
(documentation AppraisalAsNotFamiliar EnglishWrittenLanguage "An appraisal that
represents an evaluation that an object or event is not familiar.")
(utterance EnglishWrittenLanguage AppraisalAsNotFamiliar "this is not familiar")
(instance AppraisalAsNotFamiliar AppraisalOfFamiliarity)


(documentation AppraisalOfJusticeOfTreatment EnglishWrittenLanguage "Appraisal
which represents an evaluation of whether the person was treated justly
or unjustly by another person.")
(termFormat EnglishWrittenLanguage AppraisalOfJusticeOfTreatment "appraisal of
justice of treatment")
(subclass AppraisalOfJusticeOfTreatment Appraisal)
(exhaustiveAttribute AppraisalOfJusticeOfTreatment
   AppraisalAsUnjustTreatment AppraisalAsJustTreatment)

(termFormat EnglishWrittenLanguage AppraisalAsUnjustTreatment "appraisal as
unjust treatment")
(instance AppraisalAsUnjustTreatment AppraisalOfJusticeOfTreatment)
(documentation AppraisalAsUnjustTreatment EnglishWrittenLanguage "An appraisal
that represents an evaluation that the person was treated unjustly by
another person. (Injustice.)")
(utterance EnglishWrittenLanguage AppraisalAsUnjustTreatment "I am being
treated unjustly")

(=>
   (and
      (attribute ?A AppraisalAsUnjustTreatment)
      (instance ?AUJ AppraisalProcess)
      (agent ?AUJ ?A))
   (exists (?P ?A2)
      (and
         (instance ?P Process)
         (refers ?AUJ ?P)
         (agent ?P ?A2)
         (not
            (equal ?A ?A2))
         (patient ?P ?A)
         (not
            (wants ?A ?P)))))

(instance AppraisalAsJustTreatment AppraisalOfJusticeOfTreatment)
(utterance EnglishWrittenLanguage AppraisalAsJustTreatment "I am being treated
justly")
(termFormat EnglishWrittenLanguage AppraisalAsJustTreatment "appraisal as just
treatment")
(documentation AppraisalAsJustTreatment EnglishWrittenLanguage "An appraisal
which represents an evaluation that the person was treated justly by
another person.")

(=>
   (and
      (attribute ?A AppraisalAsJustTreatment)
      (instance ?AJT AppraisalProcess)
      (agent ?AJT ?A))
   (exists (?P ?A2)
      (and
         (instance ?P Process)
         (refers ?AJT ?P)
         (agent ?P ?A2)
         (not
            (equal ?A ?A2))
         (patient ?P ?A)
         (wants ?A ?P))))

(subclass AppraisalOfDesirabilityOfConsequences Appraisal)
(documentation AppraisalOfDesirabilityOfConsequences EnglishWrittenLanguage "An
appraisal that represents an evaluation of the desirability of the
expected consequences of an event.")
(documentation AppraisalOfDesirabilityOfConsequences EnglishWrittenLanguage
   "Distinguished in GRID questionnaire between FOR SELF and FOR OTHER.")
(termFormat EnglishWrittenLanguage AppraisalOfDesirabilityOfConsequences
   "appraisal of desirability of consequences")
(exhaustiveAttribute AppraisalOfDesirabilityOfConsequences
   AppraisalAsDesirableConsequences AppraisalAsUndesirableConsequences)

(termFormat EnglishWrittenLanguage AppraisalAsDesirableConsequences "appraisal
as desirable consequences")
(documentation AppraisalAsDesirableConsequences EnglishWrittenLanguage "An
appraisal that represents an evaluation that the expected consequences
of an event are desirable.")
(utterance EnglishWrittenLanguage AppraisalAsDesirableConsequences "this has
desirable consequences")
(instance AppraisalAsDesirableConsequences
   AppraisalOfDesirabilityOfConsequences)

(documentation AppraisalAsUndesirableConsequences EnglishWrittenLanguage "An
appraisal that represents an evaluation that the expected consequences
of an event are undesirable.")
(relatedInternalConcept EmotionalState AppraisalAsUndesirableConsequences)
(termFormat EnglishWrittenLanguage AppraisalAsUndesirableConsequences
   "appraisal as undesirable consequences")
(utterance EnglishWrittenLanguage AppraisalAsUndesirableConsequences "this has
undesirable consequences")
(instance AppraisalAsUndesirableConsequences
   AppraisalOfDesirabilityOfConsequences)


(documentation AppraisalOfUrgency EnglishWrittenLanguage "An appraisal that
represents an evaluation of the urgency of responding to an event.")
(subclass AppraisalOfUrgency Appraisal)
(termFormat EnglishWrittenLanguage AppraisalOfUrgency "appraisal of urgency of
response")
(exhaustiveAttribute AppraisalOfUrgency AppraisalAsNotUrgentResponse
   AppraisalAsUrgentResponse)

(utterance EnglishWrittenLanguage AppraisalAsNotUrgentResponse "a response is
needed but not urgently")
(documentation AppraisalAsNotUrgentResponse EnglishWrittenLanguage "An
appraisal that represents an evaluation that an event does not require
an urgent response.")
(termFormat EnglishWrittenLanguage AppraisalAsNotUrgentResponse "appraisal as
not urgent response")
(instance AppraisalAsNotUrgentResponse AppraisalOfUrgency)

(instance AppraisalAsUrgentResponse AppraisalOfUrgency)
(utterance EnglishWrittenLanguage AppraisalAsUrgentResponse "a response is
needed urgently")
(documentation AppraisalAsUrgentResponse EnglishWrittenLanguage "An appraisal
that represents an evaluation that an event requires an urgent
(immediate) response.")
(termFormat EnglishWrittenLanguage AppraisalAsUrgentResponse "appraisal as
urgent response")


(termFormat EnglishWrittenLanguage AppraisalOfCongruenceWithIdeals "appraisal
of congruence with ideals")
(documentation AppraisalOfCongruenceWithIdeals EnglishWrittenLanguage "Can also
be defined FOR SELF and FOR OTHER, where a special case of OTHER is
&apos;society&apos; (=> a judgement that an event violated laws or
socially accepted norms) May want to distinguish violation of
&apos;standards&apos; from that of &apos;ideals&apos;, &apos;norms&apos;
and &apos;laws&apos;. At the moment they are all lumped together.")
(documentation AppraisalOfCongruenceWithIdeals EnglishWrittenLanguage "An
appraisal which represents a judgement about whether an event is
consistent with the person&apos;s standards or ideals.")
(subclass AppraisalOfCongruenceWithIdeals Appraisal)
(exhaustiveAttribute AppraisalOfCongruenceWithIdeals
   AppraisalAsCongruentWithIdeals AppraisalAsNotCongruentWithIdeals)

(instance AppraisalAsCongruentWithIdeals AppraisalOfCongruenceWithIdeals)
(utterance EnglishWrittenLanguage AppraisalAsCongruentWithIdeals "this is in
line with my ideals")
(documentation AppraisalAsCongruentWithIdeals EnglishWrittenLanguage "An
appraisal which represents a judgement that an event is consistent with
the person&apos;s standards or ideals.")
(termFormat EnglishWrittenLanguage AppraisalAsCongruentWithIdeals "appraisal as
congruent with ideals")

(instance AppraisalAsNotCongruentWithIdeals AppraisalOfCongruenceWithIdeals)
(termFormat EnglishWrittenLanguage AppraisalAsNotCongruentWithIdeals "appraisal
as not congruent with ideals")
(documentation AppraisalAsNotCongruentWithIdeals EnglishWrittenLanguage "An
appraisal that represents a judgement that an event is inconsistent with
a person&apos;s standards or ideals.")
(utterance EnglishWrittenLanguage AppraisalAsNotCongruentWithIdeals "this is
against my ideals")


(termFormat EnglishWrittenLanguage AppraisalOfPleasantness "appraisal of
pleasantness")
(documentation AppraisalOfPleasantness EnglishWrittenLanguage "GRID
questionnaire distinguishes between appraisal of pleasantness FOR SELF
and appraisal of pleasantness FOR SOME OTHER. So far we have defined
appraisal as evaluation of relevance FOR SELF, thus, we only include one
appraisal of pleasantness (for the time being), although we may expand
this later -- although I suspect that all or most of the appraisal types
would have to be so qualified.")
(documentation AppraisalOfPleasantness EnglishWrittenLanguage "An appraisal
that represents an evaluation of the pleasantness of an object or event.")
(subclass AppraisalOfPleasantness Appraisal)
(exhaustiveAttribute AppraisalOfPleasantness AppraisalAsPleasant
   AppraisalAsUnpleasant)

(termFormat EnglishWrittenLanguage AppraisalAsPleasant "appraisal as pleasant")
(documentation AppraisalAsPleasant EnglishWrittenLanguage "An appraisal that
represents an evaluation that an object or event is pleasant.")
(instance AppraisalAsPleasant AppraisalOfPleasantness)
(utterance EnglishWrittenLanguage AppraisalAsPleasant "this is pleasant")

(utterance EnglishWrittenLanguage AppraisalAsUnpleasant "this is unpleasant")
(documentation AppraisalAsUnpleasant EnglishWrittenLanguage "An appraisal that
represents an evaluation that an object or event is unpleasant.")
(instance AppraisalAsUnpleasant AppraisalOfPleasantness)
(termFormat EnglishWrittenLanguage AppraisalAsUnpleasant "appraisal as unpleasant")


(documentation AppraisalAsBeingDisliked EnglishWrittenLanguage "Appraisal that
one is being disliked")
(instance AppraisalAsBeingDisliked Appraisal)
(termFormat EnglishWrittenLanguage AppraisalAsBeingDisliked "appraisal as being
disliked")

(termFormat EnglishWrittenLanguage AppraisalAsBeingLiked "appraisal as being
liked")
(documentation AppraisalAsBeingLiked EnglishWrittenLanguage "appraisal that one
is being liked")
(instance AppraisalAsBeingLiked Appraisal)
(contraryAttribute AppraisalAsBeingDisliked AppraisalAsBeingLiked)

(subclass AppraisalOfExpectedness Appraisal)
(termFormat EnglishWrittenLanguage AppraisalOfExpectedness "appraisal of
expectedness")
(documentation AppraisalOfExpectedness EnglishWrittenLanguage "An appraisal
that represents an evaluation of whether an event was expected to occur.")
(exhaustiveDecomposition AppraisalOfExpectedness AppraisalAsExpected AppraisalAsNotExpected)

(termFormat EnglishWrittenLanguage AppraisalAsExpected "appraisal as expected")
(utterance EnglishWrittenLanguage AppraisalAsExpected "this is expected")
(documentation AppraisalAsExpected EnglishWrittenLanguage "An appraisal that
represents an evaluation that an event was expected.")
(subclass AppraisalAsExpected AppraisalOfExpectedness)

(termFormat EnglishWrittenLanguage AppraisalAsNotExpected "appraisal as not
expected")
(documentation AppraisalAsNotExpected EnglishWrittenLanguage "An appraisal that
represents an evaluation that an event was not expected.")
(instance AppraisalAsNotExpected AppraisalOfExpectedness)
(utterance EnglishWrittenLanguage AppraisalAsNotExpected "this is not expected")


(subclass AppraisalOfDangerousness Appraisal)
(documentation AppraisalOfDangerousness EnglishWrittenLanguage "An appraisal
which represents an evaluation of the dangerousness of an object or
situation.")
(termFormat EnglishWrittenLanguage AppraisalOfDangerousness "appraisal of
dangerousness")
(exhaustiveAttribute AppraisalOfDangerousness AppraisalAsNotDangerous
   AppraisalAsDangerous)

(documentation AppraisalAsNotDangerous EnglishWrittenLanguage "An appraisal
that represents an evaluation that an object or situation is not
dangerous to the person.")
(termFormat EnglishWrittenLanguage AppraisalAsNotDangerous "appraisal as not
dangerous")
(utterance EnglishWrittenLanguage AppraisalAsNotDangerous "this is not dangerous")
(instance AppraisalAsNotDangerous AppraisalOfDangerousness)

(termFormat EnglishWrittenLanguage AppraisalAsDangerous "appraisal as dangerous")
(utterance EnglishWrittenLanguage AppraisalAsDangerous "this is dangerous")
(documentation AppraisalAsDangerous EnglishWrittenLanguage "An appraisal that
represents an evaluation that an object or situation is dangerous to the
person.")
(instance AppraisalAsDangerous AppraisalOfDangerousness)


(documentation AppraisalOfSuddenness EnglishWrittenLanguage "An appraisal which
represents an evaluation of how suddenly an event occurred.")
(subclass AppraisalOfSuddenness Appraisal)
(termFormat EnglishWrittenLanguage AppraisalOfSuddenness "appraisal of suddenness")
(exhaustiveAttribute AppraisalOfSuddenness AppraisalAsSudden
   AppraisalAsNotSudden)

(documentation AppraisalAsSudden EnglishWrittenLanguage "An appraisal that
represents an evaluation that an event occurred suddenly.")
(instance AppraisalAsSudden AppraisalOfSuddenness)
(utterance EnglishWrittenLanguage AppraisalAsSudden "this is sudden")
(termFormat EnglishWrittenLanguage AppraisalAsSudden "appraisal as sudden")

(documentation AppraisalAsNotSudden EnglishWrittenLanguage "An appraisal that
represents an evaluation that an event did not occur suddenly.")
(utterance EnglishWrittenLanguage AppraisalAsNotSudden "this is not sudden")
(instance AppraisalAsNotSudden AppraisalOfSuddenness)
(termFormat EnglishWrittenLanguage AppraisalAsNotSudden "appraisal as not sudden")


(subclass AppraisalOfCausalAgency Appraisal)
(documentation AppraisalOfCausalAgency EnglishWrittenLanguage "An appraisal
that represents an evaluation of who or what caused an event.")
(termFormat EnglishWrittenLanguage AppraisalOfCausalAgency "appraisal of causal
agency")
(exhaustiveAttribute AppraisalOfCausalAgency
   AppraisalAsCausedSupernaturally AppraisalAsCausedBySelf
   AppraisalAsCausedByChance AppraisalAsCausedByAnother)

(utterance EnglishWrittenLanguage AppraisalAsCausedByAnother "this is being
caused by someone else")
(instance AppraisalAsCausedByAnother AppraisalOfCausalAgency)
(documentation AppraisalAsCausedByAnother EnglishWrittenLanguage "An appraisal
that represents an evaluation that an event was caused by another person.")
(termFormat EnglishWrittenLanguage AppraisalAsCausedByAnother "appraisal as
caused by an other")

(utterance EnglishWrittenLanguage AppraisalAsCausedSupernaturally "this is
being caused supernaturally")
(documentation AppraisalAsCausedSupernaturally EnglishWrittenLanguage "An
appraisal that represents an evaluation that an event was caused by a
supernatural agent (God, the ancestors, ghosts...).")
(instance AppraisalAsCausedSupernaturally AppraisalOfCausalAgency)
(termFormat EnglishWrittenLanguage AppraisalAsCausedSupernaturally "appraisal
as caused supernaturally")

(utterance EnglishWrittenLanguage AppraisalAsCausedBySelf "this is being caused
by me")
(termFormat EnglishWrittenLanguage AppraisalAsCausedBySelf "appraisal as caused
by self")
(documentation AppraisalAsCausedBySelf EnglishWrittenLanguage "An appraisal
that represents an evaluation that an event was caused by the self.")
(instance AppraisalAsCausedBySelf AppraisalOfCausalAgency)

(utterance EnglishWrittenLanguage AppraisalAsCausedByChance "this is being
caused by chance")
(documentation AppraisalAsCausedByChance EnglishWrittenLanguage "An appraisal
that represents an evaluation that an event was caused by chance.")
(termFormat EnglishWrittenLanguage AppraisalAsCausedByChance "appraisal as
caused by chance")
(instance AppraisalAsCausedByChance AppraisalOfCausalAgency)


(documentation AppraisalOfSocialAttention EnglishWrittenLanguage "An appraisal
which represents a judgement about the direction and nature of the
social attention surrounding an event.")
(subclass AppraisalOfSocialAttention Appraisal)
(termFormat EnglishWrittenLanguage AppraisalOfSocialAttention "appraisal of
social attention")
(exhaustiveAttribute AppraisalOfSocialAttention
   AppraisalAsBeingAtTheCentreOfAttention
   AppraisalAsNotBeingAtTheCentreOfAttention)

(termFormat EnglishWrittenLanguage AppraisalAsBeingAtTheCentreOfAttention
   "appraisal as being at the centre of attention")
(instance AppraisalAsBeingAtTheCentreOfAttention AppraisalOfSocialAttention)
(utterance EnglishWrittenLanguage AppraisalAsBeingAtTheCentreOfAttention "I am
at the centre of attention")
(documentation AppraisalAsBeingAtTheCentreOfAttention EnglishWrittenLanguage
   "An appraisal which represents a judgement that the person is at the
centre of the surrounding social attention. (That is, that all other
nearby persons are paying attention to him/her.)")

(utterance EnglishWrittenLanguage AppraisalAsNotBeingAtTheCentreOfAttention "I
am not at the centre of attention")
(documentation AppraisalAsNotBeingAtTheCentreOfAttention EnglishWrittenLanguage
   "An appraisal that represents a judgement that a person is not at the
centre of the surrounding social attention.")
(instance AppraisalAsNotBeingAtTheCentreOfAttention
   AppraisalOfSocialAttention)
(termFormat EnglishWrittenLanguage AppraisalAsNotBeingAtTheCentreOfAttention
   "appraisal as not being at the centre of attention")


(termFormat EnglishWrittenLanguage AppraisalOfCausalIntent "appraisal of causal
intent")
(documentation AppraisalOfCausalIntent EnglishWrittenLanguage "An appraisal
that represents an evaluation of the causal intent of the person who (is
evaluated to have) caused an event.")
(subclass AppraisalOfCausalIntent Appraisal)
(exhaustiveAttribute AppraisalOfCausalIntent AppraisalAsUnintended
   AppraisalAsDeliberate)

(utterance EnglishWrittenLanguage AppraisalAsUnintended "this is not being
deliberately caused")
(instance AppraisalAsUnintended AppraisalOfCausalIntent)
(documentation AppraisalAsUnintended EnglishWrittenLanguage "An appraisal that
represents an evaluation that an event was caused unintentionally.")
(termFormat EnglishWrittenLanguage AppraisalAsUnintended "appraisal as unintended")

(termFormat EnglishWrittenLanguage AppraisalAsDeliberate "appraisal as deliberate")
(utterance EnglishWrittenLanguage AppraisalAsDeliberate "this is being
deliberately caused")
(documentation AppraisalAsDeliberate EnglishWrittenLanguage "An appraisal that
represents an evaluation that an event was deliberately (intentionally)
caused.")
(instance AppraisalAsDeliberate AppraisalOfCausalIntent)


;; -------------- Emotional States --------------

(documentation Panic EnglishWrittenLanguage "A severe episode of fear with
strong associated discomfort and thoughts of impending harm.")
(termFormat EnglishWrittenLanguage Panic "panic")
(subAttribute Panic Fear)
(utterance EnglishWrittenLanguage Panic "panicked")

(documentation Annoyance EnglishWrittenLanguage "The &%Annoyance is a specific kind of &%Anger characterized by a feeling of being slightly irritated or bothered, representing a relatively mild &%EmotionalState and &%StateOfMind.")
(subAttribute Annoyance Anger)
(utterance EnglishWrittenLanguage Annoyance "annoyed")
(termFormat EnglishWrittenLanguage Annoyance "annoyance")

(termFormat GermanWrittenLanguage Jealousy "eifersucht")
(termFormat EnglishWrittenLanguage Jealousy "jealousy")
(documentation Jealousy EnglishWrittenLanguage "A negative emotion aroused when
a person feels threatened by a rival in his or her relationship with
another individual, in particular an intimate partner. Involves feelings
of threat, fear, suspicion, distrust, anxiety, anger, betrayal, and
rejection. [Source: OCEAS]")
(termFormat FrenchWrittenLanguage Jealousy "jalousie")
(instance Jealousy EmotionalState)
(utterance EnglishWrittenLanguage Jealousy "jealous")
(termFormat SpanishWrittenLanguage Jealousy "celos")

(termFormat EnglishWrittenLanguage Interested "interested")
(documentation Interested EnglishWrittenLanguage "&%Interesed is a feeling or emotion 
that causes attention to focus on an object, event, or process.The emotion of 
interest does have its own facial expression, of which the most prominent 
component is having dilated pupils.[Wikipedia]")
(termFormat SpanishWrittenLanguage Interested "interés")
(termFormat FrenchWrittenLanguage Interested "intérêt")
(termFormat FrenchWrittenLanguage Interested "interesse")
(termFormat EnglishWrittenLanguage Interested "interest")
(instance Interested EmotionalState)
(relatedInternalConcept Interested Curiosity)

(actionTendency Interested PupilsDilation)

(=>
   (holdsDuring ?T
      (attribute ?A Interested))
   (exists (?O ?I)
      (and
         (instance ?O Object)
         (patient ?I ?O)
         (instance ?I IntentionalPsychologicalProcess)
         (agent ?I ?A)
         (enjoys ?A ?I)
         (during ?T
            (WhenFn ?I)))))

(instance interestedIn BinaryPredicate)
(subrelation interestedIn inScopeOfInterest)
(documentation interestedIn EnglishWrittenLanguage "(interestedIn ?A ?O) means that the
&%CongitiveAgent ?A is interested in the &%Object ?O. This is different from &%enjoys 
in which the second argument is a &%Process. Both &%enjoys and &%interestedIn entail
a positive sentiment.")
(termFormat EnglishWrittenLanguage interestedIn "interested in")
(format EnglishWrittenLanguage interestedIn "%1 is interestedIn %2")
(domain interestedIn 1 CognitiveAgent)
(domain interestedIn 2 Object)

(=>
   (holdsDuring ?T
      (attribute ?A Interested))
   (holdsDuring ?T
      (exists (?O)
         (interestedIn ?A ?O))))

(subclass PupillaryResponse PhysiologicProcess)
(subclass PupillaryResponse QuantityChange)
(documentation PupillaryResponse EnglishWrittenLanguage "&%PupillaryResponse is a 
physiological response that varies the size of the pupil between 1.5 mm and 
8 mm in diameter,via the optic and oculomotor cranial nerve.[Wikipedia]")
(termFormat EnglishWrittenLanguage PupillaryResponse "pupillary response")
(partition PupillaryResponse PupilsConstriction PupilsDilation)

(=>
   (and
      (instance ?R PupillaryResponse)
      (patient ?R ?P)
      (instance ?P BothEyePupils)
      (subProcess ?C ?R)
      (instance ?C QuantityChange)
      (patient ?C ?P)
      (instance ?DIAM LengthMeasure)
      (equal ?DIAM (MeasureFn ?X Millimeter))
      (approximateDiameter ?P ?DIAM))
   (and
      (greaterThanOrEqualTo ?X 1.5)
      (lessThanOrEqualTo ?X 8.0)))

;(subclass PupillaryLightReflex PupillaryResponse)
(subclass PupillaryLightReflex AutonomicProcess)
(documentation PupillaryLightReflex EnglishWrittenLanguage "&%PupillaryLightReflex or 
Photopupilary reflex is a reflex that controls the diameter of the &EyePupil, 
in response to the intensity of light that falls on the retinal ganglion cells 
of the retina in the back of the eye, thereby assisting the adaptation of vision 
to various level of lightness/darkness. A greater intensity of the light causes
the pupil to constrict; whereas a lower intensity of light causes the pupil to
dilate. Thus the pupillary light reflex regualtes the intensity of the light 
entering the eye. Light shone into one eye will cause both pupils to constrict.
[Wikipedia]")
(termFormat EnglishWrittenLanguage PupillaryLightReflex "pupillary light reflex")  
(termFormat EnglishWrittenLanguage PupillaryLightReflex "photopupillary reflex") 

(=>
   (and
      (instance ?R PupillaryLightReflex)
      (patient ?R ?P)
      (instance ?P BothEyePupils))
   (exists (?L)
      (and
         (instance ?L RadiatingVisibleLight)
         (patient ?L ?P)
         (causes ?L ?R))))

(subclass PupilsDilation PhysiologicalResponseToEmotionalState)
(subclass PupilsDilation PupillaryResponse)
(documentation PupilsDilation EnglishWrittenLanguage "&%PupilsDilation 
is the widening of the pupil. Dilation of the pupil occurs when the 
smooth cells of the radial muscle, controlled by the sympathetic nervous 
system (SNS), contract, and also when the cells of the iris sphincter 
muscle relax.[wikipedia] ")
(termFormat EnglishWrittenLanguage PupilsDilation "dilated pupils")
(actionTendency Fear PupilsDilation)
(actionTendency Love PupilsDilation)
(actionTendency Anxiety PupilsDilation)
(actionTendency Surprise PupilsDilation)

(=>
   (and
      (instance ?D PupilsDilation)
      (patient ?D ?P)
      (instance ?P BothEyePupils)
      (instance ?DIAM1 LengthMeasure)      
      (equal ?DIAM1 (MeasureFn ?X Millimeter))
      (instance ?DIAM2 LengthMeasure)      
      (equal ?DIAM2 (MeasureFn ?Y Millimeter))
      (holdsDuring
         (BeginFn
            (WhenFn ?D))
         (approximateDiameter ?P ?DIAM1))
      (holdsDuring
         (EndFn
            (WhenFn ?D))
         (approximateDiameter ?P ?DIAM2)))
   (greaterThan ?Y ?X))

(=>
   (and
      (instance ?D PupilsDilation)
      (patient ?D ?P)
      (instance ?P BothEyePupils))
   (exists (?IDM ?ISM ?C ?R)
      (and
         (instance ?IDM IrisDilatorMuscle)
         (instance ?ISM IrisSphincterMuscle)
         (part ?IDM ?P)
         (part ?ISM ?P)
         (instance ?C MuscularContraction)
         (subProcess ?C ?D)
         (patient ?C ?IDM)
         (instance ?R MuscleRelaxing)
         (patient ?R ?ISM)
         (subProcess ?R ?D))))

(subclass Mydriasis PupilsDilation)
(subclass Mydriasis PathologicProcess)
(documentation Mydriasis EnglishWrittenLanguage "&%Mydriasis is kind of 
&%PupilsDilation that has a non-physiological cause, including disease, trauma,
or the use of certain types of drugs. It may also be of unknown cause. A 
mydriatic pupil will remain excessively large even in a bright environment. 
[wikipedia] ")
(termFormat EnglishWrittenLanguage Mydriasis "mydriasis")

(=>
  (and
    (instance ?M Mydriasis)
    (patient ?M ?P)
    (instance ?P BothEyePupils)
    (instance ?L RadiatingVisibleLight)
    (instance ?DIAM LengthMeasure)
    (equal ?DIAM
      (MeasureFn ?A Millimeter))
    (instance ?DIAM2 LengthMeasure)
    (equal ?DIAM2
      (MeasureFn ?B Millimeter))
    (patient ?L ?P)
    (holdsDuring
      (BeginFn
        (WhenFn ?L))
      (approximateDiameter ?P ?DIAM))
    (holdsDuring
      (EndFn
        (WhenFn ?L))
      (approximateDiameter ?P ?DIAM2)))
  (not
    (lessThan ?B ?A)))

(=>
   (and
      (instance ?M Mydriasis)
      (patient ?M ?P)
      (instance ?P BothEyePupils))
   (holdsDuring
      (WhenFn ?M)
      (not
         (exists (?L)
            (and
               (instance ?L PupillaryLightReflex)
               (patient ?L ?P))))))

(=>
   (and
      (patient ?I ?B)
      (instance ?B Brain)
      (or
         (instance ?I Stroke)
         (instance ?I Injuring)
         (instance ?I Seizure))
      (experiencer ?I ?H)
      (part ?B ?H))
   (modalAttribute
      (exists (?M)
         (and
            (instance ?M Mydriasis)
            (experiencer ?M ?H)
            (causes ?I ?M))) Possibility))

(=>
   (holdsDuring ?T
      (and
         (attribute ?H Drugged)
         (instance ?H Human)))
   (modalAttribute
      (exists (?M)
         (and
            (instance ?M Mydriasis)
            (patient ?M ?H)
            (during
               (WhenFn ?M) ?T))) Possibility))

(subclass PupilsConstriction PupillaryResponse)
(subclass PupilsConstriction PhysiologicalResponseToEmotionalState)
(documentation PupilsConstriction EnglishWrittenLanguage "&%PupilsConstriction 
 is the narrowing of the pupil. Constriction of the pupil occurs when the 
 circular muscle, controlled by the parasympathetic nervous system (PSNS), 
 contracts, and also to an extent when the radial muscle relaxes.[wikipedia] ")
(termFormat EnglishWrittenLanguage PupilsConstriction "constricted pupils")
(termFormat EnglishWrittenLanguage PupilsConstriction "miosis")
(disjoint PupilsDilation PupilsConstriction)
(actionTendency Anger PupilsConstriction)
(actionTendency Disgust PupilsConstriction)

(=>
   (and
      (instance ?C PupilsConstriction)
      (patient ?C ?P)
      (instance ?P BothEyePupils)
      (instance ?LENGTH LengthMeasure)
      (equal ?LENGTH (MeasureFn ?X Millimeter))
      (instance ?LENGTH2 LengthMeasure)
      (equal ?LENGTH2 (MeasureFn ?Y Millimeter))
      (holdsDuring
         (BeginFn
            (WhenFn ?C))
         (approximateDiameter ?P ?LENGTH))
      (holdsDuring
         (EndFn
            (WhenFn ?C))
         (approximateDiameter ?P ?LENGTH2)))
   (greaterThan ?X ?Y))

(=>
   (and
      (instance ?C PupilsConstriction)
      (patient ?D ?P)
      (instance ?P BothEyePupils))
   (exists (?IDM ?ISM ?R ?MC)
      (and
         (instance ?IDM IrisDilatorMuscle)
         (instance ?ISM IrisSphincterMuscle)
         (part ?IDM ?P)
         (part ?ISM ?P)
         (instance ?MC MuscularContraction)
         (subProcess ?MC ?C)
         (patient ?MC ?ISM)
         (instance ?R MuscleRelaxing)
         (patient ?R ?IDM)
         (subProcess ?R ?C))))

(subclass Miosis PupilsConstriction)
(subclass Miosis PathologicProcess)
(documentation Miosis EnglishWrittenLanguage "&%Miosis is excessive 
constriction of the pupil.The opposite condition, mydriasis.[wikipedia] ")
(termFormat EnglishWrittenLanguage Miosis "miosis")
(disjoint Miosis Mydriasis)

(=>
   (and
      (instance ?M Miosis)
      (patient ?M ?P)
      (instance ?P BothEyePupils)
      (instance ?L RadiatingVisibleLight)
      (patient ?L ?P)
      (instance ?LENGTH LengthMeasure)
      (equal ?LENGTH (MeasureFn ?A Millimeter))
      (instance ?LENGTH2 LengthMeasure)
      (equal ?LENGTH2 (MeasureFn ?B Millimeter))
      (holdsDuring
         (BeginFn
            (WhenFn ?L))
         (approximateDiameter ?P ?LENGTH))
      (holdsDuring
         (EndFn
            (WhenFn ?L))
         (approximateDiameter ?P ?LENGTH2)))
   (not
      (greaterThan ?B ?A)))

(=>
   (and
      (instance ?M Miosis)
      (patient ?M ?P)
      (instance ?P BothEyePupils))
   (holdsDuring
      (WhenFn ?M)
      (not
         (exists (?L)
            (and
               (instance ?L PupillaryLightReflex)
               (patient ?L ?P))))))

(=>
   (and
      (patient ?I ?B)
      (instance ?B Brain)
      (or
         (instance ?I Stroke)
         (instance ?I Injuring)
         (instance ?I Seizure))
      (experiencer ?I ?H)
      (part ?B ?H))
   (modalAttribute
      (exists (?M)
         (and
            (instance ?M Miosis)
            (experiencer ?M ?H)
            (causes ?I ?M))) Possibility))

(=>
   (holdsDuring ?T
      (and
         (attribute ?H Drugged)
         (instance ?H Human)))
   (modalAttribute
      (exists (?M)
         (and
            (instance ?M Miosis)
            (patient ?M ?H)
            (during
               (WhenFn ?M) ?T))) Possibility))

(subclass BothEyePupils Pair)
(documentation BothEyePupils EnglishWrittenLanguage "&%BothEyePupils are the right
and left pupils of the eyes.")
(termFormat EnglishWrittenLanguage BothEyePupils "both eye pupils")

(=>
   (and
      (instance ?P BothEyePupils)
      (member ?L ?P)
      (member ?R ?P))
   (and
      (instance ?L
         (BodySideFn Left EyePupil))
      (instance ?R
         (BodySideFn Right EyePupil))))

(subclass Anisocoria DiseaseOrSyndrome)
(documentation Anisocoria EnglishWrittenLanguage "&%Anisocoria a condition 
characterized by an unequal size of the eyes' pupils. Affecting up to 20% 
of the population, anisocoria is often entirely harmless, but can be a 
sign of more serious medical problems.It is defined by a diameter difference 
of 0.4 mm or more between the sizes of the pupils of the eyes.[Wikipedia]")
(termFormat EnglishWrittenLanguage Anisocoria "anisocoria")

(=>
   (holdsDuring ?T
      (and
         (attribute ?H ?A)    
         (instance ?H Human)
         (instance ?A Anisocoria)
         (part ?P ?H)
         (instance ?R PupillaryResponse)
         (patient ?R ?P)
         (instance ?P BothEyePupils)
         (equal
            (DiffPupilSizeFn ?P)
            (MeasureFn ?Z Millimeter))))
   (greaterThan ?Z 0.4))

(instance PhysiologicalAnisocoria Anisocoria)
(documentation PhysiologicalAnisocoria EnglishWrittenLanguage "About 20% of the population has a 
slight difference in pupil size, which is know as &%PhysiologicalAnisocoria. In 
this condition, the difference between pupils is usually less than 1mm. [Wikipedia]")
(termFormat EnglishWrittenLanguage PhysiologicalAnisocoria "physiological anisocoria")

(=>
   (and
      (attribute ?H PhysiologicalAnisocoria)
      (instance ?H Human)
      (part ?P ?H)
      (instance ?P BothEyePupils)
      (equal
         (MeasureFn ?Z Millimeter)
         (DiffPupilSizeFn ?P)))
   (lessThan ?Z 1))

(instance MechanicalAnisocoria Anisocoria)
(documentation MechanicalAnisocoria EnglishWrittenLanguage "Occasionally, previous trauma, eye 
surgery, or inflammation (uveitis, angle closure glaucoma) can lead to adhesions between 
the iris and the lens. [Wikipedia]")
(termFormat EnglishWrittenLanguage MechanicalAnisocoria "mechanical anisocoria")

(=>
   (holdsDuring ?T
      (and
         (attribute ?H TraumaticBrainInjury)
         (instance ?H Human)))
   (modalAttribute
      (and
         (during ?T
            (ImmediateFutureFn ?T))
         (attribute ?H MechanicalAnisocoria)) Possibility))

(=>
   (and
      (instance ?I Inflammation)
      (patient ?I ?E)
      (instance ?E Eyeball)
      (part ?E ?H)
      (instance ?H Human))
   (modalAttribute
      (and
         (during
            (WhenFn ?I)
            (ImmediateFutureFn
               (WhenFn ?I)))
         (attribute ?H MechanicalAnisocoria)) Possibility))

(=>
   (and
      (instance ?S Surgery)
      (patient ?S ?E)
      (instance ?E Eyeball)
      (part ?E ?H)
      (instance ?H Human))
   (modalAttribute
      (holdsDuring
         (ImmediateFutureFn
            (WhenFn ?S))
         (attribute ?H MechanicalAnisocoria)) Possibility))

(instance DiffPupilSizeFn UnaryFunction)
(documentation DiffPupilSizeFn EnglishWrittenLanguage "(&%DiffPupilSizeFn ?PUPILS) denotes the 
difference between pupils of a human in &%Millimeter")
(termFormat EnglishWrittenLanguage DiffPupilSizeFn "diffence in pupil size")
(format EnglishWrittenLanguage DiffPupilSizeFn "The difference in size of %1 is")
(domain DiffPupilSizeFn 1 BothEyePupils)
(range DiffPupilSizeFn LengthMeasure)

(=>
   (and
      (instance ?P BothEyePupils)
      (member ?L ?P)
      (member ?R ?P)
      (instance ?DIAM1 LengthMeasure)
      (equal ?DIAM1 (MeasureFn ?X Millimeter))
      (instance ?DIAM2 LengthMeasure)
      (equal ?DIAM2 (MeasureFn ?Y Millimeter))
      (approximateDiameter ?L ?DIAM1)
      (approximateDiameter ?R ?DIAM2)
      (equal ?Z
         (SubtractionFn ?X ?Y)))
   (equal
      (MeasureFn ?Z Millimeter)
      (DiffPupilSizeFn ?P)))

(=>
   (equal
      (MeasureFn ?Z Millimeter)
      (DiffPupilSizeFn ?P))
   (exists (?L ?R ?X ?Y ?DIAM1 ?DIAM2)
      (and
         (member ?L ?P)
         (member ?R ?P)  
         (instance ?DIAM1 LengthMeasure)
         (equal ?DIAM1 (MeasureFn ?X Millimeter))
         (instance ?DIAM2 LengthMeasure)
         (equal ?DIAM2 (MeasureFn ?Y Millimeter))
         (approximateDiameter ?L
            ?DIAM1)
         (approximateDiameter ?R
            ?DIAM2)
         (equal ?Z
            (SubtractionFn ?X ?Y)))))

(subclass EyeMuscle Muscle)
(documentation EyeMuscle EnglishWrittenLanguage "&%EyeMuscle are split into two main groups. &%ExtraocularMuscles sit outside the &%Eye and control movement. &%IntraocularMuscles sit inside the &%Eye and control the lens shape and pupil size.")
(termFormat EnglishWrittenLanguage EyeMuscle "eye muscle")

(documentation ExtraocularMuscle EnglishWrittenLanguage "A &%ExtraocularMuscle is a type of &%VoluntaryMuscle that is located outside the eyeball and is responsible for controlling the movement and position of the eye within the orbit.")
(subclass ExtraocularMuscle VoluntaryMuscle)
(documentation EyeMuscle EnglishWrittenLanguage "&%ExtraocularMuscles are &%VoluntaryMuscles that sit in the &%EyeSocket and control &%Eye movement.")
(termFormat EnglishWrittenLanguage EyeMuscle "extraocular muscles")

(subclass IntraocularMuscle InvoluntaryMuscle)
(documentation IntraocularMuscle EnglishWrittenLanguage "&%IntraocularMuscles are &%InvoluntaryMuscles that sit inside the &%Eye and control the lens shape and pupil size.")
(termFormat EnglishWrittenLanguage IntraocularMuscle "intraocular muscles")

(partition EyeMuscle ExtraocularMuscle IntraocularMuscle)

(subclass IrisDilatorMuscle IntraocularMuscle)
(documentation IrisDilatorMuscle EnglishWrittenLanguage "&%IrisDilatorMuscle is a smooth 
muscle of the eye, running radially in the iris and therefore fit as a dilator.[Wikipedia]")
(termFormat EnglishWrittenLanguage IrisDilatorMuscle "iris dilator muscle")

(subclass IrisSphincterMuscle IntraocularMuscle)
(documentation IrisSphincterMuscle EnglishWrittenLanguage "&%IrisSphincterMuscle is a 
muscle in the part of the eye called the iris. It encircles the pupil of the iris, 
appropriate to its function as a constrictor of the pupil.[Wikipedia]")
(termFormat EnglishWrittenLanguage IrisSphincterMuscle "iris sphincter muscle")

(instance Contempt EmotionalState)
(documentation Contempt EnglishWrittenLanguage "A negative emotion generally
elicited by the negative evaluation of others and their actions. Usually
elicited by violations of community codes. Closely related to anger and
disgust. [Source: OCEAS]")
(termFormat FrenchWrittenLanguage Contempt "mépris")
(termFormat SpanishWrittenLanguage Contempt "desprecio")
(termFormat EnglishWrittenLanguage Contempt "contempt")
(termFormat GermanWrittenLanguage Contempt "verachtung")
(utterance EnglishWrittenLanguage Contempt "contemptuous")
(relatedInternalConcept Anger Contempt)
(relatedInternalConcept Disgust Contempt)

(termFormat SpanishWrittenLanguage Love "amor")
(documentation Love EnglishWrittenLanguage "A strong emotion associated with
feelings of desire, warmth and intimacy for another person. [Source:
OCEAS]")
(termFormat GermanWrittenLanguage Love "liebe")
(termFormat EnglishWrittenLanguage Love "love")
(utterance EnglishWrittenLanguage Love "loving")
(termFormat FrenchWrittenLanguage Love "amour")
(instance Love EmotionalState)

(termFormat GermanWrittenLanguage Joy "freude")
(subAttribute Joy Happiness)
(termFormat SpanishWrittenLanguage Joy "gozo")
(termFormat EnglishWrittenLanguage Joy "joy")
(documentation Joy EnglishWrittenLanguage "A pleasant, positive emotion which
arises in safe and familiar circumstances, when people have made
progress towards important personal goals, especially when the progress
is better than expected. [Source: OCEAS]")
(utterance EnglishWrittenLanguage Joy "joyful")
(termFormat FrenchWrittenLanguage Joy "joie")

(termFormat EnglishWrittenLanguage Schadenfreude "schadenfreude")
(documentation Schadenfreude EnglishWrittenLanguage "A complex emotion that
consists of the experience of pleasure as caused by the misfortune of
others.")
(contraryAttribute Pleasure Pain)
(subAttribute Schadenfreude Pleasure)

(=>
   (attribute ?A Schadenfreude)
   (exists (?A2 ?P)
      (and
         (causesProposition ?P  
            (attribute ?A Schadenfreude))
         (not
            (equal ?A ?A2))
         (not
            (desires ?A2 ?P)))))

(instance Pleasure EmotionalState)
(termFormat EnglishWrittenLanguage Pleasure "pleasure")
(documentation Pleasure EnglishWrittenLanguage "A positively experienced
emotion which is sought out (approached) and is associated with
happiness, enjoyment, and satisfaction. [Source: OCEAS]")
(termFormat GermanWrittenLanguage Pleasure "vergnügen")
(termFormat FrenchWrittenLanguage Pleasure "plaisir")
(termFormat SpanishWrittenLanguage Pleasure "placer")
(utterance EnglishWrittenLanguage Pleasure "pleased")

(utterance EnglishWrittenLanguage SensoryPleasure "sensory pleasure")
(termFormat EnglishWrittenLanguage SensoryPleasure "sensory pleasure")
(documentation SensoryPleasure EnglishWrittenLanguage "Pleasure in smell,
touch, sight, sound and taste. [Source: OCEAS]")
(subAttribute SensoryPleasure Pleasure)

(=>
   (holdsDuring ?T
      (attribute ?A SensoryPleasure))
   (exists (?P)
      (and
         (instance ?P Perception)
         (during ?T
            (WhenFn ?P))
         (causesProposition
            (experiencer ?P ?A)
            (holdsDuring ?T
               (attribute ?A SensoryPleasure))))))

(subAttribute MasteryPleasure Pleasure)
(documentation MasteryPleasure EnglishWrittenLanguage "Pleasure derived from
mastery, including the experience of flow. [Source: OCEAS]")
(termFormat EnglishWrittenLanguage MasteryPleasure "mastery pleasure")
(utterance EnglishWrittenLanguage MasteryPleasure "a feeling of mastery")

(termFormat FrenchWrittenLanguage Happiness "bonheur")
(termFormat EnglishWrittenLanguage Happiness "happiness")
(utterance EnglishWrittenLanguage Happiness "happy")
(termFormat GermanWrittenLanguage Happiness "glück")
(termFormat SpanishWrittenLanguage Happiness "felicidad")
(instance Happiness EmotionalState)
(documentation Happiness EnglishWrittenLanguage "A positive emotion which is
experienced in reaction to a positive experience or event. [Source: OCEAS]")

(documentation Happiness EnglishWrittenLanguage "The state of being happy, experiencing pleasure,
joy or contentment.  Note that this &%Attribute covers both active enjoyment,
as well as the emotional state of simply being free from anxiety or fear.")

(=>
   (attribute ?PERSON Happiness)
   (not
      (exists (?PROP)
         (fears ?PERSON ?PROP))))

(=>
   (and
      (instance ?SMILE Smiling)
      (agent ?SMILE ?AGENT))
   (holdsDuring
      (WhenFn ?SMILE)
      (attribute ?AGENT Happiness)))

(instance Depression PsychologicalDysfunction)
(documentation Depression EnglishWrittenLanguage "Depression is a state of
low mood and aversion to activity. Classified medically as a mental
and behavioral disorder, the experience of depression affects a
person's thoughts, behavior, motivation, feelings, and sense of
well-being. The core symptom of depression is said to be anhedonia,
which refers to loss of interest or a loss of feeling of pleasure in
certain activities that usually bring joy to people. Depressed mood
is a symptom of some mood disorders such as major depressive disorder
or dysthymia; it is a normal temporary reaction to life events,
such as the loss of a loved one; and it is also a symptom of some
physical diseases and a side effect of some drugs and medical
treatments. It may feature sadness, difficulty in thinking and
concentration and a significant increase or decrease in appetite and
time spent sleeping. People experiencing depression may have feelings
of dejection, hopelessness and suicidal thoughts. It can either be
short term or long term.[from Wikipedia]")
(termFormat EnglishWrittenLanguage Depression "depression")
(termFormat EnglishWrittenLanguage Depression "depressed")

(=>
   (holdsDuring ?T
      (attribute ?H Depression))
   (modalAttribute
      (holdsDuring ?T
         (not
            (attribute ?H Happiness)))
      Likely))

(subclass CausingHappiness Process)
(documentation CausingHappiness EnglishWrittenLanguage "Any &%Process whose result is that the
patient of the process is happy.")

(=>
   (and
      (instance ?C CausingHappiness)
      (patient ?C ?P))
   (and
      (holdsDuring
         (BeginFn
            (WhenFn ?C))
         (not
            (attribute ?P Happiness)))
      (holdsDuring
         (EndFn
            (WhenFn ?C))
         (attribute ?P Happiness))))

(subclass CausingPain CausingUnhappiness)
(documentation CausingPain EnglishWrittenLanguage "Any &%Process whose result is that the
patient of the process is in &%Pain.")

(subclass CausingUnhappiness Process)
(documentation CausingUnhappiness EnglishWrittenLanguage "Any &%Process whose result is that the
patient of the process is unhappy.")

(=>
   (and
      (instance ?C CausingUnhappiness)
      (patient ?C ?P))
   (and
      (holdsDuring
         (BeginFn
            (WhenFn ?C))
         (not
            (attribute ?P Unhappiness)))
      (holdsDuring
         (EndFn
            (WhenFn ?C))
         (attribute ?P Unhappiness))))

(subAttribute Satisfaction Happiness)
(documentation Satisfaction EnglishWrittenLanguage "The state of being happy about a state of
affairs that occurred in the past.  In cases where that state of affairs
is the product of one's own doing, this is known as pride.")

(subAttribute Tranquility Happiness)
(contraryAttribute Tranquility Anxiety)
(documentation Tranquility EnglishWrittenLanguage "The state of being free from &%Anxiety.")

(instance Unhappiness EmotionalState)
(contraryAttribute Unhappiness Happiness)
(documentation Unhappiness EnglishWrittenLanguage "The state of being unhappy, experiencing pain,
sorrow or unease.")

(subAttribute Excitement Happiness)
(documentation Excitement EnglishWrittenLanguage "The state of being happy about a state of
affairs that might occur in the future.")

(documentation Anxiety EnglishWrittenLanguage "A negative, aversive emotion
provoked by the prospect of future threat. Distinguished from fear since
it is triggered by a distal threat whereas fear is triggered by an
immediate threat. Often gradual and long_lasting, whereas fear usually
has sudden onset and offset. [Source: OCEAS]")
(instance Anxiety EmotionalState)
(relatedInternalConcept Anxiety Worry)

;(=>
;   (holdsDuring ?T
;     (attribute ?PERSON Anxiety))
;   (believes ?PERSON
;     (holdsDuring
;       (ImmediateFutureFn ?T)
;       (exists (?PROP)
;         (fears ?PERSON ?PROP)))))

(=>
   (attribute ?A Anxiety)
   (attribute ?A Unhappiness))

(instance Anger EmotionalState)
(documentation Anger EnglishWrittenLanguage "Anger is a negative emotion,
characterised by feelings of unpleasantness and high arousal, in the
form of antagonistic feelings and action tendencies. [Source: OCEAS]")
(termFormat GermanWrittenLanguage Anger "wut")
(termFormat SpanishWrittenLanguage Anger "ira")
(utterance EnglishWrittenLanguage Anger "angry")
(termFormat EnglishWrittenLanguage Anger "anger")
(termFormat FrenchWrittenLanguage Anger "colère")

(=>
   (attribute ?PERSON Anger)    
   (exists (?PROP)
      (disapproves ?PERSON ?PROP)))

(=>
   (attribute ?A Anger)
   (attribute ?A Unhappiness))

(utterance EnglishWrittenLanguage Shame "ashamed")
(termFormat SpanishWrittenLanguage Shame "vengüenza")
(termFormat EnglishWrittenLanguage Shame "shame")
(instance Shame EmotionalState)
(termFormat FrenchWrittenLanguage Shame "honte")
(termFormat GermanWrittenLanguage Shame "scham")
(documentation Shame EnglishWrittenLanguage "&%Shame is an unpleasant self-conscious emotion 
often associated with negative self-evaluation. The focus of shame is on the self or 
the individual with respect to a perceived audience. According to cultural anthropologist 
Ruth Benedict, shame arises from a violation of cultural or social values while guilt 
feelings arise from violations of one's internal values. Psychoanalyst Helen B. Lewis 
argued that the experience of shame is directly about the self, which is the focus of evaluation. 
In guilt, the self is not the central object of negative evaluation, but rather the thing 
done is the focus. [Wikipedia]")

(=>
   (and
      (member ?A ?G)
      (instance ?G Public)
      (holdsDuring ?T
         (attribute ?A Shame)))
   (believes ?A
      (or
         (not
            (knows ?G
               (exists (?P)
                  (and
                     (instance ?P Process)
                     (agent ?P ?A)
                     (meetsTemporally
                        (WhenFn ?P)
                        ?T)))))
         (dislikes ?G ?A))))

(utterance EnglishWrittenLanguage Disgust "disgusted")
(termFormat FrenchWrittenLanguage Disgust "dégoût")
(instance Disgust EmotionalState)
(termFormat SpanishWrittenLanguage Disgust "asco")
(termFormat EnglishWrittenLanguage Disgust "disgust")
(documentation Disgust EnglishWrittenLanguage "A negative emotion which guards
the body against dangerous foods and microbial infections. The basic
physiological disgust has also culturally evolved to incorporate moral
disgust which protects the self from nonphysical threats such as moral
violations. [Source: OCEAS]")
(termFormat GermanWrittenLanguage Disgust "ekel")

(subAttribute CoreDisgust Disgust)
(termFormat EnglishWrittenLanguage CoreDisgust "core disgust")
(documentation CoreDisgust EnglishWrittenLanguage "Disgust elicited by
&quot;contaminated&quot; food substances: rotten food, culturally
variable &quot;bad&quot; food, certain animals associated with rotten
food (maggots, rats), and every body product except tears. [Source: OCEAS]")

(documentation InterpersonalDisgust EnglishWrittenLanguage "Disgust elicited by
contact with others, especially contact with strangers or other
individuals or groups we are averse to. [Source: OCEAS]")
(subAttribute InterpersonalDisgust Disgust)
(termFormat EnglishWrittenLanguage InterpersonalDisgust "interpersonal disgust")

(=>
   (holdsDuring ?T
      (attribute ?A InterpersonalDisgust))
   (exists (?P ?H)
      (and
         (instance ?P Perception)
         (patient ?P ?H)
         (experiencer ?P ?A)
         (instance ?H Human)
         (not
            (equal ?H ?A))
         (during
            (WhenFn ?P) ?T))))

(=>
   (holdsDuring ?T
      (attribute ?A InterpersonalDisgust))
   (causesProposition
      (exists (?P ?H)
         (and
            (instance ?P Perception)
            (patient ?P ?H)
            (experiencer ?P ?A)
            (instance ?H Human)
            (during
               (WhenFn ?P) ?T)))
      (holdsDuring ?T
         (attribute ?A InterpersonalDisgust))))

(termFormat EnglishWrittenLanguage AnimalNatureDisgust "animal_nature disgust")
(subAttribute AnimalNatureDisgust Disgust)
(documentation AnimalNatureDisgust EnglishWrittenLanguage "Disgust elicited by
poor hygeine, inappropriate sex, gore or violations of bodily
boundaries, and death or the odor of decay. [Source: OCEAS]")

(termFormat EnglishWrittenLanguage MoralDisgust "moral disgust")
(documentation MoralDisgust EnglishWrittenLanguage "Disgust elicited by some
kinds of especially egregious moral violations. [Source: OCEAS]")
(subAttribute MoralDisgust Disgust)

