(subclass DisgustedVoiceUtterance EmotionalVoiceUtterances)
(documentation DisgustedVoiceUtterance EnglishWrittenLanguage "Voice utterances
characteristically associated with the experience of disgust.")
(relatedInternalConcept DisgustedVoiceUtterance Disgust)
(termFormat EnglishWrittenLanguage DisgustedVoiceUtterance "disgusted voice
utterance")

(=>
   (and
      (instance ?DVU DisgustedVoiceUtterance)
      (agent ?DVU ?A))
   (holdsDuring
      (WhenFn ?DVU)
      (attribute ?A Disgust)))

(documentation SpeakingAtAFasterRate EnglishWrittenLanguage "Speaking in a
manner that is faster than the norm for that person.")
(subclass SpeakingAtAFasterRate EmotionalSpeakingBehavior)
(termFormat EnglishWrittenLanguage SpeakingAtAFasterRate "speaking at a faster
rate")

(=>
   (and
      (instance ?SF SpeakingAtAFasterRate)
      (instance ?SS SpeakingAtASlowerRate)
      (instance ?U UnitOfDuration)
      (agent ?SF ?A)
      (agent ?SS ?A)
      (containsInformation ?SF ?I)
      (containsInformation ?SS ?I)
      (instance ?TIMED1 TimeDuration)
      (equal ?TIMED1 (MeasureFn ?FAST ?U))
      (instance ?TIMED2 TimeDuration)
      (equal ?TIMED2 (MeasureFn ?SLOW ?U))
      (duration
         (WhenFn ?SF) 
         ?TIMED1)
      (duration
         (WhenFn ?SS) 
         ?TIMED2))
   (greaterThan ?FAST ?SLOW))

(termFormat EnglishWrittenLanguage SpeakingAssertively "speaking assertively")
(subclass SpeakingAssertively EmotionalSpeakingBehavior)
(documentation SpeakingAssertively EnglishWrittenLanguage "Speaking with a
voice that is confident and assertive.")

(documentation SpeakingWithAlteredSpeechMelody EnglishWrittenLanguage "Speaking
