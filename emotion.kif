;; -------------- Facial Expressions --------------

(subclass Winking ClosingEye)
(subclass Winking IntentionalProcess)
(documentation Winking EnglishWrittenLanguage "&%Closing only one eye for a brief moment to convey a 
message or as a form of flirtation or acknowledgement.")
(=>
   (and
      (instance ?B Winking)
      (patient ?B ?E)
      (or
         (instance ?E
            (BodySideFn Left Eye))
         (instance ?E
            (BodySideFn Right Eye))))      
   (exists (?T)
      (and
         (holdsDuring ?T
            (attribute ?E Closed))
         (during
            (WhenFn ?B) ?T)
         (holdsDuring
            (ImmediatePastFn
               (WhenFn ?B))
            (attribute ?E Open))
         (holdsDuring
            (ImmediateFutureFn
               (WhenFn ?B))
            (attribute ?E Open)))))

(termFormat EnglishWrittenLanguage PressingLipsTogether "pressing lips together")
