   (and
      (instance ?PLT PressingLipsTogether)
      (agent ?PLT ?A))
   (exists (?L ?BM)
      (and
         (instance ?L Lip)
         (part ?L ?A)
         (instance ?BM BodyMotion)
         (patient ?BM ?L)
         (agent ?BM ?A))))

(subclass Frowning FacialExpression)
(documentation Frowning EnglishWrittenLanguage "Furrowing the forehead in such a way as to convey
unhappiness.")

(=>
   (and
      (instance ?FROWN Frowning)
      (agent ?FROWN ?AGENT))
   (holdsDuring
      (WhenFn ?FROWN)
      (attribute ?AGENT Unhappiness)))

(subclass Weeping FacialExpression)
(documentation Weeping EnglishWrittenLanguage "&%Expressing unhappiness by shedding tears.")

(=>
   (and
      (instance ?WEEP Weeping)
      (agent ?WEEP ?AGENT))
   (holdsDuring
      (WhenFn ?WEEP)
      (attribute ?AGENT Unhappiness)))


(subclass HappyFacialExpression EmotionalFacialExpression)
(relatedInternalConcept HappyFacialExpression Happiness)
(documentation HappyFacialExpression EnglishWrittenLanguage "The canonical
facial expression associated with the experience of happiness.")
(relatedInternalConcept HappyFacialExpression Smiling)
(termFormat EnglishWrittenLanguage HappyFacialExpression "happy facial expression")

(=>
   (holdsDuring ?T
      (attribute ?A Happiness))
   (modalAttribute
      (exists (?HF)
         (and
            (instance ?HF HappyFacialExpression)
            (experiencer ?HF ?A)
            (during
               (WhenFn ?HF) ?T)))
      Likely))

(relatedInternalConcept AngryFacialExpression Anger)
(termFormat EnglishWrittenLanguage AngryFacialExpression "angry facial expression")
(subclass AngryFacialExpression EmotionalFacialExpression)
(documentation AngryFacialExpression EnglishWrittenLanguage "The facial
expression associated with the experience of anger.")
(relatedInternalConcept AngryFacialExpression Frowning)

(=>
   (holdsDuring ?T
      (attribute ?A Anger))
   (modalAttribute
      (exists (?HF)
         (and
            (instance ?HF AngryFacialExpression)
            (experiencer ?HF ?A)
            (during
               (WhenFn ?HF) ?T)))
      Likely))

(relatedInternalConcept DisgustedFacialExpression Disgust)
(documentation DisgustedFacialExpression EnglishWrittenLanguage "The facial
expression associated with the experience of disgust.")
(termFormat EnglishWrittenLanguage DisgustedFacialExpression "disgusted facial
expression")
(subclass DisgustedFacialExpression EmotionalFacialExpression)

(=>
   (holdsDuring ?T
      (attribute ?A Disgust))
   (modalAttribute
      (exists (?FE)
         (and
            (instance ?FE DisgustedFacialExpression)
            (experiencer ?FE ?A)
            (during
               (WhenFn ?FE) ?T)))
      Likely))

(relatedInternalConcept SurprisedFacialExpression OpeningEyesWidely)
(relatedInternalConcept SurprisedFacialExpression Surprise)
(relatedInternalConcept SurprisedFacialExpression JawDropping)
(termFormat EnglishWrittenLanguage SurprisedFacialExpression "surprised facial
expression")
(documentation SurprisedFacialExpression EnglishWrittenLanguage "A &%SurprisedFacialExpression is a kind of &%EmotionalBehavioralProcess that manifests as a specific &%FacialExpression, and more broadly as a &%PsychologicalProcess, characterized by the outward physical configuration of the face that occurs when an individual experiences the emotion of surprise.")
(subclass SurprisedFacialExpression FacialExpression)
(subclass SurprisedFacialExpression EmotionalBehavioralProcess)

(=>
   (holdsDuring ?T
      (attribute ?A Surprise))
   (modalAttribute
      (exists (?FE)
         (and
            (instance ?FE SurprisedFacialExpression)
            (experiencer ?FE ?A)
            (during
               (WhenFn ?FE) ?T)))
      Likely))

(termFormat EnglishWrittenLanguage JawDropping "jaw dropping")
(documentation JawDropping EnglishWrittenLanguage "A facial expression behavior
in which the jaw drops.")
(subclass JawDropping FacialExpression)
(subclass JawDropping Opening)

(=>
   (and
      (instance ?J JawDropping)
      (agent ?J ?A)
      (instance ?M Mouth)
      (part ?M ?A))
   (exists (?O)
      (and
         (instance ?O Opening)
         (subProcess ?O ?J)
         (patient ?O ?M)
         (holdsDuring
            (BeginFn
               (WhenFn ?O))
            (attribute ?M Closed))
         (holdsDuring
            (EndFn
               (WhenFn ?O))
            (attribute ?M Open)))))

(documentation NeutralExpression EnglishWrittenLanguage "A facial expression
behavior which appears very neutral (showing no expression).")
(subclass NeutralExpression FacialExpression)
(termFormat EnglishWrittenLanguage NeutralExpression "neutral expression")

(relatedInternalConcept EmotionalFacialExpression EmotionalState)
(documentation EmotionalFacialExpression EnglishWrittenLanguage "Characteristic
facial expression made when a person is undergoing an experience of
surprise.")
(subclass EmotionalFacialExpression FacialExpression)
(documentation EmotionalFacialExpression EnglishWrittenLanguage "Characteristic
facial expressions that are made when a person is undergoing a so_called
&quot;basic&quot; emotions. These are canonical, that is, individual
facial expressions when undergoing emotions can vary or not change at
all. However, research indicates evidence for the existence of
characteristic canonical facial expressions that are displayed when
experiencing certain emotions even across cultures.")
(termFormat EnglishWrittenLanguage EmotionalFacialExpression "emotional facial
expression")

(subclass SadFacialExpression EmotionalFacialExpression)
(termFormat EnglishWrittenLanguage SadFacialExpression "sad facial expression")
(relatedInternalConcept SadFacialExpression Sadness)
(documentation SadFacialExpression EnglishWrittenLanguage "The canonical facial
expression associated with the experience of sadness.")

(=>
   (holdsDuring ?T
      (attribute ?A Sadness))
   (modalAttribute
      (exists (?FE)
         (and
            (instance ?FE SadFacialExpression)
            (experiencer ?FE ?A)
            (during
               (WhenFn ?FE) ?T)))
      Likely))

(termFormat EnglishWrittenLanguage FearfulFacialExpression "fearful facial
expression")
(relatedInternalConcept FearfulFacialExpression OpeningEyesWidely)
(relatedInternalConcept FearfulFacialExpression Fear)
(documentation FearfulFacialExpression EnglishWrittenLanguage "The canonical
facial expression associated with the experience of fear.")
(subclass FearfulFacialExpression EmotionalFacialExpression)

(=>
   (holdsDuring ?T
      (attribute ?A Fear))
   (modalAttribute
      (exists (?FE)
         (and
            (instance ?FE FearfulFacialExpression)
            (experiencer ?FE ?A)
            (during
               (WhenFn ?FE) ?T)))
      Likely))

;; -------------- Body Responses --------------

(documentation PhysiologicalResponseToEmotionalState EnglishWrittenLanguage "A
physiological response to emotion process is a bodily process which
encompasses all the neurophysiological changes caused by the appraisal,
which take place in the central nervous system (CNS), neuro_endocrine
system (NES) and autonomous nervous system (ANS).")
(subclass PhysiologicalResponseToEmotionalState PhysiologicProcess)
(subclass PhysiologicalResponseToEmotionalState EmotionalBehavioralProcess)
(termFormat EnglishWrittenLanguage PhysiologicalResponseToEmotionalState
   "physiological response to emotion process")

(=>
   (instance ?PR PhysiologicalResponseToEmotionalState)
   (exists (?EP ?A)
      (and
         (instance ?EP EmotionalState)
         (experiencer ?EP ?A)
         (experiencer ?PR ?A)
         (causes ?EP ?PR))))

(subclass MovingAwayFromPeople EmotionalBodilyMovementBehavior)
(termFormat EnglishWrittenLanguage MovingAwayFromPeople "moving away from people")
(documentation MovingAwayFromPeople EnglishWrittenLanguage "A bodily movement
behavior which involves moving, or leaning, away from people (avoidance).")

(=>
   (and
      (instance ?MTP MovingAwayFromPeople)
      (origin ?MTP ?O)
      (destination ?MTP ?D))
   (not
      (equal ?O ?D)))

(=>
   (and
      (instance ?MTP MovingAwayFromPeople)
      (agent ?MTP ?A))
   (exists (?P ?U ?D1 ?D2 ?DIST1 ?DIST2)
      (and
         (instance ?P Human)
         (instance ?U UnitOfLength)
         (instance ?DIST1 LengthMeasure)
         (equal ?DIST1 (MeasureFn ?D1 ?U))
         (instance ?DIST2 LengthMeasure)
         (equal ?DIST2 (MeasureFn ?D2 ?U))
         (holdsDuring
            (ImmediatePastFn
               (WhenFn ?MTP))
            (distance ?MTP ?A 
               ?DIST1))
         (holdsDuring
            (ImmediateFutureFn
               (WhenFn ?MTP))
            (distance ?MTP ?A 
               ?DIST2))
         (greaterThan ?D2 ?D1))))

(termFormat EnglishWrittenLanguage MovingTowardsPeople "moving towards people")
(documentation MovingTowardsPeople EnglishWrittenLanguage "A bodily movement
behavior which involves moving, or leaning, towards people (approach).")
(subclass MovingTowardsPeople EmotionalBodilyMovementBehavior)
(subclass MovingTowardsPeople Translocation)

(=>
   (and
      (instance ?MTP MovingTowardsPeople)
      (origin ?MTP ?O)
      (destination ?MTP ?D))
   (not
      (equal ?O ?D)))

(=>
   (and
      (instance ?MTP MovingTowardsPeople)
      (agent ?MTP ?A))
   (exists (?P ?U ?D1 ?D2 ?LENGTH ?LENGTH2)
      (and
         (instance ?P Human)
         (instance ?U UnitOfLength)
         (instance ?LENGTH LengthMeasure)
         (equal ?LENGTH (MeasureFn ?D1 ?U))
         (instance ?LENGTH2 LengthMeasure)
         (equal ?LENGTH2 (MeasureFn ?D2 ?U))
         (holdsDuring
            (ImmediatePastFn
               (WhenFn ?MTP))
            (distance ?MTP ?A ?LENGTH))
         (holdsDuring
            (ImmediateFutureFn
               (WhenFn ?MTP))
            (distance ?MTP ?A ?LENGTH2))
         (greaterThan ?D1 ?D2))))
