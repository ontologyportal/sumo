   (holdsDuring ?T
      (attribute ?A Terror))
   (fears ?A
      (exists (?F)
         (and
            (instance ?F Frightening)
            (experiencer ?F ?A)
            (earlier ?T
               (WhenFn ?F))))))

(utterance EnglishWrittenLanguage Boredom "bored")
(instance Boredom EmotionalState)
(termFormat EnglishWrittenLanguage Boredom "boredom")
(names "ennui" Boredom)
(names "tedium" Boredom)
(documentation Boredom EnglishWrittenLanguage "&%Boredom is an emotion characterized by 
uninterest in one's surrounding, often caused by a lack of distractions or occupations.
It seems to be a specific mental state that people find unpleasant. [Wikipedia] Here, it 
is defined as lack of interest in doing an intentional process in the near future. And
People don't desire to be bored.")

(=>
   (holdsDuring ?T
      (attribute ?A Boredom))
   (not
      (exists (?P ?H)
         (and
            (instance ?P IntentionalProcess)
            (agent ?P ?A)
            (enjoys ?H ?P)
            (during
               (ImmediateFutureFn ?P) ?T)))))

(=>
   (instance ?H Human)        
   (not
      (desires ?H
         (attribute ?H Boredom))))

(=>
   (holdsDuring ?T
      (attribute ?A Boredom))
   (not
      (desires ?A
         (exists (?P)
            (and
               (instance ?P IntentionalProcess)
               (agent ?P ?A)
               (during
                  (ImmediateFutureFn ?P) ?T))))))

