(subAttribute Horror Fear)
(subAttribute Horror Disgust)

(=>
   (holdsDuring ?T
      (attribute ?A Horror))
   (exists (?X ?F)
      (and
         (dislikes ?A ?X)
         (instance ?F Frightening)
