(instance Worry EmotionalState)
(documentation Worry EnglishWrittenLanguage "As an emotion, &%Worry is experienced 
from &%Anxiety or &%Concern about a real or imagined issue, often personal 
issues such as health or finances, or external broader issues such as 
environmental pollution, social structure or technological change.[Wikipedia]")
(termFormat EnglishWrittenLanguage Worry "worry")
(utterance EnglishWrittenLanguage Worry "worried")
(relatedInternalConcept Worry Concern)

(=>
   (holdsDuring ?T
      (attribute ?A Worry))
   (exists (?W)
      (and
         (instance ?W Worrying)
         (agent ?W ?A)
         (during
            (WhenFn ?W) ?T))))

(subclass Worrying PsychologicalProcess)
(subclass Worrying ContentBearingProcess)
(documentation Worrying EnglishWrittenLanguage "&%Worrying is a category of perseverative 
cognition, i.e.,a continuous thinking about negative events in the past or in the future.
[Wikipedia] It is a specific though about a potential problem or future event.")
(termFormat EnglishWrittenLanguage Worrying "worrying")

(=>
   (and
      (instance ?W Worrying)
      (experiencer ?W ?A)
      (instance ?A Human)
      (containsFormula ?W ?F))
   (fears ?A ?F))

(=>
   (and
      (instance ?W Worrying)
      (experiencer ?W ?A)
      (instance ?A Human))
   (fears ?A
      (holdsDuring
         (ImmediateFutureFn
            (WhenFn ?W))
         (exists (?F)
            (and
               (instance ?F Formula)
               (containsFormula ?W ?F)
               (truth ?F True))))))

(instance Concern EmotionalState)
(documentation Concern EnglishWrittenLanguage "&%Concern is the recognition of a future outcome 
that could be troubling, without necessarily having fear in the outcome.[Wikipedia]")
(termFormat EnglishWrittenLanguage Concern "concern")
(utterance EnglishWrittenLanguage Concern "concerned")

(=>
   (holdsDuring ?T
      (attribute ?A Concern))
   (holdsDuring
      (ImmediateFutureFn ?T)
      (exists (?X)
         (and
            (not
               (desires ?A ?X))
            (not
               (fears ?A ?X))))))

(termFormat EnglishWrittenLanguage Compassion "compassion")
(termFormat SpanishWrittenLanguage Compassion "compasión")
(documentation Compassion EnglishWrittenLanguage "Compassion involves feeling for another 
and is a precursor to empathy, the feeling as another capacity (as opposed to 
sympathy, the feeling towards another). In common parlance, active compassion 
is the desire to alleviate another's suffering.[Wikipedia]")
(termFormat GermanWrittenLanguage Compassion "mitgefühl")
(instance Compassion EmotionalState)
(utterance EnglishWrittenLanguage Compassion "compassionate")

(=>
   (and
      (attribute ?A Compassion)
      (instance ?A CognitiveAgent))
   (not
      (desires ?A
         (exists (?D ?O)
            (and
               (instance ?D Damaging)
               (patient ?D ?O)
               (instance ?O Object))))))

(documentation Fear EnglishWrittenLanguage "An activated, aversive emotion that
motivates attempts to cope with events that provide threats to the
survival or well_being of organisms. Characterised by feelings of threat
and impending doom, and by an urge to get out of the situation. [Source:
OCEAS]Anxiety is different from fear in that fear is defined as the emotional 
response to a present threat, whereas anxiety is the anticipation of a future 
one.[Wikipedia]")
(instance Fear EmotionalState)
(termFormat SpanishWrittenLanguage Fear "miedo")
(termFormat FrenchWrittenLanguage Fear "peur")
(termFormat EnglishWrittenLanguage Fear "fear")
(utterance EnglishWrittenLanguage Fear "afraid")
(termFormat EnglishWrittenLanguage Fear "angst")

(=>
   (attribute ?PERSON Fear)
   (exists (?PROP)
      (fears ?PERSON ?PROP)))

(relatedInternalConcept Anxiety Fear)

(subclass Imagining PsychologicalProcess)
(documentation Imagining EnglishWrittenLanguage "Forming a mental picture of something which
is not present.")

(subclass Dreaming Imagining)
(disjoint Dreaming IntentionalProcess)
(documentation Dreaming EnglishWrittenLanguage "A &%Process of producing metal images which occurs
while one is &%Asleep.")

(=>
   (and
      (instance ?DREAM Dreaming)
      (experiencer ?DREAM ?AGENT))
   (holdsDuring
      (WhenFn ?DREAM)
      (attribute ?AGENT Asleep)))

(subclass Frightening PsychologicalProcess)
(documentation Frightening EnglishWrittenLanguage "Any &%PsychologicalProcess where the &%patient
comes to feel &%Fear.")

(=>
   (and
      (instance ?FRIGHTEN Frightening)
      (experiencer ?FRIGHTEN ?AGENT))
   (and
      (holdsDuring
         (BeginFn
            (WhenFn ?FRIGHTEN))
         (not (attribute ?AGENT Fear)))
      (holdsDuring
         (EndFn
            (WhenFn ?FRIGHTEN))
         (attribute ?AGENT Fear))))

(=>
   (holdsDuring ?T
      (attribute ?A Fear))
   (exists (?F)
      (and
         (instance ?F Frightening)
         (experiencer ?F ?A)
         (during
            (WhenFn ?F) ?T))))

(=>
   (and
      (instance ?F Frightening)
      (experiencer ?F ?A))
   (exists (?P)
      (and 
         (fears ?A
            (instance ?P Physical))
         (or
            (origin ?F ?P)
            (causes ?P ?F)))))

