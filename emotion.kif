;


;; changed from (subclass Perspiring PhysiologicalResponseToEmotionalState)
;; not all perspiring is emotional
(subclass Perspiring PhysiologicalResponseToEmotionalState)
(termFormat EnglishWrittenLanguage Perspiring "perspiring")
(termFormat EnglishWrittenLanguage Perspiring "sweating")
(subclass Perspiring LiquidMotion)

(=>
   (instance ?P Perspiring)
   (exists (?S)
      (and
         (instance ?S Sweat)
         (result ?P ?S))))

(termFormat EnglishWrittenLanguage PerspiringHands "perspiring (hands)")
(documentation PerspiringHands EnglishWrittenLanguage "The state of &%PerspiringHands is a specific kind of &%Perspiring in which the &%Excreting of liquid through the skin, categorized as &%LiquidMotion, occurs specifically from the hands.")
(subclass PerspiringHands Perspiring)

(=>
   (and
      (instance ?P Perspiring)
      (experiencer ?P ?A))
   (exists (?H)
      (and
         (instance ?H Hand)
         (part ?H ?A)
         (destination ?P ?H))))

(termFormat EnglishWrittenLanguage PerspiringWholeBody "perspiring (whole body)")
(documentation PerspiringWholeBody EnglishWrittenLanguage "The process of &%PerspiringWholeBody is a specific kind of &%Perspiring in which the &%Excreting of moisture via &%LiquidMotion occurs across the entirety of an organism's body surface rather than in isolated areas.")
(subclass PerspiringWholeBody Perspiring)

(=>
   (and
      (instance ?P PerspiringWholeBody)
      (experiencer ?P ?A))
   (not 
      (exists (?B)
         (and
            (instance ?B BodyPart)
            (part ?B ?A)
            (not
               (destination ?P ?B))))))

(termFormat EnglishWrittenLanguage BreathingAtASlowerRate "breathing at a
slower rate")
(documentation BreathingAtASlowerRate EnglishWrittenLanguage "&%BreathingAtASlowerRate is a kind of &%PhysiologicalResponseToEmotionalState characterized by a reduction in the frequency of respiratory cycles as a bodily reaction to a specific emotional state.")
(subclass BreathingAtASlowerRate PhysiologicalResponseToEmotionalState)

(documentation HeartBeatingAtSlowerRate EnglishWrittenLanguage "The &%HeartBeatingAtSlowerRate is a kind of &%PhysiologicalResponseToEmotionalState characterized by a reduction in the frequency of cardiac contractions, occurring as a biological reaction to a specific emotional state.")
(subclass HeartBeatingAtSlowerRate PhysiologicalResponseToEmotionalState)
(termFormat EnglishWrittenLanguage HeartBeatingAtSlowerRate "heart beating at
slower rate")

(documentation TemperatureFallingExperiencedAsFeelingCold EnglishWrittenLanguage 
   "&%TemperatureFallingExperiencedAsFeelingCold means feeling cold. It is a 
&%PhysiologicProcess in respose to to an &%EmotionalState.")
(subclass TemperatureFallingExperiencedAsFeelingCold
   PhysiologicalResponseToEmotionalState)
(termFormat EnglishWrittenLanguage TemperatureFallingExperiencedAsFeelingCold
   "temperature falling (experienced as feeling cold)")

(=>
   (and
      (instance ?T TemperatureFallingExperiencedAsFeelingCold)
      (located ?T ?L)
      (experiencer ?T ?A))
   (holdsDuring
      (WhenFn ?T)
      (believes ?A
         (attribute ?L ColdTemperature))))

(documentation TemperatureRisingExperiencedAsFeelingWarm EnglishWrittenLanguage 
   "&%TemperatureRisingExperiencedAsFeelingWarm means feeling warm. It is a 
&%PhysiologicProcess in respose to to an &%EmotionalState.")
(termFormat EnglishWrittenLanguage TemperatureRisingExperiencedAsFeelingWarm
   "temperature rising (experienced as feeling warm)")
(subclass TemperatureRisingExperiencedAsFeelingWarm
   PhysiologicalResponseToEmotionalState)
(disjoint TemperatureRisingExperiencedAsFeelingWarm TemperatureFallingExperiencedAsFeelingCold) 

(=>
   (and
      (instance ?T TemperatureRisingExperiencedAsFeelingWarm)
      (located ?T ?L)
      (experiencer ?T ?A))
   (holdsDuring
      (WhenFn ?T)
      (believes ?A
         (attribute ?L WarmTemperature))))

(termFormat EnglishWrittenLanguage ExperiencingDiscomfortInTheStomach
   "experiencing discomfort in the stomach")
(documentation ExperiencingDiscomfortInTheStomach EnglishWrittenLanguage "&%ExperiencingDiscomfortInTheStomach is a kind of &%PhysiologicalResponseToEmotionalState characterized by the sensation of physical unease, pain, or distress located within the stomach region, occurring as a bodily reaction to a specific emotional state.")
(subclass ExperiencingDiscomfortInTheStomach
   PhysiologicalResponseToEmotionalState)

(=>
   (and
      (instance ?ELT ExperiencingDiscomfortInTheStomach)
      (experiencer ?ELT ?A))
   (exists (?P ?PAIN ?T)
      (and
         (instance ?P Perception)
         (during
            (WhenFn ?P)
            (WhenFn ?PAIN))
         (instance ?PAIN Pain)
         (experiencer ?PAIN ?A)
         (subProcess ?P ?ELT)
         (agent ?P ?A)
         (patient ?P ?T)
         (instance ?T Stomach)
         (part ?T ?A))))

(subclass Weeping EmotionalBehavioralProcess)
(subclass Weeping LiquidMotion)

(=>
   (and
      (instance ?W Weeping)
      (experiencer ?W ?A))
   (modalAttribute
      (holdsDuring
         (WhenFn ?W)
         (attribute ?A Sadness))
      Likely))

; (subclass Smiling FacialExpression) ; in MILO

(=>
   (and
      (instance ?S Smiling)
      (experiencer ?S ?A))
   (modalAttribute
      (holdsDuring
         (WhenFn ?S)
         (attribute ?A Happiness))
      Likely))

(=>
   (and
      (instance ?S Laughing)
      (experiencer ?S ?A))
   (modalAttribute
      (holdsDuring
         (WhenFn ?S)
         (attribute ?A Happiness))
      Likely))

(subclass RaisingEyebrows FacialExpression)
(termFormat EnglishWrittenLanguage RaisingEyebrows "raising eyebrows")
(documentation RaisingEyebrows EnglishWrittenLanguage "A facial expression
behavior in which the eyebrows are raised.")

(termFormat EnglishWrittenLanguage PhysicalViolence "violence")
(documentation PhysicalViolence EnglishWrittenLanguage "Violence is aggression
that has extreme physical harm as its goal. [Source: OCEAS]")
(subclass PhysicalViolence ViolentContest)

(=>
   (and
      (instance ?PV PhysicalViolence)
      (agent ?PV ?A))
   (modalAttribute
      (holdsDuring
         (WhenFn ?PV)
         (attribute ?A Anger))
      Likely))

(documentation Shivering EnglishWrittenLanguage "&%Shivering is a kind of &%Trembling that consists of involuntary, rhythmic muscle contractions, often occurring as a &%PhysiologicalResponseToEmotionalState or in response to cold, functioning as an &%AutonomicProcess.")
(subclass Shivering PhysiologicalResponseToEmotionalState)
(subclass Shivering Trembling)
(termFormat EnglishWrittenLanguage Shivering "shivering")

(termFormat EnglishWrittenLanguage LimbWeakening "limb weakening")
(documentation LimbWeakening EnglishWrittenLanguage "A &%LimbWeakening is a kind of &%PhysiologicalResponseToEmotionalState characterized by a perceived or actual loss of muscular strength or stability in the limbs resulting from a specific emotional state.")
(subclass LimbWeakening PhysiologicalResponseToEmotionalState)

(documentation OpeningEyesWidely EnglishWrittenLanguage "A facial expression
behavior in which the eyes are opened widely.")
(subclass OpeningEyesWidely FacialExpression)
(termFormat EnglishWrittenLanguage OpeningEyesWidely "opening eyes widely")

(=>
   (and
      (instance ?OEW OpeningEyesWidely)
      (agent ?OEW ?A))
   (exists (?EL)
      (and
         (instance ?EL Eyelid)
         (part ?EL ?A)
         (patient ?OEW ?EL))))

(documentation HeartBeatingAtFasterRate EnglishWrittenLanguage "The &%HeartBeatingAtFasterRate is a kind of &%PhysiologicalResponseToEmotionalState characterized by an increase in the frequency of the cardiac cycle in response to a specific emotional state.")
(subclass HeartBeatingAtFasterRate PhysiologicalResponseToEmotionalState)
(termFormat EnglishWrittenLanguage HeartBeatingAtFasterRate "heart beating at
faster rate")

(=>
   (instance ?HB HeartBeatingAtFasterRate)
   (exists (?H)
      (and
         (instance ?H Heart)
         (patient ?HB ?H))))

(termFormat EnglishWrittenLanguage MovingAbruptly "moving abruptly")
(subclass MovingAbruptly EmotionalBodilyMovementBehavior)
(documentation MovingAbruptly EnglishWrittenLanguage "A bodily movement
behavior which involves abrupt movements.")

(termFormat EnglishWrittenLanguage Blushing "blushing")
(subclass Blushing PhysiologicalResponseToEmotionalState)
(subclass Blushing AutonomicProcess)
(documentation Blushing EnglishWrittenLanguage "The process of turning red in response to a
stimulus which has a deep emotional effect.")

(=>
   (and
      (instance ?B Blushing)
      (experiencer ?B ?A))
   (exists (?T1 ?T2 ?S1 ?S2)
      (and
         (instance ?S1 EmotionalState)
         (instance ?S2 EmotionalState)
         (not
            (equal ?S1 ?S2))
         (holdsDuring ?T1
            (attribute ?A ?S1))
         (holdsDuring ?T2
            (attribute ?A ?S2))
         (starts
            (WhenFn ?B) ?T2)
         (finishes
            (WhenFn ?B) ?T1))))

(termFormat EnglishWrittenLanguage BreathingAtAMoreRapidRate "breathing at a
more rapid rate")
(documentation BreathingAtAMoreRapidRate EnglishWrittenLanguage "The &%BreathingAtAMoreRapidRate is a kind of &%Breathing that occurs at a frequency higher than the normal resting rate, often occurring as a &%PhysiologicalResponseToEmotionalState within an &%OrganismProcess.")
(subclass BreathingAtAMoreRapidRate PhysiologicalResponseToEmotionalState)
(subclass BreathingAtAMoreRapidRate Breathing)

(termFormat EnglishWrittenLanguage BecomingPale "becoming pale")
(documentation BecomingPale EnglishWrittenLanguage "&%BecomingPale is a kind of &%PhysiologicalResponseToEmotionalState characterized by the loss of color or lightening of the skin, typically resulting from a reduction of blood flow to the cutaneous capillaries in response to an emotional state.")
(subclass BecomingPale PhysiologicalResponseToEmotionalState)

(termFormat EnglishWrittenLanguage ExperiencingALumpInTheThroat "experiencing a
lump in the throat")
(documentation ExperiencingALumpInTheThroat EnglishWrittenLanguage "&%ExperiencingALumpInTheThroat is a kind of &%PhysiologicalResponseToEmotionalState characterized by the sensation of a constriction or a lump in the throat, often occurring as a physical manifestation of strong emotional distress or sadness.")
(subclass ExperiencingALumpInTheThroat
   PhysiologicalResponseToEmotionalState)

(=>
   (and
      (instance ?ELT ExperiencingALumpInTheThroat)
      (experiencer ?ELT ?A))
   (exists (?P ?T)
      (and
         (instance ?P Perception)
         (subProcess ?P ?ELT)
         (agent ?P ?A)
         (patient ?P ?T)
         (instance ?T Throat)
         (part ?T ?A))))

(documentation ExperiencingWarmSensationInWholeBody EnglishWrittenLanguage 
   "&%ExperiencingWarmSensationInWholeBody is a &%PhysiologicalResponseToEmotionalState when
feeling warm.")
(termFormat EnglishWrittenLanguage ExperiencingWarmSensationInWholeBody
   "experiencing warm sensation in whole body")

(instance ExperiencingWarmSensationInWholeBody TemperatureRisingExperiencedAsFeelingWarm)
(documentation ExperiencingHeatInCheeksOrChest EnglishWrittenLanguage 
   "&%ExperiencingHeatInCheeksOrChest is a &%PhysiologicalResponseToEmotionalState when
feeling warm.")

(subclass ExperiencingHeatInCheeksOrChest TemperatureRisingExperiencedAsFeelingWarm)
(termFormat EnglishWrittenLanguage ExperiencingHeatInCheeksOrChest
   "experiencing heat in cheeks or chest")

(=>
   (and
      (instance ?ELT ExperiencingHeatInCheeksOrChest)
      (experiencer ?ELT ?A))
   (exists (?P ?T)
      (and
         (instance ?P Perception)
         (subProcess ?P ?ELT)
         (agent ?P ?A)
         (patient ?P ?T)
         (or
            (instance ?T Torso)
            (instance ?T Face))
         (part ?T ?A))))

;; -------------- Feelings --------------

(documentation FeelingCalm EnglishWrittenLanguage "The subjective feeling of
being calm, being relaxed, being at peace.")
(termFormat EnglishWrittenLanguage FeelingCalm "feeling calm")
(instance FeelingCalm SubjectiveEmotionalFeeling)
(utterance EnglishWrittenLanguage FeelingCalm "calm")
(contraryAttribute FeelingCalm FeelingNervous)

(termFormat EnglishWrittenLanguage FeelingNervous "feeling nervous")
(utterance EnglishWrittenLanguage FeelingNervous "nervous")
(instance FeelingNervous SubjectiveEmotionalFeeling)
(documentation FeelingNervous EnglishWrittenLanguage "The subjective feeling of
being not at ease, of being anxious or nervous or agitated.")
(contraryAttribute FeelingNervous FeelingAtEase)

(documentation FeelingRestless EnglishWrittenLanguage "The subjective emotional
feeling of restlessness, a state of not being calm, of an agitation to
do something.")
(termFormat EnglishWrittenLanguage FeelingRestless "feeling restless")
(utterance EnglishWrittenLanguage FeelingRestless "restless")
(instance FeelingRestless SubjectiveEmotionalFeeling)
(contraryAttribute FeelingRestless FeelingCalm)

(termFormat EnglishWrittenLanguage FeelingAtEase "feeling at ease")
(documentation FeelingAtEase EnglishWrittenLanguage "The subjective emotional
feeling of being at ease, comfortable, relaxed.")
(instance FeelingAtEase SubjectiveEmotionalFeeling)
(utterance EnglishWrittenLanguage FeelingAtEase "at ease")
(contraryAttribute FeelingAtEase FeelingRestless)

(instance FeelingInControl SubjectiveEmotionalFeeling)
(documentation FeelingInControl EnglishWrittenLanguage "The subjective emotional feeling that one is in control of oneself, that one is fully the agent of one&apos s behavior.")
(utterance EnglishWrittenLanguage FeelingInControl "in control")
(termFormat EnglishWrittenLanguage FeelingInControl "feeling in control")
(contraryAttribute FeelingInControl FeelingOutOfControl)

(documentation FeelingOutOfControl EnglishWrittenLanguage "May have an
evaluative component as well as a feeling component. Needs discussing.")
(instance FeelingOutOfControl SubjectiveEmotionalFeeling)
(utterance EnglishWrittenLanguage FeelingOutOfControl "out of control")
(termFormat EnglishWrittenLanguage FeelingOutOfControl "feeling out of control")
(documentation FeelingOutOfControl EnglishWrittenLanguage "The subjective
feeling of not being in control, not being able to gain agency of
one&apos;s own behavior.")

(utterance EnglishWrittenLanguage FeelingStrong "strong")
(termFormat EnglishWrittenLanguage FeelingStrong "feeling strong")
(documentation FeelingStrong EnglishWrittenLanguage "The subjective feeling of
strength, capability, energy and capacity to do things.")
(instance FeelingStrong SubjectiveEmotionalFeeling)
(contraryAttribute FeelingStrong FeelingWeak)

(documentation FeelingWeak EnglishWrittenLanguage "The subjective feeling of
weakness, lack of energy and/or capability, faintness, absence of
strength.")
(termFormat EnglishWrittenLanguage FeelingWeak "feeling weak")
(utterance EnglishWrittenLanguage FeelingWeak "weak")
(instance FeelingWeak SubjectiveEmotionalFeeling)

(documentation FeelingExhausted EnglishWrittenLanguage "The subjective
emotional feeling of exhaustion, an extremely strong form of feeling
tired.")
(subAttribute FeelingExhausted FeelingTired)
(termFormat EnglishWrittenLanguage FeelingExhausted "feeling exhausted")
(utterance EnglishWrittenLanguage FeelingExhausted "exhausted")
(contraryAttribute FeelingExhausted FeelingEnergetic)

(utterance EnglishWrittenLanguage FeelingEnergetic "energetic")
(termFormat EnglishWrittenLanguage FeelingEnergetic "feeling energetic")
(instance FeelingEnergetic SubjectiveEmotionalFeeling)
(documentation FeelingEnergetic EnglishWrittenLanguage "The subjective
emotional feeling of having lots of energy, being energetic.")

(documentation FeelingBad EnglishWrittenLanguage "The subjective emotional
feeling of feeling bad, negative.")
(termFormat EnglishWrittenLanguage FeelingBad "feeling bad")
(utterance EnglishWrittenLanguage FeelingBad "bad")
(instance FeelingBad SubjectiveEmotionalFeeling)
(termFormat EnglishWrittenLanguage FeelingBad "feeling negative")
(contraryAttribute FeelingGood FeelingBad)

(utterance EnglishWrittenLanguage FeelingGood "good")
(instance FeelingGood SubjectiveEmotionalFeeling)
(termFormat EnglishWrittenLanguage FeelingGood "feeling positive")
(documentation FeelingGood EnglishWrittenLanguage "The subjective emotional
feeling of feeling good, positive.")
(termFormat EnglishWrittenLanguage FeelingGood "feeling good")

(termFormat EnglishWrittenLanguage FeelingAlert "feeling alert")
(utterance EnglishWrittenLanguage FeelingAlert "alert")
(instance FeelingAlert SubjectiveEmotionalFeeling)
(documentation FeelingAlert EnglishWrittenLanguage "The subjective feeling of
being wide awake, alert, having active attention and perception.")
(contraryAttribute FeelingAlert FeelingTired)

(instance FeelingTired SubjectiveEmotionalFeeling)
(utterance EnglishWrittenLanguage FeelingTired "tired")
(documentation FeelingTired EnglishWrittenLanguage "The subjective emotional
feeling of tiredness, needing sleep.")
(termFormat EnglishWrittenLanguage FeelingTired "feeling tired")

(instance FeelingCold SubjectiveAssessmentAttribute)
(utterance EnglishWrittenLanguage FeelingCold "cold")
(documentation FeelingCold EnglishWrittenLanguage "The subjective state of
feeling cold. This could be because the temperature is low
for the amount of clothing worn, or it could be because the person is
running a &%Fever.")
(termFormat EnglishWrittenLanguage FeelingCold "feeling cold")

(=>
   (holdsDuring ?T
      (and
         (located ?H ?L)
         (instance ?TEMP1 TemperatureMeasure)
         (equal ?TEMP1 (MeasureFn ?T ?TU))
         (airTemperature ?L ?TEMP1)
         (attribute ?H FeelingCold)))
   (exists (?T2 ?TEMP2)
      (and
        (instance ?TEMP2 TemperatureMeasure)
        (equal ?TEMP2 (MeasureFn ?T2 ?TU))
        (desires ?H
          (holdsDuring ?T
              (and
                (airTemperature ?L 
                    ?TEMP2)
                (greaterThan ?T2 ?T)))))))

(subclass Chills Trembling)
(documentation Chills EnglishWrittenLanguage "&%Trembling caused by
&%FeelingCold.  Note that this is different from &%Shivering 
which is the same physiologically, but is caused by emotion,
such as &%Fear.")
(termFormat EnglishWrittenLanguage Chills "chills")

(=>
   (and
      (instance ?C Chills)
      (experiencer ?C ?H))
   (holdsDuring
      (WhenFn ?C)
      (attribute ?H FeelingCold)))

(instance FeelingHot SubjectiveAssessmentAttribute)
(utterance EnglishWrittenLanguage FeelingHot "hot")
(documentation FeelingHot EnglishWrittenLanguage "The subjective state of
feeling hot. This could be because the temperature is high
for the amount of clothing worn, or it could be because the person is
exercising vigorously.")
(termFormat EnglishWrittenLanguage FeelingCold "feeling hot")

(=>
   (holdsDuring ?T
      (and
         (located ?H ?L)
         (instance ?TEMP TemperatureMeasure)
         (equal ?TEMP (MeasureFn ?T ?TU))
         (airTemperature ?L ?TEMP)
         (attribute ?H FeelingHot)))
   (exists (?T2 ?TEMP2)
      (and
        (instance ?TEMP2 TemperatureMeasure)
        (equal ?TEMP2 (MeasureFn ?T2 ?TU))
        (desires ?H
          (holdsDuring ?T
            (and
              (airTemperature ?L ?TEMP2)
              (greaterThan ?T ?T2)))))))

(documentation FeelingDubious EnglishWrittenLanguage "The &%FeelingDubious is a kind of &%EmotionalState characterized by a &%StateOfMind of uncertainty, hesitation, or lack of conviction regarding the truth or reliability of a particular matter.")
(instance FeelingDubious EmotionalState)
(termFormat EnglishWrittenLanguage FeelingDubious "dubious")

;; -------------- Speech --------------

(documentation SurprisedVoiceUtterance EnglishWrittenLanguage "Voice utterance
canonically associated with the experience of surprise")
(termFormat EnglishWrittenLanguage SurprisedVoiceUtterance "surprised voice
utterance")
(relatedInternalConcept SurprisedVoiceUtterance Surprise)
(subclass SurprisedVoiceUtterance EmotionalVoiceUtterances)

(=>
   (and
      (instance ?SVU SurprisedVoiceUtterance)
      (agent ?SVU ?A))
   (holdsDuring
      (WhenFn ?SVU)
      (attribute ?A Surprise)))

(relatedInternalConcept AngryVoiceUtterance SpeakingLoudly)
(termFormat EnglishWrittenLanguage AngryVoiceUtterance "angry voice utterance")
(documentation AngryVoiceUtterance EnglishWrittenLanguage "Vocal utterances
canonically associated with the experience of anger")
(relatedInternalConcept AngryVoiceUtterance Anger)
(subclass AngryVoiceUtterance EmotionalVoiceUtterances)

(=>
   (and
      (instance ?AVU AngryVoiceUtterance)
      (agent ?AVU ?A))
   (modalAttribute
      (holdsDuring
         (WhenFn ?AVU)
         (attribute ?A Anger))
      Likely))

(relatedInternalConcept SadVoiceUtterance Weeping)
(documentation SadVoiceUtterance EnglishWrittenLanguage "Voice utterance
characteristically associated with the experience of sadness.")
(relatedInternalConcept SadVoiceUtterance Sadness)
(termFormat EnglishWrittenLanguage SadVoiceUtterance "sad voice utterance")
(subclass SadVoiceUtterance EmotionalVoiceUtterances)

(=>
   (and
      (instance ?SVU SadVoiceUtterance)
      (agent ?SVU ?A))
   (holdsDuring
      (WhenFn ?SVU)
      (attribute ?A Sadness)))

(subclass HappyVoiceUtterance EmotionalVoiceUtterances)
