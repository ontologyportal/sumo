(=>
  (instance ?LP LegPress)
  (exists (?LPM ?PERSON ?F1 ?F2 ?EP ?S ?PUSH)
    (and
      (instance ?LPM LegPressMachine)
      (instance ?PERSON Human)
      (instance ?F1 Foot)
      (instance ?F2 Foot)
      (instance ?EP ExercisePlatform)
      (instance ?S Seat)
      (instance ?PUSH Pushing)
      (not
        (equal ?F1 ?F2))
      (part ?F1 ?PERSON)
      (part ?F2 ?PERSON)
      (component ?EP ?LPM)
      (component ?S ?LPM)
      (attribute ?PERSON Sitting)
      (orientation ?PERSON ?S On)
      (subProcess ?PUSH ?LP)
      (agent ?LP ?PERSON)
      (agent ?PUSH ?PERSON)
      (instrument ?LP ?LPM)
      (instrument ?PUSH ?F1)
      (instrument ?PUSH ?F2)
      (patient ?PUSH ?EP))))

(=>
  (instance ?LP LegPress)
  (hasPurpose ?LP
    (exists (?G ?Q ?GL)
      (and
        (instance ?G Growth)
        (instance ?Q QuadricepsFemorisMuscle)
        (instance ?GL GluteusMaximusMuscle)
        (patient ?G ?Q)
        (patient ?G ?GL)))))

(subclass LateralRaise Weightlifting)
(documentation LateralRaise EnglishWrittenLanguage "A &%Weightlifting exercise that trains the &%DeltoidMuscle and &%LatissimusDorsi by moving a &%Dumbbell or a &%CableFitnessAttachment on a &%CableMachine in &%Semicircle motion at one's sides.")
(termFormat EnglishWrittenLanguage LateralRaise "Lateral Raise")

(=>
  (instance ?LR LateralRaise)
  (exists (?PULL ?PERSON ?H1 ?INS ?PATH)
    (and
      (instance ?PULL Pulling)
      (instance ?PERSON Human)
      (instance ?H1 Hand)
      (part ?H1 ?PERSON)
      (subProcess ?PULL ?LR)
      (path ?PULL ?PATH)
      (shape ?PATH Semicircle)
      (agent ?LR ?PERSON)
      (agent ?PULL ?PERSON)
      (instrument ?PULL ?H1)
      (instrument ?LR ?INS)
      (patient ?PULL ?INS)
      (or
        (orientation ?INS ?PERSON Left)
        (orientation ?INS ?PERSON Right))
      (or
        (instance ?INS Dumbbell)
        (exists (?CM ?ATTACH)
          (and
            (instance ?INS CableFitnessAttachment)
            (instance ?CM CableMachine)
            (instance ?ATTACH Attaching)
            (patient ?ATTACH ?INS)
            (destination ?ATTACH ?CM)))))))

(=>
  (instance ?LR LateralRaise)
  (hasPurpose ?LR
    (exists (?G ?D ?LD)
      (and
        (instance ?G Growth)
        (instance ?D DeltoidMuscle)
        (instance ?LD LatissimusDorsi)
        (patient ?G ?D)
        (patient ?G ?LD)))))

