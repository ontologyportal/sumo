(termFormat EnglishWrittenLanguage Climbing "Climbing")
(=>
  (instance ?C Climbing)
  (exists (?A ?REFERENCE ?BEFOREALT ?AFTERALT)
    (and
      (agent ?C ?A)
      (instance ?REFERENCE Physical)
      (holdsDuring
        (BeginFn
          (WhenFn ?C))
        (altitude ?A ?REFERENCE ?BEFOREALT))
      (holdsDuring
        (EndFn
          (WhenFn ?C))
        (altitude ?A ?REFERENCE ?AFTERALT))
      (greaterThan ?AFTERALT ?BEFOREALT))))

(subclass PreacherCurlDevice AnaerobicExerciseDevice)
(documentation PreacherCurlDevice EnglishWrittenLanguage "A stationary &%AnaerobicExerciseDevice that consists of a &%Seat and an elevated &%Padded &%surface used to perform the &%PreacherCurl exercise.")
(termFormat EnglishWrittenLanguage PreacherCurlDevice "Preacher Curl Device")

(=>
  (instance ?PCD PreacherCurlDevice)
  (hasPurpose ?PCD
    (exists (?PERSON ?PC ?EZ ?PAD ?SEAT)
      (and
        (instance ?PERSON Human)
        (instance ?PC PreacherCurl)
        (instance ?EZ EZBarbell)
        (instance ?PAD Object)
        (instance ?SEAT Seat)
        (surface ?PAD ?PCD)
        (attribute ?PAD Padded)
        (component ?SEAT ?PCD)
        (agent ?PC ?PERSON)
        (instrument ?PC ?PCD)
        (instrument ?PC ?EZ)))))

(=>
  (instance ?PCD PreacherCurlDevice)
  (exists (?PAD ?SEAT)
    (and
      (instance ?PAD Object)
      (instance ?SEAT Seat)
      (component ?PAD ?PCD)
      (component ?SEAT ?PCD)
      (attribute ?PAD Padded)
      (relativeAngle ?PAD ?SEAT 45))))

(subclass PreacherCurl BicepCurl)
(documentation PreacherCurl EnglishWrittenLanguage "A type &%BicepCurl in which the arms are rested on top of a &%PreacherCurlDevice while using a &%EZBarbell in order to isolate the &%Bicep.")
(termFormat EnglishWrittenLanguage PreacherCurl "Preacher Curl")

(=>
  (instance ?PC PreacherCurl)
  (exists (?PERSON ?A1 ?A2 ?EZ ?PCD)
    (and
      (instance ?PCD PreacherCurlDevice)
      (instance ?PERSON Human)
      (instance ?A1 Arm)
      (instance ?A2 Arm)
      (instance ?EZ EZBarbell)
      (not
        (equal ?A1 ?A2))
      (part ?A1 ?PERSON)
      (part ?A2 ?PERSON)
      (orientation ?A1 ?PCD On)
      (orientation ?A2 ?PCD On)
      (instrument ?PC ?EZ)
      (instrument ?PC ?PCD)
      (agent ?PC ?PERSON))))

(subclass GobletSquat Squat)
(documentation GobletSquat EnglishWrittenLanguage "A type of weighted &%Squat in which the user holds a &%Dumbbell or &%Kettlebell near the &%Chest.")
(termFormat EnglishWrittenLanguage GobletSquat "Goblet Squat")

(=>
  (instance ?GS GobletSquat)
  (exists (?INS ?T ?PERSON)
    (and
      (or
        (instance ?INS Dumbbell)
        (instance ?INS Kettlebell))
      (instance ?T Torso)
      (instance ?PERSON Human)
      (part ?T ?PERSON)
      (grasps ?PERSON ?INS)
      (agent ?GS ?PERSON)
      (orientation ?INS ?T Near)
      (instrument ?GS ?INS))))

(subclass BarbellBackSquat Squat)
(documentation BarbellBackSquat EnglishWrittenLanguage "A type of weighted &%Squat in which the user holds a &%Barbell on both &%Shoulder.")
(termFormat EnglishWrittenLanguage BarbellBackSquat "Barbell Back Squat")

(=>
  (instance ?BBS BarbellBackSquat)
  (exists (?BB ?S1 ?S2 ?PERSON)
    (and
      (instance ?BB Barbell)
      (instance ?S1 Shoulder)
      (instance ?S2 Shoulder)
      (instance ?PERSON Human)
      (not
        (equal ?S1 ?S2))
      (part ?S1 ?PERSON)
      (part ?S2 ?PERSON)
      (agent ?BBS ?PERSON)
      (instrument ?BBS ?BB)
      (grasps ?PERSON ?BB)
      (orientation ?BB ?S1 On)
      (orientation ?BB ?S2 On))))

(subclass CalfRaise Weightlifting)
(documentation CalfRaise EnglishWrittenLanguage "A &%Weightlifting exercise that trains the &%GastrocnemiusMuscle and &%SoleusMuscle by &%Pushing the &%Foot vertically.")
(termFormat EnglishWrittenLanguage CalfRaise "Calf Raise")

(=>
  (instance ?CR CalfRaise)
  (exists (?PERSON ?F1 ?F2 ?PUSH ?FL)
    (and
      (instance ?PERSON Human)
      (instance ?F1 Foot)
      (instance ?F2 Foot)
      (instance ?FL Floor)
      (instance ?PUSH Pushing)
      (not
        (equal ?F1 ?F2))
      (part ?F1 ?PERSON)
      (part ?F2 ?PERSON)
      (subProcess ?PUSH ?CR)
      (direction ?PUSH Vertical)
      (agent ?CR ?PERSON)
      (orientation ?PERSON ?FL On)
      (instrument ?PUSH ?F1)
      (instrument ?PUSH ?F2)
      (patient ?PUSH ?FL))))

(=>
  (instance ?CR CalfRaise)
  (hasPurpose ?CR
    (exists (?G ?GM ?SL)
      (and
        (instance ?G Growth)
        (instance ?GM GastrocnemiusMuscle)
        (instance ?SL SoleusMuscle)
        (patient ?G ?GM)
        (patient ?G ?SL)))))

(subclass GymLandmineDevice AnaerobicExerciseDevice)
(documentation GymLandmineDevice EnglishWrittenLanguage "A &%AnaerobicExerciseDevice that anchors one end of a &%Barbell to allow pivoting during various exercises.")
(termFormat EnglishWrittenLanguage GymLandmineDevice "Gym Landmine Device")

(=>
  (instance ?GLD GymLandmineDevice)
  (hasPurpose ?GLD
    (exists (?EXERCISE ?PERSON ?BB ?ANCHOREDEND)
      (and
        (instance ?EXERCISE Weightlifting)
        (instance ?PERSON Human)
        (instance ?BB Barbell)
        (instance ?ANCHOREDEND Object)
        (side ?ANCHOREDEND ?BB)
        (connected ?ANCHOREDEND ?GLD)
        (agent ?EXERCISE ?PERSON)
        (instrument ?EXERCISE ?GLD)
        (instrument ?EXERCISE ?BB)))))

(subclass LandminePress Weightlifting)
(documentation LandminePress EnglishWrittenLanguage "A &%Weightlifting exercise that trains the &%Pectoralis, &%DeltoidMuscle and &%Tricep by pushing the free end of a &%Barbell attached to a &%GymLandmineDevice above the &%Head.")
(termFormat EnglishWrittenLanguage LandminePress "Landmine Press")

(=>
  (instance ?LP LandminePress)
  (exists (?PERSON ?H ?HEAD ?BB ?GLD ?PUSH ?ANCHOREDEND ?MOVINGEND)
    (and
      (instance ?PERSON Human)
      (instance ?H Hand)
      (instance ?HEAD Head)
      (instance ?BB Barbell)
      (instance ?GLD GymLandmineDevice)
      (instance ?PUSH Pushing)
      (instance ?ANCHOREDEND Object)
      (instance ?MOVINGEND Object)
      (part ?H ?PERSON)
      (part ?HEAD ?PERSON)
      (side ?ANCHOREDEND ?BB)
      (side ?MOVINGEND ?BB)
      (not
        (equal ?ANCHOREDEND ?MOVINGEND))
      (connected ?ANCHOREDEND ?GLD)
      (not
        (connected ?MOVINGEND ?GLD))
      (subProcess ?PUSH ?LP)
      (agent ?LP ?PERSON)
      (agent ?PUSH ?PERSON)
      (instrument ?LP ?GLD)
      (instrument ?LP ?BB)
      (instrument ?PUSH ?H)
      (patient ?PUSH ?MOVINGEND)
      (orientation ?MOVINGEND ?HEAD Above))))

(=>
  (instance ?LP LandminePress)
  (hasPurpose ?LP
    (exists (?G ?PM ?DM ?T)
      (and
        (instance ?G Growth)
        (instance ?PM Pectoralis)
        (instance ?DM DeltoidMuscle)
        (instance ?T Tricep)
        (patient ?G ?PM)
        (patient ?G ?DM)
        (patient ?G ?T)))))

(subclass GymTowel Towel)
(documentation GymTowel EnglishWrittenLanguage "A &%Towel that is used to perform &%Cleaning on both &%AerobicExerciseDevice and &%AnaerobicExerciseDevice.")
(termFormat EnglishWrittenLanguage GymTowel "Gym Towel")

(=>
  (instance ?GT GymTowel)
  (hasPurpose ?GT
    (exists (?DEVICE ?C)
      (and
        (instance ?C Cleaning)
        (or
          (instance ?DEVICE AnaerobicExerciseDevice)
          (instance ?DEVICE AerobicExerciseDevice))
        (patient ?C ?DEVICE)
        (instrument ?C ?GT)))))

(subclass FitnessStretching Stretching)
(subclass FitnessStretching RecreationOrExercise)
(documentation FitnessStretching EnglishWrittenLanguage "A type of &%Stretching of the muscles in order to prevent injury.")
(termFormat EnglishWrittenLanguage FitnessStretching "Fitness Stretching")

(=>
  (instance ?FS FitnessStretching)
  (hasPurpose ?FS
    (exists (?S ?M ?I)
      (and
        (instance ?S Stretching)
        (instance ?M Muscle)
        (instance ?I Injuring)
        (patient ?S ?M)
        (patient ?I ?M)
        (prevents ?S ?I)))))

(subclass YogaMat RecreationOrExerciseDevice)
(documentation YogaMat EnglishWrittenLanguage "A flat, pliable and portable &%RecreationOrExerciseDevice that is placed on the floor to provide a surface for &%FitnessStretching.")
(termFormat EnglishWrittenLanguage YogaMat "Yoga Mat")

(=>
  (instance ?YM YogaMat)
  (hasPurpose ?YM
    (exists (?FS ?PERSON)
      (and
        (instance ?FS FitnessStretching)
        (instance ?PERSON Human)
        (agent ?FS ?PERSON)
        (orientation ?PERSON ?YM On)))))

(=>
  (instance ?YM YogaMat)
  (and
    (attribute ?YM Flat)
    (attribute ?YM Pliable)
    (attribute ?YM Portable)))

(subclass HackSquatMachine WeightMachine)
(documentation HackSquatMachine EnglishWrittenLanguage "A &%WeightMachine consisting of an &%ExercisePlatform and padded back that guides the user through the &%HackSquat exercise.")
(termFormat EnglishWrittenLanguage HackSquatMachine "Hack Squat Machine")

(=>
  (instance ?HSM HackSquatMachine)
  (hasPurpose ?HSM
    (exists (?HS ?PERSON ?PLATFORM ?BACKSUPPORT)
      (and
        (instance ?HS HackSquat)
        (instance ?PERSON Human)
        (instance ?PLATFORM ExercisePlatform)
        (instance ?BACKSUPPORT Object)
        (component ?PLATFORM ?HSM)
        (component ?BACKSUPPORT ?HSM)
        (attribute ?BACKSUPPORT Padded)
        (agent ?HS ?PERSON)
        (instrument ?HS ?HSM)
        (orientation ?PERSON ?PLATFORM On)
        (orientation
          (BackFn ?PERSON) ?BACKSUPPORT On)))))

(=>
  (instance ?HSM HackSquatMachine)
  (hasPurpose ?HSM
    (exists (?HS ?G ?Q ?GL ?H)
      (and
        (instance ?HS HackSquat)
        (instrument ?HS ?HSM)
        (instance ?G Growth)
        (instance ?Q QuadricepsFemorisMuscle)
        (instance ?GL GluteusMaximusMuscle)
        (instance ?H HamstringMuscle)
        (patient ?G ?Q)
        (patient ?G ?GL)
        (patient ?G ?H)))))

(=>
  (instance ?HSM HackSquatMachine)
  (attribute ?HSM ResistanceAdjustable))

(subclass HackSquat Squat)
(documentation HackSquat EnglishWrittenLanguage "A type of &%Squat performed on a &%HackSquatMachine while the user's back is on the machine's support while the legs push vertically against the machine's &%ExercisePlatform.")
(termFormat EnglishWrittenLanguage HackSquat "Hack Squat")

(=>
  (instance ?HS HackSquat)
  (exists (?HSM ?PERSON ?L1 ?L2 ?PLATFORM ?BACKSUPPORT ?PUSH)
    (and
      (instance ?HSM HackSquatMachine)
      (instance ?PERSON Human)
      (instance ?L1 Leg)
      (instance ?L2 Leg)
      (instance ?PLATFORM ExercisePlatform)
      (instance ?BACKSUPPORT Object)
      (instance ?PUSH Pushing)
      (not
        (equal ?L1 ?L2))
      (part ?L1 ?PERSON)
      (part ?L2 ?PERSON)
      (component ?PLATFORM ?HSM)
      (component ?BACKSUPPORT ?HSM)
      (attribute ?BACKSUPPORT Padded)
      (orientation ?PERSON ?PLATFORM On)
      (orientation
        (BackFn ?PERSON) ?BACKSUPPORT On)
      (subProcess ?PUSH ?HS)
      (direction ?PUSH Vertical)
      (agent ?HS ?PERSON)
      (agent ?PUSH ?PERSON)
      (instrument ?HS ?HSM)
      (instrument ?PUSH ?L1)
      (instrument ?PUSH ?L2)
      (patient ?PUSH ?PLATFORM)
      (patient ?PUSH ?PERSON))))

(subclass PreventativeWeightliftingEquipment WearableItem)
(subclass PreventativeWeightliftingEquipment SafetyDevice)
(documentation PreventativeWeightliftingEquipment EnglishWrittenLanguage "A &%WearableItem with the purpose of reducing risk of injury during &%Weightlifting")
(termFormat EnglishWrittenLanguage PreventativeWeightliftingEquipment "Preventative Weightlifting Equipment")

(=>
  (instance ?PR PreventativeWeightliftingEquipment)
  (hasPurpose ?PR
    (exists (?PERSON ?PART ?W)
      (and
        (instance ?PERSON Human)
        (instance ?PART BodyPart)
        (part ?PART ?PERSON)
        (instance ?W Weightlifting)
        (agent ?W ?PERSON)
        (wears ?PERSON ?PR)))))

(subclass WristWrap Band)
(subclass WristWrap PreventativeWeightliftingEquipment)
(documentation WristWrap EnglishWrittenLanguage "A wearable &%Band worn around &%Wrist to reduce risk of &%Wrist injury during &%Weightlifting.")
(termFormat EnglishWrittenLanguage WristWrap "Wrist Wrap")

(=>
  (instance ?WW WristWrap)
  (hasPurpose ?WW
    (exists (?PERSON ?WR ?W)
      (and
        (instance ?PERSON Human)
        (instance ?WR Wrist)
        (part ?WR ?PERSON)
        (instance ?W Weightlifting)
        (agent ?W ?PERSON)
        (wears ?PERSON ?WW)
        (orientation ?WW ?WR On)
        (not
          (exists (?I)
            (and
              (instance ?I Injuring)
              (patient ?I ?WR))))))))

(subclass WeightliftingBelt Belt)
(subclass WeightliftingBelt PreventativeWeightliftingEquipment)
(documentation WeightliftingBelt EnglishWrittenLanguage "A &%Belt worn around the &%Torso to provide support and reduce risk of injury to the &%SpinalCord during &%Weightlifting.")
(termFormat EnglishWrittenLanguage WeightliftingBelt "Weightlifting Belt")

(=>
  (instance ?WB WeightliftingBelt)
  (hasPurpose ?WB
    (exists (?PERSON ?T ?W ?S)
      (and
        (instance ?PERSON Human)
        (instance ?T Torso)
        (instance ?S SpinalCord)
        (part ?T ?PERSON)
        (part ?S ?PERSON)
        (instance ?W Weightlifting)
        (agent ?W ?PERSON)
        (wears ?PERSON ?WB)
        (orientation ?WB ?T On)
        (not
          (exists (?I)
            (and
              (instance ?I Injuring)
              (patient ?I ?S))))))))