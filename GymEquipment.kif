      (agent ?PULL ?PERSON)
      (instrument ?PULL ?S)
      (instrument ?FS ?INS)
      (grasps ?PERSON ?INS)
      (patient ?PULL ?INS)
      (or
        (instance ?INS Dumbbell)
        (instance ?INS Kettlebell)))))

(=>
  (instance ?FS FitnessShrug)
  (hasPurpose ?FS
