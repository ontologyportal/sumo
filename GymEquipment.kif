(subclass WeightTrainingBench AnaerobicExerciseDevice)
(documentation WeightTrainingBench EnglishWrittenLanguage "A type of &%Bench meant to support one person for the purpose of performing various exercises. They are typically &%Padded and some allow the user to adjust the bench's incline.")
(termFormat EnglishWrittenLanguage WeightTrainingBench "Weight Training Bench")

(=>
  (instance ?WTB WeightTrainingBench)
  (hasPurpose ?WTB
    (exists (?PERSON ?EXERCISE)
      (and
        (instance ?PERSON Human)
        (instance ?EXERCISE Weightlifting)
        (or
          (attribute ?PERSON Sitting)
          (attribute ?PERSON Prostrate))
        (orientation ?PERSON ?WTB On)
        (agent ?EXERCISE ?PERSON)
        (instrument ?EXERCISE ?WTB)
        (not
          (exists (?PERSON2)
            (and
              (instance ?PERSON2 Human)
              (not
                (equal ?PERSON ?PERSON2))
              (or
                (attribute ?PERSON2 Sitting)
                (attribute ?PERSON2 Prostrate))
              (orientation ?PERSON2 ?WTB On))))))))

(=>
  (attribute ?OBJ InclineAdjustable)
  (and
    (instance ?OBJ Artifact)
    (capability Rotating patient ?OBJ)))

(instance SimulatedActivityFn UnaryFunction)
(domainSubclass SimulatedActivityFn 1 Process)
(rangeSubclass SimulatedActivityFn IntentionalProcess)
(documentation SimulatedActivityFn EnglishWrittenLanguage "A &%UnaryFunction that maps a class of processes to intentional processes that simulate processes of that type without necessarily producing the same physical results.")
(termFormat EnglishWrittenLanguage SimulatedActivityFn "Simulated Activity")

(=>
  (instance ?SIMULATION
    (SimulatedActivityFn ?ACTIVITY))
  (and
    (instance ?SIMULATION IntentionalProcess)
    (subclass ?ACTIVITY Process)))

