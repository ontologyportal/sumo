;; ======================================================================================
;; Ontology of Gym Equipment written by Jackson Lawrence
;; 
;; Depends heavily upon Muscles.kif
;; ======================================================================================

(subclass Treadmill AerobicExerciseDevice)
(documentation Treadmill EnglishWrittenLanguage "A stationary &%AerobicExerciseDevice with a moving &%Drivebelt that is ambulated on for the purpose of exercise.")
(termFormat EnglishWrittenLanguage Treadmill "Treadmill")

(=>
  (instance ?T Treadmill)
  (hasPurpose ?T
    (exists (?EXERCISE ?PERSON)
      (and
        (instance ?EXERCISE Aerobics)
        (instance ?PERSON Human)
        (agent ?EXERCISE ?PERSON)
        (instrument ?EXERCISE ?T)))))

(=>
  (instance ?T Treadmill)
  (exists (?DB)
    (and
      (instance ?DB Drivebelt)
      (component ?DB ?T)
      (capability Rotating patient ?DB))))

(subclass ExercisePlatform Artifact)
(documentation ExercisePlatform EnglishWrittenLanguage "A flat &%Artifact that is used as a part of various RecreationOrExerciseDevices, designed to have pressure applied to it via the &%Foot or &%Leg.")
(termFormat EnglishWrittenLanguage ExercisePlatform "Exercise Platform")

(=>
  (instance ?PL ExercisePlatform)
  (and
    (attribute ?PL Flat)
    (attribute ?PL LoadBearing)))

(=>
  (instance ?PL ExercisePlatform)
  (exists (?DEVICE)
    (and
      (instance ?DEVICE RecreationOrExerciseDevice)
      (component ?PL ?DEVICE))))

(=>
  (instance ?PL ExercisePlatform)
  (hasPurpose ?PL
    (exists (?PUSHORPULL ?PERSON ?FOOTORLEG)
      (and
        (or
          (instance ?PUSHORPULL Pushing)
          (instance ?PUSHORPULL Pulling))
        (instance ?PERSON Human)
        (part ?FOOTORLEG ?PERSON)
        (or
          (instance ?FOOTORLEG Foot)
          (instance ?FOOTORLEG Leg))
        (patient ?PUSHORPULL ?PL)
        (agent ?PUSHORPULL ?PERSON)
        (instrument ?PUSHORPULL ?FOOTORLEG)))))

(subclass Elliptical AerobicExerciseDevice)
(documentation Elliptical EnglishWrittenLanguage "A stationary &%AerobicExerciseDevice that emulates the motion of ambulation on two &%ExercisePlatform that move in elliptic paths for the purpose of exercise.")
(termFormat EnglishWrittenLanguage Elliptical "Elliptical")

(=>
  (instance ?E Elliptical)
  (hasPurpose ?E
    (exists (?EXERCISE ?PERSON)
      (and
        (instance ?EXERCISE Aerobics)
        (instance ?PERSON Human)
        (agent ?EXERCISE ?PERSON)
        (instrument ?EXERCISE ?E)))))

(=>
  (instance ?E Elliptical)
  (exists (?PL1 ?PL2 ?M1 ?M2 ?P1 ?P2 ?PERSON)
    (and
      (instance ?PL1 ExercisePlatform)
      (instance ?PL2 ExercisePlatform)
      (instance ?PERSON Human)
      (component ?PL1 ?E)
      (component ?PL2 ?E)
      (not
        (equal ?PL1 ?PL2))
      (instance ?M1 Motion)
      (instance ?M2 Motion)
      (not
        (equal ?M1 ?M2))
      (patient ?M1 ?PL1)
      (patient ?M2 ?PL2)
      (orientation ?PERSON ?E On)
      (path ?M1 ?P1)
      (path ?M2 ?P2)
      (shape ?P1 Oval)
      (shape ?P2 Oval))))

(subclass Pedal ExercisePlatform)
(documentation Pedal EnglishWrittenLanguage "An &%ExercisePlatform that is meant to have force applied to it by the feet for various purposes.")
(termFormat EnglishWrittenLanguage Pedal "Pedal")
(=>
  (instance ?P Pedal)
  (hasPurpose ?P
    (exists (?PUSH ?PERSON ?FOOT)
      (and
        (instance ?PUSH Pushing)
        (instance ?PERSON Human)
        (instance ?FOOT Foot)
        (part ?FOOT ?PERSON)
        (agent ?PUSH ?PERSON)
        (instrument ?PUSH ?FOOT)
        (orientation ?FOOT ?P On)
        (patient ?PUSH ?P)))))

(subclass StationaryBicycle AerobicExerciseDevice)
(documentation StationaryBicycle EnglishWrittenLanguage "A stationary &%AerobicExerciseDevice that emulates the motion of pedaling a &%Bicycle for the purpose of exercise. Minimally, it has a &%Seat and two movable pedals.")
(termFormat EnglishWrittenLanguage StationaryBicycle "Stationary Bicycle")

(=>
  (instance ?SB StationaryBicycle)
  (hasPurpose ?SB
    (exists (?EXERCISE ?PERSON)
      (and
        (instance ?EXERCISE Aerobics)
        (instance ?PERSON Human)
        (agent ?EXERCISE ?PERSON)
        (instrument ?EXERCISE ?SB)))))

(=>
  (instance ?SB StationaryBicycle)
  (exists (?P1 ?P2 ?S)
    (and
      (instance ?P1 Pedal)
      (instance ?P2 Pedal)
      (instance ?S Seat)
      (component ?P1 ?SB)
      (component ?P2 ?SB)
      (component ?S ?SB)
      (not
        (equal ?P1 ?P2)))))

(subclass WeightMachine AnaerobicExerciseDevice)
(documentation WeightMachine EnglishWrittenLanguage "A stationary &%AnaerobicExerciseDevice that provides resistance during various motions for the purpose of developing muscles.")
(termFormat EnglishWrittenLanguage WeightMachine "Weight Machine")

(=>
  (instance ?WM WeightMachine)
  (hasPurpose ?WM
    (exists (?EXERCISE ?PERSON)
      (and
        (instance ?EXERCISE Weightlifting)
        (instance ?PERSON Human)
        (agent ?EXERCISE ?PERSON)
        (instrument ?EXERCISE ?WM)))))

(=>
  (instance ?WM WeightMachine)
  (attribute ?WM LoadBearing))

(subclass CableMachine WeightMachine)
(documentation CableMachine EnglishWrittenLanguage "A &%WeightMachine that has weights attached to a &%Cable and &%Pulley system that can be pushed or pulled to develop various muscles.")
(termFormat EnglishWrittenLanguage CableMachine "Cable Machine")

(=>
  (instance ?CM CableMachine)
  (exists (?PU ?C)
    (and
      (instance ?PU Pulley)
      (instance ?C Cable)
      (component ?PU ?CM)
      (component ?C ?CM)
      (connectedEngineeringComponents ?C ?PU)
      (meetsSpatially ?C ?PU))))

(subclass LegPressMachine WeightMachine)
(documentation LegPressMachine EnglishWrittenLanguage "A &%WeightMachine which has a &%ExercisePlatform that is pushed by the user in order to develop muscles in the &%Leg. The &%ExercisePlatform is located above the machine's &%Seat.")
(termFormat EnglishWrittenLanguage LegPressMachine "Leg Press Machine")

(=>
  (instance ?LPM LegPressMachine)
  (hasPurpose ?LPM
    (exists (?PUSH ?PERSON ?FOOT1 ?FOOT2 ?PLATFORM ?S)
      (and
        (instance ?PUSH Pushing)
        (instance ?PERSON Human)
        (instance ?FOOT1 Foot)
        (instance ?FOOT2 Foot)
        (instance ?S Seat)
        (instance ?PLATFORM ExercisePlatform)
        (part ?FOOT1 ?PERSON)
        (part ?FOOT2 ?PERSON)
        (component ?S ?LPM)
        (not
          (equal ?FOOT1 ?FOOT2))
        (orientation ?PERSON ?S On)
        (component ?PLATFORM ?LPM)
        (orientation ?PLATFORM ?S Above)
        (orientation ?FOOT1 ?PLATFORM On)
        (orientation ?FOOT2 ?PLATFORM On)
        (agent ?PUSH ?PERSON)
        (instrument ?PUSH ?FOOT1)
        (instrument ?PUSH ?FOOT2)
        (patient ?PUSH ?PLATFORM)))))

(=>
  (instance ?LPM LegPressMachine)
  (hasPurpose ?LPM
    (exists (?LP ?G ?Q ?GL)
      (and
        (instance ?LP LegPress)
        (instrument ?LP ?LPM)
        (instance ?G Growth)
        (instance ?Q QuadricepsFemorisMuscle)
        (instance ?GL GluteusMaximusMuscle)
        (patient ?G ?Q)
        (patient ?G ?GL)))))

(=>
  (instance ?LPM LegPressMachine)
  (attribute ?LPM ResistanceAdjustable))

(subclass LegExtensionMachine WeightMachine)
(documentation LegExtensionMachine EnglishWrittenLanguage "A &%WeightMachine which has a &%LongAndThin &%ExercisePlatform that is pushed away from the user with the legs to develop muscles in the &%Leg.")
(termFormat EnglishWrittenLanguage LegExtensionMachine "Leg Extension Machine")

(=>
  (instance ?LEM LegExtensionMachine)
  (hasPurpose ?LEM
    (exists (?PUSH ?PERSON ?L1 ?L2 ?PLATFORM ?S)
      (and
        (instance ?PUSH Pushing)
        (instance ?PERSON Human)
        (instance ?L1 Leg)
        (instance ?L2 Leg)
        (instance ?PLATFORM ExercisePlatform)
        (instance ?S Seat)
        (attribute ?PLATFORM LongAndThin)
        (part ?L1 ?PERSON)
        (part ?L2 ?PERSON)
        (not
          (equal ?L1 ?L2))
        (attribute ?PERSON Sitting)
        (orientation ?PERSON ?S On)
        (component ?S ?LEM)
        (component ?PLATFORM ?LEM)
        (orientation ?L1 ?PLATFORM On)
        (orientation ?L2 ?PLATFORM On)
        (agent ?PUSH ?PERSON)
        (instrument ?PUSH ?L1)
        (instrument ?PUSH ?L2)
        (patient ?PUSH ?PLATFORM)))))

(=>
  (instance ?LEM LegExtensionMachine)
  (hasPurpose ?LEM
    (exists (?LE ?G ?Q)
      (and
        (instance ?LE LegExtension)
        (instrument ?LE ?LEM)
        (instance ?G Growth)
        (instance ?Q QuadricepsFemorisMuscle)
        (patient ?G ?Q)))))

(=>
  (instance ?LEM LegExtensionMachine)
  (attribute ?LEM ResistanceAdjustable))

(subclass LegCurlMachine WeightMachine)
(documentation LegCurlMachine EnglishWrittenLanguage "A &%WeightMachine which has a &%LongAndThin &%ExercisePlatform that is pulled towards from the user with the legs to develop muscles in the &%Leg.")
(termFormat EnglishWrittenLanguage LegCurlMachine "Leg Curl Machine")

(=>
  (instance ?LCM LegCurlMachine)
  (hasPurpose ?LCM
    (exists (?PULL ?PERSON ?L1 ?L2 ?PLATFORM ?S)
      (and
        (instance ?PULL Pulling)
        (instance ?PERSON Human)
        (instance ?L1 Leg)
        (instance ?L2 Leg)
        (instance ?PLATFORM ExercisePlatform)
        (instance ?S Seat)
        (attribute ?PLATFORM LongAndThin)
        (part ?L1 ?PERSON)
        (part ?L2 ?PERSON)
        (not
          (equal ?L1 ?L2))
        (attribute ?PERSON Sitting)
        (orientation ?PERSON ?S On)
        (component ?S ?LCM)
        (component ?PLATFORM ?LCM)
        (orientation ?L1 ?PLATFORM On)
        (orientation ?L2 ?PLATFORM On)
        (agent ?PULL ?PERSON)
        (instrument ?PULL ?L1)
        (instrument ?PULL ?L2)
        (patient ?PULL ?PLATFORM)))))

(=>
  (instance ?LCM LegCurlMachine)
  (hasPurpose ?LCM
    (exists (?LC ?G ?H)
      (and
        (instance ?LC LegCurl)
        (instrument ?LC ?LCM)
        (instance ?G Growth)
        (instance ?H HamstringMuscle)
        (patient ?G ?H)))))

(=>
  (instance ?LCM LegCurlMachine)
  (attribute ?LCM ResistanceAdjustable))

(subclass Band Artifact)
(documentation Band EnglishWrittenLanguage "A &%LongAndThin &%Artifact that is used to attach or bind objects.")
(termFormat EnglishWrittenLanguage Band "Band")

(=>
  (instance ?B Band)
  (attribute ?B LongAndThin))

(=>
  (instance ?B Band)
  (hasPurpose ?B
    (exists (?A ?O)
      (and
        (instance ?A Attaching)
        (instance ?O Object)
        (patient ?A ?B)
        (destination ?A ?O)))))

(instance Elastic InternalAttribute)
(documentation Elastic EnglishWrittenLanguage "The attribute of an &%Artifact to stretch beyond its normal dimensions when force is applied and return to its approximately previous dimensions when said force is released.")
(termFormat EnglishWrittenLanguage Elastic "Elastic")

(=>
  (attribute ?OBJ Elastic)
  (and
    (attribute ?OBJ Pliable)
    (capability Stretching patient ?OBJ)))

(=>
  (and
    (instance ?S Stretching)
    (attribute ?OBJ Elastic)
    (patient ?S ?OBJ))
  (exists (?SHAPE)
    (and
      (holdsDuring
        (BeginFn
          (WhenFn ?S))
        (shape ?OBJ ?SHAPE))
      (holdsDuring
        (EndFn
          (WhenFn ?S))
        (shape ?OBJ ?SHAPE)))))

(subclass ResistanceBand Band)
(subclass ResistanceBand AnaerobicExerciseDevice)
(documentation ResistanceBand EnglishWrittenLanguage "A large &%Elastic &%Band made of rubber used in exercise that provides resistance when pulled apart for the purpose of training muscles. It is designed for exercise rather than binding objects like a typical rubber band and may be in a loop or open-ended.")
(termFormat EnglishWrittenLanguage ResistanceBand "Resistance Band")

(=>
  (instance ?RB ResistanceBand)
  (attribute ?RB Elastic))

(instance Portable InternalAttribute)
(documentation Portable EnglishWrittenLanguage "The attribute of an &%Artifact to be transported multiple times.")
(termFormat EnglishWrittenLanguage Portable "Portable")

(=>
  (attribute ?OBJ Portable)
  (hasPurpose ?OBJ
    (exists (?T1 ?T2)
      (and
        (instance ?T1 Transportation)
        (instance ?T2 Transportation)
        (not
          (equal ?T1 ?T2))
        (patient ?T1 ?OBJ)
        (patient ?T2 ?OBJ)))))

(subclass FreeWeight AnaerobicExerciseDevice)
(documentation FreeWeight EnglishWrittenLanguage "An &%AnaerobicExerciseDevice that provides resistance while being moved freely unlike a &%WeightMachine.")
(termFormat EnglishWrittenLanguage FreeWeight "Free Weight")

(=>
  (instance ?F FreeWeight)
  (and
    (attribute ?F Portable)
    (attribute ?F LoadBearing)))

(=>
  (instance ?F FreeWeight)
  (hasPurpose ?F
    (exists (?EXERCISE ?PERSON)
      (and
        (instance ?EXERCISE Weightlifting)
        (instance ?PERSON Human)
        (agent ?EXERCISE ?PERSON)
        (instrument ?EXERCISE ?F)))))

(subclass WeightPlate FreeWeight)
(documentation WeightPlate EnglishWrittenLanguage "A &%FreeWeight that is used to increase resistance during various forms of exercise. They tend to be circular but they come in a variety of shapes, and may have a hole in their center so they can be placed on other exercise equipment.")
(termFormat EnglishWrittenLanguage WeightPlate "Weight Plate")

(=>
  (instance ?WP WeightPlate)
  (and
    (attribute ?WP Flat)
    (hasPurpose ?WP
      (exists (?ATTACH ?D)
        (and
          (instance ?ATTACH Attaching)
          (instance ?D AnaerobicExerciseDevice)
          (patient ?ATTACH ?WP)
          (destination ?ATTACH ?D))))))

(instance TexturedGrip InternalAttribute)
(documentation TexturedGrip EnglishWrittenLanguage "The attribute of an &%Artifact to be at least somewhat textured so as to allow users to more easily grip it.")
(termFormat EnglishWrittenLanguage TexturedGrip "Textured Grip")

(=>
  (attribute ?OBJ TexturedGrip)
  (hasPurpose ?OBJ
    (exists (?GRAB ?PERSON)
      (and
        (instance ?GRAB Grabbing)
        (instance ?PERSON Human)
        (agent ?GRAB ?PERSON)
        (instrument ?GRAB ?OBJ)))))

(=>
  (attribute ?OBJ TexturedGrip)
  (attribute ?OBJ Rough))

(subclass Barbell FreeWeight)
(documentation Barbell EnglishWrittenLanguage "A &%FreeWeight that normally consists of a &%LongAndThin &%Rod to be lifted during various exercises. Weight plates are typically placed on its ends for increased resistance.")
(termFormat EnglishWrittenLanguage Barbell "Barbell")

(=>
  (instance ?BB Barbell)
  (exists (?R)
    (and
      (instance ?R Rod)
      (part ?R ?BB)
      (attribute ?BB LongAndThin)
      (attribute ?BB TexturedGrip)
      (attribute ?BB Rigid))))

(=>
  (instance ?BB Barbell)
  (hasPurpose ?BB
    (exists (?WL ?PERSON ?HAND1 ?HAND2)
      (and
        (instance ?WL Weightlifting)
        (instance ?PERSON Human)
        (instance ?HAND1 Hand)
        (instance ?HAND2 Hand)
        (part ?HAND1 ?PERSON)
        (part ?HAND2 ?PERSON)
        (not
          (equal ?HAND1 ?HAND2))
        (agent ?WL ?PERSON)
        (instrument ?WL ?HAND1)
        (instrument ?WL ?HAND2)
        (instrument ?WL ?BB)))))

(subclass Dumbbell FreeWeight)
(documentation Dumbbell EnglishWrittenLanguage "A &%FreeWeight that normally consists of a short &%Rod with weight at both ends and is typically intended to be held in one hand.")
(termFormat EnglishWrittenLanguage Dumbbell "Dumbbell")

(=>
  (instance ?DB Dumbbell)
  (exists (?R)
    (and
      (instance ?R Rod)
      (part ?R ?DB))))

(=>
  (instance ?DB Dumbbell)
  (hasPurpose ?DB
    (exists (?WL ?PERSON ?HAND)
      (and
        (instance ?WL Weightlifting)
        (instance ?PERSON Human)
        (instance ?HAND Hand)
        (part ?HAND ?PERSON)
        (agent ?WL ?PERSON)
        (instrument ?WL ?HAND)
        (instrument ?WL ?DB)
        (meetsSpatially ?HAND ?DB)
        (not
          (exists (?HAND2)
            (and
              (instance ?HAND2 Hand)
              (part ?HAND2 ?PERSON)
              (not
                (equal ?HAND ?HAND2))
              (meetsSpatially ?HAND2 ?DB))))))))

(subAttribute Hexagon Polygon)
(documentation Hexagon EnglishWrittenLanguage "Any six-sided &%Polygon")
(termFormat EnglishWrittenLanguage Hexagon "Hexagon")

(=>
  (attribute ?H Hexagon)
  (exists (?A ?B ?C ?D ?E ?F)
    (and
      (instance ?A ClosedLineSegment)
      (instance ?B ClosedLineSegment)
      (instance ?C ClosedLineSegment)
      (instance ?D ClosedLineSegment)
      (instance ?E ClosedLineSegment)
      (instance ?F ClosedLineSegment)
      (sideOfFigure ?A ?H)
      (sideOfFigure ?B ?H)
      (sideOfFigure ?C ?H)
      (sideOfFigure ?D ?H)
      (sideOfFigure ?E ?H)
      (sideOfFigure ?F ?H)
      (not
        (equal ?A ?B))
      (not
        (equal ?A ?C))
      (not
        (equal ?A ?D))
      (not
        (equal ?A ?E))
      (not
        (equal ?A ?F))
      (not
        (equal ?B ?C))
      (not
        (equal ?B ?D))
      (not
        (equal ?B ?E))
      (not
        (equal ?B ?F))
      (not
        (equal ?C ?D))
      (not
        (equal ?C ?E))
      (not
        (equal ?C ?F))
      (not
        (equal ?D ?E))
      (not
        (equal ?D ?F))
      (not
        (equal ?E ?F))
      (not
        (exists (?X)
          (and
            (instance ?X ClosedLineSegment)
            (sideOfFigure ?X ?H)
            (not
              (equal ?X ?A))
            (not
              (equal ?X ?B))
            (not
              (equal ?X ?C))
            (not
              (equal ?X ?D))
            (not
              (equal ?X ?E))
            (not
              (equal ?X ?F))))))))

(subAttribute RegularHexagon Hexagon)
(documentation RegularHexagon EnglishWrittenLanguage "Any &%Hexagon with equal length sides.")
(termFormat EnglishWrittenLanguage RegularHexagon "Regular Hexagon")

(=>
  (attribute ?RH RegularHexagon)
  (exists (?A ?B ?C ?D ?E ?F ?L)
    (and
      (instance ?A ClosedLineSegment)
      (instance ?B ClosedLineSegment)
      (instance ?C ClosedLineSegment)
      (instance ?D ClosedLineSegment)
      (instance ?E ClosedLineSegment)
      (instance ?F ClosedLineSegment)
      (sideOfFigure ?A ?RH)
      (sideOfFigure ?B ?RH)
      (sideOfFigure ?C ?RH)
      (sideOfFigure ?D ?RH)
      (sideOfFigure ?E ?RH)
      (sideOfFigure ?F ?RH)
      (lineMeasure ?A ?L)
      (lineMeasure ?B ?L)
      (lineMeasure ?C ?L)
      (lineMeasure ?D ?L)
      (lineMeasure ?E ?L)
      (lineMeasure ?F ?L))))

(subAttribute IrregularHexagon Hexagon)
(documentation IrregularHexagon EnglishWrittenLanguage "Any &%Hexagon where not all sides are of equal length.")
(termFormat EnglishWrittenLanguage IrregularHexagon "Irregular Hexagon")

(=>
  (attribute ?IH IrregularHexagon)
  (exists (?A ?B ?L1 ?L2)
    (and
      (instance ?A ClosedLineSegment)
      (instance ?B ClosedLineSegment)
      (sideOfFigure ?A ?IH)
      (sideOfFigure ?B ?IH)
      (not
        (equal ?A ?B))
      (lineMeasure ?A ?L1)
      (lineMeasure ?B ?L2)
      (not
        (equal ?L1 ?L2)))))

(subclass HexBarbell Barbell)
(documentation HexBarbell EnglishWrittenLanguage "A large &%Barbell with a hollow hex-shape around its center. They are typically used in deadlifts and similar exercises.")
(termFormat EnglishWrittenLanguage HexBarbell "Hex Barbell")

(=>
  (instance ?HBB HexBarbell)
  (exists (?HR ?H)
    (and
      (instance ?HR HoleRegion)
      (attribute ?H Hexagon)
      (hole ?HR ?HBB)
      (shape ?HR ?H))))

(instance curveReversalCount BinaryPredicate)
(instance curveReversalCount SingleValuedRelation)
(domain curveReversalCount 1 Entity)
(domain curveReversalCount 2 NonnegativeInteger)
(documentation curveReversalCount EnglishWrittenLanguage "The number of points on an entity in which its curvature reverses direction.")
(termFormat EnglishWrittenLanguage curveReversalCount "curve reversal count")

(=>
  (and
    (curveReversalCount ?OBJ ?N)
    (greaterThan ?N 1))
  (shape ?OBJ Wavy))

(=>
  (and
    (curveReversalCount ?OBJ ?N)
    (greaterThan ?N 0))
  (exists (?L1 ?L2 ?L3 ?PLANE)
    (and
      (instance ?L1 FiniteLineInSpace)
      (instance ?L2 FiniteLineInSpace)
      (instance ?L3 FiniteLineInSpace)
      (instance ?PLANE PlaneInSpace)
      (part ?L1 ?OBJ)
      (part ?L2 ?OBJ)
      (part ?L3 ?OBJ)
      (part ?L1 ?PLANE)
      (part ?L2 ?PLANE)
      (part ?L3 ?PLANE)
      (meetsSpatially ?L1 ?L2)
      (meetsSpatially ?L2 ?L3)
      (or
        (and
          (orientation ?L2 ?L1 Left)
          (orientation ?L3 ?L2 Right))
        (and
          (orientation ?L2 ?L1 Right)
          (orientation ?L3 ?L2 Left))))))

(instance Wavy ShapeAttribute)

(documentation Wavy EnglishWrittenLanguage "A &%ShapeAttribute describing an entity whose &%curvatureReversalCount is greater than 1.")
(termFormat EnglishWrittenLanguage Wavy "Wavy")

(=>
  (shape ?OBJ Wavy)
  (exists (?N)
    (and
      (curveReversalCount ?OBJ ?N)
      (greaterThan ?N 1))))

(instance pronationProportion BinaryPredicate)
(instance pronationProportion SingleValuedRelation)
(domain pronationProportion 1 BodySegment)
(domain pronationProportion 2 RealNumber)
(documentation pronationProportion EnglishWrittenLanguage "A measure of the pronation of a &%BodySegment, where 0 represents a neutral position, 1 represents complete pronation, and -1 represents complete supination.")
(termFormat EnglishWrittenLanguage pronationProportion "pronation proportion")

(=>
  (pronationProportion ?F ?N)
  (and
    (greaterThanOrEqualTo ?N -1)
    (lessThanOrEqualTo ?N 1)))

(instance PartiallyPronated PositionalAttribute)
(documentation PartiallyPronated EnglishWrittenLanguage "The position of a &%BodySegment whose &%pronationProportion is greater than 0 but less than 1.")
(termFormat EnglishWrittenLanguage PartiallyPronated "Partially Pronated")
(=>
  (attribute ?B PartiallyPronated)
  (and
    (instance ?B BodySegment)
    (exists (?N)
      (and
        (pronationProportion ?B ?N)
        (greaterThan ?N 0)
        (lessThan ?N 1)))))

(subclass EZBarbell Barbell)
(documentation EZBarbell EnglishWrittenLanguage "A medium-sized &%Barbell with a &%Wavy shape intended to allow the user's forearms to remain partially pronated during exercises such as a &%BicepCurl.")
(termFormat EnglishWrittenLanguage EZBarbell "EZ Barbell")

(=>
  (instance ?EZ EZBarbell)
  (shape ?EZ Wavy))
(=>
  (instance ?EZ EZBarbell)
  (hasPurpose ?EZ
    (exists (?BC ?PERSON ?F1 ?F2)
      (and
        (instance ?BC BicepCurl)
        (instance ?PERSON Human)
        (instance ?F1 Forearm)
        (instance ?F2 Forearm)
        (not
          (equal ?F1 ?F2))
        (part ?F1 ?PERSON)
        (part ?F2 ?PERSON)
        (agent ?BC ?PERSON)
        (instrument ?BC ?EZ)
        (holdsDuring
          (WhenFn ?BC)
          (attribute ?F1 PartiallyPronated))
        (holdsDuring
          (WhenFn ?BC)
          (attribute ?F2 PartiallyPronated))))))

(subclass Kettlebell FreeWeight)
(documentation Kettlebell EnglishWrittenLanguage "A &%FreeWeight made of metal that consists of a spherical central mass and a &%Handle along the top to allow the device to be easily picked up.")
(termFormat EnglishWrittenLanguage Kettlebell "Kettlebell")

(=>
  (instance ?KB Kettlebell)
  (exists (?H ?SP)
    (and
      (instance ?H Handle)
      (instance ?SP Artifact)
      (shape ?SP Sphere)
      (component ?H ?KB)
      (component ?SP ?KB))))

(subclass FlyMachine CableMachine)
(documentation FlyMachine EnglishWrittenLanguage "A &%CableMachine having a seat and two movable arms or handles that a user pushes together or pulls apart to perform pectoral fly or rear-delt fly exercises.")
(termFormat EnglishWrittenLanguage FlyMachine "Fly Machine")

(=>
  (instance ?FM FlyMachine)
  (hasPurpose ?FM
    (exists (?PULLORPUSH ?PERSON ?S ?H1 ?H2 ?HA1 ?HA2)
      (and
        (instance ?S Seat)
        (or
          (instance ?PULLORPUSH Pulling)
          (instance ?PULLORPUSH Pushing))
        (instance ?PERSON Human)
        (instance ?H1 Hand)
        (instance ?H2 Hand)
        (instance ?HA1 Handle)
        (instance ?HA2 Handle)
        (not
          (equal ?H1 ?H2))
        (not
          (equal ?HA1 ?HA2))
        (part ?H1 ?PERSON)
        (part ?H2 ?PERSON)
        (component ?HA1 ?FM)
        (component ?HA2 ?FM)
        (component ?S ?FM)
        (attribute ?PERSON Sitting)
        (orientation ?PERSON ?S On)
        (orientation ?HA1 ?S Above)
        (orientation ?HA2 ?S Above)
