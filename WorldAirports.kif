(subclass IslandChain CollectionOfObjects)
(documentation IslandChain EnglishWrittenLanguage "A &%CollectionOfObjects of &%Islands that
are part of the same &%Nation and are grouped either or both by their nationality and their
relative proximity.")
(termFormat EnglishWrittenLanguage IslandChain "island chain")

(=>
  (instance ?IC IslandChain)
  (memberType ?IC Island))

