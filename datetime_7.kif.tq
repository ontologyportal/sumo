;March still has 31 days in a leap year
(note DateTime_march_in_leap_year)
(category general)
(time 10)

(instance CalendarMarchTestYear Integer)
(equal (RemainderFn CalendarMarchTestYear 4) 0)
(not (equal (RemainderFn CalendarMarchTestYear 100) 0))

(query (daysInMonth 3 CalendarMarchTestYear 31))
(answer yes)