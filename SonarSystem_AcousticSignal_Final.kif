; ====================================================================
; Sonar System and Underwater Acoustic Signal Ontology
; ====================================================================

; =====================================================================
; PASSIVE SONAR CLASS DEFINITION 
; =====================================================================

(subclass PassiveSonar Sonar)
(documentation
  PassiveSonar
  EnglishWrittenLanguage
  "A PassiveSonar does not transmit any &%UnderwaterAcousticSignal.")
(termFormat EnglishWrittenLanguage PassiveSonar "passive sonar")

; not able to radiating sound
(=>
  (instance ?PASSONAR PassiveSonar)
  (unable RadiatingSound origin ?PASSONAR))

; able to sense an underwater acoustic signal
(=>
  (instance ?PASSONAR PassiveSonar)
  (capability Discovering instrument ?PASSONAR))

(disjoint ActiveSonar PassiveSonar)

; =====================================================================
; ACTIVE SONAR CLASS DEFINITION ;
; =====================================================================

(subclass ActiveSonar Sonar)
(documentation
  ActiveSonar
  EnglishWrittenLanguage
  "An active sonar emits sound waves(pings) into the water.
  The pulse reflects off objects and is recorded by a Sonar System 
  Receiver.")
(termFormat EnglishWrittenLanguage ActiveSonar "active sonar")

; able to radiating sound
(=>
  (instance ?ACTSONAR ActiveSonar)
  (capability RadiatingSound origin ?ACTSONAR))

; able to sense an underwater acoustic signal
(=>
  (instance ?ACTSONAR ActiveSonar)
  (capability Discovering instrument ?ACTSONAR))

; ;
; =====================================================================
; ; UNDERWATER ACOUSTIC SIGNAL CLASS DEFINITION ;
; =====================================================================

(subclass UnderwaterAcousticSignal RadiatingSound)
(documentation
  UnderwaterAcousticSignal
  EnglishWrittenLanguage
  "An UnderwaterAcousticSignal is a RadiatingSound that propagates through
  an underwater acoustic medium and may be received, detected, or 
  processed by a sonar system. In this domain model, a fully described
  UnderwaterAcousticSignal may be associated with metadata describing its
  frequencies, temporal, geometric, source-classification, and environmental
  context, including frequency, bandwidth, amplitude, timestamp, duration,
  bearing, range distance, depth, temperature, salinity, and the sound speed 
  profile of the propagation medium.")
(termFormat
  EnglishWrittenLanguage
  UnderwaterAcousticSignal
  "underwater acoustic signal")

; ; Every UnderwaterAcousticSignal is located in some UnderwaterRegion.

(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?REGION)
    (and
      (instance ?REGION UnderwaterRegion) 
      (located ?SIG ?REGION))))

; Every region in which the signal is located is an UnderwaterRegion.
(=>
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (located ?SIG ?REGION))
  (instance ?REGION UnderwaterRegion))


; Every UnderwaterAcousticSignal has a frequency measure.
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?F)
    (and
      (instance ?F RealNumber)
      (signalFrequency
        ?SIG
        (MeasureFn ?F Hertz)))))

; ; Every UnderwaterAcousticSignal has a bandwidth measure.
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?B)
    (and
      (instance ?B RealNumber)
      (signalBandwidth
        ?SIG
        (MeasureFn ?B Hertz)))))

; ; Every UnderwaterAcousticSignal has a period measured in seconds.

(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?PERIOD)
    (and
      (instance ?PERIOD PhysicalQuantity)
      (period ?SIG ?PERIOD))))

; ; Every UnderwaterAcousticSignal has a time duration in seconds.

(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?DUR)
    (and
      (instance ?DUR TimeDuration)
      (signalDuration ?SIG ?DUR))))

; ; Every UnderwaterAcousticSignal has a lower frequency measured in
; Hertz.

(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?FL)
    (and
      (instance ?FL PhysicalQuantity)
      (lowerFrequency ?SIG ?FL))))

; ; Every UnderwaterAcousticSignal has an upper frequency measured in
; Hertz.

(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?FU)
    (and
      (instance ?FU PhysicalQuantity)
      (upperFrequency ?SIG ?FU))))

; ; Every UnderwaterAcousticSignal has a central frequency-related
; measure.

(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?CFREQ)
    (and
      (instance ?CFREQ PhysicalQuantity)
      (centerFrequency ?SIG ?CFREQ))))

; Timestamp associated to the time position at which the signal
; observation begins or is recorded.

(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?TIMESTAMP)
    (and
      (instance ?TIMESTAMP TimePoint)
      (timestamp ?SIG ?TIMESTAMP))))

; Every UnderwaterAcousticSignal underwater acoustic signal has an
; associated pressure level
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?SPL)
    (and
      (instance ?SPL PhysicalQuantity)
      (soundPressureLevel ?SIG ?SPL))))


; An UnderwaterAcousticSignal source has a source class confidence 
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?CONF)
    (and
      (instance ?CONF RealNumber)
      (sourceClassConfidence ?SIG ?CONF))))

; ;
; =====================================================================
; ; UnderwaterAcousticSignal environment characterization ;
; =====================================================================
; bearing
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?BEARING)
    (and
      (instance ?BEARING PhysicalQuantity)
      (bearing ?SIG ?BEARING))))

; range distance
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?RANGE)
    (and
      (instance ?RANGE PhysicalQuantity)
      (rangeDistance ?SIG ?RANGE))))

; depth
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?DEPTH)
    (and
      (instance ?DEPTH PhysicalQuantity)
      (signalDepth ?SIG ?DEPTH))))

; water temperature
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?TEMP)
    (and
      (instance ?TEMP PhysicalQuantity)
      (waterTemperature ?SIG ?TEMP))))

; water salinity
(=>
  (instance ?SIG UnderwaterAcousticSignal)
  (exists (?SAL ?REGION)
    (and
      (instance ?SAL PhysicalQuantity)
      (instance ?REGION UnderwaterRegion)
      (located ?SIG ?REGION)
      (waterSalinity ?SIG ?REGION ?SAL))))

; =============================================================================
; SONAR ECHO
; =============================================================================
(subclass SonarEcho UnderwaterAcousticSignal)
(documentation
  SonarEcho
  EnglishWrittenLanguage
  "A SonarEcho is an UnderwaterAcousticSignal corresponding to reflected or
  scattered acoustic energy received after interaction with an object,
  boundary, or medium discontinuity.")
(termFormat EnglishWrittenLanguage SonarEcho "sonar echo")

; =============================================================================
; SIGNAL DETECTION- SONAR RECEIVER
; =============================================================================

; ; An UnderwaterAcousticSignal is detected by a SonarReceiver.

(instance detectedByReceiver BinaryPredicate)
(domain detectedByReceiver 1 UnderwaterAcousticSignal)
(domain detectedByReceiver 2 SonarReceiver)
(documentation
  detectedByReceiver
  EnglishWrittenLanguage
  "detectedByReceiver relates an &%UnderwaterAcousticSignal to the &%SonarReceiver 
  that detected, received, or processed it.")
(termFormat
  EnglishWrittenLanguage
  detectedByReceiver
  "The signal %1 is detected by %2")

(=>
  (detectedByReceiver ?SIG ?SR)
  (exists (?DISC)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?SR SonarReceiver)
      (instance ?DISC Discovering)
      (instrument ?DISC ?SR)
      (patient ?DISC ?SIG))))

; =============================================================================
; ;; SONAR RECEIVER

; =============================================================================
(subclass SonarReceiver Device)
(documentation
  SonarReceiver
  EnglishWrittenLanguage
  "A SonarReceiver is a &%Device that receives or detects 
  &%UnderwaterAcousticSignal. It has a sensor-type attribute and sampling rate.")
(termFormat EnglishWrittenLanguage SonarReceiver "sonar receiver")

; ; A SonarReceiver has at least one acoustic sensor.

(=>
  (instance ?SR SonarReceiver)
  (exists (?SENS)
    (and
      (instance ?SENS AcousticSensor)
      (part ?SENS ?SR))))

; ; A SonarReceiver has a sensor(s) deployment geometry type.

(=>
  (instance ?SR SonarReceiver)
  (or
    (attribute ?SR HullMountedDeployment)
    (attribute ?SR TowedArrayDeployment)
    (attribute ?SR VariableDepthDeployment)
    (attribute ?SR SonobuoyDeployment)))

; ; A SonarReceiver has a sample rate measured in Hertz.

(=>
  (instance ?SR SonarReceiver)
  (exists (?FS)
    (and
      (instance ?FS PositiveRealNumber)
      (sampleRate
        ?SR
        (MeasureFn ?FS Hertz)))))

; ; A SonarReceiver has the purpose of being the agent of discovering
; underwater acoustic signals.
(=>
  (instance ?SR SonarReceiver)
  (hasPurpose
    ?SR
    (exists (?DISC ?SIG)
      (and
        (instance ?DISC Discovering)
        (instance ?SIG UnderwaterAcousticSignal)
        (instrument ?DISC ?SR)
        (patient ?DISC ?SIG)))))

; ; A SonarReceiver has sampling rate.
(=>
  (instance ?SR SonarReceiver)
  (exists (?SAMPLE)
    (and
      (instance ?SAMPLE PhysicalQuantity)
      (sampleRate ?SR ?SAMPLE))))

; =============================================================================
; ; SONAR RECEIVER RELATIONS
; =============================================================================

; ; sampleRate

(instance sampleRate BinaryPredicate)
(domain sampleRate 1 SonarReceiver)
(domain sampleRate 2 PhysicalQuantity)
(documentation
  sampleRate
  EnglishWrittenLanguage
  "sampleRate relates a SonarReceiver to its sampling frequency,
  expressed as a quantity in Hertz.")
(termFormat
  EnglishWrittenLanguage
  sampleRate
  "The sonar receiver %1 has sample rate equals %2 ")

(=>
  (sampleRate ?SR ?FS)
  (exists (?N)
    (and
      (instance ?SR SonarReceiver)
      (instance ?N RealNumber)
      (instance ?FS PhysicalQuantity)
      (equal
        ?FS
        (MeasureFn ?N Hertz)))))

; ; The sample rate should be at least twice the upper frequency of the
; ; detected signal (Nyquist axiom)

(=>
  (and
    (instance ?SR SonarReceiver)
    (sampleRate
      ?SR
      (MeasureFn ?FS Hertz))
    (instance ?SIG UnderwaterAcousticSignal)
    (detectedByReceiver ?SIG ?SR)
    (upperFrequency
      ?SIG
      (MeasureFn ?FU Hertz)))
  (and
    (instance ?FS RealNumber)
    (instance ?FU RealNumber)
    (greaterThanOrEqualTo
      ?FS
      (MultiplicationFn 2 ?FU))))

; =================================================================== 
; ACOUSTIC SENSOR CLASSES
; ===================================================================

(subclass AcousticSensor Sensor)
(documentation
  AcousticSensor
  EnglishWrittenLanguage
  "An AcousticSensor is a &%Sensor that detects, measures, or samples
  acoustic energy propagating through a medium. In underwater acoustics,
  an AcousticSensor is typically used by a &%SonarReceiver to observe
  &%UnderwaterAcousticSignal instances. Acoustic sensors may measure
  acoustic pressure, particle motion, or both.")
(termFormat EnglishWrittenLanguage AcousticSensor "acoustic sensor type")

; Capability of being an instrument of Discovering)
(=>
  (instance ?SENS AcousticSensor)
  (capability Discovering instrument ?SENS))

; AcousticSensor may sense an underwater acoustic signals
(=>
  (instance ?SENS AcousticSensor)
  (modalAttribute
    (exists (?DISC ?SIG)
      (and
        (instance ?SIG UnderwaterAcousticSignal)
        (instance ?DISC Discovering)
        (patient ?DISC ?SIG)
        (instrument ?DISC ?SENS)))
    Possibility))

; AcousticSensor measures either pressure or particle motion (or both)
(=>
  (instance ?AS AcousticSensor)
  (modalAttribute
    (exists (?P ?S ?Q ?DISC ?SIG)
      (and
        (instance ?Q PhysicalQuantity)
        (instance ?P RealNumber)
        (instance ?S RealNumber)
        (instance ?SIG UnderwaterAcousticSignal)
        (or
          (equal
            ?Q
            (MeasureFn ?P Decibel))
          (equal
            ?Q
            (SpeedFn
              (MeasureFn ?S Meter)
              (MeasureFn 1 SecondDuration))))
        (instance ?DISC Discovering)
        (instrument ?DISC ?AS)
        (patient ?DISC ?SIG)
        (measure ?SIG ?Q)))
    Possibility))

; Hydrophones

(subclass Hydrophone AcousticSensor)
(documentation
  Hydrophone
  EnglishWrittenLanguage
  "Hydrophone is an &%AcousticSensor that converts variations in
  acoustic pressure into electrical signals. Hydrophones are the most
  common sensing elements used in underwater passive and active sonar
  systems and measure the scalar pressure component of an acoustic field.")
(termFormat EnglishWrittenLanguage Hydrophone "hydrophone")

(=>
  (instance ?HYD Hydrophone)
  (capability Measuring instrument ?HYD))

; ; Hydrophone measures acoustic pressure (scalar)
(=>
  (instance ?H Hydrophone)
  (modalAttribute
    (exists (?PRESSURE ?DISC ?SIG ?P)
      (and
        (instance ?PRESSURE PhysicalQuantity)
        (instance ?P RealNumber)
        (instance ?SIG UnderwaterAcousticSignal)
        (instance ?DISC Discovering)
        (equal
          ?PRESSURE
          (MeasureFn ?P Decibel))
        (instrument ?DISC ?H)
        (patient ?DISC ?SIG)
        (measure ?SIG ?PRESSURE)))
    Possibility))

; ; Hydrophone converts acoustic pressure variations into electrical
; signals
(=>
  (instance ?H Hydrophone)
  (modalAttribute
    (exists (?CONV ?PRESSURE ?ELECTRICAL ?P ?E)
      (and
        (instance ?CONV Process)
        (agent ?CONV ?H)
        (instance ?P RealNumber)
        (instance ?E RealNumber)
        (instance ?PRESSURE PhysicalQuantity)
        (instance ?ELECTRICAL PhysicalQuantity)
        (equal
          ?PRESSURE
          (MeasureFn ?P Decibel))
        (equal
          ?ELECTRICAL
          (MeasureFn ?E Voltage))
        (patient ?CONV ?PRESSURE)
        (result ?CONV ?ELECTRICAL)))
    Possibility))

(subclass VectorSensor AcousticSensor)
(documentation
  VectorSensor
  EnglishWrittenLanguage
  "A VectorSensor is an &%AcousticSensor that measures acoustic pressure
  and one or more components of particle motion, such as particle velocity
  or particle acceleration. Vector sensors provide directional information
  about an acoustic field and may improve source localization compared to
  pressure-only sensors.")
(termFormat EnglishWrittenLanguage VectorSensor "vector sensor sonar type")

; ; VectorSensor measures both acoustic pressure and particle motion
(=>
  (instance ?VS VectorSensor)
  (modalAttribute
    (exists (?P ?PRESSURE ?DISC ?SIG)
      (and
        (instance ?PRESSURE PhysicalQuantity)
        (instance ?SIG UnderwaterAcousticSignal)
        (instance ?P RealNumber)
        (equal
          ?PRESSURE
          (MeasureFn ?P Decibel))
        (instance ?DISC Discovering)
        (instrument ?DISC ?VS)
        (patient ?DISC ?SIG)
        (measure ?SIG ?PRESSURE)))
    Possibility))

(=>
  (instance ?VS VectorSensor)
  (modalAttribute
    (exists (?SPEED ?S ?DISC ?SIG)
      (and
        (instance ?SPEED PhysicalQuantity)
        (instance ?S RealNumber)
        (instance ?SIG UnderwaterAcousticSignal)
        (equal
          ?SPEED
          (SpeedFn
            (MeasureFn ?S Meter)
            (MeasureFn 1 SecondDuration)))
        (instance ?DISC Discovering)
        (instrument ?DISC ?VS)
        (patient ?DISC ?SIG)
        (measure ?SIG ?SPEED)))
    Possibility))

; =============================================================================
; SENSOR DEPLOYMENT GEOMETRY TYPES
; =============================================================================

(subclass SensorDeploymentType RelationalAttribute)
(documentation
  SensorDeploymentType
  EnglishWrittenLanguage
  "SensorDeploymentType identifies the deployment geometry.")
(termFormat
  EnglishWrittenLanguage
  SensorDeploymentType
  "sensor deployment type")

(instance HullMountedDeployment SensorDeploymentType)
(documentation
  HullMountedDeployment
  EnglishWrittenLanguage
  "A HullMountedDeployment attribute identifies that the sensor is mounted in 
  the ship's hull.")
(termFormat
  EnglishWrittenLanguage
  HullMountedDeployment
  "hull mounted deployment")

(instance TowedArrayDeployment SensorDeploymentType)
(documentation
  TowedArrayDeployment
  EnglishWrittenLanguage
  "A TowedArrayDeployment attribute identifies that the sensors are
  a collection of hydrophones or vector sensors arranged in a long array towed 
  behind a vessel.")
(termFormat
  EnglishWrittenLanguage
  TowedArrayDeployment
  "towed array deployment")

(instance VariableDepthDeployment SensorDeploymentType)
(documentation
  VariableDepthDeployment
  EnglishWrittenLanguage
  "A VariableDepthDeployment attribute identifies that the sensors are
  arranged in a depth control style.")
(termFormat
  EnglishWrittenLanguage
  VariableDepthDeployment
  "variable depth Deployment")

(instance SonobuoyDeployment SensorDeploymentType)
(documentation
  SonobuoyDeployment
  EnglishWrittenLanguage
  "A SonobuoyDeploymentType attribute identifies that the sensors are
  arranged in a sonobuoy platform.")
(termFormat EnglishWrittenLanguage SonobuoyDeployment "sonobuoy deployment")

; =============================================================================
; UNDERWATER ACOUSTIC SIGNALS CLASSES
; =============================================================================


; Biological Underwater Acoustic signal

(subclass BiologicalUnderwaterAcousticSignal UnderwaterAcousticSignal)
(documentation
  BiologicalUnderwaterAcousticSignal
  EnglishWrittenLanguage
  "A BiologicalUnderwaterAcousticSignal is UnderwaterAcousticSignal interpreted
  as originating from biological sources. Examples of such sources include
  marine mammals, fish, and invertebrates.")
(termFormat
  EnglishWrittenLanguage
  BiologicalUnderwaterAcousticSignal
  "Biological Underwater Acoustic Signal")
(=>
  (instance ?SIG BiologicalUnderwaterAcousticSignal)
  (exists (?S)
    (and
      (instance ?S OrganicObject)
      (origin ?SIG ?S))))

; Mechanical Underwater Acoustic Signal

(subclass MechanicalUnderwaterAcousticSignal UnderwaterAcousticSignal)
(documentation
  MechanicalUnderwaterAcousticSignal
  EnglishWrittenLanguage
  "A MechanicalUnderwaterAcousticSignal is a UnderwaterAcousticSignal interpreted
  as originating from mechanical sources. Examples of mechanical sources
  include commercial ships, sonar systems, offshore construction and industry 
  and underwater vehicles")
(termFormat
  EnglishWrittenLanguage
  MechanicalUnderwaterAcousticSignal
  "Mechanical Underwater Acoustic Signal")

(=>
  (instance ?SIG MechanicalUnderwaterAcousticSignal)
  (exists (?S)
    (and
      (instance ?S Source)
      (attribute ?S MechanicalProductAttribute)
      (origin ?SIG ?S))))

; Environmental Underwater Acoustic Signal
(subclass EnvironmentalUnderwaterAcousticSignal UnderwaterAcousticSignal)
(documentation
  EnvironmentalUnderwaterAcousticSignal
  EnglishWrittenLanguage
  "An EnvironmentalUnderwaterAcousticSignal is a UnderwaterAcousticSignal interpreted
  as originating from environmental or natural non-biological processes.
  Examples include waves and surface activity, seismic and geological activities
  and ice processes.")
(termFormat
  EnglishWrittenLanguage
  EnvironmentalUnderwaterAcousticSignal
  "Environmental Underwater Acoustic Signal")

(=>
 (instance ?SIG EnvironmentalUnderwaterAcousticSignal)
 (exists (?NP)
    (and
      (instance ?NP NaturalProcess)
      (origin ?SIG ?NP))))


; Unknown Underwater Acoustic Signal
(subclass UnknownUnderwaterAcousticSignal UnderwaterAcousticSignal)
(documentation
  UnknownUnderwaterAcousticSignal
  EnglishWrittenLanguage
  "An UnknownUnderwaterAcousticSignal is a type of UnderwaterAcousticSignal used when the available evidence
  does not support assigning the signal to any known source. It is not confidently identified.")
(termFormat
  EnglishWrittenLanguage
  UnknownUnderwaterAcousticSignal
  "Unknown Underwater Acoustic Signal")

(=>
  (instance ?SIG UnknownUnderwaterAcousticSignal)
  (exists (?CONF)
    (and
      (instance ?CONF RealNumber)
      (sourceClassConfidence ?SIG ?CONF)
      (lessThan ?CONF 0.5))))

; =============================================================================
; SOURCE CLASS CONFIDENCE
; =============================================================================

(instance sourceClassConfidence BinaryPredicate)
(domain sourceClassConfidence 1 UnderwaterAcousticSignal)
(domain sourceClassConfidence 2 RealNumber)

(documentation
  sourceClassConfidence
  EnglishWrittenLanguage
  "sourceClassConfidence means that a confidence score is assigned to the 
  given  &%UnderwaterAcousticSignal is a real number  between 0 and 1.")
(termFormat
  EnglishWrittenLanguage
  sourceClassConfidence
  "source classification confidence")

(=>
  (sourceClassConfidence ?SIG ?CONF)
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (instance ?CONF RealNumber)
    (greaterThanOrEqualTo ?CONF 0)
    (lessThanOrEqualTo ?CONF 1)))

; =============================================================================
; ACOUSTIC SIGNAL RELATIONS
; =============================================================================

; frequency

(instance signalFrequency BinaryPredicate)
(domain signalFrequency 1 UnderwaterAcousticSignal)
(domain signalFrequency 2 PhysicalQuantity)

(documentation
  signalFrequency
  EnglishWrittenLanguage
  "signalFrequency relates an UnderwaterAcousticSignal to a representative
  frequency expressed as a MeasureFn quantity, normally in Hertz. For a
  band-limited signal, this representative frequency may be the center
  frequency.")
(termFormat
  EnglishWrittenLanguage
  signalFrequency
  "The signalFrequency of signal %1 is %2")

; frequency holds while signal exists
(=>
  (signalFrequency ?SIG ?FREQ)
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (instance ?FREQ PhysicalQuantity)
    (holdsDuring
        (WhenFn ?SIG)
        (measure ?SIG ?FREQ))))

; frequency is measured in Hertz
(=>
  (signalFrequency ?SIG ?FREQ)
  (exists (?F)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?F RealNumber)
      (instance ?FREQ PhysicalQuantity)
      (equal
        ?FREQ
        (MeasureFn ?F Hertz)))))

; frequency is positive
(=>
  (signalFrequency ?SIG (MeasureFn ?F Hertz))
  (greaterThan ?F 0))

; period

(instance period BinaryPredicate)
(domain period 1 UnderwaterAcousticSignal)
(domain period 2 PhysicalQuantity )

(documentation
  period
  EnglishWrittenLanguage
  "period relates an UnderwaterAcousticSignal to the duration of one
  complete cycle of its representative wave. Period is the inverse of
  frequency. Mathematical axiom: If frequency is f and period is T, 
  then f * T = 1.")
(termFormat EnglishWrittenLanguage period "The period of signal %1 is %2")


; period holds while signal exists
(=>
  (period ?SIG ?PERIOD)
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (instance ?PERIOD PhysicalQuantity)
    (holdsDuring
      (WhenFn ?SIG)
      (measure ?SIG ?PERIOD))))

; Period is measured in seconds 
(=>
  (period ?SIG ?PERIOD)
  (exists (?T)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?PERIOD PhysicalQuantity)
      (instance ?T RealNumber)
      (equal
        ?PERIOD
        (MeasureFn ?T SecondDuration)))))

; period is positive
(=>
  (period ?SIG (MeasureFn ?T SecondDuration))
  (greaterThan ?T 0))

; period is the inverse of frequency
(=>
  (and
    (signalFrequency
      ?SIG
      (MeasureFn ?F Hertz))
    (period
      ?SIG
      (MeasureFn ?T SecondDuration)))
  (equal ?T (DivisionFn 1 ?F)))

; lowerFrequency
(instance lowerFrequency BinaryPredicate)
(domain lowerFrequency 1 UnderwaterAcousticSignal)
(domain lowerFrequency 2 PhysicalQuantity)

(documentation
  lowerFrequency
  EnglishWrittenLanguage
  "lowerFrequency relates an UnderwaterAcousticSignal to the lower
  frequency bound of its occupied spectral band.")
(termFormat
  EnglishWrittenLanguage
  lowerFrequency
  "The lower frequency of signal %1 is %2")

(=>
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (lowerFrequency
      ?SIG
      (MeasureFn ?FL Hertz))
    (upperFrequency
      ?SIG
      (MeasureFn ?FU Hertz)))
  (lessThanOrEqualTo ?FL ?FU))

; upperFrequency

(instance upperFrequency BinaryPredicate)
(domain upperFrequency 1 UnderwaterAcousticSignal)
(domain upperFrequency 2 PhysicalQuantity)

(documentation
  upperFrequency
  EnglishWrittenLanguage
  "upperFrequency relates an UnderwaterAcousticSignal to the upper
  frequency bound of its occupied spectral band.")
(termFormat
  EnglishWrittenLanguage
  upperFrequency
  "The upper frequency of signal %1 is %2")

(=>
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (lowerFrequency
      ?SIG
      (MeasureFn ?FL Hertz))
    (upperFrequency
      ?SIG
      (MeasureFn ?FU Hertz)))
  (greaterThanOrEqualTo ?FU ?FL))

; centerFrequency

(instance centerFrequency BinaryPredicate)
(domain centerFrequency 1 UnderwaterAcousticSignal)
(domain centerFrequency 2 PhysicalQuantity)

(documentation
  centerFrequency
  EnglishWrittenLanguage
  "centerFrequency relates an UnderwaterAcousticSignal to the midpoint
  of its occupied frequency band. Mathematically, center frequency is
 (lower frequency + upper frequency) / 2.")
(termFormat
  EnglishWrittenLanguage
  centerFrequency
  "The center frequency of signal %1 is %2")

(=>
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (centerFrequency
      ?SIG
      (MeasureFn ?FC Hertz))
    (lowerFrequency
      ?SIG
      (MeasureFn ?FL Hertz))
    (upperFrequency
      ?SIG
      (MeasureFn ?FU Hertz)))
  (equal
    ?FC
    (DivisionFn
      (AdditionFn ?FL ?FU)
      2)))

; bandwidth

(instance signalBandwidth BinaryPredicate)
(domain signalBandwidth 1 UnderwaterAcousticSignal)
(domain signalBandwidth 2 PhysicalQuantity)

(documentation
  signalBandwidth
  EnglishWrittenLanguage
  "signalBandwidth relates an UnderwaterAcousticSignal to the width of its
  occupied frequency band. Mathematically, bandwidth is upper frequency
  minus lower frequency.")
(termFormat
  EnglishWrittenLanguage
  signalBandwidth
  "The signalBandwidth of signal %1 is %2")

(=>
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (signalBandwidth
      ?SIG
      (MeasureFn ?B Hertz))
    (lowerFrequency
      ?SIG
      (MeasureFn ?FL Hertz))
    (upperFrequency
      ?SIG
      (MeasureFn ?FU Hertz)))
  (equal
    ?B
    (SubtractionFn ?FU ?FL)))

; timestamp
(instance timestamp BinaryPredicate)
(domain timestamp 1 UnderwaterAcousticSignal)
(domain timestamp 2 TimePoint)
(documentation
  timestamp
  EnglishWrittenLanguage
  "a timestamp is associated to an UnderwaterAcousticSignal to the time 
  position at which the signal observation begins or is recorded.")
(termFormat EnglishWrittenLanguage timestamp "The timestamp of %1 is %2")

(=>
  (timestamp ?SIG ?TIMESTAMP)
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (instance ?TIMESTAMP TimePoint)
    (equal
      ?TIMESTAMP
      (BeginFn
        (WhenFn ?SIG)))))

; amplitude

(instance amplitude BinaryPredicate)
(domain amplitude 1 UnderwaterAcousticSignal)
(domain amplitude 2 PhysicalQuantity)
(documentation
  amplitude
  EnglishWrittenLanguage
  "amplitude relates an UnderwaterAcousticSignal to a magnitude measure
  of the acoustic waveform. The unit depends on the modeling convention,
  for example pressure amplitude or normalized amplitude.")
(termFormat EnglishWrittenLanguage amplitude "The amplitude of %1 is %2")

(=>
  (amplitude ?SIG ?AMP)
  (exists (?A ?UNIT)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?AMP PhysicalQuantity)
      (instance ?A RealNumber)
      (instance ?UNIT UnitOfMeasure)
      (equal
        ?AMP
        (MeasureFn ?A ?UNIT))
      (greaterThanOrEqualTo ?A 0)
      (holdsDuring
        (WhenFn ?SIG)
        (measure ?SIG ?AMP)))))

; signal duration
(instance signalDuration BinaryPredicate)
(domain signalDuration 1 UnderwaterAcousticSignal)
(domain signalDuration 2 TimeDuration)
(documentation
  signalDuration
  EnglishWrittenLanguage
  "signalDuratione relates an &%UnderwaterAcousticSignal to a TimeDuration 
  representing its duration.")
(termFormat
  EnglishWrittenLanguage
  signalDuration
  "The duration of signal %1 is %2")

(=>
  (signalDuration ?SIG ?T)
  (and
    (instance ?SIG UnderwaterAcousticSignal)
    (instance ?T TimeDuration)
    (equal
      ?T
      (WhenFn ?SIG))))

; sound pressure level measured

(instance soundPressureLevel BinaryPredicate)
(domain soundPressureLevel 1 UnderwaterAcousticSignal)
(domain soundPressureLevel 2 PhysicalQuantity)
(documentation
  soundPressureLevel
  EnglishWrittenLanguage
  "Relates an &%UnderwaterAcousticSignal to its sound pressure level,
  typically represented as a decibel-valued measure.")
(termFormat
  EnglishWrittenLanguage
  soundPressureLevel
  "soundPressureLevel associates a sound 
 pressure level %2 to a signal %1")

(=>
  (soundPressureLevel ?SIG ?SPL)
  (exists (?S)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?SPL PhysicalQuantity)
      (instance ?S RealNumber)
      (equal
        ?SPL
        (MeasureFn ?S Decibel))
      (holdsDuring
        (WhenFn ?SIG)
        (measure ?SIG ?SPL)))))

; =============================================================================
;  GEOMETRIC RELATIONS
; =============================================================================

; bearing

(instance bearing BinaryPredicate)
(domain bearing 1 UnderwaterAcousticSignal)
(domain bearing 2 PhysicalQuantity)

(documentation
  bearing
  EnglishWrittenLanguage
  "bearing relates an &%UnderwaterAcousticSignal to a bearing measure in 
  angular degree indicating the direction from receiver to source or apparent 
  arrival direction, as defined by the application context.")
(termFormat
  EnglishWrittenLanguage
  bearing
  "bearing associates a bearing measure %2
 to a signal %1")

(=>
  (bearing ?SIG ?BEARING)
  (exists (?B)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?B RealNumber)
      (equal
        ?BEARING
        (MeasureFn ?B AngularDegree))
      (holdsDuring
        (WhenFn ?SIG)
        (measure ?SIG ?BEARING))
      (greaterThanOrEqualTo ?B 0)
      (lessThan ?B 360))))


; rangeDistance 

(instance rangeDistance BinaryPredicate)

(domain rangeDistance 1 UnderwaterAcousticSignal)
(domain rangeDistance 2 LengthMeasure)

(documentation
  rangeDistance
  EnglishWrittenLanguage
  "rangeDistance relates an &%UnderwaterAcousticSignal to a range measure 
  representing the estimated or measured distance between the receiver 
  or reference point and the signal, as defined by the application 
  context.")
(termFormat
  EnglishWrittenLanguage
  rangeDistance
  "rangeDistance associates a range measure %2
 to a signal %1")

(=>
  (rangeDistance ?SIG ?RANGE)
  (exists (?R)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?R RealNumber)
      (instance ?RANGE PhysicalQuantity)
      (equal
        ?RANGE
        (MeasureFn ?R Meter))
      (holdsDuring
        (WhenFn ?SIG)
        (measure ?SIG ?RANGE))
      (greaterThanOrEqualTo ?R 0))))


; signalDepth 

(instance signalDepth BinaryPredicate)
(domain signalDepth 1 UnderwaterAcousticSignal)
(domain signalDepth 2 LengthMeasure)

(documentation
  signalDepth
  EnglishWrittenLanguage
  "signalDepth relates an UnderwaterAcousticSignal to an estimated source 
 depth or propagation depth below a reference surface.")
(termFormat
  EnglishWrittenLanguage
  signalDepth
  "signalDepth associates a depth measure %2
 to a signal %1")
(=>
  (signalDepth ?SIG ?DEPTH)
  (exists (?D)
    (and
      (instance ?D RealNumber)
      (instance ?DEPTH PhysicalQuantity)
      (instance ?SIG UnderwaterAcousticSignal)
      (equal
        ?DEPTH
        (MeasureFn ?D Meter))
      (depth ?SIG SeaLevel ?DEPTH)
      (greaterThanOrEqualTo ?D 0))))

; ============================================================================
; UNDERWATER ACOUSTIC SIGNAL ENVIRONMENT
; ============================================================================

; Temperature

(instance waterTemperature BinaryPredicate)
(domain waterTemperature 1 UnderwaterAcousticSignal)
(domain waterTemperature 2 PhysicalQuantity)

(documentation
  waterTemperature
  EnglishWrittenLanguage
  "waterTemperature relates an UnderwaterAcousticSignal to a water-temperature 
 measure used to characterize the environmental conditions relevant to 
 propagation or detection.")
(termFormat
  EnglishWrittenLanguage
  waterTemperature
  "Associates water temperature %2 to a signal %1")

(=>
  (waterTemperature ?SIG ?TEMP)
  (exists (?T)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?T RealNumber)
      (instance ?TEMP PhysicalQuantity)
      (equal
        ?TEMP
        (MeasureFn ?T KelvinDegree))
      (holdsDuring
        (WhenFn ?SIG)
        (greaterThanOrEqualTo ?T 0)))))

; Salinity

; Water salinity unit of mesure
(instance PracticalSalinityUnit UnitOfMeasure)
(documentation
  PracticalSalinityUnit
  EnglishWrittenLanguage
  "A unit label used in this ontology for values reported on the
Practical Salinity Scale. Practical salinity values are conventionally
treated as dimensionless, although PSU is commonly used informally
in data products.")
(termFormat
  EnglishWrittenLanguage
  PracticalSalinityUnit
  "Practical Salinity Unit also known as PSU")

; waterSalinity
(instance waterSalinity TernaryPredicate)
(domain waterSalinity 1 UnderwaterAcousticSignal)
(domain waterSalinity 2 UnderwaterRegion)
(domain waterSalinity 3 PhysicalQuantity)

(documentation
  waterSalinity
  EnglishWrittenLanguage
  "waterSalinity relates an UnderwaterAcousticSignal to a salinity measure 
 used to characterize the water salinity relevant to the environment
 where the signal propagates and is detected.")
(termFormat
  EnglishWrittenLanguage
  waterSalinity
  "Associates the salinity %3 
 to the underwater signal %1 located at water region %2")

(=>
  (waterSalinity ?SIG ?REGION ?SAL)
  (exists (?S)
    (and
      (instance ?SIG UnderwaterAcousticSignal)
      (instance ?REGION UnderwaterRegion)
      (located ?SIG ?REGION)
      (instance ?SAL PhysicalQuantity)
      (instance ?S RealNumber)
      (equal
        ?SAL
        (MeasureFn ?S PracticalSalinityUnit))
      (measure ?REGION ?SAL)
      (greaterThanOrEqualTo ?S 0))))

; ================================================================ ;
; SONAR SYSTEM 
; ================================================================

(subclass SonarSystem PhysicalSystem)
(documentation
  SonarSystem
  EnglishWrittenLanguage
  "A SonarSystem is a system that uses sound propagation (sonar) for 
  underwater detection, navigation, and measurement. Typically
  used in naval applications [from wikipedia]")
(termFormat EnglishWrittenLanguage SonarSystem "Sonar System")

; ; Every naval sonar system has at least one acoustic sensor.
(=>
  (instance ?SS SonarSystem)
  (exists (?SENS)
    (and
      (instance ?SENS AcousticSensor)
      (part ?SENS ?SS))))

; ; Every naval sonar system has at least one sonar (active or passive).
(=>
  (instance ?SONARSYST SonarSystem)
  (exists (?S)
    (and
      (part ?S ?SONARSYST)
      (or
        (instance ?S PassiveSonar)
        (instance ?S ActiveSonar)))))

; ; Every sonar system has at least one receiver.
(=>
  (instance ?SONARSYST SonarSystem)
  (exists (?SR)
    (and
      (instance ?SR SonarReceiver)
      (part ?SR ?SONARSYST))))

; Sonar system records underwater acoustic signals if the signals are
; detected by active or passive sonars.
(=>
  (instance ?SS SonarSystem)
  (modalAttribute
    (exists (?SR ?SIG ?AR ?DD ?DISC)
      (and
        (instance ?SR SonarReceiver)
        (part ?SR ?SS)
        (instance ?SIG UnderwaterAcousticSignal)
        (instance ?DISC Discovering)
        (instrument ?DISC ?SR)
        (patient ?DISC ?SIG)
        (instance ?AR AudioRecording)
        (instance ?DD DigitalData)
        (record ?AR ?SIG)
        (dataStored ?AR ?DD)))
    Possibility))