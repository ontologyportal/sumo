(instance WoodProductManufacturing IndustryAttribute)

(documentation WoodProductManufacturing EnglishWrittenLanguage "An &%Attribute of an &%Organization, that specifies that the primary business of the organization involves Wood Product Manufacturing.")

(=>
  (and
    (instance ?ORG Organization)
    (attribute ?ORG WoodProductManufacturing))
  (exists (?EV ?MEM)
    (and
      (member ?MEM ?ORG)
      (agent ?MEM ?EV)
      (exists (?THING ?MEM2 ?EV2)
        (and
          (instance ?EV Manufacture)
          (or
            (instance ?THING Wood)
            (material Wood ?THING))
          (patient ?EV ?THING)
          (member ?MEM2 ?ORG)
          (instance ?EV2 Selling)
          (agent ?EV2 ?MEM2)
          (patient ?EV2 ?THING))))))
              
