(instance FoodManufacturing IndustryAttribute)

(documentation FoodManufacturing EnglishWrittenLanguage "An &%Attribute of an &%Organization, that specifies that the primary business of the organization involves Food Manufacturing.")

(=>
  (and
    (instance ?ORG Organization)
    (attribute ?ORG FoodManufacturing))
  (exists (?EV ?MEM)
    (and
      (member ?MEM ?ORG)
      (agent ?MEM ?EV)
      (exists (?THING ?MEM2 ?EV2)
        (and
          (instance ?EV Cooking)
          (instance ?EV Manufacture)
          (patient ?EV ?THING)
          (member ?MEM2 ?ORG)
          (instance ?EV2 Selling)
          (agent ?EV2 ?MEM2)
          (patient ?EV2 ?THING))))))

