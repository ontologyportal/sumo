(=>
  (and
    (instance ?ORG Organization)
    (attribute ?ORG ChemicalManufacturing))
  (exists (?EV ?MEM)
    (and
      (member ?MEM ?ORG)
      (agent ?MEM ?EV)
      (exists (?THING ?MEM2 ?EV2)
        (and
          (instance ?EV Manufacture)
          (instance ?THING PureSubstance)
          (patient ?EV ?THING)
          (member ?MEM2 ?ORG)
          (instance ?EV2 Selling)
          (agent ?EV2 ?MEM2)
          (patient ?EV2 ?THING))))))

