(=>
  (and
    (instance ?ORG Organization)
    (attribute ?ORG RailTransportation))
  (exists (?EV ?MEM)
    (and
      (member ?MEM ?ORG)
      (agent ?MEM ?EV)
      (exists (?P)
        (and
          (instance ?EV Selling)
          (instance ?P Human)
          (patient ?EV ?P)
          (confersRight ?MEM ?P
            (exists (?MOVE ?RR ?OBJ)
              (and
                (instance ?MOVE Transportation)
                (or
                  (patient ?MOVE ?P)
                  (and
                    (possesses ?P ?OBJ)
                    (patient ?MOVE ?OBJ)
                    (instance ?OBJ Object)))
                (possesses ?ORG ?RR)
                (instance ?RR RailVehicle)))))))))

