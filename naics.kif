(instance WarehousingAndStorage IndustryAttribute)

(documentation WarehousingAndStorage EnglishWrittenLanguage "An &%Attribute of an &%Organization, that specifies that the primary business of the organization involves Warehousing and Storage.")

(=>
  (and
    (instance ?ORG Organization)
    (attribute ?ORG WarehousingAndStorage))
  (exists (?EV ?MEM)
    (and
      (member ?MEM ?ORG)
      (agent ?MEM ?EV)
      (exists (?P ?OBJ)
        (and
          (instance ?EV Selling)
          (instance ?OBJ Object)
          (instance ?P Human)
          (patient ?EV ?P)
          (confersRight ?MEM ?P
            (exists (?B ?T)
              (and
                (instance ?T TimeInterval)
                (instance ?B Building)
                (possesses ?P ?OBJ)
                (holdsDuring ?T
                  (located ?B ?OBJ))))))))))

(subAttribute GeneralWarehousingAndStorage WarehousingAndStorage)

