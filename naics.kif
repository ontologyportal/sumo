(subAttribute PassengerCarRental PassengerCarRentalAndLeasing)
(documentation PassengerCarRental EnglishWrittenLanguage "An &%Attribute of an &%Organization, that specifies that the primary business of the organization involves Passenger Car Rental or Passenger Car Rental.")

(=>
  (attribute ?X PassengerCarRental)
  (hasPurpose ?X
    (exists (?RENT ?CAR ?CUST)
      (and
        (customer ?CUST ?X)
        (instance ?CAR Automobile)
        (instance ?RENT Renting)
        (possesses ?X ?CAR)
        (agent ?RENT ?CUST)))))

