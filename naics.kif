(instance Mining IndustryAttribute)

(documentation Mining EnglishWrittenLanguage "An &%Attribute of an &%Organization, that specifies that the primary business of the organization involves Mining.")

(=>
  (and
    (instance ?ORG Organization)
    (attribute ?ORG Mining))
  (exists (?EV ?MEM)
    (and
      (member ?MEM ?ORG)
      (agent ?MEM ?EV)
      (exists (?THING ?MEM2 ?EV2)
        (and
          (instance ?EV Removing)
          (patient ?EV ?THING)
          (instance ?THING PureSubstance)
          (attribute ?THING Solid)
          (member ?MEM2 ?ORG)
          (instance ?EV2 Selling)
          (agent ?EV2 ?MEM2)
          (patient ?EV2 ?THING))))))
          
