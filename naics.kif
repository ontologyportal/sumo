(=>
  (attribute ?X SnackAndNonalcoholicBeverageBars)
  (hasPurpose ?X
    (exists (?SELL ?FOOD)
      (and
        (instance ?FOOD
          (FoodForFn Human))
        (instance ?SELL Selling)
        (patient ?SELL ?FOOD)
        (agent ?SELL ?X)))))

