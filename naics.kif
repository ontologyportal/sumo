(subAttribute BarberShops HairNailAndSkinCareServices)

(documentation BarberShops EnglishWrittenLanguage "An &%Attribute of an &%Organization, that specifies that the primary business of the organization involves Barber Shops or Barber Shops (except barber colleges).")

(=>
  (attribute ?X BarberShops)
  (hasPurpose ?X
    (exists (?HAIR ?HUMAN ?CUT ?STYLIST)
      (and
        (instance ?HAIR Hair)
        (part ?HAIR ?HUMAN)
        (instance ?HUMAN Human)
        (instance ?CUT Cutting)
        (patient ?CUT ?HAIR)
        (eventLocated ?CUT ?X)
        (agent ?CUT ?STYLIST)
        (employs ?X ?STYLIST)))))

