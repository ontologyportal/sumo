(subclass DeepPalmarArch Artery)
(termFormat EnglishWrittenLanguage DeepPalmarArch "deep palmar arch")
(documentation DeepPalmarArch EnglishWrittenLanguage "An arterial arch in the deep part of the palm, formed primarily by the radial artery and completed by the deep branch of the ulnar artery.")

(subclass AnteriorBoidyOfThirdMetacarpal PalmBone)
(termFormat EnglishWrittenLanguage AnteriorBoidyOfThirdMetacarpal "anterior body of third metacarpal")
(documentation AnteriorBoidyOfThirdMetacarpal EnglishWrittenLanguage "The superficial bony region on the anterior, or palmar, aspect of the shaft of the third metacarpal bone.")

; The legacy AbductorPollicisMuscle block describes adductor pollicis.
; Its third-metacarpal origin and deep ulnar innervation identify the adductor.
(muscleOrigin AdductorPollicisMuscle AnteriorBoidyOfThirdMetacarpal)
(muscleInsertion AdductorPollicisMuscle UlnarBaseOfProximalPhalanxOfThumb)
(muscleInsertion AdductorPollicisMuscle UlnarSesamoidOfThumb)
(suppliesBlood DeepPalmarArch AdductorPollicisMuscle)
(ennervates DeepBranchOfUlnarNerve AdductorPollicisMuscle)
; Adductor pollicis documentation appears with its primary declaration.

(subclass PalmarMetacarpalArtery Artery)
(termFormat EnglishWrittenLanguage PalmarMetacarpalArtery "palmar metacarpal artery")
(documentation PalmarMetacarpalArtery EnglishWrittenLanguage "An arterial branch of the deep palmar arch supplying deep
    structures of the palm, including the interosseous muscles.")

(subclass Palm BodyPart)
(termFormat EnglishWrittenLanguage Palm "palm")
(documentation Palm EnglishWrittenLanguage "The anterior region of the hand between the wrist and
    the bases of the fingers.")

