(ennervates FemoralNerve ArticularisGenusMuscle)
(subclass FemoralNerve Nerve)
(termFormat EnglishWrittenLanguage FemoralNerve "femoral nerve")
(documentation ArticularisGenusMuscle EnglishWrittenLanguage "The &%ArticularisGenusMuscle pulls suprapatellar bursa during &%Extension of &%Knee.")

(subclass MedialSideOfUpperTibiaInPesAnserinus Tendon)
(termFormat EnglishWrittenLanguage MedialSideOfUpperTibiaInPesAnserinus "medial side of upper tibia in pes anserinus")
(documentation MedialSideOfUpperTibiaInPesAnserinus EnglishWrittenLanguage "The tendinous portion of the pes anserinus that attaches to the anteromedial surface of the proximal tibia, comprising contributions from the tendons of the sartorius, gracilis, and semitendinosus muscles.")

(subclass SartoriusMuscle Muscle)
(termFormat EnglishWrittenLanguage SartoriusMuscle "sartorius muscle")
(muscleOrigin SartoriusMuscle SuperiorToAnteriorSuperiorIliacSpine)
(muscleInsertion SartoriusMuscle MedialSideOfUpperTibiaInPesAnserinus)
(suppliesBlood FemoralArtery SartoriusMuscle)
(ennervates FemoralNerve SartoriusMuscle)
(documentation SartoriusMuscle EnglishWrittenLanguage "The &%SartoriusMuscle performs &%Flexion of , laterally rotates, and abducts thigh, performs &%Flexion of  and medially rotates &%Leg.")

(subclass QuadricepsFemorisMuscle Muscle)
(termFormat EnglishWrittenLanguage QuadricepsFemorisMuscle "quadriceps femoris muscle")
; Quadriceps components are constituent muscles, not sites of origin.
(=>
  (instance ?M RectusFemorisMuscle)
  (exists (?Q)
    (and
      (instance ?Q QuadricepsFemorisMuscle)
      (part ?M ?Q))))
(=>
  (instance ?M VastusLateralisMuscle)
  (exists (?Q)
    (and
      (instance ?Q QuadricepsFemorisMuscle)
      (part ?M ?Q))))
(=>
  (instance ?M VastusIntermediusMuscle)
  (exists (?Q)
    (and
      (instance ?Q QuadricepsFemorisMuscle)
      (part ?M ?Q))))
(=>
  (instance ?M VastusMedialisMuscle)
  (exists (?Q)
    (and
      (instance ?Q QuadricepsFemorisMuscle)
      (part ?M ?Q))))
(muscleInsertion QuadricepsFemorisMuscle PatellaBone)
; Distal tibial attachment is indirect, through the patellar ligament.
(muscleInsertion QuadricepsFemorisMuscle TibialTuberosity)
(suppliesBlood FemoralArtery QuadricepsFemorisMuscle)
(ennervates FemoralNerve QuadricepsFemorisMuscle)
(documentation QuadricepsFemorisMuscle EnglishWrittenLanguage "The &%QuadricepsFemorisMuscle extends &%Knee, performs &%Flexion of  &%HipJoint (rectus femoris only).")
(antagonistMuscles HamstringMuscle QuadricepsFemorisMuscle)

(subclass RectusFemorisMuscle Muscle)
(termFormat EnglishWrittenLanguage RectusFemorisMuscle "rectus femoris muscle")
(muscleOrigin RectusFemorisMuscle AnteriorInferiorIliacSpine)
(muscleOrigin RectusFemorisMuscle SupraAcetabularGrooveOfIlium)
(muscleInsertion RectusFemorisMuscle PatellaBone)
; Distal tibial attachment is indirect, through the patellar ligament.
(muscleInsertion RectusFemorisMuscle TibialTuberosity)
(suppliesBlood FemoralArtery RectusFemorisMuscle)
(ennervates FemoralNerve RectusFemorisMuscle)
(documentation RectusFemorisMuscle EnglishWrittenLanguage "The &%RectusFemorisMuscle &%Knee &%Extension; &%HipJoint flexion.")
(antagonistMuscles HamstringMuscle RectusFemorisMuscle)

