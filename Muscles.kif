(muscleOrigin LevatorAniPubococcygeusMuscle BackSurfaceOfPubic)
(muscleInsertion LevatorAniPubococcygeusMuscle Coccyx)
(suppliesBlood InferiorGlutealArtery LevatorAniPubococcygeusMuscle)
(ennervates LevatorAniNerve LevatorAniPubococcygeusMuscle)
(documentation LevatorAniPubococcygeusMuscle EnglishWrittenLanguage "The &%LevatorAniPubococcygeusMuscle controls urine flow, contracts during orgasm.")

(subclass LevatorAniPuborectalisMuscle Muscle)
(termFormat EnglishWrittenLanguage PuborectalisMuscle "levator ani puborectalis muscle")
(muscleOrigin PuborectalisMuscle LowerPartOfPubicSymphysis)
(suppliesBlood InferiorGlutealArtery PuborectalisMuscle)
(ennervates S3S4LevatorAniNerve PuborectalisMuscle)
(subclass S3S4LevatorAniNerve Nerve)
(termFormat EnglishWrittenLanguage S3S4LevatorAniNerve "S3, S4. levator ani nerve")
(documentation PuborectalisMuscle EnglishWrittenLanguage "The &%PuborectalisMuscle inhibits defecation.")

(subclass SphincterAniExternusMuscle Muscle)
(termFormat EnglishWrittenLanguage SphincterAniExternusMuscle "sphincter ani externus muscle")
(suppliesBlood InferiorRectalArtery SphincterAniExternusMuscle)
(ennervates S4AndTwigsFromInferiorAnalNervesOfPudendalNerve SphincterAniExternusMuscle)
(subclass S4AndTwigsFromInferiorAnalNervesOfPudendalNerve Nerve)
(termFormat EnglishWrittenLanguage S4AndTwigsFromInferiorAnalNervesOfPudendalNerve "S4 and twigs from inferior anal nerves of pudendal nerve")
(documentation SphincterAniExternusMuscle EnglishWrittenLanguage "The &%SphincterAniExternusMuscle keeps anal canal and anus closed, aids in expulsion of feces.")

(subclass SphincterAniInternusMuscle Muscle)
(termFormat EnglishWrittenLanguage SphincterAniInternusMuscle "sphincter ani internus muscle")
(suppliesBlood InferiorRectalArtery SphincterAniInternusMuscle)
(ennervates PudendalNerve SphincterAniInternusMuscle)
(subclass PudendalNerve Nerve)
(termFormat EnglishWrittenLanguage PudendalNerve "pudendal nerve")
(documentation SphincterAniInternusMuscle EnglishWrittenLanguage "The &%SphincterAniInternusMuscle keeps anal canal and anus closed, aids in expulsion of feces.")

(subclass AnteriorSurfaceOfIschialTuberosity Bone)
(termFormat EnglishWrittenLanguage AnteriorSurfaceOfIschialTuberosity "anterior surface of ischial tuberosity")
(documentation AnteriorSurfaceOfIschialTuberosity EnglishWrittenLanguage "The anterior-facing bony portion of the ischial tuberosity.")

(subclass CentralPointOfPerineum BodyPart)
(termFormat EnglishWrittenLanguage CentralPointOfPerineum "perineal body")
(documentation CentralPointOfPerineum EnglishWrittenLanguage "A midline fibromuscular structure at the junction of the
    urogenital and anal triangles, providing attachment and
    continuity for several perineal muscles.")

(subclass SuperficialTransversePerinealMuscle Muscle)
(termFormat EnglishWrittenLanguage SuperficialTransversePerinealMuscle "superficial transverse perineal muscle")
(muscleOrigin SuperficialTransversePerinealMuscle AnteriorSurfaceOfIschialTuberosity)
(muscleInsertion SuperficialTransversePerinealMuscle CentralPointOfPerineum)
(suppliesBlood PerinealArtery SuperficialTransversePerinealMuscle)
(ennervates PudendalNerve SuperficialTransversePerinealMuscle)
(documentation SuperficialTransversePerinealMuscle EnglishWrittenLanguage "The
&%SuperficialTransversePerinealMuscle constricts &%Urethra (maintains urinary continence), constricts &%Vagina (women).")

(subclass PerinealRaphe BodyPart)
(termFormat EnglishWrittenLanguage PerinealRaphe "perineal raphe")
(documentation PerinealRaphe EnglishWrittenLanguage "A median seam of connective tissue in the perineum that provides an attachment site for fibers of the bulbospongiosus muscle.")

(subclass BulbospongiosusMuscle Muscle)
(termFormat EnglishWrittenLanguage BulbospongiosusMuscle "bulbospongiosus muscle")
(muscleOrigin BulbospongiosusMuscle PerinealRaphe)
(suppliesBlood PerinealArtery BulbospongiosusMuscle)
(ennervates PudendalNerve BulbospongiosusMuscle)
(documentation BulbospongiosusMuscle EnglishWrittenLanguage "The
&%BulbospongiosusMuscle empties &%Urethra (men) clenches &%Vagina (women).")

(subclass IschialTuberosity Bone)
(termFormat EnglishWrittenLanguage IschialTuberosity "ischial tuberosity")
(documentation IschialTuberosity EnglishWrittenLanguage "A roughened bony prominence on the inferior portion of the
    ischium that supports body weight during sitting and provides
    attachment sites for muscles and ligaments.")

(subclass CrusOfPenis BodyPart)
(termFormat EnglishWrittenLanguage CrusOfPenis "crus of penis")
(documentation CrusOfPenis EnglishWrittenLanguage "One of the paired proximal portions of the corpora cavernosa of the penis, attached to an ischiopubic ramus and covered by the ischiocavernosus muscle.")

(subclass CrusOfClitoris BodyPart)
(termFormat EnglishWrittenLanguage CrusOfClitoris "crus of clitoris")
(documentation CrusOfClitoris EnglishWrittenLanguage "One of the paired proximal portions of the corpora cavernosa of the clitoris, attached to an ischiopubic ramus and covered by the ischiocavernosus muscle.")

(subclass IschiocavernosusMuscle Muscle)
(termFormat EnglishWrittenLanguage IschiocavernosusMuscle "ischiocavernosus muscle")
(muscleOrigin IschiocavernosusMuscle IschialTuberosity)
(muscleInsertion IschiocavernosusMuscle CrusOfPenis)
(muscleInsertion IschiocavernosusMuscle CrusOfClitoris)
(suppliesBlood PerinealArtery IschiocavernosusMuscle)
(ennervates PudendalNerve IschiocavernosusMuscle)
(documentation IschiocavernosusMuscle EnglishWrittenLanguage "The
&%IschiocavernosusMuscle assists bulbospongiosus.")

(subclass InferiorRamusOfIschium Bone)
(termFormat EnglishWrittenLanguage InferiorRamusOfIschium "inferior ramus of ischium")
(documentation InferiorRamusOfIschium EnglishWrittenLanguage "The portion of the ischium extending toward and joining the
    inferior pubic ramus, forming part of the obturator foramen's
    bony boundary.")

(subclass DeepTransversePerinealMuscleMuscle Muscle)
(termFormat EnglishWrittenLanguage DeepTransversePerinealMuscleMuscle "deep transverse perineal muscle")
(muscleOrigin DeepTransversePerinealMuscleMuscle InferiorRamusOfIschium)
(muscleInsertion DeepTransversePerinealMuscleMuscle ContralateralDeepTransversePerinealFibers)
(ennervates PudendalNerve DeepTransversePerinealMuscleMuscle)
(documentation DeepTransversePerinealMuscleMuscle EnglishWrittenLanguage "The &%DeepTransversePerinealMuscleMuscle
constricts urethra (maintains urinary continence), constricts &%Vagina (women).")

(subclass SphincterUrethraeMembranaceaeMuscle Muscle)
(termFormat EnglishWrittenLanguage SphincterUrethraeMembranaceaeMuscle "sphincter urethrae membranaceae muscle")
(muscleOrigin SphincterUrethraeMembranaceaeMuscle IschiopubicRamus)
(muscleOrigin SphincterUrethraeMembranaceaeMuscle PerinealFascia)
(muscleInsertion SphincterUrethraeMembranaceaeMuscle ContralateralExternalUrethralSphincterFibers)
(ennervates PerinealBranchOfPudendalNerveS2S3S4 SphincterUrethraeMembranaceaeMuscle)
(subclass PerinealBranchOfPudendalNerveS2S3S4 Nerve)
(termFormat EnglishWrittenLanguage PerinealBranchOfPudendalNerveS2S3S4 "perineal branch of pudendal nerve (S2, S3, S4)")
(documentation SphincterUrethraeMembranaceaeMuscle EnglishWrittenLanguage "The &%SphincterUrethraeMembranaceaeMuscle
constricts urethra, maintains urinary continence.")

(subclass ExternalOccipitalProtuberance Bone)
(termFormat EnglishWrittenLanguage ExternalOccipitalProtuberance "external occipital protuberance")
(documentation ExternalOccipitalProtuberance EnglishWrittenLanguage "A midline prominence on the external surface of the occipital
    bone that provides attachment for the nuchal ligament.")

(subclass TrapeziusMuscle Muscle)
(termFormat EnglishWrittenLanguage TrapeziusMuscle "trapezius muscle")
(muscleOrigin TrapeziusMuscle ExternalOccipitalProtuberance)
(muscleInsertion TrapeziusMuscle ClavicleBone)
(suppliesBlood TransverseCervicalArtery TrapeziusMuscle)
(ennervates AccessoryNerve TrapeziusMuscle)
(documentation TrapeziusMuscle EnglishWrittenLanguage "The &%TrapeziusMuscle retracts and elevates &%scapula.")
(antagonistMuscles TrapeziusMuscle SerratusAnteriorMuscle)

(antagonistMuscles DeltoidMuscle LatissimusDorsiMuscle)
(antagonistMuscles TrapeziusMuscle LatissimusDorsiMuscle)

(subclass MedialBorderOfScapula Bone)
(termFormat EnglishWrittenLanguage MedialBorderOfScapula "medial border of scapula")
(documentation MedialBorderOfScapula EnglishWrittenLanguage "The edge of the scapula nearest the vertebral column,
    extending between its superior and inferior angles.")

(subclass RhomboidsMuscle Muscle)
(termFormat EnglishWrittenLanguage RhomboidsMuscle "rhomboids muscle")
(muscleOrigin RhomboidsMuscle NuchalLigament)
(muscleOrigin RhomboidsMuscle SpinousProcessesOfC7ThroughT5)
(muscleInsertion RhomboidsMuscle MedialBorderOfScapula)
(suppliesBlood DorsalScapularArtery RhomboidsMuscle)
(ennervates DorsalScapularNerveC4AndC5 RhomboidsMuscle)
(subclass DorsalScapularNerveC4AndC5 Nerve)
(termFormat EnglishWrittenLanguage DorsalScapularNerveC4AndC5 "dorsal scapular nerve (C4 and C5)")
(documentation RhomboidsMuscle EnglishWrittenLanguage "The &%RhomboidsMuscle retracts &%ScapulaBone and rotates it to
depress glenoid cavity, fixes &%ScapulaBone to thoracic wall.")
(antagonistMuscles SerratusAnteriorMuscle RhomboidsMuscle)

(subclass SpinousProcessesOfT2ToT5Vertebrae Bone)
(termFormat EnglishWrittenLanguage SpinousProcessesOfT2ToT5Vertebrae "spinous processes of T2 through T5 vertebrae")
(documentation SpinousProcessesOfT2ToT5Vertebrae EnglishWrittenLanguage "A spinous process belonging to any of the second through fifth
    thoracic vertebrae. These posterior bony projections provide
    attachment for muscles and ligaments of the back.")

(subclass RhomboidMajorMuscle Muscle)
(termFormat EnglishWrittenLanguage RhomboidMajorMuscle "rhomboid major muscle")
(muscleOrigin RhomboidMajorMuscle SpinousProcessesOfT2ToT5Vertebrae)
(muscleInsertion RhomboidMajorMuscle MedialBorderOfScapulaInferiorToInsertionOfRhomboidMinor)
(suppliesBlood DorsalScapularArtery RhomboidMajorMuscle)
(ennervates DorsalScapularNerveC4AndC5 RhomboidMajorMuscle)
(documentation RhomboidMajorMuscle EnglishWrittenLanguage "The &%RhomboidMajorMuscle retracts &%ScapulaBone
and rotates it to depress glenoid cavity, fixes &%ScapulaBone to thoracic wall.")
(antagonistMuscles SerratusAnteriorMuscle RhomboidMajorMuscle)

(subclass RhomboidMinorMuscle Muscle)
(termFormat EnglishWrittenLanguage RhomboidMinorMuscle "rhomboid minor muscle")
(muscleOrigin RhomboidMinorMuscle NuchalLigament)
(muscleOrigin RhomboidMinorMuscle SpinousProcessesOfC7ThroughT1)
(muscleInsertion RhomboidMinorMuscle MedialBorderOfScapulaSuperiorToInsertionOfRhomboidMajor)
(suppliesBlood DorsalScapularArtery RhomboidMinorMuscle)
(ennervates DorsalScapularNerveC4AndC5 RhomboidMinorMuscle)
(documentation RhomboidMinorMuscle EnglishWrittenLanguage "The &%RhomboidMinorMuscle retracts &%ScapulaBone and rotates it to depress glenoid cavity, fixes &%ScapulaBone to thoracic wall.")
(antagonistMuscles SerratusAnteriorMuscle RhomboidMinorMuscle)

(subclass PectoralBranchOfThoracoacromialArtery Artery)
(termFormat EnglishWrittenLanguage PectoralBranchOfThoracoacromialArtery "pectoral branch of thoracoacromial artery")
(documentation PectoralBranchOfThoracoacromialArtery EnglishWrittenLanguage "A branch of the thoracoacromial artery supplying the
    pectoralis major and pectoralis minor muscles.")

(subclass PectoralisMajorMuscle Muscle)
(termFormat EnglishWrittenLanguage PectoralisMajorMuscle "pectoralis major muscle")
(muscleOrigin PectoralisMajorMuscle AnteriorSurfaceOfMedialHalfOfClavicle)
(muscleOrigin PectoralisMajorMuscle AnteriorSurfaceOfSternum)
(muscleOrigin PectoralisMajorMuscle SuperiorSixCostalCartilages)
(muscleInsertion PectoralisMajorMuscle IntertubercularGrooveOfHumerus)
(suppliesBlood PectoralBranchOfThoracoacromialArtery PectoralisMajorMuscle)
(ennervates LateralPectoralNerveMedialPectoralNerveClavicularHeadC5AndC6SternocostalHeadC7C8AndT1 PectoralisMajorMuscle)
(subclass LateralPectoralNerveMedialPectoralNerveClavicularHeadC5AndC6SternocostalHeadC7C8AndT1 Nerve)
(termFormat EnglishWrittenLanguage LateralPectoralNerveMedialPectoralNerveClavicularHeadC5AndC6SternocostalHeadC7C8AndT1 "lateral pectoral nerve, medial pectoral nerve clavicular head: C5 and C6 sternocostal head: C7, C8 and T1")
(documentation PectoralisMajorMuscle EnglishWrittenLanguage "The &%PectoralisMajorMuscle adducts and medially rotates humerus, draws &%ScapulaBone anteriorly and inferiorly clavicular head: performs &%Flexion of  humerus sternocostal head: extends humerus.")

(subclass PectoralisMinorMuscle Muscle)
(termFormat EnglishWrittenLanguage PectoralisMinorMuscle "pectoralis minor muscle")
(muscleOrigin PectoralisMinorMuscle ThirdTo5ThRibsNearTheirCostalCartilages)
(muscleInsertion PectoralisMinorMuscle MedialBorderAndSuperiorSurfaceOfCoracoidProcessOfScapula)
(suppliesBlood PectoralBranchOfThoracoacromialArtery PectoralisMinorMuscle)
(ennervates MedialPectoralNerveC8T1 PectoralisMinorMuscle)
(subclass MedialPectoralNerveC8T1 Nerve)
(termFormat EnglishWrittenLanguage MedialPectoralNerveC8T1 "medial pectoral nerve (C8, T1)")
(documentation PectoralisMinorMuscle EnglishWrittenLanguage "The &%PectoralisMinorMuscle stabilizes
&%ScapulaBone by drawing it inferiorly and anteriorly against thoracic wall.")

(subclass FirstRib RibBone)
(termFormat EnglishWrittenLanguage FirstRib "first rib")
(documentation FirstRib EnglishWrittenLanguage "The uppermost rib on either side of the thorax. In humans, it is
    short, broad, and flattened, articulates posteriorly with the first
    thoracic vertebra, and connects anteriorly to the sternum through
    its costal cartilage.")

(subclass SubclavianGrooveOfClavicle Bone)
(termFormat EnglishWrittenLanguage SubclavianGrooveOfClavicle "subclavian groove of clavicle")
(documentation SubclavianGrooveOfClavicle EnglishWrittenLanguage "The grooved bony region on the inferior surface of the
    clavicular shaft where the subclavius muscle inserts.")

(subclass ThoracoacromialArteryClavicularBranch Artery)
(termFormat EnglishWrittenLanguage ThoracoacromialArteryClavicularBranch "clavicular branch of thoracoacromial artery")
(documentation ThoracoacromialArteryClavicularBranch EnglishWrittenLanguage "A branch of the thoracoacromial artery supplying the
    subclavius muscle and tissues near the sternoclavicular joint.")

(subclass SubclaviusMuscle Muscle)
(termFormat EnglishWrittenLanguage SubclaviusMuscle "subclavius muscle")
(muscleOrigin SubclaviusMuscle FirstRib)
(muscleInsertion SubclaviusMuscle SubclavianGrooveOfClavicle)
(suppliesBlood ThoracoacromialArteryClavicularBranch SubclaviusMuscle)
(ennervates SubclavianNerve SubclaviusMuscle)
(subclass SubclavianNerve Nerve)
(termFormat EnglishWrittenLanguage SubclavianNerve "subclavian nerve")
(documentation SubclaviusMuscle EnglishWrittenLanguage "The &%SubclaviusMuscle depresses clavicle.")

(subclass SerratusAnteriorMuscle Muscle)
(termFormat EnglishWrittenLanguage SerratusAnteriorMuscle "serratus anterior muscle")
(muscleOrigin SerratusAnteriorMuscle RibBone)
(muscleInsertion SerratusAnteriorMuscle ScapulaBone)
(suppliesBlood LateralThoracicArtery SerratusAnteriorMuscle)
(ennervates LongThoracicNerve SubclaviusMuscle)
(subclass LongThoracicNerve Nerve)
(termFormat EnglishWrittenLanguage LongThoracicNerve "long thoracic nerve")
(documentation SerratusAnteriorMuscle EnglishWrittenLanguage "The &%SerratusAnteriorMuscle protracts and stabilises scapula, assists in upward rotation.")

(subclass DeltoidTuberosityOfHumerus Bone)
(termFormat EnglishWrittenLanguage DeltoidTuberosityOfHumerus "deltoid tuberosity of humerus")
(documentation DeltoidTuberosityOfHumerus EnglishWrittenLanguage "A roughened prominence on the lateral humeral shaft where
    the deltoid muscle inserts.")

(subclass DeltoidMuscle Muscle)
(termFormat EnglishWrittenLanguage DeltoidMuscle "deltoid muscle")
(muscleOrigin DeltoidMuscle LateralThirdOfClavicle)
(muscleOrigin DeltoidMuscle AcromionOfScapula)
(muscleOrigin DeltoidMuscle SpineOfScapula)
(muscleInsertion DeltoidMuscle DeltoidTuberosityOfHumerus)
(suppliesBlood PosteriorHumeralCircumflexArtery DeltoidMuscle)
(ennervates AxillaryNerve DeltoidMuscle)
(subclass AxillaryNerve Nerve)
(termFormat EnglishWrittenLanguage AxillaryNerve "axillary nerve")
(documentation DeltoidMuscle EnglishWrittenLanguage "The &%DeltoidMuscle abducts, performs &%Flexion of,
and extends &%Shoulder.")
(antagonistMuscles LatissimusDorsiMuscle DeltoidMuscle)

(subclass MedialLipOfIntertubercularSulcusOfHumerus Bone)
(termFormat EnglishWrittenLanguage MedialLipOfIntertubercularSulcusOfHumerus "medial lip of intertubercular sulcus of humerus")
(documentation MedialLipOfIntertubercularSulcusOfHumerus EnglishWrittenLanguage "The bony ridge forming the medial margin of the humeral
    intertubercular groove, providing the insertion of teres major.")

(subclass PosteriorSurfaceOfInferiorAngleOfScapula Bone)
(termFormat EnglishWrittenLanguage PosteriorSurfaceOfInferiorAngleOfScapula "posterior surface of inferior angle of scapula")
(documentation PosteriorSurfaceOfInferiorAngleOfScapula EnglishWrittenLanguage "The posterior-facing bony region at the lowest angle of
    the scapula, where its medial and lateral borders meet.")

(subclass TeresMajorMuscle Muscle)
(termFormat EnglishWrittenLanguage TeresMajorMuscle "teres major muscle")
(muscleOrigin TeresMajorMuscle PosteriorSurfaceOfInferiorAngleOfScapula)
(muscleInsertion TeresMajorMuscle MedialLipOfIntertubercularSulcusOfHumerus)
(suppliesBlood SubscapularArtery TeresMajorMuscle)
(suppliesBlood CircumflexScapularArtery TeresMajorMuscle)
(ennervates LowerSubscapularNerveSegmentalLevelsC5AndC6 TeresMajorMuscle)
(subclass LowerSubscapularNerveSegmentalLevelsC5AndC6 Nerve)
(termFormat EnglishWrittenLanguage LowerSubscapularNerveSegmentalLevelsC5AndC6 "lower subscapular nerve (segmental levels C5 and C6)")
(documentation TeresMajorMuscle EnglishWrittenLanguage "The &%TeresMajorMuscle internally rotates humerus.")

(subclass SupraspinousFossaOfScapula Bone)
(termFormat EnglishWrittenLanguage SupraspinousFossaOfScapula "supraspinous fossa of scapula")
(documentation SupraspinousFossaOfScapula EnglishWrittenLanguage "The depressed bony region above the scapular spine on the
    posterior surface of the scapula, providing the origin of
    the supraspinatus muscle.")

(subclass SuperiorFacetOfGreaterTubercleOfHumerus Bone)
(termFormat EnglishWrittenLanguage SuperiorFacetOfGreaterTubercleOfHumerus "superior facet of greater tubercle of humerus")
(documentation SuperiorFacetOfGreaterTubercleOfHumerus EnglishWrittenLanguage "The uppermost facet on the greater tubercle of the humerus,
    receiving the supraspinatus tendon.")

(subclass SupraspinatusMuscle Muscle)
(termFormat EnglishWrittenLanguage SupraspinatusMuscle "supraspinatus muscle")
(muscleOrigin SupraspinatusMuscle SupraspinousFossaOfScapula)
(muscleInsertion SupraspinatusMuscle SuperiorFacetOfGreaterTubercleOfHumerus)
(suppliesBlood SuprascapularArtery SupraspinatusMuscle)
(ennervates SuprascapularNerve SupraspinatusMuscle)
(subclass SuprascapularNerve Nerve)
(termFormat EnglishWrittenLanguage SuprascapularNerve "suprascapular nerve")
(documentation SupraspinatusMuscle EnglishWrittenLanguage "The &%SupraspinatusMuscle abducts and stabilises humerus.")
(antagonistMuscles InfraspinatusMuscle SupraspinatusMuscle)
(antagonistMuscles TeresMinorMuscle SupraspinatusMuscle)
(antagonistMuscles PectoralisMajorMuscle SupraspinatusMuscle)
(antagonistMuscles LatissimusDorsiMuscle SupraspinatusMuscle)

(subclass SuprascapularArtery Artery)
(termFormat EnglishWrittenLanguage SuprascapularArtery "suprascapular artery")
(documentation SuprascapularArtery EnglishWrittenLanguage "An artery that supplies the supraspinous and infraspinous regions
    of the scapula and contributes to the arterial network around
    the scapula.")

(subclass CircumflexScapularArtery Artery)
(termFormat EnglishWrittenLanguage CircumflexScapularArtery "circumflex scapular artery")
(documentation CircumflexScapularArtery EnglishWrittenLanguage "A branch of the subscapular artery that passes around the lateral
    border of the scapula and supplies the posterior scapular region.")

(subclass InfraspinousFossaOfScapula Bone)
(termFormat EnglishWrittenLanguage InfraspinousFossaOfScapula "infraspinous fossa of scapula")
(documentation InfraspinousFossaOfScapula EnglishWrittenLanguage "The depressed bony region below the scapular spine on the
    posterior surface of the scapula, providing the origin of
    the infraspinatus muscle.")

(subclass MiddleFacetOfGreaterTubercleOfHumerus Bone)
(termFormat EnglishWrittenLanguage MiddleFacetOfGreaterTubercleOfHumerus "middle facet of greater tubercle of humerus")
(documentation MiddleFacetOfGreaterTubercleOfHumerus EnglishWrittenLanguage "The middle of the three facets on the greater tubercle of
    the humerus, receiving the infraspinatus tendon.")

(subclass InfraspinatusMuscle Muscle)
(termFormat EnglishWrittenLanguage InfraspinatusMuscle "infraspinatus muscle")
(muscleOrigin InfraspinatusMuscle InfraspinousFossaOfScapula)
(muscleInsertion InfraspinatusMuscle MiddleFacetOfGreaterTubercleOfHumerus)
(suppliesBlood SuprascapularArtery InfraspinatusMuscle)
(suppliesBlood CircumflexScapularArtery InfraspinatusMuscle)
(ennervates SuprascapularNerve InfraspinatusMuscle)
(documentation InfraspinatusMuscle EnglishWrittenLanguage "The &%InfraspinatusMuscle laterally rotates, adducts, and stabilises humerus.")
(antagonistMuscles SubscapularisMuscle InfraspinatusMuscle)
(antagonistMuscles PectoralisMajorMuscle InfraspinatusMuscle)
(antagonistMuscles LatissimusDorsiMuscle InfraspinatusMuscle)

(subclass InferiorFacetOfGreaterTubercleOfHumerus Bone)
(termFormat EnglishWrittenLanguage InferiorFacetOfGreaterTubercleOfHumerus "inferior facet of greater tubercle of humerus")
(documentation InferiorFacetOfGreaterTubercleOfHumerus EnglishWrittenLanguage "The lowest of the three facets on the greater tubercle of the
    humerus, providing the attachment site for the tendon of the
    teres minor muscle.")

(subclass LateralBorderOfScapula Bone)
(termFormat EnglishWrittenLanguage LateralBorderOfScapula "lateral border of scapula")
(documentation LateralBorderOfScapula EnglishWrittenLanguage "The thickened lateral edge of the scapula extending from
    the glenoid region to the inferior angle.")

(subclass TeresMinorMuscle Muscle)
(termFormat EnglishWrittenLanguage TeresMinorMuscle "teres minor muscle")
(muscleOrigin TeresMinorMuscle LateralBorderOfScapula)
(muscleInsertion TeresMinorMuscle InferiorFacetOfGreaterTubercleOfHumerus)
(suppliesBlood PosteriorHumeralCircumflexArtery TeresMinorMuscle)
(suppliesBlood CircumflexScapularArtery TeresMinorMuscle)
(ennervates AxillaryNerve TeresMinorMuscle)
(documentation TeresMinorMuscle EnglishWrittenLanguage "The &%TeresMinorMuscle laterally rotates and adducts humerus.")
(antagonistMuscles SubscapularisMuscle TeresMinorMuscle)
(antagonistMuscles PectoralisMajorMuscle TeresMinorMuscle)
(antagonistMuscles LatissimusDorsiMuscle TeresMinorMuscle)

(subclass LesserTubercleOfHumerus Bone)
(termFormat EnglishWrittenLanguage LesserTubercleOfHumerus "lesser tubercle of humerus")
(documentation LesserTubercleOfHumerus EnglishWrittenLanguage "An anterior projection of the proximal humerus where the
    subscapularis tendon inserts.")

(subclass SubscapularFossaOfScapula Bone)
(termFormat EnglishWrittenLanguage SubscapularFossaOfScapula "subscapular fossa of scapula")
(documentation SubscapularFossaOfScapula EnglishWrittenLanguage "The broad, concave bony region on the anterior surface of
    the scapula, providing the origin of the subscapularis muscle.")

(subclass SubscapularisMuscle Muscle)
(termFormat EnglishWrittenLanguage SubscapularisMuscle "subscapularis muscle")
(muscleOrigin SubscapularisMuscle SubscapularFossaOfScapula)
(muscleInsertion SubscapularisMuscle LesserTubercleOfHumerus)
(suppliesBlood SubscapularArtery SubscapularisMuscle)
(ennervates UpperSubscapularNerveLowerSubscapularNerveC5C6 SubscapularisMuscle)
(subclass UpperSubscapularNerveLowerSubscapularNerveC5C6 Nerve)
(termFormat EnglishWrittenLanguage UpperSubscapularNerveLowerSubscapularNerveC5C6 "upper subscapular nerve, lower subscapular nerve (C5, C6)")
(documentation SubscapularisMuscle EnglishWrittenLanguage "The &%SubscapularisMuscle medially rotates humerus, stabilizes &%Shoulder.")
(antagonistMuscles InfraspinatusMuscle SubscapularisMuscle)
(antagonistMuscles TeresMinorMuscle SubscapularisMuscle)

(subclass CoracoidProcessOfScapula Bone)
(termFormat EnglishWrittenLanguage CoracoidProcessOfScapula "coracoid process of scapula")
(documentation CoracoidProcessOfScapula EnglishWrittenLanguage "A curved bony projection extending anteriorly from the superior
    portion of the scapula that provides attachment sites for
    muscles and ligaments.")

(subclass MedialSurfaceOfHumerus Bone)
(termFormat EnglishWrittenLanguage MedialSurfaceOfHumerus "medial surface of humerus")
(documentation MedialSurfaceOfHumerus EnglishWrittenLanguage "The superficial bony portion of the humerus facing toward
    the body's midline in the standard anatomical position.")

(subclass CoracobrachialisMuscle Muscle)
(termFormat EnglishWrittenLanguage CoracobrachialisMuscle "coracobrachialis muscle")
(muscleOrigin CoracobrachialisMuscle CoracoidProcessOfScapula)
(muscleInsertion CoracobrachialisMuscle MedialSurfaceOfHumerus)
(suppliesBlood BrachialArtery CoracobrachialisMuscle)
(ennervates MusculocutaneousNerve CoracobrachialisMuscle)
(subclass MusculocutaneousNerve Nerve)
(termFormat EnglishWrittenLanguage MusculocutaneousNerve "musculocutaneous nerve")
(documentation CoracobrachialisMuscle EnglishWrittenLanguage "The &%CoracobrachialisMuscle performs &%Flexion of and adducts &%Shoulder.")

(subclass RadialTuberosity Bone)
(termFormat EnglishWrittenLanguage RadialTuberosity "radial tuberosity")
(documentation RadialTuberosity EnglishWrittenLanguage "A bony prominence just distal to the neck of the radius,
    on its anteromedial aspect, where the biceps brachii tendon inserts.")

(subclass BicepsBrachiiMuscle Muscle)
(termFormat EnglishWrittenLanguage BicepsBrachiiMuscle "coracobrachialis muscle")
(muscleOrigin BicepsBrachiiMuscle CoracoidProcessOfScapula)
(muscleInsertion BicepsBrachiiMuscle RadialTuberosity)
(suppliesBlood BrachialArtery BicepsBrachiiMuscle)
(ennervates MusculocutaneousNerve BicepsBrachiiMuscle)
(documentation BicepsBrachiiMuscle EnglishWrittenLanguage "The &%BicepsBrachiiMuscle flexes elbow, supinates forearm.")

(subclass AnteriorSurfaceOfHumerusMainlyDistalHalf LegBone)
(termFormat EnglishWrittenLanguage AnteriorSurfaceOfHumerusMainlyDistalHalf "anterior surface of distal half of humerus")
(documentation AnteriorSurfaceOfHumerusMainlyDistalHalf EnglishWrittenLanguage "The superficial bony region covering principally the distal half of the anterior surface of the humeral shaft, providing an origin for the brachialis muscle.")

(subclass BrachialisMuscle Muscle)
(termFormat EnglishWrittenLanguage BrachialisMuscle "brachialis muscle")
(muscleOrigin BrachialisMuscle AnteriorSurfaceOfHumerusMainlyDistalHalf)
(muscleInsertion BrachialisMuscle CoronoidProcessOfUlna)
(muscleInsertion BrachialisMuscle UlnarTuberosity)
(suppliesBlood RadialRecurrentArtery BrachialisMuscle)
(ennervates MusculocutaneousNerve BrachialisMuscle)
(documentation BrachialisMuscle EnglishWrittenLanguage "The &%BrachialisMuscle performs &%Flexion of  elbow.")
(antagonistMuscles TricepsBrachiiMuscle BrachialisMuscle)

(subclass InfraglenoidTubercleOfScapula Bone)
(termFormat EnglishWrittenLanguage InfraglenoidTubercleOfScapula "infraglenoid tubercle of scapula")
(documentation InfraglenoidTubercleOfScapula EnglishWrittenLanguage "A bony prominence below the scapula's glenoid cavity that
    provides the origin of the long head of the triceps brachii.")

(subclass OlecranonOfUlna Bone)
(termFormat EnglishWrittenLanguage OlecranonOfUlna "olecranon of ulna")
(documentation OlecranonOfUlna EnglishWrittenLanguage "The proximal projection of the ulna forming the point of
    the elbow and receiving the triceps brachii tendon.")

(subclass DeepArteryOfArm Artery)
(termFormat EnglishWrittenLanguage DeepArteryOfArm "deep artery of arm")
(documentation DeepArteryOfArm EnglishWrittenLanguage "A branch of the brachial artery supplying the posterior
    compartment of the arm. Also called the profunda brachii artery.")

(subclass TricepsBrachiiMuscle Muscle)
(termFormat EnglishWrittenLanguage TricepsBrachiiMuscle "triceps brachii muscle")
(muscleOrigin TricepsBrachiiMuscle InfraglenoidTubercleOfScapula)
(muscleInsertion TricepsBrachiiMuscle OlecranonOfUlna)
(suppliesBlood DeepArteryOfArm TricepsBrachiiMuscle)
(ennervates RadialNerve TricepsBrachiiMuscle)
(subclass RadialNerve Nerve)
(termFormat EnglishWrittenLanguage RadialNerve "Radial nerve")
(documentation TricepsBrachiiMuscle EnglishWrittenLanguage "The &%TricepsBrachiiMuscle extends forearm
long head: adducts shoulder medial head: does not function at shoulder.")
(antagonistMuscles TricepsBrachiiMuscle BicepsBrachiiMuscle)

(subclass LateralEpicondyleOfHumerus Bone)
(termFormat EnglishWrittenLanguage LateralEpicondyleOfHumerus "lateral epicondyle of humerus")
(documentation LateralEpicondyleOfHumerus EnglishWrittenLanguage "A lateral prominence of the distal humerus that provides
    attachment for the common extensor tendon and other structures.")

(subclass AnconeusMuscle Muscle)
(termFormat EnglishWrittenLanguage AnconeusMuscle "anconeus muscle")
(muscleOrigin AnconeusMuscle LateralEpicondyleOfHumerus)
(muscleInsertion AnconeusMuscle LateralSurfaceOfOlecranon)
(muscleInsertion AnconeusMuscle UpperPosteriorSurfaceOfUlna)
(suppliesBlood DeepArteryOfArm AnconeusMuscle)
(suppliesBlood InterosseousRecurrentArtery AnconeusMuscle)
(ennervates RadialNerveC7C8AndT1 AnconeusMuscle)
(subclass RadialNerveC7C8AndT1 Nerve)
(termFormat EnglishWrittenLanguage RadialNerveC7C8AndT1 "radial nerve (C7, C8, and T1)")
(documentation AnconeusMuscle EnglishWrittenLanguage "The &%AnconeusMuscle partly blended with triceps, extends forearm, stabilises elbow, abducts ulna during pronation.")

(subclass PronatorTuberosityOfRadius Bone)
(termFormat EnglishWrittenLanguage PronatorTuberosityOfRadius "pronator tuberosity of radius")
(documentation PronatorTuberosityOfRadius EnglishWrittenLanguage "A roughened bony region on the lateral surface of the middle part of the radius where the pronator teres muscle inserts.")

(subclass PronatorTeresMuscle Muscle)
(termFormat EnglishWrittenLanguage PronatorTeresMuscle "pronator teres muscle")
(muscleOrigin PronatorTeresMuscle MedialEpicondyleOfHumerus)
(muscleInsertion PronatorTeresMuscle PronatorTuberosityOfRadius)
(suppliesBlood UlnarArtery PronatorTeresMuscle)
(suppliesBlood RadialArtery PronatorTeresMuscle)
(ennervates MedianNerve PronatorTeresMuscle)
(subclass MedianNerve Nerve)
(termFormat EnglishWrittenLanguage MedianNerve "median nerve")
(documentation PronatorTeresMuscle EnglishWrittenLanguage "The &%PronatorTeresMuscle pronates forearm, flexes elbow.")
(antagonistMuscles PronatorTeresMuscle SupinatorMuscle)

(subclass FlexorCarpiRadialisMuscle Muscle)
(termFormat EnglishWrittenLanguage FlexorCarpiRadialisMuscle "flexor carpi radialis muscle")
(muscleOrigin FlexorCarpiRadialisMuscle MedialEpicondyleOfHumerus)
(muscleOrigin FlexorCarpiRadialisMuscle CommonFlexorTendon)
(muscleInsertion FlexorCarpiRadialisMuscle BaseOfSecondMetacarpal)
(muscleInsertion FlexorCarpiRadialisMuscle BaseOf3RdMetacarpal)
(suppliesBlood RadialArtery FlexorCarpiRadialisMuscle)
(ennervates MedianNerve FlexorCarpiRadialisMuscle)
(documentation FlexorCarpiRadialisMuscle EnglishWrittenLanguage "The &%FlexorCarpiRadialisMuscle performs &%Flexion of  and abducts &%Wrist.")
(antagonistMuscles ExtensorCarpiRadialisBrevisMuscle FlexorCarpiRadialisMuscle)
(antagonistMuscles ExtensorCarpiRadialisLongusMuscle FlexorCarpiRadialisMuscle)

(subclass PalmarAponeurosis BodyPart)
(termFormat EnglishWrittenLanguage PalmarAponeurosis "palmar aponeurosis")
(documentation PalmarAponeurosis EnglishWrittenLanguage "A strong sheet of connective tissue in the palm that anchors
    the overlying skin and protects underlying tendons, nerves,
    and blood vessels.")

(subclass PalmarisLongusMuscle Muscle)
(termFormat EnglishWrittenLanguage PalmarisLongusMuscle "palmaris longus muscle")
(muscleOrigin PalmarisLongusMuscle MedialEpicondyleOfHumerus)
(muscleOrigin PalmarisLongusMuscle CommonFlexorTendon)
(muscleInsertion PalmarisLongusMuscle PalmarAponeurosis)
(suppliesBlood UlnarArtery PalmarisLongusMuscle)
(ennervates MedianNerve PalmarisLongusMuscle)
(documentation PalmarisLongusMuscle EnglishWrittenLanguage "The &%PalmarisLongusMuscle performs &%Flexion of  &%Wrist.")
(antagonistMuscles ExtensorCarpiRadialisBrevisMuscle PalmarisLongusMuscle)
(antagonistMuscles ExtensorCarpiRadialisLongusMuscle PalmarisLongusMuscle)
(antagonistMuscles ExtensorCarpiUlnarisMuscle PalmarisLongusMuscle)

(subclass FlexorCarpiUlnarisMuscle Muscle)
(termFormat EnglishWrittenLanguage FlexorCarpiUlnarisMuscle "flexor carpi ulnaris muscle")
(muscleOrigin FlexorCarpiUlnarisMuscle MedialEpicondyleOfHumerus)
(muscleOrigin FlexorCarpiUlnarisMuscle CommonFlexorTendon)
(muscleInsertion FlexorCarpiUlnarisMuscle Pisiform)
(muscleInsertion FlexorCarpiUlnarisMuscle HookOfHamate)
(muscleInsertion FlexorCarpiUlnarisMuscle BaseOfFifthMetacarpal)
(suppliesBlood UlnarArtery FlexorCarpiUlnarisMuscle)
(ennervates MuscularBranchesOfUlnarNerve FlexorCarpiUlnarisMuscle)
(subclass MuscularBranchesOfUlnarNerve Nerve)
(termFormat EnglishWrittenLanguage MuscularBranchesOfUlnarNerve "muscular branches of ulnar nerve")
(documentation FlexorCarpiUlnarisMuscle EnglishWrittenLanguage "The &%FlexorCarpiUlnarisMuscle performs &%Flexion of  and adducts &%Wrist.")
(antagonistMuscles ExtensorCarpiUlnarisMuscle FlexorCarpiUlnarisMuscle)

(subclass FlexorDigitorumSuperficialisMuscle Muscle)
(termFormat EnglishWrittenLanguage FlexorDigitorumSuperficialisMuscle "flexor digitorum superficialis muscle")
(muscleOrigin FlexorDigitorumSuperficialisMuscle MedialEpicondyleOfHumerus)
(muscleOrigin FlexorDigitorumSuperficialisMuscle CommonFlexorTendon)
(muscleOrigin FlexorDigitorumSuperficialisMuscle CoronoidProcessOfUlna)
(muscleOrigin FlexorDigitorumSuperficialisMuscle AnteriorBorderOfRadius)
(muscleInsertion FlexorDigitorumSuperficialisMuscle BasesOfMiddlePhalanges234And5)
(suppliesBlood UlnarArtery FlexorDigitorumSuperficialisMuscle)
(ennervates MedianNerve FlexorDigitorumSuperficialisMuscle)
(documentation FlexorDigitorumSuperficialisMuscle EnglishWrittenLanguage "The &%FlexorDigitorumSuperficialisMuscle performs &%Flexion of  &%Fingers (primarily at proximal interphalangeal &%BodyJoints).")
(antagonistMuscles ExtensorDigitorumMuscle FlexorDigitorumSuperficialisMuscle)

(subclass AnteriorInterosseousNerve Nerve)
(termFormat EnglishWrittenLanguage AnteriorInterosseousNerve "anterior interosseous nerve")
(documentation AnteriorInterosseousNerve EnglishWrittenLanguage "A branch of the median nerve supplying the flexor pollicis
    longus, pronator quadratus, and lateral portion of the
    flexor digitorum profundus in the forearm.")

(subclass LateralAnteriorSurfaceOfRadius Bone)
(termFormat EnglishWrittenLanguage LateralAnteriorSurfaceOfRadius "anterolateral surface of radius")
(documentation LateralAnteriorSurfaceOfRadius EnglishWrittenLanguage "The superficial bony region of the radius facing anteriorly
    and laterally in the standard anatomical position.")

(subclass MedialAnteriorSurfaceOfUlna ArmBone)
(termFormat EnglishWrittenLanguage MedialAnteriorSurfaceOfUlna "anteromedial surface of ulna")
(documentation MedialAnteriorSurfaceOfUlna EnglishWrittenLanguage "The superficial bony region of the ulna facing anteriorly
    and medially in the standard anatomical position.")

(subclass PronatorQuadratusMuscle Muscle)
(termFormat EnglishWrittenLanguage PronatorQuadratusMuscle "pronator quadratus muscle")
(muscleOrigin PronatorQuadratusMuscle MedialAnteriorSurfaceOfUlna)
(muscleInsertion PronatorQuadratusMuscle LateralAnteriorSurfaceOfRadius)
(suppliesBlood AnteriorInterosseousArtery PronatorQuadratusMuscle)
(ennervates AnteriorInterosseousNerve PronatorQuadratusMuscle)
(subclass AnteriorInterosseousNerveMedianNerve Nerve)
(termFormat EnglishWrittenLanguage AnteriorInterosseousNerve "anterior interosseous nerve (median nerve)")
(documentation PronatorQuadratusMuscle EnglishWrittenLanguage "The &%PronatorQuadratusMuscle weakly pronates forearm.")
(antagonistMuscles SupinatorMuscle PronatorQuadratusMuscle)

(subclass DistalPhalanx Bone)
(termFormat EnglishWrittenLanguage DistalPhalanx "distal phalanx")
(documentation DistalPhalanx EnglishWrittenLanguage "The terminal phalangeal bone of a finger or toe, supporting
    the tip of the digit.")

(subclass FlexorDigitorumProfundusMuscle Muscle)
(termFormat EnglishWrittenLanguage FlexorDigitorumProfundusMuscle "flexor digitorum profundus muscle")
(muscleOrigin FlexorDigitorumProfundusMuscle Ulna)
(muscleInsertion FlexorDigitorumProfundusMuscle DistalPhalanx)
(suppliesBlood AnteriorInterosseousArtery FlexorDigitorumProfundusMuscle)
(ennervates AnteriorInterosseousNerve FlexorDigitorumProfundusMuscle)
(documentation FlexorDigitorumProfundusMuscle EnglishWrittenLanguage "The &%FlexorDigitorumProfundusMuscle flexes wrist, flexes interphalangeal joints.")
(antagonistMuscles ExtensorDigitorumMuscle FlexorDigitorumProfundusMuscle)

(subclass BaseOfDistalPhalanxOfThumb PalmBone)
(termFormat EnglishWrittenLanguage BaseOfDistalPhalanxOfThumb "base of distal phalanx of thumb")
(documentation BaseOfDistalPhalanxOfThumb EnglishWrittenLanguage "The expanded proximal portion of the thumb's distal phalanx,
    bearing the articular surface for the head of its proximal
    phalanx.")

(subclass FlexorPollicisLongusMuscle Muscle)
(termFormat EnglishWrittenLanguage FlexorPollicisLongusMuscle "flexor pollicis longus muscle")
(muscleOrigin FlexorPollicisLongusMuscle MiddleAnteriorSurfaceOfRadius)
(muscleOrigin FlexorPollicisLongusMuscle InterosseousMembraneOfForearm)
(muscleInsertion FlexorPollicisLongusMuscle BaseOfDistalPhalanxOfThumb)
(suppliesBlood AnteriorInterosseousArtery FlexorPollicisLongusMuscle)
(ennervates AnteriorInterosseousNerveMedianNerveC8T1 FlexorPollicisLongusMuscle)
(subclass AnteriorInterosseousNerveMedianNerveC8T1 Nerve)
(termFormat EnglishWrittenLanguage AnteriorInterosseousNerveMedianNerveC8T1 "anterior interosseous nerve (median nerve) (C8, T1)")
(documentation FlexorPollicisLongusMuscle EnglishWrittenLanguage "The &%FlexorPollicisLongusMuscle performs &%Flexion of  &%Thumb.")
(antagonistMuscles ExtensorPollicisLongusMuscle FlexorPollicisLongusMuscle)
(antagonistMuscles ExtensorPollicisBrevisMuscle FlexorPollicisLongusMuscle)

(subclass ExtensorDigitorumMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorDigitorumMuscle "extensor digitorum muscle")
(muscleOrigin ExtensorDigitorumMuscle LateralEpicondyleOfHumerus)
(muscleOrigin ExtensorDigitorumMuscle CommonExtensorTendon)
(muscleInsertion ExtensorDigitorumMuscle SecondNd5ThPhalanges)
(suppliesBlood PosteriorInterosseousArtery ExtensorDigitorumMuscle)
(ennervates PosteriorInterosseousNerveC7C8 ExtensorDigitorumMuscle)
(subclass PosteriorInterosseousNerveC7C8 Nerve)
(termFormat EnglishWrittenLanguage PosteriorInterosseousNerveC7C8 "posterior interosseous nerve (C7, C8)")
(documentation ExtensorDigitorumMuscle EnglishWrittenLanguage "The &%ExtensorDigitorumMuscle extends &%Hand, extends &%Fingers.")
(antagonistMuscles FlexorDigitorumSuperficialisMuscle ExtensorDigitorumMuscle)
(antagonistMuscles FlexorDigitorumProfundusMuscle ExtensorDigitorumMuscle)

(subclass ExtensorDigitiMinimiMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorDigitiMinimiMuscle "extensor digiti minimi muscle")
(muscleOrigin ExtensorDigitiMinimiMuscle LateralEpicondyleOfHumerus)
(muscleOrigin ExtensorDigitiMinimiMuscle CommonExtensorTendon)
(muscleInsertion ExtensorDigitiMinimiMuscle ExtensorExpansionLocatedAtBaseOfProximalPhalanxOnDorsalSide)
(suppliesBlood PosteriorInterosseousArtery ExtensorDigitiMinimiMuscle)
(ennervates PosteriorInterosseousNerveC7C8 ExtensorDigitiMinimiMuscle)
(documentation ExtensorDigitiMinimiMuscle EnglishWrittenLanguage "The &%ExtensorDigitiMinimiMuscle extends little &%Finger at all &%BodyJoints.")
(antagonistMuscles FlexorDigitiMinimiBrevisMuscle ExtensorDigitiMinimiMuscle)

(subclass FifthMetacarpal PalmBone)
(termFormat EnglishWrittenLanguage FifthMetacarpal "fifth metacarpal")
(documentation FifthMetacarpal EnglishWrittenLanguage "The metacarpal bone of the little finger, located along the ulnar
    side of the hand. Its base articulates with the hamate and the
    fourth metacarpal, and its head articulates with the proximal
    phalanx of the little finger.")

(subclass ExtensorCarpiUlnarisMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorCarpiUlnarisMuscle "extensor carpi ulnaris muscle")
(muscleOrigin ExtensorCarpiUlnarisMuscle LateralEpicondyleOfHumerus)
(muscleOrigin ExtensorCarpiUlnarisMuscle CommonExtensorTendon)
(muscleOrigin ExtensorCarpiUlnarisMuscle PosteriorBorderOfUlna)
(muscleInsertion ExtensorCarpiUlnarisMuscle FifthMetacarpal)
(suppliesBlood UlnarArtery ExtensorCarpiUlnarisMuscle)
(ennervates PosteriorInterosseousNerveC7C8 ExtensorCarpiUlnarisMuscle)
(documentation ExtensorCarpiUlnarisMuscle EnglishWrittenLanguage "The &%ExtensorCarpiUlnarisMuscle extends and adducts &%Wrist.")
(antagonistMuscles FlexorCarpiUlnarisMuscle ExtensorCarpiUlnarisMuscle)

(subclass LateralSupracondylarRidgeOfHumerus Bone)
(termFormat EnglishWrittenLanguage LateralSupracondylarRidgeOfHumerus "lateral supracondylar ridge of humerus")
(documentation LateralSupracondylarRidgeOfHumerus EnglishWrittenLanguage "A narrow bony ridge along the lateral border of the distal humerus,
    extending proximally from the lateral epicondyle. It provides sites
    of origin for the &%BrachioradialisMuscle and the
    &%ExtensorCarpiRadialisLongusMuscle.")

(subclass RadialStyloidProcessDistalRadius Bone)
(termFormat EnglishWrittenLanguage RadialStyloidProcessDistalRadius "styloid process of the distal radius")
(documentation RadialStyloidProcessDistalRadius EnglishWrittenLanguage "A pointed bony projection on the lateral (thumb-side) aspect of
    the distal end of the radius, near the wrist.")

(subclass BrachioradialisMuscle Muscle)
(termFormat EnglishWrittenLanguage BrachioradialisMuscle "brachioradialis muscle")
(muscleOrigin BrachioradialisMuscle LateralSupracondylarRidgeOfHumerus)
(muscleInsertion BrachioradialisMuscle RadialStyloidProcessDistalRadius)
(suppliesBlood RadialRecurrentArtery BrachioradialisMuscle)
(ennervates RadialNerve BrachioradialisMuscle)
(documentation BrachioradialisMuscle EnglishWrittenLanguage "The &%BrachioradialisMuscle performs &%Flexion of  forearm, pronates forearm when supine, supinates forearm when prone.")

(subclass SecondMetacarpal PalmBone)
(termFormat EnglishWrittenLanguage SecondMetacarpal "second metacarpal")
(documentation SecondMetacarpal EnglishWrittenLanguage "The metacarpal bone associated with the index finger,
    extending from the distal carpal row to the proximal
    phalanx of that finger.")

(subclass ExtensorCarpiRadialisLongusMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorCarpiRadialisLongusMuscle "extensor carpi radialis longus muscle")
(muscleOrigin ExtensorCarpiRadialisLongusMuscle LateralSupracondylarRidgeOfHumerus)
(muscleInsertion ExtensorCarpiRadialisLongusMuscle SecondMetacarpal)
(suppliesBlood RadialArtery ExtensorCarpiRadialisLongusMuscle)
(ennervates RadialNerve ExtensorCarpiRadialisLongusMuscle)
(documentation ExtensorCarpiRadialisLongusMuscle EnglishWrittenLanguage "The &%ExtensorCarpiRadialisLongusMuscle extends &%Wrist &%BodyJoint, abducts &%Hand at &%Wrist.")
(antagonistMuscles FlexorCarpiRadialisMuscle ExtensorCarpiRadialisLongusMuscle)

(subclass BaseOf3RdMetacarpal PalmBone)
(termFormat EnglishWrittenLanguage BaseOf3RdMetacarpal "base of third metacarpal")
(documentation BaseOf3RdMetacarpal EnglishWrittenLanguage "The proximal, expanded portion of the third metacarpal bone,
    located at the wrist end of the metacarpal associated with
    the middle finger.")

(subclass ExtensorCarpiRadialisBrevisMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorCarpiRadialisBrevisMuscle "extensor carpi radialis brevis muscle")
(muscleOrigin ExtensorCarpiRadialisBrevisMuscle LateralEpicondyleOfHumerus)
(muscleOrigin ExtensorCarpiRadialisBrevisMuscle CommonExtensorTendon)
(muscleInsertion ExtensorCarpiRadialisBrevisMuscle BaseOf3RdMetacarpal)
(suppliesBlood RadialArtery ExtensorCarpiRadialisBrevisMuscle)
(ennervates PosteriorInterosseusNerve ExtensorCarpiRadialisBrevisMuscle)
(subclass PosteriorInterosseusNerve Nerve)
(termFormat EnglishWrittenLanguage PosteriorInterosseusNerve "posterior interosseus nerve")
(documentation ExtensorCarpiRadialisBrevisMuscle EnglishWrittenLanguage "The &%ExtensorCarpiRadialisBrevisMuscle extends &%Wrist &%BodyJoint, abducts &%Hand at &%Wrist.")
(antagonistMuscles FlexorCarpiRadialisMuscle ExtensorCarpiRadialisBrevisMuscle)

(subclass LateralProximalShaftOfRadius ArmBone)
(termFormat EnglishWrittenLanguage LateralProximalShaftOfRadius "lateral proximal shaft of radius")
(documentation LateralProximalShaftOfRadius EnglishWrittenLanguage "The lateral bony region of the radial shaft near the elbow,
    distal to the neck of the radius.")

(subclass SupinatorMuscle Muscle)
(termFormat EnglishWrittenLanguage SupinatorMuscle "supinator muscle")
(muscleOrigin SupinatorMuscle LateralEpicondyleOfHumerus)
(muscleOrigin SupinatorMuscle SupinatorCrestOfUlna)
(muscleOrigin SupinatorMuscle RadialCollateralLigamentOfElbow)
(muscleOrigin SupinatorMuscle AnnularLigamentOfRadius)
(muscleInsertion SupinatorMuscle LateralProximalShaftOfRadius)
(suppliesBlood RadialRecurrentArtery SupinatorMuscle)
(ennervates PosteriorInterosseusNerveC7C8 SupinatorMuscle)
(subclass PosteriorInterosseusNerveC7C8 Nerve)
(termFormat EnglishWrittenLanguage PosteriorInterosseusNerveC7C8 "posterior interosseus nerve (C7, C8)")
(documentation SupinatorMuscle EnglishWrittenLanguage "The &%SupinatorMuscle supinates forearm.")
(antagonistMuscles PronatorTeresMuscle SupinatorMuscle)
(antagonistMuscles PronatorQuadratusMuscle SupinatorMuscle)

(subclass IndexFingerExtensorHood ExtensorExpansion)
(termFormat EnglishWrittenLanguage IndexFingerExtensorHood "extensor hood of index finger")
(documentation IndexFingerExtensorHood EnglishWrittenLanguage "The extensor expansion on the dorsal surface of the index finger into which the extensor tendons and intrinsic hand muscles insert.")

(subclass ExtensorIndicisMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorIndicisMuscle "extensor indicis muscle")
(muscleOrigin ExtensorIndicisMuscle Ulna)
(muscleInsertion ExtensorIndicisMuscle IndexFingerExtensorHood)
(ennervates PosteriorInterosseusNerveC7C8 ExtensorIndicisMuscle)
(documentation ExtensorIndicisMuscle EnglishWrittenLanguage "The &%ExtensorIndicisMuscle extends index &%Finger, &%Wrist.")

(subclass FirstMetacarpal PalmBone)
(termFormat EnglishWrittenLanguage FirstMetacarpal "first metacarpal")
(documentation FirstMetacarpal EnglishWrittenLanguage "The metacarpal bone associated with the thumb, situated
    between the trapezium and the thumb's proximal phalanx.")

(subclass AdductorPollicisMuscle Muscle)
(termFormat EnglishWrittenLanguage AdductorPollicisMuscle "adductor pollicis muscle")
(documentation AdductorPollicisMuscle EnglishWrittenLanguage "An intrinsic hand muscle with oblique and transverse heads
    that adducts the thumb and contributes to pinch grip.")

(subclass AbductorPollicisLongusMuscle Muscle)
(termFormat EnglishWrittenLanguage AbductorPollicisLongusMuscle "abductor pollicis longus muscle")
(muscleOrigin AbductorPollicisLongusMuscle Ulna)
(muscleInsertion AbductorPollicisLongusMuscle FirstMetacarpal)
(suppliesBlood PosteriorInterosseousArtery AbductorPollicisLongusMuscle)
(ennervates PosteriorInterosseousNerveC7C8 AbductorPollicisLongusMuscle)
(documentation AbductorPollicisLongusMuscle EnglishWrittenLanguage "The &%AbductorPollicisLongusMuscle abducts and extends &%Thumb.")
(antagonistMuscles AdductorPollicisMuscle AbductorPollicisLongusMuscle)

(subclass ProximalPhalanxOfThumb PalmBone)

(termFormat EnglishWrittenLanguage ProximalPhalanxOfThumb "proximal phalanx of thumb")

(documentation ProximalPhalanxOfThumb EnglishWrittenLanguage "The bone of the thumb situated between the first metacarpal and
    the distal phalanx of the thumb. Its base articulates with the
    first metacarpal, and its head articulates with the distal
    phalanx of the thumb.")

(subclass ExtensorPollicisBrevisMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorPollicisBrevisMuscle "extensor pollicis brevis muscle")
(muscleOrigin ExtensorPollicisBrevisMuscle PosteriorSurfaceOfRadius)
(muscleOrigin ExtensorPollicisBrevisMuscle InterosseousMembraneOfForearm)
(muscleInsertion ExtensorPollicisBrevisMuscle ProximalPhalanxOfThumb)
(suppliesBlood PosteriorInterosseousArtery ExtensorPollicisBrevisMuscle)
(ennervates PosteriorInterosseousNerveC7C8 ExtensorPollicisBrevisMuscle)
(documentation ExtensorPollicisBrevisMuscle EnglishWrittenLanguage "The &%ExtensorPollicisBrevisMuscle extends &%Thumb at metacarpophalangeal &%BodyJoint.")
(antagonistMuscles FlexorPollicisLongusMuscle ExtensorPollicisBrevisMuscle)
(antagonistMuscles FlexorPollicisBrevisMuscle ExtensorPollicisBrevisMuscle)

(subclass DistalPhalanxOfThumb PalmBone)
(termFormat EnglishWrittenLanguage DistalPhalanxOfThumb "distal phalanx of thumb")
(documentation DistalPhalanxOfThumb EnglishWrittenLanguage "The terminal bone of the thumb, articulating proximally
    with its proximal phalanx and supporting the thumb tip.")

(subclass ExtensorPollicisLongusMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorPollicisLongusMuscle "extensor pollicis longus muscle")
(muscleOrigin ExtensorPollicisLongusMuscle PosteriorSurfaceOfUlna)
(muscleOrigin ExtensorPollicisLongusMuscle InterosseousMembraneOfForearm)
(muscleInsertion ExtensorPollicisLongusMuscle DistalPhalanxOfThumb)
(suppliesBlood PosteriorInterosseousArtery ExtensorPollicisLongusMuscle)
(ennervates PosteriorInterosseousNerveC7C8 ExtensorPollicisLongusMuscle)
(documentation ExtensorPollicisLongusMuscle EnglishWrittenLanguage "The &%ExtensorPollicisLongusMuscle extends &%Thumb (metacarpophalangeal and interphalangeal).")
(antagonistMuscles FlexorPollicisLongusMuscle ExtensorPollicisLongusMuscle)
(antagonistMuscles FlexorPollicisBrevisMuscle ExtensorPollicisLongusMuscle)

(subclass SuperficialPalmarArch Artery)
(termFormat EnglishWrittenLanguage SuperficialPalmarArch "superficial palmar arch")
(documentation SuperficialPalmarArch EnglishWrittenLanguage "An arterial arch in the superficial part of the palm, formed primarily by the ulnar artery and usually completed by a branch of the radial artery.")

(subclass OpponensPollicisMuscle Muscle)
(termFormat EnglishWrittenLanguage OpponensPollicisMuscle "opponens pollicis muscle")
(muscleOrigin OpponensPollicisMuscle TrapeziumBone)
(muscleOrigin OpponensPollicisMuscle FlexorRetinaculumOfHand)
(muscleInsertion OpponensPollicisMuscle MetacarpalBoneOfThumbOnItsRadialSide)
(suppliesBlood SuperficialPalmarArch OpponensPollicisMuscle)
(ennervates MedianNerve OpponensPollicisMuscle)
(documentation OpponensPollicisMuscle EnglishWrittenLanguage "The &%OpponensPollicisMuscle opposes &%Thumb.")

(subclass ThumbProximalPhalanx ProximalPhalanxOfThumb)
(termFormat EnglishWrittenLanguage ThumbProximalPhalanx
    "proximal phalanx of thumb")
(documentation ThumbProximalPhalanx EnglishWrittenLanguage
    "The proximal of the two phalanges forming a human thumb, located between the first metacarpal and the distal phalanx.")

