(subclass TwoOccipitalBelliesAnd2FrontalBellies BodyPart)
(termFormat EnglishWrittenLanguage TwoOccipitalBelliesAnd2FrontalBellies "paired occipital and frontal bellies")
(documentation TwoOccipitalBelliesAnd2FrontalBellies EnglishWrittenLanguage "The paired occipital and frontal muscle bellies that form the
    muscular portions of the &%OccipitofrontalisMuscle.")

(subclass OccipitofrontalisMuscle Muscle)
(muscleOrigin OccipitofrontalisMuscle TwoOccipitalBelliesAnd2FrontalBellies)
(muscleInsertion OccipitofrontalisMuscle EpicranialAponeurosis)
(ennervates FacialNerveCNVII OccipitofrontalisMuscle)
(subclass FacialNerveCNVII Nerve)
(documentation OccipitofrontalisMuscle EnglishWrittenLanguage "The &%OccipitofrontalisMuscle raises &%Eyebrows.
The occipitofrontalis muscle (epicranius muscle) is a &%Muscle which covers parts of the skull. It
consists of two parts or bellies: the occipital belly, near the occipital bone, and the frontal belly,
near the frontal bone. It is supplied by the &%SupraorbitalArtery, the supratrochlear artery, and the
occipital artery. It is innervated by the facial nerve. In humans, the occipitofrontalis helps to
create facial expressions.[from Wikipedia]")
(externalImage OccipitofrontalisMuscle "https://upload.wikimedia.org/wikipedia/commons/f/fa/Gray378.png")
(termFormat EnglishWrittenLanguage OccipitofrontalisMuscle "occipitofrontalis")
(termFormat EnglishWrittenLanguage FacialNerveCNVII "facial nerve [CNVII]")

(subclass EpicranialAponeurosis Tendon)
(termFormat EnglishWrittenLanguage EpicranialAponeurosis "epicranial aponeurosis")
(documentation EpicranialAponeurosis EnglishWrittenLanguage "A broad, flat sheet of tendinous tissue covering the upper part
    of the skull and connecting the frontal and occipital bellies
    of the &%OccipitofrontalisMuscle. Also called the galea
    aponeurotica.")

(subclass SuperiorNuchalLineOfOccipitalBone OccipitalBone)
(termFormat EnglishWrittenLanguage SuperiorNuchalLineOfOccipitalBone "superior nuchal line of occipital bone")
(documentation SuperiorNuchalLineOfOccipitalBone EnglishWrittenLanguage "A curved bony ridge on the external surface of the occipital
    bone that provides attachment sites for muscles and fascia.")

(subclass MastoidPartOfTemporalBone Bone)
(termFormat EnglishWrittenLanguage MastoidPartOfTemporalBone "mastoid part of temporal bone")
(documentation MastoidPartOfTemporalBone EnglishWrittenLanguage "The posterior portion of the temporal bone that includes the
    mastoid process.")

(subclass OccipitalisMuscle Muscle)
(termFormat EnglishWrittenLanguage OccipitalisMuscle "occipitalis muscle")
(muscleOrigin OccipitalisMuscle SuperiorNuchalLineOfOccipitalBone)
(muscleOrigin OccipitalisMuscle MastoidPartOfTemporalBone)
(muscleInsertion OccipitalisMuscle EpicranialAponeurosis)
(suppliesBlood OccipitalArtery OccipitalisMuscle)
(ennervates PosteriorAuricularNerveFacialNerveCNVII OccipitalisMuscle)
(subclass PosteriorAuricularNerveFacialNerveCNVII Nerve)
(termFormat EnglishWrittenLanguage PosteriorAuricularNerveFacialNerveCNVII "posterior auricular nerve (facial nerve [CNVII])")
(documentation OccipitalisMuscle EnglishWrittenLanguage "The &%OccipitalisMuscle retracts scalp.")

(subclass FrontalisMuscle Muscle)
(termFormat EnglishWrittenLanguage FrontalisMuscle "frontalis muscle")
(muscleOrigin FrontalisMuscle FrontalBone)
; ; (muscleInsertion FrontalisMuscle Lateral palpebral raphe)
(suppliesBlood OphthalmicArtery FrontalisMuscle)
(ennervates TemporalBranchOfFacialNerveCNVII FrontalisMuscle)
(subclass TemporalBranchOfFacialNerveCNVII Nerve)
(termFormat EnglishWrittenLanguage TemporalBranchOfFacialNerveCNVII "temporal branch of facial nerve [CNVII]")
(documentation FrontalisMuscle EnglishWrittenLanguage "The &%FrontalisMuscle wrinkles &%Eyebrow.")

(subclass OrbicularisOculiMuscle Muscle)
(termFormat EnglishWrittenLanguage OrbicularisOculiMuscle "orbicularis oculi muscle")
(muscleOrigin OrbicularisOculiMuscle SkinOfEyebrowAndGlabella)
(muscleInsertion OrbicularisOculiMuscle EpicranialAponeurosis)
(suppliesBlood OphthalmicArtery OrbicularisOculiMuscle)
(ennervates ZygomaticBranchOfFacialNerveCNVII OrbicularisOculiMuscle)
(subclass ZygomaticBranchOfFacialNerveCNVII Nerve)
(termFormat EnglishWrittenLanguage ZygomaticBranchOfFacialNerveCNVII "zygomatic branch of facial nerve [CNVII]")
(documentation OrbicularisOculiMuscle EnglishWrittenLanguage "The &%OrbicularisOculiMuscle closes the &%Eyelid.")

(subclass NasalPartOfFrontalBone Bone)
(termFormat EnglishWrittenLanguage NasalPartOfFrontalBone "nasal part of frontal bone")
(documentation NasalPartOfFrontalBone EnglishWrittenLanguage "The portion of the frontal bone between its orbital parts
    that contributes to the root of the nose and articulates
    with the nasal bones and frontal processes of the maxillae.")

(subclass CorrugatorSuperciliiMuscle Muscle)
(termFormat EnglishWrittenLanguage CorrugatorSuperciliiMuscle "corrugator supercilii muscle")
(muscleOrigin CorrugatorSuperciliiMuscle NasalPartOfFrontalBone)
(muscleInsertion CorrugatorSuperciliiMuscle IntermediateThirdOfSkinOfEyebrow)
(suppliesBlood OphthalmicArtery CorrugatorSuperciliiMuscle)
(ennervates ZygomaticBranchOfFacialNerveCNVII CorrugatorSuperciliiMuscle)
(documentation CorrugatorSuperciliiMuscle EnglishWrittenLanguage "The &%CorrugatorSuperciliiMuscle moves skin of &%Forehead medially and inferiorly (towards root of &%Nose).")

(subclass DepressorSuperciliiMuscle Muscle)
(termFormat EnglishWrittenLanguage DepressorSuperciliiMuscle "depressor supercilii muscle")
(muscleOrigin DepressorSuperciliiMuscle NasalPartOfFrontalBone)
(muscleOrigin DepressorSuperciliiMuscle MedialOrbitalMargin)
(muscleInsertion DepressorSuperciliiMuscle MedialThirdOfSkinOfEyebrow)
(ennervates ZygomaticBranchOfFacialNerveCNVII DepressorSuperciliiMuscle)
(documentation DepressorSuperciliiMuscle EnglishWrittenLanguage "The &%DepressorSuperciliiMuscle moves skin of &%Eyebrows inferiorly.")

(subclass TarsalPlateUpperEyelid SuperiorTarsalPlateOfEyelid)
(termFormat EnglishWrittenLanguage TarsalPlateUpperEyelid
    "tarsal plate of upper eyelid")
(documentation TarsalPlateUpperEyelid EnglishWrittenLanguage
    "The dense plate of connective tissue within the upper eyelid that supports the eyelid and receives muscular attachments.")

(subclass LevatorPalpebraeSuperiorisMuscle Muscle)
(termFormat EnglishWrittenLanguage LevatorPalpebraeSuperiorisMuscle "levator palpebrae superioris muscle")
(muscleOrigin LevatorPalpebraeSuperiorisMuscle SphenoidBone)
(muscleInsertion LevatorPalpebraeSuperiorisMuscle TarsalPlateUpperEyelid)
(suppliesBlood OphthalmicArtery LevatorPalpebraeSuperiorisMuscle)
(ennervates OculomotorNerveCNIII LevatorPalpebraeSuperiorisMuscle)
(subclass OculomotorNerveCNIII Nerve)
(termFormat EnglishWrittenLanguage OculomotorNerveCNIII "oculomotor nerve [CNIII]")
(documentation LevatorPalpebraeSuperiorisMuscle EnglishWrittenLanguage "The &%LevatorPalpebraeSuperiorisMuscle retracts and elevates the &%Eyelid.")
(antagonistMuscles OrbicularisOculiMuscle LevatorPalpebraeSuperiorisMuscle)

(subclass SuperiorTarsalPlateOfEyelid BodyPart)
(termFormat EnglishWrittenLanguage SuperiorTarsalPlateOfEyelid "superior tarsal plate of eyelid")
(documentation SuperiorTarsalPlateOfEyelid EnglishWrittenLanguage "A dense plate of connective tissue within the upper eyelid that provides structural support and attachment for muscles acting on the eyelid.")

(subclass SuperiorTarsalMuscle Muscle)
(termFormat EnglishWrittenLanguage SuperiorTarsalMuscle "superior tarsal muscle")
(termFormat EnglishWrittenLanguage SuperiorTarsalMuscle "Muller's muscle")
(muscleOrigin SuperiorTarsalMuscle UndersideOfLevatorPalpebraeSuperioris)
(muscleInsertion SuperiorTarsalMuscle SuperiorTarsalPlateOfEyelid)
(suppliesBlood OphthalmicArtery SuperiorTarsalMuscle)
; (ennervates SympatheticNervousSystem SuperiorTarsalMuscle) (subclass
; SympatheticNervousSystem Nerve) (termFormat EnglishWrittenLanguage
; SympatheticNervousSystem "sympathetic nervous system")
(documentation SuperiorTarsalMuscle EnglishWrittenLanguage "The &%SuperiorTarsalMuscle raises upper &%eyelid.")

(subclass AnnulusOfZinnAtOrbitalApex Tendon)
(termFormat EnglishWrittenLanguage AnnulusOfZinnAtOrbitalApex "annulus of Zinn at orbital apex")
(documentation AnnulusOfZinnAtOrbitalApex EnglishWrittenLanguage "The common tendinous ring at the apex of the orbit from which the superior, inferior, medial, and lateral rectus muscles originate.")

(subclass SuperiorRectusMuscle Muscle)
(termFormat EnglishWrittenLanguage SuperiorRectusMuscle "superior rectus muscle")
(muscleOrigin SuperiorRectusMuscle AnnulusOfZinnAtOrbitalApex)
(muscleInsertion SuperiorRectusMuscle SuperiorRectusScleralInsertion)
(suppliesBlood OphthalmicArtery SuperiorRectusMuscle)
(ennervates SuperiorBranchOfOculomotorNerveCNIII SuperiorRectusMuscle)
(subclass SuperiorBranchOfOculomotorNerveCNIII Nerve)
(termFormat EnglishWrittenLanguage SuperiorBranchOfOculomotorNerveCNIII "superior branch of oculomotor nerve [CNIII]")
(documentation SuperiorRectusMuscle EnglishWrittenLanguage "The &%SuperiorMuscle elevates, adducts, and medially rotates eye.")

(subclass InferiorRectusMuscle Muscle)
(termFormat EnglishWrittenLanguage InferiorRectusMuscle "inferior rectus muscle")
(muscleOrigin InferiorRectusMuscle AnnulusOfZinnAtOrbitalApex)
(muscleInsertion InferiorRectusMuscle InferiorRectusScleralInsertion)
(suppliesBlood OphthalmicArtery InferiorRectusMuscle)
(ennervates InferiorBranchOfOculomotorNerveCNIII InferiorRectusMuscle)
(subclass InferiorBranchOfOculomotorNerveCNIII Nerve)
(termFormat EnglishWrittenLanguage InferiorBranchOfOculomotorNerveCNIII "inferior branch of oculomotor nerve [CNIII]")
(documentation InferiorRectusMuscle EnglishWrittenLanguage "The &%InferiorMuscle depresses and adducts eye.")

(subclass MedialRectusMuscle Muscle)
(termFormat EnglishWrittenLanguage MedialRectusMuscle "medial rectus muscle")
(muscleOrigin MedialRectusMuscle AnnulusOfZinnAtOrbitalApex)
(muscleInsertion MedialRectusMuscle MedialRectusScleralInsertion)
(suppliesBlood OphthalmicArtery MedialRectusMuscle)
(ennervates InferiorBranchOfOculomotorNerveCNIII MedialRectusMuscle)
(documentation MedialRectusMuscle EnglishWrittenLanguage "The &%MedialMuscle adducts eye.")

(subclass LateralRectusMuscle Muscle)
(termFormat EnglishWrittenLanguage LateralRectusMuscle "lateral rectus muscle")
(muscleOrigin LateralRectusMuscle AnnulusOfZinnAtOrbitalApex)
(muscleInsertion LateralRectusMuscle LateralRectusScleralInsertion)
(suppliesBlood OphthalmicArtery LateralRectusMuscle)
(ennervates AbducensNerveCNVI LateralRectusMuscle)
(subclass AbducensNerveCNVI Nerve)
(termFormat EnglishWrittenLanguage AbducensNerveCNVI "abducens nerve [CNVI]")
(documentation LateralRectusMuscle EnglishWrittenLanguage "The &%LateralMuscle abducts eye.")

(subclass LateralMuscularBranchOfOphthalmicArtery Artery)
(termFormat EnglishWrittenLanguage LateralMuscularBranchOfOphthalmicArtery "lateral muscular branch of ophthalmic artery")
(documentation LateralMuscularBranchOfOphthalmicArtery EnglishWrittenLanguage "A muscular branch of the ophthalmic artery that supplies extraocular muscles on the lateral side of the orbit.")

(subclass SuperiorObliqueMuscle Muscle)
(termFormat EnglishWrittenLanguage SuperiorObliqueMuscle "superior oblique muscle")
(muscleOrigin SuperiorObliqueMuscle SphenoidBodySuperiorMedialToOpticCanal)
(muscleInsertion SuperiorObliqueMuscle OuterPosteriorQuadrantOfEyeball)
(suppliesBlood LateralMuscularBranchOfOphthalmicArtery SuperiorObliqueMuscle)
(ennervates TrochlearNerveCNIV SuperiorObliqueMuscle)
(subclass TrochlearNerveCNIV Nerve)
(termFormat EnglishWrittenLanguage TrochlearNerveCNIV "trochlear nerve [CNIV]")
(documentation SuperiorObliqueMuscle EnglishWrittenLanguage "The &%SuperiorMuscle intorts, abducts, and depress eye.")

(subclass InferiorObliqueMuscle Muscle)
(termFormat EnglishWrittenLanguage InferiorObliqueMuscle "inferior oblique muscle")
(muscleOrigin InferiorObliqueMuscle OrbitalSurfaceOfMaxillaLateralToLacrimalGroove)
(muscleInsertion InferiorObliqueMuscle LaterallyOntoEyeballDeepToLateralRectusByAShortFlatTendon)
(ennervates OculomotorNerveCNIII InferiorObliqueMuscle)
(documentation InferiorObliqueMuscle EnglishWrittenLanguage "The &%InferiorMuscle extorts, elevates, and abducts eye.")

(subclass TemporoparietalisMuscle Muscle)
(termFormat EnglishWrittenLanguage TemporoparietalisMuscle "temporoparietalis muscle")
(muscleOrigin TemporoparietalisMuscle AuricularesMuscles)
(muscleInsertion TemporoparietalisMuscle EpicranialAponeurosis)
(ennervates FacialNerveCNVII TemporoparietalisMuscle)
(externalImage TemporoparietalisMuscle "https://upload.wikimedia.org/wikipedia/commons/8/8c/Skeletal_muscles_homo_sapiens.JPG")

(subclass TemporalFascia BodyPart)
(termFormat EnglishWrittenLanguage TemporalFascia "temporal fascia")
(documentation TemporalFascia EnglishWrittenLanguage "The dense fascial sheet covering the temporalis muscle,
    extending from the superior temporal line to the zygomatic arch.")

(subclass FrontOfHelixOfEar BodyPart)
(termFormat EnglishWrittenLanguage FrontOfHelixOfEar
    "anterior part of helix of ear")
(documentation FrontOfHelixOfEar EnglishWrittenLanguage
    "The anterior region of the helix of the auricle, providing an attachment for the auricularis anterior muscle.")

(subclass AuricularisAnteriorMuscle Muscle)
(termFormat EnglishWrittenLanguage AuricularisAnteriorMuscle "auricularis anterior muscle")
(muscleOrigin AuricularisAnteriorMuscle TemporalFascia)
(muscleInsertion AuricularisAnteriorMuscle FrontOfHelixOfEar)
(suppliesBlood PosteriorAuricularArtery AuricularisAnteriorMuscle)
(ennervates FacialNerveCNVII AuricularisAnteriorMuscle)
(documentation AuricularisAnteriorMuscle EnglishWrittenLanguage "The &%AuricularisAnteriorMuscle pulls auricle forwards.")

(subclass AuricularisSuperiorMuscle Muscle)
(termFormat EnglishWrittenLanguage AuricularisSuperiorMuscle "auricularis superior muscle")
(muscleOrigin AuricularisSuperiorMuscle EpicranialAponeurosis)
(muscleInsertion AuricularisSuperiorMuscle DorsocranialSurfaceOfAuricle)
(suppliesBlood PosteriorAuricularArtery AuricularisSuperiorMuscle)
(ennervates FacialNerveCNVII AuricularisSuperiorMuscle)
(documentation AuricularisSuperiorMuscle EnglishWrittenLanguage "The &%AuricularisSuperiorMuscle pulls auricle upwards.")

(subclass MastoidProcessOfTemporalBone Bone)
(termFormat EnglishWrittenLanguage MastoidProcessOfTemporalBone "mastoid process of temporal bone")
(documentation MastoidProcessOfTemporalBone EnglishWrittenLanguage "A bony projection of the temporal bone located behind and below
    the external acoustic opening that provides attachment sites
    for neck muscles.")

(subclass DorsalPartOfAuricle BodyPart)
(termFormat EnglishWrittenLanguage DorsalPartOfAuricle
    "dorsal part of auricle")
(documentation DorsalPartOfAuricle EnglishWrittenLanguage
    "The posterior region of the auricle of the external ear, including the tissues to which the auricularis posterior muscle attaches.")

(subclass AuricularisPosteriorMuscle Muscle)
(termFormat EnglishWrittenLanguage AuricularisPosteriorMuscle "auricularis posterior muscle")
(muscleOrigin AuricularisPosteriorMuscle MastoidPartOfTemporalBone)
(muscleOrigin AuricularisPosteriorMuscle TendonOfSternocleidomastoid)
(muscleInsertion AuricularisPosteriorMuscle DorsalPartOfAuricle)
(suppliesBlood PosteriorAuricularArtery AuricularisPosteriorMuscle)
(ennervates FacialNerveCNVII AuricularisPosteriorMuscle)
(documentation AuricularisPosteriorMuscle EnglishWrittenLanguage "The &%AuricularisPosteriorMuscle pulls auricle backwards.")

(subclass NeckOfStapes Bone)
(termFormat EnglishWrittenLanguage NeckOfStapes "neck of stapes")
(documentation NeckOfStapes EnglishWrittenLanguage "The narrowed portion of the stapes between its head and
    crura, providing attachment for the stapedius tendon.")

(subclass StapediusMuscle Muscle)
(termFormat EnglishWrittenLanguage StapediusMuscle "stapedius muscle")
(muscleOrigin StapediusMuscle TipOfPyramidOfMiddleEar)
(muscleInsertion StapediusMuscle NeckOfStapes)
(suppliesBlood StapedialBranchOfPosteriorAuricularArtery StapediusMuscle)
(ennervates NerveToTheStapediusFromFacialNerveCNVII StapediusMuscle)
(subclass NerveToTheStapediusFromFacialNerveCNVII Nerve)
(termFormat EnglishWrittenLanguage NerveToTheStapediusFromFacialNerveCNVII "nerve to the stapedius from facial nerve [CNVII]")
(documentation StapediusMuscle EnglishWrittenLanguage "The &%StapediusMuscle reduces movement of stapes, controls amplitude of sound waves to inner ear.")

(subclass HandleOfMalleus Bone)
(termFormat EnglishWrittenLanguage HandleOfMalleus "handle of malleus")
(documentation HandleOfMalleus EnglishWrittenLanguage "The elongated portion of the malleus attached to the tympanic
    membrane, through which vibrations are transmitted to the
    ossicles of the middle ear.")

(subclass TensorTympaniMuscle Muscle)
(termFormat EnglishWrittenLanguage TensorTympaniMuscle "tensor tympani muscle")
(muscleOrigin TensorTympaniMuscle EustachianTube)
(muscleInsertion TensorTympaniMuscle HandleOfMalleus)
(suppliesBlood SuperiorTympanicArtery TensorTympaniMuscle)
(ennervates MedialPterygoidNerveFromMandibularNerveCNV3 TensorTympaniMuscle)
(subclass MedialPterygoidNerveFromMandibularNerveCNV3 Nerve)
(termFormat EnglishWrittenLanguage MedialPterygoidNerveFromMandibularNerveCNV3 "medial pterygoid nerve from mandibular nerve [CNV3]")
(documentation TensorTympaniMuscle EnglishWrittenLanguage "The &%TensorTympaniMuscle tenses tympanic membrane, controls amplitude of sound waves to inner ear.")

(subclass ProcerusMuscleMuscle Muscle)
(termFormat EnglishWrittenLanguage ProcerusMuscleMuscle "procerus muscle")
(muscleOrigin ProcerusMuscleMuscle FasciaOverLowerPartOfNasalBone)
(muscleInsertion ProcerusMuscleMuscle SkinOfLowerPartOfForeheadBetweenEyebrows)
(suppliesBlood FacialArtery ProcerusMuscleMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII ProcerusMuscleMuscle)
(subclass BuccalBranchOfFacialNerveCNVII Nerve)
(termFormat EnglishWrittenLanguage BuccalBranchOfFacialNerveCNVII "buccal branch of facial nerve [CNVII]")
(documentation ProcerusMuscleMuscle EnglishWrittenLanguage "The &%ProcerusMuscleMuscle draws down medial angle of &%Eyebrow (giving expressions of frowning).")

(subclass IncisiveFossaOfMaxilla Bone)
(termFormat EnglishWrittenLanguage IncisiveFossaOfMaxilla "incisive fossa of maxilla")
(documentation IncisiveFossaOfMaxilla EnglishWrittenLanguage "A shallow bony depression on the anterior surface of the maxilla above the incisor teeth and below the nasal aperture.")

(subclass DepressorSeptiNasiMuscle Muscle)
(termFormat EnglishWrittenLanguage DepressorSeptiNasiMuscle "depressor septi nasi muscle")
(muscleOrigin DepressorSeptiNasiMuscle IncisiveFossaOfMaxilla)
(muscleInsertion DepressorSeptiNasiMuscle MobileNasalSeptum)
(muscleInsertion DepressorSeptiNasiMuscle PosteriorAlarNasalisFibers)
(suppliesBlood SuperiorLabialArtery DepressorSeptiNasiMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII DepressorSeptiNasiMuscle)
(documentation DepressorSeptiNasiMuscle EnglishWrittenLanguage "The &%DepressorSeptiNasiMuscle depresses nasal septum.")

(subclass FrontalProcessOfMaxilla Bone)
(termFormat EnglishWrittenLanguage FrontalProcessOfMaxilla "frontal process of maxilla")
(documentation FrontalProcessOfMaxilla EnglishWrittenLanguage "An upward projection of the maxilla beside the nose that
    articulates with the frontal, nasal, and lacrimal bones.")

(subclass LevatorLabiiSuperiorisAlaequeNasiMuscle Muscle)
(termFormat EnglishWrittenLanguage LevatorLabiiSuperiorisAlaequeNasiMuscle "levator labii superioris alaeque nasi muscle")
(muscleOrigin LevatorLabiiSuperiorisAlaequeNasiMuscle FrontalProcessOfMaxilla)
(muscleInsertion LevatorLabiiSuperiorisAlaequeNasiMuscle SkinNearMarginOfNostril)
(muscleInsertion LevatorLabiiSuperiorisAlaequeNasiMuscle SkinOfUpperLip)
(suppliesBlood SuperiorLabialArtery LevatorLabiiSuperiorisAlaequeNasiMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII LevatorLabiiSuperiorisAlaequeNasiMuscle)
(documentation LevatorLabiiSuperiorisAlaequeNasiMuscle EnglishWrittenLanguage "The &%LevatorLabiiSuperiorisAlaequeNasiMuscle dilates nostril, elevates upper &%Lip, elevates wing of &%Nose.")

(subclass LateralNasalCartilage Cartilage)
(termFormat EnglishWrittenLanguage LateralNasalCartilage "lateral nasal cartilage")
(documentation LateralNasalCartilage EnglishWrittenLanguage "One of the paired upper lateral cartilages supporting the
    sides of the external nose, inferior to the nasal bones.")

(subclass TransversePartCompressorNarisMuscle Muscle)
(termFormat EnglishWrittenLanguage TransversePartCompressorNarisMuscle "transverse part compressor naris muscle")
(muscleOrigin TransversePartCompressorNarisMuscle AlveolarYokeOfCanineTooth)
(muscleOrigin TransversePartCompressorNarisMuscle LateralNasalCartilage)
(suppliesBlood SuperiorLabialArtery TransversePartCompressorNarisMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII TransversePartCompressorNarisMuscle)
(documentation TransversePartCompressorNarisMuscle EnglishWrittenLanguage "compresses nostrils")

(subclass SkinNearMarginOfNostril BodyPart)
(termFormat EnglishWrittenLanguage SkinNearMarginOfNostril "skin near margin of nostril")
(documentation SkinNearMarginOfNostril EnglishWrittenLanguage "The cutaneous tissue adjacent to the rim of an external
    nasal opening.")

(subclass AlarPartDilatorNarisMuscle Muscle)
(termFormat EnglishWrittenLanguage AlarPartDilatorNarisMuscle "alar part dilator naris muscle")
(muscleOrigin AlarPartDilatorNarisMuscle AlveolarYokeOfIncisorTooth)
(muscleOrigin AlarPartDilatorNarisMuscle SkinNearMarginOfNostril)
(suppliesBlood SuperiorLabialArtery AlarPartDilatorNarisMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII AlarPartDilatorNarisMuscle)
(documentation AlarPartDilatorNarisMuscle EnglishWrittenLanguage "dilates nostrils")

(subclass ModiolusOfMouth BodyPart)
(termFormat EnglishWrittenLanguage ModiolusOfMouth "modiolus of mouth")
(documentation ModiolusOfMouth EnglishWrittenLanguage "A fibromuscular convergence of facial muscles near each
    corner of the mouth, contributing to movement and stability
    of the oral commissure.")

(subclass LevatorAngulaOrisMuscle Muscle)
(termFormat EnglishWrittenLanguage LevatorAngulaOrisMuscle "levator angula oris muscle")
(muscleOrigin LevatorAngulaOrisMuscle MaxillaBone)
(muscleOrigin LevatorAngulaOrisMuscle ModiolusOfMouth)
(suppliesBlood FacialArtery LevatorAngulaOrisMuscle)
(ennervates FacialNerveCNVII LevatorAngulaOrisMuscle)
(documentation LevatorAngulaOrisMuscle EnglishWrittenLanguage "elevates angle of mouth (smile)")
(antagonistMuscles LevatorAngulaOrisMuscle DepressorAnguliOrisMuscle)

(subclass DepressorAnguliOrisMuscle Muscle)
(termFormat EnglishWrittenLanguage DepressorAnguliOrisMuscle "depressor angula oris muscle")
(muscleOrigin DepressorAnguliOrisMuscle TubercleOfMandible)
(muscleOrigin DepressorAnguliOrisMuscle ModiolusOfMouth)
(suppliesBlood FacialArtery DepressorAnguliOrisMuscle)
(ennervates MandibularBranchOfFacialNerveCNVII DepressorAnguliOrisMuscle)
(documentation DepressorAnguliOrisMuscle EnglishWrittenLanguage "depresses angle of mouth (smile)")

(subclass LevatorLabiiSuperiorisMuscle Muscle)
(termFormat EnglishWrittenLanguage LevatorLabiiSuperiorisMuscle "levator labii superioris muscle")
(muscleOrigin LevatorLabiiSuperiorisMuscle MedialPartOfInfraOrbitalMarginOfMaxilla)
(muscleInsertion LevatorLabiiSuperiorisMuscle SkinOfUpperLip)
(muscleInsertion LevatorLabiiSuperiorisMuscle UpperLipMuscleFibers)
(suppliesBlood SuperiorLabialArtery LevatorLabiiSuperiorisMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII LevatorLabiiSuperiorisMuscle)
(documentation LevatorLabiiSuperiorisMuscle EnglishWrittenLanguage "The &%LevatorLabiiSuperiorisMuscle elevates upper &%Lip.")
(externalImage LevatorLabiiSuperiorisMuscle "https://upload.wikimedia.org/wikipedia/commons/8/8c/Skeletal_muscles_homo_sapiens.JPG")

(subclass DepressorLabiiInferiorisMuscle Muscle)
(termFormat EnglishWrittenLanguage DepressorLabiiInferiorisMuscle "depressor labii inferioris muscle")
(muscleOrigin DepressorLabiiInferiorisMuscle ObliqueLineOfMandibleBetweenSymphysisAndMentalForamen)
(muscleInsertion DepressorLabiiInferiorisMuscle SkinOfLowerLip)
(muscleInsertion DepressorLabiiInferiorisMuscle FibresOfOrbicularisOris)
(muscleInsertion DepressorLabiiInferiorisMuscle ContralateralDepressorLabiiInferiorisFibers)
(suppliesBlood InferiorLabialArtery DepressorLabiiInferiorisMuscle)
(ennervates MandibularBranchOfFacialNerveCNVII DepressorLabiiInferiorisMuscle)
(subclass MandibularBranchOfFacialNerveCNVII Nerve)
(termFormat EnglishWrittenLanguage MandibularBranchOfFacialNerveCNVII "mandibular branch of facial nerve [CNVII]")
(documentation DepressorLabiiInferiorisMuscle EnglishWrittenLanguage "The &%DepressorLabiiInferiorisMuscle depresses lower &%Lip.")

(subclass SkinOfChin BodyPart)
(termFormat EnglishWrittenLanguage SkinOfChin "skin of chin")
(documentation SkinOfChin EnglishWrittenLanguage "The cutaneous tissue covering the chin, below the lower lip
    and over the anterior prominence of the mandible.")

(subclass MentalisMuscle Muscle)
(termFormat EnglishWrittenLanguage MentalisMuscle "mentalis muscle")
(muscleOrigin MentalisMuscle AlveolarYokeOfLowerLateralIncisorToothFoundOnAnteriorMandible)
(muscleInsertion MentalisMuscle SkinOfChin)
(suppliesBlood InferiorLabialArtery MentalisMuscle)
(ennervates MandibularBranchOfFacialNerveCNVII MentalisMuscle)
(documentation MentalisMuscle EnglishWrittenLanguage "The &%MentalisMuscle elevates and wrinkles skin of &%Chin, protrudes lower &%Lip.")

(subclass BuccinatorMuscle Muscle)
(termFormat EnglishWrittenLanguage BuccinatorMuscle "buccinator muscle")
(muscleOrigin BuccinatorMuscle AlveolarProcessOfMaxilla)
(muscleOrigin BuccinatorMuscle AlveolarProcessOfMandible)
(muscleOrigin BuccinatorMuscle PterygomandibularRaphe)
(muscleInsertion BuccinatorMuscle FibresOfOrbicularisOris)
(suppliesBlood BuccalArtery BuccinatorMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII BuccinatorMuscle)
(documentation BuccinatorMuscle EnglishWrittenLanguage "The &%BuccinatorMuscle compress cheeks against teeth (&%Tooth) (blowing), mastication (&%Chewing).")

(subclass SkinAroundLips BodyPart)
(termFormat EnglishWrittenLanguage SkinAroundLips "skin around lips")
(documentation SkinAroundLips EnglishWrittenLanguage "The cutaneous tissue surrounding the lips in the perioral
    region of the face.")

(subclass OrbicularisOrisMuscle Muscle)
(termFormat EnglishWrittenLanguage OrbicularisOrisMuscle "orbicularis oris muscle")
(muscleOrigin OrbicularisOrisMuscle MaxillaBone)
(muscleOrigin OrbicularisOrisMuscle Mandible)
(muscleInsertion OrbicularisOrisMuscle SkinAroundLips)
(suppliesBlood SuperiorLabialArtery OrbicularisOrisMuscle)
(suppliesBlood InferiorLabialArtery OrbicularisOrisMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII OrbicularisOrisMuscle)
(documentation OrbicularisOrisMuscle EnglishWrittenLanguage "The &%OrbicularisOrisMuscle puckers &%Lips.")
(externalImage OrbicularisOrisMuscle "https://upload.wikimedia.org/wikipedia/commons/8/8c/Skeletal_muscles_homo_sapiens.JPG")

(subclass ParotidFascia BodyPart)
(termFormat EnglishWrittenLanguage ParotidFascia "parotid fascia")
(documentation ParotidFascia EnglishWrittenLanguage "The fibrous fascial covering surrounding the parotid gland,
    continuous with the fascia over the masseter muscle.")

(subclass RisoriusMuscle Muscle)
(termFormat EnglishWrittenLanguage RisoriusMuscle "risorius muscle")
(muscleOrigin RisoriusMuscle ParotidFascia)
(muscleInsertion RisoriusMuscle ModiolusOfMouth)
(suppliesBlood FacialArtery RisoriusMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII RisoriusMuscle)
(documentation RisoriusMuscle EnglishWrittenLanguage "The &%RisoriusMuscle draw back angle of &%Mouth.")

(subclass ZygomaticBoneInRegionOfZygomaticomaxillarySuture Bone)
(termFormat EnglishWrittenLanguage ZygomaticBoneInRegionOfZygomaticomaxillarySuture "zygomatic bone near zygomaticomaxillary suture")
(documentation ZygomaticBoneInRegionOfZygomaticomaxillarySuture EnglishWrittenLanguage "The superficial bony region of the zygomatic bone adjacent to its articulation with the maxilla, providing an origin for the zygomaticus muscles.")

(subclass ZygomaticMajorMuscle Muscle)
(termFormat EnglishWrittenLanguage ZygomaticMajorMuscle "zygomatic major muscle")
(muscleOrigin ZygomaticMajorMuscle ZygomaticBoneInRegionOfZygomaticomaxillarySuture)
(muscleInsertion ZygomaticMajorMuscle ModiolusOfMouth)
(suppliesBlood FacialArtery ZygomaticMajorMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII ZygomaticMajorMuscle)
(documentation ZygomaticMajorMuscle EnglishWrittenLanguage "The &%ZygomaticMajorMuscle draws angle of &%Mouth upward and laterally.")

(subclass SkinOfUpperLip BodyPart)
(termFormat EnglishWrittenLanguage SkinOfUpperLip "skin of upper lip")
(documentation SkinOfUpperLip EnglishWrittenLanguage "The cutaneous tissue covering the external portion of
    the upper lip.")

(subclass ZygomaticMinorMuscle Muscle)
(termFormat EnglishWrittenLanguage ZygomaticMinorMuscle "zygomatic minor muscle")
(muscleOrigin ZygomaticMinorMuscle ZygomaticBoneInRegionOfZygomaticomaxillarySuture)
(muscleInsertion ZygomaticMinorMuscle SkinOfUpperLip)
(suppliesBlood FacialArtery ZygomaticMinorMuscle)
(ennervates BuccalBranchOfFacialNerveCNVII ZygomaticMinorMuscle)
(documentation ZygomaticMinorMuscle EnglishWrittenLanguage "The &%ZygomaticMinorMuscle elevates upper &%Lip.")

(subclass MasseterMuscle Muscle)
(termFormat EnglishWrittenLanguage MasseterMuscle "masseter muscle")
(muscleOrigin MasseterMuscle AnteriorTwoThirdsOfInferiorBorderOfZygomaticArch)
(muscleOrigin MasseterMuscle ZygomaticProcessOfMaxilla)
(muscleInsertion MasseterMuscle AngleOfMandibleMassetericTuberosityOfMandible)
(suppliesBlood MassetericArtery MasseterMuscle)
(ennervates MassetericNerveFromMandibularNerveCNV3 MasseterMuscle)
(subclass MassetericNerveFromMandibularNerveCNV3 Nerve)
(termFormat EnglishWrittenLanguage MassetericNerveFromMandibularNerveCNV3 "masseteric nerve from mandibular nerve [CNV3]")
(documentation MasseterMuscle EnglishWrittenLanguage "The &%MasseterMuscle elevates and retracts mandible (closes &%Mouth).")
(antagonistMuscles PlatysmaMuscle MasseterMuscle)

(subclass CoronoidProcessOfMandible Bone)
(termFormat EnglishWrittenLanguage CoronoidProcessOfMandible "coronoid process of mandible")
(documentation CoronoidProcessOfMandible EnglishWrittenLanguage "The anterior superior projection of the mandibular ramus,
    providing an insertion site for the temporalis muscle.")

(subclass DeepTemporalArteries Artery)
(termFormat EnglishWrittenLanguage DeepTemporalArteries "deep temporal arteries")
(documentation DeepTemporalArteries EnglishWrittenLanguage "The class of arterial branches of the maxillary artery that
    ascend along the deep surface of the temporalis muscle
    and supply it.")

(subclass TemporalLinesOnParietalBoneOfSkull HeadBone)
(termFormat EnglishWrittenLanguage TemporalLinesOnParietalBoneOfSkull "temporal lines on parietal bone")
(documentation TemporalLinesOnParietalBoneOfSkull EnglishWrittenLanguage "A bony ridge forming either the superior or inferior temporal
    line on the external surface of a parietal bone. The superior
    line provides attachment for the temporal fascia, and the
    inferior line marks the upper limit of the temporalis origin.")

(subclass TemporalisMuscle Muscle)
(termFormat EnglishWrittenLanguage TemporalisMuscle "temporalis muscle")
(muscleOrigin TemporalisMuscle TemporalLinesOnParietalBoneOfSkull)
(muscleInsertion TemporalisMuscle CoronoidProcessOfMandible)
(suppliesBlood DeepTemporalArteries TemporalisMuscle)
(ennervates DeepTemporalNervesFromMandibularNerveCNV3 TemporalisMuscle)
(subclass DeepTemporalNervesFromMandibularNerveCNV3 Nerve)
(termFormat EnglishWrittenLanguage DeepTemporalNervesFromMandibularNerveCNV3 "deep temporal nerves from mandibular nerve [CNV3]")
(documentation TemporalisMuscle EnglishWrittenLanguage "The &%TemporalisMuscle elevates and retracts mandible (closes &%Mouth).")
(antagonistMuscles PlatysmaMuscle TemporalisMuscle)

(subclass CondyloidProcessOfMandible Bone)
(termFormat EnglishWrittenLanguage CondyloidProcessOfMandible "condyloid process of mandible")
(documentation CondyloidProcessOfMandible EnglishWrittenLanguage "The posterior superior projection of the mandibular ramus,
    comprising the mandibular head and neck and participating
    in the temporomandibular joint.")

(subclass PterygoidBranchesOfMaxillaryArtery Artery)
(termFormat EnglishWrittenLanguage PterygoidBranchesOfMaxillaryArtery "pterygoid branches of maxillary artery")
(documentation PterygoidBranchesOfMaxillaryArtery EnglishWrittenLanguage "The class of muscular branches of the maxillary artery
    supplying the medial and lateral pterygoid muscles.")

(subclass PterygoidLateralMuscle Muscle)
(termFormat EnglishWrittenLanguage PterygoidLateralMuscle "pterygoid lateral muscle")
(muscleOrigin PterygoidLateralMuscle GreaterWingOfSphenoid)
(muscleOrigin PterygoidLateralMuscle LateralPterygoidPlateOfSphenoid)
(muscleInsertion PterygoidLateralMuscle CondyloidProcessOfMandible)
(suppliesBlood PterygoidBranchesOfMaxillaryArtery PterygoidLateralMuscle)
(ennervates ExternalPterygoidNerveFromMandibularNerveCNV3 PterygoidLateralMuscle)
(subclass ExternalPterygoidNerveFromMandibularNerveCNV3 Nerve)
(termFormat EnglishWrittenLanguage ExternalPterygoidNerveFromMandibularNerveCNV3 "external pterygoid nerve from mandibular nerve [CNV3]")
(documentation PterygoidLateralMuscle EnglishWrittenLanguage "The &%LateralMuscle depresses mandible (opens &%Mouth).")
(antagonistMuscles MasseterMuscle PterygoidLateralMuscle)
(antagonistMuscles TemporalisMuscle PterygoidLateralMuscle)
(antagonistMuscles PterygoidMedialMuscle PterygoidLateralMuscle)

(subclass MedialAngleOfMandible HeadBone)
(termFormat EnglishWrittenLanguage MedialAngleOfMandible "medial surface of angle of mandible")
(documentation MedialAngleOfMandible EnglishWrittenLanguage "The bony region on the medial surface of the mandibular angle,
    where the body and ramus meet. It provides an attachment site
    for the medial pterygoid muscle.")

(subclass PterygoidMedialMuscle Muscle)
(termFormat EnglishWrittenLanguage PterygoidMedialMuscle "pterygoid medial muscle")
(muscleOrigin PterygoidMedialMuscle MedialSideOfLateralPterygoidPlateBehindUpperTeeth)
(muscleInsertion PterygoidMedialMuscle MedialAngleOfMandible)
(suppliesBlood PterygoidBranchesOfMaxillaryArtery PterygoidMedialMuscle)
(ennervates MedialPterygoidNerveFromMandibularNerveCNV3 PterygoidMedialMuscle)
(documentation PterygoidMedialMuscle EnglishWrittenLanguage "The &%PterygoidMedialMuscle elevates mandible, closes &%Jaw, helps lateral pterygoid in moving jaw from side to side.")

(subclass SuperiorPartOfMentalSpineOfMandible Bone)
(termFormat EnglishWrittenLanguage SuperiorPartOfMentalSpineOfMandible "superior part of mental spine of mandible")
(documentation SuperiorPartOfMentalSpineOfMandible EnglishWrittenLanguage "The superior mental spine region on the inner midline surface
    of the mandible, providing the origin of the genioglossus muscle.")

(subclass GenioglossusMuscle Muscle)
(termFormat EnglishWrittenLanguage GenioglossusMuscle "hyoglossus muscle")
(muscleOrigin GenioglossusMuscle SuperiorPartOfMentalSpineOfMandible)
(muscleInsertion GenioglossusMuscle DorsumOfTongue)
(suppliesBlood LingualArtery GenioglossusMuscle)
(ennervates HypoglossalNerveCNXII GenioglossusMuscle)
(subclass HypoglossalNerveCNXII Nerve)
(termFormat EnglishWrittenLanguage HypoglossalNerveCNXII "hypoglossal nerve [CNXII]")
(documentation GenioglossusMuscle EnglishWrittenLanguage "The &%GenioglossusMuscle inferior fibers:
protrudes tongue middle fibers: depresses tongue, superior fibers: draws tip of tongue back and down.")

(subclass HyoglossusMuscle Muscle)
(termFormat EnglishWrittenLanguage HyoglossusMuscle "hyoglossus muscle")
(muscleOrigin HyoglossusMuscle HyoidBone)
(muscleInsertion HyoglossusMuscle SideOfTongue)
(ennervates HypoglossalNerveCNXII HyoglossusMuscle)
(documentation HyoglossusMuscle EnglishWrittenLanguage "The &%HyoglossusMuscle depresses &%Tongue.")

(subclass ChondroglossusMuscle Muscle)
(termFormat EnglishWrittenLanguage ChondroglossusMuscle "chondroglossus muscle")
(muscleOrigin ChondroglossusMuscle LesserHornOfHyoidBone)
(muscleOrigin ChondroglossusMuscle BodyOfHyoidBone)
(muscleInsertion ChondroglossusMuscle IntrinsicMuscularFibersOfTongue)
(ennervates HypoglossalNerveCNXII ChondroglossusMuscle)
(documentation ChondroglossusMuscle EnglishWrittenLanguage "The &%ChondroglossusMuscle depresses &%Tongue (some consider this muscle to be part of hyoglossus).")

(subclass StyloidProcessOfTemporalBone Bone)
(termFormat EnglishWrittenLanguage StyloidProcessOfTemporalBone "styloid process of temporal bone")
(documentation StyloidProcessOfTemporalBone EnglishWrittenLanguage "A slender, pointed projection extending inferiorly from the
    temporal bone, providing attachment sites for muscles and
    ligaments associated with the tongue, pharynx, and hyoid.")

(subclass SublingualBranchOfLingualArtery Artery)
(termFormat EnglishWrittenLanguage SublingualBranchOfLingualArtery "sublingual branch of lingual artery")
(documentation SublingualBranchOfLingualArtery EnglishWrittenLanguage "A branch of the lingual artery supplying the sublingual gland
    and surrounding tissues in the floor of the mouth.")

(subclass StyloglossusMuscle Muscle)
(termFormat EnglishWrittenLanguage StyloglossusMuscle "styloglossus muscle")
(muscleOrigin StyloglossusMuscle StyloidProcessOfTemporalBone)
(muscleInsertion StyloglossusMuscle Tongue)
(suppliesBlood SublingualBranchOfLingualArtery StyloglossusMuscle)
(ennervates HypoglossalNerveCNXII StyloglossusMuscle)
(documentation StyloglossusMuscle EnglishWrittenLanguage "The &%StyloglossusMuscle elevates and retracts &%Tongue.")
(antagonistMuscles InferiorAndMiddleFibersOfGenioglossusMuscle StyloglossusMuscle)

(subclass PalatineAponeurosis BodyPart)
(termFormat EnglishWrittenLanguage PalatineAponeurosis "palatine aponeurosis")
(documentation PalatineAponeurosis EnglishWrittenLanguage "A fibrous sheet supporting the anterior portion of the soft
    palate, attached to the posterior hard palate and receiving
    the tendons of the tensor veli palatini muscles.")

(subclass PalatoglossusMuscle Muscle)
(termFormat EnglishWrittenLanguage PalatoglossusMuscle "palatoglossus muscle")
(muscleOrigin PalatoglossusMuscle PalatineAponeurosis)
(muscleInsertion PalatoglossusMuscle Tongue)
(ennervates VagusNerveCNXAccessoryNerveCNXI PalatoglossusMuscle)
(subclass VagusNerveCNXAccessoryNerveCNXI Nerve)
(termFormat EnglishWrittenLanguage VagusNerveCNXAccessoryNerveCNXI "vagus nerve [CNX], accessory nerve [CNXI]")

(subclass SuperiorLongitudinalMuscle Muscle)
(termFormat EnglishWrittenLanguage SuperiorLongitudinalMuscle "superior longitudinal muscle")
(muscleOrigin SuperiorLongitudinalMuscle CloseToEpiglottisFromMedianFibrousSeptum)
(muscleInsertion SuperiorLongitudinalMuscle EdgesOfTongue)
(suppliesBlood LingualArtery SuperiorLongitudinalMuscle)
(suppliesBlood TonsillarBranchArtery SuperiorLongitudinalMuscle)
(suppliesBlood AscendingPharyngealArtery SuperiorLongitudinalMuscle)
(ennervates HypoglossalNerveCNXII SuperiorLongitudinalMuscle)
(documentation SuperiorLongitudinalMuscle EnglishWrittenLanguage "The &%SuperiorLongitudinalMuscle shortens &%Tongue, turns tip upward, turns lateral margins upward.")

(subclass MedianFibrousSeptum BodyPart)
(termFormat EnglishWrittenLanguage MedianFibrousSeptum "median fibrous septum of tongue")
(documentation MedianFibrousSeptum EnglishWrittenLanguage "A median sheet of fibrous connective tissue that divides the muscular body of the tongue into right and left halves and provides attachment for intrinsic tongue muscle fibers.")

(subclass TransversusMuscle Muscle)
(termFormat EnglishWrittenLanguage TransversusMuscle "transversus muscle")
(muscleOrigin TransversusMuscle MedianFibrousSeptum)
(muscleInsertion TransversusMuscle SideOfTongue)
(suppliesBlood LingualArtery TransversusMuscle)
(suppliesBlood TonsillarBranchArtery TransversusMuscle)
(suppliesBlood AscendingPharyngealArtery TransversusMuscle)
(ennervates HypoglossalNerveCNXII TransversusMuscle)
(documentation TransversusMuscle EnglishWrittenLanguage "The &%TransversusMuscle narrows &%Tongue with no elongation.")

(subclass ApexOfTongue BodyPart)
(termFormat EnglishWrittenLanguage ApexOfTongue "apex of tongue")
(documentation ApexOfTongue EnglishWrittenLanguage "The freely movable anterior tip of the tongue.")

(subclass RootOfTongue BodyPart)
(termFormat EnglishWrittenLanguage RootOfTongue "root of tongue")
(documentation RootOfTongue EnglishWrittenLanguage "The posterior attached portion of the tongue, located
    behind the terminal sulcus.")

(subclass InferiorLongitudinalMuscle Muscle)
(termFormat EnglishWrittenLanguage InferiorLongitudinalMuscle "inferior longitudinal muscle")
(muscleOrigin InferiorLongitudinalMuscle RootOfTongue)
(muscleInsertion InferiorLongitudinalMuscle ApexOfTongue)
(suppliesBlood LingualArtery InferiorLongitudinalMuscle)
(suppliesBlood TonsillarBranchArtery InferiorLongitudinalMuscle)
(suppliesBlood AscendingPharyngealArtery InferiorLongitudinalMuscle)
(ennervates HypoglossalNerveCNXII InferiorLongitudinalMuscle)
(documentation InferiorLongitudinalMuscle EnglishWrittenLanguage "The &%InferiorLongitudinalMuscle shortens &%Tongue, retracts, pulls tip downward.")

(subclass DorsumOfTongue BodyPart)
(termFormat EnglishWrittenLanguage DorsumOfTongue "dorsum of tongue")
(documentation DorsumOfTongue EnglishWrittenLanguage "The superficial tissue region forming the upper surface
    of the tongue.")

(subclass VerticalisMuscle Muscle)
(termFormat EnglishWrittenLanguage VerticalisMuscle "verticalis muscle")
(muscleOrigin VerticalisMuscle DorsumOfTongue)
(muscleInsertion VerticalisMuscle InferiorSurfaceBordersOfTongue)
(suppliesBlood LingualArtery VerticalisMuscle)
(suppliesBlood TonsillarBranchArtery VerticalisMuscle)
(suppliesBlood AscendingPharyngealArtery VerticalisMuscle)
(ennervates HypoglossalNerveCNXII VerticalisMuscle)

(subclass MedialPterygoidPlateOfSphenoidBone HeadBone)
(termFormat EnglishWrittenLanguage MedialPterygoidPlateOfSphenoidBone "medial pterygoid plate of sphenoid bone")
(documentation MedialPterygoidPlateOfSphenoidBone EnglishWrittenLanguage "The medial of the two bony plates forming a pterygoid process
    of the sphenoid bone. Its inferior end forms the pterygoid hamulus.")

(subclass TensorVeliPalatiniMuscle Muscle)
(termFormat EnglishWrittenLanguage TensorVeliPalatiniMuscle "tensor veli palatini muscle")
(muscleOrigin TensorVeliPalatiniMuscle MedialPterygoidPlateOfSphenoidBone)
(muscleInsertion TensorVeliPalatiniMuscle PalatineAponeurosis)
(ennervates MedialPterygoidNerveFromMandibularNerveCNV3 TensorVeliPalatiniMuscle)
(documentation TensorVeliPalatiniMuscle EnglishWrittenLanguage "The &%TensorVeliPalatiniMuscle tenses soft palate, aids in swallowing.")

(subclass LevatorVeliPalatiniMuscle Muscle)
(termFormat EnglishWrittenLanguage LevatorVeliPalatiniMuscle "levator veli palatini muscle")
(muscleOrigin LevatorVeliPalatiniMuscle PetrousPartOfTemporalBone)
(muscleOrigin LevatorVeliPalatiniMuscle CartilageOfEustachianTube)
(muscleInsertion LevatorVeliPalatiniMuscle PalatineAponeurosis)
(suppliesBlood FacialArtery LevatorVeliPalatiniMuscle)
(ennervates PharyngealPlexusOfVagusNerveCNX LevatorVeliPalatiniMuscle)
(subclass PharyngealPlexusOfVagusNerveCNX Nerve)
(termFormat EnglishWrittenLanguage PharyngealPlexusOfVagusNerveCNX "pharyngeal plexus of vagus nerve [CNX]")
(documentation LevatorVeliPalatiniMuscle EnglishWrittenLanguage "The &%LevatorVeliPalatiniMuscle elevates soft palate.")

(ennervates PharyngealPlexusOfVagusNerveCNX PalatoglossusMuscle)
(documentation PalatoglossusMuscle EnglishWrittenLanguage "The &%PalatoglossusMuscle aids in &%Breathing by raising back part of &%Tongue.")

(subclass PalatopharyngeusMuscle Muscle)
(termFormat EnglishWrittenLanguage PalatopharyngeusMuscle "palatopharyngeus muscle")
(muscleOrigin PalatopharyngeusMuscle PalatineAponeurosis)
(muscleOrigin PalatopharyngeusMuscle HardPalate)
(muscleInsertion PalatopharyngeusMuscle SuperiorBorderOfThyroidCartilage)
(muscleInsertion PalatopharyngeusMuscle PharyngealConstrictorFibers)
(suppliesBlood FacialArtery PalatopharyngeusMuscle)
(ennervates PharyngealBranchOfVagusNerveCNX PalatopharyngeusMuscle)
(subclass PharyngealBranchOfVagusNerveCNX Nerve)
(termFormat EnglishWrittenLanguage PharyngealBranchOfVagusNerveCNX "pharyngeal branch of vagus nerve [CNX]")
(documentation PalatopharyngeusMuscle EnglishWrittenLanguage "The &%PalatopharyngeusMuscle aids in  &%Breathing by pulling pharynx and larynx.")

(subclass HardPalate BodyPart)
(termFormat EnglishWrittenLanguage HardPalate "hard palate")
(documentation HardPalate EnglishWrittenLanguage "The rigid anterior portion of the palate that separates the oral cavity from the nasal cavities and is formed by portions of the maxillae and palatine bones.")

(subclass SoftTissueOfUvula BodyPart)
(termFormat EnglishWrittenLanguage SoftTissueOfUvula "soft tissue of uvula")
(documentation SoftTissueOfUvula EnglishWrittenLanguage "The muscular and connective tissue forming the uvula, the projection that descends from the posterior margin of the soft palate.")

(subclass PalatineUvulaMuscle Muscle)
(termFormat EnglishWrittenLanguage PalatineUvulaMuscle "palatine uvula muscle")
(muscleOrigin PalatineUvulaMuscle HardPalate)
(muscleInsertion PalatineUvulaMuscle SoftTissueOfUvula)
(ennervates PharyngealBranchOfVagusNerveCNX PalatineUvulaMuscle)
(documentation PalatineUvulaMuscle EnglishWrittenLanguage "The &%PalatineUvulaMuscle moves and changes shape of uvula.")

(subclass PharyngealBranchesOfAscendingPharyngealArtery Artery)
(termFormat EnglishWrittenLanguage PharyngealBranchesOfAscendingPharyngealArtery "pharyngeal branches of ascending pharyngeal artery")
(documentation PharyngealBranchesOfAscendingPharyngealArtery EnglishWrittenLanguage "An arterial branch of the ascending pharyngeal artery that supplies part of the pharynx and adjacent tissues.")

(subclass StylopharyngeusMuscle Muscle)
(termFormat EnglishWrittenLanguage StylopharyngeusMuscle "stylopharyngeus muscle")
(muscleOrigin StylopharyngeusMuscle StyloidProcessOfTemporalBone)
(muscleInsertion StylopharyngeusMuscle ThyroidCartilage)
(muscleInsertion StylopharyngeusMuscle PharyngealWall)
(suppliesBlood PharyngealBranchesOfAscendingPharyngealArtery StylopharyngeusMuscle)
(ennervates GlossopharyngealNerveCNIX StylopharyngeusMuscle)
(subclass GlossopharyngealNerveCNIX Nerve)
(termFormat EnglishWrittenLanguage GlossopharyngealNerveCNIX "glossopharyngeal nerve [CNIX]")
(documentation StylopharyngeusMuscle EnglishWrittenLanguage "The &%StylopharyngeusMuscle elevates larynx, elevates pharynx, swallowing.")

(subclass CartilageOfEustachianTube Cartilage)
(termFormat EnglishWrittenLanguage CartilageOfEustachianTube "cartilage of Eustachian tube")
(documentation CartilageOfEustachianTube EnglishWrittenLanguage "The cartilaginous framework supporting the portion of the
    auditory tube that opens into the nasopharynx.")

(subclass SalpingopharyngeusMuscle Muscle)
(termFormat EnglishWrittenLanguage SalpingopharyngeusMuscle "salpingopharyngeus muscle")
(muscleOrigin SalpingopharyngeusMuscle CartilageOfEustachianTube)
(muscleInsertion SalpingopharyngeusMuscle PosteriorFasciculusOfPharyngopalatinus)
(ennervates VagusNerveCNXAccessoryNerveCNXI SalpingopharyngeusMuscle)
(documentation SalpingopharyngeusMuscle EnglishWrittenLanguage "The &%SalpingopharyngeusMuscle raises nasopharynx.")

(subclass PharyngealRaphe BodyPart)
(termFormat EnglishWrittenLanguage PharyngealRaphe "pharyngeal raphe")
(documentation PharyngealRaphe EnglishWrittenLanguage "A median fibrous seam on the posterior wall of the pharynx into which the paired pharyngeal constrictor muscles insert.")

(subclass PharyngealInferiorMuscle Muscle)
(termFormat EnglishWrittenLanguage PharyngealInferiorMuscle "pharyngeal inferior muscle")
(muscleOrigin PharyngealInferiorMuscle CricoidCartilage)
(muscleOrigin PharyngealInferiorMuscle ThyroidCartilage)
(muscleInsertion PharyngealInferiorMuscle PharyngealRaphe)
(suppliesBlood PharyngealBranchesOfAscendingPharyngealArtery PharyngealInferiorMuscle)
(ennervates ExternalLaryngealBranchOfSuperiorLaryngealNerveAndRecurrentLaryngealNerveFromVagusNerveCNX PharyngealInferiorMuscle)
(subclass ExternalLaryngealBranchOfSuperiorLaryngealNerveAndRecurrentLaryngealNerveFromVagusNerveCNX Nerve)
(termFormat EnglishWrittenLanguage ExternalLaryngealBranchOfSuperiorLaryngealNerveAndRecurrentLaryngealNerveFromVagusNerveCNX "external laryngeal branch of superior laryngeal nerve and recurrent laryngeal nerve from vagus nerve [CNX]")
(documentation PharyngealInferiorMuscle EnglishWrittenLanguage "The &%PharyngealInferiorMuscle swallowing.")

(subclass PharyngealMiddleMuscle Muscle)
(termFormat EnglishWrittenLanguage PharyngealMiddleMuscle "pharyngeal middle muscle muscle")
(muscleOrigin PharyngealMiddleMuscle HyoidBone)
(muscleInsertion PharyngealMiddleMuscle PharyngealRaphe)
(suppliesBlood PharyngealBranchesOfAscendingPharyngealArtery PharyngealMiddleMuscle)
(ennervates PharyngealPlexusOfVagusNerveCNX PharyngealMiddleMuscle)
(documentation PharyngealMiddleMuscle EnglishWrittenLanguage "The &%PharyngealMiddleMuscle swallowing.")

(subclass MedialPterygoidPlate Bone)
(termFormat EnglishWrittenLanguage MedialPterygoidPlate "medial pterygoid plate")
(documentation MedialPterygoidPlate EnglishWrittenLanguage "The medial bony plate of the pterygoid process of the sphenoid
    bone, whose inferior end forms the pterygoid hamulus.")

(subclass PterygomandibularRaphe BodyPart)
(termFormat EnglishWrittenLanguage PterygomandibularRaphe "pterygomandibular raphe")
(documentation PterygomandibularRaphe EnglishWrittenLanguage "A fibrous region extending between the pterygoid hamulus and
    the mandible, providing attachment for the buccinator and
    superior pharyngeal constrictor muscles.")

(subclass MylohyoidLineOfMandible Bone)
(termFormat EnglishWrittenLanguage MylohyoidLineOfMandible "mylohyoid line of mandible")
(documentation MylohyoidLineOfMandible EnglishWrittenLanguage "A bony ridge on the inner surface of the mandible that provides
    muscle attachment sites, including an attachment for the superior
    pharyngeal constrictor muscle at its posterior end.")

(subclass PharyngealSuperiorMuscle Muscle)
(termFormat EnglishWrittenLanguage PharyngealSuperiorMuscle "pharyngeal superior muscle")
(muscleInsertion PharyngealSuperiorMuscle PharyngealRaphe)
(muscleInsertion PharyngealSuperiorMuscle PharyngealTubercleOfOccipitalBone)
(suppliesBlood AscendingPharyngealArtery PharyngealSuperiorMuscle)
(suppliesBlood TonsillarBranchArtery PharyngealSuperiorMuscle)
(ennervates PharyngealPlexusOfVagusNerveCNX PharyngealSuperiorMuscle)
(documentation PharyngealSuperiorMuscle EnglishWrittenLanguage "The &%PharyngealSuperiorMuscle swallowing.")

(muscleOrigin PharyngealSuperiorMuscle MedialPterygoidPlate)
(muscleOrigin PharyngealSuperiorMuscle PterygomandibularRaphe)
(muscleOrigin PharyngealSuperiorMuscle MylohyoidLineOfMandible)

(subclass CricothyroidBranchOfSuperiorThyroidArtery Artery)
(termFormat EnglishWrittenLanguage CricothyroidBranchOfSuperiorThyroidArtery "cricothyroid branch of superior thyroid artery")
(documentation CricothyroidBranchOfSuperiorThyroidArtery EnglishWrittenLanguage "A branch of the superior thyroid artery supplying the
    cricothyroid muscle and adjacent tissues.")

(subclass CricothyroidMuscle Muscle)
(termFormat EnglishWrittenLanguage CricothyroidMuscle "cricothyroid muscle")
(muscleOrigin CricothyroidMuscle AnteriorAndLateralCricoidCartilage)
(muscleInsertion CricothyroidMuscle InferiorHornOfThyroidCartilage)
(muscleInsertion CricothyroidMuscle LaminaOfThyroidCartilage)
(suppliesBlood CricothyroidBranchOfSuperiorThyroidArtery CricothyroidMuscle)
(ennervates ExternalLaryngealBranchOfSuperiorLaryngealNerveFromVagusNerveCNX CricothyroidMuscle)
(subclass ExternalLaryngealBranchOfSuperiorLaryngealNerveFromVagusNerveCNX Nerve)
(termFormat EnglishWrittenLanguage ExternalLaryngealBranchOfSuperiorLaryngealNerveFromVagusNerveCNX "external laryngeal branch of superior laryngeal nerve from vagus nerve [CNX]")
(documentation CricothyroidMuscle EnglishWrittenLanguage "The &%CricothyroidMuscle tenses and elongates vocal folds (has minor adductory effect).")

(subclass SuperiorLaryngealBranchOfSuperiorThyroidArtery Artery)
(termFormat EnglishWrittenLanguage SuperiorLaryngealBranchOfSuperiorThyroidArtery "superior laryngeal branch of superior thyroid artery")
(documentation SuperiorLaryngealBranchOfSuperiorThyroidArtery EnglishWrittenLanguage "A branch of the superior thyroid artery that enters the
    larynx through the thyrohyoid membrane and supplies laryngeal
    muscles and mucosa.")

(subclass ArytenoidTransverseAndObliqueMuscle Muscle)
(termFormat EnglishWrittenLanguage ArytenoidTransverseAndObliqueMuscle "arytenoid (transverse and oblique) muscle")
(muscleOrigin ArytenoidTransverseAndObliqueMuscle ArytenoidCartilageOnOneSide)
(muscleInsertion ArytenoidTransverseAndObliqueMuscle ArytenoidCartilageOnOppositeSide)
(suppliesBlood SuperiorLaryngealBranchOfSuperiorThyroidArtery ArytenoidTransverseAndObliqueMuscle)
(ennervates RecurrentLaryngealNerveFromVagusNerveCNX ArytenoidTransverseAndObliqueMuscle)
(subclass RecurrentLaryngealNerveFromVagusNerveCNX Nerve)
(termFormat EnglishWrittenLanguage RecurrentLaryngealNerveFromVagusNerveCNX "recurrent laryngeal nerve from vagus nerve [CNX]")
(documentation ArytenoidTransverseAndObliqueMuscle EnglishWrittenLanguage "The &%ArytenoidTransverseAndObliqueMuscle approximates arytenoid cartilages (closes rima glottidis).")

(subclass AnteriorSurfaceOfArytenoidCartilage Cartilage)
(termFormat EnglishWrittenLanguage AnteriorSurfaceOfArytenoidCartilage "anterior surface of arytenoid cartilage")
(documentation AnteriorSurfaceOfArytenoidCartilage EnglishWrittenLanguage "The anterior-facing tissue region of an arytenoid cartilage,
    forming part of its anterolateral surface.")

(subclass InnerAnteriorSurfaceOfThyroidCartilage BodyPart)
(termFormat EnglishWrittenLanguage InnerAnteriorSurfaceOfThyroidCartilage "inner anterior surface of thyroid cartilage")
(documentation InnerAnteriorSurfaceOfThyroidCartilage EnglishWrittenLanguage "The inward-facing tissue region of the anterior thyroid
    cartilage near the junction of its two laminae.")

(subclass ThyroarytenoidMuscle Muscle)
(termFormat EnglishWrittenLanguage ThyroarytenoidMuscle "thyroarytenoid muscle")
(muscleOrigin ThyroarytenoidMuscle InnerAnteriorSurfaceOfThyroidCartilage)
(muscleInsertion ThyroarytenoidMuscle AnteriorSurfaceOfArytenoidCartilage)
(ennervates RecurrentLaryngealNerveFromVagusNerveCNX ThyroarytenoidMuscle)
(documentation ThyroarytenoidMuscle EnglishWrittenLanguage "The &%ThyroarytenoidMuscle thickens and decreases length of vocal folds, adducts during speech.")

(subclass LateralCricoarytenoidMuscle Muscle)
(termFormat EnglishWrittenLanguage LateralCricoarytenoidMuscle "lateral cricoarytenoid muscle")
(documentation LateralCricoarytenoidMuscle EnglishWrittenLanguage "A paired intrinsic laryngeal muscle extending from the cricoid
    cartilage to the muscular process of the arytenoid cartilage.
    It adducts the vocal folds.")

(subclass MuscularProcessOfArytenoidCartilage Cartilage)
(termFormat EnglishWrittenLanguage MuscularProcessOfArytenoidCartilage "muscular process of arytenoid cartilage")
(documentation MuscularProcessOfArytenoidCartilage EnglishWrittenLanguage "A lateral projection at the base of an arytenoid cartilage
    receiving the lateral and posterior cricoarytenoid muscles.")

(subclass PosteriorPartOfCricoidCartilage Cartilage)
(termFormat EnglishWrittenLanguage PosteriorPartOfCricoidCartilage "posterior part of cricoid cartilage")
(documentation PosteriorPartOfCricoidCartilage EnglishWrittenLanguage "The broad posterior lamina of the cricoid cartilage,
    providing origin sites for the posterior cricoarytenoid muscles.")

(subclass CricoarytenoidPosteriorMuscle Muscle)
(termFormat EnglishWrittenLanguage CricoarytenoidPosteriorMuscle "posterior muscle")
(muscleOrigin CricoarytenoidPosteriorMuscle PosteriorPartOfCricoidCartilage)
(muscleInsertion CricoarytenoidPosteriorMuscle MuscularProcessOfArytenoidCartilage)
(ennervates RecurrentLaryngealNerveFromVagusNerveCNX CricoarytenoidPosteriorMuscle)
(documentation CricoarytenoidPosteriorMuscle EnglishWrittenLanguage "The &%CricoarytenoidPosteriorMuscle abducts and laterally rotates cartilage, pulling vocal ligaments away from midline and forward and so opening rima glottidis.")
(antagonistMuscles LateralCricoarytenoidMuscle CricoarytenoidPosteriorMuscle)

(subclass PosteriorCricoarytenoidMuscle Muscle)
(termFormat EnglishWrittenLanguage PosteriorCricoarytenoidMuscle "posterior cricoarytenoid muscle")
(documentation PosteriorCricoarytenoidMuscle EnglishWrittenLanguage "A paired intrinsic laryngeal muscle extending from the posterior
    cricoid lamina to the muscular process of the arytenoid cartilage.
    It abducts the vocal folds.")

(subclass LateralPartOfArchOfCricoidCartilage Cartilage)
(termFormat EnglishWrittenLanguage LateralPartOfArchOfCricoidCartilage "lateral part of arch of cricoid cartilage")
(documentation LateralPartOfArchOfCricoidCartilage EnglishWrittenLanguage "A lateral portion of the cricoid arch, providing an origin
    site for the lateral cricoarytenoid muscle.")

(subclass CricoarytenoidLateralMuscle Muscle)
(termFormat EnglishWrittenLanguage CricoarytenoidLateralMuscle "lateral muscle")
(muscleOrigin CricoarytenoidLateralMuscle LateralPartOfArchOfCricoidCartilage)
(muscleInsertion CricoarytenoidLateralMuscle MuscularProcessOfArytenoidCartilage)
(ennervates RecurrentLaryngealNerveFromVagusNerveCNX CricoarytenoidLateralMuscle)
(documentation CricoarytenoidLateralMuscle EnglishWrittenLanguage "The &%CricoarytenoidLateralMuscle adducts and medially rotates cartilage, pulling vocal ligaments towards midline and backwards and so closing rima glottidis.")
(antagonistMuscles PosteriorCricoarytenoidMuscle CricoarytenoidLateralMuscle)

(subclass BaseOfMandible Bone)
(termFormat EnglishWrittenLanguage BaseOfMandible "base of mandible")
(documentation BaseOfMandible EnglishWrittenLanguage "The thickened inferior border of the body of the mandible.")

(subclass PlatysmaMuscle Muscle)
(termFormat EnglishWrittenLanguage PlatysmaMuscle "platysma muscle")
(muscleOrigin PlatysmaMuscle BaseOfMandible)
(muscleInsertion PlatysmaMuscle FasciaOverPectoralisMajor)
(muscleInsertion PlatysmaMuscle FasciaOverDeltoid)
(suppliesBlood SubmentalArtery PlatysmaMuscle)
(suppliesBlood SuprascapularArtery PlatysmaMuscle)
(ennervates CervicalBranchOfFacialNerveCNVII PlatysmaMuscle)
(subclass CervicalBranchOfFacialNerveCNVII Nerve)
(termFormat EnglishWrittenLanguage CervicalBranchOfFacialNerveCNVII "cervical branch of facial nerve [CNVII]")
(documentation PlatysmaMuscle EnglishWrittenLanguage "The &%PlatysmaMuscle tenses skin of  &%Neck.")
(antagonistMuscles MasseterMuscle PlatysmaMuscle)
(antagonistMuscles TemporalisMuscle PlatysmaMuscle)

(subclass SternocleidomastoidMuscle Muscle)
(termFormat EnglishWrittenLanguage SternocleidomastoidMuscle "sternocleidomastoid muscle")
(muscleOrigin SternocleidomastoidMuscle ManubriumOfSternum)
(muscleInsertion SternocleidomastoidMuscle MastoidProcessOfTemporalBone)
(suppliesBlood OccipitalArtery SternocleidomastoidMuscle)
(ennervates CervicalBranchOfFacialNerveCNVII SternocleidomastoidMuscle)
(subclass AccessoryNerve Nerve)
(termFormat EnglishWrittenLanguage AccessoryNerve "accessory nerve")
(documentation SternocleidomastoidMuscle EnglishWrittenLanguage "The &%SternocleidomastoidMuscle acting alone:
tilts &%Head to its own side, rotates &%Head so &%Face is turned towards opposite side,
acting together: flexes &%Neck, raises &%Sternum, assists in forced inspiration.")
(antagonistMuscles MasseterMuscle SternocleidomastoidMuscle)
(antagonistMuscles TemporalisMuscle SternocleidomastoidMuscle)

(subclass DigastricFossa Bone)
(termFormat EnglishWrittenLanguage DigastricFossa "digastric fossa")
(documentation DigastricFossa EnglishWrittenLanguage "A shallow bony depression near the inferior border of the
    inner mandibular surface, beside the midline, providing the
    origin of the anterior belly of the digastric muscle.")

(subclass DigastricMuscle Muscle)
(termFormat EnglishWrittenLanguage DigastricMuscle "digastric muscle")
(muscleOrigin DigastricMuscle DigastricFossa)
(muscleInsertion DigastricMuscle HyoidBone)
(suppliesBlood OccipitalArtery FacialArtery)
(ennervates MandibularNerve DigastricMuscle)
(subclass MandibularNerve Nerve)
(termFormat EnglishWrittenLanguage MandibularNerve "mandibular nerve")
(documentation DigastricMuscle EnglishWrittenLanguage "The &%DigastricMuscle opens &%Jaw when masseter and temporalis are relaxed.")

(subclass GreaterHornOfHyoidBone Bone)
(termFormat EnglishWrittenLanguage GreaterHornOfHyoidBone "greater horn of hyoid bone")
(documentation GreaterHornOfHyoidBone EnglishWrittenLanguage "One of the paired elongated projections extending posteriorly
    from the body of the hyoid bone, providing attachment sites
    for muscles and ligaments.")

(subclass StylohyoidMuscle Muscle)
(termFormat EnglishWrittenLanguage StylohyoidMuscle "stylohyoid muscle")
(muscleOrigin StylohyoidMuscle StyloidProcessOfTemporalBone)
(muscleInsertion StylohyoidMuscle GreaterHornOfHyoidBone)
(suppliesBlood OccipitalArtery StylohyoidMuscle)
(ennervates FacialNerveCNVII StylohyoidMuscle)
(documentation StylohyoidMuscle EnglishWrittenLanguage "The &%StylohyoidMuscle elevates &%HyoidBone during swallowing.")

(subclass MylohyoidBranchOfInferiorAlveolarArtery Artery)
(termFormat EnglishWrittenLanguage MylohyoidBranchOfInferiorAlveolarArtery "mylohyoid branch of inferior alveolar artery")
(documentation MylohyoidBranchOfInferiorAlveolarArtery EnglishWrittenLanguage "A branch of the inferior alveolar artery supplying the
    mylohyoid muscle and adjacent tissues.")

(subclass MylohyoidMuscle Muscle)
(termFormat EnglishWrittenLanguage MylohyoidMuscle "mylohyoid muscle")
(muscleOrigin MylohyoidMuscle MylohyoidLineOfMandible)
(muscleInsertion MylohyoidMuscle PharyngealRaphe)
(suppliesBlood MylohyoidBranchOfInferiorAlveolarArtery MylohyoidMuscle)
(ennervates MylohyoidNerveFromInferiorAlveolarBranchOfMandibularNerveCNV3 MylohyoidMuscle)
(subclass MylohyoidNerveFromInferiorAlveolarBranchOfMandibularNerveCNV3 Nerve)
(termFormat EnglishWrittenLanguage MylohyoidNerveFromInferiorAlveolarBranchOfMandibularNerveCNV3 "mylohyoid nerve, from inferior alveolar branch of mandibular nerve [CNV3]")
(documentation MylohyoidMuscle EnglishWrittenLanguage "The &%MylohyoidMuscle raises oral cavity floor, elevates &%HyoidBone, depresses mandible.")

(subclass AnteriorSurfaceOfBodyOfHyoidBone Bone)
(termFormat EnglishWrittenLanguage AnteriorSurfaceOfBodyOfHyoidBone "anterior surface of body of hyoid bone")
(documentation AnteriorSurfaceOfBodyOfHyoidBone EnglishWrittenLanguage "The anterior-facing bony portion of the central body of
    the hyoid bone.")

(subclass MandibularSymphysis HeadBone)
(termFormat EnglishWrittenLanguage MandibularSymphysis
    "mandibular symphysis")
(documentation MandibularSymphysis EnglishWrittenLanguage
    "The median bony region of the mandible marking the line at which its right and left embryonic halves fuse.")

(subclass GeniohyoidMuscle Muscle)
(termFormat EnglishWrittenLanguage GeniohyoidMuscle "geniohyoid muscle")
(muscleOrigin GeniohyoidMuscle MandibularSymphysis)
(muscleInsertion GeniohyoidMuscle AnteriorSurfaceOfBodyOfHyoidBone)
(ennervates C1ViaHypoglossalNerve GeniohyoidMuscle)
(subclass C1ViaHypoglossalNerve Nerve)
(termFormat EnglishWrittenLanguage C1ViaHypoglossalNerve "C1 via hypoglossal nerve")
(documentation GeniohyoidMuscle EnglishWrittenLanguage "The &%GeniohyoidMuscle elevates &%HyoidBone and &%Tongue upward during swallowing.")

(subclass ManubriumOfSternum Bone)
(termFormat EnglishWrittenLanguage ManubriumOfSternum "manubrium of sternum")
(documentation ManubriumOfSternum EnglishWrittenLanguage "The broad superior portion of the sternum, articulating with
    the clavicles, the first costal cartilages, and the sternal
    body, and contributing to the second costal cartilage attachments.")

(subclass SternohyoidMuscle Muscle)
(termFormat EnglishWrittenLanguage SternohyoidMuscle "sternohyoid muscle")
(muscleOrigin SternohyoidMuscle ManubriumOfSternum)
(muscleInsertion SternohyoidMuscle HyoidBone)
(suppliesBlood SuperiorThyroidArtery SternohyoidMuscle)
(ennervates AnsaCervicalis SternohyoidMuscle)
(subclass AnsaCervicalis Nerve)
(termFormat EnglishWrittenLanguage AnsaCervicalis "ansa cervicalis")
(documentation SternohyoidMuscle EnglishWrittenLanguage "The &%SternohyoidMuscle depresses &%HyoidBone.")

(subclass ThyroidCartilage Cartilage)
(termFormat EnglishWrittenLanguage ThyroidCartilage "thyroid cartilage")
(documentation ThyroidCartilage EnglishWrittenLanguage "The largest cartilage of the larynx, consisting of two
    laminae joined anteriorly and forming a protective framework
    around the vocal folds.")

(subclass SternothyroidMuscle Muscle)
(termFormat EnglishWrittenLanguage SternothyroidMuscle "sternothyroid muscle")
(muscleOrigin SternothyroidMuscle ManubriumOfSternum)
(muscleInsertion SternothyroidMuscle ThyroidCartilage)
(suppliesBlood SuperiorThyroidArtery SternothyroidMuscle)
(ennervates AnsaCervicalis SternothyroidMuscle)
(documentation SternothyroidMuscle EnglishWrittenLanguage "The &%SternothyroidMuscle depresses larynx, may slightly depress &%HyoidBone.")

(subclass ThyrohyoidMuscle Muscle)
(termFormat EnglishWrittenLanguage ThyrohyoidMuscle "thyrohyoid muscle")
(muscleOrigin ThyrohyoidMuscle ThyroidCartilage)
(muscleInsertion ThyrohyoidMuscle HyoidBone)
(suppliesBlood SuperiorThyroidArtery ThyrohyoidMuscle)
(ennervates C1Nerve ThyrohyoidMuscle)
(subclass C1Nerve Nerve)
(termFormat EnglishWrittenLanguage C1Nerve "C1 Nerve")
(documentation ThyrohyoidMuscle EnglishWrittenLanguage "The &%ThyrohyoidMuscle depress &%HyoidBone.")

(subclass UpperBorderOfScapula Bone)
(termFormat EnglishWrittenLanguage UpperBorderOfScapula "superior border of scapula")
(documentation UpperBorderOfScapula EnglishWrittenLanguage "The superior edge of the scapula extending from its superior
    angle toward the base of the coracoid process.")

(subclass OmohyoidMuscle Muscle)
(termFormat EnglishWrittenLanguage OmohyoidMuscle "omohyoid muscle")
(muscleOrigin OmohyoidMuscle UpperBorderOfScapula)
(muscleInsertion OmohyoidMuscle HyoidBone)
(suppliesBlood InferiorThyroidArtery OmohyoidMuscle)
(ennervates AnsaCervicalis OmohyoidMuscle)
(documentation OmohyoidMuscle EnglishWrittenLanguage "The &%OmohyoidMuscle depresses larynx, depresses and moves to side &%HyoidBone.")

(subclass AnteriorArchOfAtlas Bone)
(termFormat EnglishWrittenLanguage AnteriorArchOfAtlas "anterior arch of atlas")
(documentation AnteriorArchOfAtlas EnglishWrittenLanguage "The anterior bony portion of the atlas connecting its lateral
    masses, with a posterior facet that articulates with the dens
    of the axis.")

(subclass LongusColliMuscle Muscle)
(termFormat EnglishWrittenLanguage LongusColliMuscle "longus colli muscle")
(muscleOrigin LongusColliMuscle TransverseProcessesOfVertebraeC3C4C5AndC6)
(muscleInsertion LongusColliMuscle AnteriorArchOfAtlas)
(suppliesBlood AscendingPharyngealArtery LongusColliMuscle)
(suppliesBlood VertebralArtery LongusColliMuscle)
(ennervates C2C3C4C5C6Nerve LongusColliMuscle)
(subclass C2C3C4C5C6Nerve Nerve)
(termFormat EnglishWrittenLanguage C2C3C4C5C6Nerve "C2, C3, C4, C5, C6 Nerve")
(documentation LongusColliMuscle EnglishWrittenLanguage "The &%LongusColliMuscle performs &%Flexion of &%Neck and &%Head.")

(subclass BasilarPartOfOccipitalBone Bone)
(termFormat EnglishWrittenLanguage BasilarPartOfOccipitalBone "basilar part of occipital bone")
(documentation BasilarPartOfOccipitalBone EnglishWrittenLanguage "The portion of the occipital bone anterior to the foramen
    magnum, contributing to the base of the skull.")

(subclass LongusCapitisMuscle Muscle)
(termFormat EnglishWrittenLanguage LongusCapitisMuscle "longus capitis muscle")
(muscleOrigin LongusCapitisMuscle AnteriorTuberclesOfTransverseProcessesOfVertebraeC3C4C5AndC6)
(muscleInsertion LongusCapitisMuscle BasilarPartOfOccipitalBone)
(ennervates C1C2C3C4Nerve LongusCapitisMuscle)
(subclass C1C2C3C4Nerve Nerve)
(termFormat EnglishWrittenLanguage C1C2C3C4Nerve "C1, C2, C3/C4 Nerve")
(documentation LongusCapitisMuscle EnglishWrittenLanguage "The &%LongusCapitisMuscle performs &%Flexion of   &%Neck at atlanto-occipital &%BodyJoint.")

(subclass RectusCapitisAnteriorMuscle Muscle)
(termFormat EnglishWrittenLanguage RectusCapitisAnteriorMuscle "rectus capitis anterior muscle")
(muscleOrigin RectusCapitisAnteriorMuscle C1VertebraBone)
(muscleInsertion RectusCapitisAnteriorMuscle OccipitalBone)
(ennervates C1Nerve RectusCapitisAnteriorMuscle)

(subclass UnderSurfaceOfJugularProcessOfOccipitalBone Bone)
(termFormat EnglishWrittenLanguage UnderSurfaceOfJugularProcessOfOccipitalBone "inferior surface of jugular process of occipital bone")
(documentation UnderSurfaceOfJugularProcessOfOccipitalBone EnglishWrittenLanguage "The superficial bony region on the inferior aspect of the jugular process of the occipital bone, providing attachment for the rectus capitis lateralis muscle.")

(subclass RectusCapitisLateralisMuscle Muscle)
(termFormat EnglishWrittenLanguage RectusCapitisLateralisMuscle "rectus capitis lateralis muscle")
(muscleOrigin RectusCapitisLateralisMuscle C1VertebraBone)
(muscleInsertion RectusCapitisLateralisMuscle UnderSurfaceOfJugularProcessOfOccipitalBone)
(ennervates C1Nerve RectusCapitisLateralisMuscle)
(documentation RectusCapitisLateralisMuscle EnglishWrittenLanguage "The &%RectusCapitisLateralisMuscle side
bends at atlanto-occipital &%BodyJoint.")

(subclass CervicalVertebrae Bone)
(termFormat EnglishWrittenLanguage CervicalVertebrae "cervical vertebrae")
(documentation CervicalVertebrae EnglishWrittenLanguage "The class of vertebrae forming the neck portion of the
    vertebral column, designated C1 through C7 in humans.")

(subclass ScaleneMuscle Muscle)
(termFormat EnglishWrittenLanguage ScaleneMuscle "scalene muscle")
(muscleOrigin ScaleneMuscle CervicalVertebrae)
(muscleInsertion ScaleneMuscle FirstRib)
(muscleInsertion ScaleneMuscle SecondRib)
(suppliesBlood AscendingCervicalArtery ScaleneMuscle)
(ennervates CervicalNervesC3C4C5C6C7 ScaleneMuscle)
(subclass CervicalNervesC3C4C5C6C7 Nerve)
(termFormat EnglishWrittenLanguage CervicalNervesC3C4C5C6C7 "cervical nerves (C3, C4, C5, C6, C7)")
(documentation ScaleneMuscle EnglishWrittenLanguage "The &%ScaleneMuscle elevates first  &%Rib and second &%Rib.")

(subclass ScaleneAnteriorMuscle Muscle)
(termFormat EnglishWrittenLanguage ScaleneAnteriorMuscle "scalene anterior muscle")
(muscleOrigin ScaleneAnteriorMuscle AnteriorTuberclesOfTransverseProcessesOfVertebraeC3C4C5AndC6)
(muscleInsertion ScaleneAnteriorMuscle FirstRib)
(suppliesBlood AscendingCervicalArtery ScaleneAnteriorMuscle)
(ennervates VentralRamusOfC5C6 ScaleneAnteriorMuscle)
(subclass VentralRamusOfC5C6 Nerve)
(termFormat EnglishWrittenLanguage VentralRamusOfC5C6 "ventral ramus of C5, C6")
(documentation ScaleneAnteriorMuscle EnglishWrittenLanguage "The &%ScaleneAnteriorMuscle when  &%Neck is fixed, elevates first &%Rib to
aid in &%Breathing; when a &%Rib is fixed, bends the &%Neck forward and sideways and rotates it to opposite side.")

(subclass AscendingCervicalArtery Artery)
(termFormat EnglishWrittenLanguage AscendingCervicalArtery "ascending cervical artery")
(documentation AscendingCervicalArtery EnglishWrittenLanguage "An artery that usually arises from the inferior thyroid artery
    and ascends through the neck, supplying deep cervical muscles,
    including the middle scalene muscle.")
(suppliesBlood AscendingCervicalArtery ScaleneMediusMuscle)

(subclass ScaleneMediusMuscle Muscle)
(termFormat EnglishWrittenLanguage ScaleneMediusMuscle "scalene medius muscle")
(muscleOrigin ScaleneMediusMuscle PosteriorTuberclesOfTransverseProcessesOfC2ThroughC7)
(muscleInsertion ScaleneMediusMuscle FirstRib)
(ennervates VentralRamiOfThirdToEighthCervicalSpinalNerves ScaleneMediusMuscle)
(subclass VentralRamiOfThirdToEighthCervicalSpinalNerves Nerve)
(termFormat EnglishWrittenLanguage VentralRamiOfThirdToEighthCervicalSpinalNerves "ventral rami of third to eighth cervical spinal nerves")
(documentation ScaleneMediusMuscle EnglishWrittenLanguage "The &%ScaleneMediusMuscle elevates first &%Rib, rotates the &%Neck to opposite side.")

(subclass SecondRib RibBone)
(termFormat EnglishWrittenLanguage SecondRib "second rib")
(documentation SecondRib EnglishWrittenLanguage "The second rib counted from above on either side of the
    thorax, connecting anteriorly through its costal cartilage
    to the sternum at the manubriosternal junction.")

(subclass ScalenePosteriorMuscle Muscle)
(termFormat EnglishWrittenLanguage ScalenePosteriorMuscle "scalene posterior muscle")
(muscleOrigin ScalenePosteriorMuscle TransverseProcessesOfC4C6)
(muscleInsertion ScalenePosteriorMuscle SecondRib)
(suppliesBlood AscendingCervicalArtery ScalenePosteriorMuscle)
(suppliesBlood TransverseCervicalSuperficialBranchArtery ScalenePosteriorMuscle)
(ennervates VentralRamusOfC5C6 ScalenePosteriorMuscle)
(documentation ScalenePosteriorMuscle EnglishWrittenLanguage "The &%PosteriorMuscle elevates second &%Rib, tilts &%Neck to same side.")

(subclass DorsalScapularArtery Artery)
(termFormat EnglishWrittenLanguage DorsalScapularArtery "dorsal scapular artery")
(documentation DorsalScapularArtery EnglishWrittenLanguage "An artery supplying the rhomboid and levator scapulae muscles,
    usually arising from the subclavian artery, but sometimes
    from the transverse cervical artery.")

(subclass SuperiorPartOfMedialBorderOfScapula Bone)
(termFormat EnglishWrittenLanguage SuperiorPartOfMedialBorderOfScapula "superior part of medial border of scapula")
(documentation SuperiorPartOfMedialBorderOfScapula EnglishWrittenLanguage "The upper bony portion of the medial border of the scapula,
    extending between the superior angle and the root of the
    scapular spine. It provides attachment for the levator
    scapulae muscle.")

(subclass LevatorScapulaeMuscle Muscle)
(termFormat EnglishWrittenLanguage LevatorScapulaeMuscle "levator scapulae muscle")
(muscleOrigin LevatorScapulaeMuscle PosteriorTuberclesOfTransverseProcessesOfC1C4)
(muscleInsertion LevatorScapulaeMuscle SuperiorPartOfMedialBorderOfScapula)
(suppliesBlood DorsalScapularArtery LevatorScapulaeMuscle)
(ennervates CervicalNerveC3C4AndDorsalScapularNerveC5 LevatorScapulaeMuscle)
(subclass CervicalNerveC3C4AndDorsalScapularNerveC5 Nerve)
(termFormat EnglishWrittenLanguage CervicalNerveC3C4AndDorsalScapularNerveC5 "cervical nerve (C3, C4) and dorsal scapular nerve (C5)")
(documentation LevatorScapulaeMuscle EnglishWrittenLanguage "The &%LevatorScapulaeMuscle elevates &%ScapulaBone, tilts glenoid
cavity inferiorly by rotating &%ScapulaBone.")
(antagonistMuscles SerratusAnteriorMuscle LevatorScapulaeMuscle)

(documentation RectusCapitisLateralisMuscle EnglishWrittenLanguage "The &%RectusCapitisLateralisMuscle laterally
performs &%Flexion of &%Neck, stabilises atlanto-occipital &%BodyJoint.")

(subclass LateralMassOfAtlas Bone)
(termFormat EnglishWrittenLanguage LateralMassOfAtlas "lateral mass of atlas")
(documentation LateralMassOfAtlas EnglishWrittenLanguage "One of the paired thickened lateral portions of the atlas,
    bearing articular surfaces for the occipital condyle above
    and the axis below.")

(subclass ObliquusCapitisSuperiorMuscle Muscle)
(termFormat EnglishWrittenLanguage ObliquusCapitisSuperiorMuscle "obliquus capitis superior muscle")
(muscleOrigin ObliquusCapitisSuperiorMuscle LateralMassOfAtlas)
(muscleInsertion ObliquusCapitisSuperiorMuscle LateralHalfOfInferiorNuchalLine)
(ennervates SuboccipitalNerve ObliquusCapitisSuperiorMuscle)
(subclass SuboccipitalNerve Nerve)
(termFormat EnglishWrittenLanguage SuboccipitalNerve "suboccipital nerve")
(documentation ObliquusCapitisSuperiorMuscle EnglishWrittenLanguage "The &%ObliquusCapitisSuperiorMuscle
performs &%Flexion of &%Head to same side.")

(subclass SpinousProcessOfAxis Bone)
(termFormat EnglishWrittenLanguage SpinousProcessOfAxis "spinous process of axis")
(documentation SpinousProcessOfAxis EnglishWrittenLanguage "The posterior bony projection of the axis, the second cervical
    vertebra. It is typically bifid and provides attachment for
    muscles and ligaments of the neck.")

(subclass ObliquusCapitisInferiorMuscle Muscle)
(termFormat EnglishWrittenLanguage ObliquusCapitisInferiorMuscle "obliquus capitis inferior muscle")
(muscleOrigin ObliquusCapitisInferiorMuscle SpinousProcessOfAxis)
(muscleInsertion ObliquusCapitisInferiorMuscle LateralMassOfAtlas)
(ennervates SuboccipitalNerve ObliquusCapitisInferiorMuscle)
(documentation ObliquusCapitisInferiorMuscle EnglishWrittenLanguage "The &%ObliquusCapitisInferiorMuscle rotates  &%Neck.")

(subclass TubercleOnPosteriorArchOfAtlasC1 Bone)
(termFormat EnglishWrittenLanguage TubercleOnPosteriorArchOfAtlasC1 "posterior tubercle of atlas")
(documentation TubercleOnPosteriorArchOfAtlasC1 EnglishWrittenLanguage "A small bony projection at the posterior midline of the posterior arch of the atlas, corresponding to the spinous process of a typical vertebra.")

(subclass RectusCapitisPosteriorMinorMuscle Muscle)
(termFormat EnglishWrittenLanguage RectusCapitisPosteriorMinorMuscle "rectus capitis posterior minor muscle")
(muscleOrigin RectusCapitisPosteriorMinorMuscle TubercleOnPosteriorArchOfAtlasC1)
(muscleInsertion RectusCapitisPosteriorMinorMuscle MedialPartOfInferiorNuchalLineOfOccipitalBoneAndSurfaceBetweenItAndForamenMagnum)
(ennervates ABranchOfDorsalPrimaryDivisionOfSuboccipitalNerve RectusCapitisPosteriorMinorMuscle)
(subclass ABranchOfDorsalPrimaryDivisionOfSuboccipitalNerve Nerve)
(termFormat EnglishWrittenLanguage ABranchOfDorsalPrimaryDivisionOfSuboccipitalNerve "a branch of dorsal primary division of suboccipital nerve")
(documentation RectusCapitisPosteriorMinorMuscle EnglishWrittenLanguage "The &%RectusCapitisPosteriorMinorMuscle
sensory &%Organ for &%Neck position, also extends &%Head at the &%Neck.")

(subclass InferiorNuchealLineOfOccipitalBone HeadBone)
(termFormat EnglishWrittenLanguage InferiorNuchealLineOfOccipitalBone "inferior nuchal line of occipital bone")
(documentation InferiorNuchealLineOfOccipitalBone EnglishWrittenLanguage "A curved bony ridge on the external surface of the occipital bone, located inferior to the superior nuchal line and providing attachment for muscles of the suboccipital region.")

(subclass SpinousProcessOfAxisC2 SpinousProcessOfAxis)
(termFormat EnglishWrittenLanguage SpinousProcessOfAxisC2
    "spinous process of axis C2")
(documentation SpinousProcessOfAxisC2 EnglishWrittenLanguage
    "The posterior, typically bifid, bony projection of the axis, which is the second cervical vertebra.")

(subclass RectusCapitisPosteriorMajorMuscle Muscle)
(termFormat EnglishWrittenLanguage RectusCapitisPosteriorMajorMuscle "rectus capitis posterior major muscle")
(muscleOrigin RectusCapitisPosteriorMajorMuscle SpinousProcessOfAxisC2)
(muscleInsertion RectusCapitisPosteriorMajorMuscle InferiorNuchealLineOfOccipitalBone)
(suppliesBlood OccipitalArtery RectusCapitisPosteriorMajorMuscle)
(ennervates DorsalRamusOfC1SuboccipitalNerve RectusCapitisPosteriorMajorMuscle)
