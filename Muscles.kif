(subclass FibularisLongusMuscle Muscle)
(termFormat EnglishWrittenLanguage FibularisLongusMuscle "fibularis longus muscle")
(muscleOrigin FibularisLongusMuscle Fibula)
(muscleInsertion FibularisLongusMuscle BaseOfFirstMetatarsal)
(muscleInsertion FibularisLongusMuscle MedialCuneiformBone)
(suppliesBlood FibularArtery FibularisLongusMuscle)
(ennervates SuperficialFibularNerve FibularisLongusMuscle)
(subclass SuperficialFibularNerve Nerve)
(termFormat EnglishWrittenLanguage SuperficialFibularNerve "superficial fibular nerve")
(documentation FibularisLongusMuscle EnglishWrittenLanguage "The &%FibularisLongusMuscle plantarflexes and everts &%Ankle.")
(antagonistMuscles TibialisAnteriorMuscle FibularisLongusMuscle)

(subclass FifthMetatarsalBone FootBone)
(termFormat EnglishWrittenLanguage FifthMetatarsalBone "fifth metatarsal bone")
(documentation FifthMetatarsalBone EnglishWrittenLanguage "The metatarsal bone associated with the fifth and most lateral toe of a human foot.")

(subclass FibularisBrevisMuscle Muscle)
(termFormat EnglishWrittenLanguage FibularisBrevisMuscle "fibularis brevis muscle")
(muscleOrigin FibularisBrevisMuscle Fibula)
(muscleInsertion FibularisBrevisMuscle FifthMetatarsalBone)
(suppliesBlood FibularArtery FibularisBrevisMuscle)
(ennervates SuperficialFibularNerve FibularisBrevisMuscle)
(documentation FibularisBrevisMuscle EnglishWrittenLanguage "The &%FibularisBrevisMuscle plantarflexes and everts &%Ankle.")
(antagonistMuscles TibialisPosteriorMuscle FibularisBrevisMuscle)

(subclass Toes BodyPart)
(termFormat EnglishWrittenLanguage Toes "toes")
(documentation Toes EnglishWrittenLanguage "The class of individual digits of the foot, including
    the great toe and the second through fifth toes.")

(subclass ExtensorDigitorumBrevisMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorDigitorumBrevisMuscle "extensor digitorum brevis")
(muscleOrigin ExtensorDigitorumBrevisMuscle CalcaneusBone)
(muscleInsertion ExtensorDigitorumBrevisMuscle Toes)
(ennervates DeepFibularNerve ExtensorDigitorumBrevisMuscle)
(documentation ExtensorDigitorumBrevisMuscle EnglishWrittenLanguage "The &%ExtensorDigitorumBrevisMuscle extends digits 2, 3, and 4.")
(antagonistMuscles FlexorDigitorumLongusMuscle ExtensorDigitorumBrevisMuscle)
(antagonistMuscles FlexorDigitorumBrevisMuscle ExtensorDigitorumBrevisMuscle)

(subclass BaseOfProximalPhalanxOfBigToe Bone)
(termFormat EnglishWrittenLanguage BaseOfProximalPhalanxOfBigToe "base of proximal phalanx of big toe")
(documentation BaseOfProximalPhalanxOfBigToe EnglishWrittenLanguage "The expanded proximal portion of the great toe's proximal
    phalanx, articulating with the head of the first metatarsal.")

(subclass ExtensorHallucisBrevisMuscle Muscle)
(termFormat EnglishWrittenLanguage ExtensorHallucisBrevisMuscle "extensor hallucis brevis muscle")
(muscleOrigin ExtensorHallucisBrevisMuscle CalcaneusBone)
(muscleInsertion ExtensorHallucisBrevisMuscle BaseOfProximalPhalanxOfBigToe)
(ennervates DeepFibularNerve ExtensorHallucisBrevisMuscle)
(documentation ExtensorHallucisBrevisMuscle EnglishWrittenLanguage "The &%ExtensorHallucisBrevisMuscle extends big &%Toe.")
(antagonistMuscles FlexorHallucisBrevisMuscle ExtensorHallucisBrevisMuscle)

(subclass Metatarsals Bone)
(termFormat EnglishWrittenLanguage Metatarsals
    "metatarsal bone")
(documentation Metatarsals EnglishWrittenLanguage
    "A long bone of the foot situated between the tarsal bones and the proximal phalanx of a toe.")

(subclass ProximalPhalanges Bone)
(termFormat EnglishWrittenLanguage ProximalPhalanges
    "proximal phalanx")
(documentation ProximalPhalanges EnglishWrittenLanguage
    "A phalanx forming the proximal skeletal segment of a finger or toe and articulating proximally with a metacarpal or metatarsal bone.")

(subclass DorsalInterosseiOfFootMuscle Muscle)
(termFormat EnglishWrittenLanguage DorsalInterosseiOfFootMuscle "dorsal interossei of foot muscle")
(muscleOrigin DorsalInterosseiOfFootMuscle Metatarsals)
(muscleInsertion DorsalInterosseiOfFootMuscle ProximalPhalanges)
(ennervates LateralPlantarNerveFourthInterosseousSpaceSuperficialBranchOthersDeepBranchFirstAndSecondInterosseiLateralBranchOfDeepFibularNerve DorsalInterosseiOfFootMuscle)
(subclass LateralPlantarNerveFourthInterosseousSpaceSuperficialBranchOthersDeepBranchFirstAndSecondInterosseiLateralBranchOfDeepFibularNerve Nerve)
(termFormat EnglishWrittenLanguage LateralPlantarNerveFourthInterosseousSpaceSuperficialBranchOthersDeepBranchFirstAndSecondInterosseiLateralBranchOfDeepFibularNerve "lateral plantar nerve(fourth interosseous space: superficial branch others: deep branch), first and second interossei: lateral branch of deep fibular nerve")
(documentation DorsalInterosseiOfFootMuscle EnglishWrittenLanguage "The &%DorsalInterosseiOfFootMuscle abducts &%Toes.")
(antagonistMuscles PlantarInterosseiMuscle DorsalInterosseiOfFootMuscle)

(subclass AbductorHallucisMuscle Muscle)
(termFormat EnglishWrittenLanguage AbductorHallucisMuscle "abductor hallucis muscle")
(muscleOrigin AbductorHallucisMuscle MedialProcessOfCalcanealTuberosity)
(muscleOrigin AbductorHallucisMuscle FlexorRetinaculumOfFoot)
(muscleOrigin AbductorHallucisMuscle PlantarAponeurosis)
(muscleInsertion AbductorHallucisMuscle MedialSideOfBaseOfProximalPhalanxOfFirstDigit)
(ennervates MedialPlantarNerve AbductorHallucisMuscle)
(subclass MedialPlantarNerve Nerve)
(termFormat EnglishWrittenLanguage MedialPlantarNerve "medial plantar nerve")
(documentation AbductorHallucisMuscle EnglishWrittenLanguage "The &%AbductorHallucisMuscle abducts hallux.")
(antagonistMuscles AdductorHallucisMuscle AbductorHallucisMuscle)

(subclass FlexorDigitorumBrevisMuscle Muscle)
(termFormat EnglishWrittenLanguage FlexorDigitorumBrevisMuscle "flexor digitorum brevis muscle")
(muscleOrigin FlexorDigitorumBrevisMuscle MedialProcessOfCalcanealTuberosity)
(muscleOrigin FlexorDigitorumBrevisMuscle PlantarAponeurosis)
(muscleOrigin FlexorDigitorumBrevisMuscle PlantarIntermuscularSepta)
(muscleInsertion FlexorDigitorumBrevisMuscle MiddlePhalangesOfDigits25)
(ennervates MedialPlantarNerve FlexorDigitorumBrevisMuscle)
(documentation FlexorDigitorumBrevisMuscle EnglishWrittenLanguage "The &%FlexorDigitorumBrevisMuscle performs &%Flexion of  lateral four &%Toes.")
(antagonistMuscles ExtensorDigitorumLongusMuscle FlexorDigitorumBrevisMuscle)
(antagonistMuscles ExtensorDigitorumBrevisMuscle FlexorDigitorumBrevisMuscle)

(subclass PhalangesOfFifthToe ToeBone)
(termFormat EnglishWrittenLanguage PhalangesOfFifthToe "phalanges of fifth toe")
(documentation PhalangesOfFifthToe EnglishWrittenLanguage "The class of phalangeal bones belonging to the fifth (little)
    toe of a foot.")

(subclass PlantarAponeurosis BodyPart)
(termFormat EnglishWrittenLanguage PlantarAponeurosis "plantar aponeurosis")
(documentation PlantarAponeurosis EnglishWrittenLanguage "A thick fibrous sheet extending along the sole from the
    calcaneus toward the toes, helping support the longitudinal
    arch of the foot.")

(muscleOrigin AbductorDigitiMinimiMuscle PlantarAponeurosis)
(muscleInsertion AbductorDigitiMinimiMuscle PhalangesOfFifthToe)
(suppliesBlood LateralPlantarArtery AbductorDigitiMinimiMuscle)
(ennervates LateralPlantarNerveS1S2 AbductorDigitiMinimiMuscle)
(subclass LateralPlantarNerveS1S2 Nerve)
(termFormat EnglishWrittenLanguage LateralPlantarNerveS1S2 "lateral plantar nerve (S1, S2)")
(documentation AbductorDigitiMinimiMuscle EnglishWrittenLanguage "The &%AbductorDigitiMinimiMuscle performs &%Flexion of  and abducts fifth &%Toe.")
(antagonistMuscles FlexorDigitiMinimiBrevisMuscle AbductorDigitiMinimiMuscle)

(subclass TendonsOfFlexorDigitorumLongus Tendon)
(termFormat EnglishWrittenLanguage TendonsOfFlexorDigitorumLongus "tendons of flexor digitorum longus")
(documentation TendonsOfFlexorDigitorumLongus EnglishWrittenLanguage "The class of tendons through which the flexor digitorum longus
    muscle inserts on the distal phalanges of the second through
    fifth toes.")

(subclass QuadratusPlantaeMuscle Muscle)
(termFormat EnglishWrittenLanguage QuadratusPlantaeMuscle "quadratus plantae muscle")
(muscleOrigin QuadratusPlantaeMuscle CalcaneusBone)
(muscleInsertion QuadratusPlantaeMuscle TendonsOfFlexorDigitorumLongus)
(ennervates LateralPlantarNerveS1S2 QuadratusPlantaeMuscle)
(documentation QuadratusPlantaeMuscle EnglishWrittenLanguage "The &%QuadratusPlantaeMuscle performs &%Flexion of  distal interphalangeal &%BodyJoints (assists flexor digitorum longus).")

(subclass LumbricalsMuscle Muscle)
(termFormat EnglishWrittenLanguage LumbricalsMuscle "lumbricals muscle")
(muscleOrigin LumbricalsMuscle TendonsOfFlexorDigitorumLongus)
(muscleInsertion LumbricalsMuscle MedialSurfaceOfExtensorExpansionOfProximalPhalangesOfLateralFourToes)
(suppliesBlood LateralPlantarArtery LumbricalsMuscle)
(suppliesBlood PlantarArterialArch LumbricalsMuscle)
(suppliesBlood PlantarMetatarsalArtery LumbricalsMuscle)
(ennervates LateralPlantarNerveLateralThreeLumbricalsAndMedialPlantarNerveFirstLumbrical LumbricalsMuscle)
(subclass LateralPlantarNerveLateralThreeLumbricalsAndMedialPlantarNerveFirstLumbrical Nerve)
(termFormat EnglishWrittenLanguage LateralPlantarNerveLateralThreeLumbricalsAndMedialPlantarNerveFirstLumbrical "lateral plantar nerve (lateral three lumbricals) and medial plantar nerve (first lumbrical)")
(documentation LumbricalsMuscle EnglishWrittenLanguage "The &%LumbricalsMuscle maintain &%Extension of digits at interphalangeal &%BodyJoints.")

(subclass PlantarSurfaceOfCuneiforms FootBone)
(termFormat EnglishWrittenLanguage PlantarSurfaceOfCuneiforms "plantar surface of cuneiform bones")
(documentation PlantarSurfaceOfCuneiforms EnglishWrittenLanguage "The superficial bony region on the plantar aspect of a medial,
    intermediate, or lateral cuneiform bone, facing the sole of
    the foot.")

(subclass FlexorHallucisBrevis Muscle)
(termFormat EnglishWrittenLanguage FlexorHallucisBrevis "flexor hallucis brevis muscle")
(documentation FlexorHallucisBrevis EnglishWrittenLanguage "An intrinsic plantar muscle of the foot that flexes the great toe at its metatarsophalangeal joint.")

(subclass FlexorHallucisBrevisMuscle Muscle)
(termFormat EnglishWrittenLanguage FlexorHallucisBrevisMuscle "flexor hallucis brevis muscle")
(muscleOrigin FlexorHallucisBrevisMuscle PlantarSurfaceOfCuneiforms)
(muscleInsertion FlexorHallucisBrevisMuscle BaseOfProximalPhalanxOfBigToe)
(ennervates MedialPlantarNerve FlexorHallucisBrevisMuscle)
(documentation FlexorHallucisBrevisMuscle EnglishWrittenLanguage "The &%FlexorHallucisBrevisMuscle flexes big &%Toe.")
(antagonistMuscles ExtensorHallucisLongusMuscle FlexorHallucisBrevis)

(subclass PhalanxOfBigToe ToeBone)
(termFormat EnglishWrittenLanguage PhalanxOfBigToe "phalanx of big toe")
(documentation PhalanxOfBigToe EnglishWrittenLanguage "A phalangeal bone of the great toe (hallux), either its
    proximal or distal phalanx.")

(subclass ProximalEndOfmetatarsal FootBone)
(termFormat EnglishWrittenLanguage ProximalEndOfmetatarsal
    "proximal end of metatarsal")
(documentation ProximalEndOfmetatarsal EnglishWrittenLanguage
    "The proximal bony region, or base, of a metatarsal bone, where the metatarsal articulates with tarsal bones and adjacent metatarsals.")

(subclass AdductorHallucisMuscle Muscle)
(termFormat EnglishWrittenLanguage AdductorHallucisMuscle "adductor hallucis muscle")
(muscleOrigin AdductorHallucisMuscle ProximalEndOfmetatarsal)
(muscleInsertion AdductorHallucisMuscle PhalanxOfBigToe)
(ennervates LateralPlantarNerve AdductorHallucisMuscle)
(subclass LateralPlantarNerve Nerve)
(termFormat EnglishWrittenLanguage LateralPlantarNerve "lateral plantar nerve ")
(documentation AdductorHallucisMuscle EnglishWrittenLanguage "The &%AdductorHallucisMuscle eadducts big &%Toe.")
(antagonistMuscles AbductorHallucisMuscle AdductorHallucisMuscle)

(subclass PhalanxOfFifthToe ToeBone)
(termFormat EnglishWrittenLanguage PhalanxOfFifthToe "phalanx of fifth toe")
(documentation PhalanxOfFifthToe EnglishWrittenLanguage "An individual phalangeal bone belonging to the fifth
    (little) toe of a foot.")

(subclass FlexorDigitiMinimiBrevisMuscle Muscle)
(termFormat EnglishWrittenLanguage FlexorDigitiMinimiBrevisMuscle "flexor digiti minimi brevis muscle")
(muscleOrigin FlexorDigitiMinimiBrevisMuscle FifthMetatarsalBone)
(muscleInsertion FlexorDigitiMinimiBrevisMuscle PhalanxOfFifthToe)
(ennervates LateralPlantarNerveSuperficialBranch FlexorDigitiMinimiBrevisMuscle)
(subclass LateralPlantarNerveSuperficialBranch Nerve)
(termFormat EnglishWrittenLanguage LateralPlantarNerveSuperficialBranch "lateral plantar nerve (superficial branch)")
(documentation FlexorDigitiMinimiBrevisMuscle EnglishWrittenLanguage "The &%FlexorDigitiMinimiBrevisMuscle extends and adducts fifth &%Toe.")
(antagonistMuscles AbductorDigitiMinimiMuscle FlexorDigitiMinimiBrevisMuscle)

(subclass TendonsOfPlantarInterossei Tendon)
(termFormat EnglishWrittenLanguage TendonsOfPlantarInterossei "tendons of plantar interossei")
(documentation TendonsOfPlantarInterossei EnglishWrittenLanguage "The class of tendons through which the plantar interosseous
    muscles attach to the proximal phalanges and extensor expansions
    of the third through fifth toes.")

(subclass PlantarInterosseiMuscle Muscle)
(termFormat EnglishWrittenLanguage PlantarInterosseiMuscle "plantar interossei muscle")
(muscleOrigin PlantarInterosseiMuscle TendonsOfPlantarInterossei)
(muscleInsertion PlantarInterosseiMuscle BasesOfProximalPhalangesOfThirdThroughFifthToes)
(suppliesBlood PlantarArterialArch PlantarInterosseiMuscle)
(suppliesBlood DorsalMetatarsalArtery PlantarInterosseiMuscle)
(ennervates LateralPlantarNerve PlantarInterosseiMuscle)
(documentation PlantarInterosseiMuscle EnglishWrittenLanguage "The &%PlantarInterosseiMuscle adducts &%Toes 3 - 5, strengthens transverse arch.")
(antagonistMuscles DorsalInterosseiMuscle PlantarInterosseiMuscle)

(subclass ProximalPhalanx FootBone)
(termFormat EnglishWrittenLanguage ProximalPhalanx "proximal phalanx")
(documentation ProximalPhalanx EnglishWrittenLanguage "The phalangeal bone nearest the hand or foot in a digit,
    articulating proximally with a metacarpal or metatarsal.")

(subclass DorsalInterosseiMuscle Muscle)
(termFormat EnglishWrittenLanguage DorsalInterosseiMuscle "dorsal interossei muscle")
(muscleOrigin DorsalInterosseiMuscle Metatarsals)
(muscleInsertion DorsalInterosseiMuscle ProximalPhalanx)
(ennervates LateralPlantarNerve DorsalInterosseiMuscle)
(documentation DorsalInterosseiMuscle EnglishWrittenLanguage "The &%DorsalInterosseiMuscle abducts &%Toes.")
(antagonistMuscles PlantarInterosseiMuscle DorsalInterosseiMuscle)


; Remaining anatomical terms resolved from their muscle-attachment context.
; Plural classes denote individual members; separate structures have separate facts.

(subclass DorsalMetacarpalArtery Artery)
(termFormat EnglishWrittenLanguage DorsalMetacarpalArtery "dorsal metacarpal artery")
(documentation DorsalMetacarpalArtery EnglishWrittenLanguage
    "An artery running along the dorsum of the hand between metacarpal bones.")

(subclass PosteriorIntercostalArtery IntercostalArtery)
(termFormat EnglishWrittenLanguage PosteriorIntercostalArtery "posterior intercostal artery")
(documentation PosteriorIntercostalArtery EnglishWrittenLanguage
    "An artery supplying an intercostal space from its posterior aspect.")

(subclass PlantarArterialArch Artery)
(termFormat EnglishWrittenLanguage PlantarArterialArch "plantar arterial arch")
(documentation PlantarArterialArch EnglishWrittenLanguage
    "The arterial arch of the sole formed by the lateral plantar artery and the deep plantar branch of the dorsalis pedis artery.")

(subclass PlantarMetatarsalArtery Artery)
(termFormat EnglishWrittenLanguage PlantarMetatarsalArtery "plantar metatarsal artery")
(documentation PlantarMetatarsalArtery EnglishWrittenLanguage
    "An artery supplying the plantar metatarsal region and contributing digital branches to the toes.")

(subclass DorsalMetatarsalArtery Artery)
(termFormat EnglishWrittenLanguage DorsalMetatarsalArtery "dorsal metatarsal artery")
(documentation DorsalMetatarsalArtery EnglishWrittenLanguage
    "An artery supplying the dorsal metatarsal region and adjacent toes.")

(subclass GlutealArtery Artery)
(termFormat EnglishWrittenLanguage GlutealArtery "gluteal artery")
(documentation GlutealArtery EnglishWrittenLanguage
    "A superior or inferior gluteal artery supplying the gluteal region.")

(subclass CommonPalmarDigitalArtery Artery)
(termFormat EnglishWrittenLanguage CommonPalmarDigitalArtery "common palmar digital artery")
(documentation CommonPalmarDigitalArtery EnglishWrittenLanguage
    "An artery in the palm that divides into proper palmar digital arteries supplying adjacent sides of fingers.")

(subclass DorsalDigitalArteryOfHand Artery)
(termFormat EnglishWrittenLanguage DorsalDigitalArteryOfHand "dorsal digital artery of hand")
(documentation DorsalDigitalArteryOfHand EnglishWrittenLanguage
    "An artery supplying the dorsal tissues of a finger.")

(subclass StapedialBranchOfPosteriorAuricularArtery Artery)
(termFormat EnglishWrittenLanguage StapedialBranchOfPosteriorAuricularArtery "stapedial branch of posterior auricular artery")
(documentation StapedialBranchOfPosteriorAuricularArtery EnglishWrittenLanguage
    "An arterial branch reaching the stapedius through the stylomastoid arterial supply, commonly derived from the posterior auricular artery.")

(subclass PosteriorThighMuscle Muscle)
(termFormat EnglishWrittenLanguage PosteriorThighMuscle "posterior thigh muscle")
(documentation PosteriorThighMuscle EnglishWrittenLanguage
    "A muscle of the posterior compartment of the thigh.")

(subclass LevatorAniPubococcygeusMuscle Muscle)
(termFormat EnglishWrittenLanguage LevatorAniPubococcygeusMuscle "pubococcygeus muscle")
(documentation LevatorAniPubococcygeusMuscle EnglishWrittenLanguage
    "The pubococcygeus component of the levator ani, extending from the pubic region toward the coccyx and supporting the pelvic viscera.")

(subclass AuricularesMuscles Muscle)
(termFormat EnglishWrittenLanguage AuricularesMuscles "auricular muscle")
(documentation AuricularesMuscles EnglishWrittenLanguage
    "An anterior, superior, or posterior extrinsic auricular muscle that moves the auricle.")

(subclass AlveolarProcessOfMaxilla Bone)
(termFormat EnglishWrittenLanguage AlveolarProcessOfMaxilla "alveolar process of maxilla")
(documentation AlveolarProcessOfMaxilla EnglishWrittenLanguage
    "The tooth-bearing bony process of the maxilla containing the sockets of the upper teeth.")

(subclass AlveolarProcessOfMandible Bone)
(termFormat EnglishWrittenLanguage AlveolarProcessOfMandible "alveolar process of mandible")
(documentation AlveolarProcessOfMandible EnglishWrittenLanguage
    "The tooth-bearing bony part of the mandible containing the sockets of the lower teeth.")

(subclass AnteriorInferiorIliacSpine Bone)
(termFormat EnglishWrittenLanguage AnteriorInferiorIliacSpine "anterior inferior iliac spine")
(documentation AnteriorInferiorIliacSpine EnglishWrittenLanguage
    "The anterior iliac projection below the anterior superior iliac spine that provides origin for the straight head of rectus femoris.")

(subclass SupraAcetabularGrooveOfIlium Bone)
(termFormat EnglishWrittenLanguage SupraAcetabularGrooveOfIlium "supra-acetabular groove of ilium")
(documentation SupraAcetabularGrooveOfIlium EnglishWrittenLanguage
    "The bony groove immediately superior to the acetabulum that provides origin for the reflected head of rectus femoris.")

(subclass CommonExtensorTendon Tendon)
(termFormat EnglishWrittenLanguage CommonExtensorTendon "common extensor tendon")
(documentation CommonExtensorTendon EnglishWrittenLanguage
    "The shared tendinous origin of several forearm extensor muscles at the lateral epicondyle of the humerus.")

(subclass AnteriorTwoThirdsOfInferiorBorderOfZygomaticArch Bone)
(termFormat EnglishWrittenLanguage AnteriorTwoThirdsOfInferiorBorderOfZygomaticArch "anterior two thirds of inferior border of zygomatic arch")
(documentation AnteriorTwoThirdsOfInferiorBorderOfZygomaticArch EnglishWrittenLanguage
    "The bony inferior margin of the anterior two thirds of the zygomatic arch.")

(subclass ZygomaticProcessOfMaxilla Bone)
(termFormat EnglishWrittenLanguage ZygomaticProcessOfMaxilla "zygomatic process of maxilla")
(documentation ZygomaticProcessOfMaxilla EnglishWrittenLanguage
    "The lateral bony process of the maxilla that articulates with the zygomatic bone.")

(subclass ArticularProcessesOfC4ThroughC6 Bone)
(termFormat EnglishWrittenLanguage ArticularProcessesOfC4ThroughC6 "articular processes of C4 through C6")
(documentation ArticularProcessesOfC4ThroughC6 EnglishWrittenLanguage
    "An articular process belonging to the fourth, fifth, or sixth cervical vertebra.")

(subclass TransverseProcessesOfC7ThroughT7 TransverseProcess)
(termFormat EnglishWrittenLanguage TransverseProcessesOfC7ThroughT7 "transverse processes of C7 through T7")
(documentation TransverseProcessesOfC7ThroughT7 EnglishWrittenLanguage
    "A transverse process of the seventh cervical vertebra or any of the first seven thoracic vertebrae.")

(subclass BaseOfSecondMetacarpal Bone)
(termFormat EnglishWrittenLanguage BaseOfSecondMetacarpal "base of second metacarpal")
(documentation BaseOfSecondMetacarpal EnglishWrittenLanguage
    "The proximal bony end of the second metacarpal, adjacent to the carpus.")

(subclass LateralThirdOfClavicle Bone)
(termFormat EnglishWrittenLanguage LateralThirdOfClavicle "lateral third of clavicle")
(documentation LateralThirdOfClavicle EnglishWrittenLanguage
    "The lateral third of the clavicle, adjacent to the acromion.")

(subclass AcromionOfScapula Bone)
(termFormat EnglishWrittenLanguage AcromionOfScapula "acromion of scapula")
(documentation AcromionOfScapula EnglishWrittenLanguage
    "The lateral expansion of the scapular spine that projects over the shoulder joint.")

(subclass SpineOfScapula Bone)
(termFormat EnglishWrittenLanguage SpineOfScapula "spine of scapula")
(documentation SpineOfScapula EnglishWrittenLanguage
    "The prominent posterior scapular ridge separating the supraspinous and infraspinous fossae.")

(subclass AnteriorSurfaceOfMedialHalfOfClavicle Bone)
(termFormat EnglishWrittenLanguage AnteriorSurfaceOfMedialHalfOfClavicle "anterior surface of medial half of clavicle")
(documentation AnteriorSurfaceOfMedialHalfOfClavicle EnglishWrittenLanguage
    "The superficial anterior bony region of the medial half of the clavicle.")

(subclass AnteriorSurfaceOfSternum Bone)
(termFormat EnglishWrittenLanguage AnteriorSurfaceOfSternum "anterior surface of sternum")
(documentation AnteriorSurfaceOfSternum EnglishWrittenLanguage
    "The superficial bony region on the front of the sternum.")

(subclass SuperiorSixCostalCartilages Cartilage)
(termFormat EnglishWrittenLanguage SuperiorSixCostalCartilages "first six costal cartilages")
(documentation SuperiorSixCostalCartilages EnglishWrittenLanguage
    "A costal cartilage associated with any of the first six ribs.")

(subclass CoronoidProcessOfUlna Bone)
(termFormat EnglishWrittenLanguage CoronoidProcessOfUlna "coronoid process of ulna")
(documentation CoronoidProcessOfUlna EnglishWrittenLanguage
    "The anterior projection of the proximal ulna below the trochlear notch.")

(subclass UlnarTuberosity Bone)
(termFormat EnglishWrittenLanguage UlnarTuberosity "ulnar tuberosity")
(documentation UlnarTuberosity EnglishWrittenLanguage
    "The roughened anterior ulnar region distal to the coronoid process where brachialis attaches.")

(subclass LowerTrueRibCostalCartilages CostalCartilage)
(termFormat EnglishWrittenLanguage LowerTrueRibCostalCartilages "lower true rib costal cartilages")
(documentation LowerTrueRibCostalCartilages EnglishWrittenLanguage
    "A costal cartilage of the lower true ribs, near the inferior sternum.")

(subclass PosteriorSurfaceOfBodyOfSternum Bone)
(termFormat EnglishWrittenLanguage PosteriorSurfaceOfBodyOfSternum "posterior surface of body of sternum")
(documentation PosteriorSurfaceOfBodyOfSternum EnglishWrittenLanguage
    "The superficial bony region on the posterior aspect of the sternal body.")

(subclass XiphoidProcessOfSternum BodyPart)
(termFormat EnglishWrittenLanguage XiphoidProcessOfSternum "xiphoid process of sternum")
(documentation XiphoidProcessOfSternum EnglishWrittenLanguage
    "The inferior process of the sternum, initially cartilaginous and variably ossified in adults.")

(subclass CricoidCartilage Cartilage)
(termFormat EnglishWrittenLanguage CricoidCartilage "cricoid cartilage")
(documentation CricoidCartilage EnglishWrittenLanguage
    "The ring-shaped laryngeal cartilage inferior to the thyroid cartilage.")

(subclass LineaAsperaOfFemur Bone)
(termFormat EnglishWrittenLanguage LineaAsperaOfFemur "linea aspera of femur")
(documentation LineaAsperaOfFemur EnglishWrittenLanguage
    "The longitudinal roughened ridge on the posterior femoral shaft.")

(subclass MedialSupracondylarLineOfFemur Bone)
(termFormat EnglishWrittenLanguage MedialSupracondylarLineOfFemur "medial supracondylar line of femur")
(documentation MedialSupracondylarLineOfFemur EnglishWrittenLanguage
    "The bony ridge extending from the medial lip of the linea aspera toward the medial femoral condyle.")

(subclass AdductorTubercleOfFemur Bone)
(termFormat EnglishWrittenLanguage AdductorTubercleOfFemur "adductor tubercle of femur")
(documentation AdductorTubercleOfFemur EnglishWrittenLanguage
    "The prominence on the medial femoral epicondyle receiving the hamstring part of adductor magnus.")

(subclass PosteriorSurfaceOfProximalFibula Bone)
(termFormat EnglishWrittenLanguage PosteriorSurfaceOfProximalFibula "posterior surface of proximal fibula")
(documentation PosteriorSurfaceOfProximalFibula EnglishWrittenLanguage
    "The superficial posterior bony region of the proximal fibula.")

(subclass SolealLineOfTibia Bone)
(termFormat EnglishWrittenLanguage SolealLineOfTibia "soleal line of tibia")
(documentation SolealLineOfTibia EnglishWrittenLanguage
    "The oblique ridge on the posterior tibia that provides attachment for soleus.")

(subclass MedialBorderOfTibia Bone)
(termFormat EnglishWrittenLanguage MedialBorderOfTibia "medial border of tibia")
(documentation MedialBorderOfTibia EnglishWrittenLanguage
    "The bony medial border of the tibial shaft.")

(subclass BaseOfFirstMetatarsal Bone)
(termFormat EnglishWrittenLanguage BaseOfFirstMetatarsal "base of first metatarsal")
(documentation BaseOfFirstMetatarsal EnglishWrittenLanguage
    "The proximal bony end of the first metatarsal.")

(subclass FlexorRetinaculumOfHand Ligament)
(termFormat EnglishWrittenLanguage FlexorRetinaculumOfHand "flexor retinaculum of hand")
(documentation FlexorRetinaculumOfHand EnglishWrittenLanguage
    "The fibrous band spanning the palmar carpus and forming the roof of the carpal tunnel.")

(subclass MedialPalmarAponeurosis BodyPart)
(termFormat EnglishWrittenLanguage MedialPalmarAponeurosis "medial palmar aponeurosis")
(documentation MedialPalmarAponeurosis EnglishWrittenLanguage
    "The medial portion of the fibrous palmar aponeurosis.")

(subclass PosteriorGlutealSurfaceOfIlium Bone)
(termFormat EnglishWrittenLanguage PosteriorGlutealSurfaceOfIlium "posterior gluteal surface of ilium")
(documentation PosteriorGlutealSurfaceOfIlium EnglishWrittenLanguage
    "The external iliac bony region posterior to the posterior gluteal line.")

(subclass ThoracolumbarFascia BodyPart)
