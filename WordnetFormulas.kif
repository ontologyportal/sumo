;; WordnetMappings.kif
;; The following are terms that are useful for natural language processing, but are not valid SUMO terms due to their violation of lifelong class membership.
(subclass Steam WaterSolution)
(documentation
  Steam
  EnglishWrittenLanguage
  "&%Steam refers to the &%Gas form of &%Water that
is a result of &%Boiling it and diffusing it into the air")
(termFormat EnglishWrittenLanguage Steam "steam")
(=>
  (instance ?STEAM Steam)
  (exists (?BOIL ?WATER)
    (and
      (instance ?BOIL Boiling)
      (instance ?WATER WaterSolution)
      (patient ?BOIL ?WATER)
      (result ?BOIL ?STEAM)
      (attribute ?STEAM Gas))))

(subclass Ice WaterSolution)
(externalImage Ice "http://upload.wikimedia.org/wikipedia/commons/c/c2/SnowflakesWilsonBentley.jpg")
(documentation
  Ice
  EnglishWrittenLanguage
  "&%Water that has the &%PhysicalState of &%Solid.")
(=>
  (instance ?ICE Ice)
  (and
    (instance ?ICE WaterSolution)
    (attribute ?ICE Solid)))

(=>
  (and
    (instance ?ICE Ice)
    (measure
      ?ICE
      (MeasureFn ?NUMBER CelsiusDegree)))
  (lessThanOrEqualTo ?NUMBER 0.0))