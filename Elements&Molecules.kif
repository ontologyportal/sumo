;; Elements&Molecules.kif
;; Lists atoms, molecules, and relationships between substances and corpuscles

(subclass HydrogenAtom Atom)
(documentation HydrogenAtom EnglishWrittenLanguage "An &%Atom containing one &%Proton.")

(subclass OxygenAtom Atom)
(documentation OxygenAtom EnglishWrittenLanguage "An &%Atom containing 8 &%Proton.")

(subclass WaterMolecule Molecule)
(documentation WaterMolecule EnglishWrittenLanguage "A &%Molecule of water made up of 2 &%HydrogenAtom and one &%OxygenAtom")

(=>
  (instance ?WATER WaterMolecule)
  (exists (?SYNTHESIS ?HYDROGEN ?OXYGEN)
    (and
      (instance ?SYNTHESIS ChemicalSynthesis)
      (resource ?SYNTHESIS ?HYDROGEN)
      (instance ?HYDROGEN HydrogenAtom)
      (resource ?SYNTHESIS ?OXYGEN)
      (instance ?OXYGEN OxygenAtom)
      (result ?SYNTHESIS ?WATER))))

(substanceCorpuscle WaterSolution WaterMolecule)
(substanceCorpuscle PurifiedWater WaterMolecule)

(subclass CaffeineMolecule Molecule)
(documentation CaffeineMolecule EnglishWrittenLanguage "a central nervous system stimulant and methylxanthine alkaloid found naturally in plants like coffee beans and tea leaves. Molecular Formula: C8H10N4O2")

(substanceCorpuscle Caffeine CaffeineMolecule)