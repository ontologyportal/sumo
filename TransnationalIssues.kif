;; ==========================================================================

;;	A. Disputes - international
(instance internationalDispute BinaryPredicate)
(domain internationalDispute 1 GeopoliticalArea)
(domain internationalDispute 2 GeopoliticalArea)

(subclass InternationalDispute Disagreeing)
(documentation InternationalDispute EnglishLanguage "A &%Disagreeing between
&%Nations.")
(=>
  (instance ?D InternationalDispute)
  (exists (?AG1 ?AG2)
    (and
      (instance ?AG1 Nation)
      (instance ?AG2 Nation)
      (not 
        (equal ?AG1 ?AG2))
      (agent ?D ?AG1)
      (agent ?D ?AG2))))
            
(subclass MaritimeBoundaryDispute InternationalDispute)
(subclass TerritorialDispute InternationalDispute)

(documentation disputedPossession EnglishLanguage "The &%disputedPossession is a kind of &%TernaryPredicate that relates a person or entity, a specific object or piece of property, and another person or entity who contests or challenges the legal or actual possession of that object.")
(instance disputedPossession TernaryPredicate)
(domain disputedPossession 1 GeopoliticalArea)
(domain disputedPossession 2 GeopoliticalArea)
(domain disputedPossession 3 GeopoliticalArea)

(documentation IslamicMilitancy EnglishLanguage "&%IslamicMilitancy is a kind of &%ReligiousProcess characterized by the use of militant or violent methods in the pursuit of goals based on an interpretation of Islamic religious principles, functioning as a specific form of &%OrganizationalProcess and &%IntentionalProcess.")
(subclass IslamicMilitancy ReligiousProcess)
(documentation AfghanUnitedNationsStatusDetermination EnglishLanguage "A &%AfghanUnitedNationsStatusDetermination is a specific kind of &%PoliticalProcess through which the formal legal and diplomatic status of Afghanistan is evaluated, deliberated upon, and determined within the framework of the United Nations.")
(subclass AfghanUnitedNationsStatusDetermination PoliticalProcess)

;;	B. Illicit drugs
(instance illicitDrugConsumer BinaryPredicate)
(domain illicitDrugConsumer 1 GeopoliticalArea)
(domainSubclass illicitDrugConsumer 2 IllicitDrug)

(documentation illicitDrugProducer EnglishLanguage "The &%illicitDrugProducer is a kind of &%BinaryPredicate that relates a person or entity to the activity of producing drugs that are illegal or illicit according to the law.")
(instance illicitDrugProducer BinaryPredicate)
(domain illicitDrugProducer 1 GeopoliticalArea)
(domainSubclass illicitDrugProducer 2 IllicitDrug)

(documentation drugShipmentDestination EnglishLanguage "The &%drugShipmentDestination is a kind of &%TernaryPredicate that relates a specific shipment of drugs, the destination intended for that shipment, and the party or entity responsible for receiving or directing the shipment to that location.")
(instance drugShipmentDestination TernaryPredicate)
(domain drugShipmentDestination 1 GeopoliticalArea)
(domainSubclass drugShipmentDestination 2 IllicitDrug)
(domain drugShipmentDestination 3 GeopoliticalArea)

(documentation illicitDrugShipmentDestination EnglishLanguage "The &%illicitDrugShipmentDestination is a kind of &%TernaryPredicate that relates an illicit shipment of drugs, the specific illicit drug being transported, and the intended geographical or physical destination to which that shipment is being sent.")
(instance illicitDrugShipmentDestination TernaryPredicate)
(domain illicitDrugShipmentDestination 1 GeopoliticalArea)
(domainSubclass illicitDrugShipmentDestination 2 IllicitDrug)
(domain illicitDrugShipmentDestination 3 GeopoliticalArea)

(documentation illicitDrugTransshipmentPoint EnglishLanguage "The &%illicitDrugTransshipmentPoint is a kind of &%TernaryPredicate that defines a relationship between an illicit drug shipment, a physical location used as a transfer point, and the entity or organization responsible for facilitating the movement of the illegal substances through that location.")
(instance illicitDrugTransshipmentPoint TernaryPredicate)
(domain illicitDrugTransshipmentPoint 1 GeopoliticalArea)
(domainSubclass illicitDrugTransshipmentPoint 2 IllicitDrug)
(domain illicitDrugTransshipmentPoint 3 GeopoliticalArea)

;; IllicitDrugMoneyLaunderingArea
(documentation IllicitDrugMoneyLaunderingArea EnglishLanguage "A &%IllicitDrugMoneyLaunderingArea is a &%GeographicArea that is specifically characterized by being a region where the processes of laundering money derived from the illegal trafficking of drugs occur.")
(subclass IllicitDrugMoneyLaunderingArea GeographicArea)

(documentation IllicitDrug EnglishLanguage "A &%IllicitDrug is a kind of &%CompoundSubstance that is categorized as a &%ControlledSubstance and is prohibited by law from being produced, distributed, or possessed.")
(subclass IllicitDrug CompoundSubstance)
(subclass IllicitDrug ControlledSubstance)

(subclass Cannabis IllicitDrug)
(roomTempState Cannabis Solid)

(documentation Cocaine EnglishLanguage "&%Cocaine is a kind of &%IllicitDrug that is a powerful stimulant and &%Narcotic derived from the leaves of the coca plant, categorized as a &%CompoundSubstance.")
(subclass Cocaine IllicitDrug)
(documentation DepressantDrug EnglishLanguage "A &%DepressantDrug is a kind of &%IllicitDrug that is a &%CompoundSubstance acting as a central nervous system depressant, typically used to reduce arousal or slow down mental and physical functions.")
(subclass DepressantDrug IllicitDrug)
(subclass Hallucinogen IllicitDrug)

(=>
  (and
    (instance ?I Ingesting)
    (objectTransferred ?I ?H)
    (instance ?H Hallucinogen)
    (destination ?I ?P))
  (modalAttribute
    (exists (?HAL)
      (and
        (instance ?HAL Hallucination)
        (experiencer ?HAL ?P)))
    Likely))
    
(documentation Hashish EnglishLanguage "&%Hashish is a kind of &%IllicitDrug that consists of a &%CompoundSubstance derived from the resin of the Cannabis plant, often regulated as a &%ControlledSubstance.")
(subclass Hashish IllicitDrug)
(roomTempState Hashish Solid)

(subclass Heroin IllicitDrug)
(roomTempState Heroin Gas)
(subclass IllicitSyntheticDrug IllicitDrug)
(documentation Marijuana EnglishLanguage "The term &%Marijuana refers to a specific kind of &%Cannabis, typically prepared for use as an &%IllicitDrug, consisting of the dried flowers and leaves of the plant which act as a &%CompoundSubstance.")
(subclass Marijuana Cannabis)
(roomTempState Marijuana Solid)
(documentation Methamphetamine EnglishLanguage "&%Methamphetamine is a kind of &%IllicitDrug that is a potent central nervous system stimulant and a &%CompoundSubstance whose manufacture and distribution are heavily regulated as a &%ControlledSubstance.")
(subclass Methamphetamine IllicitDrug)
(roomTempState Methamphetamine Solid)
(documentation StimulantDrug EnglishLanguage "A &%StimulantDrug is a kind of &%IllicitDrug that is a &%CompoundSubstance specifically designed or used as a &%Stimulant to increase alertness, attention, or energy in the central nervous system.")
(subclass StimulantDrug IllicitDrug)
(subclass StimulantDrug Stimulant)
(roomTempState StimulantDrug Liquid)
