; Tests that an ordinary leap year has 366 calendar days:
(note DateTime_leap_year_has_366_days)
(category general)
(time 30)

(instance CalendarTestYear Integer)
(equal (RemainderFn CalendarTestYear 4) 0)
(not (equal (RemainderFn CalendarTestYear 100) 0))

(query (daysInYear CalendarTestYear 366))
(answer yes)