(subclass Eyebrow BodyPart)
(documentation Eyebrow EnglishWrittenLanguage "A &%part of the &%Face above each &%Eye that typically has &%Hair.")
(termFormat EnglishWrittenLanguage Eyebrow "eyebrow")
(initialPart Eyebrow Head)
(=>
  (and
    (instance ?E Eyebrow)
    (attribute ?H Healthy)
    (part ?E ?H))
  (exists (?EYE)
    (and
      (instance ?EYE Eye)
      (part ?EYE ?H)
      (orientation ?EYE ?E Near))))

(=>
  (and
    (instance ?E Eyebrow)
    (attribute ?H Healthy)
    (part ?E ?H)
    (member ?C ?E))
  (memberCount ?E 2))

(=>
  (and
    (instance ?E Eyebrow)
    (attribute ?H Healthy)
    (part ?E ?H)
    (member ?C ?E))
  (exists (?HAIR)
    (and
      (instance ?HAIR Hair)
      (part ?HAIR ?E))))

(=>
  (and
    (instance ?E Eyebrow)
    (holdsDuring ?T
      (and
        (attribute ?H Healthy)
        (attribute ?H Standing)))
    (part ?E ?H))
  (exists (?EYE)
    (and
      (instance ?EYE Eye)
      (part ?EYE ?H)
      (orientation ?E ?EYE Above))))

(subclass Forehead BodyPart)
(documentation Forehead EnglishWrittenLanguage "The region of the front of the &%Head above the eyes and forward of the hairline or scalp.")
(termFormat EnglishWrittenLanguage Forehead "forehead")
(initialPart Forehead Head)
(=>
  (and
    (instance ?F Forehead)
    (holdsDuring ?T
      (and
        (attribute ?H Healthy)
        (attribute ?H Standing)))
    (part ?E ?H))
  (exists (?EYE)
    (and
      (instance ?EYE Eye)
      (part ?EYE ?H)
      (orientation ?F ?EYE Above))))

(subclass EustachianTube BodyCavity)
(documentation EustachianTube EnglishWrittenLanguage "In anatomy, the Eustachian tube, also called the auditory tube or pharyngotympanic tube,
is a tube that links the nasopharynx to the middle ear, of which it is also a part. In adult humans, the
Eustachian tube is approximately 35 mm (1.4 in) long and 3 mm (0.12 in) in diameter. In humans and other tetrapods,
both the middle ear and the ear canal are normally filled with air. Unlike the air of the ear canal, however, the
air of the middle ear is not in direct contact with the atmosphere outside the body; thus, a pressure difference
can develop between the atmospheric pressure of the ear canal and the middle ear. Normally, the Eustachian tube
is collapsed, but it gapes open with swallowing and with positive pressure, allowing the middle ear's pressure
to adjust to the atmospheric pressure.
The Eustachian tube extends from the anterior wall of the middle ear to the lateral wall of the nasopharynx,
approximately at the level of the inferior nasal concha. It consists of a bony part and a cartilaginous part.
[from Wikipedia]")
(termFormat EnglishWrittenLanguage EustachianTube "Eustachian tube")
(externalImage EustachianTube "https://upload.wikimedia.org/wikipedia/commons/ d/ d2/ Anatomy_of_the_Human_Ear.svg")

(=>
  (and
    (instance ?ET EustachianTube)
    (part ?ET ?H)
    (attribute ?H Healthy)
    (instance ?TUBELENGTH LengthMeasure)
    (equal ?TUBELENGTH
      (MeasureFn ?N Centimeter))
    (length ?ET ?TUBELENGTH))
  (approximateValue ?N 35.0))

(=>
  (and
    (instance ?ET EustachianTube)
    (part ?ET ?H)
    (attribute ?H Healthy)
    (instance ?TUBEDIAMETER LengthMeasure)
    (equal ?TUBEDIAMETER
      (MeasureFn ?N Millimeter))
    (diameter ?ET ?TUBEDIAMETER))
  (approximateValue ?N 3.0))

(subclass Urethra BodyCavity)
(subclass Urethra BodyOrifice)
(documentation Urethra EnglishWrittenLanguage "The urethra is a tube that connects the urinary &%ladder to the urinary meatus for the removal of &%Urine from the body of both females and males. In human females and other &%Primates, the urethra connects to the urinary meatus above the &%Vagina, whereas in &%Marsupials, the female's urethra empties into the urogenital sinus. Females use their urethra only for &%Urination, but males use their urethra for both urination and ejaculation. The external urethral sphincter is a striated muscle that allows voluntary control over urination. The internal sphincter, formed by the involuntary smooth &%Muscles lining the bladder neck and urethra, receives its &%Nerve supply by the sympathetic division of the autonomic nervous system. The internal sphincter is present both in males and females. [from Wikipedia]")
(termFormat EnglishWrittenLanguage Urethra "urethra")
(externalImage Urethra "https://upload.wikimedia.org/wikipedia/commons/3/ 30/ Urinary_system.svg")
(connectedBodyPartTypes Urethra Bladder Human)

(=>
  (instance ?U Urethra)
  (hasPurpose ?U
    (exists (?UR)
      (and
        (instance ?UR Urination)
        (instrument ?UR ?U)))))

(subclass AuditoryCanal BodyCavity)
(documentation AuditoryCanal EnglishWrittenLanguage "The ear canal (external acoustic meatus, external auditory meatus, EAM) is a pathway running from the outer ear to the middle ear. The adult human ear canal extends from the pinna to the eardrum and is about 2.5 centimetres (1 in) in length and 0.7 centimetres (0.3 in) in diameter.[from Wikipedia]")
(termFormat EnglishWrittenLanguage AuditoryCanal "auditory canal")
(connectedBodyPartTypes AuditoryCanal TympanicCavity Human)

(=>
  (and
    (instance ?ET AuditoryCanal)
    (part ?ET ?H)
    (attribute ?H Healthy)
    (instance ?CANALLENGTH LengthMeasure)
    (equal ?CANALLENGTH
      (MeasureFn ?N Centimeter))
    (length ?ET ?CANALLENGTH))
  (approximateValue ?N 2.5))

(=>
  (and
    (instance ?ET AuditoryCanal)
    (part ?ET ?H)
    (attribute ?H Healthy)
    (instance ?CANALDIAMETER LengthMeasure)
    (equal ?CANALDIAMETER
      (MeasureFn ?N Millimeter))
    (diameter ?ET ?CANALDIAMETER))
  (approximateValue ?N 0.7))

(subclass TympanicCavity BodyCavity)
(documentation TympanicCavity EnglishWrittenLanguage "The tympanic cavity is a small &%BodyCavity surrounding the bones of the middle ear. Within it sit the ossicles (&%InnerEarBone), three small &%Bones that transmit vibrations used in the detection of sound. On its lateral surface, it abuts the external auditory meatus [ &%AuditoryCanal ] from which it is separated by the tympanic membrane (eardrum).[from Wikipedia]")
(termFormat EnglishWrittenLanguage TympanicCavity "tympanic cavity")
(termFormat EnglishWrittenLanguage TympanicCavity "middle ear")
(connectedBodyPartTypes TympanicCavity InnerEar Human)

(subclass InnerEar BodyCavity)

(documentation InnerEar EnglishWrittenLanguage "The inner ear is the innermost part
of the vertebrate ear. In vertebrates, the inner ear is mainly responsible for sound detection and balance.
In &%Mammals, it consists of the bony labyrinth, a hollow cavity in the &%TemporalBone of the skull with a
system of passages comprising two main functional parts:
(1) The cochlea, dedicated to hearing; converting sound pressure patterns from the &%AuditoryCanal into electrochemical
impulses which are passed on to the &%Brain via the auditory nerve.
(2) The vestibular system, dedicated to balance.
The inner ear is found in all &%Vertebrates, with substantial variations in form and function. The inner ear is
innervated by the eighth cranial nerve in all vertebrates. [from Wikipedia]")

(termFormat EnglishWrittenLanguage InnerEar "inner ear")
(termFormat EnglishWrittenLanguage InnerEar "internal ear")
(termFormat EnglishWrittenLanguage InnerEar "auris interna")
(externalImage EustachianTube "https://upload.wikimedia.org/wikipedia/commons/ 1/ 14/ Blausen_0329_EarAnatomy_InternalEar.png")

(documentation Auricle EnglishWrittenLanguage "An Auricle is a &%BodyPart that is the visible outer portion of the ear.")
(subclass Auricle BodyPart)
(termFormat EnglishWrittenLanguage Auricle "auricle")
(termFormat EnglishWrittenLanguage Auricle "pinna")

(connectedBodyPartTypes Auricle AuditoryCanal Human)
(partTypes MalleusBone AuditoryCanal)
(partTypes IncusBone AuditoryCanal)
(partTypes StapesBone AuditoryCanal)
(connectedBodyPartTypes MalleusBone IncusBone Human)
(connectedBodyPartTypes MalleusBone Eardrum Human)
(connectedBodyPartTypes IncusBone StapesBone Human)

(subclass Eardrum BodyPart)
(documentation Eardrum EnglishWrittenLanguage "In the anatomy of humans and various other tetrapods, the eardrum, also called the tympanic membrane or myringa, is a thin, cone_shaped membrane that separates the external ear from the middle ear. Its function is to transmit sound from the air to the ossicles inside the middle ear, and then to the oval window in the fluid_filled cochlea. Hence, it ultimately converts and amplifies vibration in the air to vibration in cochlear fluid. The &%MalleusBone bridges the gap between the eardrum and the other ossicles. Rupture or perforation of the eardrum can lead to conductive hearing loss. Collapse or retraction of the eardrum can cause conductive hearing loss or cholesteatoma. [from Wikipedia]")
(termFormat EnglishWrittenLanguage Eardrum "eardrum")
(termFormat EnglishWrittenLanguage Eardrum "tympanic membrane")
(termFormat EnglishWrittenLanguage Eardrum "myringa")
(externalImage Eardrum "https://upload.wikimedia.org/wikipedia/commons/0/ 0d/ Blausen_0328_EarAnatomy.png")

(=>
  (and
    (instance ?E Eardrum)
    (part ?E ?H)
    (experiencer ?HEAR ?H)
    (attribute ?H Healthy)
    (instance ?HEAR Hearing))
  (instrument ?HEAR ?E))

(=>
  (holdsDuring ?T
    (attribute ?H
      (ImpairedBodyPartFn Eardrum)))
  (modalAttribute
    (not
      (exists (?HEAR)
        (and
          (instance ?HEAR Hearing)
          (during
            (WhenFn ?HEAR) ?T)
          (experiencer ?HEAR ?H)))) Likely))

(subclass Jaw BodyPart)
(documentation Jaw EnglishWrittenLanguage "The lower part of the &%Mouth of an &%Animal. It is involved in &%Chewing and creating an opening of the &%Mouth suitable for &%Breathing in &%Mammals. Motion of the jaw is involved in &%Speaking in &%Humans.")
(termFormat EnglishWrittenLanguage Jaw "jaw")

(=>
  (and
    (instance ?S Speaking)
    (instance ?J Jaw)
    (agent ?S ?H)
    (part ?J ?H))
  (modalAttribute
    (exists (?M)
      (and
        (instance ?M BodyMotion)
        (objectTransferred ?M ?J)
        (during
          (WhenFn ?M)
          (WhenFn ?S)))) Likely))


(documentation muscleOrigin EnglishWrittenLanguage "The origin of a muscle is an attachment site that connects the &%MMuscle to a &%Bone or other &%BodyPart. This point is typically proximal to the body and does not move during &%MuscularContraction (relative to &%StandardAnatomicalPosition). This is a relationship between classes of things, where a typical and healthy &%Human (and likely more broadly for &%Primates) will have a muscle with the given origin point. [from Wikipedia]")

(instance muscleOrigin BinaryPredicate)
(domainSubclass muscleOrigin 1 Muscle)
(domainSubclass muscleOrigin 2 BodyPart)
(format EnglishWrittenLanguage muscleOrigin "the &%origin of %1 is %2")
(termFormat EnglishWrittenLanguage muscleOrigin "muscle origin")

(=>
  (muscleOrigin ?MC ?BPC)
  (connectedBodyPart ?MC ?BPC))

(=>
  (and
    (muscleOrigin ?MC ?BPC)
    (instance ?H Human)
    (attribute ?H Healthy))
  (exists (?M ?BP)
    (and
      (instance ?M ?MC)
      (instance ?BP ?BPC)
      (part ?M ?H)
      (part ?BP ?H)
      (connected ?M ?BP))))

(=>
  (and
    (muscleOrigin ?MC ?BPC)
    (instance ?H Human)
    (holdsDuring ?T
      (attribute ?H StandardAnatomicalPosition))
    (attribute ?H Healthy)
    (instance ?C MuscularContraction)
    (during
      (WhenFn ?C) ?T)
    (instance ?M ?MC)
    (part ?M ?H)
    (instrument ?C ?M)
    (physicalEnd ?E ?M)
    (meetsSpatially ?E ?BP)
    (holdsDuring
      (BeginFn ?C)
      (located ?E ?L)))
  (holdsDuring
    (EndFn ?C)
    (located ?E ?L)))

(documentation muscleInsertion EnglishWrittenLanguage "The insertion of a muscle is an attachment site that connects the &%MMuscle to a &%Bone. This point is typically distal to the body and moves during &%MuscularContraction (relative to &%StandardAnatomicalPosition).[from Wikipedia]")

(instance muscleInsertion BinaryPredicate)
(domainSubclass muscleInsertion 1 Muscle)
(domainSubclass muscleInsertion 2 BodyPart)
(format EnglishWrittenLanguage muscleInsertion "the &%insertion point of %1 is %2")
(termFormat EnglishWrittenLanguage muscleInsertion "muscle insertion")

(=>
  (muscleInsertion ?MC ?BPC)
  (connectedBodyPart ?MC ?BPC))

(=>
  (and
    (muscleInsertion ?MC ?BPC)
    (instance ?H Human)
    (attribute ?H Healthy))
  (exists (?M ?BP)
    (and
      (instance ?M ?MC)
      (instance ?BP ?BPC)
      (part ?M ?H)
      (part ?BP ?H)
      (connected ?M ?BP))))

(=>
  (and
    (muscleInsertion ?MC ?BPC)
    (instance ?H Human)
    (holdsDuring ?T
      (attribute ?H StandardAnatomicalPosition))
    (attribute ?H Healthy)
    (instance ?C MuscularContraction)
    (during
      (WhenFn ?C) ?T)
    (instance ?M ?MC)
    (part ?M ?H)
    (instrument ?C ?M)
    (physicalEnd ?E ?M)
    (meetsSpatially ?E ?BP)
    (holdsDuring
      (BeginFn ?C)
      (located ?E ?L)))
  (holdsDuring
    (EndFn ?C)
    (not
      (located ?E ?L))))

(subAttribute StandardAnatomicalPosition Standing)
(documentation StandardAnatomicalPosition EnglishWrittenLanguage "In standard anatomical position, the human body is standing erect and at rest. Unlike the situation in other vertebrates, the limbs are placed in positions reminiscent of the supine position imposed on cadavers during autopsy. Therefore, the body has its feet together (or slightly separated), and its arms are rotated outward so that the palms are forward, and the thumbs are pointed away from the body (forearms supine). As well, the arms are usually moved slightly out from the body, so that the hands do not touch the sides. The positions of the &%Limbs (and the &%Arms in particular) have important implications for directional terms in those appendages. The penis in the anatomical position is described in its erect position and therefore lies against the abdomen, hence the dorsal surface of the penis is actually anterior when the penis is flaccid.[from Wikipedia]")
(externalImage StandardAnatomicalPosition "https://upload.wikimedia.org/ wikipedia/ commons/ b/ b2/ Anatomical_position.jpg")
(termFormat EnglishWrittenLanguage StandardAnatomicalPosition "standard anatomical position")

(subAttribute Prone Prostrate)
(termFormat EnglishWrittenLanguage Prone "prone")
(documentation Prone EnglishWrittenLanguage "Lying face down.")

(=>
  (and
    (holdsDuring ?T
      (and
        (attribute ?H Prone)
        (orientation ?H ?O On)))
    (instance ?C Chest)
    (part ?C ?H))
  (meetsSpatially ?C ?O))

(subAttribute Supine Prostrate)
(termFormat EnglishWrittenLanguage Supine "supine")
(documentation Supine EnglishWrittenLanguage "Lying face up, on one's back.")
(contraryAttribute Prone Supine)

(=>
  (and
    (holdsDuring ?T
      (and
        (attribute ?H Supine)
        (orientation ?H ?O On)))
    (equal ?B
      (BackFn ?H)))
  (meetsSpatially ?B ?O))

(=>
  (and
    (instance ?C Chest)
    (part ?C ?P)
    (equal ?B
      (BackFn ?P)))
  (not
    (part ?C ?B)))

(instance LateralRecumbant BodyPosition)
(subAttribute LateralRecumbant Prostrate)
(documentation LateralRecumbant EnglishWrittenLanguage "The &%BodyPosition of lying on one's side.")
(termFormat EnglishWrittenLanguage LateralRecumbant "lying on one's side")
(termFormat EnglishWrittenLanguage LateralRecumbant "lateral recumbant")

(=>
  (and
    (holdsDuring ?T
      (and
        (attribute ?H LateralRecumbant)
        (orientation ?H ?O On)))
    (instance ?LA LeftArm)
    (part ?LA ?H)
    (instance ?RA RightArm)
    (part ?RA ?H)
    (instance ?LL LeftLeg)
    (part ?LL ?H)
    (instance ?RL RightLeg)
    (part ?RL ?H)
    (or
      (meetsSpatially ?LA ?O)
      (meetsSpatially ?LL ?O)))
  (holdsDuring ?T
    (and
      (not
        (meetsSpatially ?RA ?O))
      (not
        (meetsSpatially ?RL ?O)))))

(=>
  (and
    (holdsDuring ?T
      (and
        (attribute ?H LateralRecumbant)
        (orientation ?H ?O On)))
    (instance ?LA LeftArm)
    (part ?LA ?H)
    (instance ?RA RightArm)
    (part ?RA ?H)
    (instance ?LL LeftLeg)
    (part ?LL ?H)
    (instance ?RL RightLeg)
    (part ?RL ?H)
    (or
      (meetsSpatially ?RA ?O)
      (meetsSpatially ?RL ?O)))
  (holdsDuring ?T
    (and
      (not
        (meetsSpatially ?LA ?O))
      (not
        (meetsSpatially ?LL ?O)))))

(documentation Nerve EnglishWrittenLanguage "A nerve is an enclosed, cable_like bundle of nerve fibers (called axons) in the peripheral nervous system. Axons transmit electrical impulses. Nerves have historically been considered the basic units of the peripheral nervous system. A nerve provides a common pathway for the electrochemical nerve impulses called action potentials that are transmitted along each of the axons to peripheral organs or, in the case of sensory nerves, from the periphery back to the central nervous system. Each axon, within the nerve, is an extension of an individual neuron, along with other supportive cells such as some Schwann cells that coat the axons in myelin. Within a nerve, each axon is surrounded by a layer of connective tissue called the endoneurium. The axons are bundled together into groups called fascicles, and each fascicle is wrapped in a layer of connective tissue called the perineurium. Finally, the entire nerve is wrapped in a layer of connective tissue called the epineurium. Nerve cells (often called neurons) are further classified as sensory, motor, or mixed nerves. In the central nervous system, the analogous structures are known as nerve tracts.[from Wikipedia]")
(termFormat EnglishWrittenLanguage Nerve "nerve")
(subclass Nerve BodyPart)

(subclass NerveFiring BiologicalProcess)
(termFormat EnglishWrittenLanguage NerveFiring "nerve firing")


(documentation NerveFiring EnglishWrittenLanguage "An action potential occurs when the membrane potential of a specific cell
rapidly rises and falls. This depolarization then causes adjacent locations to similarly depolarize. Action
potentials occur in several types of animal cells, called excitable cells, which include neurons, muscle cells,
and in some plant cells. Certain endocrine cells such as pancreatic beta cells, and certain cells of the anterior
&%PituitaryGland are also excitable cells. In neurons, action potentials play a central role in cell–cell
communication by providing for—or with regard to saltatory conduction, assisting—the propagation of signals along
the neuron's axon toward synaptic boutons situated at the ends of an axon; these signals can then connect with
other neurons at synapses, or to motor cells or glands.[from Wikipedia]")

(=>
  (instance ?N Nerve)
  (exists (?NC)
    (and
      (instance ?NC NerveCell)
      (part ?NC ?N))))

(instance ennervates BinaryPredicate)
(termFormat EnglishWrittenLanguage ennervates "ennervates")

(documentation ennervates EnglishWrittenLanguage "A relation between a class of &%Nerve and a class of &%Muscle that is activated by that nerve, when both are instances in a particular organism.")
(domainSubclass ennervates 1 Nerve)
(domainSubclass ennervates 2 Muscle)

(=>
  (and
    (ennervates ?NC ?MC)
    (instance ?N ?NC)
    (instance ?M ?MC)
    (part ?N ?H)
    (part ?M ?H)
    (attribute ?H Healthy)
    (instance ?H Human))
  (hasPurpose ?N
    (exists (?NF ?C)
      (and
        (instance ?NF NerveFiring)
        (instrument ?NF ?N)
        (instance ?C MuscularContraction)
        (instrument ?C ?M)
        (causes ?NF ?C)))))

(instance suppliesBlood BinaryPredicate)
(termFormat EnglishWrittenLanguage suppliesBlood "supplies blood")

(documentation suppliesBlood EnglishWrittenLanguage "A relation between a class of &%Artery and a class of &%BodyPart that that indicates blood is supplied through the artery to the part in a normal and healthy version of an organism.")
(domainSubclass suppliesBlood 1 Artery)
(domainSubclass suppliesBlood 2 BodyPart)

(=>
  (and
    (suppliesBlood ?AC ?BPC)
    (instance ?A ?AC)
    (instance ?BP ?BPC))
  (hasPurpose ?A
    (exists (?BF ?B)
      (and
        (instance ?BF LiquidMotion)
        (objectTransferred ?BF ?B)
        (instance ?B Blood)
        (destination ?BF ?BP)))))


(documentation Dorsal EnglishWrittenLanguage "Belonging to or on or near the back or upper surface of an animal or organ or part; 'the dorsal fin is the vertical fin on the back of a fish and certain marine mammals'.")
(termFormat EnglishWrittenLanguage Dorsal "dorsal")
(instance Dorsal Attribute)

(=>
  (attribute ?D Dorsal)
  (exists (?O ?B)
    (and
      (or
        (instance ?O Organism)
        (instance ?O BodyPart))
      (not
        (and
          (instance ?O Organism)
          (instance ?O BodyPart)))
      (part ?D ?O)
      (equal ?B
        (BackFn ?O))
      (meetsSpatially ?B ?D))))


(documentation Ventral EnglishWrittenLanguage "Belonging to or on or near the front or bottom part of an animal or organ or part; The opposite side of dorsal")
(termFormat EnglishWrittenLanguage Ventral "ventral")
(instance Ventral Attribute)

(=>
  (attribute ?V Ventral)
  (exists (?O ?F)
    (and
      (or
        (instance ?O Organism)
        (instance ?O BodyPart))
      (not
        (and
          (instance ?O Organism)
          (instance ?O BodyPart)))
      (part ?V ?O)
      (equal ?F
        (FrontFn ?O))
      (meetsSpatially ?F ?V))))


(documentation Abducting EnglishWrittenLanguage "Pull a body part away from the body.")
(termFormat EnglishWrittenLanguage Abducting "abducting")
(subclass Abducting BodyMotion)
(subclass Abducting MovingAwayFrom)

(=>
  (instance ?A Abducting)
  (exists (?BP ?ORGANISM ?TORSO ?MAF ?MOVINGAWAYFROM)
    (and
      (instance ?BP BodyPart)
      (instance ?ORGANISM Organism)
      (instance ?TORSO Torso)
      (not
        (equal ?BP ?TORSO))
      (instance ?MOVINGAWAYFROM MovingAwayFrom)
      (subProcess ?MAF ?MOVINGAWAYFROM)
      (patient ?MAF ?BP)
      (patient ?MAF ?TORSO)
      (part ?BP ?ORGANISM)
      (part ?TORSO ?ORGANISM)
      (experiencer ?A ?ORGANISM)
      (moves ?A ?BP))))

(documentation Adducting EnglishWrittenLanguage "Pull a limb towards the body.")
(termFormat EnglishWrittenLanguage Adducting "adducting")
(subclass Adducting BodyMotion)
(subclass Adducting MovingTowards)

(=>
  (instance ?A Adducting)
  (exists (?BP ?ORGANISM ?TORSO ?MT)
    (and
      (instance ?BP BodyPart)
      (instance ?ORGANISM Organism)
      (instance ?TORSO Torso)
      (not
        (equal ?BP ?TORSO))
      (instance ?MT MovingTowards)
      (subProcess ?MT ?A)
      (patient ?MT ?BP)
      (patient ?MT ?TORSO)
      (part ?BP ?ORGANISM)
      (part ?TORSO ?ORGANISM)
      (experiencer ?A ?ORGANISM)
      (moves ?A ?BP))))

(relatedInternalConcept Adducting Abducting)
