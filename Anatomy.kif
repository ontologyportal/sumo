(=>
  (and
    (instance ?R CervicalVertebraBone)
    (part ?R ?H)
    (instance ?H Human)
    (instance ?DISEASE DiseaseOrSyndrome)
    (not
      (attribute ?H ?DISEASE)))
  (exists (?S)
    (and
      (instance ?S CervicalVertebraBone)
      (not
        (equal ?S ?R))
      (part ?S ?H)
      (connected ?S ?R))))
      
