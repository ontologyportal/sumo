(=>
  (and
    (instance ?R TrueRibBone)
    (part ?R ?H)
    (instance ?H Human)
    (instance ?DISEASE DiseaseOrSyndrome)
    (not
      (attribute ?H ?DISEASE)))
  (exists (?S)
    (and
      (instance ?S Sternum)
      (part ?S ?H)
      (connected ?S ?R))))
      
(=>
  (and
    (instance ?R FalseRibBone)
    (part ?R ?H)
    (instance ?H Human)
    (instance ?DISEASE DiseaseOrSyndrome)
    (not
      (attribute ?H ?DISEASE)))
  (not
    (exists (?S)
      (and
        (instance ?S Sternum)
        (part ?S ?H)
        (connected ?S ?R)))))
            
