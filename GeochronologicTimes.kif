(partition GeochronologicTime GeochronologicAge GeochronologicEpoch GeochronologicEra GeochronologicSubPeriod GeochronologicPeriod GeochronologicEon GeochronologicSuperEon)

(subclass GeochronologicTime TimeInterval)
(termFormat EnglishWrittenLanguage GeochronologicTime "geochronologic time")

(subclass GeochronologicSuperEon GeochronologicTime)
(termFormat EnglishWrittenLanguage GeochronologicSuperEon "supereon")
(termFormat PortugueseWrittenLanguage GeochronologicSuperEon "super éon")

(subclass GeochronologicEon GeochronologicTime)
(termFormat EnglishWrittenLanguage GeochronologicEon "eon")
(termFormat PortugueseWrittenLanguage GeochronologicEon "éon")

(subclass GeochronologicEra GeochronologicTime)
(termFormat EnglishWrittenLanguage GeochronologicEra "era")
(termFormat PortugueseWrittenLanguage GeochronologicEra "era")

(subclass GeochronologicPeriod GeochronologicTime)
(termFormat EnglishWrittenLanguage GeochronologicPeriod "period")
(termFormat PortugueseWrittenLanguage GeochronologicPeriod "período")

(subclass GeochronologicSubPeriod GeochronologicTime)
(termFormat EnglishWrittenLanguage GeochronologicSubPeriod "sub period")

(subclass GeochronologicEpoch GeochronologicTime)
(termFormat EnglishWrittenLanguage GeochronologicEpoch "epoch")
(termFormat PortugueseWrittenLanguage GeochronologicEpoch "época")

(subclass GeochronologicAge GeochronologicTime)
(termFormat EnglishWrittenLanguage GeochronologicAge "age")
(termFormat PortugueseWrittenLanguage GeochronologicAge "idade")


;; there are no two GeochronologicTime in the same rank overlapping

(=>
  (and
    (instance ?X GeochronologicTime)
    (instance ?Y GeochronologicTime)
    (instance ?X ?Class)
    (instance ?Y ?Class)
    (not
      (equal ?X ?Y))
    (subclass ?Class GeochronologicTime))
  (not
    (overlapsTemporally ?X ?Y)))


;; The hierarchy is: SuperEon > Eon > Era > Period > SubPeriod (where
;; one exists) > Epoch > Age

(=>
  (instance ?X GeochronologicAge)
  (exists (?Y)
    (and
      (instance ?Y GeochronologicEpoch)
      (or
        (starts ?X ?Y)
        (during ?X ?Y)
        (finishes ?X ?Y)))))

(=>
  (instance ?X GeochronologicEpoch)
  (exists (?Y)
    (and
      (or
        (instance ?Y GeochronologicPeriod)
        (instance ?Y GeochronologicSubPeriod))
      (or
        (starts ?X ?Y)
        (during ?X ?Y)
        (finishes ?X ?Y)))))

(=>
  (instance ?X GeochronologicSubPeriod)
  (exists (?Y)
    (and
      (instance ?Y GeochronologicPeriod)
      (or
        (starts ?X ?Y)
        (during ?X ?Y)
        (finishes ?X ?Y)))))
		
(=>
  (instance ?X GeochronologicPeriod)
  (exists (?Y)
    (and
      (instance ?Y GeochronologicEra)
      (or
        (starts ?X ?Y)
        (during ?X ?Y)
        (finishes ?X ?Y)))))

(=>
  (instance ?X GeochronologicEra)
  (exists (?Y)
    (and
      (instance ?Y GeochronologicEon)
      (or
        (starts ?X ?Y)
        (during ?X ?Y)
        (finishes ?X ?Y)))))


;; the boundaries

(subclass GeochronologicBase TimePoint)
(termFormat EnglishWrittenLanguage GeochronologicBase "geochronologic base")


;; we can also use the PositiveInfinity concept defined in Merge.kif
(instance GeochronologicPresent TimePoint)
(exists (?YEAR1950)
  (and
    (instance ?YEAR1950
      (YearFn 1950))
    (equal GeochronologicPresent
      (BeginFn ?YEAR1950))))
            
(termFormat EnglishWrittenLanguage GeochronologicPresent "geochronologic present")

(instance MillionYearsAgoFn UnaryFunction)
(termFormat EnglishWrittenLanguage MillionYearsAgoFn "million years ago")
(domain MillionYearsAgoFn 1 RealNumber)
(range MillionYearsAgoFn TimePoint)

(exists (?YEAR)
  (and
    (instance ?YEAR
      (YearFn
        (FloorFn
          (AdditionFn 1950
            (MultiplicationFn ?X -1000000)))))
    (equal
      (MillionYearsAgoFn ?X)
      (BeginFn ?YEAR))))

(instance maBoundary TernaryPredicate)
(termFormat EnglishWrittenLanguage maBoundary "ma boundary")
(domain maBoundary 1 GeochronologicBase)
(domain maBoundary 2 RealNumber)
(domain maBoundary 3 RealNumber)

(=>
  (maBoundary ?Base ?X ?Y)
  (temporallyBetween
    (MillionYearsAgoFn
      (AdditionFn ?X ?Y)) ?Base
    (MillionYearsAgoFn
      (SubtractionFn ?X ?Y))))
		  

(instance maApproxPoint BinaryPredicate)
(termFormat EnglishWrittenLanguage maApproxPoint "million years ago approximate point")
(domain maApproxPoint 1 GeochronologicBase)
(domain maApproxPoint 2 RealNumber)

(=>
  (maApproxPoint ?Base ?X)
  (exists (?Y)
    (and
      (approximateValue ?X ?Y)
      (equal ?Base
        (MillionYearsAgoFn ?Y)))))


(instance maPoint BinaryPredicate)
(termFormat EnglishWrittenLanguage maPoint "million years ago point")
(domain maPoint 1 GeochronologicBase)
(domain maPoint 2 RealNumber)

(=>
  (maPoint ?Base ?X)
  (equal ?Base
    (MillionYearsAgoFn ?X)))


;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; 175 cases from line 194 to line 1435			           ;;
;; for every particular GeochronologicItem X, creates:	           ;;
;; - sets the value of BaseX as a numerical value X	           ;;
;; - sets the beginning of X as a instance of GeochronologicBases  ;;
;; - sets the end of X as a of GeochronologicBases		   ;;
;; - provides X name in English				           ;;
;; - provides X name in Portuguese			           ;;
;; - X meets temporally the next one GeochronologicItem            ;;
;;   of the same type                                              ;;
;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;; Ages

(instance Carnian GeochronologicAge)
(termFormat EnglishWrittenLanguage Carnian "Carnian")
(termFormat PortugueseWrittenLanguage Carnian "Carniano")
(equal
  (BeginFn Carnian) BaseLateTriassic)
(equal
  (EndFn Carnian) BaseNorian)
(starts Carnian LateTriassic)
(meetsTemporally Ladinian Carnian)

(instance Pliensbachian GeochronologicAge)
(termFormat EnglishWrittenLanguage Pliensbachian "Pliensbachian")
(termFormat PortugueseWrittenLanguage Pliensbachian "Pliensbaquiano")
(equal
  (BeginFn Pliensbachian) BasePliensbachian)
(equal
  (EndFn Pliensbachian) BaseToarcian)
(during Pliensbachian EarlyJurassic)
(meetsTemporally Sinemurian Pliensbachian)

